<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\GwsBusinessSuite.Domain\GwsBusinessSuite.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Markdig" Version="1.5.1" />
    <!-- Compiles the C# in generated articles so hallucinated APIs fail loudly instead of
         shipping. A compiler cannot be talked into believing a method exists, which is the one
         thing an LLM self-check cannot do. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="SkiaSharp" Version="4.154.0" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Airport list the Overwatch aircraft panel names a tracked takeoff from (see AircraftDetailService). -->
    <EmbeddedResource Include="LiveLayers\airports.csv" LogicalName="GwsBusinessSuite.Application.LiveLayers.airports.csv" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
