{
  "id": "/admin",
  "name": "GWS Business Suite",
  "short_name": "GWS Suite",
  "description": "Grant Watson's business suite: SentinelGPT, Overwatch, World News, Mail, content and the rest of the admin app.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/admin",
  "scope": "/admin",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#141210",
  "theme_color": "#141210",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "/img/app-icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/img/app-icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/img/app-icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/img/app-icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "SentinelGPT", "url": "/admin?assistant=open", "icons": [{ "src": "/img/app-icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Overwatch", "url": "/admin/osint", "icons": [{ "src": "/img/app-icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "World News", "url": "/admin/world-news", "icons": [{ "src": "/img/app-icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Mail", "url": "/admin/mail", "icons": [{ "src": "/img/app-icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
