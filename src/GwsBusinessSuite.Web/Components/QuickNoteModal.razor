@* A small, draggable, resizable "quick capture" note. Pointer dragging stays entirely in
   the browser so movement remains smooth and cannot select the dashboard behind it. *@
@using GwsBusinessSuite.Application.Abstractions
@using GwsBusinessSuite.Application.Wiki
@inject IQuickNoteService QuickNoteService
@inject ICurrentUserAccessor CurrentUserAccessor
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (IsOpen)
{
    <div id="@ModalElementId" class="qn-modal">
        <div class="qn-header" data-qn-drag-handle>
            <i class="bi bi-stickies-fill me-2" aria-hidden="true"></i>
            <span class="fw-semibold small">Quick Note</span>
            <button type="button" class="qn-header-button ms-auto" data-qn-expand-button title="Expand Quick Note" aria-label="Expand Quick Note"
                    @onclick="ToggleExpandedAsync">
                <i class="bi bi-arrows-fullscreen" aria-hidden="true"></i>
            </button>
            <button type="button" class="btn-close btn-close-white ms-1" aria-label="Close" @onclick="CloseAsync"></button>
        </div>

        <div class="qn-body">
            <input class="form-control form-control-sm qn-title" placeholder="Title"
                   @bind="Title" @bind:event="oninput" />

            <textarea id="@EditorElementId" class="qn-textarea">@_body</textarea>

            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="alert alert-danger py-2 px-3 small mb-0 mt-2">@ErrorMessage</div>
            }
        </div>

        <div class="qn-footer">
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CloseAsync" disabled="@_isSaving">Cancel</button>
            <button type="button" class="btn btn-sm btn-primary" @onclick="SaveAsync" disabled="@_isSaving">
                @(_isSaving ? "Saving..." : "Save")
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private const string EditorElementId = "quick-note-editor";
    private const string ModalElementId = "quick-note-modal";
    private string Title { get; set; } = string.Empty;
    private string _body = string.Empty;
    private string ErrorMessage { get; set; } = string.Empty;
    private bool _isSaving;
    private bool _editorInitialized;
    private DotNetObjectReference<QuickNoteModal>? _editorRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen && !_editorInitialized)
        {
            _editorRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("gwsMarkdownEditor.init", EditorElementId, _editorRef, new
            {
                compact = true,
                minHeight = "180px"
            });
            await JS.InvokeVoidAsync("gwsQuickNote.init", ModalElementId);
            _editorInitialized = true;
        }
    }

    [JSInvokable]
    public void OnMarkdownChanged(string value) => _body = value;

    private Task ToggleExpandedAsync() => JS.InvokeVoidAsync("gwsQuickNote.toggleExpanded", ModalElementId).AsTask();

    private async Task SaveAsync()
    {
        ErrorMessage = string.Empty;
        if (string.IsNullOrWhiteSpace(Title) && string.IsNullOrWhiteSpace(_body))
        {
            ErrorMessage = "Write something first.";
            return;
        }

        _isSaving = true;
        try
        {
            var performedBy = await CurrentUserAccessor.GetCurrentUsernameAsync();
            await QuickNoteService.AddQuickNoteAsync(
                string.IsNullOrWhiteSpace(Title) ? "Untitled note" : Title, _body, performedBy);
            await OnSaved.InvokeAsync();
            await CloseAsync();
        }
        catch (Exception)
        {
            ErrorMessage = "Couldn't save that note. Try again.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task CloseAsync()
    {
        if (_editorInitialized)
        {
            await JS.InvokeVoidAsync("gwsQuickNote.destroy", ModalElementId);
            await JS.InvokeVoidAsync("gwsMarkdownEditor.destroy", EditorElementId);
            _editorInitialized = false;
        }
        Title = string.Empty;
        _body = string.Empty;
        ErrorMessage = string.Empty;
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    public async ValueTask DisposeAsync()
    {
        if (_editorInitialized)
        {
            try
            {
                await JS.InvokeVoidAsync("gwsQuickNote.destroy", ModalElementId);
                await JS.InvokeVoidAsync("gwsMarkdownEditor.destroy", EditorElementId);
            }
            catch (JSDisconnectedException) { /* circuit already gone */ }
        }
        _editorRef?.Dispose();
    }
}

<style>
    .qn-modal {
        position: fixed;
        z-index: 1999;
        left: 120px;
        top: 100px;
        width: 380px;
        min-width: 320px;
        min-height: 220px;
        max-width: min(92vw, 820px);
        max-height: min(88vh, 680px);
        resize: both;
        overflow: auto;
        background: var(--gws-panel-bg, #1b1917);
        border: 1px solid var(--gws-panel-border, #4c4337);
        border-radius: 10px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, .45);
        display: flex;
        flex-direction: column;
    }

    .qn-header {
        display: flex;
        align-items: center;
        padding: .5rem .75rem;
        border-bottom: 1px solid var(--gws-panel-border, #4c4337);
        cursor: grab;
        user-select: none;
        touch-action: none;
        flex: 0 0 auto;
    }

    .qn-header-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.75rem;
        height: 1.75rem;
        padding: 0;
        color: var(--gws-text-soft);
        background: transparent;
        border: 0;
        border-radius: .35rem;
    }

    .qn-header-button:hover,
    .qn-header-button:focus-visible {
        color: var(--gws-text-strong);
        background: var(--gws-sidebar-hover-bg);
    }

    .qn-body {
        padding: .6rem .75rem;
        flex: 1 1 auto;
        overflow: auto;
    }

    .qn-title {
        margin-bottom: .5rem;
    }

    .qn-textarea {
        width: 100%;
    }

    .qn-modal .EasyMDEContainer .editor-toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 1px;
        padding: .25rem;
        opacity: 1;
    }

    .qn-modal .EasyMDEContainer .editor-toolbar button {
        width: 28px;
        height: 28px;
        line-height: 28px;
        border: 0;
        border-radius: .3rem;
    }

    .qn-modal .EasyMDEContainer .editor-toolbar i.separator {
        height: 20px;
        margin: 4px 2px;
    }

    .qn-modal .EasyMDEContainer .CodeMirror {
        min-height: 180px;
        border-radius: 0;
    }

    .qn-modal .EasyMDEContainer .editor-statusbar {
        padding: .25rem .1rem 0;
        font-size: .7rem;
    }

    .qn-modal[data-expanded="true"] {
        max-width: 96vw;
        max-height: 92vh;
        resize: none;
    }

    .qn-modal[data-expanded="true"] .qn-body,
    .qn-modal[data-expanded="true"] .EasyMDEContainer {
        display: flex;
        flex: 1 1 auto;
        flex-direction: column;
        min-height: 0;
    }

    .qn-modal[data-expanded="true"] .EasyMDEContainer .CodeMirror {
        flex: 1 1 auto;
        height: auto;
    }

    .qn-footer {
        display: flex;
        justify-content: flex-end;
        gap: .5rem;
        padding: .5rem .75rem;
        border-top: 1px solid var(--gws-panel-border, #4c4337);
        flex: 0 0 auto;
    }
</style>
