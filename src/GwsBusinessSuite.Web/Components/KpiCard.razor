@* Shared dashboard metric: consistent hierarchy, semantic tone, optional destination and detail. *@
@if (!string.IsNullOrWhiteSpace(Href))
{
    <a class="gws-kpi-tile gws-kpi-tile-@Tone @CssClass" href="@Href" aria-label="@AccessibleLabel">
        @Body
    </a>
}
else
{
    <article class="gws-kpi-tile gws-kpi-tile-@Tone @CssClass" aria-label="@AccessibleLabel">
        @Body
    </article>
}

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Value { get; set; } = string.Empty;
    [Parameter] public string? Detail { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public string Tone { get; set; } = "neutral";
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    // A daily trend under the value (T5), oldest first, and what it covers.
    [Parameter] public IReadOnlyList<double>? Trend { get; set; }
    [Parameter] public string TrendLabel { get; set; } = "Last 14 days";
    [Parameter] public Func<double, string>? TrendFormat { get; set; }

    private string AccessibleLabel => string.Join(", ", new[] { Label, Value, Detail }.Where(value => !string.IsNullOrWhiteSpace(value)));

    // A template with no wrapper element is @<text>...</text>. Razor has no <>...</> fragment: it
    // compiles <> to an element with an empty name, which the browser refuses (createElement("")),
    // so every page with a tile crashed its circuit - the Mac app's "Reload" on login (01-11..05-11-26).
    private RenderFragment Body => @<text>
        <div class="gws-kpi-tile-head">
            <span class="gws-kpi-tile-label">@Label</span>
            @if (!string.IsNullOrWhiteSpace(Icon))
            {
                <i class="bi @Icon" aria-hidden="true"></i>
            }
        </div>
        <strong class="gws-kpi-tile-value">@Value</strong>
        @if (Trend is { Count: > 1 })
        {
            <Sparkline Values="Trend" Label="@($"{Label}, {TrendLabel.ToLowerInvariant()}")" Tone="@(Tone == "neutral" ? "info" : Tone)" Format="TrendFormat" />
        }
        @if (!string.IsNullOrWhiteSpace(Detail))
        {
            <span class="gws-kpi-tile-detail">@Detail</span>
        }
        @Footer
        @if (!string.IsNullOrWhiteSpace(Href))
        {
            <i class="bi bi-arrow-up-right gws-kpi-tile-arrow" aria-hidden="true"></i>
        }
    </text>;
}
