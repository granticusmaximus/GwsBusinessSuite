@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject GwsBusinessSuite.Web.Services.AdminThemeProvider AdminTheme
@inject GwsBusinessSuite.Application.AdminPortal.IUserPreferenceService Preferences
@inject GwsBusinessSuite.Application.Abstractions.ICurrentUserAccessor CurrentUser
@using System.Security.Claims

@if (!string.IsNullOrEmpty(_adminThemeCss))
{
    @* The live website's theme (accent, sidebar, top bar) - see AdminThemeCss. After app.css,
       so it overrides the built-in admin colors in both light and dark mode. *@
    <style>@((MarkupString)_adminThemeCss)</style>
}
<AuthorizeView>
    <Authorized Context="authState">
        <div class="gws-layout @(IsChromelessRoute ? "gws-builder-mode" : "") @(_compact ? "gws-density-compact" : "")">
            @if (!IsChromelessRoute)
            {
                <header class="gws-admin-bar">
                    <div class="gws-admin-bar-start">
                        <button type="button" class="gws-sidebar-toggle" title="Collapse sidebar"
                                aria-label="Collapse sidebar" aria-controls="gws-sidebar" aria-expanded="true">
                            <i class="bi bi-chevron-bar-left gws-sidebar-toggle-desktop" aria-hidden="true"></i>
                            <i class="bi bi-list gws-sidebar-toggle-mobile" aria-hidden="true"></i>
                        </button>
                        <div class="gws-admin-bar-brand">
                            <img src="favicon.svg" alt="" class="gws-admin-bar-icon" />
                            <span>GWS Business Suite</span>
                        </div>
                    </div>
                    <div class="gws-admin-bar-actions">
                        <button type="button" class="gws-command-trigger" data-gws-command-open
                                aria-label="Search the admin portal" aria-haspopup="dialog">
                            <i class="bi bi-search" aria-hidden="true"></i>
                            <span>Search</span>
                            <kbd>⌘K</kbd>
                        </button>
                        <button type="button" class="gws-theme-toggle" data-gws-theme-toggle
                                title="Switch between light and dark theme" aria-label="Switch between light and dark theme">
                            <i class="bi bi-moon-stars gws-theme-icon-dark" aria-hidden="true"></i>
                            <i class="bi bi-sun gws-theme-icon-light" aria-hidden="true"></i>
                        </button>
                        <AssistantPanel @rendermode="InteractiveServer" />
                        <NotificationBell @rendermode="InteractiveServer" />
                        <details class="gws-account-menu">
                            <summary aria-label="Open account menu">
                                <span class="gws-account-avatar" aria-hidden="true">@UserInitial(authState.User.Identity?.Name)</span>
                                <span class="gws-account-name">@authState.User.Identity?.Name</span>
                                <i class="bi bi-chevron-down" aria-hidden="true"></i>
                            </summary>
                            <div class="gws-account-popover">
                                <div class="gws-account-popover-user">
                                    <strong>@authState.User.Identity?.Name</strong>
                                    <span>@UserRole(authState.User)</span>
                                </div>
                                @if (authState.User.IsInRole(GwsBusinessSuite.Domain.Entities.AppRoles.Admin))
                                {
                                    <a href="/admin/settings"><i class="bi bi-gear" aria-hidden="true"></i> Settings</a>
                                }
                                <a href="/admin/account/touch-id"><i class="bi bi-fingerprint" aria-hidden="true"></i> Touch ID &amp; page lock</a>
                                <DensityToggle Compact="_compact" @rendermode="InteractiveServer" />
                                <a href="/auth/logout"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> Sign out</a>
                            </div>
                        </details>
                    </div>
                </header>
            }

            <div class="gws-layout-body">
                @if (!IsChromelessRoute)
                {
                    <aside class="gws-sidebar" id="gws-sidebar" aria-label="Admin navigation">
                        <NavMenu />
                    </aside>
                    <button type="button" class="gws-sidebar-backdrop" data-gws-sidebar-close
                            aria-label="Close navigation"></button>
                }

                <div class="gws-body">
                    <main class="gws-content @(IsChromelessRoute ? "gws-content-builder" : "")">
                        @Body
                    </main>
                    @if (!IsChromelessRoute)
                    {
                        @* The status strip (tech-forward T4): the live connection, automation jobs running,
                           SentinelGPT and the build, filled in by app.js (gwsStatusStrip) from
                           /admin/api/shell-status. data-permanent keeps what it shows across enhanced
                           navigation (its children; the root's own attributes are re-synced, so none
                           of its state lives there).
                           Hidden below 768px, where the phone bar sits. *@
                        <footer class="gws-status-strip" data-gws-status-strip data-permanent aria-label="System status">
                            <a href="/admin" class="gws-status-strip-link" title="Open the dashboard">
                                <span class="gws-status-item" data-status="connection" data-tone="success"><span class="gws-status-dot" aria-hidden="true"></span><span data-status-text>Live</span></span>
                                <span class="gws-status-item" data-status="jobs"><i class="bi bi-diagram-3" aria-hidden="true"></i><span data-status-text>Jobs …</span></span>
                                <span class="gws-status-item" data-status="ai"><i class="bi bi-stars" aria-hidden="true"></i><span data-status-text>SentinelGPT …</span></span>
                                <span class="gws-status-item gws-status-build" data-status="build"><span data-status-text></span></span>
                            </a>
                        </footer>
                    }
                </div>
            </div>

            @if (!IsChromelessRoute)
            {
                @* The phone bar (below 768px only): Menu opens the workspace rail and sub-nav as a
                   sheet, Search opens ⌘K, SentinelGPT opens the assistant panel. app.js handles all
                   three, so they work on static and interactive pages alike. *@
                <nav class="gws-bottom-bar" aria-label="Quick navigation">
                    <NavLink class="gws-bottom-bar-item" href="admin" Match="NavLinkMatch.All">
                        <i class="bi bi-house-door-fill" aria-hidden="true"></i><span>Home</span>
                    </NavLink>
                    <button type="button" class="gws-bottom-bar-item" data-gws-nav-toggle
                            aria-controls="gws-sidebar" aria-expanded="false">
                        <i class="bi bi-list" aria-hidden="true"></i><span>Menu</span>
                    </button>
                    <button type="button" class="gws-bottom-bar-item" data-gws-command-open aria-haspopup="dialog">
                        <i class="bi bi-search" aria-hidden="true"></i><span>Search</span>
                    </button>
                    <button type="button" class="gws-bottom-bar-item" data-gws-assistant-open>
                        <i class="bi bi-stars" aria-hidden="true"></i><span>SentinelGPT</span>
                    </button>
                </nav>

                <ToastHost @rendermode="InteractiveServer" />

                @* An enhanced navigation finishing while the palette is open must not reset it to this
                   markup (it closed the palette and cleared the search mid-word). data-permanent keeps
                   an element's children but still re-syncs its own attributes - `hidden` included - so
                   it sits on a wrapper and the palette's open state on the child (27-10-26). *@
                <div data-permanent="command-layer">
                <div class="gws-command-layer" data-gws-command-layer hidden>
                    <button type="button" class="gws-command-backdrop" data-gws-command-close
                            aria-label="Close search"></button>
                    <section class="gws-command-dialog" role="dialog" aria-modal="true"
                             aria-labelledby="gws-command-title">
                        <header>
                            <i class="bi bi-search" aria-hidden="true"></i>
                            <label id="gws-command-title" class="visually-hidden" for="gws-command-input">Search the admin portal</label>
                            <input id="gws-command-input" data-gws-command-input type="search"
                                   placeholder="Search pages and tools…" autocomplete="off" />
                            <kbd>Esc</kbd>
                        </header>
                        <div class="gws-command-body">
                            <div class="gws-command-results" data-gws-command-results></div>
                            @* The highlighted record's preview, on wide screens (tech-forward T2). *@
                            <aside class="gws-command-preview" data-command-preview hidden aria-hidden="true"></aside>
                        </div>
                        <footer>Type to filter · <kbd>t:ticket</kbd> <kbd>t:invoice</kbd>… for one kind · ↑ ↓ to move · Enter to open</footer>
                    </section>
                </div>
                </div>

                @* The hover preview card (tech-forward T2), filled and placed by app.js over anything with
                   data-preview="kind:id". Supplementary (the trigger itself opens the record), so
                   it's hidden from assistive tech. On a permanent wrapper like the palette's. *@
                <div data-permanent="preview-card"><div class="gws-preview-card" data-gws-preview-card hidden aria-hidden="true"></div></div>

                @* The keyboard shortcut sheet (tech-forward T1): ? opens it; app.js handles the keys. On a
                   permanent wrapper like the palette's, so a navigation doesn't close it. *@
                <div data-permanent="shortcuts-layer">
                <div class="gws-shortcuts-layer" data-gws-shortcuts-layer hidden>
                    <button type="button" class="gws-command-backdrop" data-gws-shortcuts-close
                            aria-label="Close keyboard shortcuts"></button>
                    <section class="gws-shortcuts-dialog" role="dialog" aria-modal="true" aria-labelledby="gws-shortcuts-title">
                        <header>
                            <h2 id="gws-shortcuts-title">Keyboard shortcuts</h2>
                            <button type="button" class="gws-shortcuts-close" data-gws-shortcuts-close aria-label="Close">
                                <i class="bi bi-x-lg" aria-hidden="true"></i>
                            </button>
                        </header>
                        <dl>
                            <dt><kbd>⌘</kbd> <kbd>K</kbd></dt><dd>Search pages and records, run actions</dd>
                            <dt><kbd>/</kbd></dt><dd>Search this page's list</dd>
                            <dt><kbd>g</kbd> then <kbd>h</kbd> <kbd>c</kbd> <kbd>r</kbd> <kbd>k</kbd> <kbd>i</kbd> <kbd>g</kbd> <kbd>p</kbd></dt>
                            <dd>Go to Home, Content, Relations, Knowledge, Intel, Growth or Platform</dd>
                            <dt><kbd>j</kbd> <kbd>k</kbd></dt><dd>Move down and up the list</dd>
                            <dt><kbd>Enter</kbd></dt><dd>Open the highlighted row</dd>
                            <dt><kbd>?</kbd></dt><dd>Show this list</dd>
                            <dt><kbd>Esc</kbd></dt><dd>Close, or leave the list</dd>
                        </dl>
                        <p>Keys stay off while you type, and on pages with their own (Sentinel, Overwatch, the page editor).</p>
                    </section>
                </div>
                </div>
            }
        </div>
    </Authorized>

    <NotAuthorized>
        <main class="gws-login-shell-full">
            @Body
        </main>
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="fw-semibold">Reload</a>
    <span class="dismiss">&#x2715;</span>
</div>

@code {
    private string _adminThemeCss = string.Empty;
    // The person's saved layout density (shell redesign R4), read on each request so an enhanced
    // navigation keeps what the account menu's switch saved.
    private bool _compact;

    protected override async Task OnInitializedAsync()
    {
        _adminThemeCss = await AdminTheme.GetCssAsync();
        var username = await CurrentUser.GetCurrentUsernameAsync();
        _compact = await Preferences.GetAsync(username, GwsBusinessSuite.Application.AdminPortal.UserPreferenceKeys.Density)
            == GwsBusinessSuite.Application.AdminPortal.Densities.Compact;
    }

    private bool IsChromelessRoute
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri);
            return path.StartsWith("admin/canvas", StringComparison.OrdinalIgnoreCase)
                || path.StartsWith("admin/ssh-terminal-window", StringComparison.OrdinalIgnoreCase);
        }
    }

    private static string UserInitial(string? username) =>
        string.IsNullOrWhiteSpace(username) ? "A" : username.Trim()[0].ToString().ToUpperInvariant();

    private static string UserRole(ClaimsPrincipal user) =>
        user.FindFirst(ClaimTypes.Role)?.Value ?? "Portal user";
}
