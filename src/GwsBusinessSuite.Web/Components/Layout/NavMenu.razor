@using GwsBusinessSuite.Application.AdminPortal
@using GwsBusinessSuite.Application.Abstractions
@using GwsBusinessSuite.Application.Settings
@using GwsBusinessSuite.Domain.Entities
@using GwsBusinessSuite.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@inject IAdminPortalSummaryService SummaryService
@inject ISiteSettingsService SiteSettingsService

<nav class="gws-nav" aria-label="Primary">
    @* The workspace rail: one button per workspace (today's sidebar groups), which shows that
       workspace's pages in the column beside it without leaving the page. The workspace of the
       current page is shown on load (NavMenuGroups.WorkspaceFor); app.js switches them. *@
    <div class="gws-rail" role="group" aria-label="Workspaces">
        @foreach (var workspace in VisibleWorkspaces)
        {
            <button type="button" class="gws-rail-item @(IsWorkspace(workspace.Key) ? "is-active" : string.Empty)"
                    data-gws-workspace="@workspace.Key" aria-controls="gws-ws-@workspace.Key"
                    aria-pressed="@(IsWorkspace(workspace.Key) ? "true" : "false")" title="@workspace.Label">
                <i class="bi @workspace.Icon" aria-hidden="true"></i><span>@workspace.ShortLabel</span>
            </button>
        }
        @if (IsAdmin)
        {
            <NavLink class="gws-rail-item gws-rail-end" href="admin/settings" title="Settings">
                <i class="bi bi-gear-fill" aria-hidden="true"></i><span>Settings</span>
            </NavLink>
        }
    </div>

    <div class="gws-subnav">
        <section class="gws-workspace" id="gws-ws-home" data-workspace="home" data-workspace-label="Home"
                 aria-label="Home" hidden="@(!IsWorkspace("home"))">
            <h2 class="gws-workspace-title">Home</h2>
            <NavLink class="gws-nav-link gws-nav-home" href="admin" Match="NavLinkMatch.All" title="Dashboard">
                <i class="bi bi-grid-1x2-fill" aria-hidden="true"></i>
                <span class="gws-nav-link-copy"><span>Home</span><small>Your work at a glance</small></span>
            </NavLink>
            <a class="@AppLinkClass(AdminApps.Community)" href="@AdminApps.Community.Href" aria-current="@AppCurrent(AdminApps.Community)" title="Community">
                <i class="bi @AdminApps.Community.Icon" aria-hidden="true"></i>
                <span class="gws-nav-link-copy"><span>Community</span><small>@AdminApps.Community.Description</small></span>
            </a>
        </section>

        <section class="gws-workspace" id="gws-ws-content" data-workspace="content" data-workspace-label="Content &amp; Publishing"
                 aria-label="Content &amp; Publishing" hidden="@(!IsWorkspace("content"))">
            <h2 class="gws-workspace-title">Content &amp; Publishing</h2>
            <NavLink class="gws-nav-link" href="admin/article-editor" title="All Posts">
                <i class="bi bi-pencil-square" aria-hidden="true"></i>
                <span class="gws-nav-link-copy"><span>Posts</span><small>Write and publish</small></span>
            </NavLink>
            @if (IsNativeApp)
            {
                <NavLink class="gws-nav-link" href="admin/content-studio" title="Content Studio">
                    <i class="bi bi-magic" aria-hidden="true"></i>
                    <span class="gws-nav-link-copy"><span>Content Studio</span><small>Mac-local article generation</small></span>
                    @if (_pendingDraftCount > 0) { <span class="gws-nav-count">@_pendingDraftCount</span> }
                </NavLink>
            }
            @if (IsAdmin)
            {
                <NavLink class="gws-nav-link" href="admin/content-calendar" title="Content Calendar">
                    <i class="bi bi-calendar3" aria-hidden="true"></i>
                    <span class="gws-nav-link-copy"><span>Content Calendar</span><small>Everything scheduled to go out</small></span>
                </NavLink>
            }
            <NavLink class="gws-nav-link" href="admin/seo-audit" title="SEO Audit">
                <i class="bi bi-search-heart" aria-hidden="true"></i>
                <span class="gws-nav-link-copy"><span>SEO Audit</span><small>Classic + AI-era readiness</small></span>
            </NavLink>
            @if (Shown("localization"))
            {
                <NavLink class="gws-nav-link" href="admin/localization" title="Content Localization">
                    <i class="bi bi-translate" aria-hidden="true"></i>
                    <span class="gws-nav-link-copy"><span>Localization</span><small>AI-assisted translations</small></span>
                </NavLink>
            }
            @if (Shown("comments"))
            {
                <NavLink class="gws-nav-link" href="admin/comments" title="Comments">
                    <i class="bi bi-chat-left-text" aria-hidden="true"></i>
                    <span class="gws-nav-link-copy"><span>Comments</span><small>Moderate visitor replies</small></span>
                    @if (_pendingCommentCount > 0) { <span class="gws-nav-count">@_pendingCommentCount</span> }
                </NavLink>
            }
            @if (IsContributorOrAbove)
            {
                <NavLink class="gws-nav-link" href="admin/form-submissions" title="Form Submissions">
                    <i class="bi bi-inbox" aria-hidden="true"></i>
                    <span class="gws-nav-link-copy"><span>Form Submissions</span><small>Visitor submissions across every page</small></span>
                    @if (_unreadFormSubmissionCount > 0) { <span class="gws-nav-count">@_unreadFormSubmissionCount</span> }
                </NavLink>
            }
            @if (IsContributorOrAbove || Shown("app-generation"))
            {
                <h3 class="gws-subnav-section">Site</h3>
            }
            @if (IsContributorOrAbove)
            {
                <NavLink class="gws-nav-link" href="admin/pages" title="Pages">
                    <i class="bi bi-layout-three-columns" aria-hidden="true"></i>
                    <span class="gws-nav-link-copy"><span>Pages</span><small>Build and organize pages</small></span>
                </NavLink>
                <a class="@AppLinkClass(AdminApps.SiteDesign)" href="@AdminApps.SiteDesign.Href" aria-current="@AppCurrent(AdminApps.SiteDesign)" title="Site design">
                    <i class="bi @AdminApps.SiteDesign.Icon" aria-hidden="true"></i>
                    <span class="gws-nav-link-copy"><span>Site design</span><small>@AdminApps.SiteDesign.Description</small></span>
                </a>
            }
            @if (Shown("app-generation"))
            {
                <a class="@AppLinkClass(AdminApps.PageBuilder)" href="@AdminApps.PageBuilder.Href" aria-current="@AppCurrent(AdminApps.PageBuilder)" title="SentinelGPT Builder">
                    <i class="bi @AdminApps.PageBuilder.Icon" aria-hidden="true"></i>
                    <span class="gws-nav-link-copy"><span>SentinelGPT Builder</span><small>Draft pages and review plans</small></span>
                    @if (IsAdmin && _pendingAppGenerationCount > 0) { <span class="gws-nav-count">@_pendingAppGenerationCount</span> }
                </a>
            }
            @if (IsContributorOrAbove)
            {
                <NavLink class="gws-nav-link" href="admin/media" title="Media Library">
                    <i class="bi bi-images" aria-hidden="true"></i>
                    <span class="gws-nav-link-copy"><span>Media</span><small>Images for posts and pages</small></span>
                </NavLink>
            }
            @if (IsAdmin)
            {
                <h3 class="gws-subnav-section">Shows</h3>
                @if (Shown("podcasts"))
                {
                    <NavLink class="gws-nav-link" href="admin/podcasts" title="Podcast Directory">
                        <i class="bi bi-mic-fill" aria-hidden="true"></i>
                        <span class="gws-nav-link-copy"><span>Podcasts</span><small>Saved shows and episodes</small></span>
                    </NavLink>
                }
                <NavLink class="gws-nav-link" href="admin/live-show" title="Live Show">
                    <i class="bi bi-camera-video-fill" aria-hidden="true"></i>
                    <span class="gws-nav-link-copy"><span>Live Show</span><small>Broadcast studio</small></span>
                </NavLink>
            }
        </section>

        @if (IsAdmin)
        {
            <section class="gws-workspace" id="gws-ws-relationships" data-workspace="relationships" data-workspace-label="Relationships"
                     aria-label="Relationships" hidden="@(!IsWorkspace("relationships"))">
                <h2 class="gws-workspace-title">Relationships</h2>
                @if (Shown("crm"))
                {
                    <a class="@AppLinkClass(AdminApps.Crm)" href="@AdminApps.Crm.Href" aria-current="@AppCurrent(AdminApps.Crm)" title="CRM">
                        <i class="bi @AdminApps.Crm.Icon" aria-hidden="true"></i>
                        <span class="gws-nav-link-copy"><span>CRM</span><small>Contacts, deals and deal scores</small></span>
                        @if (_dueFollowUpCount > 0) { <span class="gws-nav-count">@_dueFollowUpCount</span> }
                    </a>
                }
                @if (Shown("billing"))
                {
                    <NavLink class="gws-nav-link" href="admin/billing" title="Billing">
                        <i class="bi bi-receipt" aria-hidden="true"></i>
                        <span class="gws-nav-link-copy"><span>Billing</span><small>Draft and send invoices</small></span>
                    </NavLink>
                }
                @if (Shown("billing"))
                {
                    <NavLink class="gws-nav-link" href="admin/time" title="Time Tracking">
                        <i class="bi bi-stopwatch" aria-hidden="true"></i>
                        <span class="gws-nav-link-copy"><span>Time Tracking</span><small>Timers and billable hours</small></span>
                    </NavLink>
                }
                @if (Shown("support"))
                {
                    <NavLink class="gws-nav-link" href="admin/support" title="Support">
                        <i class="bi bi-life-preserver" aria-hidden="true"></i>
                        <span class="gws-nav-link-copy"><span>Support</span><small>Client portal tickets</small></span>
                    </NavLink>
                }
                @if (Shown("scheduling"))
                {
                    <NavLink class="gws-nav-link" href="admin/scheduling" title="Scheduling">
                        <i class="bi bi-calendar2-check" aria-hidden="true"></i>
                        <span class="gws-nav-link-copy"><span>Scheduling</span><small>Booking types and bookings</small></span>
                    </NavLink>
                }
                @if (Shown("email-campaigns"))
                {
                    <NavLink class="gws-nav-link" href="admin/email-campaigns" title="Email Campaigns">
                        <i class="bi bi-envelope-paper-fill" aria-hidden="true"></i>
                        <span class="gws-nav-link-copy"><span>Email Campaigns</span><small>Alert lists and drip sequences</small></span>
                    </NavLink>
                }
                <NavLink class="gws-nav-link" href="admin/users" title="User Management">
                    <i class="bi bi-person-gear" aria-hidden="true"></i>
                    <span class="gws-nav-link-copy"><span>Users</span><small>Accounts and roles</small></span>
                </NavLink>
            </section>
        }

        @if (IsAdmin)
        {
            <section class="gws-workspace" id="gws-ws-knowledge" data-workspace="knowledge" data-workspace-label="Knowledge"
                     aria-label="Knowledge" hidden="@(!IsWorkspace("knowledge"))">
                <h2 class="gws-workspace-title">Knowledge</h2>
                <NavLink class="gws-nav-link" href="admin/sentinel" title="Sentinel">
                    <i class="bi bi-journal-bookmark-fill" aria-hidden="true"></i>
                    <span class="gws-nav-link-copy"><span>Sentinel</span><small>Knowledge workspace</small></span>
                </NavLink>
                <NavLink class="gws-nav-link" href="admin/mind-maps" title="Mind Maps">
                    <i class="bi bi-diagram-2-fill" aria-hidden="true"></i>
                    <span class="gws-nav-link-copy"><span>Mind Maps</span><small>Visual outlines and roadmaps</small></span>
                </NavLink>
            </section>

            <section class="gws-workspace" id="gws-ws-intelligence" data-workspace="intelligence" data-workspace-label="Intelligence"
                     aria-label="Intelligence" hidden="@(!IsWorkspace("intelligence"))">
                <h2 class="gws-workspace-title">Intelligence</h2>
                <NavLink class="gws-nav-link" href="admin/news-intelligence" title="Media Watch">
                    <i class="bi bi-newspaper" aria-hidden="true"></i>
                    <span class="gws-nav-link-copy"><span>Media Watch</span><small>SentinelGPT-curated feeds</small></span>
                </NavLink>
                <NavLink class="gws-nav-link" href="admin/world-news" title="World News">
                    <i class="bi bi-globe-europe-africa" aria-hidden="true"></i>
                    <span class="gws-nav-link-copy"><span>World News</span><small>Every story, every language, grouped</small></span>
                </NavLink>
                <NavLink class="gws-nav-link" href="admin/government-intelligence" title="Civic Watch">
                    <i class="bi bi-building" aria-hidden="true"></i>
                    <span class="gws-nav-link-copy"><span>Civic Watch</span><small>Community and government</small></span>
                </NavLink>
                <NavLink class="gws-nav-link" href="admin/business-intelligence" title="Business Intelligence">
                    <i class="bi bi-bar-chart-line-fill" aria-hidden="true"></i>
                    <span class="gws-nav-link-copy"><span>BI Dashboards</span><small>Build and pin custom reports</small></span>
                </NavLink>
                <NavLink class="gws-nav-link" href="admin/osint" title="Overwatch" data-enhance-nav="false">
                    <i class="bi bi-globe2" aria-hidden="true"></i>
                    <span class="gws-nav-link-copy"><span>Overwatch</span><small>Live public cameras + weather</small></span>
                </NavLink>
                <NavLink class="gws-nav-link" href="admin/threat-intel" title="Threat Intelligence">
                    <i class="bi bi-shield-exclamation" aria-hidden="true"></i>
                    <span class="gws-nav-link-copy"><span>Threat Intelligence</span><small>Exploited CVEs, malware, breaches, lookups</small></span>
                </NavLink>
            </section>

            <section class="gws-workspace" id="gws-ws-growth" data-workspace="growth" data-workspace-label="Growth &amp; Monetization"
                     aria-label="Growth &amp; Monetization" hidden="@(!IsWorkspace("growth"))">
                <h2 class="gws-workspace-title">Growth &amp; Monetization</h2>
                <NavLink class="gws-nav-link" href="admin/growth" title="Growth Studio">
                    <i class="bi bi-activity" aria-hidden="true"></i>
                    <span class="gws-nav-link-copy"><span>Growth Studio</span><small>Analytics and social publishing</small></span>
                </NavLink>
                <a class="@AppLinkClass(AdminApps.Affiliate)" href="@AdminApps.Affiliate.Href" aria-current="@AppCurrent(AdminApps.Affiliate)" title="Affiliate">
                    <i class="bi @AdminApps.Affiliate.Icon" aria-hidden="true"></i>
                    <span class="gws-nav-link-copy"><span>Affiliate</span><small>@AdminApps.Affiliate.Description</small></span>
                </a>
            </section>

            <section class="gws-workspace" id="gws-ws-platform" data-workspace="platform" data-workspace-label="Platform"
                     aria-label="Platform" hidden="@(!IsWorkspace("platform"))">
                <h2 class="gws-workspace-title">Platform</h2>
                <NavLink class="gws-nav-link" href="admin/automation" title="Workflow Automation">
                    <i class="bi bi-diagram-3-fill" aria-hidden="true"></i>
                    <span class="gws-nav-link-copy"><span>Automation</span><small>Build and run workflows</small></span>
                </NavLink>
                <NavLink class="gws-nav-link" href="admin/docker-health" title="Docker Management">
                    <i class="bi bi-box-seam" aria-hidden="true"></i>
                    <span class="gws-nav-link-copy"><span>Docker</span><small>Containers and deployment</small></span>
                    @if (_unreadDockerAlertCount > 0) { <span class="gws-nav-count gws-nav-count-danger">@_unreadDockerAlertCount</span> }
                </NavLink>
                <NavLink class="gws-nav-link" href="admin/dev-tools" title="Developer Tools">
                    <i class="bi bi-tools" aria-hidden="true"></i>
                    <span class="gws-nav-link-copy"><span>Dev Tools</span><small>Encoders, generators, and testers</small></span>
                </NavLink>
                <NavLink class="gws-nav-link" href="admin/security-audit" title="Security Audit">
                    <i class="bi bi-shield-check" aria-hidden="true"></i>
                    <span class="gws-nav-link-copy"><span>Security Audit</span><small>Authentication and access evidence</small></span>
                </NavLink>
                <NavLink class="gws-nav-link" href="admin/privacy-operations" title="Privacy Operations">
                    <i class="bi bi-person-lock" aria-hidden="true"></i>
                    <span class="gws-nav-link-copy"><span>Privacy Operations</span><small>Requests, retention, and incidents</small></span>
                </NavLink>
            </section>

        }
    </div>

    @* Every tab of a merged app (AdminApps) stays findable in ⌘K under its own name: app.js
       reads these hidden entries alongside the sidebar links (including the ones in workspaces
       not currently shown). Same visibility as the entries; Settings is here because its rail
       button isn't a sidebar link, and Mission Control because it is now the dashboard. *@
    <div class="gws-command-extras" hidden>
        @foreach (var (app, visible) in CommandApps)
        {
            if (!visible) continue;
            foreach (var tab in app.TabsFor(_role))
            {
                <a class="gws-command-extra" href="@tab.Href" data-command-group="@app.Label">
                    <i class="bi @tab.Icon" aria-hidden="true"></i>
                    <span class="gws-nav-link-copy"><span>@tab.Label</span><small>@tab.Description</small></span>
                </a>
            }
        }
        @if (IsAdmin)
        {
            <a class="gws-command-extra" href="admin/cms-knowledge" data-command-group="Pages">
                <i class="bi bi-journal-richtext" aria-hidden="true"></i>
                <span class="gws-nav-link-copy"><span>Builder Reference</span><small>CMS workflow notes</small></span>
            </a>
            @* Mission Control's status strip lives on the dashboard; its old address redirects there. *@
            <a class="gws-command-extra" href="admin" data-command-group="Home">
                <i class="bi bi-speedometer2" aria-hidden="true"></i>
                <span class="gws-nav-link-copy"><span>Mission Control</span><small>System status on the dashboard</small></span>
            </a>
            <a class="gws-command-extra" href="admin/settings" data-command-group="General">
                <i class="bi bi-gear-fill" aria-hidden="true"></i>
                <span class="gws-nav-link-copy"><span>Settings</span><small>Portal preferences</small></span>
            </a>
        }
    </div>
</nav>

@code {
    private IReadOnlyList<string> _hiddenNavKeys = [];
    private string _workspace = NavMenuGroups.Home.Key;

    // Hidden, not disabled: the route still resolves, so an existing bookmark keeps working and
    // turning a feature back on is a checkbox in Settings rather than a deploy.
    private bool Shown(string featureKey) =>
        !_hiddenNavKeys.Contains(featureKey, StringComparer.OrdinalIgnoreCase);

    private string _role = string.Empty;
    private bool IsNativeApp { get; set; }
    private int _pendingCommentCount;
    private int _unreadDockerAlertCount;
    private int _pendingDraftCount;
    private int _dueFollowUpCount;
    private int _pendingAppGenerationCount;
    private int _unreadFormSubmissionCount;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _role = state.User.FindFirst(ClaimTypes.Role)?.Value ?? string.Empty;
        IsNativeApp = state.User.HasClaim(claim => claim.Type == "amr" && claim.Value is "device-secret" or "device-key");

        // A page in a workspace this role can't see (reached by its address) shows Home instead.
        var workspace = NavMenuGroups.WorkspaceFor(Navigation.ToBaseRelativePath(Navigation.Uri));
        _workspace = VisibleWorkspaces.Contains(workspace) ? workspace.Key : NavMenuGroups.Home.Key;
        if (state.User.Identity?.IsAuthenticated != true) return;

        // Nav visibility is a display preference, so a settings failure must never take the whole
        // menu down - on error everything simply stays visible.
        try
        {
            var settings = await SiteSettingsService.GetSettingsAsync();
            _hiddenNavKeys = AdminFeatures.Parse(settings.HiddenNavKeys);
        }
        catch (Exception)
        {
            _hiddenNavKeys = [];
        }

        var summary = await SummaryService.GetAsync(IsAdmin);
        _pendingCommentCount = summary.PendingComments;
        _unreadDockerAlertCount = summary.UnreadSystemAlerts;
        _pendingDraftCount = summary.PendingDrafts;
        _dueFollowUpCount = summary.DueFollowUps;
        _pendingAppGenerationCount = summary.PendingAppApprovals;
        _unreadFormSubmissionCount = summary.UnreadFormSubmissions;
    }

    // Non-admins see Home and the Content pages their role can use, as before the rail.
    private IEnumerable<NavWorkspace> VisibleWorkspaces =>
        NavMenuGroups.Workspaces.Where(workspace => !workspace.AdminOnly || IsAdmin);

    private bool IsWorkspace(string key) => _workspace == key;

    // A merged app's entry is current on any of its tabs' pages; NavLink only matches its own href.
    private string AppLinkClass(AdminApp app) =>
        app.Contains(Navigation.ToBaseRelativePath(Navigation.Uri)) ? "gws-nav-link active" : "gws-nav-link";

    private string? AppCurrent(AdminApp app) =>
        app.Contains(Navigation.ToBaseRelativePath(Navigation.Uri)) ? "page" : null;

    private IEnumerable<(AdminApp App, bool Visible)> CommandApps =>
    [
        (AdminApps.Community, true),
        (AdminApps.Crm, IsAdmin && Shown("crm")),
        (AdminApps.PageBuilder, Shown("app-generation")),
        (AdminApps.SiteDesign, IsContributorOrAbove),
        (AdminApps.Affiliate, IsAdmin)
    ];

    private bool IsAdmin => _role == AppRoles.Admin;
    private bool IsContributorOrAbove => _role is AppRoles.Admin or AppRoles.Contributor;
}
