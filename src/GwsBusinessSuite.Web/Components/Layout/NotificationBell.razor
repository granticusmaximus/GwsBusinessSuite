@using GwsBusinessSuite.Application.DockerHealth
@using GwsBusinessSuite.Application.Growth
@implements IDisposable
@inject IDockerHealthService DockerHealthService
@inject DockerHealthNotifier DockerNotifier
@inject ISocialPublishingService SocialPublishingService
@inject SocialPublishingNotifier SocialNotifier
@inject GwsBusinessSuite.Application.Community.IChatService ChatService
@inject GwsBusinessSuite.Application.Community.ChatNotifier ChatNotifier
@inject GwsBusinessSuite.Infrastructure.Services.OverwatchAreaService OverwatchAreaService
@inject GwsBusinessSuite.Infrastructure.Services.OverwatchAreaNotifier OverwatchAreaNotifier
@inject GwsBusinessSuite.Application.Abstractions.ICurrentUserAccessor CurrentUserAccessor
@inject NavigationManager Navigation
@inject ILogger<NotificationBell> Logger

@if (IsOpen)
{
    @* Transparent full-screen layer under the panel: a click anywhere outside the panel lands
       here and closes it, instead of the panel staying open until the bell is clicked again. *@
    <div class="notif-bell-backdrop" @onclick="Close"></div>
}
<div class="notif-bell-wrap" @onkeydown="OnKeyDown">
    <button type="button" class="notif-bell-btn" @onclick="ToggleOpen" title="Notifications"
            aria-label="Notifications" aria-expanded="@IsOpen">
        <i class="bi bi-bell-fill" aria-hidden="true"></i>
        @if (UnreadCount > 0)
        {
            <span class="notif-bell-badge">@(UnreadCount > 9 ? "9+" : UnreadCount.ToString())</span>
        }
    </button>

    @if (IsOpen)
    {
        <div class="notif-bell-panel">
            <div class="notif-bell-panel-header">
                <span>Notifications</span>
                @if (UnreadCount > 0)
                {
                    <button type="button" class="notif-bell-mark-all" @onclick="MarkAllReadAsync">Mark all as read</button>
                }
            </div>
            @if (RecentAlerts.Count == 0)
            {
                <div class="notif-bell-empty">No alerts.</div>
            }
            else
            {
                @foreach (var alert in RecentAlerts)
                {
                    <div class="notif-bell-item @(alert.IsRead ? "" : "notif-bell-item-unread")">
                        @* A real link to the alert's page rather than href="javascript:void(0)": the
                           production CSP blocks javascript: URLs, so whenever the Blazor handler
                           didn't intercept the click, nothing happened at all. *@
                        <a href="@alert.NavigateTo" class="notif-bell-item-link"
                           @onclick="() => OpenAlertAsync(alert)" @onclick:preventDefault>
                            <div class="notif-bell-item-title">@alert.Title</div>
                            <div class="notif-bell-item-message">@alert.Message</div>
                            <div class="notif-bell-item-time">@alert.CreatedAt.ToLocalTime().ToString("MMM d, h:mm tt")</div>
                        </a>
                        @if (!alert.IsRead)
                        {
                            <button type="button" class="notif-bell-mark-read" title="Mark as read"
                                    @onclick="() => MarkReadAsync(alert)" @onclick:stopPropagation>
                                <i class="bi bi-check2"></i>
                            </button>
                        }
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    // Merges alerts from every subsystem that has one (currently Docker container health and
    // scheduled social-post failures) into a single bell rather than one bell per subsystem.
    // Each source keeps its own storage/service (DockerHealthAlert / SocialPostAlert) - this
    // is purely a display-layer merge, identified by Kind so mark-read/navigate dispatch to
    // the right backing service.
    private sealed record BellAlert(
        string Kind, Guid Id, string Title, string Message, bool IsRead, DateTimeOffset CreatedAt, string NavigateTo);

    private bool IsOpen { get; set; }
    private int UnreadCount { get; set; }
    private List<BellAlert> RecentAlerts { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        var dockerUnread = await DockerHealthService.CountUnreadAlertsAsync();
        var socialUnread = await SocialPublishingService.CountUnreadAlertsAsync();

        var dockerAlerts = (await DockerHealthService.ListAlertsAsync(unreadOnly: false)).Select(ToBellAlert);
        var socialAlerts = (await SocialPublishingService.ListAlertsAsync(unreadOnly: false)).Select(ToBellAlert);
        var chatAlerts = await LoadChatAlertsAsync();
        var (overwatchUnread, overwatchAlerts) = await LoadOverwatchAlertsAsync();
        UnreadCount = dockerUnread + socialUnread + chatAlerts.Count + overwatchUnread;
        RecentAlerts = dockerAlerts.Concat(socialAlerts).Concat(chatAlerts).Concat(overwatchAlerts).OrderByDescending(a => a.CreatedAt).Take(10).ToList();

        DockerNotifier.OnAlert += HandleDockerAlert;
        SocialNotifier.OnAlert += HandleSocialAlert;
        ChatNotifier.OnMessage += HandleChatMessage;
        OverwatchAreaNotifier.OnAlert += HandleOverwatchAlert;
    }

    // Overwatch watched-area alerts (per admin). LoadChatAlertsAsync has already set _currentUsername.
    private async Task<(int Unread, List<BellAlert> Alerts)> LoadOverwatchAlertsAsync()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(_currentUsername)) return (0, []);
            var unread = await OverwatchAreaService.CountUnreadAlertsAsync(_currentUsername);
            var alerts = (await OverwatchAreaService.ListAlertsAsync(_currentUsername)).Select(ToBellAlert).ToList();
            return (unread, alerts);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Couldn't load Overwatch area alerts for the bell.");
            return (0, []);
        }
    }

    private static BellAlert ToBellAlert(GwsBusinessSuite.Infrastructure.Services.OverwatchAreaAlertView alert) => new(
        "overwatch", alert.Id, alert.Title, alert.Message, alert.IsRead, alert.CreatedAt, $"/admin/osint?area={alert.AreaId}");

    private void HandleOverwatchAlert(string username, GwsBusinessSuite.Infrastructure.Services.OverwatchAreaAlertView alert)
    {
        if (!string.Equals(username, _currentUsername, StringComparison.OrdinalIgnoreCase)) return;
        AddAlert(ToBellAlert(alert));
    }

    private static BellAlert ToBellAlert(DockerHealthAlertView alert) => new(
        "docker", alert.Id, alert.ContainerName, alert.Message, alert.IsRead, alert.CreatedAt,
        $"/admin/docker-health/{Uri.EscapeDataString(alert.ContainerName)}");

    private static BellAlert ToBellAlert(SocialPostAlertView alert) => new(
        "social", alert.Id, alert.PostTitle, alert.Message, alert.IsRead, alert.CreatedAt,
        "/admin/growth");

    private string _currentUsername = string.Empty;

    // Community messages: one bell entry per conversation with unread messages (opening the
    // conversation is what marks it read).
    private async Task<List<BellAlert>> LoadChatAlertsAsync()
    {
        try
        {
            _currentUsername = await CurrentUserAccessor.GetCurrentUsernameAsync();
            if (string.IsNullOrWhiteSpace(_currentUsername)) return [];
            return (await ChatService.ListThreadsForUserAsync(_currentUsername))
                .Where(t => t.UnreadCount > 0)
                .Select(t => new BellAlert("chat", t.ThreadId, t.Title,
                    $"{t.UnreadCount} unread · {t.LastMessagePreview}", false, t.LastMessageAt ?? DateTimeOffset.UtcNow,
                    $"/admin/community/messages/{t.ThreadId}"))
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Couldn't load unread chat messages for the bell.");
            return [];
        }
    }

    private void HandleChatMessage(GwsBusinessSuite.Application.Community.ChatMessageNotice notice)
    {
        if (!notice.RecipientUsernames.Contains(_currentUsername, StringComparer.OrdinalIgnoreCase)) return;
        // Don't ping about the conversation the user is looking at right now.
        if (Navigation.Uri.Contains($"/admin/community/messages/{notice.ThreadId}", StringComparison.OrdinalIgnoreCase)) return;
        _ = InvokeAsync(() =>
        {
            var existing = RecentAlerts.FindIndex(a => a.Kind == "chat" && a.Id == notice.ThreadId);
            var wasUnread = existing >= 0 && !RecentAlerts[existing].IsRead;
            if (existing >= 0) RecentAlerts.RemoveAt(existing);
            var label = notice.IsGroup ? $"{notice.SenderDisplayName}: {notice.Preview}" : notice.Preview;
            RecentAlerts.Insert(0, new BellAlert("chat", notice.ThreadId, notice.ThreadTitle, label, false, notice.SentAt,
                $"/admin/community/messages/{notice.ThreadId}"));
            if (RecentAlerts.Count > 10) RecentAlerts.RemoveAt(RecentAlerts.Count - 1);
            if (!wasUnread) UnreadCount++;
            StateHasChanged();
        });
    }

    private void HandleDockerAlert(DockerHealthAlertView alert) => AddAlert(ToBellAlert(alert));

    private void HandleSocialAlert(SocialPostAlertView alert) => AddAlert(ToBellAlert(alert));

    private void AddAlert(BellAlert alert)
    {
        _ = InvokeAsync(() =>
        {
            RecentAlerts.Insert(0, alert);
            if (RecentAlerts.Count > 10) RecentAlerts.RemoveAt(RecentAlerts.Count - 1);
            UnreadCount++;
            StateHasChanged();
        });
    }

    private void ToggleOpen()
    {
        IsOpen = !IsOpen;
    }

    private void Close() => IsOpen = false;

    private void OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            IsOpen = false;
        }
    }

    private async Task MarkReadAsync(BellAlert alert)
    {
        if (alert.IsRead)
        {
            return;
        }

        if (alert.Kind == "docker") await DockerHealthService.MarkAlertReadAsync(alert.Id);
        else if (alert.Kind == "chat") { /* opening the conversation marks it read */ }
        else if (alert.Kind == "overwatch") await OverwatchAreaService.MarkAlertReadAsync(_currentUsername, alert.Id);
        else await SocialPublishingService.MarkAlertReadAsync(alert.Id);

        var index = RecentAlerts.FindIndex(a => a.Kind == alert.Kind && a.Id == alert.Id);
        if (index >= 0)
        {
            RecentAlerts[index] = alert with { IsRead = true };
        }

        UnreadCount = Math.Max(0, UnreadCount - 1);
    }

    private async Task MarkAllReadAsync()
    {
        await DockerHealthService.MarkAllAlertsReadAsync();
        await SocialPublishingService.MarkAllAlertsReadAsync();
        if (!string.IsNullOrWhiteSpace(_currentUsername))
        {
            await OverwatchAreaService.MarkAllAlertsReadAsync(_currentUsername);
            foreach (var chat in RecentAlerts.Where(a => a.Kind == "chat" && !a.IsRead))
            {
                await ChatService.MarkThreadReadAsync(chat.Id, _currentUsername);
            }
        }
        RecentAlerts = RecentAlerts.Select(a => a.IsRead ? a : a with { IsRead = true }).ToList();
        UnreadCount = 0;
    }

    private async Task OpenAlertAsync(BellAlert alert)
    {
        // Opening the alert matters more than its read flag - a failed mark-read must neither
        // block the navigation nor, unhandled, take down the circuit every other admin page's
        // buttons share.
        try
        {
            if (!alert.IsRead)
            {
                await MarkReadAsync(alert);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Marking {Kind} alert {AlertId} read failed; opening it anyway.", alert.Kind, alert.Id);
        }

        IsOpen = false;
        // Overwatch loads its globe script from the page itself, which only runs on a full page
        // load (the sidebar link sets data-enhance-nav="false" for the same reason) - an in-app
        // navigation would leave tacticalGlobe undefined and crash the circuit.
        Navigation.NavigateTo(alert.NavigateTo, forceLoad: alert.Kind == "overwatch");
    }

    public void Dispose()
    {
        DockerNotifier.OnAlert -= HandleDockerAlert;
        SocialNotifier.OnAlert -= HandleSocialAlert;
        ChatNotifier.OnMessage -= HandleChatMessage;
        OverwatchAreaNotifier.OnAlert -= HandleOverwatchAlert;
    }
}
