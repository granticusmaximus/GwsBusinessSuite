@implements IAsyncDisposable
@using GwsBusinessSuite.Application.Abstractions
@using GwsBusinessSuite.Application.Assistant
@using GwsBusinessSuite.Application.SentinelAgent
@using GwsBusinessSuite.Domain.Entities
@using GwsBusinessSuite.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject AssistantContext Assistant
@inject RightPanelState RightPanels
@inject SentinelAgentRunner AgentRunner
@inject SentinelAgentRelay AgentRelay
@inject SentinelGptGenerationCoordinator Coordinator
@inject AuthenticationStateProvider AuthState
@inject ICurrentUserAccessor CurrentUserAccessor
@inject NavigationManager Navigation
@inject IJSRuntime JS

@* One SentinelGPT panel for every admin page. Since 30-10-26 it's an agent: asked to do
   something, it researches, then acts through the app's own services as this user (only what
   their role allows), and each change shows with Open and Undo; deleting and publishing wait for
   a Confirm. It knows what the page shows (title, heading, text, the selection, the record from
   AssistantContext) and what this chat has changed. The agent thinks on this computer's Ollama
   (the Mac app's bridge, or a browser Ollama allows); with no model there that uses tools, the
   server's SentinelGPT answers questions but doesn't act, since its small model claimed changes
   it never made in the 30-10-26 live check. A draft answer still only lands in the page through
   the page's own "Use..." button. *@
<button type="button" class="gws-assistant-toggle @(_open ? "is-active" : string.Empty)" @onclick="ToggleAsync"
        title="SentinelGPT" aria-label="SentinelGPT assistant" aria-expanded="@(_open ? "true" : "false")" aria-controls="gws-assistant">
    <i class="bi bi-stars" aria-hidden="true"></i>
</button>
@if (_open)
{
    <aside id="gws-assistant" class="gws-assistant" aria-label="SentinelGPT assistant">
        <header class="gws-assistant-head">
            <div class="gws-assistant-title">
                <div class="fw-semibold"><i class="bi bi-stars me-1" aria-hidden="true"></i>SentinelGPT</div>
                <div class="gws-assistant-context" title="@ContextLabel">@ContextLabel</div>
            </div>
            <a class="btn btn-sm btn-outline-secondary" href="admin/sentinelgpt/activity" title="What SentinelGPT did" aria-label="What SentinelGPT did">
                <i class="bi bi-clock-history" aria-hidden="true"></i>
            </a>
            @if (_turns.Count > 0)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="NewChat" disabled="@_busy">New chat</button>
            }
            <button type="button" class="btn-close" aria-label="Close assistant" @onclick="Close"></button>
        </header>

        <div class="gws-assistant-thread" @ref="_thread" aria-live="polite">
            @if (_turns.Count == 0)
            {
                <p class="gws-assistant-intro">Ask about this page, or tell me what to do: make a to-do list, add a card to a board, draft a site page. I look things up first, then do it. Changes come with Undo; deleting and publishing wait for your Confirm. Doing things uses your Mac's model, in the Mac app; elsewhere I answer questions.</p>
            }
            @foreach (var turn in _turns)
            {
                <div class="gws-assistant-question">@turn.Question</div>
                <div class="gws-assistant-answer">
                    @if (turn.Steps.Count > 0)
                    {
                        <ol class="gws-assistant-steps" aria-label="What SentinelGPT did">
                            @foreach (var step in turn.Steps)
                            {
                                <li>@step</li>
                            }
                        </ol>
                    }
                    @if (turn.Answer.Length > 0)
                    {
                        <div class="gws-assistant-text">@((MarkupString)AssistantMarkdown.ToSafeHtml(turn.Answer))</div>
                    }
                    @foreach (var action in turn.Actions.Where(action => action.Tool == SentinelAgentRunner.PlanToolName))
                    {
                        <div class="gws-assistant-action gws-assistant-plan is-@action.Status">
                            <div class="gws-assistant-plan-head"><i class="bi bi-list-check" aria-hidden="true"></i>Plan@(PlanSuffix(action))</div>
                            <ol>
                                @foreach (var step in PlanSteps(action))
                                {
                                    <li>@step</li>
                                }
                            </ol>
                            @if (action.AwaitingConfirm)
                            {
                                <span class="gws-assistant-action-buttons">
                                    <button type="button" class="btn btn-sm btn-primary" disabled="@(_acting || _busy)" @onclick="() => ResolvePlanAsync(turn, action, true)">Go</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(_acting || _busy)" @onclick="() => ResolvePlanAsync(turn, action, false)">Cancel</button>
                                </span>
                            }
                        </div>
                    }
                    @foreach (var action in turn.Actions.Where(action => action.Tool != SentinelAgentRunner.PlanToolName))
                    {
                        <div class="gws-assistant-action is-@action.Status">
                            <i class="bi @ActionIcon(action)" aria-hidden="true"></i>
                            <span class="gws-assistant-action-text">@action.Summary@ActionSuffix(action)</span>
                            <span class="gws-assistant-action-buttons">
                                @if (action.AwaitingConfirm)
                                {
                                    <button type="button" class="btn btn-sm btn-primary" disabled="@_acting" @onclick="() => ResolveAsync(turn, action, true)">Confirm</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_acting" @onclick="() => ResolveAsync(turn, action, false)">Decline</button>
                                }
                                else
                                {
                                    @if (action.Link is not null && action.Status != SentinelAgentActionStatuses.Undone)
                                    {
                                        <a class="btn btn-sm btn-link" href="@action.Link">Open</a>
                                    }
                                    @if (action.CanUndo)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_acting" @onclick="() => UndoAsync(turn, action)">Undo</button>
                                    }
                                }
                            </span>
                        </div>
                    }
                    @if (turn.ActionError is not null)
                    {
                        <div class="gws-assistant-error">@turn.ActionError</div>
                    }
                    @if (turn.AnswersOnlyNote)
                    {
                        <div class="gws-assistant-activity">Answered on the server, which doesn't make changes. To have SentinelGPT do things, open the Mac app: it runs on your Mac's model, and while the app is open this browser can use it too.</div>
                    }
                    @if (turn.Activity is not null)
                    {
                        <div class="gws-assistant-activity"><span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>@turn.Activity</div>
                    }
                    @if (turn.Error is not null)
                    {
                        <div class="gws-assistant-error">@turn.Error</div>
                    }
                    @if (turn.Done && turn.Error is null && turn.Answer.Length > 0)
                    {
                        <div class="gws-assistant-meta">
                            <span class="gws-assistant-source">@turn.Source</span>
                            <button type="button" class="btn btn-sm btn-link" @onclick="() => CopyAsync(turn)">@(turn.Copied ? "Copied" : "Copy")</button>
                            @if (ApplyFor(turn) is { } registration)
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => ApplyAsync(turn, registration)" disabled="@turn.Applied">@(turn.Applied ? "Added to the page" : registration.ApplyLabel)</button>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        <footer class="gws-assistant-foot">
            @if (_selection.Length > 0)
            {
                <div class="gws-assistant-selection">
                    <i class="bi bi-cursor-text" aria-hidden="true"></i>
                    <span>Using your selection: &ldquo;@Preview(_selection)&rdquo;</span>
                    <button type="button" class="btn-close" aria-label="Don't use the selection" @onclick="ForgetSelectionAsync"></button>
                </div>
            }
            @if (!_busy)
            {
                <div class="gws-assistant-suggestions" role="group" aria-label="Suggested questions">
                    @foreach (var suggestion in AssistantPrompt.Suggestions(Assistant.Current?.Page, _selection.Length > 0))
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => AskAsync(suggestion)">@suggestion</button>
                    }
                </div>
            }
            <form class="gws-assistant-form" @onsubmit="SendAsync" @onsubmit:preventDefault>
                <label class="visually-hidden" for="gws-assistant-input">Ask SentinelGPT</label>
                <textarea id="gws-assistant-input" class="form-control" rows="2" maxlength="2000" placeholder="Ask, or tell SentinelGPT what to do…"
                          @bind="_input" @bind:event="oninput" @onfocus="RefreshSelectionAsync" disabled="@_busy"></textarea>
                @if (_busy)
                {
                    <button type="button" class="btn btn-outline-secondary" @onclick="Stop">Stop</button>
                }
                else
                {
                    <button type="submit" class="btn btn-primary" disabled="@string.IsNullOrWhiteSpace(_input)">Send</button>
                }
            </form>
        </footer>
    </aside>
}

@code {
    private static readonly TimeSpan LocalRetryAfter = TimeSpan.FromMinutes(5);

    private readonly List<Turn> _turns = [];
    private bool _open;
    private bool _busy;
    private string _input = string.Empty;
    private string _selection = string.Empty;
    private string _heading = string.Empty;
    private Guid _conversationId = Guid.NewGuid();
    private Guid? _generationId;
    private bool _answersOnlyNoted;
    private string? _username;
    private bool _acting;
    // The local model that last worked, tried first; ones that turned out not to use tools are skipped.
    private string? _localModel;
    private readonly HashSet<string> _skipLocal = new(StringComparer.OrdinalIgnoreCase);
    private CancellationTokenSource? _stop;
    private BrowserLocalOllamaService? _local;
    private DateTimeOffset _localUnavailableUntil;
    private ElementReference _thread;
    private bool _scrollToEnd;

    protected override void OnInitialized()
    {
        Assistant.Changed += OnContextChanged;
        Navigation.LocationChanged += OnLocationChanged;
        RightPanels.InspectorOpened += OnInspectorOpened;
    }

    // A record inspector opened: make way for it unless the screen has room for both.
    private void OnInspectorOpened() => _ = InvokeAsync(async () =>
    {
        if (!_open) return;
        try
        {
            if (await JS.InvokeAsync<bool>("gwsAssistant.wide")) return;
        }
        catch (JSException)
        {
            // Without the check, make way.
        }
        _open = false;
        RightPanels.NotifyAssistantClosed();
        StateHasChanged();
    });

    private string ContextLabel => Assistant.Current?.Page is { } page
        ? page.RecordTitle is { } title ? $"{page.PageName} · {page.RecordKind}: {title}" : page.PageName
        : _heading.Length > 0 ? _heading : "This page";

    private async Task ToggleAsync()
    {
        _open = !_open;
        if (!_open)
        {
            RightPanels.NotifyAssistantClosed();
            return;
        }
        RightPanels.NotifyAssistantOpened();
        await RefreshSelectionAsync();
    }

    private void Close()
    {
        _open = false;
        RightPanels.NotifyAssistantClosed();
    }

    private void NewChat()
    {
        _turns.Clear();
        _conversationId = Guid.NewGuid();
    }

    private Task SendAsync() => AskAsync(_input);

    private async Task AskAsync(string question)
    {
        question = question.Trim();
        if (question.Length == 0 || _busy) return;
        _busy = true;
        _input = string.Empty;
        var turn = new Turn(question) { Activity = "Reading the page…" };
        _turns.Add(turn);
        _scrollToEnd = true;
        _stop = new CancellationTokenSource();
        StateHasChanged();
        try
        {
            var capture = await JS.InvokeAsync<AssistantCapture>("gwsAssistant.capture");
            var registration = Assistant.Current;
            turn.RecordKey = registration is null ? null : RecordKey(registration);
            var context = AssistantPrompt.DescribeContext(registration?.Page, capture);
            await RunAgentAsync(turn, context, _stop.Token);
        }
        catch (OperationCanceledException)
        {
            if (turn.Answer.Length == 0) turn.Error = "Stopped.";
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException or JSException)
        {
            turn.Error = ex.Message;
        }
        finally
        {
            turn.Activity = null;
            turn.Done = true;
            _busy = false;
            _generationId = null;
            _stop?.Dispose();
            _stop = null;
            _scrollToEnd = true;
            await RefreshSelectionAsync();
        }
    }

    // The agent thinks on this computer's Ollama when it has a model that uses tools (the Mac app's
    // bridge, or a browser Ollama allows), else on this person's Mac through the relay while their
    // Mac app is open; its tools act on the server as this user either way. Otherwise the server's
    // SentinelGPT answers, without acting.
    private async Task RunAgentAsync(Turn turn, string context, CancellationToken stop)
    {
        var user = await AgentUserAsync();
        foreach (var model in await LocalCandidatesAsync(stop))
        {
            turn.Activity = $"Thinking on your local {model}…";
            StateHasChanged();
            try
            {
                await RunTurnAsync(turn, user, context, _local!, model, SentinelAgentRunner.LocalRounds, $"Local · {model}", stop);
                _localModel = model;
                return;
            }
            catch (Exception ex) when (!stop.IsCancellationRequested && turn.Actions.Count == 0
                                       && ex is JSException or InvalidOperationException or System.Text.Json.JsonException)
            {
                // A model whose template has no tools answers 400 and the next may do; anything
                // else local goes to the server, and local is left alone for a few minutes.
                if (SentinelAgentModels.IsNoToolsError(ex))
                {
                    _skipLocal.Add(model);
                    continue;
                }
                _localUnavailableUntil = DateTimeOffset.UtcNow + LocalRetryAfter;
                turn.Steps.Clear();
                break;
            }
        }

        foreach (var model in AgentRelay.ModelsFor(user.Username))
        {
            turn.Activity = $"Thinking on your Mac's {model}…";
            StateHasChanged();
            try
            {
                await RunTurnAsync(turn, user, context, new RelayedOllamaService(AgentRelay, user.Username), model,
                    SentinelAgentRunner.LocalRounds, $"Your Mac · {model}", stop);
                return;
            }
            catch (InvalidOperationException ex) when (!stop.IsCancellationRequested && turn.Actions.Count == 0)
            {
                if (SentinelAgentModels.IsNoToolsError(ex)) continue;
                turn.Steps.Clear();
                break;
            }
        }

        await AskServerAsync(turn, context, stop);
        turn.AnswersOnlyNote = !_answersOnlyNoted;
        _answersOnlyNoted = true;
    }

    // The server's SentinelGPT through the shared generation coordinator (one job per user,
    // queued with everything else that uses the server's Ollama). The page context goes along
    // as context only: it isn't stored with the conversation.
    private async Task AskServerAsync(Turn turn, string context, CancellationToken stop)
    {
        _username ??= await CurrentUserAccessor.GetCurrentUsernameAsync();
        turn.Activity = "Asking SentinelGPT on the server…";
        StateHasChanged();
        var generation = await Coordinator.StartAsync(_conversationId, wikiPageId: null, turn.Question, _username,
            includeInternet: false, useDeepAnalysis: false, pageContext: context);
        _generationId = generation.Id;
        while (true)
        {
            stop.ThrowIfCancellationRequested();
            var snapshot = Coordinator.Get(generation.Id, _username)
                ?? throw new InvalidOperationException("The SentinelGPT response is no longer available.");
            turn.Answer = snapshot.Output;
            turn.Activity = snapshot.Output.Length > 0 ? null : string.IsNullOrWhiteSpace(snapshot.Activity) ? "Thinking…" : snapshot.Activity;
            switch (snapshot.Status)
            {
                case SentinelGptGenerationStatuses.Failed:
                    throw new InvalidOperationException(snapshot.Error ?? "SentinelGPT couldn't answer.");
                case SentinelGptGenerationStatuses.Cancelled:
                    throw new OperationCanceledException();
                case SentinelGptGenerationStatuses.Completed:
                    turn.Answer = (snapshot.CompletedRun?.Output ?? snapshot.Output).Trim();
                    turn.Source = $"Server · {snapshot.CompletedRun?.Model ?? "SentinelGPT"} · answers only";
                    return;
            }
            _scrollToEnd = true;
            StateHasChanged();
            await Task.Delay(150, stop);
        }
    }

    private async Task RunTurnAsync(
        Turn turn, SentinelAgentUser user, string context, IOllamaService model, string modelName, int rounds, string source, CancellationToken stop)
    {
        var result = await AgentRunner.RunAsync(
            new SentinelAgentRequest(_conversationId, user, turn.Question, context, model, modelName, rounds),
            agentEvent => InvokeAsync(() =>
            {
                switch (agentEvent)
                {
                    case SentinelAgentStep step:
                        turn.Steps.Add(step.Text);
                        turn.Activity = step.Text + "…";
                        break;
                    case SentinelAgentActed acted:
                        turn.Upsert(acted.Action);
                        break;
                    case SentinelAgentWithdrawn withdrawn:
                        turn.Actions.RemoveAll(action => action.Id == withdrawn.ActionId);
                        break;
                }
                _scrollToEnd = true;
                StateHasChanged();
            }),
            stop);
        turn.Answer = result.Answer;
        turn.Source = source;
        RefreshIfShowing(result.Actions);
    }

    private async Task<IReadOnlyList<string>> LocalCandidatesAsync(CancellationToken stop)
    {
        if (DateTimeOffset.UtcNow < _localUnavailableUntil) return [];
        _local ??= new BrowserLocalOllamaService(JS);
        LocalOllamaStatus status;
        try
        {
            status = await _local.ProbeAsync(stop);
        }
        catch (JSException)
        {
            status = new LocalOllamaStatus(false, [], null);
        }
        var candidates = status.IsReachable
            ? SentinelAgentModels.LocalCandidates(status.Models).Where(model => !_skipLocal.Contains(model)).ToList()
            : [];
        if (candidates.Count == 0)
        {
            _localUnavailableUntil = DateTimeOffset.UtcNow + LocalRetryAfter;
            return [];
        }
        if (_localModel is not null && candidates.Remove(_localModel)) candidates.Insert(0, _localModel);
        return candidates;
    }

    private async Task<SentinelAgentUser> AgentUserAsync()
    {
        _username ??= await CurrentUserAccessor.GetCurrentUsernameAsync();
        var principal = (await AuthState.GetAuthenticationStateAsync()).User;
        return new SentinelAgentUser(_username, AppRoles.All.Where(principal.IsInRole).ToList());
    }

    // A Confirm card's answer: approving runs exactly what the card showed.
    private async Task ResolveAsync(Turn turn, SentinelAgentActionView action, bool approve)
    {
        await ActOnAsync(turn, async user => await AgentRunner.ConfirmAsync(action.Id, user, approve, CancellationToken.None));
    }

    // Go agrees the plan, then asks for it to be carried out as the next turn.
    private async Task ResolvePlanAsync(Turn turn, SentinelAgentActionView plan, bool go)
    {
        await ResolveAsync(turn, plan, go);
        if (go && turn.ActionError is null) await AskAsync(SentinelAgentRunner.GoMessage);
    }

    private static IEnumerable<string> PlanSteps(SentinelAgentActionView plan) =>
        plan.Summary.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(line => System.Text.RegularExpressions.Regex.Replace(line, @"^\d+\.\s*", string.Empty));

    private static string PlanSuffix(SentinelAgentActionView plan) => plan.Status switch
    {
        SentinelAgentActionStatuses.Done => " (started)",
        SentinelAgentActionStatuses.Declined => " (cancelled)",
        _ => string.Empty
    };

    private async Task UndoAsync(Turn turn, SentinelAgentActionView action)
    {
        await ActOnAsync(turn, async user => await AgentRunner.UndoAsync(action.Id, user, CancellationToken.None));
    }

    private async Task ActOnAsync(Turn turn, Func<SentinelAgentUser, Task<SentinelAgentActionView>> act)
    {
        if (_acting) return;
        _acting = true;
        turn.ActionError = null;
        try
        {
            var updated = await act(await AgentUserAsync());
            turn.Upsert(updated);
            RefreshIfShowing([updated]);
        }
        catch (InvalidOperationException ex)
        {
            turn.ActionError = ex.Message;
        }
        finally
        {
            _acting = false;
        }
    }

    // The page on screen is the one that just changed: show the change.
    private void RefreshIfShowing(IEnumerable<SentinelAgentActionView> actions)
    {
        var here = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (actions.Any(action => action.Link is { } link && string.Equals(link.TrimStart('/'), here, StringComparison.OrdinalIgnoreCase)))
        {
            Navigation.Refresh();
        }
    }

    private static string ActionIcon(SentinelAgentActionView action) => action.Status switch
    {
        SentinelAgentActionStatuses.AwaitingConfirm => "bi-question-circle",
        SentinelAgentActionStatuses.Undone or SentinelAgentActionStatuses.Declined => "bi-arrow-counterclockwise",
        SentinelAgentActionStatuses.Failed => "bi-exclamation-triangle",
        _ => "bi-check2-circle"
    };

    private static string ActionSuffix(SentinelAgentActionView action) => action.Status switch
    {
        SentinelAgentActionStatuses.AwaitingConfirm => "?",
        SentinelAgentActionStatuses.Undone => " (undone)",
        SentinelAgentActionStatuses.Declined => " (declined)",
        _ => string.Empty
    };

    private void Stop()
    {
        _stop?.Cancel();
        if (_generationId is { } id && _username is not null) Coordinator.Cancel(id, _username);
    }

    // A draft is only offered back to the record it was written for.
    private AssistantContext.Registration? ApplyFor(Turn turn) =>
        Assistant.Current is { Apply: not null } registration && turn.RecordKey == RecordKey(registration) ? registration : null;

    private static string RecordKey(AssistantContext.Registration registration) =>
        $"{registration.Path}|{registration.Page.RecordKind}|{registration.Page.RecordTitle}";

    private async Task ApplyAsync(Turn turn, AssistantContext.Registration registration)
    {
        await registration.Apply!(turn.Answer);
        turn.Applied = true;
    }

    private async Task CopyAsync(Turn turn)
    {
        try
        {
            await JS.InvokeVoidAsync("gwsAssistant.copy", turn.Answer);
            turn.Copied = true;
        }
        catch (JSException)
        {
            turn.Error = "Couldn't copy. Select the text and copy it instead.";
        }
    }

    // The selection, and the page heading the header falls back to when the page describes no record.
    private async Task RefreshSelectionAsync()
    {
        try
        {
            _selection = await JS.InvokeAsync<string>("gwsAssistant.selection");
            _heading = await JS.InvokeAsync<string>("gwsAssistant.heading");
        }
        catch (JSException)
        {
            _selection = string.Empty;
            _heading = string.Empty;
        }
    }

    private async Task ForgetSelectionAsync()
    {
        _selection = string.Empty;
        await JS.InvokeVoidAsync("gwsAssistant.clearSelection");
    }

    private static string Preview(string text)
    {
        var flat = string.Join(' ', text.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries));
        return flat.Length <= 60 ? flat : flat[..57] + "…";
    }

    // ⌘K's "Ask SentinelGPT" (tech-forward T1b) opens the panel and asks; app.js reaches this
    // island through the reference registered on its first render.
    private DotNetObjectReference<AssistantPanel>? _selfRef;

    [JSInvokable]
    public Task AskFromPaletteAsync(string question) => InvokeAsync(async () =>
    {
        if (!_open) await ToggleAsync();
        await AskAsync(question);
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("gwsAssistant.register", _selfRef);
            }
            catch (JSException)
            {
                // An older app.js without the hook: the palette's Ask just opens the panel.
            }
        }
        if (!_scrollToEnd || !_open) return;
        _scrollToEnd = false;
        try
        {
            await JS.InvokeVoidAsync("gwsAssistant.scrollToEnd", _thread);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private void OnContextChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        _ = InvokeAsync(async () =>
        {
            if (_open) await RefreshSelectionAsync();
            StateHasChanged();
        });

    public async ValueTask DisposeAsync()
    {
        RightPanels.NotifyAssistantClosed();
        Assistant.Changed -= OnContextChanged;
        Navigation.LocationChanged -= OnLocationChanged;
        RightPanels.InspectorOpened -= OnInspectorOpened;
        _stop?.Cancel();
        _selfRef?.Dispose();
        if (_local is not null) await _local.DisposeAsync();
    }

    private sealed class Turn(string question)
    {
        public string Question { get; } = question;
        public string Answer { get; set; } = string.Empty;
        public string? Activity { get; set; }
        public string? Error { get; set; }
        public string? Source { get; set; }
        public string? RecordKey { get; set; }
        public bool Done { get; set; }
        public bool Copied { get; set; }
        public bool Applied { get; set; }
        public List<string> Steps { get; } = [];
        public List<SentinelAgentActionView> Actions { get; } = [];
        public string? ActionError { get; set; }
        public bool AnswersOnlyNote { get; set; }

        public void Upsert(SentinelAgentActionView action)
        {
            var index = Actions.FindIndex(item => item.Id == action.Id);
            if (index >= 0) Actions[index] = action;
            else Actions.Add(action);
        }
    }
}
