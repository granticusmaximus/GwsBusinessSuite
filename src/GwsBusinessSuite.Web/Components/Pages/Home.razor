@page "/admin"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "PortalAccess")]
@using GwsBusinessSuite.Application.AdminPortal
@using GwsBusinessSuite.Application.MissionControl
@using GwsBusinessSuite.Domain.Entities
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject IAdminPortalSummaryService SummaryService
@inject IMissionControlService MissionControlService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS

<PageTitle>Dashboard · GWS Business Suite</PageTitle>

<div class="page-header gws-dashboard-header">
    <div>
        <span class="gws-eyebrow">@DateTimeOffset.Now.ToString("dddd, MMMM d")</span>
        <h1>Good @GreetingPeriod()</h1>
        <p>@DashboardDescription</p>
    </div>
    <div class="gws-dashboard-quick-actions" aria-label="Quick actions">
        <a class="btn btn-primary" href="/admin/article-editor"><i class="bi bi-pencil-square me-1" aria-hidden="true"></i>Manage posts</a>
        <a class="btn btn-outline-secondary" href="/admin/content-studio"><i class="bi bi-magic me-1" aria-hidden="true"></i>Generate draft</a>
        <button type="button" class="btn btn-outline-secondary" @onclick="OpenQuickNote">
            <i class="bi bi-stickies-fill me-1" aria-hidden="true"></i>Quick Note
        </button>
    </div>
</div>

<QuickNoteModal @bind-IsOpen="_showQuickNote" OnSaved="OnQuickNoteSaved" />

@if (!string.IsNullOrWhiteSpace(_quickNoteStatus))
{
    <div class="alert alert-success py-2 px-3 small" role="status">@_quickNoteStatus</div>
}

@if (_showCommandPaletteHint)
{
    <div class="gws-hint-banner mb-4" role="status">
        <i class="bi bi-lightbulb-fill" aria-hidden="true"></i>
        <span>Press <kbd>⌘K</kbd> (or <kbd>Ctrl</kbd>+<kbd>K</kbd>) anywhere in the portal to jump straight to a page, contact, or post.</span>
        <button type="button" class="btn-close ms-auto" aria-label="Dismiss" @onclick="DismissCommandPaletteHint"></button>
    </div>
}

<section aria-labelledby="attention-heading" class="mb-5">
    <div class="gws-section-heading">
        <div><span class="gws-eyebrow">Today</span><h2 id="attention-heading">Needs attention</h2></div>
        <span class="text-secondary small">Live operational counts</span>
    </div>
    <div class="row g-3">
        @foreach (var item in AttentionItems)
        {
            <div class="col-sm-6 col-xl-3">
                <a class="card gws-attention-card h-100 text-decoration-none" href="@item.Url">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <span class="gws-stat-icon @item.IconClass"><i class="bi @item.Icon" aria-hidden="true"></i></span>
                            <i class="bi bi-arrow-up-right gws-card-arrow" aria-hidden="true"></i>
                        </div>
                        <div class="gws-attention-count">@item.Count</div>
                        <div class="fw-semibold">@item.Title</div>
                        <div class="text-secondary small mt-1">@item.Description</div>
                    </div>
                </a>
            </div>
        }
    </div>
</section>

@if (IsAdmin && _missionControl is { } mc)
{
    <section aria-labelledby="kpi-heading" class="mb-5">
        <div class="gws-section-heading">
            <div><span class="gws-eyebrow">Business</span><h2 id="kpi-heading">At a glance</h2></div>
            <span class="text-secondary small">Generated @mc.GeneratedAt.ToLocalTime().ToString("h:mm tt")</span>
        </div>
        <div class="row g-3">
            <div class="col-md-3 col-6">
                <a class="card gws-kpi-card h-100 text-decoration-none @(mc.AutomationRecentFailureCount > 0 ? "gws-kpi-card-danger" : "")" href="/admin/automation">
                    <div class="card-body">
                        <div class="small text-secondary">Automation failures</div>
                        <div class="gws-kpi-value">@mc.AutomationRecentFailureCount</div>
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-6">
                <a class="card gws-kpi-card h-100 text-decoration-none" href="/admin/crm">
                    <div class="card-body">
                        <div class="small text-secondary">Open CRM deals</div>
                        <div class="gws-kpi-value">@mc.CrmOpenDealCount</div>
                        <div class="small text-secondary">@mc.CrmOpenDealValueUsd.ToString("C0") pipeline &middot; @mc.CrmDueFollowUpCount due</div>
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-6">
                <a class="card gws-kpi-card h-100 text-decoration-none" href="/admin/affiliate-analytics">
                    <div class="card-body">
                        <div class="small text-secondary">Affiliate clicks</div>
                        <div class="gws-kpi-value">@mc.AffiliateTotalClicks</div>
                        <div class="small text-secondary">@mc.AffiliateTotalCommissionAmount.ToString("C2") commission</div>
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-6">
                <a class="card gws-kpi-card h-100 text-decoration-none @(mc.DockerUnreadAlertCount > 0 ? "gws-kpi-card-warning" : "")" href="/admin/docker-health">
                    <div class="card-body">
                        <div class="small text-secondary">Container alerts</div>
                        <div class="gws-kpi-value">@mc.DockerUnreadAlertCount</div>
                    </div>
                </a>
            </div>
        </div>

        @if (mc.AutomationRecentFailures.Count > 0)
        {
            <div class="card border-0 shadow-sm mt-3">
                <div class="card-header bg-white border-bottom py-2 fw-semibold small"><i class="bi bi-exclamation-triangle-fill text-danger me-1"></i>Recent automation failures</div>
                <div class="list-group list-group-flush">
                    @foreach (var failure in mc.AutomationRecentFailures)
                    {
                        <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-start gap-2" href="@($"/admin/automation/{failure.WorkflowId}")">
                            <div class="min-w-0">
                                <div class="fw-semibold text-truncate">@failure.WorkflowName <span class="text-secondary fw-normal">&middot; @failure.Mode</span></div>
                                <div class="small text-secondary text-truncate">@failure.ErrorMessage</div>
                            </div>
                            <span class="small text-secondary flex-shrink-0">@(failure.FinishedAt?.ToLocalTime().ToString("MMM d, h:mm tt") ?? "")</span>
                        </a>
                    }
                </div>
            </div>
        }
    </section>
}

<section aria-labelledby="workspace-heading">
    <div class="gws-section-heading">
        <div><span class="gws-eyebrow">Workspace</span><h2 id="workspace-heading">Pick up where you left off</h2></div>
    </div>
    <div class="row g-3">
        @foreach (var module in Modules)
        {
            <div class="col-md-6 col-xl-4">
                <a class="card h-100 text-decoration-none gws-module-card" href="@module.Url">
                    <div class="card-body d-flex align-items-start gap-3">
                        <div class="gws-module-icon @module.IconClass"><i class="bi @module.Icon" aria-hidden="true"></i></div>
                        <div class="min-w-0">
                            <div class="fw-semibold mb-1">@module.Title</div>
                            <div class="text-secondary small">@module.Description</div>
                        </div>
                        <i class="bi bi-chevron-right gws-module-chevron ms-auto" aria-hidden="true"></i>
                    </div>
                </a>
            </div>
        }
    </div>
</section>

@code {
    private const string CommandPaletteHintKey = "gws-dashboard-command-hint-dismissed";

    private int _pendingDrafts;
    private int _pendingComments;
    private int _dueFollowUps;
    private int _unreadAlerts;
    private string _role = string.Empty;
    private bool _showQuickNote;
    private string _quickNoteStatus = string.Empty;
    private bool _showCommandPaletteHint;
    private MissionControlSnapshot? _missionControl;

    private void OpenQuickNote() => _showQuickNote = true;

    private void OnQuickNoteSaved() => _quickNoteStatus = "Saved to Quick Notes in Sentinel.";

    private async Task DismissCommandPaletteHint()
    {
        _showCommandPaletteHint = false;
        await JS.InvokeVoidAsync("gwsDashboardHints.dismiss", CommandPaletteHintKey);
    }

    private IReadOnlyList<AttentionItem> AttentionItems
    {
        get
        {
            var items = new List<AttentionItem>
            {
                new("Drafts to review", "Ready for editorial review", _pendingDrafts, "/admin/content-studio", "bi-file-earmark-check", "bg-primary-subtle text-primary"),
                new("Comments", "Waiting for moderation", _pendingComments, "/admin/comments", "bi-chat-left-text", "bg-info-subtle text-info")
            };

            if (IsAdmin)
            {
                items.Add(new("Follow-ups", "Due or overdue in CRM", _dueFollowUps, "/admin/crm", "bi-calendar2-check", "bg-warning-subtle text-warning"));
                items.Add(new("System alerts", "Unread container alerts", _unreadAlerts, "/admin/docker-health", "bi-heart-pulse", _unreadAlerts > 0 ? "bg-danger-subtle text-danger" : "bg-success-subtle text-success"));
            }

            return items;
        }
    }

    private IReadOnlyList<DashboardModule> Modules
    {
        get
        {
            var modules = new List<DashboardModule>
            {
                new("Publishing", "Write posts, generate drafts, and moderate reader comments.", "/admin/article-editor", "bi-pencil-square", "bg-primary-subtle text-primary")
            };

            if (IsContributorOrAbove)
            {
                modules.Add(new("Site design", "Manage media, pages, menus, and the public-site appearance.", "/admin/pages", "bi-layout-three-columns", "bg-success-subtle text-success"));
                modules.Add(new("Podcasts", "Organize saved shows, episodes, and listening progress.", "/admin/podcasts", "bi-mic-fill", "bg-warning-subtle text-warning"));
            }

            if (IsAdmin)
            {
                modules.Add(new("Relationships", "Manage contacts, follow-ups, comments, and portal users.", "/admin/crm", "bi-people-fill", "bg-info-subtle text-info"));
                modules.Add(new("Intelligence", "Monitor media, community news, and government activity.", "/admin/news-intelligence", "bi-newspaper", "bg-warning-subtle text-warning"));
                modules.Add(new("Affiliate revenue", "Manage CJ campaigns, placement suggestions, and analytics.", "/admin/affiliate-analytics", "bi-graph-up-arrow", "bg-success-subtle text-success"));
                modules.Add(new("Sentinel", "Open your connected workspace for documents, databases, and operational knowledge.", "/admin/sentinel", "bi-journal-bookmark-fill", "bg-secondary-subtle text-secondary"));
                modules.Add(new("Operations", "Review containers, SentinelGPT models, broadcasts, and deployments.", "/admin/docker-health", "bi-box-seam", "bg-danger-subtle text-danger"));
            }

            return modules;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _role = authenticationState.User.FindFirst(ClaimTypes.Role)?.Value ?? string.Empty;

        var summary = await SummaryService.GetAsync(includeAdminMetrics: IsAdmin);
        _pendingDrafts = summary.PendingDrafts;
        _pendingComments = summary.PendingComments;
        _dueFollowUps = summary.DueFollowUps;
        _unreadAlerts = summary.UnreadSystemAlerts;

        if (IsAdmin)
        {
            _missionControl = await MissionControlService.GetSnapshotAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var dismissed = await JS.InvokeAsync<bool>("gwsDashboardHints.isDismissed", CommandPaletteHintKey);
        if (!dismissed)
        {
            _showCommandPaletteHint = true;
            StateHasChanged();
        }
    }

    private string DashboardDescription => IsAdmin
        ? "Here’s what needs your attention across the business today."
        : "Here’s what needs your attention in your publishing workspace today.";

    private bool IsAdmin => _role == AppRoles.Admin;
    private bool IsContributorOrAbove => _role is AppRoles.Admin or AppRoles.Contributor;

    private static string GreetingPeriod()
    {
        var hour = DateTime.Now.Hour;
        if (hour < 12) return "morning";
        return hour < 18 ? "afternoon" : "evening";
    }

    private sealed record AttentionItem(string Title, string Description, int Count, string Url, string Icon, string IconClass);
    private sealed record DashboardModule(string Title, string Description, string Url, string Icon, string IconClass);
}

<script src="js/dashboard-hints.js"></script>
