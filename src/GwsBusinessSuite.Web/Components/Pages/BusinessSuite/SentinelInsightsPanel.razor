@using GwsBusinessSuite.Application.Abstractions
@using GwsBusinessSuite.Application.Wiki
@inject ISentinelInsightsService Insights
@inject ICurrentUserAccessor CurrentUserAccessor
@inject ILogger<SentinelInsightsPanel> Logger

@* Workspace insights (items 21-23). *@
<div class="sentinel-ask sentinel-insights" role="dialog" aria-label="Workspace insights">
    <div class="sentinel-ask-header">
        <strong><i class="bi bi-bar-chart-line me-1" aria-hidden="true"></i>Insights</strong>
        <button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="() => OnClose.InvokeAsync()"></button>
    </div>
    <div class="btn-group btn-group-sm w-100 mb-2" role="tablist">
        @foreach (var (key, label) in Tabs)
        {
            <button type="button" role="tab" class="btn @(_tab == key ? "btn-secondary" : "btn-outline-secondary")" aria-selected="@(_tab == key ? "true" : "false")" @onclick="() => SelectAsync(key)">@label</button>
        }
    </div>
    @if (_loading)
    {
        <p class="text-secondary small">Loading...</p>
    }
    else if (_tab == "tags")
    {
        @if (_tag is { } selected)
        {
            <button type="button" class="btn btn-link btn-sm p-0 mb-2" @onclick="() => { _tag = null; }"><i class="bi bi-arrow-left me-1"></i>All tags</button>
            <div class="fw-semibold mb-1">#@selected</div>
            @Pages(_tagged.Select(p => (p.Id, p.Title, p.Icon, string.Join(" ", p.Tags.Select(t => "#" + t)))), "Nothing you can see has this tag.")
        }
        else if (_tags.Count == 0)
        {
            <p class="text-secondary small">No tags yet. Write #tag in a page, or add one under its title. Nest them like #client/acme.</p>
        }
        else
        {
            <ul class="list-unstyled mb-0">
                @foreach (var tag in _tags)
                {
                    <li style="padding-left:@(tag.Tag.Count(c => c == '/') * 1)rem">
                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" @onclick="() => OpenTagAsync(tag.Tag)">#@tag.Tag.Split('/').Last()</button>
                        <span class="text-secondary small">@tag.Pages</span>
                    </li>
                }
            </ul>
        }
    }
    else if (_tab == "most")
    {
        @Pages(_read.Select(p => (p.Id, p.Title, p.Icon, $"{p.Views} views · {p.Viewers} {(p.Viewers == 1 ? "person" : "people")}")), "No page has been opened in the last 30 days.")
    }
    else if (_tab == "never")
    {
        <p class="small text-secondary mb-1">Pages over @SentinelGaps.NeverReadAfterDays days old that nobody has opened.</p>
        @Pages(_read.Select(p => (p.Id, p.Title, p.Icon, "")), "Every page has been read at least once.")
    }
    else
    {
        <p class="small text-secondary mb-1">Questions asked with <strong>Ask</strong> that the workspace couldn't answer, grouped by topic.</p>
        @if (_gaps.Count == 0)
        {
            <p class="text-secondary small">No unanswered questions.</p>
        }
        @foreach (var gap in _gaps)
        {
            <div class="sentinel-gap">
                <div class="d-flex justify-content-between align-items-center gap-2">
                    <strong>@gap.Topic</strong>
                    <span class="text-secondary small">@gap.Asks @(gap.Asks == 1 ? "ask" : "asks") · @gap.LastAskedAt.ToLocalGwsDate()</span>
                </div>
                <ul class="small mb-1">
                    @foreach (var question in gap.Questions.Take(4))
                    {
                        <li>@question</li>
                    }
                </ul>
                <button type="button" class="btn btn-sm btn-outline-primary" disabled="@_busy" @onclick="() => WriteAsync(gap)">Write this page</button>
            </div>
        }
    }
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="small text-danger mt-2" role="alert">@_error</div>
    }
</div>

@code {
    [Parameter] public string? InitialTag { get; set; }
    [Parameter] public EventCallback<Guid> OnOpenPage { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private static readonly (string Key, string Label)[] Tabs = [("tags", "Tags"), ("most", "Most read"), ("never", "Never read"), ("gaps", "Gaps")];
    private string _tab = "tags";
    private string? _tag;
    private IReadOnlyList<SentinelTagCount> _tags = [];
    private IReadOnlyList<SentinelTaggedPage> _tagged = [];
    private IReadOnlyList<SentinelReadPage> _read = [];
    private IReadOnlyList<SentinelKnowledgeGap> _gaps = [];
    private bool _loading;
    private bool _busy;
    private string? _error;
    private string? _openedFor = "\0";

    protected override async Task OnParametersSetAsync()
    {
        if (_openedFor == InitialTag) return;
        _openedFor = InitialTag;
        await SelectAsync("tags");
        if (InitialTag is { Length: > 0 } tag) await OpenTagAsync(tag);
    }

    private async Task SelectAsync(string tab)
    {
        (_tab, _tag, _error, _loading) = (tab, null, null, true);
        try
        {
            var username = await CurrentUserAccessor.GetCurrentUsernameAsync();
            switch (tab)
            {
                case "tags": _tags = await Insights.ListTagsAsync(username); break;
                case "most": _read = await Insights.ListMostReadAsync(username); break;
                case "never": _read = await Insights.ListNeverReadAsync(username); break;
                default: _gaps = await Insights.ListKnowledgeGapsAsync(username); break;
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "Loading insights failed");
            _error = "This couldn't be loaded just now.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenTagAsync(string tag)
    {
        _tag = tag;
        _tagged = await Insights.ListTaggedPagesAsync(tag, await CurrentUserAccessor.GetCurrentUsernameAsync());
    }

    private async Task WriteAsync(SentinelKnowledgeGap gap)
    {
        _busy = true;
        try
        {
            var pageId = await Insights.WriteGapPageAsync(gap, await CurrentUserAccessor.GetCurrentUsernameAsync());
            _gaps = _gaps.Where(g => g != gap).ToList();
            await OnOpenPage.InvokeAsync(pageId);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "Writing a knowledge gap page failed");
            _error = "The page couldn't be created. Try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    private RenderFragment Pages(IEnumerable<(Guid Id, string Title, string? Icon, string Detail)> pages, string empty) => __builder =>
    {
        var list = pages.ToList();
        if (list.Count == 0)
        {
            <p class="text-secondary small">@empty</p>
            return;
        }
        <div class="list-group list-group-flush">
            @foreach (var item in list)
            {
                <button type="button" class="list-group-item list-group-item-action text-start px-0" @onclick="() => OnOpenPage.InvokeAsync(item.Id)">
                    <div class="small fw-semibold">@(item.Icon is { Length: > 0 } icon ? $"{icon} " : "")@(string.IsNullOrWhiteSpace(item.Title) ? "Untitled" : item.Title)</div>
                    @if (item.Detail.Length > 0)
                    {
                        <div class="small text-secondary">@item.Detail</div>
                    }
                </button>
            }
        </div>
    };
}
