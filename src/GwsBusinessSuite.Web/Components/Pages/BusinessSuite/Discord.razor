@page "/admin/discord"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "AdminOnly")]
@using GwsBusinessSuite.Application.Discord
@inject IDiscordService DiscordService
@inject ILogger<Discord> Logger

<PageTitle>Discord</PageTitle>

<div class="page-header">
    <h1><i class="bi bi-discord me-2 text-primary"></i>Discord</h1>
    <p>Search the servers your Discord bot belongs to, browse channels and messages, send replies, and look up members and roles.</p>
</div>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="alert alert-danger d-flex align-items-start gap-2 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill mt-1 flex-shrink-0"></i>
        <div>@ErrorMessage</div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(StatusMessage))
{
    <div class="alert alert-info d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-check-circle-fill flex-shrink-0"></i>
        <div>@StatusMessage</div>
    </div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between gap-2">
        <span class="fw-semibold"><i class="bi bi-robot me-1"></i>Bot Connection</span>
        <div class="d-flex gap-2">
            @if (BotUsername is not null)
            {
                <span class="badge text-bg-success align-self-center">Connected as @BotUsername</span>
            }
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => ShowSettings = !ShowSettings" disabled="@IsBusy">
                <i class="bi bi-gear-fill me-1"></i>@(ShowSettings ? "Hide" : "Settings")
            </button>
        </div>
    </div>
    @if (ShowSettings)
    {
        <div class="card-body">
            <p class="text-secondary small">Create a Discord Application and Bot at <code>discord.com/developers/applications</code>, enable the <strong>Server Members Intent</strong> and <strong>Message Content Intent</strong> under Bot settings, copy the bot token below, then invite the bot to your server(s).</p>
            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label fw-semibold small">Bot Token</label>
                    <div class="input-group">
                        <input class="form-control" type="@(ShowToken ? "text" : "password")"
                               @bind="TokenInput" autocomplete="off" placeholder="Paste your bot token" />
                        <button type="button" class="btn btn-outline-secondary" @onclick="() => ShowToken = !ShowToken">
                            <i class="bi @(ShowToken ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                        </button>
                    </div>
                    @if (TokenUnreadable)
                    {
                        <div class="form-text text-danger">The previously saved token can no longer be decrypted - please re-enter it.</div>
                    }
                </div>
            </div>
            <div class="mt-3 d-flex flex-wrap gap-2">
                <button class="btn btn-primary" @onclick="SaveTokenAsync" disabled="@IsBusy">
                    <i class="bi bi-floppy-fill me-1"></i>Save Token
                </button>
                <button class="btn btn-outline-primary" @onclick="TestConnectionAsync" disabled="@IsBusy">
                    Test Connection
                </button>
            </div>
        </div>
    }
</div>

@if (BotUsername is not null)
{
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom py-3 fw-semibold">Servers</div>
                <div class="card-body p-0">
                    <div class="p-2 border-bottom">
                        <input type="search" class="form-control form-control-sm" placeholder="Search servers..."
                               value="@GuildSearch" @oninput="OnGuildSearchInput" />
                    </div>
                    @if (IsLoadingGuilds)
                    {
                        <div class="p-4 text-secondary"><span class="spinner-border spinner-border-sm me-2"></span>Loading servers...</div>
                    }
                    else if (Guilds.Count == 0)
                    {
                        <div class="p-4 text-secondary">No servers match, or the bot hasn't been invited to any server yet.</div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var guild in Guilds)
                            {
                                <button type="button" class="list-group-item list-group-item-action @(SelectedGuildId == guild.Id ? "active" : string.Empty)"
                                        @onclick="() => SelectGuildAsync(guild.Id)" disabled="@IsBusy">
                                    @guild.Name
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            @if (SelectedGuildId is null)
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-secondary">Select a server to browse its channels and members.</div>
                </div>
            }
            else
            {
                <ul class="nav nav-pills mb-3">
                    <li class="nav-item">
                        <button type="button" class="nav-link @(ActiveTab == "Channels" ? "active" : string.Empty)" @onclick='() => ActiveTab = "Channels"'>
                            <i class="bi bi-chat-left-text-fill me-1"></i>Channels
                        </button>
                    </li>
                    <li class="nav-item">
                        <button type="button" class="nav-link @(ActiveTab == "Members" ? "active" : string.Empty)" @onclick='SwitchToMembersTabAsync'>
                            <i class="bi bi-people-fill me-1"></i>Members &amp; Roles
                        </button>
                    </li>
                </ul>

                @if (ActiveTab == "Channels")
                {
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-white border-bottom py-2 fw-semibold small text-uppercase">Channels</div>
                                <div class="list-group list-group-flush">
                                    @foreach (var channel in Channels)
                                    {
                                        <button type="button" class="list-group-item list-group-item-action @(SelectedChannelId == channel.Id ? "active" : string.Empty)"
                                                @onclick="() => SelectChannelAsync(channel.Id)" disabled="@IsBusy">
                                            <i class="bi bi-hash"></i>@channel.Name
                                        </button>
                                    }
                                    @if (Channels.Count == 0 && !IsLoadingChannels)
                                    {
                                        <div class="p-3 text-secondary small">No text channels found.</div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-md-8">
                            @if (SelectedChannelId is null)
                            {
                                <div class="card border-0 shadow-sm">
                                    <div class="card-body text-secondary">Select a channel to view recent messages.</div>
                                </div>
                            }
                            else
                            {
                                <div class="card border-0 shadow-sm">
                                    <div class="card-header bg-white border-bottom py-2 fw-semibold small">
                                        <i class="bi bi-hash"></i>@(Channels.FirstOrDefault(c => c.Id == SelectedChannelId)?.Name)
                                    </div>
                                    <div class="card-body" style="max-height: 28rem; overflow-y: auto;">
                                        @if (IsLoadingMessages)
                                        {
                                            <div class="text-secondary"><span class="spinner-border spinner-border-sm me-2"></span>Loading messages...</div>
                                        }
                                        else if (Messages.Count == 0)
                                        {
                                            <p class="text-secondary mb-0">No recent messages.</p>
                                        }
                                        else
                                        {
                                            @foreach (var message in Messages)
                                            {
                                                <div class="mb-3">
                                                    <div class="small text-secondary">
                                                        <span class="fw-semibold text-body">@message.AuthorName</span>
                                                        @if (message.IsBot)
                                                        {
                                                            <span class="badge text-bg-secondary ms-1">Bot</span>
                                                        }
                                                        &middot; @message.SentAt.ToLocalTime().ToString("MMM d, h:mm tt")
                                                    </div>
                                                    <div>@message.Content</div>
                                                </div>
                                            }
                                        }
                                    </div>
                                    <div class="card-footer bg-white d-flex gap-2">
                                        <input class="form-control" placeholder="Message #@(Channels.FirstOrDefault(c => c.Id == SelectedChannelId)?.Name)..."
                                               value="@ReplyBody" @oninput="e => ReplyBody = e.Value?.ToString() ?? string.Empty"
                                               @onkeydown="OnReplyKeyDown" />
                                        <button class="btn btn-primary flex-shrink-0" @onclick="SendReplyAsync" disabled="@(IsBusy || string.IsNullOrWhiteSpace(ReplyBody))">
                                            <i class="bi bi-send-fill"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        <div class="col-md-7">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-white border-bottom py-2">
                                    <input type="search" class="form-control form-control-sm" placeholder="Search members..."
                                           value="@MemberSearch" @oninput="OnMemberSearchInput" />
                                </div>
                                <div class="list-group list-group-flush">
                                    @if (IsLoadingMembers)
                                    {
                                        <div class="p-3 text-secondary"><span class="spinner-border spinner-border-sm me-2"></span>Loading members...</div>
                                    }
                                    else if (Members.Count == 0)
                                    {
                                        <div class="p-3 text-secondary small">No members match.</div>
                                    }
                                    else
                                    {
                                        @foreach (var member in Members)
                                        {
                                            <div class="list-group-item">
                                                <div class="fw-semibold">@(member.DisplayName ?? member.Username)</div>
                                                @if (member.RoleNames.Count > 0)
                                                {
                                                    <div class="small text-secondary">@string.Join(", ", member.RoleNames)</div>
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-white border-bottom py-2 fw-semibold small text-uppercase">Roles</div>
                                <div class="list-group list-group-flush">
                                    @foreach (var role in Roles)
                                    {
                                        <div class="list-group-item d-flex align-items-center gap-2">
                                            <span class="rounded-circle flex-shrink-0" style="width:.75rem;height:.75rem;background:@role.ColorHex;"></span>
                                            @role.Name
                                        </div>
                                    }
                                    @if (Roles.Count == 0)
                                    {
                                        <div class="p-3 text-secondary small">No roles found.</div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
}

@code {
    private bool ShowSettings;
    private bool ShowToken;
    private string TokenInput = string.Empty;
    private bool TokenUnreadable;
    private string? BotUsername;
    private bool IsBusy;
    private string ErrorMessage = string.Empty;
    private string StatusMessage = string.Empty;

    private string GuildSearch = string.Empty;
    private List<DiscordGuildView> Guilds { get; set; } = [];
    private bool IsLoadingGuilds;
    private ulong? SelectedGuildId;
    private string ActiveTab = "Channels";

    private List<DiscordChannelView> Channels { get; set; } = [];
    private bool IsLoadingChannels;
    private ulong? SelectedChannelId;
    private List<DiscordMessageView> Messages { get; set; } = [];
    private bool IsLoadingMessages;
    private string ReplyBody = string.Empty;

    private string MemberSearch = string.Empty;
    private List<DiscordMemberView> Members { get; set; } = [];
    private bool IsLoadingMembers;
    private List<DiscordRoleView> Roles { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        var settings = await DiscordService.GetConnectorSettingsAsync();
        TokenInput = settings?.BotToken ?? string.Empty;
        TokenUnreadable = settings?.BotTokenUnreadable ?? false;
        ShowSettings = string.IsNullOrWhiteSpace(TokenInput);

        if (!string.IsNullOrWhiteSpace(TokenInput))
        {
            await TestConnectionAsync(silent: true);
            if (BotUsername is not null)
            {
                await LoadGuildsAsync();
            }
        }
    }

    private async Task SaveTokenAsync()
    {
        await Work(async () =>
        {
            await DiscordService.SaveConnectorSettingsAsync(new DiscordConnectorSettingsView { BotToken = TokenInput });
            StatusMessage = "Bot token saved.";
            await TestConnectionAsync(silent: true);
            if (BotUsername is not null)
            {
                ShowSettings = false;
                await LoadGuildsAsync();
            }
        });
    }

    private Task TestConnectionAsync() => TestConnectionAsync(silent: false);

    private async Task TestConnectionAsync(bool silent)
    {
        await Work(async () =>
        {
            var result = await DiscordService.TestConnectionAsync();
            if (result.Success)
            {
                BotUsername = result.BotUsername;
                if (!silent) StatusMessage = $"Connected successfully as {result.BotUsername}.";
            }
            else
            {
                BotUsername = null;
                if (!silent) ErrorMessage = result.ErrorMessage ?? "Unable to connect to Discord.";
            }
        }, clearMessagesFirst: !silent);
    }

    private async Task LoadGuildsAsync()
    {
        IsLoadingGuilds = true;
        StateHasChanged();
        try
        {
            Guilds = (await DiscordService.ListGuildsAsync(GuildSearch)).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to load Discord servers.");
            ErrorMessage = $"Unable to load servers. {ex.Message}";
        }
        finally
        {
            IsLoadingGuilds = false;
            StateHasChanged();
        }
    }

    private async Task OnGuildSearchInput(ChangeEventArgs e)
    {
        GuildSearch = e.Value?.ToString() ?? string.Empty;
        await LoadGuildsAsync();
    }

    private async Task SelectGuildAsync(ulong guildId)
    {
        SelectedGuildId = guildId;
        SelectedChannelId = null;
        Messages = [];
        ActiveTab = "Channels";
        IsLoadingChannels = true;
        StateHasChanged();
        try
        {
            Channels = (await DiscordService.ListChannelsAsync(guildId)).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to load channels for guild {GuildId}.", guildId);
            ErrorMessage = $"Unable to load channels. {ex.Message}";
        }
        finally
        {
            IsLoadingChannels = false;
            StateHasChanged();
        }
    }

    private async Task SwitchToMembersTabAsync()
    {
        ActiveTab = "Members";
        if (SelectedGuildId is { } guildId)
        {
            await LoadMembersAndRolesAsync(guildId);
        }
    }

    private async Task LoadMembersAndRolesAsync(ulong guildId)
    {
        IsLoadingMembers = true;
        StateHasChanged();
        try
        {
            Members = (await DiscordService.ListMembersAsync(guildId, MemberSearch)).ToList();
            Roles = (await DiscordService.ListRolesAsync(guildId)).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to load members/roles for guild {GuildId}.", guildId);
            ErrorMessage = $"Unable to load members. {ex.Message}";
        }
        finally
        {
            IsLoadingMembers = false;
            StateHasChanged();
        }
    }

    private async Task OnMemberSearchInput(ChangeEventArgs e)
    {
        MemberSearch = e.Value?.ToString() ?? string.Empty;
        if (SelectedGuildId is { } guildId)
        {
            await LoadMembersAndRolesAsync(guildId);
        }
    }

    private async Task SelectChannelAsync(ulong channelId)
    {
        SelectedChannelId = channelId;
        IsLoadingMessages = true;
        StateHasChanged();
        try
        {
            Messages = (await DiscordService.GetRecentMessagesAsync(channelId)).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to load messages for channel {ChannelId}.", channelId);
            ErrorMessage = $"Unable to load messages. {ex.Message}";
        }
        finally
        {
            IsLoadingMessages = false;
            StateHasChanged();
        }
    }

    private async Task OnReplyKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(ReplyBody))
        {
            await SendReplyAsync();
        }
    }

    private async Task SendReplyAsync()
    {
        if (SelectedChannelId is not { } channelId || string.IsNullOrWhiteSpace(ReplyBody)) return;

        await Work(async () =>
        {
            var result = await DiscordService.SendMessageAsync(channelId, ReplyBody);
            if (result.Success)
            {
                ReplyBody = string.Empty;
                Messages = (await DiscordService.GetRecentMessagesAsync(channelId)).ToList();
            }
            else
            {
                ErrorMessage = result.ErrorMessage ?? "Unable to send message.";
            }
        }, clearMessagesFirst: false);
    }

    private async Task Work(Func<Task> action, bool clearMessagesFirst = true)
    {
        if (clearMessagesFirst)
        {
            ErrorMessage = string.Empty;
            StatusMessage = string.Empty;
        }
        IsBusy = true;
        StateHasChanged();
        try
        {
            await action();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Discord admin page action failed.");
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsBusy = false;
            StateHasChanged();
        }
    }
}
