    protected override async Task OnInitializedAsync()
    {
        CurrentUsername = await CurrentUserNameAsync();
        if (AuthState is not null)
        {
            var authState = await AuthState;
            _isAdmin = authState.User.IsInRole(AppRoles.Admin);
        }
        CursorTracker.Moved += HandleCursorsMoved;
        await LoadTreeAsync(selectFirstPage: false);
        await LoadWorkspaceNavigationAsync();
        await RestoreLastOpenedItemAsync();

        var query = QueryHelpers.ParseQuery(Navigator.ToAbsoluteUri(Navigator.Uri).Query);
        if (query.TryGetValue("page", out var requestedPage)
            && Guid.TryParse(requestedPage.ToString(), out var requestedPageId))
        {
            await OpenPageAsync(requestedPageId);
        }
        else if (query.TryGetValue("database", out var requestedDatabase)
            && Guid.TryParse(requestedDatabase.ToString(), out var requestedDatabaseId))
        {
            await OpenDatabaseAsync(requestedDatabaseId);
        }

        if (query.TryGetValue("notionOAuth", out var oauthResult))
        {
            await OpenNotionModalAsync();
            (NotionMessage, NotionMessageIsError) = oauthResult.ToString() switch
            {
                "connected" => ("Notion workspace connected. Browse the authorized content, then sync.", false),
                "denied" => ("Notion authorization was cancelled.", true),
                "invalid-state" => ("Notion authorization expired or could not be verified. Try connecting again.", true),
                "not-configured" => ("Notion OAuth is not configured on this server.", true),
                _ => ("Notion authorization could not be completed. Try connecting again.", true)
            };
        }

        // Lets the macOS menu-bar companion's "Refresh Workspace Data" action trigger a real
        // sync (src/GwsBusinessSuite.SentinelMenuBar) without that native client needing its own
        // authenticated API credentials - it just opens this already-authenticated browser
        // session with ?syncNow=1, and this reuses the exact same manual-sync path the "Sync
        // now" button already calls. Also opens the modal (loading NotionSettings first, since
        // HasNotionConnection depends on it) so the visitor sees sync progress, not a silent
        // background action.
        if (query.ContainsKey("syncNow"))
        {
            await OpenNotionModalAsync();
            if (HasNotionConnection)
            {
                await SyncNotionNowAsync();
            }
        }
    }

