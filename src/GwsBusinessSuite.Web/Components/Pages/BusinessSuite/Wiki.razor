    private async Task SavePageAsync()
    {
        // An explicit save is about to write the freshest possible snapshot and rebuild
        // Editor from the result - any autosave debounce still pending against the current
        // (about to be replaced) Editor is now moot.
        DiscardPendingAutosave();
        IsBusy = true;
        ErrorMessage = string.Empty;
        StatusMessage = string.Empty;

        try
        {
            // Only existing pages have a SentinelResourcePermission row to check - a brand new
            // page has no target to grant/deny access to yet, so creating one is unrestricted
            // (matches how a Contributor is free to create pages, just not edit ones they were
            // never given Edit access to).
            if (Editor.WikiPageId is { } existingPageId
                && !await CanAccessPageOrDatabaseAsync(existingPageId, isDatabase: false, SentinelAccessLevels.Edit))
            {
                ErrorMessage = "You don't have permission to edit this Sentinel page.";
                return;
            }

            // The block editor owns its live DOM and reports changes on a short debounce.
            // An explicit Save can legitimately arrive before that callback, especially after
            // a toolbar action, so capture synchronously before writing the server snapshot.
            await CaptureEditorBlocksAsync();
            var user = await CurrentUserNameAsync();
            var saved = await WikiService.SavePageAsync(Editor, user);
            SelectedPageId = saved.Id;
            Editor = new WikiPageEditorModel
            {
                WikiPageId = saved.Id,
                ExpectedContentVersion = saved.ContentVersion,
                Title = saved.Title,
                Slug = saved.Slug,
                BlocksJson = saved.BlocksJson,
                BaseBlocksJson = saved.BlocksJson,
                Icon = saved.Icon,
                CoverImageUrl = saved.CoverImageUrl,
                ParentWikiPageId = saved.ParentWikiPageId
            };
            // Deliberately not bumping _editorGeneration here - the block editor's DOM already
            // reflects exactly what was just saved (that's where BlocksJson came from), so
            // resetting it would only cost the user their cursor position for no benefit.
            if (_blockEditorInitialized && _blockEditorModule is not null)
            {
                await _blockEditorModule.InvokeVoidAsync(
                    "setHistoryKey",
                    _blockEditorContainer,
                    BlockEditorHistoryKey());
            }
            StatusMessage = $"Saved Sentinel page '{saved.Title}'.";
            PageConflict = null;
            await LoadTreeAsync(selectFirstPage: false);
            await LoadHistoryAsync(saved.Id);
            Backlinks = (await SentinelWorkspaceService.GetBacklinksAsync(saved.Id, CurrentUsername)).ToList();
            await SentinelWorkspaceService.RecordOpenedAsync(CurrentUsername, saved.Id, false);
            await LoadWorkspaceNavigationAsync();
        }
        catch (WikiPageConcurrencyException ex)
        {
            Logger.LogWarning(ex, "Sentinel page {WikiPageId} had a concurrent edit conflict.", Editor.WikiPageId);
            PageConflict = ex.Conflict;
            StatusMessage = string.Empty;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to save wiki page.");
            ErrorMessage = $"Unable to save Sentinel page. {ex.Message}";
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task InsertAiOutputAsync(string output)
    {
        var blocks = WikiBlockJson.ParseBlocks(Editor.BlocksJson).ToList();
        foreach (var paragraph in output.Split("\n\n", StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))
        {
            blocks.Add(new WikiBlock(Guid.NewGuid(), WikiBlockTypes.Paragraph, 0,
                [new WikiRichTextSpan(paragraph)], new Dictionary<string, string>()));
        }
        Editor.BlocksJson = WikiBlockJson.Serialize(blocks);
        _editorGeneration++;
        await InvokeAsync(StateHasChanged);
        StatusMessage = "Inserted a reviewed SentinelGPT draft. Save the page to persist it.";
    }

