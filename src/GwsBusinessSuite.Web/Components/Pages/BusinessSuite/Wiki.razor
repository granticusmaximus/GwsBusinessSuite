    [JSInvokable]
    public async Task<IReadOnlyList<LinkedDatabaseSuggestion>> SearchLinkedDatabaseSuggestions(string query)
    {
        var normalized = query.Trim();
        var candidates = WikiDatabases
            .Where(database => database.NotionArchivedAt is null
                && (normalized.Length == 0 || database.Title.Contains(normalized, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(database => database.Title, StringComparer.OrdinalIgnoreCase)
            .ToList();
        var suggestions = new List<LinkedDatabaseSuggestion>();
        foreach (var database in candidates)
        {
            if (!await CanAccessPageOrDatabaseAsync(database.Id, isDatabase: true, SentinelAccessLevels.View))
            {
                continue;
            }
            suggestions.Add(new LinkedDatabaseSuggestion(
                database.Id,
                database.Title,
                string.IsNullOrWhiteSpace(database.Icon) ? "▦" : database.Icon));
            if (suggestions.Count == 10)
            {
                break;
            }
        }
        return suggestions;
    }

