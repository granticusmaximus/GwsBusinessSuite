    private async Task SaveCurrentSearchAsync()
    {
        var query = SearchQuery.Trim();
        if (query.Length == 0) return;
        try
        {
            await SentinelWorkspaceService.SaveSearchAsync(CurrentUsername, query);
            SavedSearches = (await SentinelWorkspaceService.ListSavedSearchesAsync(CurrentUsername)).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to save Sentinel search '{Query}'.", query);
            ErrorMessage = $"Unable to save this search. {ex.Message}";
        }
    }

    private async Task RunSavedSearchAsync(string query)
    {
        SearchQuery = query;
        await SearchWorkspaceAsync();
    }

    private async Task DeleteSavedSearchAsync(Guid savedSearchId)
    {
        try
        {
            await SentinelWorkspaceService.DeleteSavedSearchAsync(CurrentUsername, savedSearchId);
            SavedSearches = SavedSearches.Where(saved => saved.Id != savedSearchId).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to delete saved Sentinel search {SavedSearchId}.", savedSearchId);
            ErrorMessage = $"Unable to delete this saved search. {ex.Message}";
        }
    }

    private async Task SearchWorkspaceAsync()
    {
        var query = SearchQuery.Trim();
        if (query.Length == 0)
        {
            WorkspaceSearchResults = new();
            return;
        }

        IsSearchBusy = true;
        try
        {
            var results = (await SentinelWorkspaceService.SearchAsync(query, CurrentUsername)).ToList();
            if (string.Equals(SearchQuery.Trim(), query, StringComparison.Ordinal))
            {
                WorkspaceSearchResults = results;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to search Sentinel.");
            ErrorMessage = $"Unable to search Sentinel. {ex.Message}";
        }
        finally
        {
            IsSearchBusy = false;
        }
    }

    // Floating Ctrl/Cmd+K palette (Phase 5.2). Deliberately its own query/results state rather
    // than sharing SearchQuery/WorkspaceSearchResults with the sidebar's own always-present
    // search box below - opening/closing/typing in the palette must never clobber whatever the
    // user separately has typed into that box, and vice versa. Both app.js's Ctrl/Cmd+K handler
    // and sentinel-workspace.js's Ctrl/Cmd+Shift+F handler already converge on clicking the
    // "Quick find" button (.sentinel-global-search) - see its @onclick in the markup above -
    // so no JS changes were needed to wire either shortcut to this.
    private bool _paletteOpen;
    private string _paletteQuery = string.Empty;
    // _paletteRawResults is exactly what SearchAsync returned; _paletteResults is that list
    // after the author/date facet filters below are applied - kept separate so the "no filters
    // configured yet" vs. "the filters excluded everything" empty states can be told apart, and
    // so keyboard nav (_paletteSelectedIndex) always indexes into what's actually on screen.
    private List<SentinelSearchResult> _paletteRawResults = new();
    private List<SentinelSearchResult> _paletteResults = new();
    private string _paletteAuthorFilter = string.Empty;
    private string _paletteDateFilter = string.Empty;
    private bool _paletteBusy;
    private int _paletteSelectedIndex;
    private ElementReference _paletteInputRef;

    private async Task OpenCommandPaletteAsync()
    {
        _paletteOpen = true;
        _paletteQuery = string.Empty;
        _paletteRawResults = new();
        _paletteResults = new();
        _paletteAuthorFilter = string.Empty;
        _paletteDateFilter = string.Empty;
        _paletteSelectedIndex = 0;
        await InvokeAsync(StateHasChanged);
        try
        {
            await _paletteInputRef.FocusAsync();
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException)
        {
            // The input may not have finished rendering yet on a very fast repeat keypress -
            // FocusAsync throws InvalidOperationException (not JSException) when the
            // ElementReference hasn't been captured by a completed render yet, which crashed the
            // whole circuit here before this catch also handled that exception type.
        }
    }

    private void CloseCommandPalette()
    {
        _paletteOpen = false;
        _paletteQuery = string.Empty;
        _paletteRawResults = new();
        _paletteResults = new();
    }

    private async Task SearchCommandPaletteAsync()
    {
        var query = _paletteQuery.Trim();
        if (query.Length == 0)
        {
            _paletteRawResults = new();
            _paletteResults = new();
            _paletteSelectedIndex = 0;
            return;
        }

        _paletteBusy = true;
        try
        {
            var results = (await SentinelWorkspaceService.SearchAsync(query, CurrentUsername)).ToList();
            // Ignore a stale response if the query changed again while this was in flight.
            if (string.Equals(_paletteQuery.Trim(), query, StringComparison.Ordinal))
            {
                _paletteRawResults = results;
                ApplyPaletteFilters();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to search Sentinel from the command palette.");
        }
        finally
        {
            _paletteBusy = false;
        }
    }

    private void ApplyPaletteFilters()
    {
        _paletteResults = ApplySearchFilters(_paletteRawResults, _paletteAuthorFilter, _paletteDateFilter);
        _paletteSelectedIndex = 0;
    }

    private static List<SentinelSearchResult> ApplySearchFilters(
        IReadOnlyList<SentinelSearchResult> results, string authorFilter, string dateFilter) =>
        SentinelSearchFiltering.Apply(results, authorFilter, dateFilter, DateTimeOffset.UtcNow).ToList();

    private async Task OpenPaletteResultAsync(SentinelSearchResult result)
    {
        CloseCommandPalette();
        await OpenSearchResultAsync(result);
    }

    private async Task HandlePaletteKeyDownAsync(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Escape":
                CloseCommandPalette();
                break;
            case "ArrowDown":
                if (_paletteResults.Count > 0)
                {
                    _paletteSelectedIndex = (_paletteSelectedIndex + 1) % _paletteResults.Count;
                }
                break;
            case "ArrowUp":
                if (_paletteResults.Count > 0)
                {
                    _paletteSelectedIndex = (_paletteSelectedIndex - 1 + _paletteResults.Count) % _paletteResults.Count;
                }
                break;
            case "Enter":
                if (_paletteSelectedIndex >= 0 && _paletteSelectedIndex < _paletteResults.Count)
                {
                    await OpenPaletteResultAsync(_paletteResults[_paletteSelectedIndex]);
                }
                break;
        }
    }

