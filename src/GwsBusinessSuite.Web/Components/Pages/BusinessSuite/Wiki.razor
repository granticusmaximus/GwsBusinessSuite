    private IReadOnlyList<NotionPickerRow> VisibleNotionPickerRows()
    {
        var byNormalizedId = NotionPickerItems.ToDictionary(
            item => NormalizeNotionPickerId(item.Id),
            StringComparer.OrdinalIgnoreCase);
        var children = NotionPickerItems
            .GroupBy(
                item => item.ParentId is { } parentId && byNormalizedId.ContainsKey(NormalizeNotionPickerId(parentId))
                    ? NormalizeNotionPickerId(parentId)
                    : string.Empty,
                StringComparer.OrdinalIgnoreCase)
            .ToDictionary(
                group => group.Key,
                group => group.OrderBy(item => item.Title, StringComparer.OrdinalIgnoreCase).ToList(),
                StringComparer.OrdinalIgnoreCase);
        var rows = new List<NotionPickerRow>();
        var visited = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        void AddChildren(string parentId, int depth)
        {
            if (!children.TryGetValue(parentId, out var childItems))
            {
                return;
            }
            foreach (var item in childItems)
            {
                var normalizedId = NormalizeNotionPickerId(item.Id);
                if (!visited.Add(normalizedId))
                {
                    continue;
                }
                var hasChildren = children.ContainsKey(normalizedId);
                var isExpanded = ExpandedNotionPickerIds.Contains(item.Id);
                rows.Add(new NotionPickerRow(item, depth, hasChildren, isExpanded));
                if (hasChildren && isExpanded)
                {
                    AddChildren(normalizedId, depth + 1);
                }
            }
        }

        AddChildren(string.Empty, 0);
        return rows;
    }

    private static IReadOnlyList<string> ParseNotionSelectedIds(string value) => value
        .Split([',', '\n', '\r', ';'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();

    private static string NormalizeNotionPickerId(string value) =>
        Guid.TryParse(value.Trim(), out var id) ? id.ToString("N") : value.Trim();

