    public async ValueTask DisposeAsync()
    {
        // Flush any pending autosave before the block editor module (and possibly the whole
        // circuit) tears down below - the component is going away entirely (route change,
        // browser closed, circuit lost), which is exactly the case OpenPageAsync/
        // OpenDatabaseAsync's flush calls can't cover on their own.
        try
        {
            await FlushAutosaveAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone; whatever OnBlocksChanged last synced is what ships.
        }

        CursorTracker.Moved -= HandleCursorsMoved;
        LeaveCursorTracking();
        await _disposeCts.CancelAsync();

        if (_workspaceModule is not null)
        {
            try
            {
                await _workspaceModule.InvokeVoidAsync("dispose");
                await _workspaceModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone.
            }
        }

        if (_blockEditorInitialized && _blockEditorModule is not null)
        {
            try
            {
                await _blockEditorModule.InvokeVoidAsync("dispose", _blockEditorContainer);
                await _blockEditorModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone (e.g. browser closed); nothing to clean up client-side.
            }
        }

        _blockEditorRef?.Dispose();

        if (_pageGraphModule is not null)
        {
            try
            {
                await _pageGraphModule.InvokeVoidAsync("dispose", _pageGraphCanvas);
                await _pageGraphModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone (e.g. browser closed); nothing to clean up client-side.
            }
        }

        if (_wikiLinksInitialized)
        {
            try
            {
                await JS.InvokeVoidAsync("gwsWikiLinks.dispose");
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone (e.g. browser closed); nothing to clean up client-side.
            }
        }

        _wikiLinksRef?.Dispose();
        _disposeCts.Dispose();
        _saveLock.Dispose();
    }
