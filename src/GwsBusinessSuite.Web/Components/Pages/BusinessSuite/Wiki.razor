    protected override async Task OnInitializedAsync()
    {
        CurrentUsername = await CurrentUserNameAsync();
        if (AuthState is not null)
        {
            var authState = await AuthState;
            _isAdmin = authState.User.IsInRole(AppRoles.Admin);
        }
        CursorTracker.Moved += HandleCursorsMoved;
        await LoadTreeAsync(selectFirstPage: false);
        await LoadWorkspaceNavigationAsync();
        await RestoreLastOpenedItemAsync();

        var query = QueryHelpers.ParseQuery(Navigator.ToAbsoluteUri(Navigator.Uri).Query);
        if (query.TryGetValue("page", out var requestedPage)
            && Guid.TryParse(requestedPage.ToString(), out var requestedPageId))
        {
            await OpenPageAsync(requestedPageId);
        }
        else if (query.TryGetValue("database", out var requestedDatabase)
            && Guid.TryParse(requestedDatabase.ToString(), out var requestedDatabaseId))
        {
            if (query.TryGetValue("row", out var requestedRow)
                && Guid.TryParse(requestedRow.ToString(), out var requestedRowId))
            {
                _pendingOpenRowId = requestedRowId;
            }
            await OpenDatabaseAsync(requestedDatabaseId);
        }

    }

    [JSInvokable]
    public void OnCursorMoved(string blockId, int? start = null, int? end = null)
    {
        if (SelectedPageId is { } wikiPageId && Guid.TryParse(blockId, out var parsedBlockId))
        {
            CursorTracker.Move(wikiPageId, CurrentUsername, parsedBlockId, start, end);
        }
    }

    private void HandleCursorsMoved(Guid wikiPageId)
    {
        if (SelectedPageId != wikiPageId) return;
        _ = InvokeAsync(async () =>
        {
            _remoteCursors = CursorTracker.List(wikiPageId, CurrentUsername);
            if (_blockEditorInitialized && _blockEditorModule is not null)
            {
                try { await _blockEditorModule.InvokeVoidAsync("setRemoteCursors", _blockEditorContainer, BuildRemoteCursorPayload()); }
                catch (JSDisconnectedException) { /* the circuit is already gone */ }
            }
        });
    }

    // Not cryptographically stable across app restarts (string hashing is randomized per
    // process for hash-flooding protection), which is fine here - a decorative cursor color
    // only needs to stay consistent for the lifetime of one server process, not forever.
    private static readonly string[] CursorColors = ["#f59e0b", "#ef4444", "#10b981", "#3b82f6", "#a855f7", "#ec4899"];

    private static string ColorForUsername(string username) =>
        CursorColors[(uint)username.GetHashCode() % (uint)CursorColors.Length];

    private object BuildRemoteCursorPayload() => _remoteCursors
        .Select(cursor => new
        {
            blockId = cursor.BlockId,
            username = cursor.Username,
            color = ColorForUsername(cursor.Username),
            start = cursor.Start,
            end = cursor.End
        })
        .ToList();

    private void LeaveCursorTracking()
    {
        if (SelectedPageId is { } previousPageId)
        {
            CursorTracker.Leave(previousPageId, CurrentUsername);
        }
        _remoteCursors = [];
    }

    private ElementReference _titleInput;
    private bool _focusTitleAfterRender;
    private int _titleAppliedVersion;

    private WikiPageEditorModel? _titleSnapshotEditor;
    private string _titleSnapshot = string.Empty;
    private int _titleSnapshotVersion;

    // Evaluated as the textarea's @key, which Blazor reads before its other attributes - so the
    // snapshot (and the element identity) are always up to date by the time value is rendered.
    // A new Editor (another page, or a just-created one) always gets a new element, even when
    // both titles are the same (e.g. two empty "Untitled" pages).
    private int TitleElementKey
    {
        get
        {
            if (!ReferenceEquals(_titleSnapshotEditor, Editor))
            {
                _titleSnapshotEditor = Editor;
                _titleSnapshot = Editor.Title ?? string.Empty;
                _titleSnapshotVersion++;
            }

            return _titleSnapshotVersion;
        }
    }

    // For code that rewrites Editor.Title in place (rather than loading a new Editor).
    private void RefreshRenderedTitle() => _titleSnapshotEditor = null;

    private void OnTitleInput(ChangeEventArgs args)
    {
        Editor.Title = args.Value?.ToString() ?? string.Empty;
        ScheduleAutosave();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Fill the title box when a different page has been loaded (see the textarea's comment).
        if (_titleAppliedVersion != _titleSnapshotVersion && _titleInput.Context is not null)
        {
            try
            {
                _workspaceModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/sentinel-workspace.js");
                await _workspaceModule.InvokeVoidAsync("setTitleValue", _titleInput, _titleSnapshot);
                _titleAppliedVersion = _titleSnapshotVersion;
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException)
            {
                // Circuit going away; the next render retries.
            }
        }

        // A just-created page opens ready to type its title.
        if (_focusTitleAfterRender && _titleInput.Context is not null)
        {
            _focusTitleAfterRender = false;
            try
            {
                await _titleInput.FocusAsync();
            }
            catch (Exception ex) when (ex is JSException or InvalidOperationException)
            {
                // Focus is a convenience - never fail the page over it.
            }
        }

        if (firstRender)
        {
            _workspaceModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/sentinel-workspace.js");
            await _workspaceModule.InvokeVoidAsync("initialize", _workspaceSearchInput);
        }

        if (!_wikiLinksInitialized)
        {
            _wikiLinksRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("gwsWikiLinks.init", _wikiLinksRef);
            _wikiLinksInitialized = true;
        }

        if (_graphNeedsRender && _pageGraph is not null)
        {
            _graphNeedsRender = false;
            _pageGraphModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/wiki-page-graph.js");
            // Passed as a plain object, not pre-serialized here - Blazor's own JS interop
            // marshalling already serializes to camelCase JSON, matching every other payload
            // handed to a JS module in this file (setDiscussionCounts, BuildRemoteCursorPayload).
            await _pageGraphModule.InvokeVoidAsync(
                "initialize", _pageGraphCanvas, DotNetObjectReference.Create(this), _pageGraph);
        }

        if (SelectedDatabaseId is null && !_blockEditorInitialized)
        {
            _blockEditorRef ??= DotNetObjectReference.Create(this);
            _blockEditorModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/wiki-block-editor.js?v=10");
            await _blockEditorModule.InvokeVoidAsync(
                "initialize",
                _blockEditorContainer,
                _blockEditorRef,
                Editor.BlocksJson,
                BlockEditorHistoryKey());
            await _blockEditorModule.InvokeVoidAsync("setDiscussionCounts", _blockEditorContainer, _blockDiscussionCounts);
            await _blockEditorModule.InvokeVoidAsync("setDiscussionHighlights", _blockEditorContainer, _blockDiscussionHighlights);
            await _blockEditorModule.InvokeVoidAsync("setRemoteCursors", _blockEditorContainer, BuildRemoteCursorPayload());
            _blockEditorInitialized = true;
            _blockEditorSyncedGeneration = _editorGeneration;
        }
        else if (SelectedDatabaseId is null && _blockEditorSyncedGeneration != _editorGeneration)
        {
            var blockEditorModule = _blockEditorModule!;
            await blockEditorModule.InvokeVoidAsync(
                "initialize",
                _blockEditorContainer,
                _blockEditorRef,
                Editor.BlocksJson,
                BlockEditorHistoryKey());
            await blockEditorModule.InvokeVoidAsync("setDiscussionCounts", _blockEditorContainer, _blockDiscussionCounts);
            await blockEditorModule.InvokeVoidAsync("setDiscussionHighlights", _blockEditorContainer, _blockDiscussionHighlights);
            // The editor element can be replaced when the conditional page-context rail enters
            // the render tree. Reinitializing, rather than assuming the old WeakMap state still
            // owns this ElementReference, guarantees a loaded page renders its persisted blocks.
            await blockEditorModule.InvokeVoidAsync("setRemoteCursors", _blockEditorContainer, BuildRemoteCursorPayload());
            _blockEditorSyncedGeneration = _editorGeneration;
        }
    }

