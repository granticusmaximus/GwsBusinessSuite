    // (a handful of blocks, not a database round trip) and guarantees it never shows a stale
    // count after a block edit, unlike a value that would need its own invalidation tracking.
    private (int Words, int Characters) PageWordAndCharacterCount()
    {
        var text = string.Join(' ', WikiBlockJson.ParseBlocks(Editor.BlocksJson)
            .SelectMany(block => block.RichText)
            .Select(span => span.Text));
        var words = text.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries).Length;
        var characters = text.Count(c => !char.IsWhiteSpace(c));
        return (words, characters);
