    // Verified finding: clicking a page link, backlink, mention, or search result had no way
    // back to wherever you clicked it from - the breadcrumb only ever shows the target page's
    // own folder-tree ancestors, not the page you actually came from, and Blazor Server never
    // pushed a browser history entry for in-app navigation (SelectedPageId/SelectedDatabaseId
    // are internal state, not routed URLs), so the browser Back button did nothing useful either.
    // This is a plain in-memory LIFO stack, not full browser-style back/forward - "get back to
    // where I was" is the actual ask, not a redo/forward feature.
    private readonly Stack<(Guid? PageId, Guid? DatabaseId)> _navigationBackStack = new();
    private bool CanGoBack => _navigationBackStack.Count > 0;

    private string? BackStackTargetTitle
    {
        get
        {
            if (_navigationBackStack.Count == 0) return null;
            var (pageId, databaseId) = _navigationBackStack.Peek();
            if (pageId is { } previousPageId)
                return WikiPages.FirstOrDefault(p => p.Id == previousPageId) is { } previousPage
                    ? (string.IsNullOrWhiteSpace(previousPage.Title) ? "Untitled" : previousPage.Title)
                    : null;
            if (databaseId is { } previousDatabaseId) return WikiDatabases.FirstOrDefault(d => d.Id == previousDatabaseId)?.Title;
            return null;
        }
    }

    private void PushCurrentLocationToBackStack(bool recordHistory, Guid? newPageId, Guid? newDatabaseId)
    {
        if (!recordHistory) return;
        if (SelectedPageId is null && SelectedDatabaseId is null) return;
        if (SelectedPageId == newPageId && SelectedDatabaseId == newDatabaseId) return;
        _navigationBackStack.Push((SelectedPageId, SelectedDatabaseId));
    }

    private async Task GoBackAsync()
    {
        if (_navigationBackStack.Count == 0) return;
        var (pageId, databaseId) = _navigationBackStack.Pop();
        if (pageId is { } previousPageId)
        {
            await OpenPageAsync(previousPageId, recordHistory: false);
        }
        else if (databaseId is { } previousDatabaseId)
        {
            await OpenDatabaseAsync(previousDatabaseId, recordHistory: false);
        }
    }
