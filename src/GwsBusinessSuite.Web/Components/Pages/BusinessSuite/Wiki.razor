    private async Task MoveNodeAsync(WikiTreeNode node, int direction)
    {
        var siblings = OrderedTreeNodes()
            .Where(n => n.ParentId == node.ParentId)
            .ToList();
        var currentIndex = siblings.FindIndex(n => n.Id == node.Id);
        var targetIndex = currentIndex + direction;
        if (currentIndex < 0 || targetIndex < 0 || targetIndex >= siblings.Count)
        {
            return;
        }

        await Work(async () =>
        {
            var user = await CurrentUserNameAsync();
            if (node.IsDatabase)
            {
                await WikiDatabaseService.ReorderDatabaseAsync(node.Id, node.ParentId, targetIndex, user);
            }
            else
            {
                await WikiService.ReorderPageAsync(node.Id, node.ParentId, targetIndex, user);
            }
            await LoadTreeAsync(selectFirstPage: false);
        });
    }

    // Mirrors WikiDatabaseEditor.razor's Board view drag pattern (StartDragRow/EndDragRow +
    // @ondragover:preventDefault/@ondrop) rather than new JS interop - the global
    // wwwroot/js/dragReorder.js listener (loaded once in App.razor) already satisfies
    // Chromium's "is this a real drag" dataTransfer.setData requirement for every
    // draggable="true" element, so no per-row JS is needed here either.
    private void StartDragNode(WikiTreeNode node)
    {
        _draggedNodeId = node.Id;
        _draggedNodeIsDatabase = node.IsDatabase;
    }

    private void EndDragNode()
    {
        _draggedNodeId = null;
        _dragOverNodeId = null;
    }

    private async Task DropOnNodeAsync(WikiTreeNode targetNode)
    {
        var draggedId = _draggedNodeId;
        var draggedIsDatabase = _draggedNodeIsDatabase;
        _dragOverNodeId = null;
        _draggedNodeId = null;
        if (draggedId is not { } nodeId || nodeId == targetNode.Id)
        {
            return;
        }

        await Work(async () =>
        {
            var user = await CurrentUserNameAsync();
            var newSortOrder = AllTreeNodes().Count(n => n.ParentId == targetNode.Id);
            if (draggedIsDatabase)
            {
                await WikiDatabaseService.ReorderDatabaseAsync(nodeId, targetNode.Id, newSortOrder, user);
            }
            else
            {
                await WikiService.ReorderPageAsync(nodeId, targetNode.Id, newSortOrder, user);
            }
            _expandedPageIds.Add(targetNode.Id);
            await LoadTreeAsync(selectFirstPage: false);
        });
    }

    private void ToggleRowMenu(Guid nodeId) =>
        _openRowMenuNodeId = _openRowMenuNodeId == nodeId ? null : nodeId;

    private async Task DuplicateNodeAsync(WikiTreeNode node)
    {
        _openRowMenuNodeId = null;
        await Work(async () =>
        {
            var user = await CurrentUserNameAsync();
            if (node.IsDatabase)
            {
                var duplicate = await WikiDatabaseService.DuplicateDatabaseAsync(node.Id, user);
                await LoadTreeAsync(selectFirstPage: false);
                await OpenDatabaseAsync(duplicate.Id);
                StatusMessage = $"Duplicated '{duplicate.Title}'.";
            }
            else
            {
                var duplicate = await WikiService.DuplicatePageAsync(node.Id, user);
                await LoadTreeAsync(selectFirstPage: false);
                await OpenPageAsync(duplicate.Id);
                StatusMessage = $"Duplicated '{duplicate.Title}'.";
            }
        });
    }

    private async Task DeleteNodeAsync(WikiTreeNode node)
    {
        _openRowMenuNodeId = null;
        if (!await CanAccessPageOrDatabaseAsync(
                node.Id, node.IsDatabase, SentinelAccessLevels.FullAccess))
        {
            ErrorMessage = $"You don't have permission to move this Sentinel {(node.IsDatabase ? "database" : "page")} to Trash.";
            return;
        }
        _pendingSingleDelete = node;
        _showSingleDeleteConfirm = true;
    }

    private void CancelSingleDelete() { _pendingSingleDelete = null; _showSingleDeleteConfirm = false; }

    private async Task ConfirmSingleDeleteAsync()
    {
        if (_pendingSingleDelete is not { } node) { _showSingleDeleteConfirm = false; return; }
        _showSingleDeleteConfirm = false;
        await Work(async () =>
        {
            var user = await CurrentUserNameAsync();
            if (node.IsDatabase)
            {
                await WikiDatabaseService.TrashDatabaseAsync(node.Id, user);
                if (SelectedDatabaseId == node.Id)
                {
                    SelectedDatabaseId = null;
                }
            }
            else
            {
                await WikiService.TrashPageAsync(node.Id, user);
                if (SelectedPageId == node.Id)
                {
                    CreateNewPage();
                }
            }
            StatusMessage = $"Moved '{node.Title}' to Trash.";
            await LoadTreeAsync(selectFirstPage: false);
            await LoadWorkspaceNavigationAsync();
        });
        _pendingSingleDelete = null;
    }

    private void ToggleTreeNodeSelect(Guid nodeId, bool selected)
    {
        if (selected) _selectedTreeNodeIds.Add(nodeId);
        else _selectedTreeNodeIds.Remove(nodeId);
    }

    private void OpenBulkMoveModal() { _bulkMoveTargetParentId = null; _showBulkMoveModal = true; }
    private void CloseBulkMoveModal() => _showBulkMoveModal = false;
    private void CancelBulkDelete() => _showBulkDeleteConfirm = false;

    private async Task ConfirmBulkDeleteAsync()
    {
        _bulkActionBusy = true;
        try
        {
            var user = await CurrentUserNameAsync();
            var nodesById = AllTreeNodes().ToDictionary(n => n.Id);
            var attempted = _selectedTreeNodeIds.Count;
            var failures = 0;
            foreach (var id in _selectedTreeNodeIds.ToList())
            {
                if (!nodesById.TryGetValue(id, out var node)) continue;
                try
                {
                    if (!await CanAccessPageOrDatabaseAsync(node.Id, node.IsDatabase, SentinelAccessLevels.FullAccess))
                    {
                        failures++;
                        continue;
                    }
                    if (node.IsDatabase)
                    {
                        await WikiDatabaseService.TrashDatabaseAsync(node.Id, user);
                        if (SelectedDatabaseId == node.Id) SelectedDatabaseId = null;
                    }
                    else
                    {
                        await WikiService.TrashPageAsync(node.Id, user);
                        if (SelectedPageId == node.Id) CreateNewPage();
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Bulk trash failed for Sentinel item {NodeId}.", node.Id);
                    failures++;
                }
            }
            StatusMessage = failures == 0
                ? $"Moved {attempted} item(s) to Trash."
                : $"Moved {attempted - failures} of {attempted} item(s) to Trash ({failures} could not be moved).";
            _selectedTreeNodeIds.Clear();
            _showBulkDeleteConfirm = false;
            await LoadTreeAsync(selectFirstPage: false);
            await LoadWorkspaceNavigationAsync();
        }
        finally { _bulkActionBusy = false; }
    }

    private async Task ConfirmBulkMoveAsync()
    {
        _bulkActionBusy = true;
        try
        {
            var user = await CurrentUserNameAsync();
            var nodesById = AllTreeNodes().ToDictionary(n => n.Id);
            var attempted = _selectedTreeNodeIds.Count;
            var failures = 0;
            foreach (var id in _selectedTreeNodeIds.ToList())
            {
                if (!nodesById.TryGetValue(id, out var node)) continue;
                try
                {
                    // Recomputed per item (not hoisted) so items appended earlier in this same
                    // loop land after each other rather than all claiming the same slot.
                    var newSortOrder = AllTreeNodes().Count(n => n.ParentId == _bulkMoveTargetParentId);
                    if (node.IsDatabase) await WikiDatabaseService.ReorderDatabaseAsync(node.Id, _bulkMoveTargetParentId, newSortOrder, user);
                    else await WikiService.ReorderPageAsync(node.Id, _bulkMoveTargetParentId, newSortOrder, user);
                }
                catch (Exception ex)
                {
                    // ReorderPageAsync/ReorderDatabaseAsync reject a move that would create a
                    // cycle (e.g. a selected page being moved under its own selected
                    // descendant) - expected for some bulk selections, not a bug.
                    Logger.LogWarning(ex, "Bulk move failed for Sentinel item {NodeId}.", node.Id);
                    failures++;
                }
            }
            StatusMessage = failures == 0
                ? $"Moved {attempted} item(s)."
                : $"Moved {attempted - failures} of {attempted} item(s) ({failures} couldn't be moved there - selecting a page together with its own destination or descendant isn't allowed).";
            _selectedTreeNodeIds.Clear();
            _showBulkMoveModal = false;
            if (_bulkMoveTargetParentId.HasValue) _expandedPageIds.Add(_bulkMoveTargetParentId.Value);
            await LoadTreeAsync(selectFirstPage: false);
        }
        finally { _bulkActionBusy = false; }
    }

    private async Task MoveToSelectedParentAsync()
    {
        if (SelectedPageId is not { } wikiPageId)
        {
            return;
        }

        await Work(async () =>
        {
            var user = await CurrentUserNameAsync();
            await WikiService.ReorderPageAsync(wikiPageId, Editor.ParentWikiPageId, int.MaxValue, user);
            await LoadTreeAsync(selectFirstPage: false);
            StatusMessage = "Page moved.";
        });
    }

    private async Task Work(Func<Task> action)
    {
        IsBusy = true;
        ErrorMessage = string.Empty;
        StatusMessage = string.Empty;
        try
        {
            await action();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Wiki page move failed.");
            ErrorMessage = $"Unable to move Sentinel page. {ex.Message}";
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task ToggleDiffAsync(WikiRevisionView revision, WikiRevisionView previousRevision)
    {
        if (DiffRevisionKey == revision.Id)
        {
            DiffRevisionKey = null;
            DiffText = null;
            return;
        }

        if (SelectedPageId is not { } wikiPageId)
        {
            return;
        }

        try
        {
            DiffText = await WikiService.GetStructuralDiffAsync(wikiPageId, previousRevision.Id, revision.Id);
            DiffRevisionKey = revision.Id;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to load diff for wiki page {WikiPageId} between revisions.", wikiPageId);
            HistoryErrorMessage = $"Unable to load diff. {ex.Message}";
        }
    }

    private async Task RevertToRevisionAsync(Guid revisionId)
    {
        if (SelectedPageId is not { } wikiPageId)
        {
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm", "Revert to this version? This creates a new version with the old content - nothing is lost.");
        if (!confirmed) return;

        IsHistoryBusy = true;
        try
        {
            var user = await CurrentUserNameAsync();
            var reverted = await WikiService.RevertToRevisionAsync(wikiPageId, revisionId, user);
            Editor = new WikiPageEditorModel
            {
                WikiPageId = reverted.Id,
                ExpectedContentVersion = reverted.ContentVersion,
                Title = reverted.Title,
                Slug = reverted.Slug,
                BlocksJson = reverted.BlocksJson,
                BaseBlocksJson = reverted.BlocksJson,
                Icon = reverted.Icon,
                CoverImageUrl = reverted.CoverImageUrl,
                ParentWikiPageId = reverted.ParentWikiPageId,
                IsFullWidth = reverted.IsFullWidth,
                FontStyle = reverted.FontStyle
            };
            _editorGeneration++;
            DiffRevisionKey = null;
            StatusMessage = $"Reverted '{reverted.Title}' to an earlier version.";
            PageConflict = null;
            await LoadTreeAsync(selectFirstPage: false);
            await LoadHistoryAsync(wikiPageId);
            Backlinks = (await SentinelWorkspaceService.GetBacklinksAsync(wikiPageId, CurrentUsername)).ToList();
            await LoadWorkspaceNavigationAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to revert wiki page {WikiPageId} to revision {RevisionId}.", wikiPageId, revisionId);
            HistoryErrorMessage = $"Unable to revert. {ex.Message}";
        }
        finally
        {
            IsHistoryBusy = false;
        }
    }

    // A page and a database look interchangeable in the sidebar tree (both have a title,
    // icon, parent, and sort order), so this is what tree rendering/reordering actually
    // operates over - WikiPage/WikiDatabase-specific behavior (opening, saving, deleting)
    // still dispatches through their own services once a node is selected.
    private readonly record struct WikiTreeNode(
        Guid Id,
        string Title,
        string? Icon,
        Guid? ParentId,
        int SortOrder,
        bool IsDatabase,
        string? NotionId,
        DateTimeOffset? NotionArchivedAt)
    {
        public bool IsNotionSynced => !string.IsNullOrWhiteSpace(NotionId);
        public bool IsArchived => NotionArchivedAt.HasValue;
    }

    private List<WikiTreeNode> AllTreeNodes() =>
        WikiPages.Select(p => new WikiTreeNode(p.Id, p.Title, p.Icon, p.ParentWikiPageId, p.SortOrder, false, p.NotionId, p.NotionArchivedAt))
            .Concat(WikiDatabases.Select(d => new WikiTreeNode(d.Id, d.Title, d.Icon, d.ParentWikiPageId, d.SortOrder, true, d.NotionId, d.NotionArchivedAt)))
            .ToList();

    // Recursive depth-first flatten via ToLookup(ParentId), rendered as an indented flat
    // list with expand/collapse rather than a nested component - mirrors Pages.razor's
    // OrderedPagesByHierarchy()/GetPageDepth() for CMS pages.
    private List<WikiTreeNode> OrderedTreeNodes()
    {
        var nodes = AllTreeNodes();
        var byId = nodes.ToDictionary(node => node.Id);
        return SentinelTreeNavigation.GetVisibleNodeIds(
                nodes.Select(ToNavigationNode).ToList(),
                _expandedPageIds)
            .Where(byId.ContainsKey)
            .Select(nodeId => byId[nodeId])
            .ToList();
    }

    private bool HasChildren(Guid nodeId) => AllTreeNodes().Any(n => n.ParentId == nodeId);
    private bool IsExpanded(Guid nodeId) => _expandedPageIds.Contains(nodeId);
    private void ToggleExpanded(Guid nodeId)
    {
        if (!_expandedPageIds.Add(nodeId))
        {
            _expandedPageIds.Remove(nodeId);
        }
    }

    private IReadOnlySet<Guid> BranchNodeIds() =>
        SentinelTreeNavigation.GetBranchNodeIds(
            AllTreeNodes().Select(ToNavigationNode).ToList());

    private bool AreAllBranchesExpanded(IReadOnlySet<Guid> branchNodeIds) =>
        branchNodeIds.Count > 0 && branchNodeIds.All(_expandedPageIds.Contains);

    private void ToggleAllBranches()
    {
        var branchNodeIds = BranchNodeIds();
        if (branchNodeIds.Count > 0 && branchNodeIds.All(_expandedPageIds.Contains))
        {
            _expandedPageIds.Clear();
            return;
        }

        _expandedPageIds.UnionWith(branchNodeIds);
    }

    private void ExpandAncestorPath(Guid nodeId)
    {
        _expandedPageIds.UnionWith(
            SentinelTreeNavigation.GetAncestorNodeIds(
                nodeId,
                AllTreeNodes().Select(ToNavigationNode).ToList()));
    }

    private static SentinelTreeNavigationNode ToNavigationNode(WikiTreeNode node) =>
        new(node.Id, node.ParentId, node.SortOrder);

    private IReadOnlyList<WikiTreeNode> CurrentBreadcrumbNodes()
    {
        var selectedNodeId = SelectedPageId ?? SelectedDatabaseId;
        if (selectedNodeId is null)
        {
            return [];
        }

        var nodes = AllTreeNodes();
        var byId = nodes.ToDictionary(node => node.Id);
        return SentinelTreeNavigation.GetBreadcrumbNodeIds(
                selectedNodeId.Value,
                nodes.Select(ToNavigationNode).ToList())
            .Where(byId.ContainsKey)
            .Select(nodeId => byId[nodeId])
            .ToList();
    }

    // A page saved with no title shows the editor's "Untitled" placeholder; navigation labels
    // need the same fallback or the parent button renders as a bare arrow.
    private static string NodeTitle(WikiTreeNode node) =>
        string.IsNullOrWhiteSpace(node.Title) ? (node.IsDatabase ? "Untitled Database" : "Untitled") : node.Title;

    private WikiTreeNode? CurrentParentNode()
    {
        var selectedNodeId = SelectedPageId ?? SelectedDatabaseId;
        if (selectedNodeId is null)
        {
            return null;
        }

        var nodes = AllTreeNodes();
        var byId = nodes.ToDictionary(node => node.Id);
        return SentinelTreeNavigation.GetParentNodeId(
                selectedNodeId.Value,
                nodes.Select(ToNavigationNode).ToList()) is { } parentId
            && byId.TryGetValue(parentId, out var parent)
                ? parent
                : null;
    }

    private int GetNodeDepth(WikiTreeNode node)
    {
        var byId = AllTreeNodes().ToDictionary(n => n.Id);
        var depth = 0;
        var current = (WikiTreeNode?)node;
        var guard = 0;
        while (current?.ParentId is { } parentId && byId.TryGetValue(parentId, out var parent) && guard++ < 64)
        {
            depth++;
            current = parent;
        }

        return depth;
    }

    // With no search query, the tree is shown collapsed to top-level + expanded branches.
    // Once searching, a matched child's ancestors may not themselves be expanded, so tree
    // order stops making sense - fall back to a flat alphabetical list of matches.
    private List<WikiTreeNode> FilteredAndOrderedNodes()
    {
        if (string.IsNullOrWhiteSpace(SearchQuery))
        {
            return OrderedTreeNodes();
        }

        return AllTreeNodes()
            .Where(n => n.Title.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase))
            .OrderBy(n => n.Title, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private async Task OpenNodeAsync(WikiTreeNode node)
    {
