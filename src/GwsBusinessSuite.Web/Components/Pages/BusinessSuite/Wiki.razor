    private async Task DeactivateBlockEditorAsync()
    {
        if (!_blockEditorInitialized || _blockEditorModule is null)
        {
            return;
        }

        try
        {
            await _blockEditorModule.InvokeVoidAsync("dispose", _blockEditorContainer);
        }
        catch (JSDisconnectedException)
        {
            // Navigation can race a disconnected circuit; the removed DOM will be collected.
        }
        finally
        {
            _blockEditorInitialized = false;
            _blockEditorSyncedGeneration = -1;
        }
    }

    private Task OpenPageAsync(Guid wikiPageId) => OpenPageAsync(wikiPageId, recordHistory: true);

    private async Task OpenPageAsync(Guid wikiPageId, bool recordHistory)
    {
        // Flush any pending autosave from whatever was previously open before this method
        // replaces Editor with the target page's data - otherwise an in-progress edit is
        // silently discarded the instant navigation happens. If the flush itself surfaces a
        // genuine concurrent-edit conflict, stop here so the user actually sees the recovery
        // UI instead of navigating straight past it.
        await FlushAutosaveAsync();
        if (PageConflict is not null) return;

        try
        {
            if (!await CanAccessPageOrDatabaseAsync(wikiPageId, isDatabase: false, SentinelAccessLevels.View))
            {
                ErrorMessage = "You don't have access to this Sentinel page.";
                return;
            }

            var page = await WikiService.GetPageAsync(wikiPageId);
            if (page is null)
            {
                StatusMessage = "The selected Sentinel page no longer exists.";
                return;
            }

            PushCurrentLocationToBackStack(recordHistory, newPageId: page.Id, newDatabaseId: null);
            _mobileWorkspaceNavOpen = false;
            SearchQuery = string.Empty;
            WorkspaceSearchResults = new();
            SelectedDatabaseId = null;
            LeaveCursorTracking();
            SelectedPageId = page.Id;
            ExpandAncestorPath(page.Id);
            Editor = new WikiPageEditorModel
            {
                WikiPageId = page.Id,
                ExpectedContentVersion = page.ContentVersion,
                Title = page.Title,
                Slug = page.Slug,
                BlocksJson = WikiBlockJson.RefreshPageLinkTitles(page.BlocksJson,
                    WikiPages.ToDictionary(p => p.Id, p => (p.Title, (string?)p.Icon))),
                BaseBlocksJson = page.BlocksJson,
                Icon = page.Icon,
                CoverImageUrl = page.CoverImageUrl,
                ParentWikiPageId = page.ParentWikiPageId,
                IsFullWidth = page.IsFullWidth,
                FontStyle = page.FontStyle
            };
            _editorGeneration++;
            PageConflict = null;
            DiffRevisionKey = null;
            StatusMessage = $"Opened Sentinel page '{(string.IsNullOrWhiteSpace(page.Title) ? "Untitled" : page.Title)}'.";
            ErrorMessage = string.Empty;
            await InvokeAsync(StateHasChanged);

            // Opening the document must not depend on recents, backlinks, or history. Those
            // secondary panels are useful, but a failure in one of them should never make an
            // imported Notion page appear unopenable.
            try
            {
                await LoadHistoryAsync(page.Id);
                Backlinks = (await SentinelWorkspaceService.GetBacklinksAsync(page.Id, CurrentUsername)).ToList();
                await SentinelWorkspaceService.RecordOpenedAsync(CurrentUsername, page.Id, false);
                await LoadWorkspaceNavigationAsync();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Opened Sentinel page {WikiPageId}, but secondary page data could not be loaded.", page.Id);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to open wiki page {WikiPageId}.", wikiPageId);
            ErrorMessage = $"Unable to open Sentinel page. {ex.Message}";
        }
    }

