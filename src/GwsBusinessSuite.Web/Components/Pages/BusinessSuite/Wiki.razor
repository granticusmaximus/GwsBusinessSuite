        ErrorMessage = string.Empty;
    }

    // "+ New page" creates a real page straight away and opens it, rather than only clearing
    // the editor to an unsaved blank: Sentinel already shows that same blank "Untitled" editor
    // when nothing is selected, so the old behavior looked like nothing happened at all, and the
    // page only appeared in the sidebar once autosave first fired. Autosave takes over from here.
    private Task NewBlankPageAsync() => CreateAndOpenPageAsync(string.Empty, null, null, "Unable to create the page.");

    private async Task CreateAndOpenPageAsync(string title, string? blocksJson, string? icon, string failureMessage)
    {
        await FlushAutosaveAsync();
        if (PageConflict is not null) return;

        IsBusy = true;
        ErrorMessage = string.Empty;
        StatusMessage = string.Empty;
        Guid? createdId = null;
        try
        {
            var user = await CurrentUserNameAsync();
            var editor = new WikiPageEditorModel { Title = title };
            if (blocksJson is not null) editor.BlocksJson = blocksJson;
            if (icon is not null) editor.Icon = icon;
            var saved = await WikiService.SavePageAsync(editor, user);
            createdId = saved.Id;
            await LoadTreeAsync(selectFirstPage: false);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Creating a new Sentinel page failed.");
            ErrorMessage = $"{failureMessage} {ex.Message}";
        }
        finally
        {
            IsBusy = false;
        }

        if (createdId is { } pageId)
        {
            await OpenPageAsync(pageId, recordHistory: true);
            // OpenPageAsync's "Opened Sentinel page '...'" note reads oddly for a page that was
            // just created (and usually has no title yet) - the open page says it all.
            if (StatusMessage.StartsWith("Opened Sentinel page", StringComparison.Ordinal))
            {
                StatusMessage = string.Empty;
            }
            _focusTitleAfterRender = true;
        }
    }

