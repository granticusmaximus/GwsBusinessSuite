    private async Task OpenDatabaseAsync(Guid wikiDatabaseId, bool recordHistory)
    {
        // Flush any pending page-editor autosave before this method blanks SelectedPageId out
        // from under it - otherwise the in-progress edit becomes orphaned in memory and is
        // lost the moment something else replaces Editor (e.g. the next page opened). If the
        // flush surfaces a genuine concurrent-edit conflict, stop so the user sees it.
        await FlushAutosaveAsync();
        if (PageConflict is not null) return;
        if (!await CanAccessPageOrDatabaseAsync(wikiDatabaseId, isDatabase: true, SentinelAccessLevels.View))
        {
            ErrorMessage = "You don't have access to this Sentinel database.";
            return;
        }
        _canEditOpenDatabase = await CanAccessPageOrDatabaseAsync(wikiDatabaseId, isDatabase: true, SentinelAccessLevels.Edit);

        PushCurrentLocationToBackStack(recordHistory, newPageId: null, newDatabaseId: wikiDatabaseId);
        _mobileWorkspaceNavOpen = false;
        ExpandAncestorPath(wikiDatabaseId);
        await DeactivateBlockEditorAsync();
        LeaveCursorTracking();
        SelectedPageId = null;
        SelectedDatabaseId = wikiDatabaseId;
        Backlinks = new();
        DiffRevisionKey = null;
        StatusMessage = string.Empty;
        ErrorMessage = string.Empty;
        await SentinelWorkspaceService.RecordOpenedAsync(CurrentUsername, wikiDatabaseId, true);
        await LoadWorkspaceNavigationAsync();
    }

    // An open-task item opens the page it lives on directly. An assigned-row item opens the
    // database rather than deep-linking the specific row - Wiki.razor has no way to hand a
    // target row id to WikiDatabaseEditor's own row-detail state from here, so this gets the
    // user to the right place, not all the way to the exact row; SourceRowId is kept on the
    // item for a future version of this that can.
    private Task OpenMyWorkItemAsync(SentinelMyWorkItem item) =>
        item.IsDatabase ? OpenDatabaseAsync(item.Id) : OpenPageAsync(item.Id);

