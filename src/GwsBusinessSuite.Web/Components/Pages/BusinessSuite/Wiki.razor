    }

    [JSInvokable]
    public async Task OnDraftRecovered(string blocksJson)
    {
        Editor.BlocksJson = blocksJson;
        StatusMessage = "Recovered an unsaved local draft from this browser.";
        await InvokeAsync(StateHasChanged);
    }

    private async Task<string> CaptureEditorBlocksAsync()
    {
        if (_blockEditorInitialized && _blockEditorModule is not null)
        {
            Editor.BlocksJson = await _blockEditorModule.InvokeAsync<string>(
                "getBlocksJson", _blockEditorContainer);
        }

        return Editor.BlocksJson;
    }

    // Silent background persistence for the main page editor, mirroring the pattern already
    // used for database row pages (SentinelDatabaseRowPage.ScheduleAutosave): debounced so a
    // burst of keystrokes becomes one write, and passes createRevisionCheckpoint=false so it
    // never mints a version-history entry on its own - only an explicit "Save changes" click
    // (or a revert) does that. This is also what fixes a brand-new, never-saved page actually
    // persisting: the first tick creates the real WikiPage row instead of the title/icon/
    // content being silently lost if the user navigates away before ever clicking Save.
    private void ScheduleAutosave()
    {
        _hasUnsavedAutosaveChanges = true;
        _autosaveCts?.Cancel();
        _autosaveCts?.Dispose();
        var cts = new CancellationTokenSource();
        _autosaveCts = cts;
        _autosaveStatus = "Editing…";
        _ = AutosaveAfterDelayAsync(cts.Token);
    }

    private async Task AutosaveAfterDelayAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(1.5), cancellationToken);
        }
        catch (TaskCanceledException)
        {
            return;
        }
        if (cancellationToken.IsCancellationRequested) return;

        await PerformAutosaveAsync(cancellationToken);
    }

    // Cancels any pending debounce timer, without saving, for resets where in-progress edits
    // must be discarded: the editor being pointed at a fresh/blank state because its
    // underlying page was just trashed out from under it. CreateNewPage always starts here.
    private void DiscardPendingAutosave()
    {
        _autosaveCts?.Cancel();
        _autosaveCts?.Dispose();
        _autosaveCts = null;
        _hasUnsavedAutosaveChanges = false;
        _autosaveStatus = string.Empty;
    }

    // Cancels any pending debounce timer and, if there are edits it hasn't written yet, saves
    // them immediately. Called from every place the editor is about to move on from the page
    // currently open (open a different page/database) so "typed, then clicked away before the
    // debounce fired" can no longer lose work - the exact bug this autosave path exists to fix.
    private async Task FlushAutosaveAsync()
    {
        _autosaveCts?.Cancel();
        _autosaveCts?.Dispose();
        _autosaveCts = null;
        if (!_hasUnsavedAutosaveChanges) return;
        await PerformAutosaveAsync(CancellationToken.None);
    }

    private async Task PerformAutosaveAsync(CancellationToken cancellationToken)
    {
        if (IsBusy) return;
        if (Editor.WikiPageId is { } existingPageId
            && !await CanAccessPageOrDatabaseAsync(existingPageId, isDatabase: false, SentinelAccessLevels.Edit))
        {
            // A permission change mid-edit is rare and not autosave's job to explain - the
            // explicit Save button's own permission check already surfaces that clearly.
            return;
        }

        try
        {
            await CaptureEditorBlocksAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit is tearing down - fall back to whatever Editor.BlocksJson last held
            // from OnBlocksChanged (at most ~250ms stale) rather than failing the flush.
        }

        try
        {
            await _saveLock.WaitAsync(cancellationToken);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        var wasNew = !Editor.WikiPageId.HasValue;
        try
        {
            var user = await CurrentUserNameAsync();
            var saved = await WikiService.SavePageAsync(Editor, user, createRevisionCheckpoint: false, cancellationToken: cancellationToken);
            if (cancellationToken.IsCancellationRequested) return;

            Editor.WikiPageId = saved.Id;
            Editor.ExpectedContentVersion = saved.ContentVersion;
            Editor.BaseBlocksJson = saved.BlocksJson;
            Editor.Slug = saved.Slug;
            _hasUnsavedAutosaveChanges = false;
            _autosaveStatus = "Saved";

            // Keep the sidebar/breadcrumb title in step with an autosaved title edit, without
            // reloading the whole tree on every debounced save.
            if (WikiPages.FirstOrDefault(p => p.Id == saved.Id) is { } treePage && treePage.Title != saved.Title)
            {
                treePage.Title = saved.Title;
            }

            if (wasNew)
            {
                // The page just became real - reflect it in the sidebar/breadcrumbs the same
                // way an explicit Save does, so the user can find it again later.
                SelectedPageId = saved.Id;
                ExpandAncestorPath(saved.Id);
                await LoadTreeAsync(selectFirstPage: false);

                // CreateNewPage()/CreateNewPageFromTemplateAsync set StatusMessage to a "ready
                // to create" flash message before any real page existed. Autosave never touched
                // StatusMessage before this fix, so that message outlived its own truth the
                // moment the page was actually saved - it would sit there, increasingly
                // inaccurate, for as long as the user kept editing, since nothing else was
                // guaranteed to overwrite it. The ongoing _autosaveStatus indicator (rendered
                // separately, near the editor toolbar) is the correct place to see live save
                // state going forward, so this one-off message has fully served its purpose.
                if (StatusMessage.StartsWith("Ready to create", StringComparison.Ordinal))
                {
                    StatusMessage = string.Empty;
                }
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (WikiPageConcurrencyException ex)
        {
            Logger.LogWarning(ex, "Sentinel page {WikiPageId} had a concurrent edit conflict during autosave.", Editor.WikiPageId);
            PageConflict = ex.Conflict;
            _autosaveStatus = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) when (!cancellationToken.IsCancellationRequested)
        {
            Logger.LogError(ex, "Autosave failed for Sentinel page {WikiPageId}.", Editor.WikiPageId);
            _autosaveStatus = "Autosave failed - use ⋯ > Save a version to retry";
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            _saveLock.Release();
        }
    }

    private async Task InsertBlockTemplateAsync(string templateBlocksJson)
    {
        var currentBlocks = WikiBlockJson.ParseBlocks(await CaptureEditorBlocksAsync()).ToList();
        if (currentBlocks.Count == 1
            && currentBlocks[0].Type == WikiBlockTypes.Paragraph
            && currentBlocks[0].RichText.Count == 0
            && currentBlocks[0].Props.Count == 0)
        {
            currentBlocks.Clear();
        }

        currentBlocks.AddRange(WikiBlockJson.ParseBlocks(templateBlocksJson));
        Editor.BlocksJson = WikiBlockJson.Serialize(currentBlocks);
        _editorGeneration++;
        StatusMessage = "Inserted reusable blocks. Save the page to persist them.";
        await InvokeAsync(StateHasChanged);
    }

    // Backing the "+"/"/" block picker's "Page"/"New database" entries (wiki-block-editor.js's
    // commitBlockPickerItem). Like Notion, the child is created nested under this page, the block
    // that triggered it becomes a link to the child, and then the child opens. Creating and opening
    // are two calls so the editor can swap in the link block between them; OpenCreatedChildFromEditor
    // saves the parent with that link before navigating away.
    public sealed record CreatedChildFromEditor(string Id, string Title, string Icon);

    [JSInvokable]
    public async Task<CreatedChildFromEditor?> CreateChildPageFromEditor(string title)
    {
        return await CreateChildFromEditorAsync(title, isDatabase: false);
    }

    [JSInvokable]
    public async Task<CreatedChildFromEditor?> CreateChildDatabaseFromEditor(string title)
    {
        return await CreateChildFromEditorAsync(title, isDatabase: true);
    }

    [JSInvokable]
    public async Task OpenCreatedChildFromEditor(string childId, bool isDatabase, string parentBlocksJson)
    {
        if (!Guid.TryParse(childId, out var id)) return;
        if (Editor.WikiPageId.HasValue && !string.IsNullOrWhiteSpace(parentBlocksJson))
        {
            // The parent's link block must be saved before OpenPageAsync replaces Editor.
            Editor.BlocksJson = parentBlocksJson;
            _hasUnsavedAutosaveChanges = true;
        }

        if (isDatabase) await OpenDatabaseAsync(id);
        else
        {
            await OpenPageAsync(id);
            if (SelectedPageId == id)
            {
                // A just-created child opens ready to type its title, like "+ New page".
                StatusMessage = string.Empty;
                _focusTitleAfterRender = true;
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task<CreatedChildFromEditor?> CreateChildFromEditorAsync(string title, bool isDatabase)
    {
        try
        {
            // Persist a new parent and finish pending edits before creating its child.
            await FlushAutosaveAsync();
            if (!Editor.WikiPageId.HasValue)
            {
                await PerformAutosaveAsync(CancellationToken.None);
            }
            if (!Editor.WikiPageId.HasValue || _hasUnsavedAutosaveChanges)
            {
                ErrorMessage = "Save the parent page before creating a child.";
                return null;
            }

            var parentId = Editor.WikiPageId.Value;
            if (!await CanAccessPageOrDatabaseAsync(parentId, isDatabase: false, SentinelAccessLevels.Edit))
            {
                ErrorMessage = "You don't have permission to create a child here.";
                return null;
            }

            var user = await CurrentUserNameAsync();
            CreatedChildFromEditor created;
            await _saveLock.WaitAsync();
            try
            {
                if (isDatabase)
                {
                    var database = await WikiDatabaseService.CreateDatabaseAsync(
                        string.IsNullOrWhiteSpace(title) ? "Untitled Database" : title.Trim(), parentId, user);
                    created = new(database.Id.ToString(), database.Title, database.Icon ?? string.Empty);
                }
                else
                {
                    // An empty title shows the "Untitled" placeholder, same as "+ New page", so
                    // the user can type the real title straight away.
                    var page = await WikiService.SavePageAsync(new WikiPageEditorModel
                    {
                        Title = title?.Trim() ?? string.Empty,
                        ParentWikiPageId = parentId
                    }, user);
                    created = new(page.Id.ToString(), page.Title, page.Icon ?? string.Empty);
                }
            }
            finally
            {
                _saveLock.Release();
            }

            await LoadTreeAsync(selectFirstPage: false);
            return created;
        }
        catch (Exception ex)
        {
            // EF wraps the real cause ("UNIQUE constraint failed: ...") in a generic "see the
            // inner exception" message, so log the full exception and surface the root cause.
            Logger.LogError(ex, "Creating a child {Kind} under Sentinel page {WikiPageId} failed.",
                isDatabase ? "database" : "page", Editor.WikiPageId);
            ErrorMessage = $"Unable to create the child {(isDatabase ? "database" : "page")}. {ex.GetBaseException().Message}";
            return null;
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

