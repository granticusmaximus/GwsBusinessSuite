    private async Task RestoreLastOpenedItemAsync()
    {
        var lastOpened = Navigation.Recents.FirstOrDefault(item =>
            item.IsDatabase
                ? WikiDatabases.Any(database =>
                    database.Id == item.Id && database.NotionArchivedAt is null)
                : WikiPages.Any(page =>
                    page.Id == item.Id && page.NotionArchivedAt is null));
        if (lastOpened is null)
        {
            return;
        }

        await OpenNavigationItemAsync(lastOpened);
        // Restoration should feel like continuity, not a new user action that needs a banner.
        StatusMessage = string.Empty;
    }

    private async Task LoadTreeAsync(bool selectFirstPage)
    {
        try
        {
            WikiPages = (await WikiService.ListPagesAsync()).ToList();
            WikiDatabases = (await WikiDatabaseService.ListDatabasesAsync()).ToList();
            TrashedPages = (await WikiService.ListTrashedPagesAsync()).ToList();
            TrashedDatabases = (await WikiDatabaseService.ListTrashedDatabasesAsync()).ToList();
            if (!_isAdmin)
            {
                var visibleTargets = await SentinelAccessService.GetAccessibleTargetsAsync(
                    WikiPages.Select(page => new SentinelAccessTarget(page.Id, IsDatabase: false))
                        .Concat(WikiDatabases.Select(database => new SentinelAccessTarget(database.Id, IsDatabase: true)))
                        .ToList(),
                    CurrentUsername,
                    SentinelAccessLevels.View);
                WikiPages = WikiPages.Where(page => visibleTargets.Contains(
                    new SentinelAccessTarget(page.Id, IsDatabase: false))).ToList();
                WikiDatabases = WikiDatabases.Where(database => visibleTargets.Contains(
                    new SentinelAccessTarget(database.Id, IsDatabase: true))).ToList();

                var manageableTrashTargets = await SentinelAccessService.GetAccessibleTargetsAsync(
                    TrashedPages.Select(page => new SentinelAccessTarget(page.Id, IsDatabase: false))
                        .Concat(TrashedDatabases.Select(database => new SentinelAccessTarget(database.Id, IsDatabase: true)))
                        .ToList(),
                    CurrentUsername,
                    SentinelAccessLevels.FullAccess);
                TrashedPages = TrashedPages.Where(page => manageableTrashTargets.Contains(
                    new SentinelAccessTarget(page.Id, IsDatabase: false))).ToList();
                TrashedDatabases = TrashedDatabases.Where(database => manageableTrashTargets.Contains(
                    new SentinelAccessTarget(database.Id, IsDatabase: true))).ToList();
            }
            if (selectFirstPage && WikiPages.Count > 0)
            {
                await OpenPageAsync(WikiPages[0].Id);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to load the wiki page/database tree.");
            ErrorMessage = $"Unable to load pages and databases. {ex.Message}";
        }
    }

