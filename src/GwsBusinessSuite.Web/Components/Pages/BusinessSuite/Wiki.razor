@page "/admin/wiki"
@page "/admin/sentinel"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "ContentAccess")]
@implements IAsyncDisposable
@using GwsBusinessSuite.Application.Wiki
@using GwsBusinessSuite.Application.CmsBuilder
@using GwsBusinessSuite.Domain.Entities
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.WebUtilities
@inject IWikiService WikiService
@inject IWikiDatabaseService WikiDatabaseService
@inject IWikiSyncedBlockService WikiSyncedBlockService
@inject ISentinelWorkspaceService SentinelWorkspaceService
@inject ISentinelAccessService SentinelAccessService
@inject INotionSyncService NotionSyncService
@inject INotionSyncCoordinator NotionSyncCoordinator
@inject INotionOAuthService NotionOAuthService
@inject IMediaLibraryService MediaLibraryService
@inject ISentinelTemplateService SentinelTemplateService
@inject ICurrentUserAccessor CurrentUserAccessor
@inject SentinelCursorTracker CursorTracker
@inject IJSRuntime JS
@inject NavigationManager Navigator
@inject ILogger<Wiki> Logger

<PageTitle>Sentinel</PageTitle>

<div class="sentinel-workspace">
@if (_paletteOpen)
{
    <div class="sentinel-command-palette-backdrop" @onclick="CloseCommandPalette">
        <div class="sentinel-command-palette" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-label="Search Sentinel">
            <div class="sentinel-command-palette-input">
                <i class="bi bi-search"></i>
                <input @ref="_paletteInputRef" @bind="_paletteQuery" @bind:event="oninput" @bind:after="SearchCommandPaletteAsync"
                       @onkeydown="HandlePaletteKeyDownAsync"
                       placeholder="Search pages, content, databases, and rows..."
                       aria-label="Search every Sentinel page, block, database, and row" />
                @if (_paletteBusy)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                }
                <kbd>Esc</kbd>
            </div>
            @if (_paletteRawResults.Count > 0)
            {
                <div class="sentinel-command-palette-filters">
                    <select class="form-select form-select-sm" @bind="_paletteAuthorFilter" @bind:after="ApplyPaletteFilters" aria-label="Filter search results by author">
                        <option value="">Any author</option>
                        @foreach (var author in _paletteRawResults.Select(result => result.CreatedBy).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(author => author, StringComparer.OrdinalIgnoreCase))
                        {
                            <option value="@author">@author</option>
                        }
                    </select>
                    <select class="form-select form-select-sm" @bind="_paletteDateFilter" @bind:after="ApplyPaletteFilters" aria-label="Filter search results by date">
                        <option value="">Any time</option>
                        <option value="week">Past week</option>
                        <option value="month">Past month</option>
                        <option value="year">Past year</option>
                    </select>
                </div>
            }
            <div class="sentinel-command-palette-results">
                @if (string.IsNullOrWhiteSpace(_paletteQuery))
                {
                    <div class="sentinel-command-palette-empty">Start typing to search everything in Sentinel.</div>
                }
                else if (_paletteRawResults.Count == 0 && !_paletteBusy)
                {
                    <div class="sentinel-command-palette-empty">Nothing matches "@_paletteQuery".</div>
                }
                else if (_paletteResults.Count == 0 && !_paletteBusy)
                {
                    <div class="sentinel-command-palette-empty">No results match the current filters.</div>
                }
                else
                {
                    @for (var index = 0; index < _paletteResults.Count; index++)
                    {
                        var result = _paletteResults[index];
                        var isSelected = index == _paletteSelectedIndex;
                        <button type="button" class="sentinel-command-palette-item @(isSelected ? "is-selected" : string.Empty)"
                                @onclick="() => OpenPaletteResultAsync(result)" @onmouseenter="() => _paletteSelectedIndex = index">
                            <i class="bi @(result.IsDatabase ? "bi-grid-3x3-gap-fill" : "bi-file-earmark-text")"></i>
                            <span>
                                <strong>@HighlightMatches(result.Title, result.MatchedTerms)</strong>
                                <small>@HighlightMatches(result.Preview, result.MatchedTerms)</small>
                            </span>
                            <span class="badge text-bg-light border">@result.MatchKind</span>
                        </button>
                    }
                }
            </div>
        </div>
    </div>
}
<div class="sentinel-workspace-header">
    <div class="sentinel-workspace-identity">
        <button type="button" class="sentinel-sidebar-shortcut" @onclick="ToggleWorkspaceBrowser"
                aria-controls="sentinel-workspace-browser" aria-expanded="@(!_workspaceBrowserCollapsed)"
                aria-label="@(_workspaceBrowserCollapsed ? "Open workspace browser" : "Close workspace browser")"
                title="Toggle workspace browser (Ctrl/⌘ + \)">
            <i class="bi bi-layout-sidebar-inset"></i>
        </button>
        <div class="sentinel-brand-mark" aria-hidden="true">S</div>
        <div>
            <div class="sentinel-eyebrow">GWS workspace</div>
            <h1>Sentinel <i class="bi bi-chevron-down" aria-hidden="true"></i></h1>
        </div>
    </div>
    <div class="sentinel-workspace-actions">
        <button type="button" class="btn btn-sm btn-outline-secondary sentinel-global-search"
                @onclick="OpenCommandPaletteAsync" title="Search every Sentinel page, block, database, and row">
            <i class="bi bi-search me-1"></i>Quick find
            <kbd>⌘K</kbd>
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary sentinel-mobile-nav-toggle"
                @onclick="ToggleMobileWorkspaceNav" aria-controls="sentinel-workspace-browser"
                aria-expanded="@_mobileWorkspaceNavOpen">
            <i class="bi bi-layout-sidebar-inset me-1"></i>@(_mobileWorkspaceNavOpen ? "Close browser" : "Browse")
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OpenNotionModalAsync" disabled="@IsBusy">
            <i class="bi bi-arrow-repeat me-1"></i>Notion sync
        </button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="alert alert-danger sentinel-notice d-flex align-items-start gap-2" role="alert">
        <i class="bi bi-exclamation-triangle-fill mt-1 flex-shrink-0"></i>
        <div>@ErrorMessage</div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(StatusMessage))
{
    <div class="alert alert-info sentinel-notice d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-check-circle-fill flex-shrink-0"></i>
        <div>@StatusMessage</div>
    </div>
}

@if (PageConflict is not null)
{
    <div class="alert alert-warning sentinel-notice" role="alert">
        <div class="d-flex align-items-start gap-2">
            <i class="bi bi-exclamation-diamond-fill mt-1"></i>
            <div class="flex-grow-1">
                <div class="fw-semibold">This page changed while you were editing.</div>
                <div class="small mt-1">
                    Your local draft is still in the editor. The latest content generation is
                    @PageConflict.CurrentContentVersion@(string.IsNullOrWhiteSpace(PageConflict.UpdatedBy) ? "." : $", saved by {PageConflict.UpdatedBy}.")
                </div>
                <div class="d-flex flex-wrap gap-2 mt-3">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ReloadLatestAfterConflictAsync">Reload latest</button>
                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="SaveConflictAsCopyAsync">Save my draft as a copy</button>
                    <button type="button" class="btn btn-sm btn-warning" @onclick="OverwriteAfterConflictAsync">Overwrite latest</button>
                </div>
            </div>
        </div>
    </div>
}

<div class="sentinel-layout @(_workspaceBrowserCollapsed ? "is-browser-collapsed" : string.Empty) @(SelectedPageId.HasValue ? "has-context-sidebar" : string.Empty) @(!_contextSidebarOpen ? "is-context-collapsed" : string.Empty)">
    <aside id="sentinel-workspace-browser" class="sentinel-local-sidebar @(_mobileWorkspaceNavOpen ? "is-mobile-open" : string.Empty)"
           aria-label="Sentinel workspace browser">
        <div class="sentinel-nav-panel">
            <div class="sentinel-nav-toolbar">
                <div>
                    <span class="fw-semibold">@CurrentUsername</span>
                    <small>Private workspace</small>
                </div>
                <div class="d-flex gap-1">
                    <div class="btn-group">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="NewBlankPageAsync" disabled="@IsBusy" title="New blank page">
                            <i class="bi bi-file-earmark-plus"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle dropdown-toggle-split" type="button"
                                data-bs-toggle="dropdown" aria-expanded="false" disabled="@IsBusy" title="New page from a starter template">
                            <span class="visually-hidden">Starter templates</span>
                        </button>
                        <ul class="dropdown-menu">
                            <li><button type="button" class="dropdown-item" @onclick="NewBlankPageAsync">📄 Blank page</button></li>
                            <li><hr class="dropdown-divider" /></li>
                            @foreach (var template in SentinelStarterTemplates.All)
                            {
                                <li><button type="button" class="dropdown-item" @onclick="() => CreateNewPageFromTemplateAsync(template.Key)">@template.Icon @template.Name</button></li>
                            }
                        </ul>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="CreateNewDatabaseAsync" disabled="@IsBusy" title="New database">
                        <i class="bi bi-grid-3x3-gap-fill"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary position-relative" @onclick="OpenTrashModal" disabled="@IsBusy" title="Trash">
                        <i class="bi bi-trash3"></i>
                        @if (TrashedPages.Count + TrashedDatabases.Count > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill text-bg-secondary" style="font-size:.55rem;">
                                @(TrashedPages.Count + TrashedDatabases.Count)
                            </span>
                        }
                    </button>
                </div>
            </div>
            <div class="sentinel-nav-search">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input id="sentinelWorkspaceSearch" @ref="_workspaceSearchInput" class="form-control"
                           @bind="SearchQuery" @bind:event="oninput" @bind:after="SearchWorkspaceAsync"
                           placeholder="Search pages, content, databases, and rows..."
                           aria-label="Search every Sentinel page, block, database, and row" />
                    @if (IsSearchBusy)
                    {
                        <span class="input-group-text bg-white"><span class="spinner-border spinner-border-sm"></span></span>
                    }
                    else if (!string.IsNullOrWhiteSpace(SearchQuery))
                    {
                        <button type="button" class="btn btn-outline-secondary" @onclick="SaveCurrentSearchAsync"
                                disabled="@IsCurrentSearchSaved" aria-label="Save this search" title="@(IsCurrentSearchSaved ? "Already saved" : "Save this search")">
                            <i class="bi @(IsCurrentSearchSaved ? "bi-bookmark-check-fill" : "bi-bookmark-plus")"></i>
                        </button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="ClearSearchAsync"
                                aria-label="Clear Sentinel search" title="Clear search">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    }
                </div>
                <div class="sentinel-search-scope">
                    Searches titles and the contents of pages, attachments, databases, and rows.
                </div>
            </div>
            <a class="sentinel-gpt-entry" href="admin/sentinel-gpt">
                <span class="sentinel-gpt-entry-icon"><i class="bi bi-chat-dots-fill"></i></span>
                <span><strong>SentinelGPT</strong><small>Chat with your workspace</small></span>
                <i class="bi bi-chevron-right"></i>
            </a>
            @if (string.IsNullOrWhiteSpace(SearchQuery)
                && (Navigation.Favorites.Count > 0 || Navigation.Recents.Count > 0 || Mentions.Count > 0 || SavedSearches.Count > 0))
            {
                <div class="sentinel-quick-navigation border-bottom">
                    @if (SavedSearches.Count > 0)
                    {
                        <div class="sentinel-nav-section">
                            <div class="sentinel-nav-heading"><i class="bi bi-bookmark-fill"></i> Saved searches</div>
                            @foreach (var saved in SavedSearches)
                            {
                                <div class="sentinel-nav-item d-flex align-items-center">
                                    <button type="button" class="btn btn-sm p-0 border-0 bg-transparent text-start flex-grow-1 d-flex align-items-center gap-2"
                                            @onclick="() => RunSavedSearchAsync(saved.Query)" disabled="@IsBusy">
                                        <i class="bi bi-search text-secondary"></i>
                                        <span class="text-truncate">@saved.Query</span>
                                    </button>
                                    <button type="button" class="btn btn-sm p-0 border-0 bg-transparent text-secondary" @onclick="() => DeleteSavedSearchAsync(saved.Id)"
                                            disabled="@IsBusy" aria-label="Delete saved search" title="Delete saved search">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    @if (Navigation.Favorites.Count > 0)
                    {
                        <div class="sentinel-nav-section">
                            <div class="sentinel-nav-heading"><i class="bi bi-star-fill text-warning"></i> Favorites</div>
                            @foreach (var item in Navigation.Favorites)
                            {
                                <button type="button" class="sentinel-nav-item" @onclick="() => OpenNavigationItemAsync(item)" disabled="@IsBusy">
                                    <span>@(string.IsNullOrWhiteSpace(item.Icon) ? (item.IsDatabase ? "🗄️" : "📄") : item.Icon)</span>
                                    <span class="text-truncate">@item.Title</span>
                                </button>
                            }
                        </div>
                    }
                    @if (Navigation.Recents.Count > 0)
                    {
                        <div class="sentinel-nav-section">
                            <div class="sentinel-nav-heading"><i class="bi bi-clock-history"></i> Recent</div>
                            @foreach (var item in Navigation.Recents.Take(5))
                            {
                                <button type="button" class="sentinel-nav-item" @onclick="() => OpenNavigationItemAsync(item)" disabled="@IsBusy">
                                    <span>@(string.IsNullOrWhiteSpace(item.Icon) ? (item.IsDatabase ? "🗄️" : "📄") : item.Icon)</span>
                                    <span class="text-truncate">@item.Title</span>
                                </button>
                            }
                        </div>
                    }
                    @if (Mentions.Count > 0)
                    {
                        <div class="sentinel-nav-section">
                            <div class="sentinel-nav-heading"><i class="bi bi-at"></i> Mentions</div>
                            @foreach (var mention in Mentions.Take(5))
                            {
                                <button type="button" class="sentinel-nav-item" @onclick="() => OpenPageAsync(mention.SourcePageId)" disabled="@IsBusy" title="@mention.Preview">
                                    <i class="bi bi-file-earmark-text text-secondary"></i>
                                    <span class="text-truncate">@mention.SourcePageTitle</span>
                                </button>
                            }
                        </div>
                    }
                </div>
            }
            <div class="sentinel-tree-scroll">
                @if (AllTreeNodes().Count == 0)
                {
                    <div class="p-4 text-secondary">
                        <p class="mb-0">Nothing here yet. Create a page or database to get started.</p>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(SearchQuery))
                {
                    @if (WorkspaceSearchResults.Count == 0 && !IsSearchBusy)
                    {
                        <div class="p-4 text-secondary">
                            <p class="mb-0">Nothing in Sentinel matches "@SearchQuery".</p>
                        </div>
                    }
                    else
                    {
                        <div class="sentinel-search-filters">
                            <select class="form-select form-select-sm" @bind="_searchAuthorFilter" aria-label="Filter search results by author">
                                <option value="">Any author</option>
                                @foreach (var author in WorkspaceSearchResults.Select(result => result.CreatedBy).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(author => author, StringComparer.OrdinalIgnoreCase))
                                {
                                    <option value="@author">@author</option>
                                }
                            </select>
                            <select class="form-select form-select-sm" @bind="_searchDateFilter" aria-label="Filter search results by date">
                                <option value="">Any time</option>
                                <option value="week">Past week</option>
                                <option value="month">Past month</option>
                                <option value="year">Past year</option>
                            </select>
                        </div>
                        var filteredWorkspaceResults = ApplySearchFilters(WorkspaceSearchResults, _searchAuthorFilter, _searchDateFilter);
                        @if (filteredWorkspaceResults.Count == 0)
                        {
                            <div class="p-4 text-secondary">
                                <p class="mb-0">No results match the current filters.</p>
                            </div>
                        }
                        else
                        {
                            <div class="list-group list-group-flush sentinel-search-results">
                                @foreach (var result in filteredWorkspaceResults)
                                {
                                    <button type="button" class="list-group-item list-group-item-action text-start"
                                            @onclick="() => OpenSearchResultAsync(result)" disabled="@IsBusy">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi @(result.IsDatabase ? "bi-grid-3x3-gap-fill" : "bi-file-earmark-text") text-secondary"></i>
                                            <span class="fw-semibold text-truncate">@HighlightMatches(result.Title, result.MatchedTerms)</span>
                                            <span class="badge text-bg-light border ms-auto">@result.MatchKind</span>
                                        </div>
                                        <div class="small text-secondary text-truncate mt-1">@HighlightMatches(result.Preview, result.MatchedTerms)</div>
                                    </button>
                                }
                            </div>
                        }
                    }
                }
                else
                {
                    var branchNodeIds = BranchNodeIds();
                    var allBranchesExpanded = AreAllBranchesExpanded(branchNodeIds);
                    <div class="wiki-tree">
                        @if (branchNodeIds.Count > 0)
                        {
                            <div class="sentinel-tree-heading">
                                <span>Private</span>
                                <button type="button"
                                        class="sentinel-tree-expand-all"
                                        @onclick="ToggleAllBranches"
                                        aria-label="@(allBranchesExpanded ? "Collapse all page branches" : "Expand all page branches")"
                                        title="@(allBranchesExpanded ? "Collapse all" : "Expand all")">
                                    <i class="bi @(allBranchesExpanded ? "bi-arrows-collapse" : "bi-arrows-expand")"></i>
                                    <span>@(allBranchesExpanded ? "Collapse all" : "Expand all")</span>
                                </button>
                            </div>
                        }
                        @if (_selectedTreeNodeIds.Count > 0)
                        {
                            <div class="wiki-tree-bulk-bar">
                                <span>@_selectedTreeNodeIds.Count selected</span>
                                <button type="button" class="btn btn-sm btn-link p-0" @onclick="() => _selectedTreeNodeIds.Clear()">Clear</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OpenBulkMoveModal" disabled="@IsBusy">Move to…</button>
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => _showBulkDeleteConfirm = true" disabled="@IsBusy">Move to Trash</button>
                            </div>
                        }
                        @foreach (var node in FilteredAndOrderedNodes())
                        {
                            var nodeDepth = GetNodeDepth(node);
                            var hasChildren = HasChildren(node.Id);
                            <div class="wiki-tree-row @(nodeDepth == 0 ? "is-top-level" : string.Empty) @(hasChildren ? "has-children" : string.Empty) @((node.IsDatabase ? SelectedDatabaseId == node.Id : SelectedPageId == node.Id) ? "active" : "") @(node.IsArchived ? "wiki-tree-archived" : "") @(_dragOverNodeId == node.Id ? "wiki-tree-drag-over" : "") @(_selectedTreeNodeIds.Contains(node.Id) ? "wiki-tree-multi-selected" : "")"
                                 style="padding-left:@(0.4 + nodeDepth * 1.15)rem;"
                                 draggable="true"
                                 @ondragstart="() => StartDragNode(node)"
                                 @ondragend="EndDragNode"
                                 @ondragenter="() => _dragOverNodeId = node.Id"
                                 @ondragleave="() => _dragOverNodeId = null"
                                 @ondragover:preventDefault
                                 @ondrop="() => DropOnNodeAsync(node)">
                                <input type="checkbox" class="form-check-input wiki-tree-select" checked="@_selectedTreeNodeIds.Contains(node.Id)"
                                       @onchange="e => ToggleTreeNodeSelect(node.Id, (bool)e.Value!)" @onclick:stopPropagation="true"
                                       aria-label="Select @node.Title" />
                                @if (hasChildren && string.IsNullOrWhiteSpace(SearchQuery))
                                {
                                    <button type="button" class="wiki-tree-toggle" @onclick="() => ToggleExpanded(node.Id)"
                                            aria-label="@(IsExpanded(node.Id) ? $"Collapse {node.Title}" : $"Expand {node.Title}")"
                                            aria-expanded="@IsExpanded(node.Id)">
                                        <i class="bi @(IsExpanded(node.Id) ? "bi-caret-down-fill" : "bi-caret-right-fill")"></i>
                                    </button>
                                }
                                else
                                {
                                    <span class="wiki-tree-spacer"></span>
                                }
                                <button type="button" class="wiki-tree-label" @onclick="() => OpenNodeAsync(node)" disabled="@IsBusy">
                                    <span class="wiki-tree-icon">@(string.IsNullOrWhiteSpace(node.Icon) ? (node.IsDatabase ? "🗄️" : "📄") : node.Icon)</span>
                                    <span class="wiki-tree-title">@node.Title</span>
                                    @if (node.IsNotionSynced)
                                    {
                                        <span class="badge rounded-pill text-bg-light border wiki-notion-badge" title="Imported from Notion">N</span>
                                    }
                                </button>
                                <div class="wiki-tree-actions">
                                    <button type="button" class="btn btn-xs btn-link p-0 @(IsFavorite(node.Id, node.IsDatabase) ? "text-warning" : "text-secondary")"
                                            title="@(IsFavorite(node.Id, node.IsDatabase) ? "Remove from favorites" : "Add to favorites")"
                                            @onclick="() => ToggleFavoriteAsync(node.Id, node.IsDatabase)" disabled="@IsBusy">
                                        <i class="bi @(IsFavorite(node.Id, node.IsDatabase) ? "bi-star-fill" : "bi-star")"></i>
                                    </button>
                                    <button type="button" class="btn btn-xs btn-link p-0" title="Move up" @onclick="() => MoveNodeAsync(node, -1)" disabled="@IsBusy">
                                        <i class="bi bi-chevron-up"></i>
                                    </button>
                                    <button type="button" class="btn btn-xs btn-link p-0" title="Move down" @onclick="() => MoveNodeAsync(node, 1)" disabled="@IsBusy">
                                        <i class="bi bi-chevron-down"></i>
                                    </button>
                                    <div class="wiki-tree-row-menu">
                                        <button type="button" class="btn btn-xs btn-link p-0" title="More actions" @onclick="() => ToggleRowMenu(node.Id)" @onclick:stopPropagation="true" disabled="@IsBusy">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        @if (_openRowMenuNodeId == node.Id)
                                        {
                                            <div class="dropdown-menu show wiki-tree-row-dropdown">
                                                <button type="button" class="dropdown-item" @onclick="() => DuplicateNodeAsync(node)">
                                                    <i class="bi bi-copy me-2"></i>Duplicate
                                                </button>
                                                <button type="button" class="dropdown-item text-danger" @onclick="() => DeleteNodeAsync(node)">
                                                    <i class="bi bi-trash me-2"></i>Move to Trash
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <ConfirmModal Show="_showSingleDeleteConfirm"
                      Title="Move to Trash"
                      Message="@(_pendingSingleDelete is { IsDatabase: true } ? "Move this database and all its rows to Trash?" : "Move this page (and its sub-pages) to Trash?")"
                      ConfirmText="Move to Trash" ConfirmButtonClass="btn-danger" Busy="IsBusy"
                      OnConfirm="ConfirmSingleDeleteAsync" OnCancel="CancelSingleDelete" />

        <ConfirmModal Show="_showBulkDeleteConfirm"
                      Title="Move to Trash"
                      Message="@($"Move {_selectedTreeNodeIds.Count} selected item(s) (and any sub-pages) to Trash?")"
                      ConfirmText="Move to Trash" ConfirmButtonClass="btn-danger" Busy="_bulkActionBusy"
                      OnConfirm="ConfirmBulkDeleteAsync" OnCancel="CancelBulkDelete" />

        <ConfirmModal Show="_showBulkMoveModal"
                      Title="Move selected items"
                      ConfirmText="Move here" ConfirmButtonClass="btn-primary" Busy="_bulkActionBusy"
                      OnConfirm="ConfirmBulkMoveAsync" OnCancel="CloseBulkMoveModal">
            <ChildContent>
                <p class="small text-secondary">Choose a destination for the @_selectedTreeNodeIds.Count selected item(s). Moving a page under its own selected sub-page isn't allowed and will be skipped.</p>
                <div class="wiki-move-target-list">
                    <button type="button" class="wiki-move-target-option @(_bulkMoveTargetParentId is null ? "is-selected" : "")" @onclick="() => _bulkMoveTargetParentId = null">
                        <i class="bi bi-house me-2"></i>Top level
                    </button>
                    @foreach (var candidate in AllTreeNodes().Where(n => !_selectedTreeNodeIds.Contains(n.Id)).OrderBy(n => n.Title))
                    {
                        <button type="button" class="wiki-move-target-option @(_bulkMoveTargetParentId == candidate.Id ? "is-selected" : "")" @onclick="() => _bulkMoveTargetParentId = candidate.Id">
                            <span class="wiki-tree-icon">@(string.IsNullOrWhiteSpace(candidate.Icon) ? (candidate.IsDatabase ? "🗄️" : "📄") : candidate.Icon)</span>
                            @candidate.Title
                        </button>
                    }
                </div>
            </ChildContent>
        </ConfirmModal>

        <div class="sentinel-teamspaces">
            <div class="sentinel-nav-heading"><i class="bi bi-people"></i> Teamspaces</div>
            <button type="button" class="sentinel-nav-item" @onclick="OpenNotionModalAsync" disabled="@IsBusy">
                <span class="sentinel-teamspace-icon">N</span>
                <span class="text-truncate">@(string.IsNullOrWhiteSpace(NotionSettings.WorkspaceName) ? "Connect Notion workspace" : NotionSettings.WorkspaceName)</span>
                <i class="bi bi-chevron-right ms-auto" aria-hidden="true"></i>
            </button>
        </div>
        <SentinelTemplates CurrentPageId="SelectedPageId"
                           CurrentPageTitle="@Editor.Title"
                           CurrentDatabaseId="SelectedDatabaseId"
                           CurrentDatabaseTitle="SelectedDatabaseTitle"
                           IsPageEditorActive="@(SelectedDatabaseId is null)"
                           CaptureBlocks="CaptureEditorBlocksAsync"
                           OnPageCreated="OpenTemplatePageAsync"
                           OnDatabaseCreated="OpenTemplateDatabaseAsync"
                           OnBlocksInserted="InsertBlockTemplateAsync"
                           OnWorkspaceImported="HandleWorkspaceImportedAsync" />
    </aside>

    <main class="sentinel-main">
        @if (SelectedDatabaseId is { } openDatabaseId)
        {
            <WikiDatabaseEditor WikiDatabaseId="openDatabaseId"
                                InitialOpenRowId="_pendingOpenRowId"
                                CanEdit="_canEditOpenDatabase"
                                OnChanged="() => LoadTreeAsync(selectFirstPage: false)"
                                OnDuplicated="OpenDuplicatedDatabaseAsync"
                                OnOpenPage="OpenPageAsync" />
        }
        else
        {
        <div class="sentinel-document">
            <div class="sentinel-document-toolbar">
                <nav class="sentinel-document-context" aria-label="Page breadcrumb">
                    @if (CurrentParentNode() is { } parentBreadcrumb)
                    {
                        <button type="button"
                                class="sentinel-breadcrumb-up"
                                aria-label="@($"Back to {parentBreadcrumb.Title}")"
                                title="@($"Back to {parentBreadcrumb.Title}")"
                                @onclick="() => OpenNodeAsync(parentBreadcrumb)"
                                disabled="@IsBusy">
                            <i class="bi bi-arrow-left" aria-hidden="true"></i>
                            <span class="text-truncate">@parentBreadcrumb.Title</span>
                        </button>
                        <span class="sentinel-breadcrumb-divider" aria-hidden="true"></span>
                    }
                    <span class="sentinel-document-breadcrumb-root">Sentinel</span>
                    @foreach (var breadcrumb in CurrentBreadcrumbNodes())
                    {
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        @if (breadcrumb.Id == SelectedPageId || breadcrumb.Id == SelectedDatabaseId)
                        {
                            <span class="sentinel-breadcrumb-current text-truncate">@breadcrumb.Title</span>
                        }
                        else
                        {
                            <button type="button" @onclick="() => OpenNodeAsync(breadcrumb)" disabled="@IsBusy">
                                <span aria-hidden="true">@(string.IsNullOrWhiteSpace(breadcrumb.Icon) ? (breadcrumb.IsDatabase ? "🗄️" : "📄") : breadcrumb.Icon)</span>
                                <span class="text-truncate">@breadcrumb.Title</span>
                            </button>
                        }
                    }
                    @if (!SelectedPageId.HasValue && !SelectedDatabaseId.HasValue)
                    {
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        <span class="sentinel-breadcrumb-current text-truncate">Untitled</span>
                    }
                </nav>
                <div class="d-flex align-items-center gap-2">
                    @if (SelectedPageId is { } selectedPageId)
                    {
                        <SentinelPresence WikiPageId="selectedPageId" />
                        <SentinelSharePanel TargetId="selectedPageId" TargetName="@(Editor.Title ?? "page")" />
                        <button type="button" class="btn btn-sm @(IsFavorite(selectedPageId, false) ? "btn-warning" : "btn-outline-secondary")"
                                @onclick="() => ToggleFavoriteAsync(selectedPageId, false)" title="Toggle favorite">
                            <i class="bi @(IsFavorite(selectedPageId, false) ? "bi-star-fill" : "bi-star")"></i>
                        </button>
                        <a class="btn btn-sm btn-outline-secondary" href="@($"admin/sentinel/pages/{selectedPageId}/export.md")"
                           title="Export this page as Markdown" download>
                            <i class="bi bi-download"></i>
                        </a>
                    }
                    <span class="sentinel-editing-state">
                        @(!string.IsNullOrEmpty(_autosaveStatus) ? _autosaveStatus : SelectedPageId.HasValue ? "Saved" : "New page")
                    </span>
                </div>
            </div>
            <EditForm Model="Editor" OnValidSubmit="SavePageAsync" class="sentinel-inline-document-form">
                @if (!string.IsNullOrWhiteSpace(Editor.CoverImageUrl))
                {
                    <div class="sentinel-page-cover">
                        <img src="@Editor.CoverImageUrl" alt="Page cover" loading="lazy" />
                        <div class="sentinel-page-cover-actions">
                            <button type="button" class="btn btn-sm btn-dark" @onclick="ToggleCoverPickerAsync">
                                <i class="bi bi-image me-1"></i>Change cover
                            </button>
                            <button type="button" class="btn btn-sm btn-dark" @onclick="RemoveCoverImage">
                                <i class="bi bi-trash3 me-1"></i>Remove
                            </button>
                        </div>
                    </div>
                }

                <div class="sentinel-document-canvas @(!string.IsNullOrWhiteSpace(Editor.CoverImageUrl) ? "has-cover" : string.Empty)">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    @if (string.IsNullOrWhiteSpace(Editor.CoverImageUrl))
                    {
                        <div class="sentinel-page-affordances">
                            <button type="button" @onclick="ToggleCoverPickerAsync">
                                <i class="bi bi-image"></i>Add cover
                            </button>
                        </div>
                    }

                    <div class="sentinel-page-heading">
                        <button type="button" class="sentinel-icon-input" @onclick="ToggleIconPicker"
                                aria-label="Change page icon" title="Change page icon">
                            @(string.IsNullOrWhiteSpace(Editor.Icon) ? "📄" : Editor.Icon)
                        </button>
                        <InputTextArea class="sentinel-title-input" @bind-Value="Editor.Title" @bind-Value:after="ScheduleAutosave"
                                       rows="1" placeholder="Untitled" aria-label="Page title" />
                    </div>

                    @if (_showIconPicker)
                    {
                        <div class="wiki-icon-picker border rounded-3 p-2 mb-3">
                            <div class="wiki-icon-picker-grid">
                                @foreach (var emoji in CommonPageIcons)
                                {
                                    <button type="button" class="wiki-icon-picker-option" @onclick="() => SelectIcon(emoji)">@emoji</button>
                                }
                            </div>
                            <div class="d-flex align-items-center gap-2 mt-2">
                                <input class="form-control form-control-sm" style="max-width:8rem;" maxlength="4"
                                       placeholder="Paste any emoji" value="@_customIconInput"
                                       @oninput="e => _customIconInput = e.Value?.ToString() ?? string.Empty" />
                                <button type="button" class="btn btn-sm btn-outline-primary" disabled="@string.IsNullOrWhiteSpace(_customIconInput)"
                                        @onclick="() => SelectIcon(_customIconInput)">Use</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => SelectIcon(string.Empty)">Remove icon</button>
                            </div>
                        </div>
                    }

                    <details class="sentinel-page-properties">
                        <summary><i class="bi bi-sliders2"></i><span>Page properties</span><i class="bi bi-chevron-right"></i></summary>
                        <div class="sentinel-properties">
                            <div class="sentinel-property-row">
                                <label for="sentinelSlug"><i class="bi bi-link-45deg"></i>Slug</label>
                                <InputText id="sentinelSlug" class="sentinel-property-control" @bind-Value="Editor.Slug" placeholder="Generated from title" />
                            </div>
                            @if (SelectedPageId.HasValue)
                            {
                                <div class="sentinel-property-row">
                                    <label for="sentinelParent"><i class="bi bi-diagram-2"></i>Parent</label>
                                    <select id="sentinelParent" class="sentinel-property-control" @bind="ParentWikiPageIdSelection" @bind:after="MoveToSelectedParentAsync">
                                        <option value="">— Top level —</option>
                                        @foreach (var candidate in WikiParentPageOptions())
                                        {
                                            <option value="@candidate.Id">@candidate.Title</option>
                                        }
                                    </select>
                                </div>
                            }
                        </div>
                    </details>

                    @if (_showCoverPicker)
                    {
                        <div class="wiki-media-picker border rounded-3 p-2 mb-3">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <InputFile OnChange="OnCoverFileSelectedAsync" disabled="@_isUploadingCover" class="form-control form-control-sm" accept="image/*" />
                                @if (_isUploadingCover)
                                {
                                    <span class="spinner-border spinner-border-sm text-secondary flex-shrink-0"></span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(_mediaPickerError))
                            {
                                <div class="text-danger small mb-0">@_mediaPickerError</div>
                            }
                            else if (_mediaAssets.Count == 0)
                            {
                                <p class="text-secondary small mb-0">No media uploaded yet. Upload an image above.</p>
                            }
                            else
                            {
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var asset in _mediaAssets)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary p-1" title="@asset.FileName"
                                                @onclick="() => SelectCoverAsync(asset)">
                                            <img src="@asset.ThumbnailUrl" alt="@asset.AltText" loading="lazy" style="width:64px;height:64px;object-fit:cover;" />
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <div class="sentinel-editor-hint">
                        <i class="bi bi-command"></i>
                        <span><code>/</code> commands · <code>[[</code> page links · <code>@@</code> mentions · Tab to indent</span>
                    </div>
                    <SentinelAiPanel WikiPageId="SelectedPageId" OnInsert="InsertAiOutputAsync" />
                    <div class="wiki-block-editor" @ref="_blockEditorContainer"></div>

                    <div class="sentinel-editor-actions">
                        <button type="submit" class="btn btn-primary" disabled="@IsBusy">
                            <i class="bi bi-check2 me-1"></i>Save changes
                        </button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="CreateNewPage" disabled="@IsBusy">
                            Reset
                        </button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="DuplicateSelectedPageAsync"
                                disabled="@(IsBusy || !SelectedPageId.HasValue)">
                            <i class="bi bi-copy me-1"></i>Duplicate
                        </button>
                        <button type="button" class="btn btn-outline-danger" @onclick="DeleteSelectedPageAsync"
                                disabled="@(IsBusy || !SelectedPageId.HasValue)" title="Move to Trash">
                            <i class="bi bi-trash3 me-1"></i>Trash
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
        }
        </main>

        @if (SelectedPageId.HasValue)
        {
            <aside class="sentinel-context-sidebar @(!_contextSidebarOpen ? "is-collapsed" : string.Empty)" aria-label="Page context">
            @if (_contextSidebarOpen)
            {
            <div class="sentinel-context-heading">
                <div>
                    <strong>Page context</strong>
                    <span>Discussions, links, and history</span>
                </div>
                <button type="button" @onclick="ToggleContextSidebar" title="Close page context" aria-label="Close page context">
                    <i class="bi bi-layout-sidebar-reverse"></i>
                </button>
            </div>
            <SentinelDiscussions @ref="_sentinelDiscussions"
                                 WikiPageId="SelectedPageId.Value"
                                 BlocksJson="Editor.BlocksJson"
                                 OnOpenPage="OpenPageAsync"
                                 OnDiscussionCountsChanged="UpdateDiscussionCountsAsync"
                                 OnDiscussionHighlightsChanged="UpdateDiscussionHighlightsAsync" />

            <div class="card border-0 shadow-sm mt-4 sentinel-support-panel">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center gap-3">
                    <div>
                        <div class="fw-semibold"><i class="bi bi-arrow-left-right me-1"></i>Backlinks</div>
                        <div class="small text-secondary">Pages in Sentinel that link to this page.</div>
                    </div>
                    <span class="badge text-bg-secondary">@Backlinks.Count</span>
                </div>
                <div class="card-body p-0">
                    @if (Backlinks.Count == 0)
                    {
                        <div class="p-4 text-secondary small">No pages link here yet.</div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var backlink in Backlinks)
                            {
                                <button type="button" class="list-group-item list-group-item-action text-start"
                                        @onclick="() => OpenPageAsync(backlink.SourcePageId)" disabled="@IsBusy">
                                    <div class="fw-semibold small">@backlink.SourcePageTitle</div>
                                    <div class="small text-secondary text-truncate mt-1">@backlink.Preview</div>
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="card border-0 shadow-sm mt-4 sentinel-support-panel">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center gap-3">
                    <div>
                        <div class="fw-semibold">History</div>
                        <div class="small text-secondary">Every version from the last 90 days is kept; older versions are thinned to one per day.</div>
                    </div>
                    <span class="badge text-bg-secondary">@History.Count version@(History.Count == 1 ? "" : "s")</span>
                </div>
                <div class="card-body p-0">
                    @if (!string.IsNullOrEmpty(HistoryErrorMessage))
                    {
                        <div class="alert alert-danger m-3 mb-0 py-2 small">@HistoryErrorMessage</div>
                    }
                    @if (History.Count == 0)
                    {
                        <div class="p-4">
                            <p class="text-secondary mb-0">No versions yet - saving this page will create the first one.</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush" style="max-height: 26rem; overflow-y: auto;">
                            @for (var i = 0; i < History.Count; i++)
                            {
                                var revision = History[i];
                                var previousRevision = i + 1 < History.Count ? History[i + 1] : null;
                                <div class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                        <div>
                                            <div class="fw-semibold small">
                                                <code class="me-1">v@(revision.RevisionNumber)</code>@(string.IsNullOrWhiteSpace(revision.Label) ? "Saved" : revision.Label)
                                            </div>
                                            <div class="small text-secondary mt-1">
                                                @revision.AuthorName &middot; @revision.When.ToLocalTime().ToString("g")
                                            </div>
                                        </div>
                                        <div class="d-flex gap-1 flex-shrink-0">
                                            @if (previousRevision is not null)
                                            {
                                                <button class="btn btn-xs btn-outline-secondary" @onclick="() => ToggleDiffAsync(revision, previousRevision)">
                                                    Diff
                                                </button>
                                            }
                                            <button class="btn btn-xs btn-outline-primary" @onclick="() => RevertToRevisionAsync(revision.Id)"
                                                    disabled="@IsHistoryBusy">
                                                Revert
                                            </button>
                                        </div>
                                    </div>
                                    @if (DiffRevisionKey == revision.Id)
                                    {
                                        <div class="mt-3 border-top pt-3">
                                            @if (string.IsNullOrEmpty(DiffText))
                                            {
                                                <div class="small text-secondary">No block changes between these versions.</div>
                                            }
                                            else
                                            {
                                                <div class="p-2 rounded-3 border bg-body-tertiary">
                                                    @foreach (var line in DiffText.Split('\n'))
                                                    {
                                                        <div class="@DiffLineClass(line)" style="white-space:pre-wrap;font-family:var(--bs-font-monospace, monospace);font-size:0.8125rem;">@line</div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
            }
            else
            {
                <button type="button" class="sentinel-context-rail-button" @onclick="ToggleContextSidebar"
                        title="Open page context" aria-label="Open page context">
                    <i class="bi bi-chat-left-text"></i>
                    <span>@Backlinks.Count</span>
                </button>
            }
            </aside>
        }
</div>
</div>

@if (ShowNotionModal)
{
    <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title">Notion Import &amp; Sync</h5>
                        @if (!string.IsNullOrWhiteSpace(NotionSettings.WorkspaceName))
                        {
                            <div class="small text-secondary mt-1">Connected to @NotionSettings.WorkspaceName</div>
                        }
                    </div>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseNotionModal"></button>
                </div>
                <div class="modal-body">
                    @if (HasNotionConnection)
                    {
                        <div class="notion-sync-summary d-flex flex-wrap align-items-center gap-3 p-3 rounded-3 border bg-body-tertiary">
                            <span class="notion-connection-choice-icon flex-shrink-0" aria-hidden="true">
                                <i class="bi bi-check2-circle"></i>
                            </span>
                            <div class="me-auto">
                                <div class="fw-semibold">
                                    @(string.IsNullOrWhiteSpace(NotionSettings.WorkspaceName)
                                        ? "Notion connected"
                                        : NotionSettings.WorkspaceName)
                                </div>
                                <div class="small text-secondary">
                                    @if (NotionSettings.LastSyncedAt is { } summaryLastSyncedAt)
                                    {
                                        <span>Last synced @summaryLastSyncedAt.ToLocalTime().ToString("g")</span>
                                    }
                                    else
                                    {
                                        <span>Ready to sync</span>
                                    }
                                </div>
                            </div>
                            <button type="button" class="btn btn-primary" @onclick="SyncNotionNowAsync"
                                    disabled="@(IsNotionOperationBusy || HasInvalidNotionScope)">
                                @if (IsNotionBusy)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                                }
                                else
                                {
                                    <i class="bi bi-arrow-repeat me-1"></i>
                                }
                                @(NotionMessageIsError ? "Retry resync" : "Resync now")
                            </button>
                        </div>
                    }
                    else
                    {
                        <p class="text-secondary mb-3">
                            Paste a Notion access token to connect. Sentinel never needs your Notion username or password.
                        </p>
                    }

                    @if (HasNotionConnection)
                    {
                        <button type="button" class="btn btn-sm btn-link text-secondary px-0 mt-2"
                                aria-expanded="@ShowNotionConnectionSettings"
                                @onclick="() => ShowNotionConnectionSettings = !ShowNotionConnectionSettings">
                            <i class="bi @(ShowNotionConnectionSettings ? "bi-chevron-down" : "bi-chevron-right") me-1"></i>
                            Change connection
                        </button>
                    }

                    @if (ShowNotionConnectionSettings || !HasNotionConnection)
                    {
                    <section class="notion-connection-choice is-primary" aria-labelledby="notion-token-heading">
                        <div class="d-flex align-items-start gap-3">
                            <span class="notion-connection-choice-icon" aria-hidden="true">
                                <i class="bi bi-key-fill"></i>
                            </span>
                            <div class="flex-grow-1 min-w-0">
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                    <div>
                                        <h3 id="notion-token-heading" class="h6 mb-1">Use an access token</h3>
                                        <p class="small text-secondary mb-0">Fastest setup for a personal workspace.</p>
                                    </div>
                                    @if (NotionSettings.HasStoredIntegrationToken && !NotionSettings.IsOAuthConnected)
                                    {
                                        <span class="badge text-bg-success">
                                            <i class="bi bi-check2-circle me-1"></i>Token connected
                                        </span>
                                    }
                                </div>

                                <label class="form-label fw-semibold small mt-3" for="notionAccessToken">
                                    Notion personal access or internal integration token
                                </label>
                                <div class="input-group">
                                    <input id="notionAccessToken" class="form-control"
                                           type="@(ShowNotionToken ? "text" : "password")"
                                           @bind="NotionSettings.IntegrationToken" @bind:event="oninput"
                                           autocomplete="new-password"
                                           placeholder="@(NotionSettings.HasStoredIntegrationToken
                                               ? "Token saved securely — enter a value only to replace it"
                                               : "Paste your ntn_… or secret_… token")" />
                                    <button type="button" class="btn btn-outline-secondary"
                                            aria-label="@(ShowNotionToken ? "Hide Notion token" : "Show Notion token")"
                                            title="@(ShowNotionToken ? "Hide token" : "Show token")"
                                            @onclick="() => ShowNotionToken = !ShowNotionToken">
                                        <i class="bi @(ShowNotionToken ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                                    </button>
                                    <button type="button" class="btn btn-primary"
                                            @onclick="SyncNotionNowAsync"
                                            disabled="@(IsNotionOperationBusy
                                                || HasInvalidNotionScope
                                                || (!NotionSettings.HasStoredIntegrationToken
                                                    && string.IsNullOrWhiteSpace(NotionSettings.IntegrationToken)))">
                                        @if (IsNotionBusy)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-plug-fill me-1"></i>
                                        }
                                        Connect &amp; sync
                                    </button>
                                </div>

                                @if (NotionSettings.IntegrationTokenUnreadable)
                                {
                                    <div class="alert alert-warning py-2 mt-2 mb-0">
                                        The stored token can no longer be decrypted. Paste it again to reconnect.
                                    </div>
                                }
                                else if (NotionSettings.HasStoredIntegrationToken)
                                {
                                    <div class="form-text">
                                        The token is encrypted on the server and is never returned to this browser.
                                    </div>
                                }

                                @if (!NotionSettings.HasStoredIntegrationToken)
                                {
                                    <div class="small text-secondary mt-2">
                                        Paste the token, then select <strong>Connect &amp; sync</strong>.
                                        Internal integrations must also be added to the pages you want to import.
                                    </div>
                                }
                            </div>
                        </div>
                    </section>

                    <div class="notion-connection-divider"><span>or</span></div>

                    <section class="notion-connection-choice" aria-labelledby="notion-oauth-heading">
                        <h3 id="notion-oauth-heading" class="h6 mb-2">Sign in with Notion OAuth</h3>
                        @if (NotionSettings.IsOAuthConnected)
                        {
                            <div class="d-flex flex-wrap align-items-center gap-3">
                                @if (!string.IsNullOrWhiteSpace(NotionSettings.WorkspaceIconUrl))
                                {
                                    <img src="@NotionSettings.WorkspaceIconUrl" alt="" width="40" height="40"
                                         class="rounded object-fit-cover" referrerpolicy="no-referrer" />
                                }
                                else
                                {
                                    <span class="d-inline-flex align-items-center justify-content-center rounded bg-body-tertiary"
                                          style="width: 40px; height: 40px;" aria-hidden="true">
                                        <i class="bi bi-check2-circle text-success"></i>
                                    </span>
                                }
                                <div class="me-auto">
                                    <div class="fw-semibold">Connected with Notion</div>
                                    <div class="small text-secondary">
                                        @(string.IsNullOrWhiteSpace(NotionSettings.WorkspaceName)
                                            ? "Authorized workspace"
                                            : NotionSettings.WorkspaceName)
                                    </div>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        @onclick="RefreshNotionOAuthAsync" disabled="@IsNotionOperationBusy">
                                    Refresh authorization
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        @onclick="DisconnectNotionOAuthAsync" disabled="@IsNotionOperationBusy">
                                    Disconnect
                                </button>
                            </div>
                        }
                        else if (NotionOAuthService.IsConfigured)
                        {
                            <div class="d-flex flex-wrap align-items-center gap-3">
                                <div class="me-auto">
                                    <div class="fw-semibold">Connect your Notion workspace</div>
                                    <div class="small text-secondary">
                                        Sign in at Notion and choose the pages Sentinel may access.
                                    </div>
                                </div>
                                <a class="btn btn-primary" href="/auth/notion/connect" data-enhance-nav="false">
                                    <i class="bi bi-box-arrow-up-right me-1"></i>Connect Notion
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="small text-secondary">
                                OAuth is optional and is not configured on this server. The access-token method above works without it.
                            </div>
                        }
                    </section>

                    <div class="small text-secondary mt-2">
                        Internal integrations must be added through <strong>••• → Add connections</strong> in Notion.
                        Personal access tokens do not need that step.
                    </div>
                    }

                    <div class="d-flex align-items-center justify-content-between gap-2 border-top mt-3 pt-3">
                        <div>
                            <div class="fw-semibold">Sync settings</div>
                            <div class="small text-secondary">@NotionSyncSettingsSummary</div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                aria-expanded="@ShowNotionSyncSettings"
                                @onclick="() => ShowNotionSyncSettings = !ShowNotionSyncSettings">
                            @(ShowNotionSyncSettings ? "Hide" : "Edit")
                        </button>
                    </div>
                    @if (ShowNotionSyncSettings)
                    {
                    <div class="form-check form-switch mt-3">
                        <input class="form-check-input" type="checkbox" role="switch" id="notionAutoSync"
                               @bind="NotionSettings.AutoSyncEnabled" />
                        <label class="form-check-label" for="notionAutoSync">Sync automatically every hour</label>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-md-5">
                            <label class="form-label fw-semibold small" for="notionDirection">Sync direction</label>
                            <select id="notionDirection" class="form-select" @bind="NotionSettings.SyncDirection">
                                <option value="import">Import only</option>
                                <option value="twoWay">Two-way (manual push)</option>
                            </select>
                        </div>
                        <div class="col-md-7">
                            <div class="d-flex align-items-center justify-content-between gap-2">
                                <label class="form-label fw-semibold small mb-0">Content scope</label>
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        @onclick="BrowseNotionContentAsync" disabled="@IsNotionOperationBusy">
                                    @if (IsNotionBrowseBusy)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-folder2-open me-1"></i>
                                    }
                                    Browse shared content
                                </button>
                            </div>
                            <div class="form-check mt-2">
                                <input class="form-check-input" type="radio" name="notionScope" id="notionScopeAll"
                                       checked="@SyncAllNotionContent" @onchange="() => SetNotionScope(true)" />
                                <label class="form-check-label" for="notionScopeAll">Everything shared with the integration</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="notionScope" id="notionScopeSelected"
                                       checked="@(!SyncAllNotionContent)" @onchange="() => SetNotionScope(false)" />
                                <label class="form-check-label" for="notionScopeSelected">Only selected pages and databases</label>
                            </div>
                        </div>
                    </div>
                    @if (!SyncAllNotionContent)
                    {
                        <div class="border rounded-3 mt-3 overflow-hidden">
                            @if (NotionPickerItems.Count == 0)
                            {
                                <div class="p-3 text-warning-emphasis small">
                                    Browse shared content to choose pages and databases. Selecting a parent includes its discoverable descendants.
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-between gap-2 p-2 border-bottom bg-body-tertiary">
                                    <span class="small fw-semibold">@SelectedNotionPickerIds.Count selected</span>
                                    <button type="button" class="btn btn-sm btn-link py-0" @onclick="ClearNotionPickerSelection"
                                            disabled="@(SelectedNotionPickerIds.Count == 0)">Clear selection</button>
                                </div>
                                <div class="p-2" style="max-height: 18rem; overflow-y: auto;">
                                    @foreach (var row in VisibleNotionPickerRows())
                                    {
                                        <div class="d-flex align-items-center gap-1 py-1"
                                             style="padding-left:@(row.Depth * 1.25)rem;">
                                            @if (row.HasChildren)
                                            {
                                                <button type="button" class="btn btn-sm btn-link text-secondary p-0"
                                                        style="width: 1.25rem;"
                                                        aria-label="@(row.IsExpanded ? $"Collapse {row.Item.Title}" : $"Expand {row.Item.Title}")"
                                                        aria-expanded="@row.IsExpanded"
                                                        @onclick="() => ToggleNotionPickerExpanded(row.Item.Id)">
                                                    <i class="bi @(row.IsExpanded ? "bi-caret-down-fill" : "bi-caret-right-fill")"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <span style="width: 1.25rem;"></span>
                                            }
                                            <input class="form-check-input mt-0" type="checkbox"
                                                   id="@($"notion-picker-{row.Item.Id}")"
                                                   checked="@SelectedNotionPickerIds.Contains(NormalizeNotionPickerId(row.Item.Id))"
                                                   @onchange="args => ToggleNotionPickerSelection(row.Item.Id, args)" />
                                            <label class="form-check-label d-flex align-items-center gap-2 text-truncate"
                                                   for="@($"notion-picker-{row.Item.Id}")">
                                                <i class="bi @(row.Item.ObjectType is "database" or "data_source" ? "bi-table" : "bi-file-earmark-text") text-secondary"></i>
                                                <span class="text-truncate">@row.Item.Title</span>
                                            </label>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    @if (NotionSettings.SyncDirection == "twoWay")
                    {
                        <div class="form-check mt-3 border rounded-3 p-3 ps-5 bg-warning-subtle">
                            <input class="form-check-input" type="checkbox" id="notionAllowWrites" @bind="NotionSettings.AllowTwoWayWrites" />
                            <label class="form-check-label" for="notionAllowWrites">
                                I understand that manual pushes replace the remote page title and block content.
                            </label>
                        </div>
                    }
                    }

                    <div class="d-flex align-items-center justify-content-between gap-2 border-top mt-3 pt-3">
                        <div>
                            <div class="fw-semibold">Webhook settings</div>
                            <div class="small text-secondary">@NotionWebhookSummary</div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                aria-expanded="@ShowNotionWebhookSettings"
                                @onclick="() => ShowNotionWebhookSettings = !ShowNotionWebhookSettings">
                            @(ShowNotionWebhookSettings ? "Hide" : "Manage")
                        </button>
                    </div>
                    @if (ShowNotionWebhookSettings)
                    {
                    <section class="border rounded-3 p-3 mt-2 bg-body-tertiary" aria-labelledby="notion-webhook-heading">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div>
                                <h3 id="notion-webhook-heading" class="h6 mb-1">Instant refresh webhook</h3>
                                <p class="small text-secondary mb-2">
                                    Add this HTTPS endpoint to the connection's Webhooks tab in Notion and subscribe to
                                    page, data source, view, and comment events.
                                </p>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    @onclick="RefreshNotionWebhookStatusAsync"
                                    disabled="@IsNotionOperationBusy">
                                Refresh status
                            </button>
                        </div>
                        <label class="form-label small fw-semibold" for="notionWebhookUrl">Webhook URL</label>
                        <input id="notionWebhookUrl" class="form-control form-control-sm font-monospace"
                               value="@NotionWebhookUrl" readonly />
                        @if (NotionSettings.HasWebhookVerificationToken)
                        {
                            <label class="form-label small fw-semibold mt-2" for="notionWebhookToken">
                                Verification token to paste into Notion
                            </label>
                            <input id="notionWebhookToken" class="form-control form-control-sm font-monospace"
                                   value="@NotionSettings.WebhookVerificationToken" readonly />
                            <div class="small text-success mt-2">
                                <i class="bi bi-shield-check me-1"></i>
                                Signature verification configured
                                @if (NotionSettings.WebhookVerificationReceivedAt is { } verifiedAt)
                                {
                                    <span>at @verifiedAt.ToLocalTime().ToString("g")</span>
                                }
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-danger mt-2"
                                    @onclick="ResetNotionWebhookAsync"
                                    disabled="@IsNotionOperationBusy">
                                Replace webhook subscription
                            </button>
                        }
                        else
                        {
                            <div class="small text-warning mt-2">
                                Waiting for Notion's verification request. Create the subscription, then refresh this status.
                            </div>
                        }
                        @if (NotionSettings.LastWebhookReceivedAt is { } webhookAt)
                        {
                            <div class="small text-secondary mt-2">
                                Last event: <strong>@(NotionSettings.LastWebhookEventType ?? "unknown")</strong>
                                at @webhookAt.ToLocalTime().ToString("g").
                            </div>
                        }
                    </section>
                    }

                    @if (_notionConflicts.Count > 0)
                    {
                        <section class="border border-warning rounded-3 p-3 mt-3" aria-labelledby="notion-conflicts-heading">
                            <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                                <h3 id="notion-conflicts-heading" class="h6 mb-0">Changes requiring review</h3>
                                <span class="badge text-bg-warning">@_notionConflicts.Count</span>
                            </div>
                            <p class="small text-secondary">
                                Sentinel and Notion changed the same field. Nothing was overwritten; choose which version should remain.
                            </p>
                            <div class="d-grid gap-2">
                                @foreach (var conflict in _notionConflicts)
                                {
                                    <article class="border rounded-3 p-2">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <div>
                                                <div class="fw-semibold">@conflict.PageTitle</div>
                                                <div class="small text-secondary">
                                                    @(conflict.FieldName == "title" ? "Page title" : "Page content")
                                                    · Notion changed @conflict.RemoteEditedAt.ToLocalTime().ToString("g")
                                                </div>
                                            </div>
                                            <button type="button" class="btn btn-sm btn-link"
                                                    @onclick="() => OpenPageFromNotionConflictAsync(conflict.WikiPageId)">
                                                Open page
                                            </button>
                                        </div>
                                        @if (conflict.FieldName == "title")
                                        {
                                            <div class="row g-2 mt-1 small">
                                                <div class="col-sm-6"><strong>Sentinel:</strong> @ConflictTitle(conflict.LocalValueJson)</div>
                                                <div class="col-sm-6"><strong>Notion:</strong> @ConflictTitle(conflict.RemoteValueJson)</div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="small text-secondary mt-2">Both content snapshots are preserved until you decide.</div>
                                        }
                                        <div class="d-flex flex-wrap gap-2 mt-2">
                                            <button type="button" class="btn btn-sm btn-outline-primary"
                                                    @onclick="() => ResolveNotionConflictAsync(conflict.Id, NotionConflictResolutions.KeepSentinel)">
                                                Keep Sentinel
                                            </button>
                                            <button type="button" class="btn btn-sm btn-warning"
                                                    @onclick="() => ResolveNotionConflictAsync(conflict.Id, NotionConflictResolutions.UseNotion)">
                                                Use Notion
                                            </button>
                                        </div>
                                    </article>
                                }
                            </div>
                        </section>
                    }

                    @if (NotionSettings.LastSyncedAt is { } lastSyncedAt)
                    {
                        <div class="border rounded-3 p-3 mt-3 bg-body-tertiary">
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <div class="small text-secondary">Last sync @lastSyncedAt.ToLocalTime().ToString("g")</div>
                                <span class="badge text-bg-success">Complete</span>
                            </div>
                            <div class="sentinel-sync-metrics mt-2">
                                <span><strong>@NotionSettings.LastSyncDiscoveredCount</strong><small>discovered</small></span>
                                <span><strong>@NotionSettings.LastSyncImportedCount</strong><small>imported</small></span>
                                <span><strong>@NotionSettings.LastSyncUpdatedCount</strong><small>updated</small></span>
                                <span><strong>@NotionSettings.LastSyncSkippedCount</strong><small>unchanged</small></span>
                                <span><strong>@NotionSettings.LastSyncContentBlockCount</strong><small>blocks</small></span>
                                <span><strong>@NotionSettings.LastSyncArchivedCount</strong><small>archived</small></span>
                            </div>
                            @if (NotionSettings.LastSyncEmptyContentCount > 0)
                            {
                                <div class="alert alert-warning py-2 mt-2 mb-0 small">
                                    <strong>@NotionSettings.LastSyncEmptyContentCount item(s) returned no readable content.</strong>
                                    Confirm the connection has Read content permission and that those pages are shared.
                                </div>
                            }
                            <div class="small text-secondary mt-2">
                                Coverage reflects content discoverable through Notion's API. Use a Notion workspace export for content the connection cannot enumerate.
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(NotionMessage))
                    {
                        <div class="alert @(NotionMessageIsError ? "alert-danger" : "alert-info") mt-3 mb-0">
                            @NotionMessage
                            @if (_notionSyncProgress is { Total: > 0 } progress)
                            {
                                <div class="progress mt-2" style="height: 0.5rem;" role="progressbar" aria-valuenow="@progress.Processed" aria-valuemin="0" aria-valuemax="@progress.Total">
                                    <div class="progress-bar" style="width:@((progress.Processed * 100 / progress.Total))%"></div>
                                </div>
                                <div class="small text-secondary mt-1">@progress.Processed of @progress.Total items synced</div>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseNotionModal" disabled="@IsNotionOperationBusy">Close</button>
                    @if (ShowNotionConnectionSettings || ShowNotionSyncSettings || !HasNotionConnection)
                    {
                    <button type="button" class="btn btn-outline-primary" @onclick="SaveNotionSettingsAsync"
                            disabled="@(IsNotionOperationBusy || HasInvalidNotionScope)">
                        <i class="bi bi-check2 me-1"></i>Save changes
                    </button>
                    }
                    <button type="button" class="btn btn-primary" @onclick="SyncNotionNowAsync"
                            disabled="@(IsNotionOperationBusy
                                || HasInvalidNotionScope
                                || (!NotionSettings.HasStoredIntegrationToken
                                    && !NotionSettings.IsOAuthConnected
                                    && string.IsNullOrWhiteSpace(NotionSettings.IntegrationToken)))">
                        @if (IsNotionBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi bi-arrow-repeat me-1"></i>
                        }
                        @(NotionMessageIsError ? "Retry resync" : "Resync now")
                    </button>
                    @if (SelectedPageId is { } notionPageId
                        && WikiPages.Any(page => page.Id == notionPageId && !string.IsNullOrWhiteSpace(page.NotionId))
                        && NotionSettings.SyncDirection == "twoWay" && NotionSettings.AllowTwoWayWrites)
                    {
                        <button type="button" class="btn btn-warning" @onclick="PushCurrentPageToNotionAsync" disabled="@IsNotionOperationBusy">
                            <i class="bi bi-cloud-arrow-up-fill me-1"></i>Push current page
                        </button>
                    }
                </div>
            </div>
        </div>
        <div class="modal-backdrop show" style="z-index:-1"></div>
    </div>
}

@if (ShowTrashModal)
{
    <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Trash</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseTrashModal"></button>
                </div>
                <div class="modal-body">
                    @if (TrashedPages.Count == 0 && TrashedDatabases.Count == 0)
                    {
                        <p class="text-secondary mb-0">Trash is empty.</p>
                    }
                    else
                    {
                        <p class="small text-secondary">Trashing a page also trashes its sub-pages and any
                            databases nested under it. Restoring one item does not automatically restore the
                            rest of that branch.</p>
                        @if (TrashedPages.Count > 0)
                        {
                            <h6 class="text-secondary text-uppercase small mb-2">Pages (@TrashedPages.Count)</h6>
                            <div class="list-group list-group-flush mb-3">
                                @foreach (var trashedPage in TrashedPages)
                                {
                                    <div class="list-group-item d-flex justify-content-between align-items-start gap-2">
                                        <div>
                                            <div class="fw-semibold">@(string.IsNullOrWhiteSpace(trashedPage.Icon) ? "📄" : trashedPage.Icon) @trashedPage.Title</div>
                                            <div class="small text-secondary">trashed @trashedPage.TrashedAt?.ToLocalTime().ToString("g")</div>
                                        </div>
                                        <div class="d-flex gap-1 flex-shrink-0">
                                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => RestoreTrashedPageAsync(trashedPage.Id)" disabled="@IsBusy">Restore</button>
                                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteTrashedPagePermanentlyAsync(trashedPage.Id)" disabled="@IsBusy">Delete Permanently</button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        @if (TrashedDatabases.Count > 0)
                        {
                            <h6 class="text-secondary text-uppercase small mb-2">Databases (@TrashedDatabases.Count)</h6>
                            <div class="list-group list-group-flush">
                                @foreach (var database in TrashedDatabases)
                                {
                                    <div class="list-group-item d-flex justify-content-between align-items-start gap-2">
                                        <div>
                                            <div class="fw-semibold">@(string.IsNullOrWhiteSpace(database.Icon) ? "🗄️" : database.Icon) @database.Title</div>
                                            <div class="small text-secondary">trashed @database.TrashedAt?.ToLocalTime().ToString("g")</div>
                                        </div>
                                        <div class="d-flex gap-1 flex-shrink-0">
                                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => RestoreTrashedDatabaseAsync(database.Id)" disabled="@IsBusy">Restore</button>
                                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteTrashedDatabasePermanentlyAsync(database.Id)" disabled="@IsBusy">Delete Permanently</button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
        <div class="modal-backdrop show" style="z-index:-1"></div>
    </div>
}

@code {
    // This route was Admin-only until per-resource Sentinel sharing (SentinelAccessService)
    // needed somewhere for Author/Contributor accounts to actually apply - see
    // OpenPageAsync/SavePageAsync/OpenDatabaseAsync for the per-resource checks that gate what
    // a non-Admin can view/edit now that the route itself admits them. Admins keep unrestricted
    // access, matching every other admin-gated page in this app - they are not subject to
    // SentinelResourcePermission grants.
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private bool _isAdmin = true;

    private async Task<bool> CanAccessPageOrDatabaseAsync(Guid targetId, bool isDatabase, string requiredLevel) =>
        _isAdmin || await SentinelAccessService.CanAccessAsync(targetId, isDatabase, CurrentUsername, requiredLevel);

    private List<WikiPage> WikiPages { get; set; } = new();
    private List<WikiDatabase> WikiDatabases { get; set; } = new();
    private List<WikiPage> TrashedPages { get; set; } = new();
    private List<WikiDatabase> TrashedDatabases { get; set; } = new();
    private bool ShowTrashModal { get; set; }
    private WikiPageEditorModel Editor { get; set; } = new();
    private Guid? SelectedPageId { get; set; }
    private Guid? SelectedDatabaseId { get; set; }
    private Guid? _pendingOpenRowId;
    private bool _canEditOpenDatabase = true;
    private string SelectedDatabaseTitle => SelectedDatabaseId is { } databaseId
        ? WikiDatabases.FirstOrDefault(database => database.Id == databaseId)?.Title ?? string.Empty
        : string.Empty;
    private bool IsBusy { get; set; }
    private bool _mobileWorkspaceNavOpen;
    private bool _workspaceBrowserCollapsed;
    // Keep the document canvas primary by default. The context rail remains one click away
    // and opening it is comfortable on wide workspaces; forcing it open alongside both the
    // portal and workspace navigation made common laptop widths unusably narrow.
    private bool _contextSidebarOpen;
    private string SearchQuery { get; set; } = string.Empty;
    private bool IsSearchBusy { get; set; }
    private List<SentinelSearchResult> WorkspaceSearchResults { get; set; } = new();
    private string _searchAuthorFilter = string.Empty;
    private string _searchDateFilter = string.Empty;
    private List<SentinelBacklink> Backlinks { get; set; } = new();
    private WikiPageConflictSnapshot? PageConflict { get; set; }
    private CancellationTokenSource? _autosaveCts;
    private bool _hasUnsavedAutosaveChanges;
    private string _autosaveStatus = string.Empty;
    private SentinelNavigationState Navigation { get; set; } = new([], []);
    private List<SentinelMention> Mentions { get; set; } = new();
    private List<SentinelSavedSearchView> SavedSearches { get; set; } = new();
    private bool IsCurrentSearchSaved => SavedSearches.Any(saved =>
        string.Equals(saved.Query, SearchQuery.Trim(), StringComparison.Ordinal));
    private string CurrentUsername { get; set; } = "unknown";
    private string StatusMessage { get; set; } = string.Empty;
    private string ErrorMessage { get; set; } = string.Empty;
    private readonly HashSet<Guid> _expandedPageIds = new();
    private Guid? _draggedNodeId;
    private bool _draggedNodeIsDatabase;
    private Guid? _dragOverNodeId;
    private Guid? _openRowMenuNodeId;
    private readonly HashSet<Guid> _selectedTreeNodeIds = new();
    private bool _showBulkDeleteConfirm, _showBulkMoveModal, _showSingleDeleteConfirm, _bulkActionBusy;
    private WikiTreeNode? _pendingSingleDelete;
    private Guid? _bulkMoveTargetParentId;

    private bool ShowNotionModal { get; set; }
    private bool ShowNotionToken { get; set; }
    private bool ShowNotionConnectionSettings { get; set; }
    private bool ShowNotionSyncSettings { get; set; }
    private bool ShowNotionWebhookSettings { get; set; }
    private bool IsNotionBusy { get; set; }
    private bool NotionMessageIsError { get; set; }
    private string NotionMessage { get; set; } = string.Empty;
    private NotionConnectorSettingsView NotionSettings { get; set; } = new();
    private bool IsNotionBrowseBusy { get; set; }
    private bool IsNotionOperationBusy => IsNotionBusy || IsNotionBrowseBusy;
    private bool HasInvalidNotionScope => !SyncAllNotionContent && SelectedNotionPickerIds.Count == 0;
    private bool HasNotionConnection =>
        NotionSettings.IsOAuthConnected
        || (NotionSettings.HasStoredIntegrationToken && !NotionSettings.IntegrationTokenUnreadable);
    private string NotionSyncSettingsSummary =>
        $"{(NotionSettings.SyncDirection == "twoWay" ? "Two-way" : "Import only")} · "
        + $"{(SyncAllNotionContent ? "Everything shared" : $"{SelectedNotionPickerIds.Count} selected")} · "
        + (NotionSettings.AutoSyncEnabled ? "Hourly sync on" : "Hourly sync off");
    private string NotionWebhookSummary =>
        NotionSettings.HasWebhookVerificationToken
            ? NotionSettings.LastWebhookReceivedAt is { } lastWebhookAt
                ? $"Verified · Last event {lastWebhookAt.ToLocalTime():g}"
                : "Verified · Waiting for events"
            : "Not configured";
    private bool SyncAllNotionContent { get; set; } = true;
    private List<NotionPickerItem> NotionPickerItems { get; set; } = [];
    private HashSet<string> SelectedNotionPickerIds { get; } = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> ExpandedNotionPickerIds { get; } = new(StringComparer.OrdinalIgnoreCase);
    private readonly CancellationTokenSource _disposeCts = new();
    private bool _isObservingNotionSync;
    private NotionSyncProgress? _notionSyncProgress;
    private string NotionWebhookUrl =>
        Navigator.ToAbsoluteUri("api/integrations/notion/webhook").ToString();
    private List<NotionSyncConflictView> _notionConflicts = [];

    private List<WikiRevisionView> History { get; set; } = new();
    private bool IsHistoryBusy { get; set; }
    private string HistoryErrorMessage { get; set; } = string.Empty;
    private Guid? DiffRevisionKey { get; set; }
    private string? DiffText { get; set; }
    private IReadOnlyList<SentinelCursorPosition> _remoteCursors = [];

    private ElementReference _blockEditorContainer;
    private ElementReference _workspaceSearchInput;
    private IJSObjectReference? _blockEditorModule;
    private IJSObjectReference? _workspaceModule;
    private DotNetObjectReference<Wiki>? _blockEditorRef;
    private bool _blockEditorInitialized;
    private int _editorGeneration;
