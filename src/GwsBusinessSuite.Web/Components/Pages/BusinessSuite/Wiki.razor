    private async Task SyncNotionNowAsync()
    {
        IsNotionBusy = true;
        NotionMessage = string.Empty;
        try
        {
            var validation = await NotionSyncService.SaveSettingsAsync(NotionSettings);
            if (!validation.IsSuccess)
            {
                NotionMessage = validation.Message;
                NotionMessageIsError = true;
                return;
            }
            NotionSettings.WorkspaceName = validation.WorkspaceName;
            NotionSettings.IntegrationTokenUnreadable = false;
            NotionSettings.HasStoredIntegrationToken = true;
            NotionSettings.IntegrationToken = string.Empty;

            if (!NotionSyncCoordinator.TryQueueManualSync())
            {
                NotionMessage = "A Notion sync is already running.";
                NotionMessageIsError = true;
                return;
            }

            _notionSyncProgress = null;
            NotionMessage = "Full Notion resync is queued on the server. It will refresh page blocks, database rows, and views even when Notion timestamps are unchanged, and will continue if this browser disconnects.";
            NotionMessageIsError = false;
            await ObserveNotionSyncAsync();
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to sync Notion workspace.");
            NotionMessage = $"Unable to sync Notion. {ex.Message}";
            NotionMessageIsError = true;
        }
        finally
        {
            IsNotionBusy = false;
        }
    }

    private async Task ObserveNotionSyncAsync()
    {
        if (_isObservingNotionSync)
        {
            return;
        }

        _isObservingNotionSync = true;
        try
        {
            while (!_disposeCts.IsCancellationRequested)
            {
                var status = NotionSyncCoordinator.GetStatus();
                if (!status.IsActive)
                {
                    if (status.Result is { } result)
                    {
                        SetNotionSyncMessage(result);
                        NotionSettings = await NotionSyncService.GetSettingsAsync() ?? NotionSettings;
                        _notionConflicts = (await NotionSyncService.GetPendingConflictsAsync()).ToList();
                        if (result.IsSuccess)
                        {
                            await LoadTreeAsync(selectFirstPage: false);
                        }
                    }
                    return;
                }

                NotionMessage = status.State == NotionSyncJobStates.Queued
                    ? "Notion sync is queued on the server."
                    : "Notion sync is running on the server. You can close this dialog or reconnect without stopping it.";
                _notionSyncProgress = status.Progress;
                await InvokeAsync(StateHasChanged);
                await Task.Delay(TimeSpan.FromSeconds(1), _disposeCts.Token);
            }
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to observe the server-side Notion sync.");
            NotionMessage = $"Unable to refresh Notion sync status. {ex.Message}";
            NotionMessageIsError = true;
        }
        finally
        {
            _isObservingNotionSync = false;
            IsNotionBusy = false;
            if (!_disposeCts.IsCancellationRequested)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void SetNotionSyncMessage(NotionSyncResult result)
    {
        NotionMessage = result.IsSuccess
            ? $"{result.Message} Discovered {result.Discovered}; {result.Imported} imported, {result.Updated} updated, {result.Skipped} unchanged, and {result.Archived} archived."
            : result.Message;
        NotionMessageIsError = !result.IsSuccess;
    }

