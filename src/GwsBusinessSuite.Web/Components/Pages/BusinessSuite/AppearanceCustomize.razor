@page "/admin/appearance/customize"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "ContributorAccess")]
@using Microsoft.AspNetCore.Authorization
@using GwsBusinessSuite.Application.CmsBuilder
@using GwsBusinessSuite.Domain.Entities
@using Microsoft.AspNetCore.Components.Forms
@using GwsBusinessSuite.Application.Abstractions
@using System.Text.Json
@inject ICmsBuilderService CmsBuilderService
@inject IConfiguration Configuration
@inject ICurrentUserAccessor CurrentUserAccessor
@inject ILogger<AppearanceCustomize> Logger

<PageTitle>Customize</PageTitle>

<div class="page-header">
    <h1><i class="bi bi-palette me-2 text-primary"></i>Customize</h1>
    <p>Global design tokens for @(CurrentSite?.Name ?? "the live site") — applies site-wide, across every page and the blog.</p>
</div>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@ErrorMessage</div>
}
@if (!string.IsNullOrWhiteSpace(StatusMessage))
{
    <div class="alert alert-info" role="alert">@StatusMessage</div>
}

<div class="card border-0 shadow-sm" style="max-width: 640px;">
    <div class="card-body">
        <label class="form-label fw-semibold small">Global Design</label>
        <div class="row g-2 mb-3">
            <div class="col-6">
                <label class="form-label small text-secondary mb-1">Accent Color</label>
                <input type="color" class="form-control form-control-color w-100" @bind="AccentColorInput" />
            </div>
            <div class="col-6">
                <label class="form-label small text-secondary mb-1">Font Pairing</label>
                <select class="form-select form-select-sm" @bind="FontPairingInput">
                    <option value="@CmsFontPairings.Elegant">Elegant (Playfair + Inter)</option>
                    <option value="@CmsFontPairings.Modern">Modern (Manrope + Inter)</option>
                    <option value="@CmsFontPairings.Classic">Classic (Merriweather + Source Sans)</option>
                </select>
            </div>
        </div>

        <label class="form-label fw-semibold small">Site-wide Custom CSS</label>
        <InputTextArea class="form-control font-monospace customize-css-editor" @bind-Value="CustomCssInput"
                       placeholder="Applies to every page on this site. Page-level CSS can override it." spellcheck="false" />

        <div class="row g-2 mt-1">
            <div class="col-12">
                <label class="form-label fw-semibold small">Logo URL</label>
                <InputText class="form-control" @bind-Value="LogoUrlInput" placeholder="https://... or /media/{id}" />
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold small">Favicon URL</label>
                <InputText class="form-control" @bind-Value="FaviconUrlInput" placeholder="https://... or /media/{id}" />
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-3">
            <button class="btn btn-primary btn-sm" @onclick="SaveAsync" disabled="@IsBusy">Save changes</button>
            @if (ExportUrl is { } exportUrl)
            {
                <a class="btn btn-sm btn-outline-secondary" href="@exportUrl" download>
                    <i class="bi bi-file-zip me-1"></i>Export ZIP
                </a>
            }
            @if (RecipeExportUrl is { } recipeUrl)
            {
                <a class="btn btn-sm btn-outline-secondary" href="@recipeUrl" download>
                    <i class="bi bi-file-earmark-code me-1"></i>Export recipe
                </a>
            }
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mt-3" style="max-width: 640px;">
    <div class="card-body">
        <label class="form-label fw-semibold small">Portable site recipe</label>
        <p class="text-secondary small">A recipe is this site's structure - pages, categories, custom fields, global blocks, and design settings - as a portable JSON package. Importing always creates a <strong>brand-new site</strong> with fresh page/category/field ids, and every imported page starts as a Draft so nothing goes live until you review and publish it.</p>
        <label class="btn btn-sm btn-outline-primary mb-0 @(IsBusy ? "disabled" : string.Empty)">
            <i class="bi bi-file-earmark-arrow-up me-1"></i>Import recipe
            <InputFile class="visually-hidden"
                       accept=".json,application/json"
                       disabled="@IsBusy"
                       OnChange="ImportRecipeAsync" />
        </label>
        @if (!string.IsNullOrWhiteSpace(RecipeImportMessage))
        {
            <div class="small @(RecipeImportSucceeded ? "text-success" : "text-danger") mt-2">@RecipeImportMessage</div>
        }
    </div>
</div>

<div class="card border-0 shadow-sm mt-3" style="max-width: 640px;">
    <div class="card-body">
        <label class="form-label fw-semibold small">Custom fields</label>
        <p class="text-secondary small">Typed fields available on every page of this site (e.g. "Product" or "Event" pages can carry real structured data beyond Title/Slug/Blocks) - edited per page on the page's Properties screen.</p>
        @if (PageProperties.Count > 0)
        {
            <div class="table-responsive mb-3">
                <table class="table table-sm align-middle">
                    <thead><tr><th>Name</th><th>Type</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var property in PageProperties)
                        {
                            <tr>
                                <td>@property.Name</td>
                                <td><span class="badge text-bg-light border">@property.Type</span>@if (property.Type == CmsPagePropertyTypes.Select) { <span class="text-secondary small ms-1">(@string.Join(", ", property.SelectOptions))</span> }</td>
                                <td class="text-end"><button type="button" class="btn btn-sm btn-link text-danger" disabled="@IsBusy" @onclick="() => DeletePropertyAsync(property.Id)">Delete</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small mb-1">Field name</label>
                <InputText class="form-control form-control-sm" @bind-Value="NewPropertyName" placeholder="Price" />
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">Type</label>
                <select class="form-select form-select-sm" @bind="NewPropertyType">
                    @foreach (var type in CmsPagePropertyTypes.All)
                    {
                        <option value="@type">@type</option>
                    }
                </select>
            </div>
            @if (NewPropertyType == CmsPagePropertyTypes.Select)
            {
                <div class="col-md-3">
                    <label class="form-label small mb-1">Options (comma-separated)</label>
                    <InputText class="form-control form-control-sm" @bind-Value="NewPropertyOptions" placeholder="Small, Medium, Large" />
                </div>
            }
            <div class="col-md-2">
                <button type="button" class="btn btn-sm btn-outline-primary w-100" disabled="@(IsBusy || string.IsNullOrWhiteSpace(NewPropertyName))" @onclick="AddPropertyAsync">Add field</button>
            </div>
        </div>
    </div>
</div>

@code {
    private CmsSite? CurrentSite { get; set; }
    private string CustomCssInput { get; set; } = string.Empty;
    private string AccentColorInput { get; set; } = "#f59e0b";
    private string FontPairingInput { get; set; } = CmsFontPairings.Elegant;
    private string LogoUrlInput { get; set; } = string.Empty;
    private string FaviconUrlInput { get; set; } = string.Empty;
    private bool IsBusy { get; set; }
    private string StatusMessage { get; set; } = string.Empty;
    private string ErrorMessage { get; set; } = string.Empty;
    private List<CmsPagePropertyView> PageProperties { get; set; } = [];
    private string NewPropertyName { get; set; } = string.Empty;
    private string NewPropertyType { get; set; } = CmsPagePropertyTypes.Text;
    private string NewPropertyOptions { get; set; } = string.Empty;

    private string? ExportUrl =>
        CurrentSite is { } site ? $"/admin/api/cms/{site.Slug}/export.zip" : null;
    private string? RecipeExportUrl =>
        CurrentSite is { } site ? $"/admin/api/cms/{site.Slug}/recipe.json" : null;
    private string RecipeImportMessage { get; set; } = string.Empty;
    private bool RecipeImportSucceeded { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var slug = Configuration["Canvas:SiteSlug"] ?? "grantwatson-dev";
        var name = Configuration["Canvas:SiteName"] ?? slug;

        var site = await CmsBuilderService.GetSiteBySlugAsync(slug);
        if (site is null)
        {
            site = await CmsBuilderService.SaveSiteAsync(new CmsSiteEditorModel { Name = name, Slug = slug, Theme = "Default" });
        }

        CurrentSite = site;
        CustomCssInput = site.CustomCss;
        AccentColorInput = site.AccentColorHex;
        FontPairingInput = site.FontPairingKey;
        LogoUrlInput = site.LogoUrl;
        FaviconUrlInput = site.FaviconUrl;
        PageProperties = (await CmsBuilderService.ListPagePropertiesAsync(site.Id)).ToList();
    }

    private async Task AddPropertyAsync()
    {
        if (CurrentSite is null || string.IsNullOrWhiteSpace(NewPropertyName)) return;
        IsBusy = true;
        try
        {
            await CmsBuilderService.SavePagePropertyAsync(new CmsPagePropertyEditor
            {
                SiteId = CurrentSite.Id,
                Name = NewPropertyName,
                Type = NewPropertyType,
                SortOrder = PageProperties.Count,
                SelectOptions = NewPropertyOptions.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            });
            PageProperties = (await CmsBuilderService.ListPagePropertiesAsync(CurrentSite.Id)).ToList();
            NewPropertyName = string.Empty;
            NewPropertyOptions = string.Empty;
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { IsBusy = false; }
    }

    private async Task DeletePropertyAsync(Guid propertyId)
    {
        if (CurrentSite is null) return;
        IsBusy = true;
        try
        {
            await CmsBuilderService.DeletePagePropertyAsync(propertyId);
            PageProperties = (await CmsBuilderService.ListPagePropertiesAsync(CurrentSite.Id)).ToList();
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { IsBusy = false; }
    }

    // Partial save: re-fetch the freshest site so a concurrent edit on
    // Appearance > Menus isn't clobbered - only these design fields come from this
    // screen, NavMenuJson/FooterNavMenuJson carry through unchanged.
    private async Task SaveAsync()
    {
        if (CurrentSite is null) return;

        IsBusy = true;
        StatusMessage = string.Empty;
        ErrorMessage = string.Empty;

        try
        {
            var freshSite = await CmsBuilderService.GetSiteBySlugAsync(CurrentSite.Slug) ?? CurrentSite;

            var saved = await CmsBuilderService.SaveSiteAsync(new CmsSiteEditorModel
            {
                SiteId = freshSite.Id,
                Name = freshSite.Name,
                Slug = freshSite.Slug,
                Theme = freshSite.Theme,
                CustomCss = CustomCssInput,
                NavMenuJson = freshSite.NavMenuJson,
                FooterNavMenuJson = freshSite.FooterNavMenuJson,
                AccentColorHex = AccentColorInput,
                FontPairingKey = FontPairingInput,
                LogoUrl = LogoUrlInput,
                FaviconUrl = FaviconUrlInput
            });

            CurrentSite = saved;
            StatusMessage = "Saved design settings.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to save site design settings.");
            ErrorMessage = $"Unable to save design settings. {ex.Message}";
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task ImportRecipeAsync(InputFileChangeEventArgs args)
    {
        RecipeImportMessage = string.Empty;
        RecipeImportSucceeded = false;
        IsBusy = true;
        try
        {
            var file = args.File;
            if (!file.Name.EndsWith(".json", StringComparison.OrdinalIgnoreCase))
            {
                throw new InvalidOperationException("Choose a .json site recipe file.");
            }

            await using var source = file.OpenReadStream(10 * 1024 * 1024);
            using var buffer = new MemoryStream();
            await source.CopyToAsync(buffer);

            var envelope = JsonSerializer.Deserialize<CmsSiteRecipeEnvelope>(
                buffer.ToArray(),
                new JsonSerializerOptions(JsonSerializerDefaults.Web));
            if (envelope is null || envelope.FormatVersion != 1)
            {
                throw new InvalidOperationException("This file isn't a recognized site recipe (unknown or missing format version).");
            }

            var user = await CurrentUserAccessor.GetCurrentUsernameAsync();
            var imported = await CmsBuilderService.ImportSiteRecipeAsync(envelope.Site, user);
            RecipeImportSucceeded = true;
            RecipeImportMessage = $"Imported \"{imported.Name}\" as a new site. Review its pages (all created as Drafts) before publishing.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to import site recipe.");
            RecipeImportMessage = $"Unable to import recipe. {ex.Message}";
        }
        finally
        {
            IsBusy = false;
        }
    }
}
