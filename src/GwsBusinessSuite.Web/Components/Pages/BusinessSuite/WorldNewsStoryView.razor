@implements IDisposable
@using GwsBusinessSuite.Application.Abstractions
@using GwsBusinessSuite.Infrastructure.Services
@using GwsBusinessSuite.WorldNewsKit
@inject WorldNewsService News
@inject ICurrentUserAccessor CurrentUserAccessor
@inject WikipediaMostReadService MostRead
@inject IServiceScopeFactory ScopeFactory

@* A World News story's document, drawn from StoryDocument: the same content as the PDF
   (EventDocument.ToMarkdown). Shared by the World News dialog and the story page. Since 07-11-26 it's
   three parts, the questions a reader asks in order: the story (what happened), agreement (how solid
   it is) and coverage (who's saying what: each outlet once, with its reports). The region and
   language chips sit with the coverage they filter. Opening it writes SentinelGPT's analysis when
   there's none yet or coverage has grown. *@

@if (_story is null)
{
    if (_gone)
    {
        <p class="text-danger" role="alert">This event isn't there any more (events are merged and pruned as coverage changes).</p>
    }
    else
    {
        <LoadingIndicator Message="Loading the story…" />
    }
}
else
{
    var e = _story.Event;
    var analysis = _story.Analysis;
    var numbers = StoryCoverage.GridNumbers(_story);
    var coverage = StoryCoverage.ByOutlet(_story);
    var storyCountry = _storyCountry;
    var localCount = storyCountry is null ? 0 : coverage.Count(c => LocalFirst.IsLocal(c.Outlet.Country, storyCountry));
    var shown = (_sort switch
        {
            CoverageSort.FirstToReport => coverage.OrderBy(c => c.Outlet.FirstSeen).ToList(),
            CoverageSort.LocalFirst => LocalFirst.Order(coverage, c => c.Outlet.Country, c => c.Outlet.FirstSeen, storyCountry),
            _ => coverage
        })
        .Where(c => _filter.Matches(c.Outlet)).ToList();
    var regions = StoryFilter.Regions(_story);
    var languages = StoryFilter.Languages(_story);

    <div class="story-analysis" role="status">
        @if (_analysisStatus is not null)
        {
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            <span>@_analysisStatus The sections below fill in when it's done.</span>
        }
        else if (_analysisError is not null)
        {
            <i class="bi bi-exclamation-triangle text-warning" aria-hidden="true"></i>
            <span>@_analysisError</span>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="AnalyseAgain">Try again</button>
        }
        else
        {
            <i class="bi bi-stars" aria-hidden="true"></i>
            <span>The claim, the summary, what each outlet leaves out or adds, and what they agree on are SentinelGPT's.</span>
            <button type="button" class="btn btn-sm btn-link" title="Read the outlets' articles and compare the coverage again"
                    @onclick="AnalyseAgain">Analyse again</button>
        }
    </div>

    @* Buttons, not "#…" links: those resolve against <base href="/"> and leave the page (app.js scrolls). *@
    <nav class="story-jump" aria-label="Parts of this story">
        <button type="button" data-story-jump="story-part-story">@EventDocument.StoryHeading</button>
        <button type="button" data-story-jump="story-part-agreement">@EventDocument.AgreementHeading</button>
        <button type="button" data-story-jump="story-part-coverage">@EventDocument.CoverageHeading <span class="story-jump-count">@_story.Outlets.Count</span></button>
        <button type="button" data-story-jump="story-part-timeline">Timeline <span class="story-jump-count">@_timeline.Count</span></button>
        <a class="story-jump-link" href="@($"admin/world-news/search?similar={Uri.EscapeDataString(_story.Event.Id)}")" title="Stories in the last week whose reports read like this one">
            <i class="bi bi-intersect me-1" aria-hidden="true"></i>Find similar
        </a>
    </nav>

    <article class="story-document">
        @if (e.Headline is not null)
        {
            <p class="story-original">Original headline: @e.Title</p>
        }
        <p class="story-numbers">@EventDocument.KeyNumbers(e, at => at.ToLocalGwsDateTime())</p>
        @if (_story.Trust is { } trust)
        {
            @* How far to trust it (World News trust plan 1.2/1.3/1.8, 13-11-26). *@
            <section class="story-trust story-trust-@trust.Confidence.Level.ToString().ToLowerInvariant()" aria-label="How far to trust this story">
                <div class="story-trust-head">
                    <span class="story-trust-label">@trust.Confidence.Label</span>
                    <span class="story-trust-reason">@trust.Confidence.Reason</span>
                </div>
                <p class="story-trust-sources">
                    @Count(trust.Independence.Outlets, "outlet") · <strong>@Count(trust.Independence.Independent, "independent source")</strong>
                    @if (trust.Independence.Origins.Any(origin => origin.Outlets.Count > 1))
                    {
                        <details class="story-trust-origins">
                            <summary>Who repeated whom</summary>
                            <ul>
                                @foreach (var origin in trust.Independence.Origins.Where(origin => origin.Outlets.Count > 1))
                                {
                                    <li><strong>@origin.Name</strong> (@OriginKind(origin.Kind)): @string.Join(", ", origin.Outlets)</li>
                                }
                            </ul>
                        </details>
                    }
                </p>
                @if (trust.CitedSources is { Count: > 0 } cited)
                {
                    @* Who the coverage relies on (A1/A2, 13-11-26). *@
                    <p class="story-trust-cited">
                        <span class="story-trust-cited-label">The coverage relies on</span>
                        @string.Join(", ", cited.Select(source => $"{source.Name} ({Count(source.Outlets, "outlet")})"))
                    </p>
                }
                @if (_bodyEdits.Count > 0)
                {
                    <details class="story-trust-checks">
                        <summary>@_bodyEdits.Count @(_bodyEdits.Count == 1 ? "report was" : "reports were") changed after publication</summary>
                        <ul>
                            @foreach (var edit in _bodyEdits)
                            {
                                <li>
                                    <strong>@edit.Report.Outlet</strong>, noticed @edit.At.ToLocalGwsDateTime():
                                    <a href="@edit.Report.Url" target="_blank" rel="noopener noreferrer">@edit.Report.Title</a>
                                    <div class="small text-secondary">First read: @Clip(edit.First)</div>
                                    <div class="small">Now: @Clip(edit.Latest)</div>
                                </li>
                            }
                        </ul>
                    </details>
                }
                @if (_sites.Networks.Count > 0 || _sites.NewSites.Count > 0)
                {
                    @* B5 (13-11-26): outlets that share a tracking or ad account, and sites registered only recently. *@
                    <details class="story-trust-checks" open>
                        <summary>Possible site network or new sites</summary>
                        <ul>
                            @foreach (var network in _sites.Networks)
                            {
                                <li><strong>@string.Join(", ", network.Outlets)</strong> share the account @network.Id (@string.Join(", ", network.Domains)), so they count as one source.</li>
                            }
                            @foreach (var site in _sites.NewSites)
                            {
                                <li><strong>@site.Outlet</strong> (@site.Domain) was registered @site.Registered!.Value.ToLocalGwsDateTime(): a new site.</li>
                            }
                        </ul>
                    </details>
                }
                @if (_photos.Recycled.Count > 0)
                {
                    @* B3 (13-11-26): a picture first used days earlier in another story. *@
                    <details class="story-trust-checks" open>
                        <summary>@_photos.Recycled.Count @(_photos.Recycled.Count == 1 ? "picture was" : "pictures were") used before, in an earlier story</summary>
                        <ul>
                            @foreach (var photo in _photos.Recycled)
                            {
                                <li>
                                    <a href="@photo.Now.ImageUrl" target="_blank" rel="noopener noreferrer">@RecycledPhotos.Describe(photo)</a>.
                                    <a href="@($"admin/world-news/events/{Uri.EscapeDataString(photo.Earlier.EventId)}")">Open the earlier story</a>
                                </li>
                            }
                        </ul>
                        <p class="small text-secondary mb-0">Matched by picture fingerprint, so a resized or recompressed copy still counts. An old picture can be fair use as a file photo; check the caption.</p>
                    </details>
                }
                else if (_photos.Pictures > 0)
                {
                    <p class="small text-secondary">@Count(_photos.Pictures, "picture") checked against earlier stories: none used before.@(_photos.WithCredentials > 0 ? $" {_photos.WithCredentials} carr{(_photos.WithCredentials == 1 ? "ies" : "y")} Content Credentials (not verified here)." : string.Empty)</p>
                }
                @if (trust.OfficialStatements is { Count: > 0 } statements)
                {
                    @* B9 (13-11-26): what official bodies said; a statement, not independent confirmation. *@
                    <ul class="story-trust-checks">
                        @foreach (var statement in statements.Take(5))
                        {
                            <li>
                                Official statement from <strong>@statement.Outlet</strong>:
                                <a href="@statement.Url" target="_blank" rel="noopener noreferrer">@statement.Title</a>
                            </li>
                        }
                    </ul>
                }
                @if (trust.FactChecks is { Count: > 0 } checks)
                {
                    <ul class="story-trust-checks">
                        @foreach (var check in checks)
                        {
                            <li>
                                Fact-checked by <strong>@check.Outlet</strong>@(check.Verdict is null ? "" : $" ({check.Verdict})"):
                                <a href="@check.Url" target="_blank" rel="noopener noreferrer">@check.Title</a>
                            </li>
                        }
                    </ul>
                }
                <p class="story-trust-rules">Rules @trust.RulesVersion · <a href="admin/world-news/methodology">how these labels are made</a></p>
                @* Challenges (World News trust plan A9, 13-11-26): anyone can question a label with evidence. *@
                <details class="story-trust-challenge">
                    <summary>Challenge this label@(_challenges.Count > 0 ? $" ({_challenges.Count} so far)" : "")</summary>
                    @foreach (var challenge in _challenges)
                    {
                        <p class="story-trust-challenge-item">
                            <span class="story-trust-edit-kind">@challenge.Status</span> @challenge.CreatedAt.ToLocalGwsDateTime(), @challenge.Username: @challenge.Note
                            @if (challenge.Resolution is { Length: > 0 } resolution) { <span class="d-block text-secondary">Resolution: @resolution</span> }
                        </p>
                    }
                    <form class="story-trust-challenge-form" @onsubmit="ChallengeAsync" @onsubmit:preventDefault>
                        <textarea class="form-control form-control-sm" rows="2" maxlength="1000" placeholder="What's wrong with this label, and how do you know?"
                                  aria-label="Why you challenge this label" @bind="_challengeNote" @bind:event="oninput"></textarea>
                        <input class="form-control form-control-sm" type="url" maxlength="500" placeholder="Link to your evidence (optional)" aria-label="Evidence link" @bind="_challengeUrl" @bind:event="oninput" />
                        <button type="submit" class="btn btn-sm btn-outline-primary" disabled="@(string.IsNullOrWhiteSpace(_challengeNote) || _username is null)">Send challenge</button>
                    </form>
                </details>
                @if (trust.Edits.Count > 0)
                {
                    <details class="story-trust-edits">
                        <summary>@Count(trust.Edits.Count, "headline change") after publication@(trust.Edits.Any(edit => edit.Kind == "correction") ? ", including a correction" : string.Empty)</summary>
                        <ul>
                            @foreach (var edit in trust.Edits)
                            {
                                <li>
                                    <span class="story-trust-edit-kind">@edit.Kind</span> @edit.SeenAt.ToLocalGwsDateTime():
                                    <del>@edit.Before</del> → <ins>@edit.After</ins>
                                </li>
                            }
                        </ul>
                    </details>
                }
            </section>
        }
        @if (_mostRead.Count > 0)
        {
            @* What people looked up yesterday that the headlines name (07-11-26). *@
            <p class="story-most-read">
                <span class="story-label">Most read on Wikipedia yesterday</span>
                @foreach (var article in _mostRead)
                {
                    <span class="story-most-read-item">
                        <a href="@article.Url" target="_blank" rel="noopener noreferrer">@article.Title</a>
                        <span class="story-most-read-rank">#@article.Rank, @article.Views.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) views</span>
                    </span>
                }
            </p>
        }

        @if (_story.Changes is { Any: true } changes)
        {
            <section class="story-changes" aria-labelledby="story-changes-heading">
                <h2 id="story-changes-heading">@EventDocument.ChangesHeading (@changes.Since.ToLocalGwsDateTime())</h2>
                <ul>
                    @foreach (var line in EventDocument.ChangeLines(changes))
                    {
                        <li>@line</li>
                    }
                </ul>
            </section>
        }

        @* The desk (World News trust plan B1/B2/N1-N3, 13-11-26): evidence, checklist, budget, draft. *@
        <section class="story-desk" aria-label="The desk">
            <div class="story-desk-actions">
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddToBudgetAsync" disabled="@_onBudget">
                    <i class="bi bi-kanban me-1" aria-hidden="true"></i>@(_onBudget ? "On the budget" : "Add to the budget")
                </button>
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="WriteDraftAsync" disabled="@_writing">
                    <i class="bi bi-pencil-square me-1" aria-hidden="true"></i>@(_writing ? "Writing…" : "Write a draft from this story")
                </button>
                @if (_draftId is { } draftId) { <a class="btn btn-sm btn-link" href="@($"admin/article-editor/{draftId}")">Open the draft</a> }
                @if (_situationId is { } situationId) { <a class="btn btn-sm btn-link" href="@($"admin/osint?news={situationId}")" data-enhance-nav="false">Show on Overwatch</a> }
            </div>

            <h3 class="story-desk-heading">Evidence board@(_board is { Place.Length: > 0 } b ? $": near {b.Place}" : "")</h3>
            @if (_board is null)
            {
                <p class="story-quiet">@(_boardLoaded ? "No place to check: the story couldn't be placed on the map." : "Checking records and sensors near the story…")</p>
            }
            else
            {
                @foreach (var check in _board.Checks)
                {
                    <p class="story-desk-check story-desk-check-@check.Verdict.ToString().ToLowerInvariant()">
                        <strong>@check.Claim:</strong> @(check.Verdict == SensorVerdict.Supported ? "supported" : "no sensor signal"). @check.Detail
                    </p>
                }
                @if (_board.Signals.Count == 0)
                {
                    <p class="story-quiet">No official records or sensor signals near here since two days before the first report.</p>
                }
                else
                {
                    <ol class="story-desk-timeline">
                        @foreach (var signal in _board.Signals)
                        {
                            <li>
                                <span class="story-desk-time">@(signal.At is { } at ? at.ToLocalGwsDateTime() : "now")</span>
                                <span class="story-desk-source">@signal.Source</span>
                                @if (signal.Url.StartsWith("http", StringComparison.Ordinal)) { <a href="@signal.Url" target="_blank" rel="noopener noreferrer">@signal.Title</a> } else { <span>@signal.Title</span> }
                                <small class="text-secondary">@($"{signal.Kilometres:0} km")</small>
                            </li>
                        }
                    </ol>
                }
            }

            <h3 class="story-desk-heading">Verification checklist @(DeskChecklist.IsComplete(_checks) ? "· checked by the desk" : "")</h3>
            <ul class="story-desk-checklist">
                @foreach (var (key, label, help) in DeskChecklist.Items)
                {
                    var check = _checks.FirstOrDefault(c => c.Item == key);
                    <li>
                        <label class="form-check">
                            <input class="form-check-input" type="checkbox" checked="@(check?.Done == true)" @onchange="e => SetCheckAsync(key, e.Value is true)" />
                            <span class="form-check-label"><strong>@label</strong> <small class="text-secondary">@help</small></span>
                        </label>
                        <input class="form-control form-control-sm" placeholder="Evidence (a link or what you checked)" aria-label="@($"Evidence for {label}")"
                               value="@(_evidence.GetValueOrDefault(key) ?? check?.Evidence)" @onchange="e => _evidence[key] = e.Value?.ToString() ?? string.Empty" />
                        @if (check?.Done != true && DeskChecklist.Suggest(key, _story.Trust, _board, _story.FirstReport) is { } suggestion)
                        {
                            <button type="button" class="btn btn-sm btn-link p-0" @onclick="() => _evidence[key] = suggestion">Use: @suggestion</button>
                        }
                        @if (check is { Done: true }) { <small class="d-block text-secondary">@check.CheckedBy, @check.CheckedAt?.ToLocalGwsDateTime()</small> }
                    </li>
                }
            </ul>
            @if (_deskError is not null) { <p class="text-danger small" role="alert">@_deskError</p> }
        </section>

        @* 1. What happened. *@
        <section id="story-part-story" class="story-part" aria-labelledby="story-h-story">
            <h2 id="story-h-story">@EventDocument.StoryHeading</h2>
            @if (analysis is { Claim.Length: > 0 })
            {
                <p class="story-claim"><span class="story-label">The claim</span> @analysis.Claim</p>
            }
            else
            {
                <p class="story-quiet">@WaitingText</p>
            }
            @if (analysis is { Summary.Length: > 0 })
            {
                @* B7 (13-11-26): sentences naming something the reports don't are marked. *@
                var checkedSummary = CheckSummary(analysis.Summary);
                <p>
                    @foreach (var sentence in checkedSummary)
                    {
                        if (sentence.Supported) { @sentence.Text @(" ") }
                        else { <span class="story-unsupported" title="@($"Not found in the reports' headlines or descriptions: {string.Join(", ", sentence.NotFound)}")">@sentence.Text</span> @(" ") }
                    }
                </p>
                @if (checkedSummary.Count(sentence => !sentence.Supported) is var unsupported and > 0)
                {
                    <p class="story-quiet">@unsupported of @checkedSummary.Count sentences (underlined) name something not found in the reports' headlines or descriptions. It may be in the full articles; check before relying on it.</p>
                }
            }
            else if (_story.Summary is { } summary)
            {
                <p>@summary.Text</p>
                <p class="story-quiet">A short summary from the headlines alone.</p>
            }
            else
            {
                <p class="story-quiet">No summary yet.</p>
            }
        </section>

        @* 2. How solid it is. *@
        <section id="story-part-agreement" class="story-part" aria-labelledby="story-h-agreement">
            <h2 id="story-h-agreement">@EventDocument.AgreementHeading</h2>

            <h3 class="story-subhead">@EventDocument.AgreedHeading</h3>
            @if (analysis is { Agreed.Count: > 0 })
            {
                <ol class="story-facts">
                    @foreach (var fact in analysis.Agreed)
                    {
                        <li>
                            <span>@fact.Text</span>
                            @if (fact.Outlets.Count > 0)
                            {
                                <span class="story-badge" title="@(string.Join(", ", fact.Outlets))">@Count(fact.Outlets.Count, "outlet")</span>
                                <span class="story-fact-outlets">@Names(fact.Outlets)</span>
                            }
                        </li>
                    }
                </ol>
            }
            else
            {
                <p class="story-quiet">@(analysis is null ? WaitingText : "SentinelGPT found no fact most outlets report alike.")</p>
            }

            @if (_story.Figures.Count > 0)
            {
                <h3 class="story-subhead">@EventDocument.FiguresHeading</h3>
                <p class="story-quiet">Read from each headline and description by fixed rules, without AI.</p>
                <ul class="story-figures">
                    @foreach (var claim in _story.Figures)
                    {
                        <li class="@(claim.Disputed ? "is-disputed" : string.Empty)">
                            <strong>@claim.Label:</strong> @(EventDocument.FigureValues(claim, 6) + "." + EventDocument.FigureVerdict(claim))
                        </li>
                    }
                </ul>
            }

            <h3 class="story-subhead">@EventDocument.DifferencesHeading</h3>
            @{
                var disputed = _story.Figures.Where(claim => claim.Disputed).ToList();
                var adds = analysis is null ? [] : _story.Comparisons.Where(c => c.Adds is not null).ToList();
                var general = analysis?.Differences.Where(d => d.Outlet.Length == 0).Select(d => d.Text).ToList()
                              ?? (_story.Summary?.Comparison ?? []).ToList();
            }
            @if (disputed.Count + adds.Count + general.Count > 0)
            {
                <ul class="story-differences">
                    @foreach (var claim in disputed)
                    {
                        <li><strong>@claim.Label:</strong> the reports give different figures (@(EventDocument.FigureValues(claim, 3))).</li>
                    }
                    @foreach (var comparison in adds)
                    {
                        <li><strong>@comparison.Outlet</strong> adds: @comparison.Adds</li>
                    }
                    @foreach (var point in general)
                    {
                        <li>@point</li>
                    }
                </ul>
            }
            else
            {
                <p class="story-quiet">@(analysis is null ? WaitingText : "SentinelGPT found no outlet whose coverage stands out from the rest.")</p>
            }

            @if (analysis is not null)
            {
                <p class="story-quiet story-credit">
                    The claim, the summary, what each outlet leaves out or adds, and what they agree on were written by SentinelGPT (@analysis.Model),
                    @analysis.CreatedAt.ToLocalGwsDateTime(), from the headlines and descriptions of @Count(analysis.ArticleCount, "report")@(analysis.ArticlesRead > 0 ? $" and {Count(analysis.ArticlesRead, "article")} read in full" : string.Empty).
                    Check the reports below before relying on a detail.
                </p>
            }
            else if (_story.Summary is { } written)
            {
                <p class="story-quiet story-credit">
                    The summary was written by AI (@written.Model) from the headlines and descriptions of @Count(written.ArticleCount, "report"),
                    @written.CreatedAt.ToLocalGwsDateTime() (version @written.Version). Check the reports below before relying on a detail.
                </p>
            }
        </section>

        @* 3. Who's saying what: each outlet once, with what it leaves out or adds and its reports. *@
        @* #7 (13-11-26): the story's chronology, from the first report to the latest change. *@
        <section id="story-part-timeline" class="story-part" aria-labelledby="story-h-timeline">
            <h2 id="story-h-timeline">Timeline</h2>
            @if (_timeline.Count == 0)
            {
                <p class="story-quiet">Nothing to show yet.</p>
            }
            else
            {
                <ol class="story-desk-timeline">
                    @foreach (var entry in _timeline)
                    {
                        <li class="story-timeline-@entry.Kind">
                            <span class="story-desk-time">@entry.At.ToLocalGwsDateTime()</span>
                            <span class="story-desk-source">@TimelineKind(entry.Kind)</span>
                            @if (entry.Url is { } url) { <a href="@url" target="_blank" rel="noopener noreferrer">@entry.Text</a> } else { <span>@entry.Text</span> }
                        </li>
                    }
                </ol>
            }
        </section>

        <section id="story-part-coverage" class="story-part" aria-labelledby="story-h-coverage">
            <h2 id="story-h-coverage">@EventDocument.CoverageHeading</h2>
            <div class="story-coverage-head">
                <p>
                    @Count(_story.Outlets.Count, "outlet") in @Count(e.Languages.Count, "language"), from @Count(e.Countries.Count, "country", "countries").
                    @if (_story.FirstReport is { } first && _story.LatestReport is { } latest)
                    {
                        <span>First: @first.Outlet, @first.SeenAt.ToLocalGwsDateTime(). Latest: @latest.Outlet, @latest.SeenAt.ToLocalGwsDateTime().</span>
                    }
                </p>
                <div class="story-spread">
                    <Sparkline Values="@StoryCoverage.Spread(_story)" Label="Outlets covering it, from the first report to the latest" Tone="info" Format="@OutletsText" />
                    <small>How it spread</small>
                </div>
            </div>

            @if (regions.Count > 0 || languages.Count > 0)
            {
                <div class="story-filters">
                    @if (regions.Count > 0)
                    {
                        <div class="story-chips" role="group" aria-label="Show outlets by region">
                            <button type="button" class="story-chip @On(_filter.Region is null)" aria-pressed="@Pressed(_filter.Region is null)"
                                    @onclick="() => _filter = _filter.WithRegion(null)">
                                All regions <span class="story-chip-count">@_story.Outlets.Count</span>
                            </button>
                            @foreach (var (region, count) in regions)
                            {
                                <button type="button" class="story-chip @On(_filter.Region == region)" aria-pressed="@Pressed(_filter.Region == region)"
                                        title="@RegionTitle(region)" @onclick="() => _filter = _filter.WithRegion(region)">
                                    @region <span class="story-chip-count">@count</span>
                                </button>
                            }
                        </div>
                    }
                    @if (languages.Count > 0)
                    {
                        <div class="story-chips" role="group" aria-label="Show outlets by language">
                            <button type="button" class="story-chip @On(_filter.Language is null)" aria-pressed="@Pressed(_filter.Language is null)"
                                    @onclick="() => _filter = _filter.WithLanguage(null)">
                                All languages <span class="story-chip-count">@_story.Outlets.Count</span>
                            </button>
                            @foreach (var (language, count) in languages)
                            {
                                <button type="button" class="story-chip @On(_filter.Language == language)" aria-pressed="@Pressed(_filter.Language == language)"
                                        @onclick="() => _filter = _filter.WithLanguage(language)">
                                    @language <span class="story-chip-count">@count</span>
                                </button>
                            }
                        </div>
                    }
                </div>
            }

            <div class="story-coverage-tools">
                <div class="story-chips" role="group" aria-label="Order outlets by">
                    <button type="button" class="story-chip @On(_sort == CoverageSort.MostReports)" aria-pressed="@Pressed(_sort == CoverageSort.MostReports)"
                            @onclick="() => _sort = CoverageSort.MostReports">Most reports</button>
                    <button type="button" class="story-chip @On(_sort == CoverageSort.FirstToReport)" aria-pressed="@Pressed(_sort == CoverageSort.FirstToReport)"
                            @onclick="() => _sort = CoverageSort.FirstToReport">First to report</button>
                    @if (localCount > 0)
                    {
                        <button type="button" class="story-chip @On(_sort == CoverageSort.LocalFirst)" aria-pressed="@Pressed(_sort == CoverageSort.LocalFirst)"
                                title="@($"Outlets based in {storyCountry}, where it happened, first")"
                                @onclick="() => _sort = CoverageSort.LocalFirst">Local first <span class="story-chip-count">@localCount</span></button>
                    }
                </div>
                @if (numbers.Count > 0)
                {
                    <button type="button" class="btn btn-sm btn-link" aria-expanded="@Pressed(_showGrid)" @onclick="() => _showGrid = !_showGrid">
                        @(_showGrid ? "Hide the comparison" : "Compare all outlets")
                    </button>
                }
            </div>
            @if (!_filter.IsEverything)
            {
                <p class="story-filter-note" role="status">
                    Showing @Count(shown.Count, "outlet") of @_story.Outlets.Count.
                    <button type="button" class="btn btn-sm btn-link" @onclick="() => _filter = StoryFilter.Everything">Show all</button>
                </p>
            }

            @if (_showGrid && numbers.Count > 0)
            {
                var rows = _story.Grid.Where(row => _filter.Matches(_story, row.Outlet)).ToList();
                <p class="story-quiet">@EventDocument.Stated the outlet's report states the fact, @EventDocument.NotStated it doesn't. The columns are the agreed facts, numbered as above.</p>
                <div class="story-table-scroll" tabindex="0" role="region" aria-label="@EventDocument.GridHeading">
                    <table class="story-table story-grid">
                        <thead>
                            <tr>
                                <th scope="col">Outlet</th>
                                @foreach (var number in numbers)
                                {
                                    <th scope="col" class="text-center" title="@(analysis!.Agreed[number - 1].Text)">@number</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in rows)
                            {
                                <tr>
                                    <th scope="row">@row.Outlet</th>
                                    @for (var i = 0; i < row.States.Count && i < numbers.Count; i++)
                                    {
                                        var stated = row.States[i];
                                        <td class="text-center @(stated ? "is-stated" : string.Empty)">
                                            <span aria-hidden="true">@(stated ? EventDocument.Stated : EventDocument.NotStated)</span>
                                            <span class="visually-hidden">@(stated ? "States" : "Doesn't state") fact @(numbers[i])</span>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (shown.Count == 0)
            {
                <p class="story-quiet">No outlet matches both of these.</p>
            }
            <ul class="story-outlets">
                @foreach (var outlet in shown)
                {
                    <li @key="outlet.Outlet.Name">
                        <details class="story-outlet">
                            <summary>
                                <span class="story-outlet-line">
                                    <span class="story-outlet-name">@outlet.Outlet.Name</span>
                                    @if (OutletNames.IsStateMedia(outlet.Outlet.Name))
                                    {
                                        <span class="story-state-media" title="State-run: a government agency, ruling-party paper or state-controlled broadcaster">state media</span>
                                    }
                                    <span class="story-outlet-meta">@outlet.Outlet.Country · @outlet.Outlet.Language · @Count(outlet.Outlet.Reports, "report")</span>
                                    @if (outlet.States is { } states)
                                    {
                                        <span class="story-dots" role="img" aria-label="@DotsLabel(states, numbers)">
                                            @for (var i = 0; i < states.Count && i < numbers.Count; i++)
                                            {
                                                <span class="@(states[i] ? "is-stated" : string.Empty)" title="Fact @(numbers[i])">@(states[i] ? EventDocument.Stated : EventDocument.NotStated)</span>
                                            }
                                        </span>
                                    }
                                    else if (numbers.Count > 0)
                                    {
                                        <span class="story-dots-none">not in the comparison</span>
                                    }
                                    @if (outlet.Outlet.ReadInFull)
                                    {
                                        <span class="story-read" title="SentinelGPT read this outlet's article in full">read in full</span>
                                    }
                                </span>
                                @if (outlet.LeavesOut.Count > 0 || outlet.Adds is not null)
                                {
                                    <span class="story-outlet-notes">
                                        @if (outlet.LeavesOut.Count > 0)
                                        {
                                            <span title="@(string.Join(" ", outlet.LeavesOut.Select(n => analysis!.Agreed[n - 1].Text)))">Leaves out @(string.Join(", ", outlet.LeavesOut))</span>
                                        }
                                        @if (outlet.LeavesOut.Count > 0 && outlet.Adds is not null)
                                        {
                                            <span aria-hidden="true"> · </span>
                                        }
                                        @if (outlet.Adds is { } added)
                                        {
                                            <span>Adds: @added</span>
                                        }
                                    </span>
                                }
                            </summary>
                            <ul class="story-reports">
                                @foreach (var report in outlet.Reports)
                                {
                                    var a = report.Report;
                                    <li>
                                        <span class="story-report-time">@a.SeenAt.ToLocalGwsDateTime()</span>
                                        @if (WebLink(a.Url) is { } href)
                                        {
                                            <a href="@href" target="_blank" rel="noopener noreferrer">@a.Title</a>
                                        }
                                        else
                                        {
                                            <span>@a.Title</span>
                                        }
                                        @if (_story.English.TryGetValue(a.Id, out var english))
                                        {
                                            <div class="story-english">In English: @english</div>
                                        }
                                        @if (report.FirstPublishedBy is { } firstBy)
                                        {
                                            <div class="story-quiet">A wire copy, first published by @firstBy.</div>
                                        }
                                        else if (a.Snippet is not null)
                                        {
                                            <blockquote>@a.Snippet</blockquote>
                                        }
                                        @if (report.AlsoCarriedBy.Count > 0)
                                        {
                                            <div class="story-quiet">Also carried by: @string.Join(", ", report.AlsoCarriedBy)</div>
                                        }
                                    </li>
                                }
                            </ul>
                        </details>
                    </li>
                }
            </ul>

            @{
                var unmatched = _filter.IsEverything ? StoryCoverage.Unmatched(_story) : [];
            }
            @if (unmatched.Count > 0)
            {
                <p class="story-quiet">SentinelGPT also wrote about outlets it named differently:</p>
                <ul class="story-differences">
                    @foreach (var comparison in unmatched)
                    {
                        <li><strong>@comparison.Outlet:</strong> @EventDocument.ComparisonText(comparison)</li>
                    }
                </ul>
            }
        </section>
    </article>
}

@code {
    private IReadOnlyList<LabelChallenge> _challenges = [];
    private string _challengeNote = string.Empty;
    private string _challengeUrl = string.Empty;

    private async Task ChallengeAsync()
    {
        if (_story is null || _username is null || string.IsNullOrWhiteSpace(_challengeNote)) return;
        var eventId = _story.Event.Id;
        var note = _challengeNote.Length > 1000 ? _challengeNote[..1000] : _challengeNote;
        var url = Uri.TryCreate(_challengeUrl.Trim(), UriKind.Absolute, out var link) && link.Scheme is "https" or "http" ? link.AbsoluteUri : null;
        var user = _username;
        await Task.Run(() => News.Store.AddChallenge(eventId, user, note, url, DateTimeOffset.UtcNow));
        _challengeNote = _challengeUrl = string.Empty;
        _challenges = await Task.Run(() => News.Store.Challenges(eventId));
    }

    private EvidenceBoard? _board;
    private bool _boardLoaded;
    private IReadOnlyList<DeskCheck> _checks = [];
    private readonly Dictionary<string, string> _evidence = new();
    private bool _onBudget;
    private bool _writing;
    private Guid? _draftId;
    private string? _situationId;
    private string? _deskError;

    // B4 (13-11-26): reports whose article text changed after World News first read it.
    private IReadOnlyList<(WorldArticle Report, string First, string Latest, DateTimeOffset At)> _bodyEdits = [];
    private (IReadOnlyList<RecycledPhoto> Recycled, int Pictures, int WithCredentials) _photos = ([], 0, 0);
    private (IReadOnlyList<SiteNetwork> Networks, IReadOnlyList<SiteSignal> NewSites) _sites = ([], []);
    private IReadOnlyList<TimelineEntry> _timeline = [];

    private static string TimelineKind(string kind) => kind switch
    {
        StoryTimeline.Report => "First",
        StoryTimeline.Outlets => "Coverage",
        StoryTimeline.Official => "Official",
        StoryTimeline.FactCheck => "Fact-check",
        StoryTimeline.Label => "Label",
        StoryTimeline.Edit => "Change",
        _ => "Record",
    };

    private void BuildTimeline(StoryDocument story) =>
        _timeline = StoryTimeline.Build(
            story.Sources.Select(source => source.Report).ToList(),
            News.Store.LabelSnapshots(story.Event.Id),
            story.Trust?.Edits,
            _bodyEdits.Select(edit => (edit.Report, edit.At)).ToList(),
            _board?.Signals.Where(signal => signal.At is not null).Select(signal => (signal.At!.Value, signal.Source, signal.Title, signal.Url)).ToList());

    private async Task LoadDeskAsync(StoryDocument story)
    {
        var edits = await Task.Run(() => News.Store.BodyEdits(story.Sources.Select(source => source.Report.Id)));
        _bodyEdits = story.Sources.Where(source => edits.ContainsKey(source.Report.Id))
            .Select(source => (source.Report, edits[source.Report.Id].FirstText, edits[source.Report.Id].LatestText, edits[source.Report.Id].DetectedAt))
            .ToList();
        var eventId = story.Event.Id;
        _photos = await Task.Run(() => News.PhotoCheck(eventId, story.Event.FirstSeen));
        BuildTimeline(story);
        _sites = News.SiteCheck(story.Outlets.Select(outlet => outlet.Name).ToList(), story.Sources.Select(source => source.Report.Url));
        _checks = await Task.Run(() => News.Store.DeskChecks(eventId));
        _onBudget = await Task.Run(() => News.Store.Budget().Any(item => item.EventId == eventId));
        _situationId = await Task.Run(() => News.Store.SituationOf(eventId));
        _board = await News.EvidenceBoardAsync(story);
        _boardLoaded = true;
        BuildTimeline(story);
    }

    private async Task SetCheckAsync(string item, bool done)
    {
        if (_story is null || _username is null) return;
        var evidence = _evidence.GetValueOrDefault(item) ?? _checks.FirstOrDefault(c => c.Item == item)?.Evidence;
        if (done && string.IsNullOrWhiteSpace(evidence)) { _deskError = "Add the evidence first: a link or what you checked."; _checks = [.. _checks]; return; }
        _deskError = null;
        var eventId = _story.Event.Id;
        var user = _username;
        await Task.Run(() => News.Store.SetDeskCheck(eventId, item, done, evidence, user, DateTimeOffset.UtcNow));
        _checks = await Task.Run(() => News.Store.DeskChecks(eventId));
    }

    private static string Clip(string text) => text.Length <= 400 ? text : text[..400] + "…";

    private IReadOnlyList<SummarySentence> CheckSummary(string summary) =>
        SummaryCheck.Check(summary, _story is null ? [] : _story.Sources.SelectMany(source =>
            new[] { source.Report.Title, source.Report.Snippet, _story.English.GetValueOrDefault(source.Report.Id) }));

    private async Task AddToBudgetAsync()
    {
        if (_story is null || _username is null) return;
        var item = new BudgetItem(_story.Event.Id, _story.Event.Headline ?? _story.Event.Title, _username, "watching", "Verify", DateTimeOffset.UtcNow, _username);
        await Task.Run(() => News.Store.SetBudgetItem(item));
        _onBudget = true;
    }

    private async Task WriteDraftAsync()
    {
        if (_story is null || _username is null) return;
        _writing = true;
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            _draftId = await scope.ServiceProvider.GetRequiredService<WorldNewsDeskService>().CreateDraftAsync(_story, _board, _username);
        }
        catch (Exception ex) when (ex is InvalidOperationException or Microsoft.EntityFrameworkCore.DbUpdateException)
        {
            _deskError = "The draft couldn't be saved: " + ex.Message;
        }
        finally { _writing = false; }
    }

    private static string OriginKind(string kind) => kind switch { "wire" => "wire copy", "owner" => "same owner", _ => "same text" };

    // The event whose story this shows.
    [Parameter, EditorRequired] public string EventId { get; set; } = string.Empty;

    private enum CoverageSort { MostReports, FirstToReport, LocalFirst }

    private StoryDocument? _story;
    private string? _storyCountry;
    // Wikipedia's most-read articles that this story's headlines name.
    private IReadOnlyList<MostReadArticle> _mostRead = [];
    private bool _gone;
    private string? _shownFor;
    private string? _username;
    private StoryFilter _filter = StoryFilter.Everything;
    private CoverageSort _sort = CoverageSort.MostReports;
    private bool _showGrid;
    // SentinelGPT's analysis while it's being written, or why it couldn't be.
    private string? _analysisStatus;
    private string? _analysisError;
    private bool _disposed;

    private string WaitingText => _analysisStatus is not null ? "SentinelGPT is writing this now." : EventDocument.Waiting;

    protected override async Task OnParametersSetAsync()
    {
        if (EventId == _shownFor) return;
        _shownFor = EventId;
        _story = null;
        _mostRead = [];
        _gone = false;
        _filter = StoryFilter.Everything;
        _sort = CoverageSort.MostReports;
        _showGrid = false;
        _analysisStatus = null;
        _analysisError = null;
        if (_username is null)
        {
            var username = await CurrentUserAccessor.GetCurrentUsernameAsync();
            _username = string.IsNullOrWhiteSpace(username) ? null : username;
        }
        await LoadAsync();
        if (_story is { } loaded)
        {
            var mostRead = WikipediaMostReadService.Matching([loaded.Event.Headline, loaded.Event.Title], await MostRead.GetAsync());
            if (loaded.Event.Id == EventId) _mostRead = mostRead;
        }
        // No analysis yet, or coverage has grown since: SentinelGPT writes one now. One already
        // running (started from another page) is followed instead.
        var id = EventId;
        if (_story is not null && (News.AnalysisStatus(id) is not null || await Task.Run(() => News.AnalysisDue(id))))
            _ = FollowAnalysisAsync(id);
    }

    private async Task LoadAsync()
    {
        var id = EventId;
        var story = await Task.Run(() => News.Story(id, _username));
        if (id != EventId || _disposed) return;
        _story = story;
        _storyCountry = story is null ? null : WorldNewsService.StoryCountry(story);
        _gone = story is null;
        _challenges = story is null ? [] : await Task.Run(() => News.Store.Challenges(story.Event.Id));
        _board = null; _boardLoaded = false; _draftId = null; _evidence.Clear(); _photos = ([], 0, 0); _sites = ([], []); _timeline = [];
        // A primary source can confirm it (World News trust plan 1.13); checked after it shows.
        if (story is not null)
        {
            StateHasChanged();
            var confirmed = await News.ConfirmWithPrimarySourcesAsync(story);
            if (id != EventId || _disposed) return;
            if (!ReferenceEquals(confirmed, story)) { _story = confirmed; StateHasChanged(); }
            await LoadDeskAsync(_story ?? story);
            if (id != EventId || _disposed) return;
        }
        // Seen: the next "what changed since you last read" starts from this analysis.
        if (_username is { } username && story?.Analysis is { } analysis)
            await Task.Run(() => News.MarkStoryRead(username, id, analysis.CreatedAt));
    }

    private void AnalyseAgain() => _ = FollowAnalysisAsync(EventId);

    // Follows the analysis (it runs on the server and carries on if this closes). The story is
    // fetched again whenever the analysis moves to its next step, so it shows as soon as it's saved,
    // before the headline translations finish, and each batch of translations shows as it lands.
    private async Task FollowAnalysisAsync(string eventId)
    {
        _analysisError = null;
        var analysis = News.AnalyzeAsync(eventId);
        string? step = null;
        while (!analysis.IsCompleted && !_disposed && eventId == EventId)
        {
            var now = News.AnalysisStatus(eventId) ?? "SentinelGPT is working…";
            if (step is not null && now != step) await LoadAsync();
            step = now;
            _analysisStatus = now;
            await InvokeAsync(StateHasChanged);
            await Task.WhenAny(analysis, Task.Delay(750));
        }
        if (_disposed || eventId != EventId) return;
        _analysisStatus = null;
        try
        {
            await analysis;
        }
        catch (InvalidOperationException ex)
        {
            _analysisError = ex.Message;
        }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException or TimeoutException)
        {
            _analysisError = "SentinelGPT couldn't finish the analysis. Try again in a minute.";
        }
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    // "BBC, Reuters, NHK" or "BBC, Reuters, NHK, Dawn, CNA and 3 more".
    private static string Names(IReadOnlyList<string> outlets) =>
        outlets.Count <= 5 ? string.Join(", ", outlets) : $"{string.Join(", ", outlets.Take(5))} and {outlets.Count - 5} more";

    private static string DotsLabel(IReadOnlyList<bool> states, IReadOnlyList<int> numbers)
    {
        var stated = numbers.Where((_, i) => i < states.Count && states[i]).ToList();
        return stated.Count == 0 ? "States none of the agreed facts" : $"States agreed facts {string.Join(", ", stated)} of {numbers.Count}";
    }

    private static string OutletsText(double value) => $"{value:0} outlets";

    // Only web links: a feed's link is shown as text when it's anything else.
    private static string? WebLink(string url) =>
        Uri.TryCreate(url, UriKind.Absolute, out var uri) && (uri.Scheme == Uri.UriSchemeHttps || uri.Scheme == Uri.UriSchemeHttp) ? uri.AbsoluteUri : null;

    private static string RegionTitle(string region) => region switch
    {
        StoryFilter.Western => "Outlets based in Europe, North America, Australia and New Zealand",
        StoryFilter.NonWestern => "Outlets based anywhere else",
        _ => $"Outlets based in {region}"
    };

    private static string On(bool on) => on ? "is-on" : string.Empty;

    private static string Pressed(bool on) => on ? "true" : "false";

    private static string Count(int n, string noun, string? plural = null) => $"{n:N0} {(n == 1 ? noun : plural ?? noun + "s")}";

    public void Dispose() => _disposed = true;
}
