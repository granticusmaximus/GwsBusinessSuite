@implements IDisposable
@using GwsBusinessSuite.Application.Abstractions
@using GwsBusinessSuite.Infrastructure.Services
@using GwsBusinessSuite.WorldNewsKit
@inject WorldNewsService News
@inject ICurrentUserAccessor CurrentUserAccessor

@* A World News story's document, drawn from StoryDocument: the same content as the PDF
   (EventDocument.ToMarkdown). Shared by the World News dialog and the story page. Since 07-11-26 it's
   three parts, the questions a reader asks in order: the story (what happened), agreement (how solid
   it is) and coverage (who's saying what: each outlet once, with its reports). The region and
   language chips sit with the coverage they filter. Opening it writes SentinelGPT's analysis when
   there's none yet or coverage has grown. *@

@if (_story is null)
{
    if (_gone)
    {
        <p class="text-danger" role="alert">This event isn't there any more (events are merged and pruned as coverage changes).</p>
    }
    else
    {
        <LoadingIndicator Message="Loading the story…" />
    }
}
else
{
    var e = _story.Event;
    var analysis = _story.Analysis;
    var numbers = StoryCoverage.GridNumbers(_story);
    var coverage = StoryCoverage.ByOutlet(_story);
    var shown = (_sort == CoverageSort.FirstToReport ? coverage.OrderBy(c => c.Outlet.FirstSeen).ToList() : coverage)
        .Where(c => _filter.Matches(c.Outlet)).ToList();
    var regions = StoryFilter.Regions(_story);
    var languages = StoryFilter.Languages(_story);

    <div class="story-analysis" role="status">
        @if (_analysisStatus is not null)
        {
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            <span>@_analysisStatus The sections below fill in when it's done.</span>
        }
        else if (_analysisError is not null)
        {
            <i class="bi bi-exclamation-triangle text-warning" aria-hidden="true"></i>
            <span>@_analysisError</span>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="AnalyseAgain">Try again</button>
        }
        else
        {
            <i class="bi bi-stars" aria-hidden="true"></i>
            <span>The claim, the summary, what each outlet leaves out or adds, and what they agree on are SentinelGPT's.</span>
            <button type="button" class="btn btn-sm btn-link" title="Read the outlets' articles and compare the coverage again"
                    @onclick="AnalyseAgain">Analyse again</button>
        }
    </div>

    @* Buttons, not "#…" links: those resolve against <base href="/"> and leave the page (app.js scrolls). *@
    <nav class="story-jump" aria-label="Parts of this story">
        <button type="button" data-story-jump="story-part-story">@EventDocument.StoryHeading</button>
        <button type="button" data-story-jump="story-part-agreement">@EventDocument.AgreementHeading</button>
        <button type="button" data-story-jump="story-part-coverage">@EventDocument.CoverageHeading <span class="story-jump-count">@_story.Outlets.Count</span></button>
    </nav>

    <article class="story-document">
        @if (e.Headline is not null)
        {
            <p class="story-original">Original headline: @e.Title</p>
        }
        <p class="story-numbers">@EventDocument.KeyNumbers(e, at => at.ToLocalGwsDateTime())</p>

        @if (_story.Changes is { Any: true } changes)
        {
            <section class="story-changes" aria-labelledby="story-changes-heading">
                <h2 id="story-changes-heading">@EventDocument.ChangesHeading (@changes.Since.ToLocalGwsDateTime())</h2>
                <ul>
                    @foreach (var line in EventDocument.ChangeLines(changes))
                    {
                        <li>@line</li>
                    }
                </ul>
            </section>
        }

        @* 1. What happened. *@
        <section id="story-part-story" class="story-part" aria-labelledby="story-h-story">
            <h2 id="story-h-story">@EventDocument.StoryHeading</h2>
            @if (analysis is { Claim.Length: > 0 })
            {
                <p class="story-claim"><span class="story-label">The claim</span> @analysis.Claim</p>
            }
            else
            {
                <p class="story-quiet">@WaitingText</p>
            }
            @if (analysis is { Summary.Length: > 0 })
            {
                <p>@analysis.Summary</p>
            }
            else if (_story.Summary is { } summary)
            {
                <p>@summary.Text</p>
                <p class="story-quiet">A short summary from the headlines alone.</p>
            }
            else
            {
                <p class="story-quiet">No summary yet.</p>
            }
        </section>

        @* 2. How solid it is. *@
        <section id="story-part-agreement" class="story-part" aria-labelledby="story-h-agreement">
            <h2 id="story-h-agreement">@EventDocument.AgreementHeading</h2>

            <h3 class="story-subhead">@EventDocument.AgreedHeading</h3>
            @if (analysis is { Agreed.Count: > 0 })
            {
                <ol class="story-facts">
                    @foreach (var fact in analysis.Agreed)
                    {
                        <li>
                            <span>@fact.Text</span>
                            @if (fact.Outlets.Count > 0)
                            {
                                <span class="story-badge" title="@(string.Join(", ", fact.Outlets))">@Count(fact.Outlets.Count, "outlet")</span>
                                <span class="story-fact-outlets">@Names(fact.Outlets)</span>
                            }
                        </li>
                    }
                </ol>
            }
            else
            {
                <p class="story-quiet">@(analysis is null ? WaitingText : "SentinelGPT found no fact most outlets report alike.")</p>
            }

            @if (_story.Figures.Count > 0)
            {
                <h3 class="story-subhead">@EventDocument.FiguresHeading</h3>
                <p class="story-quiet">Read from each headline and description by fixed rules, without AI.</p>
                <ul class="story-figures">
                    @foreach (var claim in _story.Figures)
                    {
                        <li class="@(claim.Disputed ? "is-disputed" : string.Empty)">
                            <strong>@claim.Label:</strong> @(EventDocument.FigureValues(claim, 6) + "." + EventDocument.FigureVerdict(claim))
                        </li>
                    }
                </ul>
            }

            <h3 class="story-subhead">@EventDocument.DifferencesHeading</h3>
            @{
                var disputed = _story.Figures.Where(claim => claim.Disputed).ToList();
                var adds = analysis is null ? [] : _story.Comparisons.Where(c => c.Adds is not null).ToList();
                var general = analysis?.Differences.Where(d => d.Outlet.Length == 0).Select(d => d.Text).ToList()
                              ?? (_story.Summary?.Comparison ?? []).ToList();
            }
            @if (disputed.Count + adds.Count + general.Count > 0)
            {
                <ul class="story-differences">
                    @foreach (var claim in disputed)
                    {
                        <li><strong>@claim.Label:</strong> the reports give different figures (@(EventDocument.FigureValues(claim, 3))).</li>
                    }
                    @foreach (var comparison in adds)
                    {
                        <li><strong>@comparison.Outlet</strong> adds: @comparison.Adds</li>
                    }
                    @foreach (var point in general)
                    {
                        <li>@point</li>
                    }
                </ul>
            }
            else
            {
                <p class="story-quiet">@(analysis is null ? WaitingText : "SentinelGPT found no outlet whose coverage stands out from the rest.")</p>
            }

            @if (analysis is not null)
            {
                <p class="story-quiet story-credit">
                    The claim, the summary, what each outlet leaves out or adds, and what they agree on were written by SentinelGPT (@analysis.Model),
                    @analysis.CreatedAt.ToLocalGwsDateTime(), from the headlines and descriptions of @Count(analysis.ArticleCount, "report")@(analysis.ArticlesRead > 0 ? $" and {Count(analysis.ArticlesRead, "article")} read in full" : string.Empty).
                    Check the reports below before relying on a detail.
                </p>
            }
            else if (_story.Summary is { } written)
            {
                <p class="story-quiet story-credit">
                    The summary was written by AI (@written.Model) from the headlines and descriptions of @Count(written.ArticleCount, "report"),
                    @written.CreatedAt.ToLocalGwsDateTime() (version @written.Version). Check the reports below before relying on a detail.
                </p>
            }
        </section>

        @* 3. Who's saying what: each outlet once, with what it leaves out or adds and its reports. *@
        <section id="story-part-coverage" class="story-part" aria-labelledby="story-h-coverage">
            <h2 id="story-h-coverage">@EventDocument.CoverageHeading</h2>
            <div class="story-coverage-head">
                <p>
                    @Count(_story.Outlets.Count, "outlet") in @Count(e.Languages.Count, "language"), from @Count(e.Countries.Count, "country", "countries").
                    @if (_story.FirstReport is { } first && _story.LatestReport is { } latest)
                    {
                        <span>First: @first.Outlet, @first.SeenAt.ToLocalGwsDateTime(). Latest: @latest.Outlet, @latest.SeenAt.ToLocalGwsDateTime().</span>
                    }
                </p>
                <div class="story-spread">
                    <Sparkline Values="@StoryCoverage.Spread(_story)" Label="Outlets covering it, from the first report to the latest" Tone="info" Format="@OutletsText" />
                    <small>How it spread</small>
                </div>
            </div>

            @if (regions.Count > 0 || languages.Count > 0)
            {
                <div class="story-filters">
                    @if (regions.Count > 0)
                    {
                        <div class="story-chips" role="group" aria-label="Show outlets by region">
                            <button type="button" class="story-chip @On(_filter.Region is null)" aria-pressed="@Pressed(_filter.Region is null)"
                                    @onclick="() => _filter = _filter.WithRegion(null)">
                                All regions <span class="story-chip-count">@_story.Outlets.Count</span>
                            </button>
                            @foreach (var (region, count) in regions)
                            {
                                <button type="button" class="story-chip @On(_filter.Region == region)" aria-pressed="@Pressed(_filter.Region == region)"
                                        title="@RegionTitle(region)" @onclick="() => _filter = _filter.WithRegion(region)">
                                    @region <span class="story-chip-count">@count</span>
                                </button>
                            }
                        </div>
                    }
                    @if (languages.Count > 0)
                    {
                        <div class="story-chips" role="group" aria-label="Show outlets by language">
                            <button type="button" class="story-chip @On(_filter.Language is null)" aria-pressed="@Pressed(_filter.Language is null)"
                                    @onclick="() => _filter = _filter.WithLanguage(null)">
                                All languages <span class="story-chip-count">@_story.Outlets.Count</span>
                            </button>
                            @foreach (var (language, count) in languages)
                            {
                                <button type="button" class="story-chip @On(_filter.Language == language)" aria-pressed="@Pressed(_filter.Language == language)"
                                        @onclick="() => _filter = _filter.WithLanguage(language)">
                                    @language <span class="story-chip-count">@count</span>
                                </button>
                            }
                        </div>
                    }
                </div>
            }

            <div class="story-coverage-tools">
                <div class="story-chips" role="group" aria-label="Order outlets by">
                    <button type="button" class="story-chip @On(_sort == CoverageSort.MostReports)" aria-pressed="@Pressed(_sort == CoverageSort.MostReports)"
                            @onclick="() => _sort = CoverageSort.MostReports">Most reports</button>
                    <button type="button" class="story-chip @On(_sort == CoverageSort.FirstToReport)" aria-pressed="@Pressed(_sort == CoverageSort.FirstToReport)"
                            @onclick="() => _sort = CoverageSort.FirstToReport">First to report</button>
                </div>
                @if (numbers.Count > 0)
                {
                    <button type="button" class="btn btn-sm btn-link" aria-expanded="@Pressed(_showGrid)" @onclick="() => _showGrid = !_showGrid">
                        @(_showGrid ? "Hide the comparison" : "Compare all outlets")
                    </button>
                }
            </div>
            @if (!_filter.IsEverything)
            {
                <p class="story-filter-note" role="status">
                    Showing @Count(shown.Count, "outlet") of @_story.Outlets.Count.
                    <button type="button" class="btn btn-sm btn-link" @onclick="() => _filter = StoryFilter.Everything">Show all</button>
                </p>
            }

            @if (_showGrid && numbers.Count > 0)
            {
                var rows = _story.Grid.Where(row => _filter.Matches(_story, row.Outlet)).ToList();
                <p class="story-quiet">@EventDocument.Stated the outlet's report states the fact, @EventDocument.NotStated it doesn't. The columns are the agreed facts, numbered as above.</p>
                <div class="story-table-scroll" tabindex="0" role="region" aria-label="@EventDocument.GridHeading">
                    <table class="story-table story-grid">
                        <thead>
                            <tr>
                                <th scope="col">Outlet</th>
                                @foreach (var number in numbers)
                                {
                                    <th scope="col" class="text-center" title="@(analysis!.Agreed[number - 1].Text)">@number</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in rows)
                            {
                                <tr>
                                    <th scope="row">@row.Outlet</th>
                                    @for (var i = 0; i < row.States.Count && i < numbers.Count; i++)
                                    {
                                        var stated = row.States[i];
                                        <td class="text-center @(stated ? "is-stated" : string.Empty)">
                                            <span aria-hidden="true">@(stated ? EventDocument.Stated : EventDocument.NotStated)</span>
                                            <span class="visually-hidden">@(stated ? "States" : "Doesn't state") fact @(numbers[i])</span>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (shown.Count == 0)
            {
                <p class="story-quiet">No outlet matches both of these.</p>
            }
            <ul class="story-outlets">
                @foreach (var outlet in shown)
                {
                    <li @key="outlet.Outlet.Name">
                        <details class="story-outlet">
                            <summary>
                                <span class="story-outlet-line">
                                    <span class="story-outlet-name">@outlet.Outlet.Name</span>
                                    @if (OutletNames.IsStateMedia(outlet.Outlet.Name))
                                    {
                                        <span class="story-state-media" title="State-run: a government agency, ruling-party paper or state-controlled broadcaster">state media</span>
                                    }
                                    <span class="story-outlet-meta">@outlet.Outlet.Country · @outlet.Outlet.Language · @Count(outlet.Outlet.Reports, "report")</span>
                                    @if (outlet.States is { } states)
                                    {
                                        <span class="story-dots" role="img" aria-label="@DotsLabel(states, numbers)">
                                            @for (var i = 0; i < states.Count && i < numbers.Count; i++)
                                            {
                                                <span class="@(states[i] ? "is-stated" : string.Empty)" title="Fact @(numbers[i])">@(states[i] ? EventDocument.Stated : EventDocument.NotStated)</span>
                                            }
                                        </span>
                                    }
                                    else if (numbers.Count > 0)
                                    {
                                        <span class="story-dots-none">not in the comparison</span>
                                    }
                                    @if (outlet.Outlet.ReadInFull)
                                    {
                                        <span class="story-read" title="SentinelGPT read this outlet's article in full">read in full</span>
                                    }
                                </span>
                                @if (outlet.LeavesOut.Count > 0 || outlet.Adds is not null)
                                {
                                    <span class="story-outlet-notes">
                                        @if (outlet.LeavesOut.Count > 0)
                                        {
                                            <span title="@(string.Join(" ", outlet.LeavesOut.Select(n => analysis!.Agreed[n - 1].Text)))">Leaves out @(string.Join(", ", outlet.LeavesOut))</span>
                                        }
                                        @if (outlet.LeavesOut.Count > 0 && outlet.Adds is not null)
                                        {
                                            <span aria-hidden="true"> · </span>
                                        }
                                        @if (outlet.Adds is { } added)
                                        {
                                            <span>Adds: @added</span>
                                        }
                                    </span>
                                }
                            </summary>
                            <ul class="story-reports">
                                @foreach (var report in outlet.Reports)
                                {
                                    var a = report.Report;
                                    <li>
                                        <span class="story-report-time">@a.SeenAt.ToLocalGwsDateTime()</span>
                                        @if (WebLink(a.Url) is { } href)
                                        {
                                            <a href="@href" target="_blank" rel="noopener noreferrer">@a.Title</a>
                                        }
                                        else
                                        {
                                            <span>@a.Title</span>
                                        }
                                        @if (_story.English.TryGetValue(a.Id, out var english))
                                        {
                                            <div class="story-english">In English: @english</div>
                                        }
                                        @if (report.FirstPublishedBy is { } firstBy)
                                        {
                                            <div class="story-quiet">A wire copy, first published by @firstBy.</div>
                                        }
                                        else if (a.Snippet is not null)
                                        {
                                            <blockquote>@a.Snippet</blockquote>
                                        }
                                        @if (report.AlsoCarriedBy.Count > 0)
                                        {
                                            <div class="story-quiet">Also carried by: @string.Join(", ", report.AlsoCarriedBy)</div>
                                        }
                                    </li>
                                }
                            </ul>
                        </details>
                    </li>
                }
            </ul>

            @{
                var unmatched = _filter.IsEverything ? StoryCoverage.Unmatched(_story) : [];
            }
            @if (unmatched.Count > 0)
            {
                <p class="story-quiet">SentinelGPT also wrote about outlets it named differently:</p>
                <ul class="story-differences">
                    @foreach (var comparison in unmatched)
                    {
                        <li><strong>@comparison.Outlet:</strong> @EventDocument.ComparisonText(comparison)</li>
                    }
                </ul>
            }
        </section>
    </article>
}

@code {
    // The event whose story this shows.
    [Parameter, EditorRequired] public string EventId { get; set; } = string.Empty;

    private enum CoverageSort { MostReports, FirstToReport }

    private StoryDocument? _story;
    private bool _gone;
    private string? _shownFor;
    private string? _username;
    private StoryFilter _filter = StoryFilter.Everything;
    private CoverageSort _sort = CoverageSort.MostReports;
    private bool _showGrid;
    // SentinelGPT's analysis while it's being written, or why it couldn't be.
    private string? _analysisStatus;
    private string? _analysisError;
    private bool _disposed;

    private string WaitingText => _analysisStatus is not null ? "SentinelGPT is writing this now." : EventDocument.Waiting;

    protected override async Task OnParametersSetAsync()
    {
        if (EventId == _shownFor) return;
        _shownFor = EventId;
        _story = null;
        _gone = false;
        _filter = StoryFilter.Everything;
        _sort = CoverageSort.MostReports;
        _showGrid = false;
        _analysisStatus = null;
        _analysisError = null;
        if (_username is null)
        {
            var username = await CurrentUserAccessor.GetCurrentUsernameAsync();
            _username = string.IsNullOrWhiteSpace(username) ? null : username;
        }
        await LoadAsync();
        // No analysis yet, or coverage has grown since: SentinelGPT writes one now. One already
        // running (started from another page) is followed instead.
        var id = EventId;
        if (_story is not null && (News.AnalysisStatus(id) is not null || await Task.Run(() => News.AnalysisDue(id))))
            _ = FollowAnalysisAsync(id);
    }

    private async Task LoadAsync()
    {
        var id = EventId;
        var story = await Task.Run(() => News.Story(id, _username));
        if (id != EventId || _disposed) return;
        _story = story;
        _gone = story is null;
        // Seen: the next "what changed since you last read" starts from this analysis.
        if (_username is { } username && story?.Analysis is { } analysis)
            await Task.Run(() => News.MarkStoryRead(username, id, analysis.CreatedAt));
    }

    private void AnalyseAgain() => _ = FollowAnalysisAsync(EventId);

    // Follows the analysis (it runs on the server and carries on if this closes). The story is
    // fetched again whenever the analysis moves to its next step, so it shows as soon as it's saved,
    // before the headline translations finish, and each batch of translations shows as it lands.
    private async Task FollowAnalysisAsync(string eventId)
    {
        _analysisError = null;
        var analysis = News.AnalyzeAsync(eventId);
        string? step = null;
        while (!analysis.IsCompleted && !_disposed && eventId == EventId)
        {
            var now = News.AnalysisStatus(eventId) ?? "SentinelGPT is working…";
            if (step is not null && now != step) await LoadAsync();
            step = now;
            _analysisStatus = now;
            await InvokeAsync(StateHasChanged);
            await Task.WhenAny(analysis, Task.Delay(750));
        }
        if (_disposed || eventId != EventId) return;
        _analysisStatus = null;
        try
        {
            await analysis;
        }
        catch (InvalidOperationException ex)
        {
            _analysisError = ex.Message;
        }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException or TimeoutException)
        {
            _analysisError = "SentinelGPT couldn't finish the analysis. Try again in a minute.";
        }
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    // "BBC, Reuters, NHK" or "BBC, Reuters, NHK, Dawn, CNA and 3 more".
    private static string Names(IReadOnlyList<string> outlets) =>
        outlets.Count <= 5 ? string.Join(", ", outlets) : $"{string.Join(", ", outlets.Take(5))} and {outlets.Count - 5} more";

    private static string DotsLabel(IReadOnlyList<bool> states, IReadOnlyList<int> numbers)
    {
        var stated = numbers.Where((_, i) => i < states.Count && states[i]).ToList();
        return stated.Count == 0 ? "States none of the agreed facts" : $"States agreed facts {string.Join(", ", stated)} of {numbers.Count}";
    }

    private static string OutletsText(double value) => $"{value:0} outlets";

    // Only web links: a feed's link is shown as text when it's anything else.
    private static string? WebLink(string url) =>
        Uri.TryCreate(url, UriKind.Absolute, out var uri) && (uri.Scheme == Uri.UriSchemeHttps || uri.Scheme == Uri.UriSchemeHttp) ? uri.AbsoluteUri : null;

    private static string RegionTitle(string region) => region switch
    {
        StoryFilter.Western => "Outlets based in Europe, North America, Australia and New Zealand",
        StoryFilter.NonWestern => "Outlets based anywhere else",
        _ => $"Outlets based in {region}"
    };

    private static string On(bool on) => on ? "is-on" : string.Empty;

    private static string Pressed(bool on) => on ? "true" : "false";

    private static string Count(int n, string noun, string? plural = null) => $"{n:N0} {(n == 1 ? noun : plural ?? noun + "s")}";

    public void Dispose() => _disposed = true;
}
