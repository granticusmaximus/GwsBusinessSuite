@page "/admin/automation"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "ContentAccess")]
@using System.Text.Json
@using GwsBusinessSuite.Application.Abstractions
@using GwsBusinessSuite.Application.Automation
@using GwsBusinessSuite.Application.Wiki
@using GwsBusinessSuite.Domain.Entities
@using Microsoft.AspNetCore.Components.Authorization
@inject IAutomationWorkflowService WorkflowService
@inject IAutomationTemplateService TemplateService
@inject ISentinelAccessService AccessService
@inject ICurrentUserAccessor CurrentUserAccessor
@inject NavigationManager Navigation
@inject ILogger<Automation> Logger

<PageTitle>Workflow Automation</PageTitle>

<div class="page-header d-flex flex-wrap align-items-start justify-content-between gap-3">
    <div>
        <h1><i class="bi bi-diagram-3-fill me-2 text-primary"></i>Workflow Automation</h1>
        <p>Build, publish, run, and inspect durable business automations.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" href="/admin/automation/credentials"><i class="bi bi-key-fill me-1"></i>Credentials</a>
        <label class="btn btn-outline-secondary mb-0" for="importWorkflowFile"><i class="bi bi-upload me-1"></i>Import @if (_importing) { <span class="spinner-border spinner-border-sm ms-1"></span> }</label>
        <InputFile id="importWorkflowFile" class="visually-hidden" OnChange="ImportWorkflowAsync" accept=".json,application/json" />
        <button class="btn btn-outline-secondary" @onclick="OpenTemplates"><i class="bi bi-collection me-1"></i>New from template</button>
        <button class="btn btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg me-1"></i>New workflow</button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger">@_error</div>
}

@if (_recentFailures.Count > 0)
{
    <div class="card border-0 shadow-sm mb-4 border-start border-danger border-3">
        <div class="card-header bg-white border-bottom py-2 d-flex align-items-center justify-content-between">
            <span class="fw-semibold text-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i>Recent failures across all workflows</span>
            <span class="badge text-bg-danger">@_recentFailures.Count</span>
        </div>
        <div class="list-group list-group-flush">
            @foreach (var failure in _recentFailures)
            {
                <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-start gap-2" @onclick="() => OpenWorkflow(failure.WorkflowId)">
                    <div>
                        <div class="fw-semibold">@failure.WorkflowName <span class="text-secondary fw-normal">&middot; @failure.Mode</span></div>
                        <div class="small text-secondary text-truncate" style="max-width: 40rem;">@failure.ErrorMessage</div>
                    </div>
                    <span class="small text-secondary flex-shrink-0">@FormatLastRun(failure.FinishedAt)</span>
                </button>
            }
        </div>
    </div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-8">
                <label class="form-label small fw-semibold" for="workflowSearch">Search workflows</label>
                <input id="workflowSearch" class="form-control" @bind="_search" @bind:event="oninput" placeholder="Name or description" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold" for="workflowStatus">Status</label>
                <select id="workflowStatus" class="form-select" @bind="_statusFilter">
                    <option value="">All statuses</option>
                    <option>Active</option><option>Inactive</option><option>Draft</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold" for="workflowTag">Tag</label>
                <select id="workflowTag" class="form-select" @bind="_tagFilter">
                    <option value="">All tags</option>
                    @foreach (var tag in AllTags) { <option value="@tag">@tag</option> }
                </select>
            </div>
        </div>
    </div>
</div>

@if (_loading)
{
    <div class="text-secondary py-5 text-center"><span class="spinner-border spinner-border-sm me-2"></span>Loading workflows…</div>
}
else if (FilteredWorkflows.Count == 0)
{
    <div class="card border-0 shadow-sm"><div class="card-body text-center py-5">
        <i class="bi bi-diagram-3 fs-1 text-secondary"></i>
        <h2 class="h5 mt-3">No workflows yet</h2>
        <p class="text-secondary">Create a workflow to open the visual editor with a Manual Trigger ready to connect.</p>
        <button class="btn btn-primary" @onclick="OpenCreate">Create workflow</button>
    </div></div>
}
else
{
    <div class="row g-3">
        @foreach (var workflow in FilteredWorkflows)
        {
            <div class="col-xl-4 col-md-6">
                <div class="card border-0 shadow-sm h-100 workflow-card">
                    <button type="button" class="card-body text-start w-100 border-0 bg-transparent p-3" @onclick="() => OpenWorkflow(workflow.Id)">
                        <div class="d-flex justify-content-between gap-2 mb-3">
                            <div class="automation-icon"><i class="bi bi-diagram-3-fill"></i></div>
                            <span class="badge @StatusClass(workflow.Status)">@workflow.Status</span>
                        </div>
                        <h2 class="h5">@workflow.Name</h2>
                        <p class="text-secondary small workflow-description">@(string.IsNullOrWhiteSpace(workflow.Description) ? "No description" : workflow.Description)</p>
                        <div class="d-flex flex-wrap gap-3 small text-secondary">
                            <span><i class="bi bi-box me-1"></i>@workflow.NodeCount nodes</span>
                            <span><i class="bi bi-layers me-1"></i>v@workflow.CurrentVersion</span>
                            <span><i class="bi bi-clock me-1"></i>@FormatLastRun(workflow.LastExecutedAt)</span>
                        </div>
                        @if (WorkflowTags(workflow).Count > 0)
                        {
                            <div class="d-flex flex-wrap gap-1 mt-2">
                                @foreach (var tag in WorkflowTags(workflow)) { <span class="badge text-bg-light border">@tag</span> }
                            </div>
                        }
                    </button>
                    <div class="card-footer bg-transparent border-0 pt-0 px-3 pb-3 d-flex justify-content-end">
                        <button type="button" class="btn btn-sm btn-link" disabled="@_busy" @onclick="() => DuplicateWorkflowAsync(workflow)">
                            <i class="bi bi-copy me-1"></i>Duplicate
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (_showCreate)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
            <div class="modal-header"><h2 class="modal-title h5">Create workflow</h2><button class="btn-close" @onclick="CloseCreate" aria-label="Close"></button></div>
            <div class="modal-body">
                <label class="form-label fw-semibold" for="newWorkflowName">Name</label>
                <input id="newWorkflowName" class="form-control mb-3" @bind="_newName" placeholder="Customer follow-up" />
                <label class="form-label fw-semibold" for="newWorkflowDescription">Description</label>
                <textarea id="newWorkflowDescription" class="form-control" rows="3" @bind="_newDescription"></textarea>
            </div>
            <div class="modal-footer"><button class="btn btn-outline-secondary" @onclick="CloseCreate">Cancel</button><button class="btn btn-primary" @onclick="CreateWorkflow" disabled="@_busy">Create and open</button></div>
        </div></div>
    </div>
}

@if (_showTemplates)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
            <div class="modal-header"><h2 class="modal-title h5">New workflow from template</h2><button class="btn-close" @onclick="CloseTemplates" aria-label="Close"></button></div>
            <div class="modal-body">
                <h3 class="h6 text-secondary text-uppercase small fw-bold mb-2">Starter workflows</h3>
                <div class="list-group mb-4">
                    @foreach (var starter in AutomationStarterWorkflows.All)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center gap-2">
                            <div>
                                <div class="fw-semibold"><i class="bi @starter.Icon me-1 text-primary"></i>@starter.Graph.Name</div>
                                <div class="small text-secondary">@starter.Description</div>
                            </div>
                            <button class="btn btn-sm btn-outline-primary flex-shrink-0" disabled="@_busy" @onclick="() => UseStarterWorkflow(starter)">Use starter</button>
                        </div>
                    }
                </div>
                <h3 class="h6 text-secondary text-uppercase small fw-bold mb-2">Your templates</h3>
                @if (_templates.Count == 0)
                {
                    <p class="text-secondary mb-0">No saved templates yet. Open a workflow and use "Save as template" to create one.</p>
                }
                else
                {
                    <div class="list-group">
                        @foreach (var template in _templates)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center gap-2">
                                <div>
                                    <div class="fw-semibold">@template.Name</div>
                                    <div class="small text-secondary">@template.NodeCount nodes @(string.IsNullOrWhiteSpace(template.Description) ? "" : $"· {template.Description}")</div>
                                </div>
                                <button class="btn btn-sm btn-outline-primary flex-shrink-0" disabled="@_busy" @onclick="() => UseTemplate(template.Id)">Use template</button>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="modal-footer"><button class="btn btn-outline-secondary" @onclick="CloseTemplates">Close</button></div>
        </div></div>
    </div>
}

@code {
    private List<AutomationWorkflowSummary> _workflows = [];
    private List<AutomationRecentFailureView> _recentFailures = [];
    private List<AutomationWorkflowTemplateSummary> _templates = [];
    private bool _loading = true, _busy, _showCreate, _showTemplates, _importing;
    private string _search = "", _statusFilter = "", _tagFilter = "", _newName = "", _newDescription = "", _error = "";
    private const long MaxImportBytes = 5 * 1024 * 1024;

    private List<AutomationWorkflowSummary> FilteredWorkflows => _workflows.Where(workflow =>
        (string.IsNullOrWhiteSpace(_search) || workflow.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) || workflow.Description.Contains(_search, StringComparison.OrdinalIgnoreCase))
        && (string.IsNullOrWhiteSpace(_statusFilter) || workflow.Status.Equals(_statusFilter, StringComparison.OrdinalIgnoreCase))
        && (string.IsNullOrWhiteSpace(_tagFilter) || WorkflowTags(workflow).Contains(_tagFilter, StringComparer.OrdinalIgnoreCase))).ToList();

    // Tags double as lightweight "folders" for browsing - a dedicated folder hierarchy wasn't
    // built given tags already cover grouping/filtering without a new entity/CRUD surface.
    private List<string> AllTags => _workflows.SelectMany(WorkflowTags).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(tag => tag).ToList();

    private static List<string> WorkflowTags(AutomationWorkflowSummary workflow) =>
        workflow.TagsCsv.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var workflows = (await WorkflowService.ListAsync()).ToList();
            var isAdmin = AuthState is not null && (await AuthState).User.IsInRole(AppRoles.Admin);
            if (!isAdmin)
            {
                // Part 4.9: an Author/Contributor sees only workflows an admin has explicitly
                // shared with them, not the full suite-wide list - the same per-workflow grant
                // AutomationEditor.razor's "Share this workflow" section creates.
                var username = await CurrentUserAccessor.GetCurrentUsernameAsync();
                var accessible = new List<AutomationWorkflowSummary>();
                foreach (var workflow in workflows)
                {
                    if (await AccessService.HasDirectPermissionAsync(workflow.Id, isDatabase: false, username, SentinelAccessLevels.View))
                        accessible.Add(workflow);
                }
                workflows = accessible;
            }
            _workflows = workflows;
            _recentFailures = (await WorkflowService.ListRecentFailuresAsync()).ToList();
        }
        catch (Exception ex) { Logger.LogError(ex, "Unable to load automation workflows."); _error = ex.Message; }
        finally { _loading = false; }
    }

    private void OpenCreate() { _newName = ""; _newDescription = ""; _showCreate = true; }
    private void CloseCreate() => _showCreate = false;
    private void OpenWorkflow(Guid id) => Navigation.NavigateTo($"/admin/automation/{id}");
    private async Task CreateWorkflow()
    {
        _busy = true; _error = "";
        try { var created = await WorkflowService.CreateAsync(_newName, _newDescription); Navigation.NavigateTo($"/admin/automation/{created.Id}"); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task DuplicateWorkflowAsync(AutomationWorkflowSummary workflow)
    {
        _busy = true; _error = "";
        try
        {
            var created = await WorkflowService.DuplicateAsync(workflow.Id, $"{workflow.Name} (copy)", "user");
            Navigation.NavigateTo($"/admin/automation/{created.Id}");
        }
        catch (Exception ex) { Logger.LogError(ex, "Unable to duplicate workflow {WorkflowId}.", workflow.Id); _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task OpenTemplates()
    {
        _error = "";
        try { _templates = (await TemplateService.ListAsync()).ToList(); _showTemplates = true; }
        catch (Exception ex) { Logger.LogError(ex, "Unable to load workflow templates."); _error = ex.Message; }
    }
    private void CloseTemplates() => _showTemplates = false;

    private async Task UseStarterWorkflow(AutomationStarterWorkflow starter)
    {
        _busy = true; _error = "";
        try
        {
            var created = await WorkflowService.CreateFromGraphAsync(
                starter.Graph.Name, starter.Graph.Description, starter.Graph.Nodes, starter.Graph.Connections, "user");
            Navigation.NavigateTo($"/admin/automation/{created.Id}");
        }
        catch (Exception ex) { Logger.LogError(ex, "Unable to create workflow from starter {StarterKey}.", starter.Key); _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task UseTemplate(Guid templateId)
    {
        _busy = true; _error = "";
        try
        {
            var created = await TemplateService.InstantiateAsync(templateId, string.Empty, "user");
            Navigation.NavigateTo($"/admin/automation/{created.Id}");
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    // Import always creates a brand-new workflow with fresh node/connection ids
    // (IAutomationWorkflowService.CreateFromGraphAsync) rather than merging into an existing
    // draft - a v1 scope decision to avoid the risk of corrupting an in-progress graph.
    private async Task ImportWorkflowAsync(InputFileChangeEventArgs args)
    {
        if (args.File.Size > MaxImportBytes) { _error = $"Workflow export files are limited to {MaxImportBytes / 1024 / 1024} MB."; return; }
        _importing = true; _error = "";
        try
        {
            await using var stream = args.File.OpenReadStream(MaxImportBytes);
            using var reader = new StreamReader(stream, detectEncodingFromByteOrderMarks: true);
            var json = await reader.ReadToEndAsync();
            var envelope = JsonSerializer.Deserialize<AutomationWorkflowExportEnvelope>(json, new JsonSerializerOptions(JsonSerializerDefaults.Web))
                ?? throw new InvalidOperationException("This file could not be read as a workflow export.");
            if (envelope.FormatVersion != 1) throw new InvalidOperationException($"Unsupported export format version {envelope.FormatVersion}.");

            var created = await WorkflowService.CreateFromGraphAsync(
                envelope.Workflow.Name, envelope.Workflow.Description, envelope.Workflow.Nodes, envelope.Workflow.Connections, "user");
            Navigation.NavigateTo($"/admin/automation/{created.Id}");
        }
        catch (Exception ex) { Logger.LogError(ex, "Unable to import workflow export."); _error = ex.Message; }
        finally { _importing = false; }
    }
    private static string StatusClass(string status) => status == "Active" ? "text-bg-success" : status == "Inactive" ? "text-bg-secondary" : "text-bg-warning";
    private static string FormatLastRun(DateTimeOffset? value) => value is null ? "Never run" : value.Value.ToLocalTime().ToString("MMM d, h:mm tt");
}
