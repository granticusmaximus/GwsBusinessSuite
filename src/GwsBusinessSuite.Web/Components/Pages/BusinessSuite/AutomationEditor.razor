    private async Task ShowDiff() => await Work(async () =>
    {
        _diff = await WorkflowService.DiffVersionsAsync(WorkflowId, _diffFromVersion, _diffToVersion);
    });
    private async Task RestoreVersion(int versionNumber) => await Work(async () =>
    {
        await WorkflowService.RollbackToVersionAsync(WorkflowId, versionNumber, "user");
        await Reload();
        Show($"Restored v{versionNumber} into the editor. Publish again to make it live.");
    });

    private async Task Work(Func<Task> action)
    {
        _busy = true; _message = ""; _messageIsError = false;
        try { await action(); MarkSaved(); }
        catch (Exception ex) { Fail(ex, ex.Message); }
        finally { _busy = false; }
    }
    // Positions of nodes moved since the last graph fetch. AutomationWorkflowView is a class
    // with init-only members, so the fetched view cannot be patched in place - and it must not
    // simply be left stale, because the node's own style and every connection path render from
    // it. Without this overlay a re-render would snap a dragged node back to where the server
    // last said it was. Cleared whenever the graph is refetched.
    private readonly Dictionary<Guid, (double X, double Y)> _movedPositions = [];

    private (double X, double Y) NodePosition(AutomationNodeView node) =>
        _movedPositions.TryGetValue(node.Id, out var moved) ? moved : (node.PositionX, node.PositionY);

    // Reported rather than requested: every edit here still persists immediately, so the header
    // says what happened instead of offering a Save button that would imply otherwise.
    private DateTimeOffset? _lastSavedAt;
    private void MarkSaved() => _lastSavedAt = DateTimeOffset.Now;
    private string SaveStateText => _busy
        ? "Saving…"
        : _lastSavedAt is { } at ? $"Saved {at.ToLocalTime():h:mm tt}" : string.Empty;

    private void Show(string message, bool error = false) { _message = message; _messageIsError = error; }
    private void Fail(Exception ex, string message) { Logger.LogError(ex, "Workflow editor operation failed for {WorkflowId}.", WorkflowId); Show(message, true); }
    private string NodeName(Guid id) => _view?.Nodes.FirstOrDefault(node => node.Id == id)?.Name ?? "Missing node";
    private string ConnectionPath(AutomationConnectionView connection)
    {
        var source = _view?.Nodes.FirstOrDefault(node => node.Id == connection.SourceNodeId); var target = _view?.Nodes.FirstOrDefault(node => node.Id == connection.TargetNodeId);
        if (source is null || target is null) return "";
        var (sourceX, sourceY) = NodePosition(source); var (targetX, targetY) = NodePosition(target);
        var sx = sourceX + 196; var sy = sourceY + (connection.SourceOutput == "true" ? 38 : connection.SourceOutput == "false" ? 72 : 55); var tx = targetX; var ty = targetY + 55; var bend = Math.Max(70, Math.Abs(tx - sx) * .45);
        return $"M {sx} {sy} C {sx + bend} {sy}, {tx - bend} {ty}, {tx} {ty}";
    }
    // Scaled to the graph's own extent rather than the old fixed 2200x1250 clamp. Now that
    // panning has removed that clamp, a node beyond it would have put its dot outside the
    // minimap entirely.
    private string MinimapPercent(double value, bool horizontal)
    {
        if (_view is null || _view.Nodes.Count == 0) return "0";
        var max = horizontal
            ? Math.Max(2200, _view.Nodes.Max(node => NodePosition(node).X) + 200)
            : Math.Max(1250, _view.Nodes.Max(node => NodePosition(node).Y) + 120);
        var percent = Math.Clamp(value / max * 100, 0, 100);
        return percent.ToString("0.##", CultureInfo.InvariantCulture);
    }

    private static string ConnectionClass(string output) => output == "true" ? "is-true" : output == "false" ? "is-false" : "";
    private static string FormatDate(DateTimeOffset? value) => value?.ToLocalTime().ToString("MMM d, h:mm:ss tt") ?? "—";
    private static string Duration(DateTimeOffset? start, DateTimeOffset? end) => start is null || end is null ? "—" : $"{(end.Value - start.Value).TotalMilliseconds:N0} ms";

    public async ValueTask DisposeAsync()
    {
        if (_module is not null) { try { await _module.InvokeVoidAsync("dispose", _canvas); await _module.DisposeAsync(); } catch (JSDisconnectedException) { } }
        _dotNetRef?.Dispose();
    }
