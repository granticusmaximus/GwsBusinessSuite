@page "/admin/automation/{WorkflowId:guid}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "ContentAccess")]
@implements IAsyncDisposable
@using System.Globalization
@using GwsBusinessSuite.Application.Abstractions
@using GwsBusinessSuite.Application.Automation
@using GwsBusinessSuite.Application.Wiki
@using GwsBusinessSuite.Domain.Entities
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@inject IAutomationWorkflowService WorkflowService
@inject IAutomationExecutionService ExecutionService
@inject IAutomationNodeRegistry NodeRegistry
@inject IAutomationCredentialService CredentialService
@inject IAutomationTemplateService TemplateService
@inject ISentinelAccessService AccessService
@inject ICurrentUserAccessor CurrentUserAccessor
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ILogger<AutomationEditor> Logger

<PageTitle>@(_view?.Name ?? "Workflow Editor")</PageTitle>

@if (_loading)
{
    <div class="text-secondary py-5 text-center"><span class="spinner-border spinner-border-sm me-2"></span>Opening workflow…</div>
}
else if (_accessDenied)
{
    <div class="alert alert-danger">You don't have access to this workflow. Ask an admin to share it with you.</div>
}
else if (_view is null)
{
    <div class="alert alert-danger">Workflow not found.</div>
}
else
{
    <div class="automation-shell">
        <header class="automation-toolbar">
            <div class="d-flex align-items-center gap-2 min-w-0">
                <button class="btn btn-sm btn-light" title="Back to workflows" @onclick="Back"><i class="bi bi-arrow-left"></i></button>
                <div class="min-w-0">
                    <input class="automation-title" @bind="_name" aria-label="Workflow name" />
                    <div class="small text-secondary">Version @_view.CurrentVersion · @_view.Status</div>
                </div>
            </div>
            <div class="d-flex flex-wrap align-items-center justify-content-end gap-2">
                <button class="btn btn-sm btn-outline-secondary" @onclick="SaveMetadata" disabled="@_busy"><i class="bi bi-floppy me-1"></i>Save</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="Validate" disabled="@_busy"><i class="bi bi-check2-circle me-1"></i>Validate</button>
                <a class="btn btn-sm btn-outline-secondary" href="/admin/api/automation/@WorkflowId/export.json"><i class="bi bi-download me-1"></i>Export</a>
                <button class="btn btn-sm btn-outline-secondary" @onclick="OpenSaveTemplate" disabled="@_busy"><i class="bi bi-collection me-1"></i>Save as template</button>
                <div class="btn-group" role="group" aria-label="Undo and redo">
                    <button class="btn btn-sm btn-outline-secondary" title="Undo (Ctrl+Z)" disabled="@(_busy || _undoStack.Count == 0)" @onclick="UndoAsync"><i class="bi bi-arrow-counterclockwise"></i></button>
                    <button class="btn btn-sm btn-outline-secondary" title="Redo (Ctrl+Y)" disabled="@(_busy || _redoStack.Count == 0)" @onclick="RedoAsync"><i class="bi bi-arrow-clockwise"></i></button>
                </div>
                <div class="btn-group" role="group" aria-label="Copy and paste">
                    <button class="btn btn-sm btn-outline-secondary" title="Copy selected (Ctrl+C)" disabled="@(_busy || SelectedNodeIds.Count == 0)" @onclick="CopySelection"><i class="bi bi-clipboard"></i></button>
                    <button class="btn btn-sm btn-outline-secondary" title="Paste (Ctrl+V)" disabled="@(_busy || _clipboardNodes.Count == 0)" @onclick="PasteClipboardAsync"><i class="bi bi-clipboard-check"></i></button>
                </div>
                @* Edits still persist immediately, so this reports state rather than offering a
                   Save button that would imply they do not. *@
                <span class="editor-save-state">@SaveStateText</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="Publish" disabled="@_busy" title="Save a runnable version without going live - lets Run workflow test it before real triggers can fire it"><i class="bi bi-cloud-arrow-up me-1"></i>Publish</button>
                <button class="btn btn-sm @(_view.Status == AutomationWorkflowStatuses.Active ? "btn-success" : "btn-outline-success")" @onclick="Activate" disabled="@_busy">
                    <i class="bi @(_view.Status == AutomationWorkflowStatuses.Active ? "bi-toggle-on" : "bi-toggle-off") me-1"></i>@(_view.Status == AutomationWorkflowStatuses.Active ? "Active" : "Activate")
                </button>
                <button class="btn btn-sm btn-primary" @onclick="RunWorkflow" disabled="@(_busy || _view.CurrentVersion == 0)"><i class="bi bi-play-fill me-1"></i>Run workflow</button>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="automation-notice alert @(_messageIsError ? "alert-danger" : "alert-info") mb-0 rounded-0">@_message</div>
        }

        <div class="automation-workspace">
            <aside class="automation-palette">
                <div class="palette-heading">Nodes</div>
                <input class="form-control form-control-sm mb-3" @bind="_paletteSearch" @bind:event="oninput" placeholder="Search nodes" aria-label="Search nodes" />
                @foreach (var group in FilteredDefinitions.GroupBy(definition => definition.Category))
                {
                    <div class="palette-category">@group.Key</div>
                    @foreach (var definition in group)
                    {
                        @* Click still adds (and is the keyboard path); the data attributes let the
                           canvas script drag the same entry to a chosen point instead. *@
                        <button type="button" class="palette-node" @onclick="() => AddNode(definition)" title="@definition.Description"
                                data-palette-node="@definition.TypeKey" data-palette-version="@definition.Version"
                                data-palette-label="@definition.DisplayName">
                            <span class="palette-node-icon"><i class="bi @definition.IconClass"></i></span>
                            <span><strong>@definition.DisplayName</strong><small>@definition.Description</small></span>
                        </button>
                    }
                }
            </aside>

            <main class="automation-canvas-viewport">
                <div class="automation-canvas" @ref="_canvas" tabindex="0" @onclick="ClearSelection" @onkeydown="HandleCanvasKeyDown">
                    @* Connections are objects you can point at, not decoration. Each one draws
                       twice: a wide transparent stroke that catches the pointer (a 2px line is
                       nearly impossible to hit), and the visible line on top. The layer no longer
                       sets pointer-events:none, so the hit-strokes can actually receive events. *@
                    <svg class="automation-connections" width="2400" height="1400">
                        @foreach (var connection in _view.Connections)
                        {
                            var path = ConnectionPath(connection);
                            var isSelected = connection.Id == _selectedConnectionId;
                            <g class="automation-connection-group @(isSelected ? "is-selected" : "")">
                                <path d="@path" class="automation-connection-hit"
                                      @onclick="() => SelectConnection(connection.Id)" @onclick:stopPropagation="true">
                                    <title>@NodeName(connection.SourceNodeId) → @NodeName(connection.TargetNodeId) · click to select, Delete to remove</title>
                                </path>
                                <path d="@path" class="automation-connection @ConnectionClass(connection.SourceOutput)" />
                            </g>
                        }
                    </svg>
                    @* The splice control lives outside the SVG so it can be a real button with a
                       normal focus ring, rather than SVG shapes pretending to be one. *@
                    @foreach (var connection in _view.Connections)
                    {
                        var midpoint = ConnectionMidpoint(connection);
                        <button type="button" class="connection-splice @(connection.Id == _selectedConnectionId ? "is-selected" : "")"
                                style="left:@(midpoint.X.ToString(CultureInfo.InvariantCulture))px; top:@(midpoint.Y.ToString(CultureInfo.InvariantCulture))px"
                                title="Insert a node here" aria-label="Insert a node between @NodeName(connection.SourceNodeId) and @NodeName(connection.TargetNodeId)"
                                @onclick="() => BeginSplice(connection.Id)" @onclick:stopPropagation="true">
                            <i class="bi bi-plus"></i>
                        </button>
                    }

                    @* Endpoint grab handles. Each carries the identity of the end that is NOT
                       moving, so the canvas anchors the drag there and the existing port
                       validity rules (no output-to-output, no self-connection) apply unchanged. *@
                    @foreach (var connection in _view.Connections.Where(c => c.Id == _selectedConnectionId))
                    {
                        var sourceEnd = ConnectionEndpoint(connection, sourceEnd: true);
                        var targetEnd = ConnectionEndpoint(connection, sourceEnd: false);
                        <span class="connection-endpoint" title="Drag to move this end of the connection"
                              style="left:@(sourceEnd.X.ToString(CultureInfo.InvariantCulture))px; top:@(sourceEnd.Y.ToString(CultureInfo.InvariantCulture))px"
                              data-rewire="source" data-rewire-connection="@connection.Id"
                              data-port="input" data-port-node="@connection.TargetNodeId" data-port-name="@connection.TargetInput"></span>
                        <span class="connection-endpoint" title="Drag to move this end of the connection"
                              style="left:@(targetEnd.X.ToString(CultureInfo.InvariantCulture))px; top:@(targetEnd.Y.ToString(CultureInfo.InvariantCulture))px"
                              data-rewire="target" data-rewire-connection="@connection.Id"
                              data-port="output" data-port-node="@connection.SourceNodeId" data-port-name="@connection.SourceOutput"></span>
                    }
                    @foreach (var node in _view.Nodes)
                    {
                        var definition = NodeRegistry.Find(node.TypeKey, node.TypeVersion);
                        <article class="automation-node @(node.Id == _selectedNodeId ? "is-selected" : "") @(_multiSelectedNodeIds.Contains(node.Id) ? "is-multi-selected" : "") @(node.IsDisabled ? "is-disabled" : "")"
                                 data-automation-node="@node.Id" style="left:@(NodePosition(node).X.ToString(CultureInfo.InvariantCulture))px; top:@(NodePosition(node).Y.ToString(CultureInfo.InvariantCulture))px"
                                 @onclick="e => SelectNode(node.Id, e)" @onclick:stopPropagation="true">
                            @* data-port carries everything the canvas script needs to start and
                               land a wire. Before this the ports rendered but nothing read them,
                               so they looked draggable and were not. *@
                            <div class="node-output node-output-main" title="Drag to connect"
                                 data-port="output" data-port-node="@node.Id" data-port-name="main"></div>
                            @if (definition?.Outputs.Contains("true") == true)
                            {
                                <div class="node-output node-output-true" title="True output — drag to connect"
                                     data-port="output" data-port-node="@node.Id" data-port-name="true"></div>
                                <div class="node-output node-output-false" title="False output — drag to connect"
                                     data-port="output" data-port-node="@node.Id" data-port-name="false"></div>
                            }
                            <div class="node-input" title="Input"
                                 data-port="input" data-port-node="@node.Id" data-port-name="main"></div>
                            <div class="node-icon"><i class="bi @(definition?.IconClass ?? "bi-box")"></i></div>
                            <div class="node-copy"><strong>@node.Name</strong><small>@(definition?.DisplayName ?? node.TypeKey)</small></div>
                            @if (node.RetryOnFail) { <i class="bi bi-arrow-repeat node-policy" title="Retries enabled"></i> }
                        </article>
                    }
                </div>
                <div class="canvas-view-controls" role="group" aria-label="Canvas view">
                    <button type="button" title="Zoom out" aria-label="Zoom out" @onclick="ZoomOutAsync"><i class="bi bi-dash-lg"></i></button>
                    <button type="button" title="Fit workflow to view" aria-label="Fit workflow to view" @onclick="FitToContentAsync"><i class="bi bi-arrows-angle-contract"></i></button>
                    <button type="button" title="Reset to 100%" aria-label="Reset zoom to 100 percent" @onclick="ResetViewAsync"><i class="bi bi-aspect-ratio"></i></button>
                    <button type="button" title="Zoom in" aria-label="Zoom in" @onclick="ZoomInAsync"><i class="bi bi-plus-lg"></i></button>
                </div>
                <div class="canvas-help"><i class="bi bi-arrows-move me-1"></i>Drag to select · Space or middle-drag to pan · scroll to zoom · Ctrl/Shift+click to multi-select · Ctrl+C/V copy · Ctrl+Z/Y undo</div>
                @if (_view.Nodes.Count > 0)
                {
                    <div class="automation-minimap" aria-hidden="true" title="Workflow overview">
                        @foreach (var node in _view.Nodes)
                        {
                            <span class="automation-minimap-dot @(node.Id == _selectedNodeId || _multiSelectedNodeIds.Contains(node.Id) ? "is-selected" : "")"
                                  style="left:@(MinimapPercent(NodePosition(node).X, horizontal: true))%; top:@(MinimapPercent(NodePosition(node).Y, horizontal: false))%"></span>
                        }
                    </div>
                }
            </main>

            <aside class="automation-inspector">
                @if (_selectedNode is null)
                {
                    <div class="inspector-empty">
                        <i class="bi bi-sliders2 fs-3"></i><h2 class="h6 mt-2">Nothing selected</h2><p>Select a node to edit its parameters and execution policy.</p>
                    </div>
                }
                else
                {
                    <div class="inspector-heading"><span>Node settings</span><button class="btn btn-sm btn-light" title="Close node settings" aria-label="Close node settings" @onclick="ClearSelection"><i class="bi bi-x-lg"></i></button></div>
                    <label class="form-label small fw-semibold">Name</label>
                    <input class="form-control form-control-sm mb-3" @bind="_nodeName" />
                    <label class="form-label small fw-semibold">Parameters (JSON)</label>
                    <textarea class="form-control form-control-sm font-monospace mb-2" rows="12" @bind="_nodeParameters"></textarea>
                    <div class="small text-secondary mb-3">Use expressions such as <code>{{ExpressionExample}}</code>.</div>
                    <label class="form-label small fw-semibold">Notes</label>
                    <ProfessionalWysiwygEditor @bind-Value="_nodeNotes" Compact="true" MinHeight="90px" AriaLabel="Node notes" CssClass="mb-3" />
                    <label class="form-label small fw-semibold">Credential</label>
                    <select class="form-select form-select-sm mb-3" @bind="_nodeCredentialId">
                        <option value="">No credential</option>
                        @foreach (var credential in _credentials) { <option value="@credential.Id">@credential.Name (@credential.TypeKey)</option> }
                    </select>
                    <div class="form-check mb-2"><input id="nodeDisabled" class="form-check-input" type="checkbox" @bind="_nodeDisabled" /><label for="nodeDisabled" class="form-check-label small">Disabled</label></div>
                    <div class="form-check mb-2"><input id="nodeContinue" class="form-check-input" type="checkbox" @bind="_nodeContinueOnFail" /><label for="nodeContinue" class="form-check-label small">Continue on failure</label></div>
                    <div class="form-check mb-3"><input id="nodeRetry" class="form-check-input" type="checkbox" @bind="_nodeRetryOnFail" /><label for="nodeRetry" class="form-check-label small">Retry on failure</label></div>
                    @if (_nodeRetryOnFail)
                    {
                        <div class="row g-2 mb-3"><div class="col-6"><label class="form-label small">Max tries</label><input class="form-control form-control-sm" type="number" min="1" max="10" @bind="_nodeMaxTries" /></div><div class="col-6"><label class="form-label small">Wait (ms)</label><input class="form-control form-control-sm" type="number" min="0" max="60000" @bind="_nodeWaitMs" /></div></div>
                    }
                    <label class="form-label small fw-semibold">Timeout (ms, 0 = none)</label>
                    <input class="form-control form-control-sm mb-3" type="number" min="0" max="600000" @bind="_nodeTimeoutMs" />
                    <div class="d-grid gap-2"><button class="btn btn-sm btn-primary" @onclick="SaveSelectedNode" disabled="@_busy">Save node</button><button class="btn btn-sm btn-outline-danger" @onclick="DeleteSelectedNode" disabled="@_busy">Delete node</button></div>
                }
            </aside>
        </div>

        <section class="automation-bottom-panel">
            <div class="bottom-panel-tabs">
                <button class="@(_bottomTab == "connections" ? "active" : "")" @onclick="ShowConnections">Connections</button>
                <button class="@(_bottomTab == "runs" ? "active" : "")" @onclick="ShowRuns">Executions <span>@_view.RecentExecutions.Count</span></button>
                <button class="@(_bottomTab == "versions" ? "active" : "")" @onclick="ShowVersions">Versions</button>
                <button class="@(_bottomTab == "settings" ? "active" : "")" @onclick="ShowSettings">Workflow settings</button>
            </div>
            <div class="bottom-panel-body">
                @if (_bottomTab == "connections")
                {
                    <div class="connection-builder">
                        <select class="form-select form-select-sm" @bind="_connectionSource"><option value="">Source node</option>@foreach (var node in _view.Nodes) { <option value="@node.Id">@node.Name</option> }</select>
                        <select class="form-select form-select-sm" @bind="_connectionOutput"><option value="main">main</option><option value="true">true</option><option value="false">false</option></select>
                        <i class="bi bi-arrow-right"></i>
                        <select class="form-select form-select-sm" @bind="_connectionTarget"><option value="">Target node</option>@foreach (var node in _view.Nodes) { <option value="@node.Id">@node.Name</option> }</select>
                        <input class="form-control form-control-sm" @bind="_connectionTargetInput" placeholder="Target input" aria-label="Target input label" />
                        <button class="btn btn-sm btn-outline-primary" @onclick="AddConnection" disabled="@_busy">Connect</button>
                    </div>
                    <div class="connection-list">
                        @foreach (var connection in _view.Connections)
                        {
                            <div><span>@NodeName(connection.SourceNodeId)</span><code>@connection.SourceOutput</code><i class="bi bi-arrow-right"></i><code>@connection.TargetInput</code><span>@NodeName(connection.TargetNodeId)</span><button class="btn btn-sm btn-link text-danger" @onclick="() => DeleteConnection(connection.Id)"><i class="bi bi-x-lg"></i></button></div>
                        }
                    </div>
                }
                else if (_bottomTab == "runs")
                {
                    @if (_latestExecution is not null)
                    {
                        @if (_latestExecution.Mode == AutomationExecutionModes.Replay)
                        {
                            <div class="alert alert-info py-2 px-3 mb-2 small">
                                <i class="bi bi-clock-history me-1"></i><strong>Time-travel replay</strong> - a sandboxed
                                dry run against the current published graph; @_latestExecution.Nodes.Count(node => node.IsSimulated)
                                node(s) with a real side effect were simulated from their original recorded output, not
                                actually run.
                            </div>
                        }
                        <div class="execution-result @(_latestExecution.Status == AutomationExecutionStatuses.Succeeded ? "is-success" : _latestExecution.Status == AutomationExecutionStatuses.Waiting ? "is-waiting" : "is-failure")">
                            <strong>@_latestExecution.Status</strong><span>@_latestExecution.ErrorMessage</span><pre>@_latestExecution.OutputJson</pre>
                        </div>
                        @if (_latestExecution.Status == AutomationExecutionStatuses.Waiting && _latestExecution.Wait is not null)
                        {
                            <div class="execution-wait-actions mb-3">
                                @if (_latestExecution.Wait.WaitingNodeTypeKey == "core.approval")
                                {
                                    <span class="me-2">Waiting for approval at <strong>@_latestExecution.Wait.WaitingNodeName</strong></span>
                                    <button class="btn btn-sm btn-success me-1" @onclick="() => ResolveApproval(true)" disabled="@_busy">Approve</button>
                                    <button class="btn btn-sm btn-outline-danger me-1" @onclick="() => ResolveApproval(false)" disabled="@_busy">Reject</button>
                                }
                                else
                                {
                                    <span class="me-2">Waiting at <strong>@_latestExecution.Wait.WaitingNodeName</strong>@(_latestExecution.Wait.ResumeAt is not null ? $" until {FormatDate(_latestExecution.Wait.ResumeAt)}" : " for a resume webhook")</span>
                                }
                                <button class="btn btn-sm btn-outline-secondary" @onclick="CancelLatestExecution" disabled="@_busy">Cancel</button>
                            </div>
                        }
                        else if (_latestExecution.Status == AutomationExecutionStatuses.Running)
                        {
                            <div class="execution-wait-actions mb-3"><button class="btn btn-sm btn-outline-secondary" @onclick="CancelLatestExecution" disabled="@_busy">Cancel</button></div>
                        }
                        else if (_latestExecution.Status == AutomationExecutionStatuses.Failed)
                        {
                            <div class="execution-wait-actions mb-3"><button class="btn btn-sm btn-outline-warning" @onclick="RetryFromFailedNode" disabled="@_busy"><i class="bi bi-arrow-repeat me-1"></i>Retry from failed node</button></div>
                        }
                    }
                    <div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>Status</th><th>Mode</th><th>Started</th><th>Duration</th><th></th></tr></thead><tbody>
                        @foreach (var run in _view.RecentExecutions)
                        {
                            <tr><td><span class="badge @(run.Status == AutomationExecutionStatuses.Succeeded ? "text-bg-success" : run.Status == AutomationExecutionStatuses.Failed ? "text-bg-danger" : run.Status == AutomationExecutionStatuses.Waiting ? "text-bg-warning" : "text-bg-secondary")">@run.Status</span></td><td>@run.Mode</td><td>@FormatDate(run.StartedAt)</td><td>@Duration(run.StartedAt, run.FinishedAt)</td><td class="text-end"><button class="btn btn-sm btn-link" @onclick="() => LoadExecution(run.Id)">Inspect</button><button class="btn btn-sm btn-link" title="Re-run this execution's recorded input against the current published graph as a sandboxed dry run" disabled="@_busy" @onclick="() => ReplayExecution(run.Id)">Replay</button></td></tr>
                        }
                    </tbody></table></div>
                }
                else if (_bottomTab == "versions")
                {
                    <div class="d-flex flex-wrap align-items-end gap-2 mb-3">
                        <div><label class="form-label small fw-semibold">Compare from</label><select class="form-select form-select-sm" @bind="_diffFromVersion"><option value="0">Version…</option>@foreach (var version in _versions) { <option value="@version.VersionNumber">v@version.VersionNumber</option> }</select></div>
                        <div><label class="form-label small fw-semibold">to</label><select class="form-select form-select-sm" @bind="_diffToVersion"><option value="0">Version…</option>@foreach (var version in _versions) { <option value="@version.VersionNumber">v@version.VersionNumber</option> }</select></div>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ShowDiff" disabled="@(_busy || _diffFromVersion == 0 || _diffToVersion == 0)">Show diff</button>
                    </div>
                    @if (_diff is not null)
                    {
                        <div class="version-diff mb-3">
                            @if (_diff.AddedNodes.Count == 0 && _diff.RemovedNodes.Count == 0 && _diff.ModifiedNodes.Count == 0 && _diff.AddedConnections.Count == 0 && _diff.RemovedConnections.Count == 0)
                            {
                                <p class="text-secondary mb-0">No differences between v@_diffFromVersion and v@_diffToVersion.</p>
                            }
                            else
                            {
                                @foreach (var node in _diff.AddedNodes) { <div class="text-success"><i class="bi bi-plus-circle me-1"></i>Added node "@node.Name" (@node.TypeKey)</div> }
                                @foreach (var node in _diff.RemovedNodes) { <div class="text-danger"><i class="bi bi-dash-circle me-1"></i>Removed node "@node.Name" (@node.TypeKey)</div> }
                                @foreach (var change in _diff.ModifiedNodes) { <div class="text-warning-emphasis"><i class="bi bi-pencil-square me-1"></i>Changed node "@change.Name"</div> }
                                @foreach (var connection in _diff.AddedConnections) { <div class="text-success"><i class="bi bi-plus-circle me-1"></i>Added connection @NodeName(connection.SourceNodeId) → @NodeName(connection.TargetNodeId)</div> }
                                @foreach (var connection in _diff.RemovedConnections) { <div class="text-danger"><i class="bi bi-dash-circle me-1"></i>Removed connection @NodeName(connection.SourceNodeId) → @NodeName(connection.TargetNodeId)</div> }
                            }
                        </div>
                    }
                    <div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>Version</th><th>Published</th><th>Change summary</th><th>Nodes</th><th></th></tr></thead><tbody>
                        @foreach (var version in _versions)
                        {
                            <tr><td>v@version.VersionNumber</td><td>@FormatDate(version.CreatedAt)</td><td>@version.ChangeSummary</td><td>@version.NodeCount</td><td class="text-end"><button class="btn btn-sm btn-link text-warning" disabled="@_busy" @onclick="() => RestoreVersion(version.VersionNumber)">Restore to draft</button></td></tr>
                        }
                    </tbody></table></div>
                }
                else
                {
                    <div class="row g-3"><div class="col-md-5"><label class="form-label small fw-semibold">Description</label><ProfessionalWysiwygEditor @bind-Value="_description" Compact="true" MinHeight="110px" AriaLabel="Workflow description" /></div><div class="col-md-4"><label class="form-label small fw-semibold">Tags</label><input class="form-control form-control-sm" @bind="_tags" placeholder="sales, notifications" /></div><div class="col-md-3"><label class="form-label small fw-semibold">Manual input JSON</label><textarea class="form-control form-control-sm font-monospace" rows="3" @bind="_runInput"></textarea></div></div>
                    <div class="form-check mt-3">
                        <input id="allowDownstreamTriggers" class="form-check-input" type="checkbox" checked="@_allowDownstreamTriggers" disabled="@_busy" @onchange="ToggleAllowDownstreamTriggers" />
                        <label for="allowDownstreamTriggers" class="form-check-label small">
                            Allow this workflow's database writes to trigger other automations
                            <span class="text-secondary d-block">Off by default to prevent automation loops. Turn on only if you understand a downstream Database Row Changed trigger reacting to this workflow's own writes is what you want.</span>
                        </label>
                    </div>
                    @if (_isAdmin)
                    {
                        <hr class="my-4" />
                        <h3 class="h6 fw-bold">Share this workflow</h3>
                        <p class="text-secondary small">Grant an Author/Contributor teammate full access to just this workflow, without making them an Admin. They still need their own account - this doesn't create one.</p>
                        <div class="input-group input-group-sm mb-2">
                            <input class="form-control" @bind="_shareUsername" placeholder="username" />
                            <button type="button" class="btn btn-outline-warning" disabled="@(_busy || string.IsNullOrWhiteSpace(_shareUsername))" @onclick="GrantWorkflowAccess">Grant access</button>
                        </div>
                        @foreach (var permission in _workflowPermissions)
                        {
                            <div class="d-flex align-items-center justify-content-between border rounded px-2 py-1 mb-1 small">
                                <span><i class="bi bi-person-circle me-1"></i>@permission.Username <span class="text-secondary">&middot; @permission.AccessLevel</span></span>
                                <button type="button" class="btn btn-sm btn-link text-danger" disabled="@_busy" @onclick="() => RevokeWorkflowAccess(permission.Id)">Remove</button>
                            </div>
                        }
                    }
                    <hr class="my-4" />
                    <h3 class="h6 fw-bold">Public status page</h3>
                    <p class="text-secondary small">Share a read-only status page externally (e.g. with a client or affiliate) - it shows this workflow's name, description, status, and recent run history only, never node configuration, credentials, or run input/output data.</p>
                    <div class="row g-2 align-items-end mb-2">
                        <div class="col-md-5"><label class="form-label small mb-1">Expires (optional)</label><input type="datetime-local" class="form-control form-control-sm" @bind="_shareExpiresAt" /></div>
                        <div class="col-md-4"><label class="form-label small mb-1">Password (optional)</label><input type="text" class="form-control form-control-sm" @bind="_sharePassword" placeholder="Require a password to view" /></div>
                        <div class="col-md-3"><button class="btn btn-sm btn-outline-warning w-100" disabled="@_busy" @onclick="CreatePublicShare">Create link</button></div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_newPublicShareUrl))
                    {
                        <div class="input-group input-group-sm mb-2">
                            <input class="form-control" value="@_newPublicShareUrl" readonly />
                            <button type="button" class="btn btn-outline-secondary" @onclick="CopyPublicShareUrl">Copy</button>
                        </div>
                        <div class="small text-warning mb-2">Copy this link now. The secret token is not stored in plaintext.</div>
                    }
                    @foreach (var share in _publicShares.Where(item => !item.IsRevoked))
                    {
                        <div class="d-flex align-items-center justify-content-between border rounded px-2 py-1 mb-1 small">
                            <span><i class="bi bi-globe2 me-1"></i>Public link @if (share.RequiresPassword) { <i class="bi bi-lock-fill ms-1" title="Password protected"></i> } <span class="text-secondary">&middot; @(share.ViewCount == 1 ? "1 view" : $"{share.ViewCount} views")</span></span>
                            <button type="button" class="btn btn-sm btn-link text-danger" disabled="@_busy" @onclick="() => RevokePublicShare(share.Id)">Revoke</button>
                        </div>
                    }
                }
            </div>
        </section>
    </div>

    @if (_showSaveTemplate)
    {
        <div class="modal-backdrop fade show"></div>
        <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true">
            <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
                <div class="modal-header"><h2 class="modal-title h5">Save as template</h2><button class="btn-close" @onclick="CloseSaveTemplate" aria-label="Close"></button></div>
                <div class="modal-body">
                    <label class="form-label fw-semibold" for="templateName">Template name</label>
                    <input id="templateName" class="form-control mb-3" @bind="_templateName" />
                    <label class="form-label fw-semibold" for="templateDescription">Description</label>
                    <ProfessionalWysiwygEditor @bind-Value="_templateDescription" Compact="true" MinHeight="110px" AriaLabel="Template description" />
                </div>
                <div class="modal-footer"><button class="btn btn-outline-secondary" @onclick="CloseSaveTemplate">Cancel</button><button class="btn btn-primary" @onclick="SaveAsTemplate" disabled="@_busy">Save template</button></div>
            </div></div>
        </div>
    }
}

