    // Sharing and permissions were refetched on every graph edit - a second round trip per
    // gesture for data that only changes when someone actually edits sharing. They are loaded
    // once and refreshed by the handful of operations that can change them.
    private Task Reload() => ReloadAsync(includeAccess: false);

    private async Task ReloadAsync(bool includeAccess)
    {
        try
        {
            _view = await WorkflowService.GetAsync(WorkflowId);
            _movedPositions.Clear();
            if (_view is not null) { _name = _view.Name; _description = _view.Description; _tags = _view.TagsCsv; _allowDownstreamTriggers = _view.AllowDownstreamAutomationTriggers; }
            if (includeAccess)
            {
                var access = await AccessService.GetAccessAsync(WorkflowId, isDatabase: false);
                _publicShares = access.Shares.ToList();
                _workflowPermissions = access.Permissions.ToList();
            }
        }
        catch (Exception ex) { Fail(ex, "Unable to open workflow."); }
        finally { _loading = false; }
    }

    [JSInvokable]
    public async Task UpdateNodePosition(string nodeId, double x, double y)
    {
        if (!Guid.TryParse(nodeId, out var id)) return;
        try
        {
            await WorkflowService.MoveNodeAsync(WorkflowId, id, x, y);
            // No reload: the canvas already moved the node, so refetching the graph would
            // re-render it in exactly the place it is already in. The in-memory view is patched
            // instead so later reads (fit-to-content, the minimap, connection geometry) agree
            // with what is on screen. AutomationNodeView is an init-only record, so the node is
            // replaced rather than mutated.
            _movedPositions[id] = (x, y);
            MarkSaved();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) { Fail(ex, "Unable to save node position."); }
    }

    // Called when a wire dragged between two ports is released on a valid target. The canvas
    // already rejects the obvious cases mid-drag (output-to-output, self-connection) so the
    // gesture shows its own validity; these checks are the authority rather than the feedback,
    // because the canvas can be stale by the time the drop lands.
    [JSInvokable]
    public async Task ConnectPorts(string sourceNodeId, string sourceOutput, string targetNodeId, string targetInput)
    {
        if (!Guid.TryParse(sourceNodeId, out var source) || !Guid.TryParse(targetNodeId, out var target)) return;
        if (source == target) return;
        if (_view is null) return;

        // Re-adding an edge that already exists would create a duplicate the executor would then
        // traverse twice, running the whole downstream branch twice per item.
        var alreadyConnected = _view.Connections.Any(c =>
            c.SourceNodeId == source && c.TargetNodeId == target
            && string.Equals(c.SourceOutput, sourceOutput, StringComparison.OrdinalIgnoreCase)
            && string.Equals(c.TargetInput, targetInput, StringComparison.OrdinalIgnoreCase));
        if (alreadyConnected)
        {
            Show("Those ports are already connected.", true);
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            await WorkflowService.AddConnectionAsync(WorkflowId, source, sourceOutput, target, targetInput);
            await Reload();
            _message = $"Connected {NodeName(source)} to {NodeName(target)}.";
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) { Fail(ex, "Unable to connect those nodes."); }
    }

    private void SelectNode(Guid id)
    {
        _selectedNodeId = id;
        var node = _selectedNode;
        if (node is null) return;
        _nodeName = node.Name; _nodeParameters = node.ParametersJson; _nodeNotes = node.Notes; _nodeDisabled = node.IsDisabled;
        _nodeCredentialId = node.CredentialId;
        _nodeContinueOnFail = node.ContinueOnFail; _nodeRetryOnFail = node.RetryOnFail; _nodeMaxTries = node.MaxTries; _nodeWaitMs = node.WaitBetweenTriesMs; _nodeTimeoutMs = node.TimeoutMs;
    }
    // Plain click: single-select (existing inspector behavior, clears any multi-selection).
    // Ctrl/Shift+click: toggles the node into/out of the multi-selection, used by Copy, without
    // disturbing whichever node the inspector currently shows.
    private void SelectNode(Guid id, MouseEventArgs e)
    {
        if (e.CtrlKey || e.ShiftKey)
        {
            if (!_multiSelectedNodeIds.Remove(id)) _multiSelectedNodeIds.Add(id);
            return;
        }
        _multiSelectedNodeIds.Clear();
        SelectNode(id);
    }
    private void ClearSelection() { _selectedNodeId = null; _multiSelectedNodeIds.Clear(); _selectedConnectionId = null; _spliceConnectionId = null; _pendingConnect = null; }

    private void SelectConnection(Guid connectionId)
    {
        // One selection at a time: a node and an edge being selected together would make Delete
        // ambiguous, which is exactly the kind of thing that deletes the wrong object.
        _selectedNodeId = null;
        _multiSelectedNodeIds.Clear();
        _selectedConnectionId = connectionId;
        _spliceConnectionId = null;
    }

    // Midpoint of the same cubic ConnectionPath draws, so the splice button sits on the wire
    // rather than near it. At t=0.5 the Bezier reduces to this weighting of its control points.
    private (double X, double Y) ConnectionMidpoint(AutomationConnectionView connection)
    {
        var source = _view?.Nodes.FirstOrDefault(node => node.Id == connection.SourceNodeId);
        var target = _view?.Nodes.FirstOrDefault(node => node.Id == connection.TargetNodeId);
        if (source is null || target is null) return (0, 0);

        var (sourceX, sourceY) = NodePosition(source);
        var (targetX, targetY) = NodePosition(target);
        var sx = sourceX + 196;
        var sy = sourceY + (connection.SourceOutput == "true" ? 38 : connection.SourceOutput == "false" ? 72 : 55);
        var tx = targetX;
        var ty = targetY + 55;
        var bend = Math.Max(70, Math.Abs(tx - sx) * .45);
        var x = (sx + 3 * (sx + bend) + 3 * (tx - bend) + tx) / 8d;
        var y = (sy + 3 * sy + 3 * ty + ty) / 8d;
        return (x - 11, y - 11); // centre the 22px button on the point
    }

    // The two ends of a connection, matching ConnectionPath's own anchor maths. Returned as the
    // handle's top-left so the 14px grab target sits centred on the wire's end.
    private (double X, double Y) ConnectionEndpoint(AutomationConnectionView connection, bool sourceEnd)
    {
        var source = _view?.Nodes.FirstOrDefault(node => node.Id == connection.SourceNodeId);
        var target = _view?.Nodes.FirstOrDefault(node => node.Id == connection.TargetNodeId);
        if (source is null || target is null) return (0, 0);

        // Offset outward along the wire by 22px. A handle centred exactly on the port would sit on
        // top of it and swallow pointer-downs meant to start a new connection from that port -
        // which is how a port with an existing connection became un-draggable.
        const double offset = 22;
        var (sourceX, sourceY) = NodePosition(source); var (targetX, targetY) = NodePosition(target);
        return sourceEnd
            ? (sourceX + 196 - 7 + offset,
               sourceY + (connection.SourceOutput == "true" ? 38 : connection.SourceOutput == "false" ? 72 : 55) - 7)
            : (targetX - 7 - offset, targetY + 55 - 7);
    }

    // Moving one end of an existing connection to a different port. The canvas anchors the drag
    // at the end that is NOT moving and reuses the same validity rules as drawing a new wire.
    [JSInvokable]
    public async Task RewireConnection(string connectionId, string movedEnd, string newNodeId, string newPortName)
    {
        if (!Guid.TryParse(connectionId, out var id) || !Guid.TryParse(newNodeId, out var newNode)) return;
        var connection = _view?.Connections.FirstOrDefault(c => c.Id == id);
        if (connection is null) return;

        var movingSource = string.Equals(movedEnd, "source", StringComparison.OrdinalIgnoreCase);
        var sourceNodeId = movingSource ? newNode : connection.SourceNodeId;
        var sourceOutput = movingSource ? newPortName : connection.SourceOutput;
        var targetNodeId = movingSource ? connection.TargetNodeId : newNode;
        var targetInput = movingSource ? connection.TargetInput : newPortName;

        if (sourceNodeId == targetNodeId) return;

        // Dropping an endpoint back where it started is a no-op, not an error - the user simply
        // changed their mind mid-drag, and deleting/recreating the same edge would churn the graph.
        if (sourceNodeId == connection.SourceNodeId && targetNodeId == connection.TargetNodeId
            && string.Equals(sourceOutput, connection.SourceOutput, StringComparison.OrdinalIgnoreCase)
            && string.Equals(targetInput, connection.TargetInput, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        var duplicate = _view!.Connections.Any(c =>
            c.Id != id && c.SourceNodeId == sourceNodeId && c.TargetNodeId == targetNodeId
            && string.Equals(c.SourceOutput, sourceOutput, StringComparison.OrdinalIgnoreCase)
            && string.Equals(c.TargetInput, targetInput, StringComparison.OrdinalIgnoreCase));
        if (duplicate)
        {
            Show("Those ports are already connected.", true);
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            // Add before delete, same ordering as the splice: a failure part-way leaves both
            // edges rather than none.
            await WorkflowService.AddConnectionAsync(WorkflowId, sourceNodeId, sourceOutput, targetNodeId, targetInput);
            await WorkflowService.DeleteConnectionAsync(WorkflowId, id);
            _selectedConnectionId = null;
            await Reload();
            _message = $"Rewired to {NodeName(movingSource ? sourceNodeId : targetNodeId)}.";
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) { Fail(ex, "Unable to rewire that connection."); }
    }

    // A node dragged from the palette onto the canvas. Landing where the pointer released is the
    // whole point - the click-to-add path puts nodes at a cycling position where they pile up.
    // Rubber-band selection result. Additive when a modifier was held during the drag, matching
    // how Ctrl/Shift+click already extends the selection here.
    [JSInvokable]
    public async Task SelectNodesInRegion(string[] nodeIds, bool additive)
    {
        if (!additive) _multiSelectedNodeIds.Clear();
        foreach (var raw in nodeIds)
        {
            if (Guid.TryParse(raw, out var id)) _multiSelectedNodeIds.Add(id);
        }

        // A marquee selects a set, so the single-node inspector selection is cleared - leaving
        // both would make Delete and the inspector disagree about what is selected.
        _selectedNodeId = null;
        _selectedConnectionId = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ZoomInAsync() => await InvokeModuleAsync("zoomIn");
    private async Task ZoomOutAsync() => await InvokeModuleAsync("zoomOut");
    private async Task FitToContentAsync() => await InvokeModuleAsync("fitToContent");
    private async Task ResetViewAsync() => await InvokeModuleAsync("resetView");

    private async Task InvokeModuleAsync(string function)
