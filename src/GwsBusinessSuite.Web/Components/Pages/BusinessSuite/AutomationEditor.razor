    // A wire released over empty canvas. Rather than discarding the gesture, remember where it
    // ended and let the next palette pick land there already connected.
    [JSInvokable]
    public async Task BeginConnectedInsert(string sourceNodeId, string sourceOutput, double x, double y)
    {
        if (!Guid.TryParse(sourceNodeId, out var source) || _view is null) return;
        _pendingConnect = (source, sourceOutput, x, y);
        _spliceConnectionId = null;
        _selectedConnectionId = null;
        Show($"Pick a node to connect to {NodeName(source)}.");
        await InvokeAsync(StateHasChanged);
    }

    private void BeginSplice(Guid connectionId)
    {
        _spliceConnectionId = connectionId;
        _selectedConnectionId = connectionId;
        _selectedNodeId = null;
        _multiSelectedNodeIds.Clear();
        Show("Pick a node from the palette to insert it into this connection.");
    }

    private async Task DeleteSelectedConnectionAsync()
    {
        if (_selectedConnectionId is not { } id) return;
        var connection = _view?.Connections.FirstOrDefault(c => c.Id == id);
        if (connection is null) return;
        _selectedConnectionId = null;
        await Work(async () =>
        {
            await WorkflowService.DeleteConnectionAsync(WorkflowId, id);
            PushUndo(new ConnectionDeletionAction(connection));
            await Reload();
            _message = "Connection removed.";
        });
    }
    private void Back() => Navigation.NavigateTo("/admin/automation");
    private void ShowConnections() => _bottomTab = "connections";
    private void ShowRuns() => _bottomTab = "runs";
    private void ShowSettings() => _bottomTab = "settings";
    private async Task ShowVersions()
    {
        _bottomTab = "versions";
        try { _versions = (await WorkflowService.ListVersionsAsync(WorkflowId)).ToList(); }
        catch (Exception ex) { Fail(ex, "Unable to load version history."); }
    }

    private async Task AddNode(AutomationNodeDefinition definition) =>
        await Work(() => AddNodeCoreAsync(definition, null, null));

    // The one place a node gets created, shared by all four routes in: clicking the palette,
    // dragging from the palette to a point, splicing into a wire, and releasing a wire in empty
    // space. Keeping them together is what stops the wiring rules drifting between them.
    private async Task AddNodeCoreAsync(AutomationNodeDefinition definition, double? dropX, double? dropY)
    {
        var count = _view!.Nodes.Count(node => node.TypeKey == definition.TypeKey) + 1;
        var name = count == 1 ? definition.DisplayName : $"{definition.DisplayName} {count}";

        var splice = _spliceConnectionId is { } spliceId
            ? _view.Connections.FirstOrDefault(c => c.Id == spliceId)
            : null;
        var pending = _pendingConnect;

        double x, y;
        if (splice is not null)
        {
            // Centre the 196px-wide node on the wire it is being inserted into.
            var midpoint = ConnectionMidpoint(splice);
            x = Math.Max(0, midpoint.X - 98);
            y = Math.Max(0, midpoint.Y - 55);
        }
        else if (dropX is { } dx && dropY is { } dy)
        {
            x = Math.Max(0, dx);
            y = Math.Max(0, dy);
        }
        else if (pending is { } p)
        {
            // Where the wire was let go, less half the node, so it lands under the cursor rather
            // than starting at it.
            x = Math.Max(0, p.X - 98);
            y = Math.Max(0, p.Y - 55);
        }
        else
        {
            // Click-to-add has no point to work from, so it cycles - which is why nodes pile up
            // and why dragging from the palette exists.
            x = 360 + ((_view.Nodes.Count * 35) % 500);
            y = 160 + ((_view.Nodes.Count * 55) % 500);
        }

        var node = await WorkflowService.SaveNodeAsync(WorkflowId, new AutomationNodeEditor
        {
            Name = name, TypeKey = definition.TypeKey, TypeVersion = definition.Version,
            PositionX = x, PositionY = y, ParametersJson = definition.DefaultParametersJson
        });

        var outcome = $"Added {node.Name}.";

        if (splice is not null)
        {
            // Both new edges before dropping the original, so a failure part-way leaves a
            // duplicate path rather than a severed one - the recoverable direction to fail in.
            await WorkflowService.AddConnectionAsync(WorkflowId, splice.SourceNodeId, splice.SourceOutput, node.Id, "main");
            await WorkflowService.AddConnectionAsync(WorkflowId, node.Id, "main", splice.TargetNodeId, splice.TargetInput);
            await WorkflowService.DeleteConnectionAsync(WorkflowId, splice.Id);
            outcome = $"Inserted {node.Name} into the connection.";
        }
        else if (pending is { } connect)
        {
            // A trigger has no input, so wiring into one would fail - the node still gets created
            // where it was dropped, which is the useful half of the gesture.
            if (definition.IsTrigger)
            {
                outcome = $"Added {node.Name}. Triggers have no input, so it was not connected.";
            }
            else
            {
                await WorkflowService.AddConnectionAsync(WorkflowId, connect.NodeId, connect.Output, node.Id, "main");
                outcome = $"Added {node.Name}, connected from {NodeName(connect.NodeId)}.";
            }
        }

        _spliceConnectionId = null;
        _selectedConnectionId = null;
        _pendingConnect = null;

        await Reload();
        SelectNode(node.Id);
        _message = outcome;
    }

    private async Task SaveSelectedNode()
    {
        if (_selectedNode is null) return;
        await Work(async () =>
        {
            await WorkflowService.SaveNodeAsync(WorkflowId, new AutomationNodeEditor { Id = _selectedNode.Id, Name = _nodeName, TypeKey = _selectedNode.TypeKey, TypeVersion = _selectedNode.TypeVersion, PositionX = _selectedNode.PositionX, PositionY = _selectedNode.PositionY, ParametersJson = _nodeParameters, CredentialId = _nodeCredentialId, IsDisabled = _nodeDisabled, ContinueOnFail = _nodeContinueOnFail, RetryOnFail = _nodeRetryOnFail, MaxTries = _nodeMaxTries, WaitBetweenTriesMs = _nodeWaitMs, TimeoutMs = _nodeTimeoutMs, Notes = _nodeNotes });
            await Reload(); SelectNode(_selectedNodeId!.Value); _message = "Node saved.";
        });
    }
    private async Task DeleteSelectedNode()
    {
        if (_selectedNodeId is null) return;
        var nodeId = _selectedNodeId.Value;
        var node = _selectedNode!;
        await Work(async () =>
        {
            var touching = _view!.Connections.Where(c => c.SourceNodeId == nodeId || c.TargetNodeId == nodeId).ToList();
            await WorkflowService.DeleteNodeAsync(WorkflowId, nodeId);
            PushUndo(new NodeDeletionAction(nodeId, EditorFrom(node), touching));
            _selectedNodeId = null;
            _multiSelectedNodeIds.Remove(nodeId);
            await Reload();
            _message = "Node deleted.";
        });
    }
    private async Task AddConnection()
    {
        if (_connectionSource is null || _connectionTarget is null) { Show("Choose a source and target node.", true); return; }
        await Work(async () => { await WorkflowService.AddConnectionAsync(WorkflowId, _connectionSource.Value, _connectionOutput, _connectionTarget.Value, _connectionTargetInput); await Reload(); _message = "Connection added."; });
    }
    private async Task DeleteConnection(Guid id) => await Work(async () =>
    {
        var connection = _view!.Connections.First(c => c.Id == id);
        await WorkflowService.DeleteConnectionAsync(WorkflowId, id);
        PushUndo(new ConnectionDeletionAction(connection));
        await Reload();
        _message = "Connection removed.";
    });

    private void PushUndo(IUndoableAction action) { _undoStack.Add(action); _redoStack.Clear(); }

    private async Task UndoAsync() => await Work(async () =>
    {
        if (_undoStack.Count == 0) return;
        var action = _undoStack[^1]; _undoStack.RemoveAt(_undoStack.Count - 1);
        await action.UndoAsync(this);
        _redoStack.Add(action);
        await Reload();
        _message = "Undone.";
    });

    private async Task RedoAsync() => await Work(async () =>
    {
        if (_redoStack.Count == 0) return;
        var action = _redoStack[^1]; _redoStack.RemoveAt(_redoStack.Count - 1);
        await action.RedoAsync(this);
        _undoStack.Add(action);
        await Reload();
        _message = "Redone.";
    });

    private Task HandleCanvasKeyDown(KeyboardEventArgs e)
    {
        // Checked ahead of the modifier guard below: Delete carries no modifier, so it would
        // otherwise never be seen at all.
        if (e.Key is "Delete" or "Backspace" && _selectedConnectionId is not null)
        {
            return DeleteSelectedConnectionAsync();
        }

        if (!e.CtrlKey && !e.MetaKey) return Task.CompletedTask;
        switch (e.Key.ToLowerInvariant())
        {
            case "c": CopySelection(); return Task.CompletedTask;
            case "v": return PasteClipboardAsync();
            case "z": return e.ShiftKey ? RedoAsync() : UndoAsync();
            case "y": return RedoAsync();
            default: return Task.CompletedTask;
        }
    }

    private void CopySelection()
    {
        var ids = SelectedNodeIds;
        if (ids.Count == 0) return;
        _clipboardNodes = _view!.Nodes.Where(node => ids.Contains(node.Id)).ToList();
        _clipboardConnections = _view.Connections.Where(c => ids.Contains(c.SourceNodeId) && ids.Contains(c.TargetNodeId)).ToList();
        Show($"Copied {_clipboardNodes.Count} node(s).");
    }

    private async Task PasteClipboardAsync() => await Work(async () =>
    {
        if (_clipboardNodes.Count == 0) return;
        var idMap = new Dictionary<Guid, Guid>();
        var pastedIds = new HashSet<Guid>();
        foreach (var node in _clipboardNodes)
        {
            var editor = EditorFrom(node);
            var created = await WorkflowService.SaveNodeAsync(WorkflowId, new AutomationNodeEditor
            {
                Name = UniqueNodeName(node.Name), TypeKey = editor.TypeKey, TypeVersion = editor.TypeVersion,
                PositionX = Math.Clamp(NodePosition(node).X + 40, 0, 5000), PositionY = Math.Clamp(NodePosition(node).Y + 40, 0, 5000),
                ParametersJson = editor.ParametersJson, CredentialId = editor.CredentialId, IsDisabled = editor.IsDisabled,
                ContinueOnFail = editor.ContinueOnFail, RetryOnFail = editor.RetryOnFail, MaxTries = editor.MaxTries,
                WaitBetweenTriesMs = editor.WaitBetweenTriesMs, TimeoutMs = editor.TimeoutMs, Notes = editor.Notes
            });
            idMap[node.Id] = created.Id;
            pastedIds.Add(created.Id);
        }
        foreach (var connection in _clipboardConnections)
        {
            if (idMap.TryGetValue(connection.SourceNodeId, out var sourceId) && idMap.TryGetValue(connection.TargetNodeId, out var targetId))
            {
                await WorkflowService.AddConnectionAsync(WorkflowId, sourceId, connection.SourceOutput, targetId, connection.TargetInput);
            }
        }
        await Reload();
        _multiSelectedNodeIds.Clear();
        foreach (var id in pastedIds) _multiSelectedNodeIds.Add(id);
        _selectedNodeId = null;
        _message = $"Pasted {pastedIds.Count} node(s).";
    });

    private string UniqueNodeName(string baseName)
    {
        if (_view!.Nodes.All(node => node.Name != baseName)) return baseName;
        var suffix = 2;
        while (_view.Nodes.Any(node => node.Name == $"{baseName} copy {suffix}")) suffix++;
        return suffix == 2 && _view.Nodes.All(node => node.Name != $"{baseName} copy") ? $"{baseName} copy" : $"{baseName} copy {suffix}";
    }

    private AutomationNodeEditor EditorFrom(AutomationNodeView node) => new()
    {
        Name = node.Name, TypeKey = node.TypeKey, TypeVersion = node.TypeVersion,
        PositionX = NodePosition(node).X, PositionY = NodePosition(node).Y, ParametersJson = node.ParametersJson,
        CredentialId = node.CredentialId, IsDisabled = node.IsDisabled, ContinueOnFail = node.ContinueOnFail,
        RetryOnFail = node.RetryOnFail, MaxTries = node.MaxTries, WaitBetweenTriesMs = node.WaitBetweenTriesMs,
        TimeoutMs = node.TimeoutMs, Notes = node.Notes
    };

    private interface IUndoableAction
    {
        Task UndoAsync(AutomationEditor editor);
        Task RedoAsync(AutomationEditor editor);
    }

    // Represents "this node was deleted." Undo recreates it (and whatever of its connections
    // can still be reattached) and remembers its new id; redo deletes that recreated node again.
    private sealed class NodeDeletionAction : IUndoableAction
    {
        private readonly Guid _originalNodeId;
        private readonly AutomationNodeEditor _snapshot;
        private readonly List<AutomationConnectionView> _connections;
        private Guid _currentNodeId;

        public NodeDeletionAction(Guid originalNodeId, AutomationNodeEditor snapshot, List<AutomationConnectionView> connections)
        {
            _originalNodeId = originalNodeId;
            _currentNodeId = originalNodeId;
            _snapshot = snapshot;
            _connections = connections;
        }

        public async Task UndoAsync(AutomationEditor editor)
        {
            var recreated = await editor.WorkflowService.SaveNodeAsync(editor.WorkflowId, _snapshot);
            editor._nodeIdRemap[_originalNodeId] = recreated.Id;
            _currentNodeId = recreated.Id;
            foreach (var connection in _connections)
            {
                var sourceId = connection.SourceNodeId == _originalNodeId ? recreated.Id : editor.ResolveNodeId(connection.SourceNodeId);
                var targetId = connection.TargetNodeId == _originalNodeId ? recreated.Id : editor.ResolveNodeId(connection.TargetNodeId);
                try { await editor.WorkflowService.AddConnectionAsync(editor.WorkflowId, sourceId, connection.SourceOutput, targetId, connection.TargetInput); }
                catch (Exception) { /* the other endpoint may no longer exist - best effort reattachment */ }
            }
        }

        public async Task RedoAsync(AutomationEditor editor) => await editor.WorkflowService.DeleteNodeAsync(editor.WorkflowId, _currentNodeId);
    }

    // Represents "this connection was deleted." Undo recreates it; redo deletes it again.
    private sealed class ConnectionDeletionAction(AutomationConnectionView snapshot) : IUndoableAction
    {
        private Guid _currentConnectionId = snapshot.Id;

        public async Task UndoAsync(AutomationEditor editor)
        {
            var sourceId = editor.ResolveNodeId(snapshot.SourceNodeId);
            var targetId = editor.ResolveNodeId(snapshot.TargetNodeId);
            var recreated = await editor.WorkflowService.AddConnectionAsync(editor.WorkflowId, sourceId, snapshot.SourceOutput, targetId, snapshot.TargetInput);
            _currentConnectionId = recreated.Id;
        }

        public async Task RedoAsync(AutomationEditor editor) => await editor.WorkflowService.DeleteConnectionAsync(editor.WorkflowId, _currentConnectionId);
    }
    private async Task SaveMetadata() => await Work(async () => { await WorkflowService.UpdateMetadataAsync(WorkflowId, _name, _description, _tags); await Reload(); _message = "Workflow saved."; });
    private async Task Validate() => await Work(async () => { var result = await WorkflowService.ValidateAsync(WorkflowId); Show(result.IsValid ? "Workflow is valid and ready to publish." : string.Join(" ", result.Errors), !result.IsValid); });
    private async Task Publish() => await Work(async () => { await WorkflowService.UpdateMetadataAsync(WorkflowId, _name, _description, _tags); var version = await WorkflowService.PublishAsync(WorkflowId, "Published from visual editor"); await Reload(); _message = $"Published immutable version {version}."; });

    // A single Activate button rather than the old two-step "Publish, then flip Active" dance -
    // that toggle used to sit disabled with no visible reason whenever CurrentVersion was 0.
    // Activate now publishes on the way to going live when a version doesn't already exist,
    // and on a validation failure it selects the offending node in the inspector instead of
    // just naming it in an error banner the user has to go hunting from.
    private async Task Activate() => await Work(async () =>
    {
        if (_view!.Status == AutomationWorkflowStatuses.Active)
        {
            await WorkflowService.SetActiveAsync(WorkflowId, false);
            await Reload();
            _message = "Workflow deactivated.";
            return;
        }

        await WorkflowService.UpdateMetadataAsync(WorkflowId, _name, _description, _tags);
        var validation = await WorkflowService.ValidateAsync(WorkflowId);
        if (!validation.IsValid)
        {
            SelectOffendingNode(validation.Errors);
            Show(string.Join(" ", validation.Errors), true);
            return;
        }

        await WorkflowService.PublishAsync(WorkflowId, "Published from visual editor");
        await WorkflowService.SetActiveAsync(WorkflowId, true);
        await Reload();
        _message = "Workflow activated.";
    });

    // Validation error messages already name the offending node in single quotes (see
    // AutomationWorkflowService.ValidateAsync) - reused here instead of threading a NodeId
    // through every error site, which would mean rewriting AutomationValidationResult's shape
    // across every existing caller for a quick-win button.
    private void SelectOffendingNode(IReadOnlyList<string> errors)
    {
        foreach (var error in errors)
        {
            var start = error.IndexOf('\'');
            if (start < 0) continue;
            var end = error.IndexOf('\'', start + 1);
            if (end < 0) continue;
            var name = error[(start + 1)..end];
            var node = _view?.Nodes.FirstOrDefault(n => n.Name == name);
            if (node is not null)
            {
                SelectNode(node.Id);
                return;
            }
        }
    }
    private async Task ToggleAllowDownstreamTriggers() => await Work(async () =>
    {
        await WorkflowService.SetAllowDownstreamAutomationTriggersAsync(WorkflowId, !_allowDownstreamTriggers);
        await Reload();
        _message = _allowDownstreamTriggers ? "This workflow's writes can now trigger other automations." : "This workflow's writes no longer trigger other automations.";
    });
    private async Task RunWorkflow() => await Work(async () => { _latestExecution = await ExecutionService.ExecuteAsync(WorkflowId, _runInput); _bottomTab = "runs"; await Reload(); Show(_latestExecution.Status == AutomationExecutionStatuses.Succeeded ? "Workflow completed successfully." : _latestExecution.ErrorMessage, _latestExecution.Status != AutomationExecutionStatuses.Succeeded); });
    private async Task CreatePublicShare() => await Work(async () =>
    {
        var expiresAt = _shareExpiresAt is { } parsed ? new DateTimeOffset(parsed) : (DateTimeOffset?)null;
        var password = string.IsNullOrWhiteSpace(_sharePassword) ? null : _sharePassword;
        var share = await AccessService.CreatePublicShareAsync(
            WorkflowId, isDatabase: false, expiresAt, allowSearchIndexing: false, password,
            await CurrentUserAccessor.GetCurrentUsernameAsync(), isAutomationWorkflow: true);
        _newPublicShareUrl = Navigation.ToAbsoluteUri($"/sentinel/share/{share.PublicToken}").ToString();
        _shareExpiresAt = null;
        _sharePassword = "";
        await ReloadAsync(includeAccess: true);
        _message = "Public status link created.";
    });
    private async Task RevokePublicShare(Guid shareId) => await Work(async () =>
    {
        await AccessService.RevokePublicShareAsync(shareId, await CurrentUserAccessor.GetCurrentUsernameAsync());
        await Reload();
        _message = "Public status link revoked.";
    });
    private async Task CopyPublicShareUrl() => await JS.InvokeVoidAsync("navigator.clipboard.writeText", _newPublicShareUrl);
    private async Task GrantWorkflowAccess() => await Work(async () =>
    {
        // Full access, not a tiered View/Edit grant: an invited teammate gets the same full
        // control over this one workflow an admin has, just scoped to it - see the plan's own
        // notes on why a binary per-workflow grant was chosen over fine-grained button-level
        // permission gating in this pass.
        await AccessService.SetPermissionAsync(WorkflowId, isDatabase: false, _shareUsername.Trim(), SentinelAccessLevels.FullAccess, _username);
        _shareUsername = "";
        await Reload();
        _message = "Access granted.";
    });
    private async Task RevokeWorkflowAccess(Guid permissionId) => await Work(async () =>
    {
        await AccessService.RemovePermissionAsync(permissionId, _username);
        await ReloadAsync(includeAccess: true);
        _message = "Access removed.";
    });
    private async Task LoadExecution(Guid id) => await Work(async () => { _latestExecution = await WorkflowService.GetExecutionAsync(id); _bottomTab = "runs"; });
    private async Task ResolveApproval(bool approved) => await Work(async () =>
    {
        if (_latestExecution is null) return;
        _latestExecution = await ExecutionService.ResolveApprovalAsync(_latestExecution.Id, approved);
        await Reload();
        _message = approved ? "Approved. Workflow resumed." : "Rejected. Workflow resumed.";
    });
    private async Task CancelLatestExecution() => await Work(async () =>
    {
        if (_latestExecution is null) return;
        _latestExecution = await ExecutionService.CancelAsync(_latestExecution.Id);
        await Reload();
        _message = "Execution canceled.";
    });
    private async Task RetryFromFailedNode() => await Work(async () =>
    {
        if (_latestExecution is null) return;
        _latestExecution = await ExecutionService.RetryFromFailedNodeAsync(_latestExecution.Id);
        await Reload();
        Show(_latestExecution.Status == AutomationExecutionStatuses.Succeeded ? "Retry succeeded." : _latestExecution.ErrorMessage, _latestExecution.Status != AutomationExecutionStatuses.Succeeded);
    });
    private async Task ReplayExecution(Guid executionId) => await Work(async () =>
    {
        _latestExecution = await ExecutionService.ReplayAsync(executionId);
        _bottomTab = "runs";
        await Reload();
        Show(_latestExecution.Status == AutomationExecutionStatuses.Succeeded ? "Replay completed - no real side effects were performed." : $"Replay stopped: {_latestExecution.ErrorMessage}", _latestExecution.Status != AutomationExecutionStatuses.Succeeded);
    });

