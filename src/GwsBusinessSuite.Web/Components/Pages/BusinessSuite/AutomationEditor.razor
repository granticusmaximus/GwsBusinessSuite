    private void CloseSaveTemplate() => _showSaveTemplate = false;
    private async Task SaveAsTemplate() => await Work(async () =>
    {
        await TemplateService.CreateFromWorkflowAsync(WorkflowId, _templateName, _templateDescription, "user");
        _showSaveTemplate = false;
        Show($"Saved as template \"{_templateName}\".");
