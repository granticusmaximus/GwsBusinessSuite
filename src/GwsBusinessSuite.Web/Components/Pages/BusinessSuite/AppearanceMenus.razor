@page "/admin/appearance/menus"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "ContributorAccess")]
@using Microsoft.AspNetCore.Authorization
@using GwsBusinessSuite.Application.CmsBuilder
@using GwsBusinessSuite.Domain.Entities
@using System.Text.Json
@inject ICmsBuilderService CmsBuilderService
@inject GwsBusinessSuite.Web.Services.CurrentCmsSiteAccessor CurrentCmsSiteAccessor
@inject ILogger<AppearanceMenus> Logger

<PageTitle>Menus</PageTitle>

<div class="page-header d-flex flex-wrap align-items-start justify-content-between gap-3">
    <div>
        <h1><i class="bi bi-list me-2 text-primary"></i>Menus</h1>
        <p>Edit the header (primary) and footer navigation for @(CurrentSite?.Name ?? "the live site").</p>
    </div>
    <CmsSiteSwitcher SiteChanged="LoadSiteAsync" />
</div>
<AppTabs App="GwsBusinessSuite.Web.Services.AdminApps.SiteDesign" />

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@ErrorMessage</div>
}
@if (!string.IsNullOrWhiteSpace(StatusMessage))
{
    <div class="alert alert-info" role="alert">@StatusMessage</div>
}

<div class="card border-0 shadow-sm" style="max-width: 720px;">
    <div class="card-body">
        <div class="btn-group btn-group-sm mb-3" role="group" aria-label="Navigation menu location">
            <button type="button" class="btn @(ActiveNavLocation == "Primary" ? "btn-primary" : "btn-outline-primary")"
                    @onclick='() => ActiveNavLocation = "Primary"'>
                Primary
            </button>
            <button type="button" class="btn @(ActiveNavLocation == "Footer" ? "btn-primary" : "btn-outline-primary")"
                    @onclick='() => ActiveNavLocation = "Footer"'>
                Footer
            </button>
        </div>

        @{
            var isFooterLocation = ActiveNavLocation == "Footer";
            var activeNavItems = isFooterLocation ? FooterNavMenuItems : NavMenuItems;
        }
        <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="small text-secondary">@(isFooterLocation ? "Shown in the site footer." : "Shown in the site header.")</span>
            <button type="button" class="btn btn-xs btn-outline-primary" @onclick="() => AddNavItem(activeNavItems)">
                <i class="bi bi-plus-lg"></i> Add Link
            </button>
        </div>
        @if (activeNavItems.Count == 0)
        {
            <p class="small text-secondary mb-0">
                No @(isFooterLocation ? "footer" : "nav") links yet — click "Add Link" to build @(isFooterLocation ? "the site's footer links" : "the site's top navigation").
            </p>
        }
        else
        {
            @for (var i = 0; i < activeNavItems.Count; i++)
            {
                var index = i;
                var item = activeNavItems[index];
                <div class="d-flex gap-2 align-items-center mb-2">
                    <input class="form-control form-control-sm" placeholder="Label" aria-label="Label" value="@item.Label"
                           @oninput="(e) => UpdateNavItem(activeNavItems, index, item with { Label = e.Value?.ToString() ?? string.Empty })" />
                    <input class="form-control form-control-sm font-monospace" placeholder="@(item.HasChildren ? "/path (optional)" : "/path")" aria-label="Link" value="@item.Href"
                           @oninput="(e) => UpdateNavItem(activeNavItems, index, item with { Href = e.Value?.ToString() ?? string.Empty })" />
                    <div class="form-check form-check-inline flex-shrink-0 mb-0" title="Open in new tab">
                        <input class="form-check-input" type="checkbox" id="@($"nav-newtab-{ActiveNavLocation}-{index}")"
                               checked="@item.OpenInNewTab"
                               @onchange="(e) => UpdateNavItem(activeNavItems, index, item with { OpenInNewTab = (bool)(e.Value ?? false) })" />
                        <label class="form-check-label small" for="@($"nav-newtab-{ActiveNavLocation}-{index}")">↗</label>
                    </div>
                    <div class="btn-group btn-group-sm flex-shrink-0">
                        <button type="button" class="btn btn-outline-secondary" title="Add a sub-link" @onclick="() => AddChild(activeNavItems, index)">
                            <i class="bi bi-plus-lg"></i><i class="bi bi-arrow-return-right"></i>
                        </button>
                        <button type="button" class="btn btn-outline-secondary" title="Make it a sub-link of the item above"
                                disabled="@(index == 0 || item.HasChildren)" @onclick="() => Indent(activeNavItems, index)">
                            <i class="bi bi-text-indent-left"></i>
                        </button>
                        <button type="button" class="btn btn-outline-secondary" title="Move up" disabled="@(index == 0)" @onclick="() => MoveNavItem(activeNavItems, index, -1)">
                            <i class="bi bi-arrow-up"></i>
                        </button>
                        <button type="button" class="btn btn-outline-secondary" title="Move down" disabled="@(index == activeNavItems.Count - 1)" @onclick="() => MoveNavItem(activeNavItems, index, 1)">
                            <i class="bi bi-arrow-down"></i>
                        </button>
                        <button type="button" class="btn btn-outline-danger" title="@(item.HasChildren ? "Remove (and its sub-links)" : "Remove")" @onclick="() => RemoveNavItem(activeNavItems, index)">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
                @if (item.Children is { Count: > 0 } children)
                {
                    @for (var c = 0; c < children.Count; c++)
                    {
                        var childIndex = c;
                        var child = children[childIndex];
                        <div class="d-flex gap-2 align-items-center mb-2 ps-4">
                            <i class="bi bi-arrow-return-right text-secondary flex-shrink-0" aria-hidden="true"></i>
                            <input class="form-control form-control-sm" placeholder="Sub-link label" aria-label="Sub-link label" value="@child.Label"
                                   @oninput="(e) => UpdateChild(activeNavItems, index, childIndex, child with { Label = e.Value?.ToString() ?? string.Empty })" />
                            <input class="form-control form-control-sm font-monospace" placeholder="/path" aria-label="Sub-link" value="@child.Href"
                                   @oninput="(e) => UpdateChild(activeNavItems, index, childIndex, child with { Href = e.Value?.ToString() ?? string.Empty })" />
                            <div class="form-check form-check-inline flex-shrink-0 mb-0" title="Open in new tab">
                                <input class="form-check-input" type="checkbox" id="@($"nav-newtab-{ActiveNavLocation}-{index}-{childIndex}")"
                                       checked="@child.OpenInNewTab"
                                       @onchange="(e) => UpdateChild(activeNavItems, index, childIndex, child with { OpenInNewTab = (bool)(e.Value ?? false) })" />
                                <label class="form-check-label small" for="@($"nav-newtab-{ActiveNavLocation}-{index}-{childIndex}")">↗</label>
                            </div>
                            <div class="btn-group btn-group-sm flex-shrink-0">
                                <button type="button" class="btn btn-outline-secondary" title="Move out to the top level" @onclick="() => Outdent(activeNavItems, index, childIndex)">
                                    <i class="bi bi-text-indent-right"></i>
                                </button>
                                <button type="button" class="btn btn-outline-secondary" title="Move up" disabled="@(childIndex == 0)" @onclick="() => MoveChild(activeNavItems, index, childIndex, -1)">
                                    <i class="bi bi-arrow-up"></i>
                                </button>
                                <button type="button" class="btn btn-outline-secondary" title="Move down" disabled="@(childIndex == children.Count - 1)" @onclick="() => MoveChild(activeNavItems, index, childIndex, 1)">
                                    <i class="bi bi-arrow-down"></i>
                                </button>
                                <button type="button" class="btn btn-outline-danger" title="Remove" @onclick="() => RemoveChild(activeNavItems, index, childIndex)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    }
                }
            }
            <p class="small text-secondary mb-0">
                @(isFooterLocation
                    ? "Sub-links are listed under their parent in the footer."
                    : "Sub-links open as a dropdown under their parent (on phones they're listed under it). A parent's own link is optional.")
            </p>
        }

        <button class="btn btn-primary btn-sm mt-3" @onclick="SaveAsync" disabled="@IsBusy">Save changes</button>
    </div>
</div>

@code {
    private static readonly JsonSerializerOptions NavJsonOptions = new() { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };

    private CmsSite? CurrentSite { get; set; }
    private List<NavMenuItem> NavMenuItems { get; set; } = new();
    private List<NavMenuItem> FooterNavMenuItems { get; set; } = new();
    private string ActiveNavLocation { get; set; } = "Primary";
    private bool IsBusy { get; set; }
    private string StatusMessage { get; set; } = string.Empty;
    private string ErrorMessage { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var site = await CurrentCmsSiteAccessor.GetCurrentSiteAsync();
        LoadSite(site);
    }

    private Task LoadSiteAsync(CmsSite site)
    {
        LoadSite(site);
        StatusMessage = $"Now editing menus for {site.Name}.";
        ErrorMessage = string.Empty;
        return Task.CompletedTask;
    }

    private void LoadSite(CmsSite site)
    {
        CurrentSite = site;
        NavMenuItems = ParseNavMenuJson(site.NavMenuJson);
        FooterNavMenuItems = ParseNavMenuJson(site.FooterNavMenuJson);
    }

    private static List<NavMenuItem> ParseNavMenuJson(string navMenuJson)
    {
        if (string.IsNullOrWhiteSpace(navMenuJson))
        {
            return new();
        }

        try
        {
            return JsonSerializer.Deserialize<List<NavMenuItem>>(navMenuJson, NavJsonOptions) ?? new();
        }
        catch (JsonException)
        {
            return new();
        }
    }

    // Shared by both the Primary and Footer editors above.
    private void AddNavItem(List<NavMenuItem> items)
    {
        items.Add(new NavMenuItem(Guid.NewGuid().ToString("N")[..8], "New Link", "/", false));
    }

    private void UpdateNavItem(List<NavMenuItem> items, int index, NavMenuItem updated)
    {
        if (index < 0 || index >= items.Count) return;
        items[index] = updated;
    }

    private void RemoveNavItem(List<NavMenuItem> items, int index)
    {
        if (index < 0 || index >= items.Count) return;
        items.RemoveAt(index);
    }

    // Sub-links (one level). NavMenuItem is immutable, so each change rebuilds the parent.
    private static void SetChildren(List<NavMenuItem> items, int parentIndex, List<NavMenuItem> children) =>
        items[parentIndex] = items[parentIndex] with { Children = children.Count > 0 ? children : null };

    private static List<NavMenuItem> ChildrenOf(List<NavMenuItem> items, int parentIndex) =>
        items[parentIndex].Children?.ToList() ?? [];

    private void AddChild(List<NavMenuItem> items, int parentIndex)
    {
        if (parentIndex < 0 || parentIndex >= items.Count) return;
        var children = ChildrenOf(items, parentIndex);
        children.Add(new NavMenuItem(Guid.NewGuid().ToString("N")[..8], "New Link", "/", false));
        SetChildren(items, parentIndex, children);
    }

    private void UpdateChild(List<NavMenuItem> items, int parentIndex, int childIndex, NavMenuItem updated)
    {
        if (parentIndex < 0 || parentIndex >= items.Count) return;
        var children = ChildrenOf(items, parentIndex);
        if (childIndex < 0 || childIndex >= children.Count) return;
        children[childIndex] = updated with { Children = null };
        SetChildren(items, parentIndex, children);
    }

    private void RemoveChild(List<NavMenuItem> items, int parentIndex, int childIndex)
    {
        if (parentIndex < 0 || parentIndex >= items.Count) return;
        var children = ChildrenOf(items, parentIndex);
        if (childIndex < 0 || childIndex >= children.Count) return;
        children.RemoveAt(childIndex);
        SetChildren(items, parentIndex, children);
    }

    private void MoveChild(List<NavMenuItem> items, int parentIndex, int childIndex, int direction)
    {
        if (parentIndex < 0 || parentIndex >= items.Count) return;
        var children = ChildrenOf(items, parentIndex);
        var target = childIndex + direction;
        if (childIndex < 0 || childIndex >= children.Count || target < 0 || target >= children.Count) return;
        (children[childIndex], children[target]) = (children[target], children[childIndex]);
        SetChildren(items, parentIndex, children);
    }

    // The item becomes the last sub-link of the item above it (only one level, so not a parent).
    private void Indent(List<NavMenuItem> items, int index)
    {
        if (index <= 0 || index >= items.Count || items[index].HasChildren) return;
        var item = items[index];
        items.RemoveAt(index);
        var children = ChildrenOf(items, index - 1);
        children.Add(item with { Children = null });
        SetChildren(items, index - 1, children);
    }

    // The sub-link moves to the top level, just after its old parent.
    private void Outdent(List<NavMenuItem> items, int parentIndex, int childIndex)
    {
        if (parentIndex < 0 || parentIndex >= items.Count) return;
        var children = ChildrenOf(items, parentIndex);
        if (childIndex < 0 || childIndex >= children.Count) return;
        var child = children[childIndex];
        children.RemoveAt(childIndex);
        SetChildren(items, parentIndex, children);
        items.Insert(parentIndex + 1, child);
    }

    private void MoveNavItem(List<NavMenuItem> items, int index, int direction)
    {
        var target = index + direction;
        if (index < 0 || index >= items.Count || target < 0 || target >= items.Count) return;
        (items[index], items[target]) = (items[target], items[index]);
    }

    // Partial save: re-fetch the freshest site so a concurrent edit on
    // Appearance > Customize isn't clobbered - only NavMenuJson/FooterNavMenuJson
    // come from this screen, everything else carries through unchanged.
    private async Task SaveAsync()
    {
        if (CurrentSite is null) return;

        IsBusy = true;
        StatusMessage = string.Empty;
        ErrorMessage = string.Empty;

        try
        {
            var freshSite = await CmsBuilderService.GetSiteBySlugAsync(CurrentSite.Slug) ?? CurrentSite;

            var saved = await CmsBuilderService.SaveSiteAsync(new CmsSiteEditorModel
            {
                SiteId = freshSite.Id,
                Name = freshSite.Name,
                Slug = freshSite.Slug,
                Theme = freshSite.Theme,
                CustomCss = freshSite.CustomCss,
                NavMenuJson = JsonSerializer.Serialize(NavMenuItems, NavJsonOptions),
                FooterNavMenuJson = JsonSerializer.Serialize(FooterNavMenuItems, NavJsonOptions),
                AccentColorHex = freshSite.AccentColorHex,
                FontPairingKey = freshSite.FontPairingKey,
                LogoUrl = freshSite.LogoUrl,
                FaviconUrl = freshSite.FaviconUrl
            });

            CurrentSite = saved;
            NavMenuItems = ParseNavMenuJson(saved.NavMenuJson);
            FooterNavMenuItems = ParseNavMenuJson(saved.FooterNavMenuJson);
            StatusMessage = "Saved navigation menus.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to save nav menus.");
            ErrorMessage = $"Unable to save navigation menus. {ex.Message}";
        }
        finally
        {
            IsBusy = false;
        }
    }
}
