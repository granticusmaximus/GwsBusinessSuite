@using GwsBusinessSuite.Application.Abstractions
@using GwsBusinessSuite.Application.Wiki
@inject ISentinelTemplateService TemplateService
@inject ISentinelWorkspaceImportService WorkspaceImportService
@inject ICurrentUserAccessor CurrentUserAccessor
@inject ILogger<SentinelTemplates> Logger

<div class="sentinel-template-panel">
    <div class="sentinel-template-panel-header">
        <span><i class="bi bi-copy me-1"></i>Templates</span>
        <span class="sentinel-template-count">@(Templates.Count + BlockTemplates.Count + DatabaseTemplates.Count)</span>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="sentinel-template-error">@ErrorMessage</div>
    }

    @* A save-as-template row per open surface, only shown when there is actually something to
       save from (an open page/database) - matches Notion's own "New template" affordance
       living next to the thing it captures rather than as an always-visible empty form. *@
    @if (IsPageEditorActive)
    {
        <div class="sentinel-template-save-row">
            <input class="form-control form-control-sm" @bind="NewBlockTemplateName" placeholder="Block template name" maxlength="120" />
            <button type="button" class="btn btn-sm btn-warning" @onclick="SaveBlockTemplateAsync"
                    disabled="@(IsBusy || string.IsNullOrWhiteSpace(NewBlockTemplateName))" title="Save the current page's blocks as a reusable template">
                <i class="bi bi-bookmark-plus me-1"></i>Save blocks
            </button>
        </div>
    }
    @if (CurrentPageId.HasValue)
    {
        <div class="sentinel-template-save-row">
            <input class="form-control form-control-sm" @bind="NewTemplateName" placeholder="Page template name" maxlength="120" />
            <button type="button" class="btn btn-sm btn-warning" @onclick="SaveTemplateAsync"
                    disabled="@(IsBusy || string.IsNullOrWhiteSpace(NewTemplateName))" title="Save this page as a template">
                <i class="bi bi-bookmark-plus me-1"></i>Save page
            </button>
        </div>
    }
    @if (CurrentDatabaseId.HasValue)
    {
        <div class="sentinel-template-save-row">
            <input class="form-control form-control-sm" @bind="NewDatabaseTemplateName" placeholder="Database template name" maxlength="120" />
            <button type="button" class="btn btn-sm btn-warning" @onclick="SaveDatabaseTemplateAsync"
                    disabled="@(IsBusy || string.IsNullOrWhiteSpace(NewDatabaseTemplateName))" title="Save this database as a template">
                <i class="bi bi-bookmark-plus me-1"></i>Save database
            </button>
        </div>
    }

    @{ var hasAnyTemplate = Templates.Count > 0 || BlockTemplates.Count > 0 || DatabaseTemplates.Count > 0; }
    @if (!hasAnyTemplate)
    {
        <div class="sentinel-template-empty">No templates yet - save a page, its blocks, or a database above to start a gallery here.</div>
    }
    else
    {
        <div class="sentinel-template-gallery">
            @foreach (var template in Templates)
            {
                <div class="sentinel-template-card">
                    <div class="sentinel-template-card-icon">@(string.IsNullOrWhiteSpace(template.Icon) ? "📄" : template.Icon)</div>
                    <div class="sentinel-template-card-body">
                        <div class="sentinel-template-card-name text-truncate">@template.Name</div>
                        <div class="sentinel-template-card-meta text-truncate">Page · @template.BlockCount blocks</div>
                    </div>
                    @if (PendingDeleteId == template.Id)
                    {
                        <div class="sentinel-template-card-actions">
                            <button type="button" class="btn btn-xs btn-danger" @onclick="() => DeleteAsync(template.Id)" disabled="@IsBusy">Confirm</button>
                            <button type="button" class="btn btn-xs btn-link" @onclick="CancelDelete" disabled="@IsBusy">Cancel</button>
                        </div>
                    }
                    else
                    {
                        <div class="sentinel-template-card-actions">
                            <button type="button" class="btn btn-xs btn-warning" @onclick="() => UseAsync(template.Id)" disabled="@IsBusy">Use</button>
                            <button type="button" class="btn btn-xs btn-link text-danger" @onclick="() => PendingDeleteId = template.Id" disabled="@IsBusy" title="Delete template">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    }
                </div>
            }
            @foreach (var template in BlockTemplates)
            {
                <div class="sentinel-template-card">
                    <div class="sentinel-template-card-icon">▦</div>
                    <div class="sentinel-template-card-body">
                        <div class="sentinel-template-card-name text-truncate">@template.Name</div>
                        <div class="sentinel-template-card-meta text-truncate">Blocks · @template.BlockCount blocks</div>
                    </div>
                    @if (PendingBlockDeleteId == template.Id)
                    {
                        <div class="sentinel-template-card-actions">
                            <button type="button" class="btn btn-xs btn-danger" @onclick="() => DeleteBlockTemplateAsync(template.Id)" disabled="@IsBusy">Confirm</button>
                            <button type="button" class="btn btn-xs btn-link" @onclick="CancelBlockDelete" disabled="@IsBusy">Cancel</button>
                        </div>
                    }
                    else
                    {
                        <div class="sentinel-template-card-actions">
                            <button type="button" class="btn btn-xs btn-warning" @onclick="() => UseBlockTemplateAsync(template.Id)" disabled="@(IsBusy || !IsPageEditorActive)">Insert</button>
                            <button type="button" class="btn btn-xs btn-link text-danger" @onclick="() => PendingBlockDeleteId = template.Id" disabled="@IsBusy" title="Delete block template">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    }
                </div>
            }
            @foreach (var template in DatabaseTemplates)
            {
                <div class="sentinel-template-card">
                    <div class="sentinel-template-card-icon">@(string.IsNullOrWhiteSpace(template.Icon) ? "🗄️" : template.Icon)</div>
                    <div class="sentinel-template-card-body">
                        <div class="sentinel-template-card-name text-truncate">@template.Name</div>
                        <div class="sentinel-template-card-meta text-truncate">Database · @template.RowCount rows · @template.ViewCount views</div>
                    </div>
                    @if (PendingDatabaseDeleteId == template.Id)
                    {
                        <div class="sentinel-template-card-actions">
                            <button type="button" class="btn btn-xs btn-danger" @onclick="() => DeleteDatabaseTemplateAsync(template.Id)" disabled="@IsBusy">Confirm</button>
                            <button type="button" class="btn btn-xs btn-link" @onclick="CancelDatabaseDelete" disabled="@IsBusy">Cancel</button>
                        </div>
                    }
                    else
                    {
                        <div class="sentinel-template-card-actions">
                            <button type="button" class="btn btn-xs btn-warning" @onclick="() => UseDatabaseTemplateAsync(template.Id)" disabled="@IsBusy">Use</button>
                            <button type="button" class="btn btn-xs btn-link text-danger" @onclick="() => PendingDatabaseDeleteId = template.Id" disabled="@IsBusy" title="Delete database template">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    }

    <details class="sentinel-notion-import-details">
        <summary>Notion import &amp; restore</summary>
        <div class="sentinel-notion-workspace-import">
            <div class="fw-semibold small mb-1"><i class="bi bi-cloud-arrow-up me-1"></i>Restore a Notion workspace</div>
            <div class="small text-secondary mb-2">
                Upload a Notion Markdown &amp; CSV or HTML workspace ZIP to create or update real editable pages,
                databases, rows, and files from the export's own hierarchy. Reimporting the same export updates
                matching documents. Maximum ZIP size: 250 MB.
            </div>
            <label class="btn btn-sm btn-warning mb-0 @(IsBusy ? "disabled" : string.Empty)">
                <i class="bi bi-file-earmark-zip me-1"></i>Restore workspace ZIP
                <InputFile class="visually-hidden"
                           accept=".zip,application/zip"
                           disabled="@IsBusy"
                           OnChange="ImportNotionWorkspaceAsync" />
            </label>
            @if (!string.IsNullOrWhiteSpace(WorkspaceImportMessage))
            {
                <div class="small @(WorkspaceImportSucceeded ? "text-success" : "text-danger") mt-2">@WorkspaceImportMessage</div>
            }
        </div>
        <div class="sentinel-notion-template-import">
            <div class="fw-semibold small mb-1"><i class="bi bi-box-arrow-in-down me-1"></i>Import a free Notion template</div>
            <div class="small text-secondary mb-2">
                Duplicate the free template into your connected Notion workspace, share it with the Sentinel
                integration, run Notion sync, then save the imported page or database as a template above.
                Supports Notion Markdown &amp; CSV or HTML exports up to 25 MB.
            </div>
            <label class="btn btn-sm btn-outline-secondary mb-0 @(IsBusy ? "disabled" : string.Empty)">
                <i class="bi bi-file-earmark-zip me-1"></i>Import Notion ZIP
                <InputFile class="visually-hidden"
                           accept=".zip,application/zip"
                           disabled="@IsBusy"
                           OnChange="ImportNotionZipAsync" />
            </label>
            @if (!string.IsNullOrWhiteSpace(ImportMessage))
            {
                <div class="small @(ImportSucceeded ? "text-success" : "text-danger") mt-2">@ImportMessage</div>
            }
        </div>
    </details>
</div>

@code {
    [Parameter] public Guid? CurrentPageId { get; set; }
    [Parameter] public string CurrentPageTitle { get; set; } = string.Empty;
    [Parameter] public Guid? CurrentDatabaseId { get; set; }
    [Parameter] public string CurrentDatabaseTitle { get; set; } = string.Empty;
    [Parameter] public bool IsPageEditorActive { get; set; }
    [Parameter, EditorRequired] public Func<Task<string>> CaptureBlocks { get; set; } = default!;
    [Parameter] public EventCallback<Guid> OnPageCreated { get; set; }
    [Parameter] public EventCallback<Guid> OnDatabaseCreated { get; set; }
    [Parameter] public EventCallback<string> OnBlocksInserted { get; set; }
    [Parameter] public EventCallback OnWorkspaceImported { get; set; }

    private List<SentinelPageTemplateView> Templates { get; set; } = new();
    private List<SentinelBlockTemplateView> BlockTemplates { get; set; } = new();
    private List<SentinelDatabaseTemplateView> DatabaseTemplates { get; set; } = new();
    private string NewTemplateName { get; set; } = string.Empty;
    private string NewBlockTemplateName { get; set; } = string.Empty;
    private string NewDatabaseTemplateName { get; set; } = string.Empty;
    private string ErrorMessage { get; set; } = string.Empty;
    private string ImportMessage { get; set; } = string.Empty;
    private bool ImportSucceeded { get; set; }
    private string WorkspaceImportMessage { get; set; } = string.Empty;
    private bool WorkspaceImportSucceeded { get; set; }
    private Guid? PendingDeleteId { get; set; }
    private Guid? PendingBlockDeleteId { get; set; }
    private Guid? PendingDatabaseDeleteId { get; set; }
    private bool IsBusy { get; set; }
    private Guid? _previousPageId;
    private Guid? _previousDatabaseId;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    protected override void OnParametersSet()
    {
        if (_previousPageId != CurrentPageId)
        {
            _previousPageId = CurrentPageId;
            NewTemplateName = CurrentPageId.HasValue && !string.IsNullOrWhiteSpace(CurrentPageTitle)
                ? $"{CurrentPageTitle} template"
                : string.Empty;
            NewBlockTemplateName = CurrentPageId.HasValue && !string.IsNullOrWhiteSpace(CurrentPageTitle)
                ? $"{CurrentPageTitle} blocks"
                : "Reusable blocks";
        }

        if (_previousDatabaseId != CurrentDatabaseId)
        {
            _previousDatabaseId = CurrentDatabaseId;
            NewDatabaseTemplateName = CurrentDatabaseId.HasValue && !string.IsNullOrWhiteSpace(CurrentDatabaseTitle)
                ? $"{CurrentDatabaseTitle} template"
                : string.Empty;
        }
    }

    private async Task SaveTemplateAsync()
    {
        if (CurrentPageId is not { } pageId) return;
        await RunAsync(async () =>
        {
            var user = await CurrentUserAccessor.GetCurrentUsernameAsync();
            await TemplateService.CreateFromPageAsync(pageId, NewTemplateName, user);
            await LoadAsync();
            NewTemplateName = $"{CurrentPageTitle} template";
        });
    }

    private async Task UseAsync(Guid templateId) => await RunAsync(async () =>
    {
        var user = await CurrentUserAccessor.GetCurrentUsernameAsync();
        var page = await TemplateService.CreatePageAsync(templateId, null, user);
        await OnPageCreated.InvokeAsync(page.Id);
    });

    private async Task SaveBlockTemplateAsync() => await RunAsync(async () =>
    {
        var blocksJson = await CaptureBlocks();
        var user = await CurrentUserAccessor.GetCurrentUsernameAsync();
        await TemplateService.CreateBlockTemplateAsync(NewBlockTemplateName, blocksJson, user);
        await LoadAsync();
        NewBlockTemplateName = "Reusable blocks";
    });

    private async Task UseBlockTemplateAsync(Guid templateId) => await RunAsync(async () =>
    {
        var blocksJson = await TemplateService.MaterializeBlockTemplateAsync(templateId);
        await OnBlocksInserted.InvokeAsync(blocksJson);
    });

    private async Task SaveDatabaseTemplateAsync()
    {
        if (CurrentDatabaseId is not { } databaseId) return;
        await RunAsync(async () =>
        {
            var user = await CurrentUserAccessor.GetCurrentUsernameAsync();
            await TemplateService.CreateFromDatabaseAsync(databaseId, NewDatabaseTemplateName, user);
            await LoadAsync();
            NewDatabaseTemplateName = $"{CurrentDatabaseTitle} template";
        });
    }

    private async Task UseDatabaseTemplateAsync(Guid templateId) => await RunAsync(async () =>
    {
        var user = await CurrentUserAccessor.GetCurrentUsernameAsync();
        var database = await TemplateService.CreateDatabaseAsync(templateId, null, user);
        await OnDatabaseCreated.InvokeAsync(database.Id);
    });

    private async Task ImportNotionZipAsync(InputFileChangeEventArgs args)
    {
        ImportMessage = string.Empty;
        ImportSucceeded = false;
        await RunAsync(async () =>
        {
            var file = args.File;
            if (!file.Name.EndsWith(".zip", StringComparison.OrdinalIgnoreCase))
            {
                throw new InvalidOperationException("Choose a .zip file exported from Notion.");
            }

            await using var source = file.OpenReadStream(25 * 1024 * 1024);
            using var buffer = new MemoryStream();
            await source.CopyToAsync(buffer);
            var user = await CurrentUserAccessor.GetCurrentUsernameAsync();
            var result = await TemplateService.ImportNotionExportAsync(buffer.ToArray(), user);
            await LoadAsync();
            ImportSucceeded = true;
            ImportMessage =
                $"Imported {result.PageTemplatesImported} page and {result.DatabaseTemplatesImported} database template(s)."
                + (result.FilesSkipped > 0 ? $" Skipped {result.FilesSkipped} unsupported or restricted file(s)." : string.Empty)
                + (result.Warnings.Count > 0 ? $" {string.Join(" ", result.Warnings.Take(3))}" : string.Empty);
        });

        if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            ImportMessage = ErrorMessage;
            ErrorMessage = string.Empty;
        }
    }

    private async Task ImportNotionWorkspaceAsync(InputFileChangeEventArgs args)
    {
        WorkspaceImportMessage = string.Empty;
        WorkspaceImportSucceeded = false;
        await RunAsync(async () =>
        {
            var file = args.File;
            if (!file.Name.EndsWith(".zip", StringComparison.OrdinalIgnoreCase))
            {
                throw new InvalidOperationException("Choose a .zip workspace exported from Notion.");
            }

            await using var source = file.OpenReadStream(
                SentinelNotionWorkspaceImportLimits.MaxArchiveBytes);
            using var buffer = new MemoryStream();
            await source.CopyToAsync(buffer);
            var user = await CurrentUserAccessor.GetCurrentUsernameAsync();
            var result = await WorkspaceImportService.ImportAsync(buffer.ToArray(), user);
            await OnWorkspaceImported.InvokeAsync();
            WorkspaceImportSucceeded = true;
            WorkspaceImportMessage =
                $"Workspace restored: {result.PagesCreated} page(s) created, {result.PagesUpdated} updated, "
                + $"{result.DatabasesCreated} database(s) created, {result.DatabasesUpdated} updated, "
                + $"{result.DatabaseRowsImported} row(s), and {result.FilesImported} file(s) imported."
                + (result.FilesSkipped > 0 ? $" {result.FilesSkipped} file(s) skipped." : string.Empty)
                + (result.Warnings.Count > 0 ? $" {string.Join(" ", result.Warnings.Take(3))}" : string.Empty);
        });

        if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            WorkspaceImportMessage = ErrorMessage;
            ErrorMessage = string.Empty;
        }
    }

    private async Task DeleteAsync(Guid templateId) => await RunAsync(async () =>
    {
        await TemplateService.DeleteAsync(templateId);
        PendingDeleteId = null;
        await LoadAsync();
    });

    private void CancelDelete() => PendingDeleteId = null;

    private async Task DeleteBlockTemplateAsync(Guid templateId) => await RunAsync(async () =>
    {
        await TemplateService.DeleteBlockTemplateAsync(templateId);
        PendingBlockDeleteId = null;
        await LoadAsync();
    });

    private void CancelBlockDelete() => PendingBlockDeleteId = null;

    private async Task DeleteDatabaseTemplateAsync(Guid templateId) => await RunAsync(async () =>
    {
        await TemplateService.DeleteDatabaseTemplateAsync(templateId);
        PendingDatabaseDeleteId = null;
        await LoadAsync();
    });

    private void CancelDatabaseDelete() => PendingDatabaseDeleteId = null;

    private async Task LoadAsync()
    {
        Templates = (await TemplateService.ListAsync()).ToList();
        BlockTemplates = (await TemplateService.ListBlockTemplatesAsync()).ToList();
        DatabaseTemplates = (await TemplateService.ListDatabaseTemplatesAsync()).ToList();
    }

    private async Task RunAsync(Func<Task> action)
    {
        IsBusy = true;
        ErrorMessage = string.Empty;
        try
        {
            await action();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Sentinel template action failed.");
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }
}
