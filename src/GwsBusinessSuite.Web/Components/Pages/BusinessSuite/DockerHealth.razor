@page "/admin/docker-health"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "AdminOnly")]
@using Microsoft.AspNetCore.Authorization
@using GwsBusinessSuite.Application.DockerHealth
@using GwsBusinessSuite.Application.DigitalOcean
@using GwsBusinessSuite.Application.Abstractions
@inject IDockerHealthService DockerHealthService
@inject IDigitalOceanService DigitalOceanService
@inject IDropletRemoteDockerService DropletRemoteDockerService
@inject IDockerDeploymentService DockerDeploymentService
@inject IWebHostEnvironment Env
@inject ICurrentUserAccessor CurrentUserAccessor
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<DockerHealth> Logger

<PageTitle>Docker Management</PageTitle>

<PageHeader Title="Docker Management" Icon="bi-box-seam"
            Description="Manage every container on the droplet, and bridge into DigitalOcean for droplet-level actions.">
    <Actions>
        <button type="button" class="btn btn-outline-primary d-inline-flex align-items-center gap-2" @onclick="LoadContainersAsync" disabled="@IsBusy">
            @if (IsBusy)
            {
                <InlineProgress />
            }
            else
            {
                <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
            }
            <span>Refresh Now</span>
        </button>
    </Actions>
</PageHeader>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="alert alert-danger d-flex align-items-start gap-2 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill mt-1 flex-shrink-0"></i>
        <div>@ErrorMessage</div>
    </div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white border-bottom py-3">
        <span class="fw-semibold"><i class="bi bi-cloud-fill me-1 text-secondary"></i>DigitalOcean Connection</span>
    </div>
    <div class="card-body">
        @if (!_doLoaded)
        {
            <ListSkeleton Message="Loading containers…" Grid="true" Rows="6" CssClass="px-0" />
        }
        else
        {
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label small text-secondary">API Token</label>
                    <input type="password" class="form-control" @bind="NewDoApiToken" @bind:event="oninput"
                           placeholder="@GetApiTokenPlaceholder()" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small text-secondary">Droplet ID <span class="text-muted">(optional - auto-detected in production)</span></label>
                    <input type="text" class="form-control" @bind="DoDropletId" @bind:event="oninput" placeholder="Leave blank to auto-detect" />
                </div>
            </div>
            <button class="btn btn-sm btn-primary" @onclick="SaveDoSettingsAsync" disabled="@IsDoSaving">
                @(IsDoSaving ? "Saving…" : "Save Connection")
            </button>
            @if (!string.IsNullOrWhiteSpace(DoSaveMessage))
            {
                <span class="small text-secondary ms-2">@DoSaveMessage</span>
            }

            @if (DropletResult is { Available: true, Droplet: { } droplet })
            {
                <hr />
                <div class="row g-3 align-items-center">
                    <div class="col-md-8">
                        <div class="fw-semibold">@droplet.Name <span class="badge text-bg-success ms-1">@droplet.Status</span></div>
                        <div class="small text-secondary">
                            @droplet.Region &middot; @droplet.Size
                            @if (droplet.VcpuDescription is not null) { <text> &middot; @droplet.VcpuDescription</text> }
                            @if (droplet.MemoryDescription is not null) { <text> &middot; @droplet.MemoryDescription</text> }
                            @if (droplet.DiskDescription is not null) { <text> &middot; @droplet.DiskDescription</text> }
                        </div>
                        @if (droplet.PublicIpAddress is not null)
                        {
                            <div class="small text-secondary">IP: @droplet.PublicIpAddress</div>
                        }
                    </div>
                    <div class="col-md-4 d-flex flex-wrap gap-2 justify-content-md-end">
                        <button class="btn btn-sm btn-outline-danger" @onclick="RebootDropletAsync" disabled="@IsDoActionBusy">Reboot</button>
                        <button class="btn btn-sm btn-outline-warning" @onclick="ShowResizePrompt" disabled="@IsDoActionBusy">Resize</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ShowSnapshotPrompt" disabled="@IsDoActionBusy">Snapshot</button>
                        <button class="btn btn-sm btn-outline-info" @onclick="OpenTerminalWindowAsync">
                            <i class="bi bi-box-arrow-up-right me-1"></i>Terminal
                        </button>
                    </div>
                </div>

                @if (DropletActions.Count > 0)
                {
                    <div class="small text-secondary mt-3">
                        <strong>Recent droplet actions</strong>
                        <ul class="list-unstyled mb-0 mt-1">
                            @foreach (var a in DropletActions.Take(5))
                            {
                                <li>@a.Type &mdash; @a.Status &mdash; @a.StartedAt.ToLocalTime().ToString("dd-MM-yy HH:mm")</li>
                            }
                        </ul>
                    </div>
                }
            }
            else if (DropletResult is { Available: false, UnavailableReason: { } reason })
            {
                <div class="small text-secondary mt-2"><i class="bi bi-info-circle me-1"></i>@reason</div>
            }
        }
    </div>
</div>

@if (HasDoApiToken)
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
            <span class="fw-semibold">
                <i class="bi bi-hdd-stack me-1 text-secondary"></i>Active Droplets &amp; Images
                @if (ActiveDropletsResult is { Available: true } activeResult)
                {
                    <span class="badge text-bg-light border ms-2">@activeResult.Droplets.Count active</span>
                }
            </span>
            <button type="button" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1"
                    @onclick="RefreshActiveDropletsAsync" disabled="@IsLoadingActiveDroplets">
                @if (IsLoadingActiveDroplets)
                {
                    <InlineProgress />
                }
                else
                {
                    <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                }
                <span>Refresh Droplets</span>
            </button>
        </div>
        <div class="card-body">
            @if (IsLoadingActiveDroplets && ActiveDropletsResult is null)
            {
                <LoadingIndicator Message="Inspecting active droplets and images…" CssClass="text-secondary" />
            }
            else if (ActiveDropletsResult is { Available: false, UnavailableReason: { } activeUnavailable })
            {
                <div class="small text-secondary"><i class="bi bi-info-circle me-1"></i>@activeUnavailable</div>
            }
            else if (ActiveDropletsResult is { Available: true, Droplets.Count: 0 })
            {
                <div class="small text-secondary">No active droplets found in this DigitalOcean account.</div>
            }
            else if (ActiveDropletsResult is { Available: true, Droplets: { } activeDroplets })
            {
                <div class="row g-3">
                    @foreach (var d in activeDroplets)
                    {
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <div class="fw-semibold">
                                        @d.Name
                                        @if (d.IsCurrentHost)
                                        {
                                            <span class="badge text-bg-info ms-1">This host</span>
                                        }
                                    </div>
                                    <span class="badge text-bg-success">@d.Status</span>
                                </div>
                                <div class="small text-secondary mb-2">
                                    @d.Region &middot; @d.Size
                                    @if (d.VcpuDescription is not null) { <text> &middot; @d.VcpuDescription</text> }
                                    @if (d.MemoryDescription is not null) { <text> &middot; @d.MemoryDescription</text> }
                                    @if (d.DiskDescription is not null) { <text> &middot; @d.DiskDescription</text> }
                                </div>
                                <div class="small text-secondary mb-2">
                                    @if (d.PublicIpAddress is not null)
                                    {
                                        <span>Public: <code>@d.PublicIpAddress</code></span>
                                    }
                                    @if (d.PrivateIpAddress is not null)
                                    {
                                        <span class="@(d.PublicIpAddress is not null ? "ms-2" : "")">Private: <code>@d.PrivateIpAddress</code></span>
                                    }
                                </div>
                                <div class="small mb-2">
                                    <strong>Droplet Image:</strong> @d.BaseImageName
                                    @if (!string.IsNullOrWhiteSpace(d.BaseImageSlug))
                                    {
                                        <span class="text-secondary"> (<code>@d.BaseImageSlug</code>)</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(d.BaseImageType))
                                    {
                                        <span class="badge text-bg-light border ms-1">@d.BaseImageType</span>
                                    }
                                </div>
                                <div class="small mb-2">
                                    <strong>Active Container Images:</strong>
                                    @if (d.ActiveContainerImages.Count > 0)
                                    {
                                        <ul class="list-unstyled mb-0 mt-1">
                                            @foreach (var img in d.ActiveContainerImages)
                                            {
                                                <li class="mb-2">
                                                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-1">
                                                        <span>
                                                            <span class="fw-medium">@img.ContainerName</span>
                                                            <span class="text-secondary"> &rarr; </span>
                                                            <code>@img.Image</code>
                                                            <span class="text-secondary"> (@img.Status)</span>
                                                        </span>
                                                        <span class="d-inline-flex gap-1">
                                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1"
                                                                    disabled="@IsDropletBusy(d.Id)"
                                                                    @onclick="() => TailRemoteLogsAsync(d, img.ContainerName)">Logs</button>
                                                            <button type="button" class="btn btn-sm btn-outline-primary py-0 px-1"
                                                                    disabled="@IsDropletBusy(d.Id)"
                                                                    @onclick="() => RequestRemoteAction(d, RemoteDropletActionKind.Pull, img.Image)">Pull</button>
                                                            <button type="button" class="btn btn-sm btn-outline-warning py-0 px-1"
                                                                    disabled="@IsDropletBusy(d.Id)"
                                                                    @onclick="() => RequestRemoteAction(d, RemoteDropletActionKind.RestartContainer, img.ContainerName)">Restart</button>
                                                        </span>
                                                    </div>
                                                </li>
                                            }
                                        </ul>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(d.ContainerProbeStatus))
                                    {
                                        <div class="text-secondary mt-1">@d.ContainerProbeStatus</div>
                                    }
                                    else
                                    {
                                        <div class="text-secondary mt-1">No running Docker containers.</div>
                                    }
                                </div>

                                <div class="d-flex flex-wrap gap-1 mt-2">
                                    <button type="button" class="btn btn-sm btn-outline-primary"
                                            disabled="@IsDropletBusy(d.Id)"
                                            @onclick="() => InspectDropletDetailsAsync(d)">
                                        @(IsDropletInspecting(d.Id) ? "Inspecting…" : "Inspect Images & Disk")
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary"
                                            disabled="@IsDropletBusy(d.Id)"
                                            @onclick="() => RequestRemoteAction(d, RemoteDropletActionKind.PruneDangling, null)">
                                        Prune Dangling
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            disabled="@IsDropletBusy(d.Id)"
                                            @onclick="() => RequestRemoteAction(d, RemoteDropletActionKind.PruneStale, null)">
                                        Prune Stale (&gt;7d)
                                    </button>
                                </div>

                                @if (RemoteActionMessages.TryGetValue(d.Id, out var remoteMsg))
                                {
                                    <div class="small mt-2 @(remoteMsg.Succeeded ? "text-success" : "text-danger")">@remoteMsg.Message</div>
                                }

                                @if (DropletInspections.TryGetValue(d.Id, out var inspection))
                                {
                                    <hr class="my-2" />
                                    @if (!inspection.Succeeded)
                                    {
                                        <div class="small text-danger">@inspection.ErrorMessage</div>
                                    }
                                    else
                                    {
                                        @if (inspection.DiskUsage.Count > 0)
                                        {
                                            <div class="small mb-2">
                                                <strong>Docker Disk Usage:</strong>
                                                <div class="table-responsive mt-1">
                                                    <table class="table table-sm mb-0">
                                                        <thead><tr><th>Type</th><th>Total</th><th>Active</th><th>Size</th><th>Reclaimable</th></tr></thead>
                                                        <tbody>
                                                            @foreach (var df in inspection.DiskUsage)
                                                            {
                                                                <tr><td>@df.Type</td><td>@df.TotalCount</td><td>@df.ActiveCount</td><td>@df.Size</td><td>@df.Reclaimable</td></tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        }
                                        @if (inspection.CachedImages.Count > 0)
                                        {
                                            <div class="small mb-2">
                                                <strong>Cached Images (@inspection.CachedImages.Count):</strong>
                                                <ul class="list-unstyled mb-0 mt-1">
                                                    @foreach (var cached in inspection.CachedImages)
                                                    {
                                                        <li>
                                                            <code>@cached.FullName</code>
                                                            <span class="text-secondary"> &middot; @cached.Size &middot; @cached.ImageId</span>
                                                            @if (cached.IsDangling)
                                                            {
                                                                <span class="badge text-bg-warning ms-1">dangling</span>
                                                            }
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        }
                                        @if (inspection.AiRuntime is { Installed: true } ai)
                                        {
                                            <div class="small mb-2">
                                                <div class="d-flex align-items-center justify-content-between gap-2">
                                                    <span>
                                                        <strong>AI Runtime:</strong> Ollama <code>@ai.OllamaServiceState</code>
                                                        &middot; Watchdog <code>@ai.WatchdogTimerState</code>
                                                    </span>
                                                    <button type="button" class="btn btn-sm btn-outline-warning py-0 px-2"
                                                            disabled="@IsDropletBusy(d.Id)"
                                                            @onclick="() => RequestRemoteAction(d, RemoteDropletActionKind.RestartOllama, null)">
                                                        Restart Ollama
                                                    </button>
                                                </div>
                                                @if (ai.Models.Count > 0)
                                                {
                                                    <ul class="list-unstyled mb-0 mt-1">
                                                        @foreach (var m in ai.Models)
                                                        {
                                                            <li><code>@m.Name</code> <span class="text-secondary">&middot; @m.Size</span></li>
                                                        }
                                                    </ul>
                                                }
                                            </div>
                                        }
                                    }
                                }

                                @if (DropletLogs.TryGetValue(d.Id, out var remoteLogs))
                                {
                                    <div class="small mt-2">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <strong>Logs (@remoteLogs.ContainerName)</strong>
                                            <button type="button" class="btn btn-sm btn-link p-0" @onclick="() => DropletLogs.Remove(d.Id)">Close</button>
                                        </div>
                                        <pre class="bg-dark text-light p-2 rounded mt-1 mb-0" style="max-height: 220px; overflow: auto; font-size: 0.75rem;">@remoteLogs.Content</pre>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white border-bottom py-3">
        <span class="fw-semibold"><i class="bi bi-hammer me-1 text-secondary"></i>Build App Image</span>
    </div>
    <div class="card-body">
        <p class="small text-secondary mb-2">
            Rebuilds this app's Docker image from the local <code>Dockerfile</code> using the Docker CLI.
            This only works when running locally with Docker installed — production deploys happen via
            <code>docker compose up -d --build</code> over SSH, not from this button.
        </p>
        <button class="btn btn-sm btn-outline-primary" @onclick="BuildImageAsync" disabled="@IsBuildingImage">
            @if (IsBuildingImage)
            {
                <InlineProgress CssClass="me-1" />
                <span>Building…</span>
            }
            else
            {
                <span>Build Image</span>
            }
        </button>
        @if (!string.IsNullOrWhiteSpace(BuildImageMessage))
        {
            <pre class="small mt-2 mb-0 @(BuildImageSucceeded ? "text-success" : "text-danger")" style="white-space: pre-wrap;">@BuildImageMessage</pre>
        }
    </div>
</div>

@if (!_loaded)
{
    <LoadingIndicator Message="Checking Docker…" CssClass="text-secondary" />
}
else if (!_available)
{
    <div class="alert alert-warning" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-1"></i>
        @UnavailableReason
    </div>
}
else if (Containers.Count == 0)
{
    <EmptyState Icon="bi-box-seam" Title="No containers found"
                Message="The list fills from the droplet's Docker socket. Refresh once the containers are running." />
}
else
{
    <div class="row g-3">
        @foreach (var container in Containers)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm h-100 @StatusTones.Stripe(container.IsError ? StatusTone.Danger : null)">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="fw-semibold">@container.Name</span>
                            <StatusPill Tone="StatusTones.ForContainer(container.IsError, container.State)">@StatusLabel(container)</StatusPill>
                        </div>
                        <div class="small text-secondary mb-1">@container.Image</div>
                        <div class="small text-secondary mb-1">@container.Status</div>
                        @if (container.RestartCount > 0)
                        {
                            <div class="small text-secondary mb-1">Restarts: @container.RestartCount</div>
                        }
                        <div class="d-flex flex-wrap gap-1 mt-2">
                            @if (container.State == "running")
                            {
                                <button class="btn btn-sm btn-outline-secondary" disabled="@IsContainerBusy(container.Name)" @onclick="() => StopAsync(container.Name)">Stop</button>
                                <button class="btn btn-sm btn-outline-secondary" disabled="@IsContainerBusy(container.Name)" @onclick="() => RestartAsync(container.Name)">Restart</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-success" disabled="@IsContainerBusy(container.Name)" @onclick="() => StartAsync(container.Name)">Start</button>
                            }
                            <button class="btn btn-sm btn-outline-primary" disabled="@IsContainerBusy(container.Name)" @onclick="() => PullAsync(container.Name)">Pull Latest</button>
                        </div>
                        @if (ActionMessages.TryGetValue(container.Name, out var msg))
                        {
                            <div class="small mt-2 @(msg.Succeeded ? "text-success" : "text-danger")">@msg.Message</div>
                        }
                        <a href="/admin/docker-health/@Uri.EscapeDataString(container.Name)" class="btn btn-sm btn-outline-secondary mt-2">
                            View Details
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}

<ConfirmModal Show="ShowRebootConfirm"
              Title="Reboot droplet"
              Message="This restarts the entire droplet, taking every container (including this app and any other services running here) down for roughly a minute. Continue?"
              ConfirmText="Reboot" Busy="IsDoActionBusy" OnConfirm="ConfirmRebootDropletAsync" OnCancel="() => ShowRebootConfirm = false" />
<ConfirmModal Show="PendingStopContainerName is not null" Title="Stop container" Message="@($"Stop {PendingStopContainerName}?")"
              ConfirmText="Stop" Busy="@(PendingStopContainerName is not null && IsContainerBusy(PendingStopContainerName))"
              OnConfirm="ConfirmStopAsync" OnCancel="() => PendingStopContainerName = null" />
<ConfirmModal Show="PendingRemoteAction is not null"
              Title="@(PendingRemoteAction?.Title ?? "Confirm remote action")"
              Message="@(PendingRemoteAction?.Message ?? string.Empty)"
              ConfirmText="@(PendingRemoteAction?.ConfirmText ?? "Run")"
              Busy="@(PendingRemoteAction is not null && IsDropletBusy(PendingRemoteAction.Droplet.Id))"
              OnConfirm="ConfirmRemoteActionAsync" OnCancel="() => PendingRemoteAction = null" />

@code {
    private List<ContainerHealthView> Containers { get; set; } = new();
    private bool _loaded;
    private bool _available;
    private string UnavailableReason { get; set; } = string.Empty;
    private bool IsBusy { get; set; }
    private string ErrorMessage { get; set; } = string.Empty;
    private readonly HashSet<string> _busyContainers = new();
    private Dictionary<string, DockerActionResult> ActionMessages { get; } = new();

    private bool IsBuildingImage { get; set; }
    private string BuildImageMessage { get; set; } = string.Empty;
    private bool BuildImageSucceeded { get; set; }

    private bool _doLoaded;
    // Never prefilled from saved settings - the token doesn't round-trip to the
    // browser. A blank value on save means "leave the existing token untouched"
    // (see GetApiTokenPlaceholder and SaveDoSettingsAsync).
    private string NewDoApiToken { get; set; } = string.Empty;
    private string DoDropletId { get; set; } = string.Empty;
    private bool HasDoApiToken { get; set; }
    private bool DoTokenUnreadable { get; set; }
    private bool IsDoSaving { get; set; }
    private bool IsDoActionBusy { get; set; }
    private string DoSaveMessage { get; set; } = string.Empty;
    private DropletInfoResult? DropletResult { get; set; }
    private List<DropletActionView> DropletActions { get; set; } = new();
    private ActiveDropletsImagesResult? ActiveDropletsResult { get; set; }
    private bool IsLoadingActiveDroplets { get; set; }
    private bool ShowRebootConfirm { get; set; }
    private string? PendingStopContainerName { get; set; }
    private readonly HashSet<long> _busyDroplets = new();
    private readonly HashSet<long> _inspectingDroplets = new();
    private Dictionary<long, DropletRemoteInspectionResult> DropletInspections { get; } = new();
    private Dictionary<long, DockerActionResult> RemoteActionMessages { get; } = new();
    private Dictionary<long, (string ContainerName, string Content)> DropletLogs { get; } = new();
    private PendingRemoteDropletAction? PendingRemoteAction { get; set; }

    private enum RemoteDropletActionKind
    {
        Pull,
        RestartContainer,
        PruneDangling,
        PruneStale,
        RestartOllama
    }

    private sealed record PendingRemoteDropletAction(
        ActiveDropletView Droplet,
        RemoteDropletActionKind Kind,
        string? Target,
        string Title,
        string Message,
        string ConfirmText);

    private Task OpenTerminalWindowAsync() => JS.InvokeVoidAsync("gwsSshTerminal.openWindow").AsTask();

    protected override async Task OnInitializedAsync()
    {
        await LoadContainersAsync();
        _loaded = true;
        await LoadDoAsync();
        _doLoaded = true;
    }

    private Task<string> CurrentUserNameAsync() => CurrentUserAccessor.GetCurrentUsernameAsync();

    private async Task LoadContainersAsync()
    {
        IsBusy = true;
        ErrorMessage = string.Empty;
        try
        {
            var result = await DockerHealthService.ListContainersAsync();
            _available = result.Available;
            UnavailableReason = result.UnavailableReason ?? string.Empty;
            Containers = result.Containers.ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to load container health.");
            ErrorMessage = $"Unable to load container health. {ex.Message}";
        }
        finally
        {
            IsBusy = false;
        }
    }

    private string GetApiTokenPlaceholder() => DoTokenUnreadable
        ? "Saved token could not be decrypted - re-enter it"
        : HasDoApiToken ? "A token is already saved. Enter a new token to replace it." : "dop_v1_...";

    private async Task LoadDoAsync()
    {
        var settings = await DigitalOceanService.GetSettingsAsync();
        DoDropletId = settings?.DropletId ?? string.Empty;
        HasDoApiToken = settings?.HasApiToken ?? false;
        DoTokenUnreadable = settings?.ApiTokenUnreadable ?? false;

        if (HasDoApiToken)
        {
            DropletResult = await DigitalOceanService.GetDropletInfoAsync();
            if (DropletResult.Available)
            {
                DropletActions = (await DigitalOceanService.ListRecentActionsAsync()).ToList();
            }
            await RefreshActiveDropletsAsync();
        }
    }

    private async Task RefreshActiveDropletsAsync()
    {
        if (!HasDoApiToken) return;
        IsLoadingActiveDroplets = true;
        try
        {
            ActiveDropletsResult = await DigitalOceanService.ListActiveDropletsWithImagesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Unable to load active DigitalOcean droplets and images.");
            ActiveDropletsResult = new ActiveDropletsImagesResult(false, [], $"Unable to load active droplets: {ex.Message}");
        }
        finally
        {
            IsLoadingActiveDroplets = false;
        }
    }

    private async Task SaveDoSettingsAsync()
    {
        IsDoSaving = true;
        DoSaveMessage = string.Empty;
        try
        {
            await DigitalOceanService.SaveSettingsAsync(new DigitalOceanApiSettingsInput { NewApiToken = NewDoApiToken, DropletId = DoDropletId });
            DoSaveMessage = "Saved.";
            DoTokenUnreadable = false;
            // The textarea reverts to the "already saved" placeholder on reload,
            // same as SshTerminalPanel's private-key field.
            NewDoApiToken = string.Empty;
            HasDoApiToken = true;
            DropletResult = await DigitalOceanService.GetDropletInfoAsync();
            if (DropletResult.Available)
            {
                DropletActions = (await DigitalOceanService.ListRecentActionsAsync()).ToList();
            }
            await RefreshActiveDropletsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to save DigitalOcean settings.");
            DoSaveMessage = $"Failed to save: {ex.Message}";
        }
        finally
        {
            IsDoSaving = false;
        }
    }

    private void RebootDropletAsync() => ShowRebootConfirm = true;

    private async Task ConfirmRebootDropletAsync()
    {
        ShowRebootConfirm = false;

        IsDoActionBusy = true;
        try
        {
            var user = await CurrentUserNameAsync();
            var result = await DigitalOceanService.RebootDropletAsync(user);
            DoSaveMessage = result.Message;
            DropletActions = (await DigitalOceanService.ListRecentActionsAsync()).ToList();
        }
        finally
        {
            IsDoActionBusy = false;
        }
    }

    private async Task ShowResizePrompt()
    {
        var newSize = await JS.InvokeAsync<string?>("gwsPrompt.ask",
            "Enter the target DigitalOcean size slug (e.g. s-2vcpu-4gb). Disk-size changes require the droplet to be powered off; CPU/RAM-only resizes can be applied live.");
        if (string.IsNullOrWhiteSpace(newSize)) return;

        var resizeDisk = await JS.InvokeAsync<bool>("confirm",
            "Also resize the disk? Disk resizes are irreversible and require the droplet to be powered off first. Choose Cancel for a live CPU/RAM-only resize.");

        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Resize droplet to {newSize}{(resizeDisk ? " (including disk)" : "")}. Continue?");
        if (!confirmed) return;

        IsDoActionBusy = true;
        try
        {
            var user = await CurrentUserNameAsync();
            var result = await DigitalOceanService.ResizeDropletAsync(newSize, resizeDisk, user);
            DoSaveMessage = result.Message;
            DropletActions = (await DigitalOceanService.ListRecentActionsAsync()).ToList();
        }
        finally
        {
            IsDoActionBusy = false;
        }
    }

    private async Task ShowSnapshotPrompt()
    {
        var name = await JS.InvokeAsync<string?>("gwsPrompt.ask", "Snapshot name:", $"gwssuite-{DateTime.UtcNow:yyyyMMdd-HHmm}");
        if (string.IsNullOrWhiteSpace(name)) return;

        var confirmed = await JS.InvokeAsync<bool>("confirm",
            "Creating a snapshot can take several minutes. The droplet stays usable throughout. Continue?");
        if (!confirmed) return;

        IsDoActionBusy = true;
        try
        {
            var user = await CurrentUserNameAsync();
            var result = await DigitalOceanService.CreateSnapshotAsync(name, user);
            DoSaveMessage = result.Message;
            DropletActions = (await DigitalOceanService.ListRecentActionsAsync()).ToList();
        }
        finally
        {
            IsDoActionBusy = false;
        }
    }

    private async Task BuildImageAsync()
    {
        IsBuildingImage = true;
        BuildImageMessage = string.Empty;
        try
        {
            // Dockerfile lives at the repo root, two levels above this project's content root.
            var dockerfilePath = Path.GetFullPath(Path.Combine(Env.ContentRootPath, "..", "..", "Dockerfile"));
            var result = await DockerDeploymentService.DeployAsync("gws-business-suite", dockerfilePath);
            BuildImageMessage = result;
            BuildImageSucceeded = result.StartsWith("Docker image", StringComparison.Ordinal);
        }
        finally
        {
            IsBuildingImage = false;
        }
    }

    private bool IsContainerBusy(string name) => _busyContainers.Contains(name);

    private Task StartAsync(string name) => RunContainerActionAsync(name, DockerHealthService.StartContainerAsync);

    private void StopAsync(string name) => PendingStopContainerName = name;

    private async Task ConfirmStopAsync()
    {
        if (PendingStopContainerName is not { } name) return;
        PendingStopContainerName = null;
        await RunContainerActionAsync(name, DockerHealthService.StopContainerAsync);
    }

    private Task RestartAsync(string name) => RunContainerActionAsync(name, DockerHealthService.RestartContainerAsync);

    private Task PullAsync(string name) => RunContainerActionAsync(name, DockerHealthService.PullImageAsync);

    private async Task RunContainerActionAsync(string name, Func<string, string, CancellationToken, Task<DockerActionResult>> action)
    {
        _busyContainers.Add(name);
        StateHasChanged();
        try
        {
            var user = await CurrentUserNameAsync();
            var result = await action(name, user, CancellationToken.None);
            ActionMessages[name] = result;
            await LoadContainersAsync();
        }
        finally
        {
            _busyContainers.Remove(name);
        }
    }

    private static string StatusLabel(ContainerHealthView c) =>
        c.IsError ? "Error" : c.State;

    private bool IsDropletBusy(long dropletId) => _busyDroplets.Contains(dropletId);

    private bool IsDropletInspecting(long dropletId) => _inspectingDroplets.Contains(dropletId);

    private async Task InspectDropletDetailsAsync(ActiveDropletView droplet)
    {
        _busyDroplets.Add(droplet.Id);
        _inspectingDroplets.Add(droplet.Id);
        StateHasChanged();
        try
        {
            DropletInspections[droplet.Id] = await DropletRemoteDockerService.InspectDropletAsync(droplet);
        }
        finally
        {
            _inspectingDroplets.Remove(droplet.Id);
            _busyDroplets.Remove(droplet.Id);
        }
    }

    private async Task TailRemoteLogsAsync(ActiveDropletView droplet, string containerName)
    {
        _busyDroplets.Add(droplet.Id);
        StateHasChanged();
        try
        {
            var result = await DropletRemoteDockerService.TailContainerLogsAsync(droplet, containerName);
            DropletLogs[droplet.Id] = result.Succeeded
                ? (containerName, result.Logs)
                : (containerName, result.ErrorMessage ?? "Could not fetch logs.");
        }
        finally
        {
            _busyDroplets.Remove(droplet.Id);
        }
    }

    private void RequestRemoteAction(ActiveDropletView droplet, RemoteDropletActionKind kind, string? target)
    {
        PendingRemoteAction = kind switch
        {
            RemoteDropletActionKind.Pull => new(droplet, kind, target, "Pull image on droplet",
                $"Pull latest {target} on {droplet.Name}?", "Pull"),
            RemoteDropletActionKind.RestartContainer => new(droplet, kind, target, "Restart container on droplet",
                $"Restart container {target} on {droplet.Name}?", "Restart"),
            RemoteDropletActionKind.PruneDangling => new(droplet, kind, target, "Prune dangling images",
                $"Remove untagged (<none>) dangling Docker image layers on {droplet.Name}?", "Prune Dangling"),
            RemoteDropletActionKind.PruneStale => new(droplet, kind, target, "Prune stale unused images",
                $"Remove unused Docker images older than 7 days on {droplet.Name}? Recent rollback tags are preserved.", "Prune Stale"),
            RemoteDropletActionKind.RestartOllama => new(droplet, kind, target, "Restart Ollama service",
                $"Restart the ollama systemd service on {droplet.Name}?", "Restart Ollama"),
            _ => null
        };
    }

    private async Task ConfirmRemoteActionAsync()
    {
        if (PendingRemoteAction is not { } pending) return;
        PendingRemoteAction = null;
        _busyDroplets.Add(pending.Droplet.Id);
        StateHasChanged();
        try
        {
            var user = await CurrentUserNameAsync();
            var result = pending.Kind switch
            {
                RemoteDropletActionKind.Pull => await DropletRemoteDockerService.PullImageAsync(pending.Droplet, pending.Target!, user),
                RemoteDropletActionKind.RestartContainer => await DropletRemoteDockerService.RestartContainerAsync(pending.Droplet, pending.Target!, user),
                RemoteDropletActionKind.PruneDangling => await DropletRemoteDockerService.PruneDanglingImagesAsync(pending.Droplet, user),
                RemoteDropletActionKind.PruneStale => await DropletRemoteDockerService.PruneStaleImagesAsync(pending.Droplet, user),
                RemoteDropletActionKind.RestartOllama => await DropletRemoteDockerService.RestartOllamaAsync(pending.Droplet, user),
                _ => new DockerActionResult(false, "Unknown action.")
            };
            RemoteActionMessages[pending.Droplet.Id] = result;
            if (result.Succeeded)
            {
                DropletInspections[pending.Droplet.Id] = await DropletRemoteDockerService.InspectDropletAsync(pending.Droplet);
                await RefreshActiveDropletsAsync();
            }
        }
        finally
        {
            _busyDroplets.Remove(pending.Droplet.Id);
        }
    }

}
