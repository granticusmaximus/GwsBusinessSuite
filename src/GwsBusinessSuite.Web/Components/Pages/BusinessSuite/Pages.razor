@page "/admin/pages"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "ContributorAccess")]
@using Microsoft.AspNetCore.Authorization
@using GwsBusinessSuite.Application.CmsBuilder
@using GwsBusinessSuite.Domain.Entities
@inject ICmsBuilderService CmsBuilderService
@inject NavigationManager Navigation
@inject GwsBusinessSuite.Web.Services.CurrentCmsSiteAccessor CurrentCmsSiteAccessor
@inject ILogger<Pages> Logger

<PageTitle>Pages</PageTitle>

<div class="page-header d-flex flex-wrap align-items-start justify-content-between gap-3">
    <div>
        <h1><i class="bi bi-layout-three-columns me-2 text-primary"></i>Pages</h1>
        <p>Create, edit, and preview pages on @(CurrentSite?.Name ?? "the live site").</p>
    </div>
    <CmsSiteSwitcher SiteChanged="OnSiteChangedAsync" />
</div>

@if (!string.IsNullOrWhiteSpace(CmsErrorMessage))
{
    <div class="alert alert-danger d-flex align-items-start gap-2 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill mt-1 flex-shrink-0"></i>
        <div>@CmsErrorMessage</div>
    </div>
}
@if (!string.IsNullOrWhiteSpace(CmsStatusMessage))
{
    <div class="alert alert-success d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-check-circle-fill flex-shrink-0"></i>
        <div>@CmsStatusMessage</div>
    </div>
}

@if (IsLoading)
{
    <LoadingIndicator Message="Loading pages…" />
}
else
{

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center gap-3">
        <div>
            <div class="fw-semibold">@(ShowTrash ? "Trash" : "Pages")</div>
            <div class="small text-secondary">@(ShowTrash ? "Restore a page or delete it permanently." : "Create, edit, and preview pages on this site.")</div>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-sm @(ShowTrash ? "btn-secondary" : "btn-outline-secondary")" @onclick="ToggleTrashViewAsync" disabled="@IsCmsBusy">
                <i class="bi bi-trash3 me-1"></i>Trash@(TrashedPages.Count > 0 ? $" ({TrashedPages.Count})" : "")
            </button>
            @if (!ShowTrash)
            {
                <button class="btn btn-sm btn-outline-primary" @onclick="CreateNewPageAsync" disabled="@(IsCmsBusy || !SelectedSiteId.HasValue)">
                    <i class="bi bi-file-earmark-plus me-1"></i>New Page
                </button>
            }
        </div>
    </div>
    <div class="card-body p-0">
        @if (ShowTrash)
        {
            @if (TrashedPages.Count == 0)
            {
                <EmptyState Icon="bi-trash3" Message="Trash is empty." />
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var trashedPage in TrashedPages)
                    {
                        <div class="list-group-item wp-list-row">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div>
                                    <div class="fw-semibold">@trashedPage.Title</div>
                                    <div class="small text-secondary">/@trashedPage.Slug &middot; trashed @trashedPage.TrashedAt?.ToLocalTime().ToString("g")</div>
                                </div>
                                <div class="d-flex gap-1 flex-shrink-0 wp-row-actions">
                                    <button class="btn btn-xs btn-outline-primary" @onclick="() => RestoreTrashedPageAsync(trashedPage.Id)" disabled="@IsCmsBusy">Restore</button>
                                    <button class="btn btn-xs btn-outline-danger" @onclick="() => PermanentlyDeleteTrashedPageAsync(trashedPage.Id)" disabled="@IsCmsBusy">Delete Permanently</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else if (CmsPages.Count == 0)
        {
            <EmptyState Icon="bi-layout-three-columns" Message="No pages exist for this site yet." />
        }
        else
        {
            <div class="d-flex flex-wrap align-items-center gap-2 p-2 border-bottom">
                <input type="search" class="form-control form-control-sm" style="max-width:16rem;"
                       placeholder="Search title or path..." value="@SearchText" @oninput="OnSearchInput" />
                <select class="form-select form-select-sm" style="max-width:10rem;" value="@StatusFilter" @onchange="OnStatusFilterChange">
                    <option value="All">All statuses</option>
                    <option value="@CmsPageStatuses.Published">Published</option>
                    <option value="@CmsPageStatuses.Draft">Draft</option>
                </select>
                @if (SelectedPageIdsForBulk.Count > 0)
                {
                    <button class="btn btn-sm btn-outline-danger" @onclick="BulkTrashSelectedPagesAsync" disabled="@IsCmsBusy">
                        <i class="bi bi-trash3 me-1"></i>Move to Trash
                    </button>
                    <span class="small text-secondary">@SelectedPageIdsForBulk.Count selected</span>
                }
            </div>
            @if (VisiblePages().Count == 0)
            {
                <EmptyState Icon="bi-search" Message="No pages match your search." />
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var cmsPage in VisiblePages())
                    {
                        var depth = IsFiltered ? 0 : GetPageDepth(cmsPage);
                        <div class="list-group-item d-flex align-items-center gap-2 wp-list-row p-0">
                            <input type="checkbox" class="form-check-input flex-shrink-0 ms-3" checked="@SelectedPageIdsForBulk.Contains(cmsPage.Id)"
                                   @onchange="e => TogglePageSelect(cmsPage.Id, (bool)(e.Value ?? false))" />
                            <button type="button"
                                    class="list-group-item-action bg-transparent border-0 text-start flex-grow-1 py-2 pe-3"
                                    style="padding-left:@(0.5 + depth * 1.25)rem;"
                                    @onclick="() => OpenPageEditor(cmsPage.Id)"
                                    disabled="@IsCmsBusy">
                                <div class="fw-semibold d-flex align-items-center gap-2">
                                    @(depth > 0 ? "— " : "")@cmsPage.Title
                                    @if (IsScheduled(cmsPage))
                                    {
                                        <span class="badge text-bg-info">Scheduled for @cmsPage.PublishedAt?.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</span>
                                    }
                                    else if (cmsPage.Status != CmsPageStatuses.Published)
                                    {
                                        <span class="badge text-bg-secondary">Draft</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(cmsPage.DraftBlocksJson))
                                    {
                                        @* Otherwise an unpublished draft is invisible from here and
                                           the live page quietly stays stale. *@
                                        <span class="badge text-bg-warning">Unpublished changes</span>
                                    }
                                </div>
                                <div class="small text-secondary">/@BuildFullPath(cmsPage)</div>
                            </button>
                            @* WordPress-style row actions. "Edit" goes straight to the visual
                               editor - reaching it used to mean opening a metadata form first
                               and finding a button below the fold. *@
                            <div class="d-flex gap-2 flex-shrink-0 wp-row-actions me-3">
                                <a href="/admin/pages/@cmsPage.Id/edit">Edit</a>
                                <a href="/admin/pages/@cmsPage.Id/edit?panel=page">Settings</a>
                                <a href="@BuildLiveUrl(cmsPage)" target="_blank" rel="noopener noreferrer">View</a>
                                <button type="button" class="text-danger"
                                        @onclick="() => TrashPageAsync(cmsPage.Id)" disabled="@IsCmsBusy">Trash</button>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

}

<ConfirmModal Show="PendingBulkTrashCount.HasValue" Title="Move to Trash" Message="@($"Move {PendingBulkTrashCount} page(s) to Trash?")"
              ConfirmText="Move to Trash" Busy="IsCmsBusy" OnConfirm="ConfirmBulkTrashSelectedPagesAsync" OnCancel="() => PendingBulkTrashCount = null" />
<ConfirmModal Show="PendingDeletePageId.HasValue" Title="Delete page permanently" Message="Permanently delete this page? This cannot be undone."
              ConfirmText="Delete Permanently" Busy="IsCmsBusy" OnConfirm="ConfirmPermanentlyDeleteTrashedPageAsync" OnCancel="() => PendingDeletePageId = null" />

@code {
    private CmsSite? CurrentSite { get; set; }
    private List<CmsPage> CmsPages { get; set; } = new();
    private List<CmsPage> TrashedPages { get; set; } = new();
    private HashSet<Guid> SelectedPageIdsForBulk { get; set; } = new();
    private Guid? SelectedSiteId { get; set; }
    private bool ShowTrash { get; set; }
    private bool IsLoading { get; set; } = true;
    private bool IsCmsBusy { get; set; }
    private int? PendingBulkTrashCount { get; set; }
    private Guid? PendingDeletePageId { get; set; }
    private string CmsStatusMessage { get; set; } = string.Empty;
    private string CmsErrorMessage { get; set; } = string.Empty;
    private string SearchText { get; set; } = string.Empty;
    private string StatusFilter { get; set; } = "All";

    // Populated as a side effect of OrderedPagesByHierarchy's single tree walk, so
    // GetPageDepth is an O(1) lookup instead of rebuilding a full id->page map and
    // re-walking ancestors on every call (it's invoked 2-3x per row per render).
    private readonly Dictionary<Guid, int> _pageDepths = new();

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        CmsErrorMessage = string.Empty;

        try
        {
            await LoadCurrentSiteAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to load pages.");
            CmsErrorMessage = $"Unable to load pages. {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task LoadCurrentSiteAsync()
    {
        var site = await CurrentCmsSiteAccessor.GetCurrentSiteAsync();

        CurrentSite = site;
        SelectedSiteId = site.Id;
        CmsPages = (await CmsBuilderService.ListPagesAsync(site.Id)).ToList();
        TrashedPages = (await CmsBuilderService.ListTrashedPagesAsync(site.Id)).ToList();
    }

    private async Task OnSiteChangedAsync(CmsSite site)
    {
        IsCmsBusy = true;
        try
        {
            CurrentSite = site;
            SelectedSiteId = site.Id;
            ShowTrash = false;
            SelectedPageIdsForBulk.Clear();
            CmsPages = (await CmsBuilderService.ListPagesAsync(site.Id)).ToList();
            TrashedPages = (await CmsBuilderService.ListTrashedPagesAsync(site.Id)).ToList();
            CmsStatusMessage = $"Now managing {site.Name}.";
        }
        finally
        {
            IsCmsBusy = false;
        }
    }

    private List<CmsPage> OrderedPagesByHierarchy()
    {
        var byParent = CmsPages.ToLookup(p => p.ParentPageId);
        var result = new List<CmsPage>();
        _pageDepths.Clear();

        void Visit(Guid? parentId, int depth)
        {
            foreach (var page in byParent[parentId])
            {
                _pageDepths[page.Id] = depth;
                result.Add(page);
                Visit(page.Id, depth + 1);
            }
        }

        Visit(null, 0);
        return result;
    }

    private int GetPageDepth(CmsPage page)
    {
        if (_pageDepths.Count == 0)
        {
            OrderedPagesByHierarchy();
        }

        return _pageDepths.GetValueOrDefault(page.Id);
    }

    private bool IsFiltered => !string.IsNullOrWhiteSpace(SearchText) || StatusFilter != "All";

    private List<CmsPage> VisiblePages() => IsFiltered ? FilteredPages() : OrderedPagesByHierarchy();

    private List<CmsPage> FilteredPages()
    {
        IEnumerable<CmsPage> query = CmsPages;

        if (StatusFilter != "All")
        {
            query = query.Where(p => p.Status == StatusFilter);
        }

        if (!string.IsNullOrWhiteSpace(SearchText))
        {
            query = query.Where(p =>
                p.Title.Contains(SearchText, StringComparison.OrdinalIgnoreCase)
                || BuildFullPath(p).Contains(SearchText, StringComparison.OrdinalIgnoreCase));
        }

        return query.OrderBy(p => p.Title, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private void OnSearchInput(ChangeEventArgs e) => SearchText = e.Value?.ToString() ?? string.Empty;

    private void OnStatusFilterChange(ChangeEventArgs e) => StatusFilter = e.Value?.ToString() ?? "All";

    private string BuildFullPath(CmsPage page) => CmsBuilderService.BuildFullPath(page, CmsPages);

    private static bool IsScheduled(CmsPage page) =>
        page.Status == CmsPageStatuses.Published
        && page.PublishedAt is { } publishAt
        && publishAt > DateTimeOffset.UtcNow;

    // Content-first: create the draft immediately and open the editor on it, rather than making
    // someone fill in slug/SEO/canonical before they can write anything. The page is a Draft with
    // no content, so nothing is public until they publish - the same auto-draft move WordPress,
    // Squarespace and Wikipedia all make.
    private async Task CreateNewPageAsync()
    {
        if (!SelectedSiteId.HasValue) return;

        IsCmsBusy = true;
        CmsErrorMessage = string.Empty;
        try
        {
            var created = await CmsBuilderService.SavePageAsync(new CmsPageEditorModel
            {
                SiteId = SelectedSiteId,
                Title = "Untitled page",
                BlocksJson = "{\"sections\":[]}",
                Status = CmsPageStatuses.Draft
            });
            Navigation.NavigateTo($"/admin/pages/{created.Id}/edit");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to create a new page.");
            CmsErrorMessage = $"Could not create the page. {ex.Message}";
            IsCmsBusy = false;
        }
    }

    // Both the row body and the "Edit" action land in the visual editor now; the old
    // /admin/pages/edit/{id} metadata form is a redirect into it (see EditPage.razor).
    private void OpenPageEditor(Guid pageId) => Navigation.NavigateTo($"/admin/pages/{pageId}/edit");

    private string BuildLiveUrl(CmsPage page) =>
        CurrentSite is null ? "#" : $"/cms/{CurrentSite.Slug}/{BuildFullPath(page)}";

    private async Task TrashPageAsync(Guid pageId)
    {
        if (!SelectedSiteId.HasValue) return;

        var siteId = SelectedSiteId.Value;
        IsCmsBusy = true;
        CmsErrorMessage = string.Empty;
        CmsStatusMessage = string.Empty;
        try
        {
            var title = CmsPages.FirstOrDefault(p => p.Id == pageId)?.Title ?? "Page";
            await CmsBuilderService.TrashPageAsync(pageId);
            CmsPages = (await CmsBuilderService.ListPagesAsync(siteId)).ToList();
            TrashedPages = (await CmsBuilderService.ListTrashedPagesAsync(siteId)).ToList();
            CmsStatusMessage = $"Moved '{title}' to Trash.";
        }
        catch (Exception ex)
        {
            // Same reason the bulk path collects failures: a page with active children refuses.
            Logger.LogError(ex, "Failed to trash page {PageId}.", pageId);
            CmsErrorMessage = ex.Message;
        }
        finally
        {
            IsCmsBusy = false;
        }
    }

    private void TogglePageSelect(Guid pageId, bool selected)
    {
        if (selected) SelectedPageIdsForBulk.Add(pageId);
        else SelectedPageIdsForBulk.Remove(pageId);
    }

    private void BulkTrashSelectedPagesAsync()
    {
        if (SelectedPageIdsForBulk.Count == 0 || !SelectedSiteId.HasValue) return;
        PendingBulkTrashCount = SelectedPageIdsForBulk.Count;
    }

    private async Task ConfirmBulkTrashSelectedPagesAsync()
    {
        PendingBulkTrashCount = null;
        if (!SelectedSiteId.HasValue) return;

        var siteId = SelectedSiteId.Value;
        var ids = SelectedPageIdsForBulk.ToList();
        IsCmsBusy = true;
        CmsErrorMessage = string.Empty;
        CmsStatusMessage = string.Empty;
        var failures = new List<string>();

        foreach (var pageId in ids)
        {
            try
            {
                await CmsBuilderService.TrashPageAsync(pageId);
            }
            catch (Exception ex)
            {
                // A page with active (non-trashed) children throws — collect and keep
                // going so one blocked page doesn't stop the rest of the bulk action.
                failures.Add($"{CmsPages.FirstOrDefault(p => p.Id == pageId)?.Title ?? pageId.ToString()}: {ex.Message}");
            }
        }

        SelectedPageIdsForBulk.Clear();
        CmsPages = (await CmsBuilderService.ListPagesAsync(siteId)).ToList();
        TrashedPages = (await CmsBuilderService.ListTrashedPagesAsync(siteId)).ToList();

        if (failures.Count > 0)
        {
            CmsErrorMessage = string.Join(" ", failures);
        }
        else
        {
            CmsStatusMessage = $"Moved {ids.Count} page(s) to Trash.";
        }

        IsCmsBusy = false;
    }

    private async Task ToggleTrashViewAsync()
    {
        ShowTrash = !ShowTrash;
        if (ShowTrash && SelectedSiteId.HasValue)
        {
            IsCmsBusy = true;
            try
            {
                TrashedPages = (await CmsBuilderService.ListTrashedPagesAsync(SelectedSiteId.Value)).ToList();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Unable to load trashed pages.");
                CmsErrorMessage = $"Unable to load Trash. {ex.Message}";
            }
            finally
            {
                IsCmsBusy = false;
            }
        }
    }

    private async Task RestoreTrashedPageAsync(Guid pageId)
    {
        if (!SelectedSiteId.HasValue) return;

        IsCmsBusy = true;
        CmsErrorMessage = string.Empty;
        CmsStatusMessage = string.Empty;

        try
        {
            await CmsBuilderService.RestorePageAsync(pageId);
            TrashedPages = (await CmsBuilderService.ListTrashedPagesAsync(SelectedSiteId.Value)).ToList();
            CmsPages = (await CmsBuilderService.ListPagesAsync(SelectedSiteId.Value)).ToList();
            CmsStatusMessage = "Restored the page from Trash.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to restore CMS page {PageId}.", pageId);
            CmsErrorMessage = $"Unable to restore page. {ex.Message}";
        }
        finally
        {
            IsCmsBusy = false;
        }
    }

    private void PermanentlyDeleteTrashedPageAsync(Guid pageId)
    {
        if (!SelectedSiteId.HasValue) return;
        PendingDeletePageId = pageId;
    }

    private async Task ConfirmPermanentlyDeleteTrashedPageAsync()
    {
        if (PendingDeletePageId is not Guid pageId) return;
        PendingDeletePageId = null;
        if (!SelectedSiteId.HasValue) return;

        IsCmsBusy = true;
        CmsErrorMessage = string.Empty;
        CmsStatusMessage = string.Empty;

        try
        {
            await CmsBuilderService.DeletePageAsync(pageId);
            TrashedPages = (await CmsBuilderService.ListTrashedPagesAsync(SelectedSiteId.Value)).ToList();
            CmsStatusMessage = "Permanently deleted the page.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to permanently delete CMS page {PageId}.", pageId);
            CmsErrorMessage = $"Unable to permanently delete page. {ex.Message}";
        }
        finally
        {
            IsCmsBusy = false;
        }
    }
}
