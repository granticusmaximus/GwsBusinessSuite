@page "/admin/crm/contacts/{ContactId:guid}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "AdminOnly")]
@using GwsBusinessSuite.Application.Billing
@using GwsBusinessSuite.Application.Campaigns
@using GwsBusinessSuite.Application.CmsBuilder
@using GwsBusinessSuite.Application.Crm
@using GwsBusinessSuite.Application.Scheduling
@using GwsBusinessSuite.Application.Support
@using GwsBusinessSuite.Domain.Entities
@inject ICrmService CrmService
@inject ISupportTicketService SupportTicketService
@inject IBillingService BillingService
@inject IBookingService BookingService
@inject IFormSubmissionService FormSubmissionService
@inject IEmailCampaignService EmailCampaignService
@inject IContactTimelineService ContactTimelineService
@inject GwsBusinessSuite.Application.TimeTracking.ITimeTrackingService TimeTrackingService
@inject GwsBusinessSuite.Application.Abstractions.ICurrentUserAccessor CurrentUserAccessor
@inject NavigationManager Navigation
@inject ILogger<ContactDetail> Logger

<PageTitle>@(Contact?.FullName ?? "Contact") · CRM</PageTitle>

<div class="page-header">
    <p class="mb-1"><a href="/admin/crm"><i class="bi bi-arrow-left me-1"></i>Back to CRM</a></p>
    <h1><i class="bi bi-person-vcard me-2 text-primary"></i>@(Contact?.FullName ?? "Contact")</h1>
</div>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="alert alert-danger d-flex align-items-start gap-2" role="alert">
        <i class="bi bi-exclamation-triangle-fill mt-1 flex-shrink-0"></i>
        <div>@ErrorMessage</div>
    </div>
}
@if (!string.IsNullOrWhiteSpace(StatusMessage))
{
    <div class="alert alert-success d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-check-circle-fill flex-shrink-0"></i>
        <div>@StatusMessage</div>
    </div>
}

@if (IsLoading)
{
    <LoadingIndicator Message="Loading contact…" CssClass="text-secondary" />
}
else if (Contact is null)
{
    <div class="alert alert-warning" role="alert">This contact no longer exists — it may have been deleted or trashed.</div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3"><span class="fw-semibold">Details</span></div>
                <div class="card-body">
                    <EditForm Model="Editor" OnValidSubmit="SaveAsync">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Full Name</label>
                                <InputText class="form-control" @bind-Value="Editor.FullName" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Status</label>
                                <InputSelect class="form-select" @bind-Value="Editor.Status">
                                    @foreach (var option in ContactStatuses.All)
                                    {
                                        <option value="@option">@option</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Email</label>
                                <InputText class="form-control" @bind-Value="Editor.Email" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Company</label>
                                <InputText class="form-control" @bind-Value="Editor.Company" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Follow-up Date <span class="text-muted">(optional)</span></label>
                                <InputDate class="form-control" @bind-Value="Editor.FollowUpDate" />
                            </div>
                        </div>
                        <div class="mt-3 d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-primary" disabled="@IsBusy">
                                <i class="bi bi-floppy-fill me-1"></i>Save
                            </button>
                            <button type="button" class="btn btn-outline-danger" @onclick="TrashAsync" disabled="@IsBusy">
                                Move to Trash
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3"><span class="fw-semibold">Notes &amp; Activity</span></div>
                <div class="card-body">
                    <div class="d-flex gap-2 mb-3">
                        <input class="form-control" placeholder="Log a call, email, or note..."
                               value="@NewActivityNote" @oninput="e => NewActivityNote = e.Value?.ToString() ?? string.Empty"
                               @onkeydown="OnActivityNoteKeyDown" />
                        <button class="btn btn-outline-primary flex-shrink-0" @onclick="AddActivityAsync" disabled="@(IsBusy || string.IsNullOrWhiteSpace(NewActivityNote))">
                            <i class="bi bi-plus-lg me-1"></i>Log
                        </button>
                    </div>
                    @if (Activities.Count == 0)
                    {
                        <p class="text-secondary mb-0">No activity logged yet.</p>
                    }
                    else
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var activity in Activities)
                            {
                                <li class="mb-2 pb-2 border-bottom">
                                    <div>@activity.Note</div>
                                    <div class="small text-secondary">@activity.CreatedBy &middot; @activity.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">Deals</span>
                    <a class="small" href="/admin/crm">Manage in Pipeline</a>
                </div>
                <div class="list-group list-group-flush">
                    @if (Deals.Count == 0)
                    {
                        <EmptyState Icon="bi-kanban" Message="No deals yet." CssClass="p-3 text-secondary small" />
                    }
                    else
                    {
                        @foreach (var deal in Deals)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center gap-2">
                                <div>
                                    <div class="fw-semibold small">@deal.Title</div>
                                    <div class="small text-secondary">@deal.Stage</div>
                                </div>
                                <span class="small">@deal.ValueUsd.ToString("C0")</span>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">Support Tickets</span>
                    <a class="small" href="/admin/support">Open Support</a>
                </div>
                <div class="list-group list-group-flush">
                    @if (Tickets.Count == 0)
                    {
                        <EmptyState Icon="bi-life-preserver" Message="No support tickets." CssClass="p-3 text-secondary small" />
                    }
                    else
                    {
                        @foreach (var ticket in Tickets)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center gap-2">
                                <div class="fw-semibold small">@ticket.Subject</div>
                                <span class="badge text-bg-secondary">@ticket.Status</span>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">Invoices</span>
                    <a class="small" href="/admin/billing">Open Billing</a>
                </div>
                <div class="list-group list-group-flush">
                    @if (Invoices.Count == 0)
                    {
                        <EmptyState Icon="bi-receipt" Message="No invoices." CssClass="p-3 text-secondary small" />
                    }
                    else
                    {
                        @foreach (var invoice in Invoices)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center gap-2">
                                <div class="fw-semibold small">@invoice.Title</div>
                                <span class="small">@invoice.TotalUsd.ToString("C0") &middot; @invoice.Status</span>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">Bookings</span>
                    <a class="small" href="/admin/scheduling">Open Scheduling</a>
                </div>
                <div class="list-group list-group-flush">
                    @if (Bookings.Count == 0)
                    {
                        <EmptyState Icon="bi-calendar2-check" Message="No bookings." CssClass="p-3 text-secondary small" />
                    }
                    else
                    {
                        @foreach (var booking in Bookings)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center gap-2">
                                <div class="fw-semibold small">@booking.BookingTypeTitle</div>
                                <span class="small">@booking.StartsAt.ToLocalTime().ToString("MMM d, yyyy") &middot; @booking.Status</span>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">Email Campaigns</span>
                    <a class="small" href="/admin/email-campaigns">Open Email Campaigns</a>
                </div>
                <div class="list-group list-group-flush">
                    @if (Enrollments.Count == 0)
                    {
                        <EmptyState Icon="bi-envelope-paper" Message="No campaign enrollments." CssClass="p-3 text-secondary small" />
                    }
                    else
                    {
                        @foreach (var enrollment in Enrollments)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center gap-2">
                                <div>
                                    <div class="fw-semibold small">@enrollment.CampaignName</div>
                                    <div class="small text-secondary">
                                        @if (enrollment.NextSendAt is { } nextSendAt)
                                        {
                                            @($"Next send {nextSendAt.ToLocalTime():MMM d, yyyy}")
                                        }
                                        else if (enrollment.CompletedAt is { } completedAt)
                                        {
                                            @($"Completed {completedAt.ToLocalTime():MMM d, yyyy}")
                                        }
                                        else
                                        {
                                            @($"Step {enrollment.NextStepIndex + 1} of {enrollment.TotalSteps}")
                                        }
                                    </div>
                                </div>
                                <span class="badge text-bg-secondary">@enrollment.Status</span>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">Time</span>
                    <a class="small" href="/admin/time?contact=@ContactId">Track time</a>
                </div>
                <div class="card-body">
                    @{ var unbilled = TimeEntries.Where(t => t.Billable && t.InvoiceId is null && !t.IsRunning).ToList(); }
                    <div class="small mb-2">
                        @TimeEntries.Sum(t => t.Minutes / 60m).ToString("0.##") h tracked in total ·
                        <strong>@unbilled.Sum(t => t.Minutes / 60m).ToString("0.##") h unbilled (@unbilled.Sum(t => t.AmountUsd).ToString("C2"))</strong>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="BillTimeAsync" disabled="@(IsBusy || unbilled.Count == 0)">
                        <i class="bi bi-receipt me-1"></i>Create draft invoice from unbilled time
                    </button>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3"><span class="fw-semibold">Form Submissions</span></div>
                <div class="list-group list-group-flush">
                    @if (FormSubmissions.Count == 0)
                    {
                        <EmptyState Icon="bi-clipboard-data" Message="No linked form submissions." CssClass="p-3 text-secondary small" />
                    }
                    else
                    {
                        @foreach (var submission in FormSubmissions)
                        {
                            <a class="list-group-item list-group-item-action" href="/admin/form-submissions/@submission.Id">
                                <div class="small">@submission.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</div>
                            </a>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mt-4">
        <div class="card-header bg-white border-bottom py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span class="fw-semibold">History <span class="text-secondary small fw-normal">everything with this contact, newest first</span></span>
            <div class="d-flex flex-wrap gap-1" role="group" aria-label="Filter history">
                <button type="button" class="btn btn-sm @(HistoryFilter is null ? "btn-primary" : "btn-outline-secondary")" @onclick="() => SetHistoryFilter(null)">All @History.Count</button>
                @foreach (var kind in ContactTimelineKinds.All.Where(k => History.Any(e => e.Kind == k)))
                {
                    <button type="button" class="btn btn-sm @(HistoryFilter == kind ? "btn-primary" : "btn-outline-secondary")"
                            @onclick="() => SetHistoryFilter(kind)">@ContactTimelineKinds.Label(kind) @History.Count(e => e.Kind == kind)</button>
                }
            </div>
        </div>
        <ul class="list-group list-group-flush">
            @if (FilteredHistory.Count == 0)
            {
                <li class="list-group-item text-secondary small">Nothing yet.</li>
            }
            @foreach (var entry in FilteredHistory.Take(HistoryShown))
            {
                <li class="list-group-item d-flex gap-3 align-items-start">
                    <i class="bi @HistoryIcon(entry.Kind) text-secondary mt-1" aria-hidden="true"></i>
                    <div class="flex-grow-1 text-break">
                        <div>@if (entry.Link is { } link) { <a href="@link">@entry.Title</a> } else { @entry.Title }</div>
                        @if (!string.IsNullOrWhiteSpace(entry.Detail))
                        {
                            <div class="small text-secondary text-break">@entry.Detail</div>
                        }
                    </div>
                    <div class="small text-secondary text-nowrap">@entry.At.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</div>
                </li>
            }
            @if (FilteredHistory.Count > HistoryShown)
            {
                <li class="list-group-item">
                    <button type="button" class="btn btn-sm btn-link p-0" @onclick="() => HistoryShown += HistoryPageSize">Show @Math.Min(HistoryPageSize, FilteredHistory.Count - HistoryShown) more</button>
                </li>
            }
        </ul>
    </div>
}

<ConfirmModal Show="ShowTrashConfirm" Title="Move to Trash" Message="Move this contact to Trash?"
              ConfirmText="Move to Trash" Busy="IsBusy" OnConfirm="ConfirmTrashAsync" OnCancel="CancelTrash" />

@code {
    [Parameter] public Guid ContactId { get; set; }

    private Contact? Contact { get; set; }
    private ContactEditorModel Editor { get; set; } = new();
    private List<ContactActivityView> Activities { get; set; } = new();
    private List<DealView> Deals { get; set; } = new();
    private List<SupportTicketView> Tickets { get; set; } = new();
    private List<InvoiceView> Invoices { get; set; } = new();
    private List<BookingView> Bookings { get; set; } = new();
    private List<EmailCampaignEnrollmentForContactView> Enrollments { get; set; } = new();
    private List<FormSubmission> FormSubmissions { get; set; } = new();
    private string NewActivityNote { get; set; } = string.Empty;
    private bool IsLoading { get; set; } = true;
    private bool IsBusy { get; set; }
    private string StatusMessage { get; set; } = string.Empty;
    private string ErrorMessage { get; set; } = string.Empty;
    private bool ShowTrashConfirm { get; set; }
    private List<GwsBusinessSuite.Application.TimeTracking.TimeEntryView> TimeEntries { get; set; } = new();

    private async Task BillTimeAsync()
    {
        if (IsBusy) return;
        IsBusy = true;
        ErrorMessage = string.Empty;
        StatusMessage = string.Empty;
        try
        {
            var invoice = await TimeTrackingService.BillUnbilledAsync(ContactId, await CurrentUserAccessor.GetCurrentUsernameAsync());
            StatusMessage = $"Draft invoice \"{invoice.Title}\" created ({invoice.TotalUsd:C2}) - review and send it from Billing.";
            Invoices = (await BillingService.ListInvoicesForContactAsync(ContactId)).ToList();
            TimeEntries = (await TimeTrackingService.ListForContactAsync(ContactId)).ToList();
        }
        catch (InvalidOperationException ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }

    private const int HistoryPageSize = 50;
    private List<ContactTimelineEntry> History { get; set; } = new();
    private string? HistoryFilter { get; set; }
    private int HistoryShown { get; set; } = HistoryPageSize;
    private List<ContactTimelineEntry> FilteredHistory =>
        HistoryFilter is null ? History : History.Where(e => e.Kind == HistoryFilter).ToList();

    private void SetHistoryFilter(string? kind)
    {
        HistoryFilter = kind;
        HistoryShown = HistoryPageSize;
    }

    private static string HistoryIcon(string kind) => kind switch
    {
        ContactTimelineKinds.Deal => "bi-briefcase",
        ContactTimelineKinds.Invoice => "bi-receipt",
        ContactTimelineKinds.Ticket => "bi-life-preserver",
        ContactTimelineKinds.Booking => "bi-calendar-event",
        ContactTimelineKinds.Form => "bi-clipboard-data",
        ContactTimelineKinds.Email => "bi-envelope",
        ContactTimelineKinds.Portal => "bi-box-arrow-in-right",
        _ => "bi-journal-text"
    };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        IsLoading = true;
        try
        {
            Contact = await CrmService.GetContactAsync(ContactId);
            if (Contact is null) return;

            Editor = new ContactEditorModel
            {
                ContactId = Contact.Id,
                FullName = Contact.FullName,
                Email = Contact.Email,
                Company = Contact.Company,
                Status = Contact.Status,
                FollowUpDate = Contact.FollowUpDate
            };

            Activities = (await CrmService.ListActivitiesAsync(ContactId)).ToList();
            Deals = (await CrmService.ListDealsForContactAsync(ContactId)).ToList();
            Tickets = (await SupportTicketService.ListTicketsForContactAsync(ContactId)).ToList();
            Invoices = (await BillingService.ListInvoicesForContactAsync(ContactId)).ToList();
            Bookings = (await BookingService.ListBookingsForContactAsync(ContactId)).ToList();
            Enrollments = (await EmailCampaignService.ListEnrollmentsForContactAsync(ContactId)).ToList();
            FormSubmissions = (await FormSubmissionService.ListForContactAsync(ContactId)).ToList();
            History = (await ContactTimelineService.GetTimelineAsync(ContactId)).ToList();
            TimeEntries = (await TimeTrackingService.ListForContactAsync(ContactId)).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to load CRM contact {ContactId}.", ContactId);
            ErrorMessage = "Unable to load this contact.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (IsBusy) return;
        IsBusy = true;
        ErrorMessage = string.Empty;
        StatusMessage = string.Empty;
        try
        {
            Contact = await CrmService.SaveContactAsync(Editor);
            StatusMessage = "Saved.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to save CRM contact {ContactId}.", ContactId);
            ErrorMessage = $"Unable to save contact. {ex.Message}";
        }
        finally
        {
            IsBusy = false;
        }
    }

    private void TrashAsync()
    {
        if (IsBusy) return;
        ShowTrashConfirm = true;
    }

    private async Task ConfirmTrashAsync()
    {
        ShowTrashConfirm = false;
        IsBusy = true;
        try
        {
            await CrmService.TrashContactAsync(ContactId);
            Navigation.NavigateTo("/admin/crm");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to trash CRM contact {ContactId}.", ContactId);
            ErrorMessage = $"Unable to move contact to Trash. {ex.Message}";
            IsBusy = false;
        }
    }

    private void CancelTrash() => ShowTrashConfirm = false;

    private async Task AddActivityAsync()
    {
        if (IsBusy || string.IsNullOrWhiteSpace(NewActivityNote)) return;
        IsBusy = true;
        ErrorMessage = string.Empty;
        try
        {
            var activity = await CrmService.AddActivityAsync(ContactId, NewActivityNote);
            Activities.Insert(0, activity);
            NewActivityNote = string.Empty;
            History = (await ContactTimelineService.GetTimelineAsync(ContactId)).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to log CRM activity for contact {ContactId}.", ContactId);
            ErrorMessage = $"Unable to log activity. {ex.Message}";
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task OnActivityNoteKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AddActivityAsync();
        }
    }
}
