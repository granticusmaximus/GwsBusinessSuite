@using GwsBusinessSuite.Application.Abstractions
@using GwsBusinessSuite.Application.Wiki
@inject ISentinelPageLockService PageLocks
@inject ISentinelLockRecoveryService Recovery
@inject ICurrentUserAccessor CurrentUserAccessor

@* Page lock settings: the PIN, and (later phases) Touch ID passkeys and Mac app keys. *@
<div class="sentinel-ask sentinel-lock-settings" role="dialog" aria-label="Page lock settings">
    <div class="sentinel-ask-header">
        <strong><i class="bi bi-lock me-1" aria-hidden="true"></i>Page lock</strong>
        @if (ShowClose)
        {
            <button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="() => OnClose.InvokeAsync()"></button>
        }
    </div>
    <p class="small text-secondary mb-2">
        Lock a page from its ⋯ menu. A locked page is stored encrypted, and only you can open it - with Touch ID or your PIN.
        One unlock opens all your locked pages for 15 minutes.
    </p>

    @* Adding or changing a way to unlock needs an unlock first. The authenticator code is the way
       back when the PIN is forgotten or the only Touch ID key is gone (31-10-26). *@
    @if (_methods.Any && !_unlocked)
    {
        <div class="sentinel-lock-confirm mb-3">
            <div class="fw-semibold small mb-1"><i class="bi bi-shield-lock me-1" aria-hidden="true"></i>Confirm it's you</div>
            <p class="small text-secondary mb-1">
                To add or remove Touch ID or change your PIN, unlock first. No PIN, or the Mac you set Touch ID up on is gone?
                Enter the 6-digit code from the authenticator app you sign in with.
            </p>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <input type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="20" class="form-control form-control-sm"
                       style="max-width: 12rem" placeholder="Authenticator code" aria-label="Authenticator code"
                       @bind="_code" @bind:event="oninput" />
                <button type="button" class="btn btn-sm btn-primary" disabled="@(_busy || _code.Trim().Length < 6)" @onclick="ConfirmWithCodeAsync">Confirm</button>
            </div>
            @if (_methods.HasPin)
            {
                <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                    <input type="password" inputmode="numeric" autocomplete="off" maxlength="8" class="form-control form-control-sm"
                           style="max-width: 12rem" placeholder="Or your PIN" aria-label="PIN" @bind="_unlockPin" @bind:event="oninput" />
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(_busy || _unlockPin.Length < 6)" @onclick="ConfirmWithPinAsync">Unlock</button>
                </div>
            }
        </div>
    }

    <div class="fw-semibold small mb-1">PIN @(_methods.HasPin ? "(set)" : "(not set)")</div>
    <div class="sentinel-lock-pin-form mb-2">
        @if (_methods.HasPin)
        {
            <input type="password" inputmode="numeric" autocomplete="off" maxlength="8" class="form-control form-control-sm"
                   placeholder="Current PIN" aria-label="Current PIN" @bind="_currentPin" @bind:event="oninput" />
        }
        <input type="password" inputmode="numeric" autocomplete="off" maxlength="8" class="form-control form-control-sm"
               placeholder="New PIN (6-8 digits)" aria-label="New PIN" @bind="_newPin" @bind:event="oninput" />
        <input type="password" inputmode="numeric" autocomplete="off" maxlength="8" class="form-control form-control-sm"
               placeholder="New PIN again" aria-label="Repeat new PIN" @bind="_repeatPin" @bind:event="oninput" />
        <button type="button" class="btn btn-sm btn-primary" disabled="@(_busy || _newPin.Length < 6)" @onclick="SavePinAsync">@(_methods.HasPin ? "Change PIN" : "Set PIN")</button>
    </div>

    @if (TouchIdSettings is not null)
    {
        @TouchIdSettings
    }

    <button type="button" class="btn btn-sm btn-outline-secondary mt-2" @onclick="LockAllAsync">
        <i class="bi bi-lock-fill me-1" aria-hidden="true"></i>Lock all now
    </button>
    @if (_message is not null)
    {
        <div class="alert @(_isError ? "alert-danger" : "alert-success") small py-2 mt-2 mb-0" role="status">@_message</div>
    }
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnLockedAll { get; set; }
    // Touch ID sections (passkeys, Mac app), supplied by the page.
    [Parameter] public RenderFragment? TouchIdSettings { get; set; }
    [Parameter] public int Generation { get; set; }
    [Parameter] public string? SessionId { get; set; }
    [Parameter] public bool ShowClose { get; set; } = true;

    private SentinelUnlockMethodsView _methods = new(false, 0, 0);
    private bool _unlocked;
    private string _code = string.Empty;
    private string _unlockPin = string.Empty;
    private string _currentPin = string.Empty;
    private string _newPin = string.Empty;
    private string _repeatPin = string.Empty;
    private string? _message;
    private bool _isError;
    private bool _busy;

    protected override async Task OnParametersSetAsync()
    {
        var username = await CurrentUserAccessor.GetCurrentUsernameAsync();
        _methods = await PageLocks.GetMethodsAsync(username);
        _unlocked = await PageLocks.IsUnlockedAsync(username, SessionId);
    }

    private Task ConfirmWithCodeAsync() =>
        ConfirmAsync(username => Recovery.UnlockWithAuthenticatorAsync(username, SessionId, _code.Trim()));

    private Task ConfirmWithPinAsync() =>
        ConfirmAsync(username => PageLocks.UnlockWithPinAsync(username, SessionId, _unlockPin, null));

    private async Task ConfirmAsync(Func<string, Task<long>> unlock)
    {
        _message = null;
        _busy = true;
        try
        {
            await unlock(await CurrentUserAccessor.GetCurrentUsernameAsync());
            _unlocked = true;
            (_message, _isError) = ("Unlocked for 15 minutes - you can add Touch ID or set your PIN now.", false);
        }
        catch (SentinelLockException ex)
        {
            (_message, _isError) = (ex.Message, true);
        }
        finally
        {
            _code = _unlockPin = string.Empty;
            _busy = false;
        }
    }

    private async Task SavePinAsync()
    {
        _message = null;
        if (_newPin != _repeatPin)
        {
            (_message, _isError) = ("The two new PINs don't match.", true);
            return;
        }
        _busy = true;
        try
        {
            await PageLocks.SetPinAsync(await CurrentUserAccessor.GetCurrentUsernameAsync(), SessionId, _methods.HasPin ? _currentPin : null, _newPin);
            (_message, _isError) = (_methods.HasPin ? "PIN changed." : "PIN set - you can lock pages now.", false);
            _currentPin = _newPin = _repeatPin = string.Empty;
            _methods = await PageLocks.GetMethodsAsync(await CurrentUserAccessor.GetCurrentUsernameAsync());
        }
        catch (SentinelLockException ex)
        {
            (_message, _isError) = (ex.Message, true);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LockAllAsync()
    {
        await PageLocks.LockAllNowAsync(await CurrentUserAccessor.GetCurrentUsernameAsync());
        (_message, _isError) = ("All your locked pages are locked again.", false);
        await OnLockedAll.InvokeAsync();
    }
}
