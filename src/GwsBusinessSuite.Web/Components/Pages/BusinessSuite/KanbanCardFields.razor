@using System.Globalization
@using System.Text.Json.Nodes
@using GwsBusinessSuite.Application.Boards
@using GwsBusinessSuite.Application.Wiki
@using GwsBusinessSuite.Domain.Entities
@inject IKanbanBoardService BoardService
@inject IWikiDatabaseService Databases
@inject ICurrentUserAccessor CurrentUserAccessor
@inject GwsBusinessSuite.Web.Services.ToastState Toasts
@inject IJSRuntime JS
@inject GwsBusinessSuite.Application.TimeTracking.ITimeTrackingService Time
@implements IAsyncDisposable

@* A card's fields in the board's drawer (Boards K2): everything the card shows, editable, above its
   Sentinel page. Each change saves at once; a refusal re-draws the control (@key) and says why. *@
<section class="kb-fields" aria-label="Card fields">
    <label class="visually-hidden" for="kb-card-title">Title</label>
    <input id="kb-card-title" class="kb-fields-title" value="@Title" @key="@($"title-{_revision}")" maxlength="300"
           @onchange="e => SetAsync(TitleProperty!.Id, Text(e.Value))" />

    <dl class="kb-fields-grid">
        <dt><i class="bi bi-circle-half" aria-hidden="true"></i>Status</dt>
        <dd>
            <select class="form-select form-select-sm" aria-label="Status" value="@Text(Board.Fields.StatusPropertyId)" @key="@($"status-{_revision}")"
                    @onchange="e => OnStatusChanged.InvokeAsync(e.Value as string ?? string.Empty)">
                @foreach (var column in Board.Columns) { <option value="@(column.OptionId ?? "")">@column.Label</option> }
            </select>
        </dd>

        @if (Property(Board.Fields.PriorityPropertyId) is { } priority)
        {
            <dt><i class="bi bi-reception-4" aria-hidden="true"></i>Priority</dt>
            <dd>
                <select class="form-select form-select-sm" aria-label="Priority" value="@(Text(priority.Id) ?? "")" @key="@($"priority-{_revision}")"
                        @onchange="e => SetAsync(priority.Id, Text(e.Value))">
                    <option value="">None</option>
                    @foreach (var option in Options(priority)) { <option value="@option.Id">@option.Label</option> }
                </select>
            </dd>
        }

        @if (Property(Board.Fields.LabelsPropertyId) is { } labels)
        {
            var chosen = Multi(labels.Id);
            <dt><i class="bi bi-tags" aria-hidden="true"></i>@labels.Name</dt>
            <dd class="kb-fields-labels">
                @foreach (var option in Options(labels))
                {
                    var on = chosen.Contains(option.Id);
                    <button type="button" class="kb-label-toggle @(on ? "is-on" : "")" aria-pressed="@(on ? "true" : "false")" style="--tone: @Color(option.Color)"
                            @onclick="() => ToggleLabelAsync(labels.Id, option.Id)">@option.Label</button>
                }
            </dd>
        }

        @if (Property(Board.Fields.DuePropertyId) is { } due)
        {
            <dt><i class="bi bi-calendar-event" aria-hidden="true"></i>@due.Name</dt>
            <dd>
                <input type="date" class="form-control form-control-sm" aria-label="@due.Name" @key="@($"due-{_revision}")"
                       value="@(Date(due.Id)?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" @onchange="e => SetDateAsync(due.Id, e.Value as string)" />
            </dd>
        }

        @if (Property(Board.Fields.AssigneePropertyId) is { } assignee)
        {
            <dt><i class="bi bi-person" aria-hidden="true"></i>@assignee.Name</dt>
            <dd class="kb-fields-inline">
                <input class="form-control form-control-sm" aria-label="@assignee.Name" placeholder="Usernames, comma-separated" @key="@($"assignee-{_revision}")"
                       value="@string.Join(", ", Multi(assignee.Id))" @onchange="e => SetPeopleAsync(assignee.Id, e.Value as string)" />
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => AssignMeAsync(assignee.Id)">Me</button>
            </dd>
        }

        @if (Property(Board.Fields.EstimatePropertyId) is { } estimate)
        {
            <dt><i class="bi bi-speedometer2" aria-hidden="true"></i>@estimate.Name</dt>
            <dd>
                <input type="number" min="0" step="0.5" class="form-control form-control-sm kb-fields-number" aria-label="@estimate.Name" @key="@($"estimate-{_revision}")"
                       value="@(Number(estimate.Id)?.ToString("0.##", CultureInfo.InvariantCulture))" @onchange="e => SetNumberAsync(estimate.Id, e.Value as string)" />
            </dd>
        }

        <dt><i class="bi bi-slash-circle" aria-hidden="true"></i>Blocked</dt>
        <dd class="kb-fields-inline">
            <input type="checkbox" class="form-check-input kb-fields-blocked" aria-label="Blocked" checked="@IsBlocked" @key="@($"blocked-{_revision}")"
                   @onchange="e => SetBlockedAsync(e.Value is true, BlockedReason)" />
            @if (IsBlocked)
            {
                <input class="form-control form-control-sm" aria-label="What it's waiting on" placeholder="What's it waiting on?" maxlength="300" @key="@($"reason-{_revision}")"
                       value="@BlockedReason" @onchange="e => SetBlockedAsync(true, e.Value as string)" />
            }
        </dd>

        <dt><i class="bi bi-signpost-split" aria-hidden="true"></i>Waiting on</dt>
        <dd>
            <select class="form-select form-select-sm" aria-label="Waiting on" multiple size="@Math.Min(5, Math.Max(2, DependencyChoices.Count()))"
                    @onchange="SetWaitingOnAsync">
                @foreach (var card in DependencyChoices)
                {
                    <option value="@card.RowId" selected="@WaitingOn.Contains(card.RowId)">@(card.Key is null ? card.Title : $"{card.Key} · {card.Title}")</option>
                }
            </select>
            @if (CurrentCard?.WaitingOnOpen is > 0)
            {
                <small class="text-body-secondary">@CurrentCard.WaitingOnOpen open</small>
            }
        </dd>

        @foreach (var other in OtherSelects)
        {
            <dt><i class="bi bi-list-ul" aria-hidden="true"></i>@other.Name</dt>
            <dd>
                <select class="form-select form-select-sm" aria-label="@other.Name" value="@(Text(other.Id) ?? "")" @key="@($"{other.Id}-{_revision}")"
                        @onchange="e => SetAsync(other.Id, Text(e.Value))">
                    <option value="">None</option>
                    @foreach (var option in Options(other)) { <option value="@option.Id">@option.Label</option> }
                </select>
            </dd>
        }
    </dl>

    <div class="kb-fields-subitems">
        <h3><i class="bi bi-diagram-3" aria-hidden="true"></i>Sub-items
            @if (_subItems.Count > 0) { <span>@_subItems.Count(item => item.Done)/@_subItems.Count</span> }
            <button type="button" class="kb-break" disabled="@_breaking" title="Suggest the steps that finish this card, with the AI on this computer" @onclick="BreakDownAsync">
                <i class="bi bi-stars" aria-hidden="true"></i>Break it down
            </button>
        </h3>
        @* K8b: steps suggested by the local model, added only once chosen. *@
        @if (_breakNote is not null) { <p class="kb-break-note" aria-live="polite">@_breakNote</p> }
        @if (_proposed is { Count: > 0 } proposed)
        {
            <ul class="kb-break-list">
                @foreach (var step in proposed)
                {
                    <li><label><input type="checkbox" class="form-check-input" checked="@_keep.Contains(step)" @onchange="e => KeepStep(step, e.Value is true)" /> @step</label></li>
                }
            </ul>
            <div class="kb-break-actions">
                <button type="button" class="btn btn-sm btn-primary" disabled="@(_keep.Count == 0)" @onclick="AddProposedAsync">Add @_keep.Count @(_keep.Count == 1 ? "sub-item" : "sub-items")</button>
                <button type="button" class="btn btn-sm btn-link" @onclick="DiscardProposed">Discard</button>
            </div>
        }
        @if (_subItems.Count > 0)
        {
            <ul>
                @foreach (var item in _subItems)
                {
                    <li class="@(item.Done ? "is-done" : "")">
                        <input type="checkbox" class="form-check-input" checked="@item.Done" aria-label="@item.Title done" @key="@($"{item.RowId}-{_revision}")"
                               @onchange="e => SetSubItemDoneAsync(item, e.Value is true)" />
                        <button type="button" class="btn btn-link p-0 text-start" @onclick="() => OnOpenSubItem.InvokeAsync(item.RowId)">@item.Title</button>
                    </li>
                }
            </ul>
        }
        <form class="kb-fields-subitem-add" @onsubmit="AddSubItemAsync" @onsubmit:preventDefault>
            <label class="visually-hidden" for="kb-subitem-new">New sub-item</label>
            <input id="kb-subitem-new" class="form-control form-control-sm" placeholder="Add a sub-item, then Enter" maxlength="300"
                   @bind="_newSubItem" @bind:event="oninput" />
        </form>
    </div>

    @* Admins only (K9g): someone a board is shared with never sees its CRM links, timers or billing. *@
    @if (ShowBusiness)
    {
        @* Business links (K8c): the contacts, tickets and invoices this card is about. Hovering one
           previews it; time on the card bills the linked contact. *@
        <div class="kb-fields-links">
            <h3><i class="bi bi-link-45deg" aria-hidden="true"></i>Linked</h3>
            @if (_links.Count > 0)
            {
                <ul>
                    @foreach (var link in _links)
                    {
                        <li class="@(link.Gone ? "is-gone" : "")" @key="link.Id">
                            <a href="@LinkUrl(link)" data-preview="@(link.Gone ? null : $"{link.Kind}:{link.TargetId}")">
                                <i class="bi @(GwsBusinessSuite.Web.Components.Pages.BusinessSuite.Board.LinkIcon(link.Kind))" aria-hidden="true"></i>
                                <span class="kb-link-title">@link.Title</span>
                                @if (link.Status is not null) { <span class="kb-link-status">@link.Status</span> }
                            </a>
                            <button type="button" class="kb-link-remove" aria-label="Unlink @link.Title" @onclick="() => UnlinkAsync(link)"><i class="bi bi-x" aria-hidden="true"></i></button>
                        </li>
                    }
                </ul>
            }
            <div class="kb-link-add">
                <label class="visually-hidden" for="kb-link-kind">Link a</label>
                <select id="kb-link-kind" class="form-select form-select-sm" value="@_linkKind" @onchange="SetLinkKindAsync">
                    <option value="@KanbanLinkKinds.Contact">Contact</option>
                    <option value="@KanbanLinkKinds.Ticket">Ticket</option>
                    <option value="@KanbanLinkKinds.Invoice">Invoice</option>
                </select>
                <label class="visually-hidden" for="kb-link-search">Find one to link</label>
                <input id="kb-link-search" class="form-control form-control-sm" placeholder="@($"Find {(_linkKind == KanbanLinkKinds.Invoice ? "an" : "a")} {_linkKind} to link…")" autocomplete="off" maxlength="100"
                       @bind="_linkQuery" @bind:event="oninput" @bind:after="SearchLinksAsync" />
            </div>
            @if (_candidates.Count > 0)
            {
                <ul class="kb-link-results" aria-label="Matches">
                    @foreach (var candidate in _candidates)
                    {
                        <li @key="candidate.Id">
                            <button type="button" @onclick="() => LinkAsync(candidate)">
                                <span>@candidate.Title</span>
                                @if (!string.IsNullOrWhiteSpace(candidate.Detail)) { <span class="kb-link-status">@candidate.Detail</span> }
                            </button>
                        </li>
                    }
                </ul>
            }
            else if (_linkQuery.Trim().Length >= 2 && !_searching)
            {
                <p class="kb-break-note">No @(_linkKind)s match.</p>
            }
        </div>

        @* Time on the card (K8c): a timer that bills the linked contact, through Time Tracking. *@
        <div class="kb-fields-time">
            <h3><i class="bi bi-stopwatch" aria-hidden="true"></i>Time
                @if (_entries.Count > 0) { <span>@Hours(_entries.Sum(entry => entry.Minutes))</span> }
            </h3>
            @if (BillTo is not { } billTo)
            {
                <p class="kb-break-note">Link a contact, ticket or invoice to track billable time here.</p>
            }
            else if (_running is { } running && running.BoardCardId == Row.Id)
            {
                <div class="kb-time-row">
                    <button type="button" class="btn btn-sm btn-danger" disabled="@_timing" @onclick="StopTimerAsync"><i class="bi bi-stop-fill me-1" aria-hidden="true"></i>Stop</button>
                    <span class="kb-time-running"><span class="kb-time-dot" aria-hidden="true"></span>Running since @running.StartedAt.ToLocalTime().ToGwsTime() for @running.ContactName</span>
                </div>
            }
            else
            {
                <div class="kb-time-row">
                    <button type="button" class="btn btn-sm btn-outline-primary" disabled="@_timing" @onclick="StartTimerAsync"><i class="bi bi-play-fill me-1" aria-hidden="true"></i>Start timer</button>
                    <span class="kb-break-note">Bills @billTo.Name@(_rate > 0 ? $" at ${_rate.ToString("0.##", CultureInfo.InvariantCulture)}/h" : "")@(_running is not null ? " · stops the timer you have running" : "")</span>
                </div>
            }
            @if (_entries.Count > 0)
            {
                <ul class="kb-time-entries">
                    @foreach (var entry in _entries.Take(4))
                    {
                        <li @key="entry.Id"><span>@entry.StartedAt.ToLocalTime().ToGwsDate()</span><span>@entry.Username</span><span>@Hours(entry.Minutes)</span>
                            <span class="kb-link-status">@(entry.InvoiceId is not null ? "billed" : entry.IsRunning ? "running" : entry.Billable ? "to bill" : "not billable")</span></li>
                    }
                </ul>
            }
        </div>
    }

    @* Card templates (K6): this card's fields and page, to make again from a column's menu or on a
       schedule (Automate). *@
    <div class="kb-fields-actions">
        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_savingTemplate" @onclick="SaveAsTemplateAsync">
            <i class="bi bi-files me-1" aria-hidden="true"></i>Save as template
        </button>
    </div>

    <p class="kb-fields-meta">
        Created @Row.CreatedAt.ToLocalGwsDateTime()@(string.IsNullOrWhiteSpace(Row.CreatedBy) ? "" : $" by {Row.CreatedBy}")
        @if (Row.UpdatedAt is { } updated) { <span> · Updated @updated.ToLocalGwsDateTime()</span> }
    </p>
</section>

@code {
    [Parameter, EditorRequired] public required KanbanBoard Board { get; set; }
    [Parameter, EditorRequired] public required WikiDatabase Database { get; set; }
    [Parameter, EditorRequired] public required WikiDatabaseRow Row { get; set; }
    // Something changed: the board reloads and hands this a fresh Row.
    [Parameter] public EventCallback OnChanged { get; set; }
    // Status goes through the board, which moves the card to the top of the new column.
    [Parameter] public EventCallback<string> OnStatusChanged { get; set; }
    [Parameter] public EventCallback<Guid> OnOpenSubItem { get; set; }
    // The contacts, tickets, invoices and timers (K9g: admins only).
    [Parameter] public bool ShowBusiness { get; set; } = true;

    private int _revision;
    private IReadOnlyList<KanbanSubItem> _subItems = [];
    private string _newSubItem = string.Empty;
    private Guid? _loadedFor;

    private JsonObject Values => WikiPropertyValues.ParseObject(Row.PropertyValuesJson);
    private WikiDatabaseProperty? TitleProperty => Database.Properties.FirstOrDefault(property => property.Type == WikiDatabasePropertyTypes.Title);
    private string Title => TitleProperty is null ? string.Empty : WikiPropertyValues.GetText(Values, TitleProperty.Id) ?? string.Empty;

    // Select properties the board doesn't already use (a Sprint, say).
    private IEnumerable<WikiDatabaseProperty> OtherSelects => Database.Properties
        .Where(property => property.Type == WikiDatabasePropertyTypes.Select
            && property.Id != Board.Fields.StatusPropertyId && property.Id != Board.Fields.PriorityPropertyId)
        .OrderBy(property => property.SortOrder);

    private bool _savingTemplate;

    private async Task SaveAsTemplateAsync()
    {
        _savingTemplate = true;
        try
        {
            var name = string.IsNullOrWhiteSpace(Title) ? "Untitled card" : Title.Trim();
            var me = await CurrentUserAccessor.GetCurrentUsernameAsync();
            var template = await Databases.CreateRowTemplateFromRowAsync(Database.Id, Row.Id, name.Length > 120 ? name[..120] : name, me);
            await OnChanged.InvokeAsync();
            Toasts.Show($"Saved \u201c{template.Name}\u201d as a template. Make cards from it in a column's menu, or set it to repeat under Automate.", tone: StatusTone.Success);
        }
        catch (Exception ex) when (ex is InvalidOperationException or KeyNotFoundException or ArgumentException)
        {
            Toasts.Show($"Couldn't save the template. {ex.Message}", tone: StatusTone.Danger);
        }
        finally
        {
            _savingTemplate = false;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == Row.Id) return;
        _loadedFor = Row.Id;
        _newSubItem = string.Empty;
        _linkQuery = string.Empty;
        _candidates = [];
        await LoadSubItemsAsync();
        await LoadLinksAndTimeAsync();
    }

    // ---- Business links and time (K8c) ----
    private IReadOnlyList<KanbanCardLink> _links = [];
    private IReadOnlyList<KanbanLinkCandidate> _candidates = [];
    private string _linkKind = KanbanLinkKinds.Contact;
    private string _linkQuery = string.Empty;
    private bool _searching;
    private IReadOnlyList<GwsBusinessSuite.Application.TimeTracking.TimeEntryView> _entries = [];
    private GwsBusinessSuite.Application.TimeTracking.TimeEntryView? _running;
    private decimal _rate;
    private bool _timing;

    private sealed record BillTarget(Guid ContactId, string Name, Guid? TicketId);

    // Who time on this card bills: a linked contact first, else a linked ticket's or invoice's.
    private BillTarget? BillTo => _links.Where(link => !link.Gone && link.ContactId is not null)
        .OrderBy(link => link.Kind == KanbanLinkKinds.Contact ? 0 : 1)
        .Select(link => new BillTarget(link.ContactId!.Value, link.Kind == KanbanLinkKinds.Contact ? link.Title : link.Detail ?? link.Title,
            _links.FirstOrDefault(item => item.Kind == KanbanLinkKinds.Ticket && !item.Gone && item.ContactId == link.ContactId)?.TargetId))
        .FirstOrDefault();

    private async Task LoadLinksAndTimeAsync()
    {
        if (!ShowBusiness) return;
        var me = await CurrentUserAccessor.GetCurrentUsernameAsync();
        _links = await BoardService.ListLinksAsync(Database.Id, Row.Id);
        _entries = await Time.ListForCardAsync(Row.Id);
        _running = await Time.GetRunningAsync(me);
        _rate = await Time.GetLastRateAsync(me);
    }

    private static string LinkUrl(KanbanCardLink link) => link.Kind switch
    {
        KanbanLinkKinds.Contact => $"/admin/crm/contacts/{link.TargetId}",
        KanbanLinkKinds.Ticket => $"/admin/support?ticket={link.TargetId}",
        _ => $"/admin/billing?invoice={link.TargetId}"
    };

    private static string Hours(int minutes) => minutes < 60 ? $"{minutes} min" : $"{(minutes / 60m).ToString("0.#", CultureInfo.InvariantCulture)} h";

    private async Task SetLinkKindAsync(ChangeEventArgs e)
    {
        _linkKind = e.Value as string ?? KanbanLinkKinds.Contact;
        await SearchLinksAsync();
    }

    private async Task SearchLinksAsync()
    {
        _searching = true;
        try { _candidates = await BoardService.SearchLinkTargetsAsync(_linkKind, _linkQuery); }
        finally { _searching = false; }
    }

    private async Task LinkAsync(KanbanLinkCandidate candidate)
    {
        try
        {
            await BoardService.LinkAsync(Database.Id, Row.Id, candidate.Kind, candidate.Id, await CurrentUserAccessor.GetCurrentUsernameAsync());
            _linkQuery = string.Empty;
            _candidates = [];
            await LoadLinksAndTimeAsync();
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            Toasts.Show($"Couldn't link it. {ex.Message}", tone: StatusTone.Danger);
        }
    }

    private async Task UnlinkAsync(KanbanCardLink link)
    {
        await BoardService.UnlinkAsync(Database.Id, link.Id);
        await LoadLinksAndTimeAsync();
        await OnChanged.InvokeAsync();
        Toasts.Show($"Unlinked {link.Title}.", async () =>
        {
            await BoardService.LinkAsync(Database.Id, Row.Id, link.Kind, link.TargetId, await CurrentUserAccessor.GetCurrentUsernameAsync());
            await LoadLinksAndTimeAsync();
            await OnChanged.InvokeAsync();
            StateHasChanged();
        });
    }

    private async Task StartTimerAsync()
    {
        if (BillTo is not { } billTo) return;
        _timing = true;
        try
        {
            await Time.StartAsync(await CurrentUserAccessor.GetCurrentUsernameAsync(), new GwsBusinessSuite.Application.TimeTracking.TimeEntryInput
            {
                ContactId = billTo.ContactId,
                TicketId = billTo.TicketId,
                BoardCardId = Row.Id,
                Description = Title,
                Billable = true,
                HourlyRateUsd = _rate
            });
            await LoadLinksAndTimeAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            Toasts.Show($"Couldn't start the timer. {ex.Message}", tone: StatusTone.Danger);
        }
        finally
        {
            _timing = false;
        }
    }

    private async Task StopTimerAsync()
    {
        _timing = true;
        try
        {
            var stopped = await Time.StopAsync(await CurrentUserAccessor.GetCurrentUsernameAsync());
            await LoadLinksAndTimeAsync();
            if (stopped is not null) Toasts.Show($"{Hours(stopped.Minutes)} logged for {stopped.ContactName}. It's on Billing's unbilled time.", tone: StatusTone.Success);
        }
        finally
        {
            _timing = false;
        }
    }

    private async Task LoadSubItemsAsync() => _subItems = await BoardService.ListSubItemsAsync(Database.Id, Row.Id);

    private WikiDatabaseProperty? Property(Guid? id) => id is { } value ? Database.Properties.FirstOrDefault(property => property.Id == value) : null;
    private static IReadOnlyList<WikiDatabasePropertyOption> Options(WikiDatabaseProperty property) => WikiDatabasePropertyConfig.GetOptions(property);
    private string? Text(Guid propertyId) => WikiPropertyValues.GetText(Values, propertyId);
    private static string? Text(object? value) => value is string text && text.Trim().Length > 0 ? text.Trim() : null;
    private IReadOnlyList<string> Multi(Guid propertyId) => WikiPropertyValues.GetMultiSelect(Values, propertyId);
    private decimal? Number(Guid propertyId) => WikiPropertyValues.GetNumber(Values, propertyId);
    // A date as written (Sentinel stores a picked date at UTC midnight), not shifted to local time.
    private DateOnly? Date(Guid propertyId) => WikiPropertyValues.GetDate(Values, propertyId) is { } date ? DateOnly.FromDateTime(date.Date) : null;
    private static string Color(string? color) => color is not null && System.Text.RegularExpressions.Regex.IsMatch(color, "^(#[0-9a-fA-F]{3,8}|[a-zA-Z]{3,20})$") ? color : "#78716c";

    private bool IsBlocked => Board.Fields.BlockedPropertyId is { } id && WikiPropertyValues.GetCheckbox(Values, id);
    private string? BlockedReason => Board.Fields.BlockedReasonPropertyId is { } id ? WikiPropertyValues.GetText(Values, id) : null;
    private KanbanCard? CurrentCard => Board.Columns.SelectMany(column => column.Cards).FirstOrDefault(card => card.RowId == Row.Id);
    private IReadOnlyList<Guid> WaitingOn => CurrentCard?.WaitingOn ?? [];
    private IEnumerable<KanbanCard> DependencyChoices => Board.Columns.SelectMany(column => column.Cards)
        .Where(card => card.RowId != Row.Id).OrderBy(card => card.Key ?? card.Title);

    private async Task SetWaitingOnAsync(ChangeEventArgs e)
    {
        // Blazor supplies the selected values for a multiple select as string[].
        var ids = e.Value is string[] selected
            ? selected.Select(value => Guid.TryParse(value, out var id) ? id : (Guid?)null).Where(id => id is not null).Select(id => id!.Value).ToList()
            : [];
        try
        {
            await BoardService.SetWaitingOnAsync(Database.Id, Row.Id, ids, await CurrentUserAccessor.GetCurrentUsernameAsync());
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            _revision++;
            Toasts.Show($"Couldn't change dependencies. {ex.Message}", tone: StatusTone.Danger);
        }
    }

    // Through the board service, which adds Blocked / Blocked reason to a board that lacks them.
    private async Task SetBlockedAsync(bool blocked, string? reason)
    {
        try
        {
            await BoardService.SetBlockedAsync(Database.Id, Row.Id, blocked, reason, await CurrentUserAccessor.GetCurrentUsernameAsync());
            await OnChanged.InvokeAsync();
        }
        catch (InvalidOperationException ex)
        {
            _revision++;
            Toasts.Show($"Couldn't change that. {ex.Message}", tone: StatusTone.Danger);
        }
    }

    private Task SetAsync(Guid propertyId, string? text) => ChangeAsync(propertyId, _ => text is null ? null : JsonValue.Create(text));

    private Task ToggleLabelAsync(Guid propertyId, string optionId) => ChangeAsync(propertyId, current =>
    {
        var ids = current is JsonArray array ? array.Select(node => node?.GetValue<string>()).OfType<string>().ToList() : [];
        if (!ids.Remove(optionId)) ids.Add(optionId);
        return new JsonArray(ids.Select(id => (JsonNode?)JsonValue.Create(id)).ToArray());
    });

    private Task SetDateAsync(Guid propertyId, string? value)
    {
        JsonNode? node = null;
        if (DateTimeOffset.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.AssumeUniversal, out var date))
        {
            // Through WikiPropertyValues, so the stored format is Sentinel's own.
            var holder = new JsonObject();
            WikiPropertyValues.SetDate(holder, propertyId, date);
            node = holder[propertyId.ToString()]?.DeepClone();
        }
        return ChangeAsync(propertyId, _ => node);
    }

    private Task SetNumberAsync(Guid propertyId, string? value) =>
        ChangeAsync(propertyId, _ => decimal.TryParse(value, NumberStyles.Number, CultureInfo.InvariantCulture, out var number) ? JsonValue.Create(number) : null);

    private Task SetPeopleAsync(Guid propertyId, string? value) => ChangeAsync(propertyId, _ =>
    {
        var people = (value ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        return people.Count == 0 ? null : new JsonArray(people.Select(person => (JsonNode?)JsonValue.Create(person)).ToArray());
    });

    private async Task AssignMeAsync(Guid propertyId)
    {
        var me = await CurrentUserAccessor.GetCurrentUsernameAsync();
        await ChangeAsync(propertyId, current =>
        {
            var people = current is JsonArray array ? array.Select(node => node?.GetValue<string>()).OfType<string>().ToList() : [];
            if (!people.Contains(me, StringComparer.OrdinalIgnoreCase)) people.Add(me);
            return new JsonArray(people.Select(person => (JsonNode?)JsonValue.Create(person)).ToArray());
        });
    }

    private async Task ChangeAsync(Guid propertyId, Func<JsonNode?, JsonNode?> change)
    {
        try
        {
            var performedBy = await CurrentUserAccessor.GetCurrentUsernameAsync();
            await BoardService.SetCardsValueAsync(Database.Id, [Row.Id], propertyId, change, performedBy);
            await OnChanged.InvokeAsync();
        }
        catch (InvalidOperationException ex)
        {
            _revision++;
            Toasts.Show($"Couldn't save that. {ex.Message}", tone: StatusTone.Danger);
        }
    }

    private async Task SetSubItemDoneAsync(KanbanSubItem item, bool done)
    {
        try
        {
            await BoardService.SetSubItemDoneAsync(Database.Id, item.RowId, done, await CurrentUserAccessor.GetCurrentUsernameAsync());
            await LoadSubItemsAsync();
            await OnChanged.InvokeAsync();
        }
        catch (InvalidOperationException ex)
        {
            _revision++;
            Toasts.Show($"Couldn't update that sub-item. {ex.Message}", tone: StatusTone.Danger);
        }
    }

    private GwsBusinessSuite.Web.Services.BrowserLocalOllamaService? _local;
    private bool _breaking;
    private string? _breakNote;
    private List<string>? _proposed;
    private readonly HashSet<string> _keep = new(StringComparer.OrdinalIgnoreCase);

    // The local model suggests the steps; nothing is added until they're chosen.
    private async Task BreakDownAsync()
    {
        _breaking = true;
        _proposed = null;
        _breakNote = "Looking for a model on this computer…";
        try
        {
            _local ??= new GwsBusinessSuite.Web.Services.BrowserLocalOllamaService(JS);
            var status = await _local.ProbeAsync();
            var model = LocalModels.PickChatModel(status.Models);
            if (!status.IsReachable || model is null)
            {
                _breakNote = $"There's no local model to ask ({status.Error ?? "no Ollama model is installed"}).";
                return;
            }
            _breakNote = $"{model} is thinking… the first answer can take a minute while it loads.";
            StateHasChanged();
            using var timeout = new CancellationTokenSource(TimeSpan.FromMinutes(3));
            var page = string.Join("\n", WikiBlockJson.ParseBlocks(Row.BlocksJson).Select(block => block.PlainText.Trim()).Where(text => text.Length > 0));
            var output = await _local.GenerateJsonAsync(model, KanbanAssistant.BreakdownSystem, KanbanAssistant.BreakdownPrompt(Title, page), timeout.Token);
            var steps = KanbanAssistant.ParseSteps(output)
                .Where(step => !_subItems.Any(item => string.Equals(item.Title, step, StringComparison.OrdinalIgnoreCase)))
                .ToList();
            _proposed = steps;
            _keep.Clear();
            _keep.UnionWith(steps);
            _breakNote = steps.Count == 0 ? $"{model} didn't suggest any new steps." : $"Suggested by {model}. Untick any you don't want.";
        }
        catch (OperationCanceledException)
        {
            _breakNote = "The local model took too long to answer.";
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException)
        {
            _breakNote = $"The local model couldn't answer ({ex.Message}).";
        }
        finally
        {
            _breaking = false;
        }
    }

    private void KeepStep(string step, bool keep)
    {
        if (keep) _keep.Add(step); else _keep.Remove(step);
    }

    private void DiscardProposed()
    {
        _proposed = null;
        _breakNote = null;
    }

    private async Task AddProposedAsync()
    {
        if (_proposed is null) return;
        var me = await CurrentUserAccessor.GetCurrentUsernameAsync();
        var added = 0;
        try
        {
            foreach (var step in _proposed.Where(_keep.Contains))
            {
                await BoardService.AddSubItemAsync(Database.Id, Row.Id, step, me);
                added++;
            }
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            Toasts.Show($"Couldn't add every step. {ex.Message}", tone: StatusTone.Danger);
        }
        DiscardProposed();
        await LoadSubItemsAsync();
        await OnChanged.InvokeAsync();
        if (added > 0) Toasts.Show($"Added {added} {(added == 1 ? "sub-item" : "sub-items")}.", tone: StatusTone.Success);
    }

    public async ValueTask DisposeAsync()
    {
        if (_local is not null) await _local.DisposeAsync();
    }

    private async Task AddSubItemAsync()
    {
        var title = _newSubItem.Trim();
        if (title.Length == 0) return;
        _newSubItem = string.Empty;
        try
        {
            await BoardService.AddSubItemAsync(Database.Id, Row.Id, title, await CurrentUserAccessor.GetCurrentUsernameAsync());
            await LoadSubItemsAsync();
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            _newSubItem = title;
            Toasts.Show($"Couldn't add that sub-item. {ex.Message}", tone: StatusTone.Danger);
        }
    }
}
