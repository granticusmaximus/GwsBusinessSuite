@page "/admin/deal-scoring"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "AdminOnly")]
@using Microsoft.AspNetCore.Authorization
@using GwsBusinessSuite.Application.Scoring

<PageTitle>Deal Scoring</PageTitle>

<div class="page-header">
    <h1><i class="bi bi-graph-up-arrow me-2 text-primary"></i>Deal Scoring</h1>
    <p>A heuristic win-likelihood score for every open deal, based on your own historical win rate, contact engagement, pace, and close date - not a trained model.</p>
</div>

@if (Result is null)
{
    <LoadingIndicator Message="Loading deal scores…" />
}
else
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 text-center">
                <div class="col-4">
                    <div class="h4 mb-0">@Result.Baseline.ClosedDealCount</div>
                    <div class="text-secondary small">Closed deals on record</div>
                </div>
                <div class="col-4">
                    <div class="h4 mb-0">@Result.Baseline.HistoricalWinRatePercent%</div>
                    <div class="text-secondary small">Historical win rate</div>
                </div>
                <div class="col-4">
                    <div class="h4 mb-0">@(Result.Baseline.AverageWonDealAgeDays?.ToString("0.#") ?? "—")</div>
                    <div class="text-secondary small">Avg. days to win</div>
                </div>
            </div>
        </div>
    </div>

    @if (Result.Deals.Count == 0)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <EmptyState Icon="bi-graph-up-arrow" Message="No open deals to score." CssClass="text-secondary" />
            </div>
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var deal in Result.Deals)
            {
                <div class="list-group-item">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div class="min-w-0">
                            <div class="fw-semibold">@deal.DealTitle</div>
                            <div class="text-secondary small">@deal.ContactName &middot; @deal.Stage &middot; @deal.ValueUsd.ToString("C0")</div>
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-shrink-0">
                            <span class="badge @BandBadgeClass(deal.Band)">@deal.Band</span>
                            <span class="fw-semibold">@deal.Score</span>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleExpanded(deal.DealId)">
                                <i class="bi @(IsExpanded(deal.DealId) ? "bi-chevron-up" : "bi-chevron-down")"></i>
                            </button>
                        </div>
                    </div>
                    @if (IsExpanded(deal.DealId))
                    {
                        <ul class="list-unstyled small mt-2 mb-0 ps-2 border-start">
                            @foreach (var factor in deal.Factors)
                            {
                                <li class="mb-1">
                                    <span class="fw-semibold">@(factor.Points >= 0 ? "+" : "")@factor.Points</span>
                                    @factor.Label &mdash; <span class="text-secondary">@factor.Detail</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            }
        </div>
    }
}

@code {
    [Inject] private IDealScoringService ScoringService { get; set; } = default!;

    private DealScoringResult? Result { get; set; }
    private readonly HashSet<Guid> _expanded = [];

    protected override async Task OnInitializedAsync()
    {
        Result = await ScoringService.ScoreOpenDealsAsync();
    }

    private void ToggleExpanded(Guid dealId)
    {
        if (!_expanded.Add(dealId)) _expanded.Remove(dealId);
    }

    private bool IsExpanded(Guid dealId) => _expanded.Contains(dealId);

    private static string BandBadgeClass(string band) => band switch
    {
        DealScoreBands.Hot => "text-bg-success",
        DealScoreBands.Warm => "text-bg-primary",
        DealScoreBands.Cool => "text-bg-warning",
        _ => "text-bg-secondary"
    };
}
