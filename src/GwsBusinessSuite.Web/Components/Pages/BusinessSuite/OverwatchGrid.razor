    private async Task GoToFavoriteAsync(CameraFeed favorite)
    {
        await JS.InvokeVoidAsync("tacticalGlobe.flyTo", "tg-viewport", favorite.Latitude, favorite.Longitude, 3000);
        await JS.InvokeVoidAsync("tacticalGlobe.openCamera", ToPinPayload(favorite));
    }

    // Called from tactical-globe.js's SHARE VIEW button (see buildShareLink) with whatever
    // camera(s) are currently open plus the camera's own current position/height - encodes it
    // statelessly (no DB row) and returns an absolute URL back to this same page. The recipient
    // must already be an authenticated admin, since /admin/osint keeps its existing AdminOnly
    // policy regardless of the "v" query parameter.
    [JSInvokable]
    public Task<string> BuildShareLinkAsync(double latitude, double longitude, double heightMeters, List<SharedCameraDto> openCameras)
    {
        var cameras = openCameras
            .Select(c => new CameraFeed(c.Id, c.Name, c.Lat, c.Lon, c.StreamUrl, Enum.Parse<CameraStreamKind>(c.StreamKind), c.SourceName, c.SourceAttributionUrl))
            .ToList();
        var token = SharedGridViewCodec.Encode(new SharedGridView(latitude, longitude, heightMeters, cameras));
        return Task.FromResult(Navigation.ToAbsoluteUri($"/admin/osint?v={Uri.EscapeDataString(token)}").ToString());
    }

    public sealed record SharedCameraDto(string Id, string Name, double Lat, double Lon, string StreamUrl, string StreamKind, string SourceName, string SourceAttributionUrl);

    private static readonly Task<IReadOnlyList<WeatherAlert>> NoAlerts = Task.FromResult<IReadOnlyList<WeatherAlert>>([]);
    private static readonly Task<IReadOnlyList<TrafficIncident>> NoIncidents = Task.FromResult<IReadOnlyList<TrafficIncident>>([]);

    // Raised by tactical-globe.js's camera.moveEnd handler once the view settles after a
    // drag/zoom (see initGlobe) - degrees, matching Cesium's own Rectangle-to-degrees output.
    //
    // Perf note: cameras/alerts/incidents/weather are 4 independent external lookups - none
    // needs another's result to start - but this used to await them one at a time (camera fetch,
    // then a JS round trip, then alerts, then incidents, then weather), so every pan/zoom paid
    // roughly the SUM of every enabled layer's latency instead of just the slowest one. That
    // chain got materially worse as this session's Overwatch coverage expansion grew the camera/
    // incident provider count well past what it was when this handler was first written (each
    // directory service already fans out across its own providers in parallel - see
    // CameraDirectoryService/TrafficIncidentDirectoryService - the serialization was only ever
    // at this level). Fanning all 4 out together and awaiting them as a group cuts the
    // steady-state per-settle latency to roughly the slowest single one.
    [JSInvokable]
    public async Task OnGlobeViewChanged(double north, double south, double east, double west)
    {
        _lastBbox = new BoundingBox(north, south, east, west);
        _hasSettledOnce = true;

        var centerLatitude = (north + south) / 2.0;
        var centerLongitude = (east + west) / 2.0;

        var camerasTask = CameraDirectoryService.GetCamerasForViewAsync(_lastBbox,
            include: _hideUnhealthy ? c => !IsKnownUnhealthy(c.Id) : null);
        var alertsTask = _alertsOn ? NwsAlertsService.GetActiveAlertsAsync(_lastBbox) : NoAlerts;
        var incidentsTask = _incidentsOn ? TrafficIncidentDirectoryService.GetIncidentsInBoundingBoxAsync(_lastBbox) : NoIncidents;
        var weatherTask = NwsForecastService.GetSnapshotAsync(centerLatitude, centerLongitude);
        var hazardsTask = _hazardsOn ? PushHazardsAsync() : Task.CompletedTask;
        var radarTask = _radarOn ? PushRadarAsync(centerLatitude, centerLongitude) : Task.CompletedTask;
        var signsTask = _signsOn ? PushSignsAsync() : Task.CompletedTask;
        var roadWeatherTask = _roadWeatherOn ? PushRoadWeatherAsync() : Task.CompletedTask;
        await Task.WhenAll(camerasTask, alertsTask, incidentsTask, weatherTask, hazardsTask, radarTask, signsTask, roadWeatherTask);

        _visibleCameras = camerasTask.Result.Cameras.ToList();
        _camerasInViewTotal = camerasTask.Result.TotalInView;
        // Reset the dismiss so a future empty area shows the hint again - this isn't a
        // one-time app-level notice like the provider-setup banner, it's per-location
        // information that should reappear whenever it becomes true again.
        if (_visibleCameras.Count > 0)
        {
            _emptyHintDismissed = false;
        }
        StateHasChanged();

        var pins = _visibleCameras.Select(ToPinPayload).ToList();
        await JS.InvokeVoidAsync("tacticalGlobe.setCameraPins", pins);

        if (_alertsOn)
        {
            await ApplyAlertsAsync(alertsTask.Result);
        }

        if (_incidentsOn)
        {
            await ApplyIncidentsAsync(incidentsTask.Result);
        }

        // Weather-on-zoom: always kept current for wherever the view is centered, not gated
        // behind a toggle - matches cameras/pins being always-on rather than opt-in.
        var weather = weatherTask.Result;
        await JS.InvokeVoidAsync("tacticalGlobe.setWeatherSnapshot", weather is null ? null : new
        {
            currentTemperatureFahrenheit = weather.CurrentTemperatureFahrenheit,
            currentConditions = weather.CurrentConditions,
            forecastTemperatureFahrenheit = weather.ForecastTemperatureFahrenheit,
            shortForecast = weather.ShortForecast,
            detailedForecast = weather.DetailedForecast,
            windSpeed = weather.WindSpeed,
            windDirection = weather.WindDirection,
            chanceOfPrecipitationPercent = weather.ChanceOfPrecipitationPercent
        });
    }

    // Bound to both the RADAR button and tactical-globe.js's "R" keydown shortcut (which
    // synthesizes a click on the same button rather than duplicating this logic in JS).
    private async Task ToggleRadarAsync()
    {
        _radarOn = !_radarOn;
        if (_radarOn && _lastBbox is { } bbox)
        {
            await PushRadarAsync((bbox.North + bbox.South) / 2.0, (bbox.East + bbox.West) / 2.0);
        }
        await JS.InvokeVoidAsync("tacticalGlobe.setRadarVisible", _radarOn);
    }

    // The radar timeline (cached server-side for 5 minutes, so re-sending it on every settle
    // costs nothing and keeps it current; the script ignores an unchanged timeline) plus the NWS
    // hourly forecast for the view's center, which the scrubber shows for future frames.
    private async Task PushRadarAsync(double centerLatitude, double centerLongitude)
    {
        var timelineTask = RadarTimelineService.GetTimelineAsync();
        var hourlyTask = NwsForecastService.GetHourlyAsync(centerLatitude, centerLongitude);
        await Task.WhenAll(timelineTask, hourlyTask);

        var timeline = timelineTask.Result;
        await JS.InvokeVoidAsync("tacticalGlobe.setRadarTimeline", new
        {
            nowIndex = timeline.NowIndex,
            modelRunUtc = timeline.ModelRunUtc,
            frames = timeline.Frames.Select(frame => new
            {
                validUtc = frame.ValidUtc,
                kind = frame.Kind.ToString(),
                tileUrlTemplate = frame.TileUrlTemplate
            })
        });
        await JS.InvokeVoidAsync("tacticalGlobe.setHourlyForecast", hourlyTask.Result
            .Where(hour => hour.EndUtc > DateTimeOffset.UtcNow)
            .Take(24)
            .Select(hour => new
            {
                startUtc = hour.StartUtc,
                endUtc = hour.EndUtc,
                temperatureFahrenheit = hour.TemperatureFahrenheit,
                chanceOfPrecipitationPercent = hour.ChanceOfPrecipitationPercent,
                shortForecast = hour.ShortForecast
            }));
    }

    private async Task ToggleAlertsAsync()
    {
        _alertsOn = !_alertsOn;
        if (_alertsOn)
        {
            await PushAlertsAsync();
        }
        else
        {
            await JS.InvokeVoidAsync("tacticalGlobe.clearWeatherAlerts");
        }
    }

    private async Task PushAlertsAsync()
    {
        var alerts = await NwsAlertsService.GetActiveAlertsAsync(_lastBbox);
        await ApplyAlertsAsync(alerts);
    }

    // Split from PushAlertsAsync so OnGlobeViewChanged can fetch alerts in parallel with
    // cameras/incidents/weather and only pay for this (JS-facing) part sequentially, once the
    // fetch it depends on has actually landed.
    private async Task ApplyAlertsAsync(IReadOnlyList<WeatherAlert> alerts)
    {
        var payload = alerts.Select(a => new
        {
            id = a.Id,
            eventName = a.Event,
            severity = a.Severity,
            areaDescription = a.AreaDescription,
            rings = a.Rings.Select(ring => ring.Select(v => new[] { v.Longitude, v.Latitude }).ToList()).ToList()
        }).ToList();
        await JS.InvokeVoidAsync("tacticalGlobe.setWeatherAlerts", payload);

        // Weather-camera correlation: badge any currently-visible camera pin that falls inside
        // one of these alert polygons, so the ALERTS and camera layers actually inform each
        // other instead of just being two independent overlays. Worst severity wins when a
        // camera sits under more than one overlapping alert.
        var highlights = _visibleCameras
            .Select(camera => new
            {
                cameraId = camera.Id,
                severity = alerts
                    .Where(a => GeoPolygon.Contains(a.Rings, camera.Latitude, camera.Longitude))
                    .OrderBy(a => AlertSeverityRank(a.Severity))
                    .Select(a => a.Severity)
                    .FirstOrDefault()
            })
            .Where(h => h.severity is not null)
            .ToList();
        await JS.InvokeVoidAsync("tacticalGlobe.setCameraAlertHighlights", highlights);
    }

    private static int AlertSeverityRank(string severity) => severity switch
    {
        "Extreme" => 0,
        "Severe" => 1,
        "Moderate" => 2,
        _ => 3
    };

    private async Task ToggleIncidentsAsync()
    {
        _incidentsOn = !_incidentsOn;
        if (_incidentsOn)
        {
            await PushIncidentsAsync();
        }
        else
        {
            await JS.InvokeVoidAsync("tacticalGlobe.clearTrafficIncidents");
        }
    }

    // Plain client-side UI state (which panel is open) - no JS/server round-trip needed to
    // toggle it, unlike RADAR/ALERTS/INCIDENTS which each drive a Cesium layer.
    private void ToggleCoverageIndex()
    {
        _coverageIndexOpen = !_coverageIndexOpen;
    }

    private bool _coverageOnMap;

    private const string OverwatchAreaSeverityAny = "any";
    private bool _areasOpen;
    private bool _areaBusy;
    private string _areaName = string.Empty;
    private bool _areaIncidents = true;
    private bool _areaWeather = true;
    private bool _areaHazards = true;
    private string _areaSeverity = "moderate";
    private string? _areaMessage;
    private List<GwsBusinessSuite.Infrastructure.Services.OverwatchAreaView> _areas = new();

    private async Task ToggleAreasPanelAsync()
    {
        _areasOpen = !_areasOpen;
        _areaMessage = null;
        if (_areasOpen)
        {
            _areas = (await OverwatchAreaService.ListAreasAsync(_username)).ToList();
            _captures = IncidentCaptureService.ListForUser(_username).ToList();
        }
    }

    private List<GwsBusinessSuite.Infrastructure.Services.IncidentCapture> _captures = new();

    private int CaptureFrameCount(GwsBusinessSuite.Infrastructure.Services.IncidentCaptureCamera camera) =>
        CameraTimelapseStore.ListFrames(camera.FrameKey).Count;

    private async Task OpenCaptureCameraAsync(GwsBusinessSuite.Infrastructure.Services.IncidentCapture capture,
        GwsBusinessSuite.Infrastructure.Services.IncidentCaptureCamera camera)
    {
        var frames = CameraTimelapseStore.ListFrames(camera.FrameKey)
            .Select(f => new
            {
                url = $"/admin/api/overwatch/timelapse/{Uri.EscapeDataString(camera.FrameKey)}/{f.FileName}",
                label = (f.CapturedAt < capture.StartedAt ? "BEFORE · " : "") +
                        f.CapturedAt.ToLocalTime().ToString("MMM d, h:mm tt", System.Globalization.CultureInfo.InvariantCulture)
            })
            .ToList();
        await JS.InvokeVoidAsync("tacticalGlobe.openTimelapse", $"{capture.Title} - {camera.Name}", frames);
    }

    private void DeleteCapture(GwsBusinessSuite.Infrastructure.Services.IncidentCapture capture)
    {
        IncidentCaptureService.Delete(_username, capture.Id);
        _captures.RemoveAll(c => c.Id == capture.Id);
    }

    private async Task AddAreaAsync()
    {
        _areaBusy = true;
        _areaMessage = null;
        try
        {
            var added = await OverwatchAreaService.AddAreaAsync(_username, _areaName, _lastBbox, _areaIncidents, _areaWeather, _areaHazards, _areaSeverity);
            _areaName = string.Empty;
            _areaMessage = $"Watching {added.Name}. The first check learns what's already there; after that, new items appear in the bell.";
            _areas = (await OverwatchAreaService.ListAreasAsync(_username)).ToList();
        }
        catch (ArgumentException ex)
        {
            _areaMessage = ex.Message;
        }
        finally
        {
            _areaBusy = false;
        }
    }

    private async Task RemoveAreaAsync(GwsBusinessSuite.Infrastructure.Services.OverwatchAreaView area)
    {
        await OverwatchAreaService.RemoveAreaAsync(_username, area.Id);
        _areas = (await OverwatchAreaService.ListAreasAsync(_username)).ToList();
    }

    private async Task GoToAreaAsync(GwsBusinessSuite.Infrastructure.Services.OverwatchAreaView area) =>
        await JS.InvokeVoidAsync("tacticalGlobe.flyToBounds", "tg-viewport", area.Bounds.West, area.Bounds.South, area.Bounds.East, area.Bounds.North);

    private static string AreaDescription(GwsBusinessSuite.Infrastructure.Services.OverwatchAreaView area)
    {
        var what = new[] { area.WatchIncidents ? "incidents" : null, area.WatchWeather ? "weather" : null, area.WatchHazards ? "hazards" : null }
            .Where(w => w is not null);
        var checkedText = area.LastCheckedAt is { } at ? $"checked {Ago(at)}" : "first check pending";
        return $"{string.Join(", ", what)} · {area.MinSeverity} · {checkedText}";
    }

    private bool _routeOpen;
    private bool _routeBusy;
    private readonly List<string> _routeStops = [string.Empty, string.Empty];
    private int? _pickingStop;
    private string _tripName = string.Empty;
    private string? _tripMessage;
    private List<GwsBusinessSuite.Infrastructure.Services.OverwatchTripView> _trips = new();
    private GwsBusinessSuite.Application.RouteWatch.RouteWatchResult? _route;
    // "datetime-local" value (yyyy-MM-ddTHH:mm) in this server's local time zone - the same zone
    // every other admin time on this page is shown in. Blank means "leaving now".
    // "Ask the cameras": still-image cameras along the route read by a vision model on the Ollama
    // of the computer the browser is on (BrowserLocalOllamaService) - never the server's.
    public const int MaxConditionCameras = 12;
    private static readonly TimeSpan ConditionTimeout = TimeSpan.FromSeconds(90);
    private GwsBusinessSuite.Web.Services.BrowserLocalOllamaService? _localModels;
    private List<string> _visionModels = new();
    private string _conditionModel = string.Empty;
    private string _conditionQuestion = string.Empty;
    private string? _conditionError;
    private bool _conditionBusy;
    private readonly List<(GwsBusinessSuite.Application.RouteWatch.RouteCamera Camera, GwsBusinessSuite.Application.RouteWatch.CameraConditionReading Reading)> _conditionResults = new();

    private static IReadOnlyList<GwsBusinessSuite.Application.RouteWatch.RouteCamera> RouteConditionCameras(GwsBusinessSuite.Application.RouteWatch.RouteWatchResult route) =>
        GwsBusinessSuite.Application.RouteWatch.RouteWatchService.ThinAlongRoute(
            route.Cameras.Where(c => c.Camera.StreamKind == CameraStreamKind.Snapshot).ToList(), MaxConditionCameras);

    private async Task LoadVisionModelsAsync()
    {
        if (_visionModels.Count > 0) return;
        try
        {
            _localModels ??= new GwsBusinessSuite.Web.Services.BrowserLocalOllamaService(JS);
            var status = await _localModels.ProbeAsync();
            if (!status.IsReachable)
            {
                _conditionError = status.Error ?? "Ollama isn't reachable on this computer.";
                return;
            }
            _visionModels = status.Models.OrderBy(m => GwsBusinessSuite.Application.RouteWatch.CameraConditions.LooksVisionCapable(m) ? 0 : 1)
                .ThenBy(m => m, StringComparer.OrdinalIgnoreCase).ToList();
            _conditionModel = _visionModels.FirstOrDefault() ?? string.Empty;
            _conditionError = _visionModels.Count == 0 ? "No models are installed in this computer's Ollama." : null;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "Couldn't list local Ollama models for ask-the-cameras");
            _conditionError = "Couldn't reach Ollama on this computer.";
        }
    }

    private async Task AskCamerasAsync()
    {
        if (_route is not { Error: null } route || _localModels is null || string.IsNullOrWhiteSpace(_conditionModel)) return;
        _conditionBusy = true;
        _conditionError = null;
        _conditionResults.Clear();
        await JS.InvokeVoidAsync("tacticalGlobe.setRouteConditions", "tg-viewport", Array.Empty<object>());
        try
        {
            foreach (var camera in RouteConditionCameras(route))
            {
                GwsBusinessSuite.Application.RouteWatch.CameraConditionReading reading;
                var frame = await CameraSnapshotDownloader.DownloadAsync(camera.Camera.StreamUrl);
                if (frame is null)
                {
                    reading = new("unknown", "unknown", "unknown", "Couldn't get a frame from this camera.", "", GwsBusinessSuite.Application.RouteWatch.CameraConditions.UnknownLevel);
                }
                else
                {
                    using var timeout = new CancellationTokenSource(ConditionTimeout);
                    try
                    {
                        var output = await _localModels.GenerateWithImagesAsync(_conditionModel,
                            GwsBusinessSuite.Application.RouteWatch.CameraConditions.SystemPrompt,
                            GwsBusinessSuite.Application.RouteWatch.CameraConditions.UserPrompt(_conditionQuestion),
                            [Convert.ToBase64String(frame)], json: true, timeout.Token);
                        reading = GwsBusinessSuite.Application.RouteWatch.CameraConditions.Parse(output);
                    }
                    catch (OperationCanceledException) when (timeout.IsCancellationRequested)
                    {
                        reading = new("unknown", "unknown", "unknown", "The model took too long on this frame.", "", GwsBusinessSuite.Application.RouteWatch.CameraConditions.UnknownLevel);
                    }
                }

                _conditionResults.Add((camera, reading));
                await JS.InvokeVoidAsync("tacticalGlobe.setRouteConditions", "tg-viewport", _conditionResults.Select(r => new
                {
                    lat = r.Camera.Camera.Latitude,
                    lon = r.Camera.Camera.Longitude,
                    level = r.Reading.Level
                }).ToList());
                StateHasChanged();
            }
        }
        catch (InvalidOperationException ex)
        {
            // The relay's own failures (Ollama stopped, model not installed, site not allowed) are
            // already worded for the person reading them.
            _conditionError = ex.Message;
        }
        finally
        {
            _conditionBusy = false;
        }
    }

    private static string ConditionLabel(GwsBusinessSuite.Application.RouteWatch.CameraConditionReading reading) =>
        reading.Level == GwsBusinessSuite.Application.RouteWatch.CameraConditions.UnknownLevel
            ? "NO READING"
            : string.Join(" · ", new[]
            {
                reading.Road == "unknown" ? null : "ROAD " + reading.Road.ToUpperInvariant(),
                reading.Visibility is "unknown" or "clear" ? null : reading.Visibility.ToUpperInvariant(),
                reading.Traffic == "unknown" ? null : reading.Traffic.ToUpperInvariant() + " TRAFFIC"
            }.Where(part => part is not null));

    private string ConditionSummary()
    {
        var bad = _conditionResults.Where(r => r.Reading.Level == GwsBusinessSuite.Application.RouteWatch.CameraConditions.BadLevel).ToList();
        var caution = _conditionResults.Count(r => r.Reading.Level == GwsBusinessSuite.Application.RouteWatch.CameraConditions.CautionLevel);
        var ok = _conditionResults.Count(r => r.Reading.Level == GwsBusinessSuite.Application.RouteWatch.CameraConditions.OkLevel);
        var unread = _conditionResults.Count(r => r.Reading.Level == GwsBusinessSuite.Application.RouteWatch.CameraConditions.UnknownLevel);
        var where = bad.Count > 0 ? $" - worst from MI {bad.Min(r => r.Camera.MilesAlong):0} to {bad.Max(r => r.Camera.MilesAlong):0}" : string.Empty;
        return $"{bad.Count} BAD · {caution} CAUTION · {ok} CLEAR · {unread} NO READING{where}";
    }

    private string _departureLocal = string.Empty;
    private IReadOnlyList<GwsBusinessSuite.Application.RouteWatch.DrivingLightStretch> _drivingLight = [];

    private DateTimeOffset DepartureUtc()
    {
        if (DateTime.TryParse(_departureLocal, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var local))
        {
            var unspecified = DateTime.SpecifyKind(local, DateTimeKind.Unspecified);
            return new DateTimeOffset(unspecified, TimeZoneInfo.Local.GetUtcOffset(unspecified)).ToUniversalTime();
        }
        return DateTimeOffset.UtcNow;
    }

    private static string FormatClock(DateTimeOffset utc) => utc.ToLocalTime().ToString("h:mm tt", System.Globalization.CultureInfo.InvariantCulture);

    private async Task OnDepartureChangedAsync(ChangeEventArgs e)
    {
        _departureLocal = e.Value?.ToString() ?? string.Empty;
        await UpdateDrivingLightAsync();
    }

    // Sun glare and darkness for the current route at the chosen departure time - pure maths on
    // the route already in hand, so changing the time never re-routes.
    private async Task UpdateDrivingLightAsync()
    {
        if (_route is not { Error: null } route)
        {
            _drivingLight = [];
            return;
        }
        _drivingLight = GwsBusinessSuite.Application.RouteWatch.DrivingLightAnalyzer.Analyze(
            route.Path, route.Legs, route.DurationMinutes, DepartureUtc());
        await JS.InvokeVoidAsync("tacticalGlobe.setRouteHighlights", "tg-viewport", _drivingLight.Select(stretch => new
        {
            kind = stretch.Kind.ToString(),
            path = ThinPath(stretch.Path, 400).Select(p => new[] { p.Longitude, p.Latitude })
        }).ToList());
    }

    private static IEnumerable<GwsBusinessSuite.Application.RouteWatch.RoutePoint> ThinPath(
        IReadOnlyList<GwsBusinessSuite.Application.RouteWatch.RoutePoint> path, int max)
    {
        if (path.Count <= max) return path;
        var step = (path.Count - 1) / (double)(max - 1);
        return Enumerable.Range(0, max).Select(i => path[(int)Math.Round(i * step)]);
    }

