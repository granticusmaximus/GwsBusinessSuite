        try
        {
            var result = await HazardLayerService.GetHazardsAsync(_lastBbox);
            var payload = result.Features.Select(h => new
            {
                id = h.Id,
                kind = h.Kind,
                title = h.Title,
                detail = h.Detail,
                severity = h.Severity,
                url = h.Url,
                observedAt = h.ObservedAt?.ToLocalTime().ToString("dd-MM-yy HH:mm", System.Globalization.CultureInfo.InvariantCulture),
                lat = h.Latitude,
                lon = h.Longitude
            }).ToList();
            var counts = new[]
            {
                (Kind: GwsBusinessSuite.Application.Hazards.HazardKinds.Earthquake, Label: "QUAKES"),
                (Kind: GwsBusinessSuite.Application.Hazards.HazardKinds.Wildfire, Label: "FIRES"),
                (Kind: GwsBusinessSuite.Application.Hazards.HazardKinds.River, Label: "FLOODING GAUGES")
            }.Select(k => $"{k.Label} {result.Features.Count(f => f.Kind == k.Kind)}");
            _hazardSummary = string.Join(" · ", counts) + (result.Notes.Count > 0 ? " - " + string.Join(" ", result.Notes) : string.Empty);
            await JS.InvokeVoidAsync("tacticalGlobe.setHazards", payload);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "Overwatch hazard layer failed");
            _hazardSummary = "Hazard sources couldn't be reached.";
        }
    }

    // Region rows say what this session has actually seen from the source. Most providers report
    // a failed fetch as an empty answer, so "nothing returned yet" is the honest wording rather
    // than "down".
    private (bool Ok, string Text) RegionStatus(CameraCoverageRegion region)
    {
        var kind = region.Name.Contains("Incidents", StringComparison.OrdinalIgnoreCase)
            ? SourceStatusTracker.IncidentKind
            : SourceStatusTracker.CameraKind;
        var status = SourceStatusTracker.Get(region.SourceName, kind);
        if (status is null) return (false, "not queried yet - fly there to check");
        if (status.LastAttemptFailed) return (false, $"failing ({status.LastError})");
        if (status.LastNonEmptyAt is { } seen)
            return (true, $"up to {status.MaxItemsSeen:N0} {kind} in one view · last returned {Ago(seen)}");
        return (false, $"answered with no {kind} so far");
    }

    private static string Ago(DateTimeOffset when)
    {
        var span = DateTimeOffset.UtcNow - when;
        return span.TotalMinutes < 1 ? "just now"
            : span.TotalMinutes < 90 ? $"{(int)span.TotalMinutes} min ago"
            : $"{(int)span.TotalHours} h ago";
    }

    private async Task ToggleCoverageOnMapAsync()
    {
        _coverageOnMap = !_coverageOnMap;
        if (_coverageOnMap)
        {
            var markers = CameraCoverageRegions.All.Select(region => new
            {
                label = region.Name,
                lat = region.Latitude,
                lon = region.Longitude,
                ok = RegionStatus(region).Ok
            }).ToList();
            await JS.InvokeVoidAsync("tacticalGlobe.setCoverageMarkers", markers);
        }
        else
        {
            await JS.InvokeVoidAsync("tacticalGlobe.clearCoverageMarkers");
        }
    }

    private async Task FlyToRegionAsync(CameraCoverageRegion region)
    {
        await JS.InvokeVoidAsync("tacticalGlobe.flyTo", "tg-viewport", region.Latitude, region.Longitude, region.FlyToHeightMeters);
    }

    // Selection itself is entirely client-side (each pin already carries its full camera
    // payload) - this just flips the mode flag JS uses to route pin clicks to selection instead
    // of opening a stream panel directly.
    private async Task ToggleSelectModeAsync()
    {
        _selectModeOn = !_selectModeOn;
        await JS.InvokeVoidAsync("tacticalGlobe.setSelectModeEnabled", "tg-viewport", _selectModeOn);
    }

    private async Task PushIncidentsAsync()
    {
        var incidents = await TrafficIncidentDirectoryService.GetIncidentsInBoundingBoxAsync(_lastBbox);
        await ApplyIncidentsAsync(incidents);
    }

    // Split from PushIncidentsAsync for the same reason as ApplyAlertsAsync above - lets
    // OnGlobeViewChanged fetch incidents in parallel with cameras/alerts/weather.
    private List<TrafficIncident> _lastIncidents = new();
    private readonly HashSet<string> _hiddenIncidentCategories = new();

    private async Task ToggleIncidentCategoryAsync(string category)
    {
        if (!_hiddenIncidentCategories.Remove(category)) _hiddenIncidentCategories.Add(category);
        await ApplyIncidentsAsync(_lastIncidents);
    }

    private async Task ApplyIncidentsAsync(IReadOnlyList<TrafficIncident> incidents)
    {
        _lastIncidents = incidents.ToList();
        var payload = incidents.Where(i => !_hiddenIncidentCategories.Contains(i.Category)).Select(i => new
        {
            id = i.Id,
            roadwayName = i.RoadwayName,
            description = i.Description,
            eventType = i.EventType,
            severity = i.Severity,
            category = i.Category,
            categoryLabel = IncidentCategories.Label(i.Category),
            severityLevel = i.SeverityLevel,
            lanes = i.Lanes,
            endsAt = i.EndsAt?.ToLocalTime().ToString("dd-MM-yy HH:mm", System.Globalization.CultureInfo.InvariantCulture),
            lat = i.Latitude,
            lon = i.Longitude,
            sourceName = i.SourceName,
            sourceAttributionUrl = i.SourceAttributionUrl
        }).ToList();
        await JS.InvokeVoidAsync("tacticalGlobe.setTrafficIncidents", payload);
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _briefCts?.Cancel();
        _driveCts?.Cancel();
        _aircraftCts?.Cancel();
        _shipsCts?.Cancel();
        // The prerendered instance never initializes the browser viewport.
        if (_dotNetRef is null) return;
        try
        {
            await JS.InvokeVoidAsync("tacticalGlobe.dispose", "tg-viewport");
        }
        catch (JSDisconnectedException)
        {
        }
        _dotNetRef?.Dispose();
        if (_localModels is not null) await _localModels.DisposeAsync();
    }
}
