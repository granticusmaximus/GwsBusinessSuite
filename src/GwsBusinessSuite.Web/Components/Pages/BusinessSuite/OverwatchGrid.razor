    protected override async Task OnInitializedAsync()
    {
        var options = CameraIntelOptions.Value;
        _hasAnyProviderConfigured = !string.IsNullOrWhiteSpace(options.WsdotAccessCode)
            || !string.IsNullOrWhiteSpace(options.WindyApiKey)
            || !string.IsNullOrWhiteSpace(options.MapillaryAccessToken);

        _username = await CurrentUserAccessor.GetCurrentUsernameAsync();
        _favorites = (await CameraFavoritesService.GetFavoritesAsync(_username)).ToList();
        _favoriteCameraIds = _favorites.Select(f => f.Id).ToHashSet();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_streetSceneNeedsOpen && _streetScene is { } openScene)
        {
            _streetSceneNeedsOpen = false;
            await JS.InvokeAsync<bool>("gwsStreetView.open", "tg-sv", _dotNetRef, StreetSceneForViewer(openScene));
        }
        if (!firstRender) return;

        if (!_hasAnyProviderConfigured)
        {
            _bannerDismissed = await JS.InvokeAsync<bool>("tacticalGlobe.isCoverageBannerDismissed");
            StateHasChanged();
        }

        _dotNetRef = DotNetObjectReference.Create(this);
        try
        {
            // A real incident: a Cesium API mismatch (OpenStreetMapImageryProvider.fromUrl,
            // which doesn't exist in this pinned version) threw synchronously inside init(),
            // which JS interop surfaces back here as a JSException - left uncaught, that fault
            // an unhandled exception in a lifecycle method - took down this component's whole
            // circuit, which is why the reported symptom was "nothing on the page responds
            // anymore," not just "the globe didn't load." Catching it here keeps a future JS
            // regression contained to this one page instead of freezing the whole app.
            await JS.InvokeVoidAsync("tacticalGlobe.init", "tg-viewport", _dotNetRef, new { ionToken = IonToken });
        }
        catch (JSException ex)
        {
            Logger.LogError(ex, "Failed to initialize the Overwatch viewport.");
            _initError = "The globe failed to start. Check the browser console for details, or try reloading.";
            StateHasChanged();
            return;
        }

        if (IonToken is not null)
        {
            try
            {
                await SetThreeDAsync(true);
            }
            catch (JSException ex)
            {
                Logger.LogWarning(ex, "Overwatch 3D cities failed to start");
            }
        }

        if (AreaId is { } areaId && await OverwatchAreaService.GetAreaAsync(_username, areaId) is { } linkedArea)
        {
            await JS.InvokeVoidAsync("tacticalGlobe.flyToBounds", "tg-viewport",
                linkedArea.Bounds.West, linkedArea.Bounds.South, linkedArea.Bounds.East, linkedArea.Bounds.North);
            _panelTab = "areas";
            _areas = (await OverwatchAreaService.ListAreasAsync(_username)).ToList();
            _captures = IncidentCaptureService.ListForUser(_username).ToList();
            StateHasChanged();
        }

        await JS.InvokeVoidAsync("tacticalGlobe.enableStreetViewDrop", "tg-viewport");

        if (DetectionId is { } detectionId && await CameraWatch.GetDetectionAsync(_username, detectionId) is { } found)
        {
            _detection = found.Alert;
            _detectionCamera = found.Camera;
            if (found.Camera is { } camera) await FlyToPointAsync(camera.Latitude, camera.Longitude);
            StateHasChanged();
        }

        _notes = (await MapNotes.ListAsync(_username)).ToList();
        if (NoteId is { } noteId)
        {
            if (await MapNotes.OpenAsync(_username, noteId, NoteKey) is { } linkedNote)
            {
                if (linkedNote.Owner != _username) _sharedNote = linkedNote;
                await OpenNoteAsync(linkedNote);
            }
            else
            {
                _noteMessage = "That map note link doesn't work any more.";
                _panelTab = _lastPanelTab = "saved";
            }
        }
        await PushNotesAsync();

        if (BriefingId is { } briefingId && await Briefings.GetMorningAlertAsync(_username, briefingId) is { } morning)
        {
            _morningBrief = morning;
            StateHasChanged();
        }

        if (!string.IsNullOrWhiteSpace(WorldNewsSituationId)) await OpenLinkedWorldNewsAsync(WorldNewsSituationId);

        if (LinkedRouteStops is { Length: >= 2 } linkedStops)
        {
            _routeStops.Clear();
            _routeStops.AddRange(linkedStops.Where(stop => !string.IsNullOrWhiteSpace(stop)).Take(GwsBusinessSuite.Application.RouteWatch.RouteWatchService.MaxStops));
            while (_routeStops.Count < 2) _routeStops.Add(string.Empty);
            await SelectPanelTabAsync("directions", keepOpen: true);
            await WatchRouteAsync();
            StateHasChanged();
        }

        var sharedView = SharedGridViewCodec.TryDecode(SharedViewToken);
        if (sharedView is not null)
        {
            await JS.InvokeVoidAsync("tacticalGlobe.flyTo", "tg-viewport", sharedView.Latitude, sharedView.Longitude, sharedView.HeightMeters);
            if (sharedView.OpenCameras.Count == 1)
            {
                await JS.InvokeVoidAsync("tacticalGlobe.openCamera", ToPinPayload(sharedView.OpenCameras[0]));
            }
            else if (sharedView.OpenCameras.Count > 1)
            {
                var pins = sharedView.OpenCameras.Select(ToPinPayload).ToList();
                await JS.InvokeVoidAsync("tacticalGlobe.openWatchWallWithCameras", "tg-viewport", pins);
            }
        }

        _ = MarkBootCompleteAsync();
    }

