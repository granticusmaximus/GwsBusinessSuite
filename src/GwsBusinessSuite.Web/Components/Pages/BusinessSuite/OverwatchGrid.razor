        var frames = CameraTimelapseStore.ListFrames(favorite.Id)
            .Select(f => new
            {
                url = $"/admin/api/overwatch/timelapse/{Uri.EscapeDataString(favorite.Id)}/{f.FileName}",
                label = f.CapturedAt.ToLocalTime().ToString("MMM d, h:mm tt", System.Globalization.CultureInfo.InvariantCulture)
