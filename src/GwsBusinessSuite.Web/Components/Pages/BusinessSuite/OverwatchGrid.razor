    private readonly List<(GwsBusinessSuite.Application.RouteWatch.RouteCamera Camera, GwsBusinessSuite.Application.RouteWatch.CameraConditionReading Reading)> _conditionResults = new();

    private static IReadOnlyList<GwsBusinessSuite.Application.RouteWatch.RouteCamera> RouteConditionCameras(GwsBusinessSuite.Application.RouteWatch.RouteWatchResult route) =>
        GwsBusinessSuite.Application.RouteWatch.RouteWatchService.ThinAlongRoute(
            route.Cameras.Where(c => c.Camera.StreamKind == CameraStreamKind.Snapshot).ToList(), MaxConditionCameras);

    private async Task LoadVisionModelsAsync()
    {
        if (_visionModels.Count > 0) return;
        try
        {
            _localModels ??= new GwsBusinessSuite.Web.Services.BrowserLocalOllamaService(JS);
            var status = await _localModels.ProbeAsync();
            if (!status.IsReachable)
            {
                _conditionError = status.Error ?? "Ollama isn't reachable on this computer.";
                return;
            }
            _visionModels = status.Models.OrderBy(m => GwsBusinessSuite.Application.RouteWatch.CameraConditions.LooksVisionCapable(m) ? 0 : 1)
                .ThenBy(m => m, StringComparer.OrdinalIgnoreCase).ToList();
            _conditionModel = _visionModels.FirstOrDefault() ?? string.Empty;
            _conditionError = _visionModels.Count == 0 ? "No models are installed in this computer's Ollama." : null;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "Couldn't list local Ollama models for ask-the-cameras");
            _conditionError = "Couldn't reach Ollama on this computer.";
        }
    }

    private async Task AskCamerasAsync()
    {
        if (_route is not { Error: null } route || _localModels is null || string.IsNullOrWhiteSpace(_conditionModel)) return;
        _conditionBusy = true;
        _conditionError = null;
        _conditionResults.Clear();
        await JS.InvokeVoidAsync("tacticalGlobe.setRouteConditions", "tg-viewport", Array.Empty<object>());
        try
        {
            foreach (var camera in RouteConditionCameras(route))
            {
                GwsBusinessSuite.Application.RouteWatch.CameraConditionReading reading;
                var frame = await CameraSnapshotDownloader.DownloadAsync(camera.Camera.StreamUrl);
                if (frame is null)
                {
                    reading = new("unknown", "unknown", "unknown", "Couldn't get a frame from this camera.", "", GwsBusinessSuite.Application.RouteWatch.CameraConditions.UnknownLevel);
                }
                else
                {
                    using var timeout = new CancellationTokenSource(ConditionTimeout);
                    try
                    {
                        var output = await _localModels.GenerateWithImagesAsync(_conditionModel,
                            GwsBusinessSuite.Application.RouteWatch.CameraConditions.SystemPrompt,
                            GwsBusinessSuite.Application.RouteWatch.CameraConditions.UserPrompt(_conditionQuestion),
                            [Convert.ToBase64String(frame)], json: true, timeout.Token);
                        reading = GwsBusinessSuite.Application.RouteWatch.CameraConditions.Parse(output);
                    }
                    catch (OperationCanceledException) when (timeout.IsCancellationRequested)
                    {
                        reading = new("unknown", "unknown", "unknown", "The model took too long on this frame.", "", GwsBusinessSuite.Application.RouteWatch.CameraConditions.UnknownLevel);
                    }
                }

                _conditionResults.Add((camera, reading));
                await JS.InvokeVoidAsync("tacticalGlobe.setRouteConditions", "tg-viewport", _conditionResults.Select(r => new
                {
                    lat = r.Camera.Camera.Latitude,
                    lon = r.Camera.Camera.Longitude,
                    level = r.Reading.Level
                }).ToList());
                StateHasChanged();
            }
        }
        catch (InvalidOperationException ex)
        {
            // The relay's own failures (Ollama stopped, model not installed, site not allowed) are
            // already worded for the person reading them.
            _conditionError = ex.Message;
        }
        finally
        {
            _conditionBusy = false;
        }
    }

    private static string ConditionLabel(GwsBusinessSuite.Application.RouteWatch.CameraConditionReading reading) =>
        reading.Level == GwsBusinessSuite.Application.RouteWatch.CameraConditions.UnknownLevel
            ? "NO READING"
            : string.Join(" · ", new[]
            {
                reading.Road == "unknown" ? null : "ROAD " + reading.Road.ToUpperInvariant(),
                reading.Visibility is "unknown" or "clear" ? null : reading.Visibility.ToUpperInvariant(),
                reading.Traffic == "unknown" ? null : reading.Traffic.ToUpperInvariant() + " TRAFFIC"
            }.Where(part => part is not null));

    private string ConditionSummary()
    {
        var bad = _conditionResults.Where(r => r.Reading.Level == GwsBusinessSuite.Application.RouteWatch.CameraConditions.BadLevel).ToList();
        var caution = _conditionResults.Count(r => r.Reading.Level == GwsBusinessSuite.Application.RouteWatch.CameraConditions.CautionLevel);
        var ok = _conditionResults.Count(r => r.Reading.Level == GwsBusinessSuite.Application.RouteWatch.CameraConditions.OkLevel);
        var unread = _conditionResults.Count(r => r.Reading.Level == GwsBusinessSuite.Application.RouteWatch.CameraConditions.UnknownLevel);
        var where = bad.Count > 0 ? $" - worst from MI {bad.Min(r => r.Camera.MilesAlong):0} to {bad.Max(r => r.Camera.MilesAlong):0}" : string.Empty;
        return $"{bad.Count} BAD · {caution} CAUTION · {ok} CLEAR · {unread} NO READING{where}";
    }

