    // Sun glare and darkness for the current route at the chosen departure time - pure maths on
    // the route already in hand, so changing the time never re-routes.
    private async Task UpdateDrivingLightAsync()
    {
        if (_route is not { Error: null } route)
        {
            _drivingLight = [];
            return;
        }
        _drivingLight = GwsBusinessSuite.Application.RouteWatch.DrivingLightAnalyzer.Analyze(
            route.Path, route.Legs, route.DurationMinutes, DepartureUtc());
        await JS.InvokeVoidAsync("tacticalGlobe.setRouteHighlights", "tg-viewport", _drivingLight.Select(stretch => new
        {
            kind = stretch.Kind.ToString(),
            path = ThinPath(stretch.Path, 400).Select(p => new[] { p.Longitude, p.Latitude })
        }).ToList());
    }

    private static IEnumerable<GwsBusinessSuite.Application.RouteWatch.RoutePoint> ThinPath(
        IReadOnlyList<GwsBusinessSuite.Application.RouteWatch.RoutePoint> path, int max)
    {
        if (path.Count <= max) return path;
        var step = (path.Count - 1) / (double)(max - 1);
        return Enumerable.Range(0, max).Select(i => path[(int)Math.Round(i * step)]);
    }

