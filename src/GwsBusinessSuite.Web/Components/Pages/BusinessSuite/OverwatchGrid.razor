@page "/admin/osint"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "AdminOnly")]
@using Microsoft.AspNetCore.Authorization
@using GwsBusinessSuite.Application.CameraIntel
@using GwsBusinessSuite.Application.Geocoding
@using GwsBusinessSuite.Application.TrafficIncidents
@using GwsBusinessSuite.Application.Weather
@inject CameraDirectoryService CameraDirectoryService
@inject INwsAlertsService NwsAlertsService
@inject INwsForecastService NwsForecastService
@inject TrafficIncidentDirectoryService TrafficIncidentDirectoryService
@inject IGeocodingService GeocodingService
@inject ICameraFavoritesService CameraFavoritesService
@inject ICameraSnapshotAnalysisService CameraSnapshotAnalysisService
@inject GwsBusinessSuite.Application.Abstractions.ICurrentUserAccessor CurrentUserAccessor
@inject Microsoft.Extensions.Options.IOptions<CameraIntelOptions> CameraIntelOptions
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ILogger<OverwatchGrid> Logger
@implements IAsyncDisposable

<PageTitle>Overwatch</PageTitle>

<div class="page-header d-flex flex-wrap align-items-start justify-content-between gap-3">
    <div>
        <h1><i class="bi bi-globe2 me-2 text-primary"></i>Overwatch</h1>
        <p class="mb-0">
            Drag/zoom the globe to discover legitimate public traffic cameras and webcams in
            view. Only publicly-provided feeds are ever surfaced here - see the attribution
            footer for each source.
        </p>
    </div>
</div>

@if (!_hasAnyProviderConfigured && !_bannerDismissed)
{
    <div class="alert alert-info alert-dismissible d-flex gap-2 align-items-start" role="note">
        <i class="bi bi-info-circle-fill mt-1" aria-hidden="true"></i>
        <div>
            No setup required: Georgia (GDOT) and Datumfeed's coverage (Austin, California,
            Ontario, Ottawa, Toronto, London, and Washington State) already work with zero
            registration. Optional API keys exist only to add Windy's global public webcams or
            raise Datumfeed's anonymous rate limit - see <code>CameraIntelOptions.cs</code> if
            you ever want either; nothing here requires them.
        </div>
        <button type="button" class="btn-close" aria-label="Dismiss" @onclick="DismissBannerAsync"></button>
    </div>
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cesium@1.145.0/Build/Cesium/Widgets/widgets.css" />
<script src="https://cdn.jsdelivr.net/npm/cesium@1.145.0/Build/Cesium/Cesium.js"></script>
<script src="/js/tactical-globe.js"></script>

<div class="tg-shell">
    <div class="tg-viewport" id="tg-viewport"></div>
    <div class="tg-scanlines"></div>
    <div class="tg-vignette"></div>

    <div class="tg-hud">
        <div>
            <div class="tg-hud-title">Overwatch // Camera + Weather Intelligence</div>
            <div class="tg-hud-sub">Public sources only - never unsecured private cameras</div>
            <div class="tg-search">
                <input type="text" id="tg-search-input" placeholder="JUMP TO CITY, ADDRESS, OR PLACE..." autocomplete="off" />
                <button type="button" id="tg-search-button">GO</button>
                <button type="button" id="tg-share-button" title="Copy a link to this exact view">SHARE VIEW</button>
                <span id="tg-search-status" class="tg-search-status"></span>
            </div>
        </div>
        <div class="tg-hud-status">
            <div>CAMERAS IN VIEW: @_visibleCameras.Count</div>
            <div class="tg-hud-toggles">
                <button type="button" data-tg-toggle="radar" class="tg-toggle @(_radarOn ? "tg-toggle-on" : "")" title="Toggle NOAA radar (R)" @onclick="ToggleRadarAsync">
                    RADAR [@(_radarOn ? "ON" : "OFF")]
                </button>
                <button type="button" data-tg-toggle="alerts" class="tg-toggle @(_alertsOn ? "tg-toggle-on" : "")" title="Toggle NWS severe weather alerts (A)" @onclick="ToggleAlertsAsync">
                    ALERTS [@(_alertsOn ? "ON" : "OFF")]
                </button>
                <button type="button" data-tg-toggle="incidents" class="tg-toggle @(_incidentsOn ? "tg-toggle-on" : "")" title="Toggle traffic accidents/roadwork/closures (I)" @onclick="ToggleIncidentsAsync">
                    INCIDENTS [@(_incidentsOn ? "ON" : "OFF")]
                </button>
                <button type="button" data-tg-toggle="coverage" class="tg-toggle @(_coverageIndexOpen ? "tg-toggle-on" : "")" title="Show known camera coverage regions (C)" @onclick="ToggleCoverageIndex">
                    COVERAGE
                </button>
                <button type="button" data-tg-toggle="select" class="tg-toggle @(_selectModeOn ? "tg-toggle-on" : "")" title="Select multiple cameras for the watch wall (S)" @onclick="ToggleSelectModeAsync">
                    SELECT [@(_selectModeOn ? "ON" : "OFF")]
                </button>
                <button type="button" data-tg-toggle="favorites" class="tg-toggle @(_favoritesOpen ? "tg-toggle-on" : "")" title="Show your favorited cameras (F)" @onclick="ToggleFavoritesPanel">
                    FAVORITES
                </button>
            </div>
        </div>
    </div>

    @if (_coverageIndexOpen)
    {
        <div class="tg-coverage-panel">
            <div class="tg-coverage-panel-header">KNOWN COVERAGE</div>
            <ul class="tg-coverage-list">
                @foreach (var region in CameraCoverageRegions.All)
                {
                    <li class="tg-coverage-item">
                        <span>@region.Name</span>
                        <button type="button" @onclick="() => FlyToRegionAsync(region)">GO</button>
                    </li>
                }
            </ul>
        </div>
    }

    @if (_favoritesOpen)
    {
        <div class="tg-coverage-panel tg-favorites-panel">
            <div class="tg-coverage-panel-header">MY FAVORITES</div>
            @if (_favorites.Count == 0)
            {
                <div class="tg-favorites-empty">No favorited cameras yet - open a camera's feed and click its star to save it here.</div>
            }
            else
            {
                <ul class="tg-coverage-list">
                    @foreach (var favorite in _favorites)
                    {
                        <li class="tg-coverage-item">
                            <span>@favorite.Name</span>
                            <button type="button" @onclick="() => GoToFavoriteAsync(favorite)">GO</button>
                        </li>
                    }
                </ul>
            }
        </div>
    }

    @if (_hasAnyProviderConfigured && _hasSettledOnce && _visibleCameras.Count == 0 && !_emptyHintDismissed)
    {
        <div class="tg-empty-hint">
            <span>
                NO KNOWN CAMERA COVERAGE IN THIS AREA &mdash; try Washington State (WSDOT) or zoom
                out for broader Windy webcam coverage.
            </span>
            <button type="button" class="tg-empty-hint-close" aria-label="Dismiss" @onclick="() => _emptyHintDismissed = true">&times;</button>
        </div>
    }

    <div class="tg-attribution">
        <span>Basemap: Esri, Maxar, Earthstar Geographics &middot; WSDOT &middot; GDOT &middot; Windy &middot; Datumfeed (Austin/Caltrans/Ontario/Ottawa/Toronto/London) &middot; NOAA/NWS &middot; Search: Photon/OSM, US Census Bureau</span>
        <span>ADMIN // AUTHORIZED ACCESS ONLY &middot; R: radar &middot; A: alerts &middot; I: incidents &middot; C: coverage &middot; S: select for watch wall &middot; F: favorites &middot; Esc: close feed</span>
    </div>

    @if (_initError is null)
    {
        <div class="tg-boot @(_bootComplete ? "tg-boot-hidden" : "")">
            <div class="tg-boot-line">INITIALIZING TACTICAL UPLINK...</div>
            <div class="tg-boot-bar"><div class="tg-boot-bar-fill"></div></div>
            <div class="tg-boot-line">STANDBY</div>
        </div>
    }
    else
    {
        <div class="tg-boot">
            <div class="tg-boot-line">UPLINK FAILED</div>
            <div class="tg-boot-line" style="opacity:.75;font-size:0.7rem;max-width:70%;text-align:center;">@_initError</div>
        </div>
    }
</div>

@code {
    // "v" for "view" - a Base64Url-encoded SharedGridView (see SharedGridViewCodec), read the
    // same way Login.razor reads its own query parameters.
    [SupplyParameterFromQuery(Name = "v")]
    public string? SharedViewToken { get; set; }

    private DotNetObjectReference<OverwatchGrid>? _dotNetRef;
    private List<CameraFeed> _visibleCameras = new();
    private bool _bootComplete;
    private bool _hasAnyProviderConfigured = true;
    private bool _bannerDismissed;
    private bool _emptyHintDismissed;
    private bool _hasSettledOnce;
    private bool _radarOn;
    private bool _alertsOn;
    private bool _incidentsOn;
    private bool _coverageIndexOpen;
    private bool _selectModeOn;
    private bool _favoritesOpen;
    private string _username = "unknown";
    private List<CameraFeed> _favorites = new();
    private HashSet<string> _favoriteCameraIds = new();
    private BoundingBox _lastBbox = new(90, -90, 180, -180);
    private string? _initError;

    protected override async Task OnInitializedAsync()
    {
        var options = CameraIntelOptions.Value;
        _hasAnyProviderConfigured = !string.IsNullOrWhiteSpace(options.WsdotAccessCode)
            || !string.IsNullOrWhiteSpace(options.WindyApiKey);

        _username = await CurrentUserAccessor.GetCurrentUsernameAsync();
        _favorites = (await CameraFavoritesService.GetFavoritesAsync(_username)).ToList();
        _favoriteCameraIds = _favorites.Select(f => f.Id).ToHashSet();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        if (!_hasAnyProviderConfigured)
        {
            _bannerDismissed = await JS.InvokeAsync<bool>("tacticalGlobe.isCoverageBannerDismissed");
            StateHasChanged();
        }

        _dotNetRef = DotNetObjectReference.Create(this);
        try
        {
            // A real incident: a Cesium API mismatch (OpenStreetMapImageryProvider.fromUrl,
            // which doesn't exist in this pinned version) threw synchronously inside init(),
            // which JS interop surfaces back here as a JSException - left uncaught, that fault
            // an unhandled exception in a lifecycle method - took down this component's whole
            // circuit, which is why the reported symptom was "nothing on the page responds
            // anymore," not just "the globe didn't load." Catching it here keeps a future JS
            // regression contained to this one page instead of freezing the whole app.
            await JS.InvokeVoidAsync("tacticalGlobe.init", "tg-viewport", _dotNetRef);
        }
        catch (JSException ex)
        {
            Logger.LogError(ex, "Failed to initialize the Overwatch viewport.");
            _initError = "The globe failed to start. Check the browser console for details, or try reloading.";
            StateHasChanged();
            return;
        }

        var sharedView = SharedGridViewCodec.TryDecode(SharedViewToken);
        if (sharedView is not null)
        {
            await JS.InvokeVoidAsync("tacticalGlobe.flyTo", "tg-viewport", sharedView.Latitude, sharedView.Longitude, sharedView.HeightMeters);
            if (sharedView.OpenCameras.Count == 1)
            {
                await JS.InvokeVoidAsync("tacticalGlobe.openCamera", ToPinPayload(sharedView.OpenCameras[0]));
            }
            else if (sharedView.OpenCameras.Count > 1)
            {
                var pins = sharedView.OpenCameras.Select(ToPinPayload).ToList();
                await JS.InvokeVoidAsync("tacticalGlobe.openWatchWallWithCameras", "tg-viewport", pins);
            }
        }

        _ = MarkBootCompleteAsync();
    }

    private async Task DismissBannerAsync()
    {
        _bannerDismissed = true;
        await JS.InvokeVoidAsync("tacticalGlobe.dismissCoverageBanner");
    }

    private async Task MarkBootCompleteAsync()
    {
        await Task.Delay(1800);
        _bootComplete = true;
        StateHasChanged();
    }

    // Called from tactical-globe.js's location search instead of a client-side fetch(): the
    // Census geocoder (this feature's fallback for exact US addresses Photon's OSM-based data
    // often misses) isn't CORS-open at all, and Photon's own docs ask for an identifying
    // User-Agent a browser fetch() can never set - see GeocodingService's own comment.
    [JSInvokable]
    public async Task<GeocodeResult?> GeocodeAsync(string query) => await GeocodingService.GeocodeAsync(query);

    // Feature: hover-to-identify. Called from tactical-globe.js's debounced pointer-move handler
    // (only while zoomed in close enough for a hover to mean something) - same reasoning as
    // GeocodeAsync for why this is a [JSInvokable] and not a client-side fetch().
    [JSInvokable]
    public async Task<PlaceInfo?> ReverseGeocodeAsync(double latitude, double longitude) =>
        await GeocodingService.ReverseGeocodeAsync(latitude, longitude);

    // Shared by the bbox pin push, the favorites panel's "GO" action, and shareable view links -
    // one camera-identity/payload shape used everywhere a camera crosses the JS interop boundary.
    private object ToPinPayload(CameraFeed camera) => new
    {
        id = camera.Id,
        name = camera.Name,
        lat = camera.Latitude,
        lon = camera.Longitude,
        streamUrl = camera.StreamUrl,
        streamKind = camera.StreamKind.ToString(),
        sourceName = camera.SourceName,
        sourceAttributionUrl = camera.SourceAttributionUrl,
        isFavorite = _favoriteCameraIds.Contains(camera.Id)
    };

    // Called from the stream panel's favorite-star button (tactical-globe.js threads the current
    // camera payload through). Returns the new favorite state so the star's visual can update
    // without a second round-trip.
    [JSInvokable]
    public async Task<bool> ToggleCameraFavoriteAsync(
        string cameraId, string name, double lat, double lon, string streamUrl, string streamKind,
        string sourceName, string sourceAttributionUrl)
    {
        var wasFavorite = _favoriteCameraIds.Contains(cameraId);
        if (wasFavorite)
        {
            await CameraFavoritesService.RemoveFavoriteAsync(_username, cameraId);
            _favoriteCameraIds.Remove(cameraId);
        }
        else
        {
            var camera = new CameraFeed(cameraId, name, lat, lon, streamUrl,
                Enum.Parse<CameraStreamKind>(streamKind), sourceName, sourceAttributionUrl);
            await CameraFavoritesService.AddFavoriteAsync(_username, camera);
            _favoriteCameraIds.Add(cameraId);
        }
        _favorites = (await CameraFavoritesService.GetFavoritesAsync(_username)).ToList();
        StateHasChanged();
        return !wasFavorite;
    }

    // Called from the stream panel's ANALYZE button. Reconstructs the CameraFeed from the loose
    // positional camera identity threaded through by tactical-globe.js - same shape as
    // ToggleCameraFavoriteAsync, for the same JS-interop-marshals-positionally reason. Returns
    // just the message text (success description or a clear failure reason) so the JS .then()
    // callback stays a single string write into the result div.
    [JSInvokable]
    public async Task<string> AnalyzeCameraAsync(
        string cameraId, string name, double lat, double lon, string streamUrl, string streamKind,
        string sourceName, string sourceAttributionUrl)
    {
        var camera = new CameraFeed(cameraId, name, lat, lon, streamUrl,
            Enum.Parse<CameraStreamKind>(streamKind), sourceName, sourceAttributionUrl);
        var result = await CameraSnapshotAnalysisService.AnalyzeAsync(camera);
        return result.Message;
    }

    private void ToggleFavoritesPanel()
    {
        _favoritesOpen = !_favoritesOpen;
    }

    private async Task GoToFavoriteAsync(CameraFeed favorite)
    {
        await JS.InvokeVoidAsync("tacticalGlobe.flyTo", "tg-viewport", favorite.Latitude, favorite.Longitude, 3000);
        await JS.InvokeVoidAsync("tacticalGlobe.openCamera", ToPinPayload(favorite));
    }

    // Called from tactical-globe.js's SHARE VIEW button (see buildShareLink) with whatever
    // camera(s) are currently open plus the camera's own current position/height - encodes it
    // statelessly (no DB row) and returns an absolute URL back to this same page. The recipient
    // must already be an authenticated admin, since /admin/osint keeps its existing AdminOnly
    // policy regardless of the "v" query parameter.
    [JSInvokable]
    public Task<string> BuildShareLinkAsync(double latitude, double longitude, double heightMeters, List<SharedCameraDto> openCameras)
    {
        var cameras = openCameras
            .Select(c => new CameraFeed(c.Id, c.Name, c.Lat, c.Lon, c.StreamUrl, Enum.Parse<CameraStreamKind>(c.StreamKind), c.SourceName, c.SourceAttributionUrl))
            .ToList();
        var token = SharedGridViewCodec.Encode(new SharedGridView(latitude, longitude, heightMeters, cameras));
        return Task.FromResult(Navigation.ToAbsoluteUri($"/admin/osint?v={Uri.EscapeDataString(token)}").ToString());
    }

    public sealed record SharedCameraDto(string Id, string Name, double Lat, double Lon, string StreamUrl, string StreamKind, string SourceName, string SourceAttributionUrl);

    // Raised by tactical-globe.js's camera.moveEnd handler once the view settles after a
    // drag/zoom (see initGlobe) - degrees, matching Cesium's own Rectangle-to-degrees output.
    [JSInvokable]
    public async Task OnGlobeViewChanged(double north, double south, double east, double west)
    {
        _lastBbox = new BoundingBox(north, south, east, west);
        _hasSettledOnce = true;
        var cameras = await CameraDirectoryService.GetCamerasInBoundingBoxAsync(_lastBbox);
        _visibleCameras = cameras.ToList();
        // Reset the dismiss so a future empty area shows the hint again - this isn't a
        // one-time app-level notice like the provider-setup banner, it's per-location
        // information that should reappear whenever it becomes true again.
        if (_visibleCameras.Count > 0)
        {
            _emptyHintDismissed = false;
        }
        StateHasChanged();

        var pins = cameras.Select(ToPinPayload).ToList();
        await JS.InvokeVoidAsync("tacticalGlobe.setCameraPins", pins);

        // The alert set is independent of any one view, but re-filtering it against the new
        // bbox on every settle keeps what's drawn matching what's actually visible - cheap,
        // since NwsAlertsService caches the underlying nationwide fetch (see its own comment).
        if (_alertsOn)
        {
            await PushAlertsAsync();
        }

        if (_incidentsOn)
        {
            await PushIncidentsAsync();
        }

        // Weather-on-zoom: always kept current for wherever the view is centered, not gated
        // behind a toggle - matches cameras/pins being always-on rather than opt-in. Uses the
        // bbox's own center rather than asking the client for one, since the server already has
        // the settled bbox right here.
        var centerLatitude = (north + south) / 2.0;
        var centerLongitude = (east + west) / 2.0;
        var weather = await NwsForecastService.GetSnapshotAsync(centerLatitude, centerLongitude);
        await JS.InvokeVoidAsync("tacticalGlobe.setWeatherSnapshot", weather is null ? null : new
        {
            currentTemperatureFahrenheit = weather.CurrentTemperatureFahrenheit,
            currentConditions = weather.CurrentConditions,
            forecastTemperatureFahrenheit = weather.ForecastTemperatureFahrenheit,
            shortForecast = weather.ShortForecast,
            detailedForecast = weather.DetailedForecast,
            windSpeed = weather.WindSpeed,
            windDirection = weather.WindDirection,
            chanceOfPrecipitationPercent = weather.ChanceOfPrecipitationPercent
        });
    }

    // Bound to both the RADAR button and tactical-globe.js's "R" keydown shortcut (which
    // synthesizes a click on the same button rather than duplicating this logic in JS).
    private async Task ToggleRadarAsync()
    {
        _radarOn = !_radarOn;
        await JS.InvokeVoidAsync("tacticalGlobe.setRadarVisible", _radarOn);
    }

    private async Task ToggleAlertsAsync()
    {
        _alertsOn = !_alertsOn;
        if (_alertsOn)
        {
            await PushAlertsAsync();
        }
        else
        {
            await JS.InvokeVoidAsync("tacticalGlobe.clearWeatherAlerts");
        }
    }

    private async Task PushAlertsAsync()
    {
        var alerts = await NwsAlertsService.GetActiveAlertsAsync(_lastBbox);
        var payload = alerts.Select(a => new
        {
            id = a.Id,
            eventName = a.Event,
            severity = a.Severity,
            areaDescription = a.AreaDescription,
            rings = a.Rings.Select(ring => ring.Select(v => new[] { v.Longitude, v.Latitude }).ToList()).ToList()
        }).ToList();
        await JS.InvokeVoidAsync("tacticalGlobe.setWeatherAlerts", payload);

        // Weather-camera correlation: badge any currently-visible camera pin that falls inside
        // one of these alert polygons, so the ALERTS and camera layers actually inform each
        // other instead of just being two independent overlays. Worst severity wins when a
        // camera sits under more than one overlapping alert.
        var highlights = _visibleCameras
            .Select(camera => new
            {
                cameraId = camera.Id,
                severity = alerts
                    .Where(a => GeoPolygon.Contains(a.Rings, camera.Latitude, camera.Longitude))
                    .OrderBy(a => AlertSeverityRank(a.Severity))
                    .Select(a => a.Severity)
                    .FirstOrDefault()
            })
            .Where(h => h.severity is not null)
            .ToList();
        await JS.InvokeVoidAsync("tacticalGlobe.setCameraAlertHighlights", highlights);
    }

    private static int AlertSeverityRank(string severity) => severity switch
    {
        "Extreme" => 0,
        "Severe" => 1,
        "Moderate" => 2,
        _ => 3
    };

    private async Task ToggleIncidentsAsync()
    {
        _incidentsOn = !_incidentsOn;
        if (_incidentsOn)
        {
            await PushIncidentsAsync();
        }
        else
        {
            await JS.InvokeVoidAsync("tacticalGlobe.clearTrafficIncidents");
        }
    }

    // Plain client-side UI state (which panel is open) - no JS/server round-trip needed to
    // toggle it, unlike RADAR/ALERTS/INCIDENTS which each drive a Cesium layer.
    private void ToggleCoverageIndex()
    {
        _coverageIndexOpen = !_coverageIndexOpen;
    }

    private async Task FlyToRegionAsync(CameraCoverageRegion region)
    {
        await JS.InvokeVoidAsync("tacticalGlobe.flyTo", "tg-viewport", region.Latitude, region.Longitude, region.FlyToHeightMeters);
    }

    // Selection itself is entirely client-side (each pin already carries its full camera
    // payload) - this just flips the mode flag JS uses to route pin clicks to selection instead
    // of opening a stream panel directly.
    private async Task ToggleSelectModeAsync()
    {
        _selectModeOn = !_selectModeOn;
        await JS.InvokeVoidAsync("tacticalGlobe.setSelectModeEnabled", "tg-viewport", _selectModeOn);
    }

    private async Task PushIncidentsAsync()
    {
        var incidents = await TrafficIncidentDirectoryService.GetIncidentsInBoundingBoxAsync(_lastBbox);
        var payload = incidents.Select(i => new
        {
            id = i.Id,
            roadwayName = i.RoadwayName,
            description = i.Description,
            eventType = i.EventType,
            severity = i.Severity,
            lat = i.Latitude,
            lon = i.Longitude,
            sourceName = i.SourceName,
            sourceAttributionUrl = i.SourceAttributionUrl
        }).ToList();
        await JS.InvokeVoidAsync("tacticalGlobe.setTrafficIncidents", payload);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("tacticalGlobe.dispose", "tg-viewport");
        }
        catch (JSDisconnectedException)
        {
        }
        _dotNetRef?.Dispose();
    }
}
