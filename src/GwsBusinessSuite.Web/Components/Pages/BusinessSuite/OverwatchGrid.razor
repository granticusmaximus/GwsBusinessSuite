@page "/admin/osint"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "AdminOnly")]
@using Microsoft.AspNetCore.Authorization
@using GwsBusinessSuite.Application.CameraIntel
@using GwsBusinessSuite.Application.Geocoding
@using GwsBusinessSuite.Application.TrafficIncidents
@using GwsBusinessSuite.Application.Weather
@inject CameraDirectoryService CameraDirectoryService
@inject CameraHealthService CameraHealthService
@inject CameraTimelapseStore CameraTimelapseStore
@inject SourceStatusTracker SourceStatusTracker
@inject GwsBusinessSuite.Application.Hazards.HazardLayerService HazardLayerService
@inject GwsBusinessSuite.Application.RouteWatch.RouteWatchService RouteWatchService
@inject GwsBusinessSuite.Infrastructure.Services.CameraIncidentReportService CameraIncidentReportService
@inject GwsBusinessSuite.Infrastructure.Services.OverwatchAreaService OverwatchAreaService
@inject GwsBusinessSuite.Infrastructure.Services.OverwatchTripService OverwatchTripService
@inject GwsBusinessSuite.Infrastructure.Services.IncidentCaptureService IncidentCaptureService
@inject GwsBusinessSuite.Infrastructure.Services.CameraSnapshotDownloader CameraSnapshotDownloader
@inject INwsAlertsService NwsAlertsService
@inject INwsForecastService NwsForecastService
@inject IRadarTimelineService RadarTimelineService
@inject GwsBusinessSuite.Application.MessageSigns.MessageSignDirectoryService MessageSignDirectoryService
@inject GwsBusinessSuite.Application.RoadWeather.RoadWeatherDirectoryService RoadWeatherDirectoryService
@inject TrafficIncidentDirectoryService TrafficIncidentDirectoryService
@inject IGeocodingService GeocodingService
@inject StreetLevelImageryService StreetLevelImagery
@inject GwsBusinessSuite.Application.RouteWatch.DeparturePlannerService DeparturePlanner
@inject GwsBusinessSuite.Infrastructure.Services.CameraWatchService CameraWatch
@inject GwsBusinessSuite.Infrastructure.Services.TimeMachineService TimeMachine
@inject GwsBusinessSuite.Infrastructure.Services.OverwatchBriefingService Briefings
@inject GwsBusinessSuite.Infrastructure.Services.WorldNewsMapService WorldNewsMap
@inject GwsBusinessSuite.Infrastructure.Services.WorldNewsContextService NewsContext
@inject GwsBusinessSuite.Infrastructure.Services.MapNoteService MapNotes
@inject GwsBusinessSuite.Application.LiveLayers.AircraftService AircraftService
@inject GwsBusinessSuite.Application.RoadTraffic.HpmsRoadTrafficService RoadTrafficService
@inject GwsBusinessSuite.Application.RoadTraffic.LiveRoadSpeedService LiveRoadSpeedService
@inject GwsBusinessSuite.Application.RoadTraffic.TomTomTrafficService TomTom
@inject GwsBusinessSuite.Application.LiveLayers.AircraftDetailService AircraftDetailService
@inject GwsBusinessSuite.Application.LiveLayers.ShipService ShipService
@inject GwsBusinessSuite.Application.LiveLayers.AirQualityService AirQualityService
@inject GwsBusinessSuite.Application.LiveLayers.PowerOutageService PowerOutageService
@inject ICameraFavoritesService CameraFavoritesService
@inject ICameraSnapshotAnalysisService CameraSnapshotAnalysisService
@inject IBusinessInfoService BusinessInfoService
@inject GwsBusinessSuite.Application.Abstractions.ICurrentUserAccessor CurrentUserAccessor
@inject Microsoft.Extensions.Options.IOptions<CameraIntelOptions> CameraIntelOptions
@inject IJSRuntime JS
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@inject ILogger<OverwatchGrid> Logger
@implements IAsyncDisposable

<PageTitle>Overwatch</PageTitle>



<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cesium@1.145.0/Build/Cesium/Widgets/widgets.css" />
<link rel="stylesheet" href="/tactical-globe.css" />
<script src="https://cdn.jsdelivr.net/npm/cesium@1.145.0/Build/Cesium/Cesium.js"></script>
<script src="@Assets["js/tactical-globe.js"]"></script>
<script src="@Assets["js/street-view.js"]"></script>

<div class="tg-shell">
    <div class="tg-viewport" id="tg-viewport"></div>
    <div class="tg-scanlines"></div>
    <div class="tg-vignette"></div>

    @* Top bar: panel toggle + search on the left, status and the Layers/info/help buttons on the
       right (Google Maps-style). The search ids are wired up by tactical-globe.js. *@
    <div class="tg-topbar">
        <div class="tg-topbar-left">
            <button type="button" class="tg-icon-btn" aria-label="@(_panelTab is null ? "Show the side panel" : "Hide the side panel")"
                    aria-expanded="@(_panelTab is null ? "false" : "true")" title="Side panel" @onclick="ToggleSidePanelAsync">
                <i class="bi bi-layout-sidebar-inset" aria-hidden="true"></i>
            </button>
            <div class="tg-search">
                <input type="text" id="tg-search-input" placeholder="SEARCH A PLACE OR ADDRESS..." autocomplete="off" aria-label="Search a place or address" />
                <button type="button" id="tg-search-button">GO</button>
                <button type="button" class="tg-icon-btn" title="Directions" aria-label="Directions" @onclick='() => SelectPanelTabAsync("directions", keepOpen: true)'>
                    <i class="bi bi-sign-turn-right" aria-hidden="true"></i>
                </button>
            </div>
            <span id="tg-search-status" class="tg-search-status" role="status"></span>
        </div>
        <div class="tg-topbar-right">
            <div class="tg-hud-status">
                CAMERAS IN VIEW: @_camerasInViewTotal
                @if (_camerasInViewTotal > _visibleCameras.Count)
                {
                    <span class="tg-hud-thinned" title="Wide views show an even spread of cameras. Zoom in to see every camera.">(SHOWING @_visibleCameras.Count - ZOOM IN FOR ALL)</span>
                }
            </div>
            <button type="button" class="tg-pill @(_layersOpen ? "is-active" : "")" aria-expanded="@(_layersOpen ? "true" : "false")"
                    aria-controls="tg-layers" @onclick="ToggleLayersPanel">
                <i class="bi bi-layers" aria-hidden="true"></i> LAYERS@(ActiveLayerCount > 0 ? $" ({ActiveLayerCount})" : "")
            </button>
            <button type="button" class="tg-icon-btn @(_infoOpen ? "is-active" : "")" aria-label="Sources and credits" title="Sources and credits"
                    aria-expanded="@(_infoOpen ? "true" : "false")" @onclick="ToggleInfoPanel"><i class="bi bi-info-lg" aria-hidden="true"></i></button>
            <button type="button" class="tg-icon-btn @(_helpOpen ? "is-active" : "")" aria-label="Keyboard shortcuts" title="Keyboard shortcuts"
                    aria-expanded="@(_helpOpen ? "true" : "false")" @onclick="ToggleHelpPanel"><i class="bi bi-question-lg" aria-hidden="true"></i></button>
        </div>
    </div>

    @* Layers: always rendered (hidden when closed) so the keyboard shortcuts, which click these
       buttons by data-tg-toggle, work with the panel closed. *@
    <div class="tg-floating-panel tg-layers-panel @(_layersOpen ? "" : "is-hidden")" id="tg-layers" aria-label="Map layers">
        <div class="tg-coverage-panel-header"><span>LAYERS</span><button type="button" class="tg-panel-close" aria-label="Close layers" @onclick="ToggleLayersPanel">&times;</button></div>
        <div class="tg-layer-group">
            <div class="tg-layer-group-title">WEATHER</div>
            <div class="tg-layer-buttons">
                <button type="button" data-tg-toggle="radar" class="tg-toggle @(_radarOn ? "tg-toggle-on" : "")" title="Radar: past hour and future radar (HRRR model), with play/scrub (R)" @onclick="ToggleRadarAsync">
                    RADAR [@(_radarOn ? "ON" : "OFF")]
                </button>
                <button type="button" data-tg-toggle="alerts" class="tg-toggle @(_alertsOn ? "tg-toggle-on" : "")" title="Toggle NWS severe weather alerts (A)" @onclick="ToggleAlertsAsync">
                    ALERTS [@(_alertsOn ? "ON" : "OFF")]
                </button>
                @if (IonToken is not null)
                {
                    <button type="button" data-tg-toggle="threed" class="tg-toggle @(_threeDOn ? "tg-toggle-on" : "")"
                            title="3D buildings and terrain (Cesium ion)" @onclick="ToggleThreeDAsync">
                        3D CITIES [@(_threeDOn ? "ON" : "OFF")]
                    </button>
                    @if (_threeDError is not null)
                    {
                        <div class="tg-favorites-empty" role="status">@_threeDError</div>
                    }
                }
                <button type="button" data-tg-toggle="roadtemps" class="tg-toggle @(_roadWeatherOn ? "tg-toggle-on" : "")"
                        title="Road surface temperature and ice risk from roadside weather stations (Montana, South Dakota)" @onclick="ToggleRoadWeatherAsync">
                    ROAD TEMPS [@(_roadWeatherOn ? "ON" : "OFF")]
                </button>
            </div>
        </div>
        <div class="tg-layer-group">
            <div class="tg-layer-group-title">TRAFFIC</div>
            <div class="tg-layer-buttons">
                <button type="button" data-tg-toggle="incidents" class="tg-toggle @(_incidentsOn ? "tg-toggle-on" : "")" title="Toggle traffic accidents/roadwork/closures (I)" @onclick="ToggleIncidentsAsync">
                    INCIDENTS [@(_incidentsOn ? "ON" : "OFF")]
                </button>
                <button type="button" data-tg-toggle="signs" class="tg-toggle @(_signsOn ? "tg-toggle-on" : "")"
                        title="What highway message signs say right now (Caltrans, Montana)" @onclick="ToggleSignsAsync">
                    SIGNS [@(_signsOn ? "ON" : "OFF")]
                </button>
                <button type="button" data-tg-toggle="city-traffic" class="tg-toggle @(_cityTrafficOn ? "tg-toggle-on" : "")"
                        title="When zoomed in to a city: how many vehicles use each road (every US state) and live speeds where the city publishes them"
                        @onclick="ToggleCityTrafficAsync">
                    CITY TRAFFIC [@(_cityTrafficOn ? "ON" : "OFF")]
                </button>
                @if (TomTom.IsConfigured)
                {
                    <button type="button" data-tg-toggle="live-flow" class="tg-toggle @(_liveFlowOn ? "tg-toggle-on" : "")"
                            title="Live congestion on every road TomTom covers, worldwide: green flowing freely, through orange, to red slow"
                            @onclick="ToggleLiveFlowAsync">
                        LIVE FLOW [@(_liveFlowOn ? "ON" : "OFF")]
                    </button>
                }
            </div>
            @if (_cityTrafficOn && CityTrafficStatus is { } cityTrafficStatus)
            {
                <div class="tg-hazard-summary">@cityTrafficStatus</div>
            }
            @if (_incidentsOn && _lastIncidents.Count > 0)
            {
                <div class="tg-hud-toggles tg-incident-filters" role="group" aria-label="Filter incidents by type">
                    @foreach (var category in IncidentCategories.All)
                    {
                        var count = _lastIncidents.Count(i => i.Category == category);
                        if (count == 0) continue;
                        var shown = !_hiddenIncidentCategories.Contains(category);
                        <button type="button" class="tg-toggle @(shown ? "tg-toggle-on" : "")" aria-pressed="@(shown ? "true" : "false")"
                                title="@(shown ? "Hide" : "Show") @IncidentCategories.Label(category).ToLowerInvariant()"
                                @onclick="() => ToggleIncidentCategoryAsync(category)">
                            @IncidentCategories.Label(category).ToUpperInvariant() @count
                        </button>
                    }
                </div>
            }
        </div>
        <div class="tg-layer-group">
            <div class="tg-layer-group-title">INTELLIGENCE</div>
            <div class="tg-layer-buttons">
                <button type="button" data-tg-toggle="world-news" class="tg-toggle @(_worldNewsOn ? "tg-toggle-on" : "")"
                        title="Reported World News situations, placed at the country or city their headlines name; not confirmed incidents"
                        @onclick="ToggleWorldNewsAsync">
                    WORLD NEWS [@(_worldNewsOn ? "ON" : "OFF")]
                </button>
            </div>
            @if (_worldNewsOn)
            {
                <div class="tg-hazard-summary">@_worldNewsCount reported situation@(_worldNewsCount == 1 ? "" : "s") in view · placed from what the headlines name</div>
                <div class="tg-layer-buttons" role="group" aria-label="Kinds of news to show">
                    @foreach (var kind in GwsBusinessSuite.WorldNewsKit.SituationKinds.All)
                    {
                        var shown = _worldNewsKinds.Contains(kind);
                        <button type="button" class="tg-toggle @(shown ? "tg-toggle-on" : "")" aria-pressed="@(shown ? "true" : "false")"
                                data-tg-news-kind="@kind" @onclick="() => ToggleWorldNewsKindAsync(kind)">
                            @GwsBusinessSuite.WorldNewsKit.SituationKinds.Label(kind).ToUpperInvariant()
                        </button>
                    }
                </div>
                <div class="tg-layer-buttons">
                    <button type="button" class="tg-toggle @(_worldNewsShading ? "tg-toggle-on" : "")" aria-pressed="@(_worldNewsShading ? "true" : "false")"
                            title="Shade each country by how many outlets cover the stories placed there; click a country for its stories"
                            @onclick="ToggleWorldNewsShadingAsync">
                        SHADE COUNTRIES [@(_worldNewsShading ? "ON" : "OFF")]
                    </button>
                </div>
                @if (_worldNewsShading)
                {
                    <div class="tg-hazard-summary">Lighter to darker purple: fewer to more outlets on the stories placed in a country</div>
                }
                <div class="tg-layer-buttons" role="group" aria-label="How far back to look">
                    @foreach (var hours in GwsBusinessSuite.Infrastructure.Services.WorldNewsMapService.WindowHours)
                    {
                        <button type="button" class="tg-toggle @(_worldNewsHours == hours ? "tg-toggle-on" : "")"
                                aria-pressed="@(_worldNewsHours == hours ? "true" : "false")" @onclick="() => SetWorldNewsWindowAsync(hours)">
                            @(hours == 24 ? "LAST 24 HOURS" : $"LAST {hours / 24} DAYS")
                        </button>
                    }
                </div>
            }
        </div>
        <div class="tg-layer-group">
            <div class="tg-layer-group-title">HAZARDS</div>
            <div class="tg-layer-buttons">
                <button type="button" data-tg-toggle="hazards" class="tg-toggle @(_hazardsOn ? "tg-toggle-on" : "")"
                        title="Earthquakes (USGS), active wildfires (NIFC) and flooding river gauges (NOAA)" @onclick="ToggleHazardsAsync">
                    HAZARDS [@(_hazardsOn ? "ON" : "OFF")]
                </button>
                <button type="button" data-tg-toggle="outages" class="tg-toggle @(_outagesOn ? "tg-toggle-on" : "")"
                        title="Power outages by county from utilities that report to the U.S. DOE's ODIN (60+ utilities in 26 states)" @onclick="ToggleOutagesAsync">
                    POWER OUTAGES [@(_outagesOn ? "ON" : "OFF")]
                </button>
            </div>
            @if (_hazardsOn && !string.IsNullOrWhiteSpace(_hazardSummary))
            {
                <div class="tg-hazard-summary">@_hazardSummary</div>
            }
            @if (_outagesOn && !string.IsNullOrWhiteSpace(_outageSummary))
            {
                <div class="tg-hazard-summary">@_outageSummary</div>
            }
        </div>
        <div class="tg-layer-group">
            <div class="tg-layer-group-title">AIR</div>
            <div class="tg-layer-buttons">
                <button type="button" data-tg-toggle="aircraft" class="tg-toggle @(_aircraftOn ? "tg-toggle-on" : "")"
                        title="Aircraft in flight (OpenSky Network), refreshed every minute" @onclick="ToggleAircraftAsync">
                    AIRCRAFT [@(_aircraftOn ? "ON" : "OFF")]
                </button>
                <button type="button" data-tg-toggle="airquality" class="tg-toggle @(_airQualityOn ? "tg-toggle-on" : "")"
                        title="Air quality index across the view (Open-Meteo, hourly model)" @onclick="ToggleAirQualityAsync">
                    AIR QUALITY [@(_airQualityOn ? "ON" : "OFF")]
                </button>
            </div>
            @if ((_aircraftOn || _airQualityOn) && !string.IsNullOrWhiteSpace(_airSummary))
            {
                <div class="tg-hazard-summary">@_airSummary</div>
            }
        </div>
        <div class="tg-layer-group">
            <div class="tg-layer-group-title">SEA</div>
            <div class="tg-layer-buttons">
                <button type="button" data-tg-toggle="ships" class="tg-toggle @(_shipsOn ? "tg-toggle-on" : "")"
                        title="Ships broadcasting AIS (aisstream.io), refreshed every 30 seconds" @onclick="ToggleShipsAsync">
                    SHIPS [@(_shipsOn ? "ON" : "OFF")]
                </button>
            </div>
            @if (_shipsOn && !string.IsNullOrWhiteSpace(_shipSummary))
            {
                <div class="tg-hazard-summary">@_shipSummary</div>
            }
        </div>
        <div class="tg-layer-group">
            <div class="tg-layer-group-title">CAMERAS</div>
            <div class="tg-layer-buttons">
                <button type="button" data-tg-toggle="healthy" class="tg-toggle @(_hideUnhealthy ? "tg-toggle-on" : "")"
                        title="Hide cameras found frozen, stale or offline (checked when opened, and every 10 minutes for favorites)" @onclick="ToggleHideUnhealthyAsync">
                    HEALTHY ONLY [@(_hideUnhealthy ? "ON" : "OFF")]
                </button>
                <button type="button" data-tg-toggle="select" class="tg-toggle @(_selectModeOn ? "tg-toggle-on" : "")" title="Select multiple cameras for the watch wall (S)" @onclick="ToggleSelectModeAsync">
                    SELECT [@(_selectModeOn ? "ON" : "OFF")]
                </button>
            </div>
        </div>
    </div>

    @if (_infoOpen)
    {
        <div class="tg-floating-panel tg-info-panel" aria-label="Sources and credits">
            <div class="tg-coverage-panel-header"><span>SOURCES</span><button type="button" class="tg-panel-close" aria-label="Close sources" @onclick="ToggleInfoPanel">&times;</button></div>
            <p class="tg-info-text">Basemap: Esri, Maxar, Earthstar Geographics &middot; 25+ US state DOTs &middot; DriveBC &middot; Madrid Traffic &middot; Fintraffic &middot; NZTA &middot; QLD Traffic &middot; Windy &middot; Datumfeed &middot; Mapillary &middot; KartaView &middot; Overpass/OSM &middot; Wikimedia Commons &middot; NOAA/NWS &middot; World News: Google News country editions and outlet feeds, places from GeoNames (CC BY 4.0) and Natural Earth &middot; Search: Photon/OSM, US Census Bureau &middot; full source list: COVERAGE panel / user guide</p>
            <p class="tg-info-text">ADMIN // AUTHORIZED ACCESS ONLY. Public sources only - never unsecured private cameras.</p>
        </div>
    }
    @if (_helpOpen)
    {
        <div class="tg-floating-panel tg-info-panel" aria-label="Keyboard shortcuts">
            <div class="tg-coverage-panel-header"><span>SHORTCUTS</span><button type="button" class="tg-panel-close" aria-label="Close shortcuts" @onclick="ToggleHelpPanel">&times;</button></div>
            <dl class="tg-shortcuts">
                <dt>R</dt><dd>Radar</dd><dt>A</dt><dd>Weather alerts</dd><dt>I</dt><dd>Traffic incidents</dd>
                <dt>C</dt><dd>Coverage (Explore)</dd><dt>F</dt><dd>Favorites (Saved)</dd><dt>S</dt><dd>Select cameras for the watch wall</dd>
                <dt>Esc</dt><dd>Close a camera feed</dd>
            </dl>
        </div>
    }

    @if (_streetPicking)
    {
        <div class="tg-pick-banner" role="status">CLICK THE MAP WHERE YOU WANT TO LOOK AROUND <button type="button" @onclick="ToggleStreetViewPickAsync">CANCEL</button></div>
    }
    @* Drive mode (DriveGuide): follows the planned route with this device's GPS. *@
    @if (_drive is not null)
    {
        <div class="tg-drive" role="region" aria-label="Drive mode">
            <div class="tg-drive-next" role="status" aria-live="polite">
                @if (_driveState is not { } drive)
                {
                    <span>WAITING FOR GPS...</span>
                }
                else if (drive.Arrived)
                {
                    <span>ARRIVED: @(_route?.To.ToUpperInvariant())</span>
                }
                else if (drive.OffRoute)
                {
                    <span>OFF ROUTE · @drive.MilesOff.ToString("0.0") MI FROM IT</span>
                    <button type="button" disabled="@_driveBusy" @onclick="ReplanFromHereAsync">REPLAN FROM HERE</button>
                }
                else if (drive.NextStep is { } next)
                {
                    <strong>@DriveDistance(drive.MilesToNextStep)</strong>
                    <span>@next.Instruction</span>
                }
                else
                {
                    <strong>@DriveDistance(drive.MilesRemaining)</strong>
                    <span>TO @(_route?.To.ToUpperInvariant())</span>
                }
            </div>
            @if (_driveState is { Arrived: false } progress)
            {
                <div class="tg-drive-meta">
                    @progress.MilesRemaining.ToString("0.0") MI LEFT · ARRIVE @DateTimeOffset.Now.AddMinutes(progress.MinutesRemaining).ToGwsTime()
                    @if (_driveSpeedMph is { } mph)
                    {
                        <text> · @mph.ToString("0") MPH</text>
                    }
                </div>
                @foreach (var closure in _driveClosures.Where(c => c.MilesAlong > progress.MilesAlong))
                {
                    <div class="tg-drive-warning">
                        <span>NEW CLOSURE @((closure.MilesAlong - progress.MilesAlong).ToString("0.0")) MI AHEAD: @closure.Incident.RoadwayName</span>
                        <button type="button" disabled="@_driveBusy" @onclick="() => RerouteAroundAsync(closure)">@(_driveBusy ? "ROUTING..." : "REROUTE")</button>
                    </div>
                }
                @foreach (var incident in progress.IncidentsAhead.Where(i => !_driveClosures.Contains(i)).Take(2))
                {
                    <div class="tg-drive-ahead">@GwsBusinessSuite.Application.TrafficIncidents.IncidentCategories.SingularLabel(incident.Incident.Category).ToUpperInvariant() IN @((incident.MilesAlong - progress.MilesAlong).ToString("0.0")) MI · @incident.Incident.RoadwayName</div>
                }
                @if (progress.CamerasAhead.Count > 0)
                {
                    <div class="tg-drive-cameras">
                        @foreach (var camera in progress.CamerasAhead)
                        {
                            <figure>
                                <img src="@DriveCameraUrl(camera.Camera)" alt="@($"Camera ahead: {camera.Camera.Name}")" />
                                <figcaption>@((camera.MilesAlong - progress.MilesAlong).ToString("0.0")) MI · @camera.Camera.Name</figcaption>
                            </figure>
                        }
                    </div>
                }
            }
            @if (!string.IsNullOrEmpty(_driveMessage))
            {
                <div class="tg-drive-ahead" role="status">@_driveMessage</div>
            }
            <div class="tg-drive-actions">
                <button type="button" aria-pressed="@(_driveVoice ? "true" : "false")" @onclick="() => _driveVoice = !_driveVoice">@(_driveVoice ? "VOICE ON" : "VOICE OFF")</button>
                <button type="button" @onclick="RecenterDriveAsync">RE-CENTRE</button>
                <button type="button" @onclick="EndDriveAsync">END DRIVE</button>
            </div>
        </div>
    }
    @if (_timeMachineOn)
    {
        <div class="tg-time-machine" role="region" aria-label="Time machine">
            <div class="tg-tm-row">
                <button type="button" class="tg-pill" aria-label="@(_tmPlaying ? "Pause" : "Play forward to now")" @onclick="ToggleTimeMachinePlayAsync">
                    <i class="bi @(_tmPlaying ? "bi-pause-fill" : "bi-play-fill")" aria-hidden="true"></i>
                </button>
                <input type="range" class="tg-tm-slider" min="0" max="@TimeMachineSteps" step="1" value="@(TimeMachineSteps - _tmMinutesAgo / 10)"
                       aria-label="Time in the past 24 hours" @oninput="OnTimeMachineSliding" @onchange="OnTimeMachineChangedAsync" />
                <button type="button" class="tg-pill" @onclick="ToggleTimeMachineAsync">LIVE</button>
            </div>
            <div class="tg-tm-label" role="status">
                <strong>@TimeMachineAt.ToLocalGwsDateTime()</strong>
                <span>@(_tmMinutesAgo == 0 ? "now" : $"{_tmMinutesAgo / 60} h {_tmMinutesAgo % 60:00} min ago")</span>
                @if (_timeMachine is { } tm)
                {
                    <span>· RADAR · @tm.Incidents.Count INCIDENTS · @tm.Earthquakes.Count QUAKES · @tm.Cameras.Count CAMERAS</span>
                    @if (tm.IncidentHistoryStartsAt is { } since && since > TimeMachineAt)
                    {
                        <span class="tg-tm-note">Incident history starts @since.ToLocalGwsDateTime()</span>
                    }
                }
                @if (_tmBusy)
                {
                    <span>· LOADING...</span>
                }
            </div>
        </div>
        @if (_timeMachine is { Cameras.Count: > 0 } withCameras)
        {
            <div class="tg-floating-panel tg-tm-cameras" aria-label="Cameras at this time">
                <div class="tg-coverage-panel-header"><span>CAMERAS AT @TimeMachineAt.ToLocalGwsTime()</span></div>
                <div class="tg-tm-camera-grid">
                    @foreach (var camera in withCameras.Cameras)
                    {
                        <figure>
                            <img src="@camera.FrameUrl" alt="@($"{camera.Name} at {camera.CapturedAt.ToLocalGwsTime()}")" loading="lazy" />
                            <figcaption>@camera.Name · @camera.CapturedAt.ToLocalGwsTime()</figcaption>
                        </figure>
                    }
                </div>
            </div>
        }
    }

    @if (_detection is { } detection)
    {
        <div class="tg-floating-panel tg-streetview-panel" aria-label="Camera watch detection">
            <div class="tg-coverage-panel-header"><span>@detection.Title.ToUpperInvariant()</span><button type="button" class="tg-panel-close" aria-label="Close" @onclick="() => _detection = null">&times;</button></div>
            <div class="tg-favorites-empty">@detection.Message · @detection.CreatedAt.ToLocalGwsDateTime()</div>
            <div class="tg-detection-frames">
                <figure><img src="@($"/admin/api/overwatch/detections/{detection.Id}/before")" alt="The camera before the change" /><figcaption>BEFORE</figcaption></figure>
                <figure><img src="@($"/admin/api/overwatch/detections/{detection.Id}/after")" alt="The camera when it turned bad" /><figcaption>AFTER</figcaption></figure>
            </div>
            @if (_detectionCamera is { } watched)
            {
                <div class="tg-route-row tg-streetview-nav">
                    <button type="button" @onclick="() => FlyToPointAsync(watched.Latitude, watched.Longitude)">GO TO CAMERA</button>
                </div>
            }
        </div>
    }

    @* Briefing: "Brief me" (facts from the server, written by the local model on this computer),
       or a morning briefing opened from the bell. *@
    @if (_briefFacts is not null || _morningBrief is not null)
    {
        <div class="tg-floating-panel tg-streetview-panel tg-briefing-panel" aria-label="Briefing">
            <div class="tg-coverage-panel-header">
                <span>@(_morningBrief is { } morningTitle ? morningTitle.Title.ToUpperInvariant() : $"BRIEFING: {_briefFacts!.Scope.ToUpperInvariant()}")</span>
                <button type="button" class="tg-panel-close" aria-label="Close" @onclick="CloseBriefing">&times;</button>
            </div>
            @if (_morningBrief is { } morning)
            {
                <div class="tg-briefing-text">@morning.Message</div>
                <div class="tg-favorites-empty">Sent @morning.CreatedAt.ToLocalGwsDateTime(). Press the briefing button on the map for an AI-written briefing of any view.</div>
            }
            else if (_briefFacts is { } facts)
            {
                <div class="tg-favorites-empty">As of @facts.At.ToLocalGwsDateTime() · written by the model on this computer from the numbered sources below</div>
                @if (_briefModels.Count > 0)
                {
                    <div class="tg-route-row">
                        <select aria-label="Local model" value="@_briefModel" @onchange="e => _briefModel = e.Value?.ToString() ?? string.Empty" disabled="@_briefBusy">
                            @foreach (var model in _briefModels)
                            {
                                <option value="@model">@model</option>
                            }
                        </select>
                        <button type="button" disabled="@_briefBusy" @onclick="WriteBriefingAsync">@(_briefBusy ? "WRITING..." : "REWRITE")</button>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_briefError))
                {
                    <div class="tg-favorites-empty" role="status">@_briefError</div>
                }
                @if (!_briefFailed)
                {
                    <div class="tg-briefing-text" role="status" aria-live="polite">@(_briefText?.Text ?? (_briefBusy ? _briefDraft + " ..." : GwsBusinessSuite.Application.Briefings.OverwatchBriefing.PlainText(facts)))</div>
                }
                @if (facts.Facts.Count > 0)
                {
                    <ol class="tg-coverage-list tg-briefing-sources">
                        @foreach (var fact in facts.Facts)
                        {
                            <li class="tg-coverage-item @(_briefText?.Cited.Contains(fact.Number) == true ? "is-cited" : "")">
                                <span>[@fact.Number] @fact.Text</span>
                                @if (fact.Latitude is { } factLat && fact.Longitude is { } factLon)
                                {
                                    <button type="button" @onclick="() => FlyToPointAsync(factLat, factLon)">GO</button>
                                }
                            </li>
                        }
                    </ol>
                }
            }
        </div>
    }

    @if (_openNote is { } openNote)
    {
        <div class="tg-floating-panel tg-streetview-panel" aria-label="Map note">
            <div class="tg-coverage-panel-header">
                <span><i class="tg-note-dot" style="background:@openNote.Color" aria-hidden="true"></i>@openNote.Title.ToUpperInvariant()</span>
                <button type="button" class="tg-panel-close" aria-label="Close" @onclick="() => _openNote = null">&times;</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(openNote.Body))
            {
                <div class="tg-briefing-text">@openNote.Body</div>
            }
            <div class="tg-favorites-empty">
                @(openNote.Kind == GwsBusinessSuite.Infrastructure.Services.MapNoteKinds.Area ? "Area" : "Pin") · updated @openNote.UpdatedAt.ToLocalGwsDateTime()@(openNote.Owner != _username ? $" · shared by {openNote.Owner}" : "")
            </div>
            <div class="tg-route-row tg-streetview-nav">
                <button type="button" @onclick="() => FlyToNoteAsync(openNote)">GO</button>
                @if (openNote.Owner == _username)
                {
                    <button type="button" @onclick="() => EditNoteAsync(openNote)">EDIT</button>
                    <button type="button" title="Copy a link other signed-in admins can open" @onclick="() => ShareNoteAsync(openNote)">@(openNote.IsShared ? "COPY LINK" : "SHARE")</button>
                    @if (openNote.IsShared)
                    {
                        <button type="button" title="Stop the link working" @onclick="() => UnshareNoteAsync(openNote)">UNSHARE</button>
                    }
                }
            </div>
            @if (!string.IsNullOrEmpty(_noteMessage))
            {
                <div class="tg-favorites-empty" role="status">@_noteMessage</div>
            }
        </div>
    }

    @* Overwatch's own street view (street-view.js renders the panorama into the canvas and places
       the walk arrows). Covers the globe while open; BACK TO MAP or Esc returns. *@
    @if (_streetScene is { } scene)
    {
        <div class="tg-sv" id="tg-sv" role="dialog" aria-label="Street view">
            <canvas class="tg-sv-canvas" tabindex="0" aria-label="360 degree street view. Drag or use the arrow keys to look around; scroll to zoom."></canvas>
            <div class="tg-sv-arrows" aria-label="Walk"></div>
            <div class="tg-sv-hud">
                <button type="button" class="tg-pill" @onclick="CloseStreetViewAsync"><i class="bi bi-arrow-left" aria-hidden="true"></i> BACK TO MAP</button>
                <div class="tg-sv-info">
                    <span>@scene.Current.Latitude.ToString("0.#####", System.Globalization.CultureInfo.InvariantCulture), @scene.Current.Longitude.ToString("0.#####", System.Globalization.CultureInfo.InvariantCulture)</span>
                    @if (scene.Current.CapturedAt is { } captured)
                    {
                        <span>CAPTURED @captured.ToLocalGwsDate()</span>
                    }
                    <span>@(scene.Links.Count == 0 ? "NO NEIGHBOURING PANORAMAS" : $"{scene.Links.Count} WAY{(scene.Links.Count == 1 ? "" : "S")} TO WALK")</span>
                </div>
            </div>
            <div class="tg-sv-compass" aria-hidden="true"><div class="tg-sv-compass-needle"><span>N</span></div></div>
            <div class="tg-sv-status" role="status" hidden></div>
            <a class="tg-sv-credit" href="@($"https://www.mapillary.com/app/?pKey={scene.Current.Id}")" target="_blank" rel="noopener noreferrer">Imagery &copy; Mapillary contributors, CC BY-SA</a>
        </div>
    }
    else if (_streetView is not null || _streetBusy)
    {
        <div class="tg-floating-panel tg-streetview-panel" aria-label="Street photos">
            <div class="tg-coverage-panel-header"><span>STREET VIEW</span><button type="button" class="tg-panel-close" aria-label="Close street view" @onclick="CloseStreetViewAsync">&times;</button></div>
            @if (_streetBusy)
            {
                <div class="tg-favorites-empty" role="status">LOOKING FOR STREET VIEW HERE...</div>
            }
            else if (_streetView is { } view)
            {
                <div class="tg-streetview-where">@view.Latitude.ToString("0.#####", System.Globalization.CultureInfo.InvariantCulture), @view.Longitude.ToString("0.#####", System.Globalization.CultureInfo.InvariantCulture)</div>
                @if (!StreetLevelImagery.HasPanoramaSource)
                {
                    <div class="tg-favorites-empty">360° street view needs the Mapillary access token (CameraIntel:MapillaryAccessToken).</div>
                }
                else
                {
                    <div class="tg-favorites-empty">No 360° street view within 250 m of this spot.@(view.Images.Count > 0 ? " The nearest street photos:" : " There are no street photos here either - try a busier street.")</div>
                }
                @if (view.Images.Count > 0)
                {
                    var image = view.Images[_streetIndex];
                    <figure class="tg-streetview-figure">
                        <img src="@image.ImageUrl" alt="@($"Street photo {_streetIndex + 1} of {view.Images.Count} from {image.Source}")" loading="lazy" />
                        <figcaption>
                            @image.Source
                            @if (image.CapturedAt is { } captured)
                            {
                                <text> · @captured.ToLocalGwsDate()</text>
                            }
                            @if (StreetLevelImageryService.Facing(image.CompassAngle) is { } facing)
                            {
                                <text> · facing @facing</text>
                            }
                            <text> · @image.DistanceMeters.ToString("0") m away</text>
                        </figcaption>
                    </figure>
                    <div class="tg-route-row tg-streetview-nav">
                        <button type="button" aria-label="Previous photo" disabled="@(_streetIndex == 0)" @onclick="() => _streetIndex--">&lt; PREV</button>
                        <span>@(_streetIndex + 1) / @view.Images.Count</span>
                        <button type="button" aria-label="Next photo" disabled="@(_streetIndex >= view.Images.Count - 1)" @onclick="() => _streetIndex++">NEXT &gt;</button>
                        <a class="tg-link-btn" href="@image.ViewUrl" target="_blank" rel="noopener noreferrer">OPEN ON @image.Source.ToUpperInvariant()</a>
                    </div>
                }
            }
        </div>
    }

    @* Side panel: one tabbed panel instead of separate floating panels. On narrow screens it
       becomes a bottom sheet (see OverwatchGrid.razor.css). *@
    <aside class="tg-side-panel @(_panelTab is null ? "is-collapsed" : "")" aria-label="Overwatch panel">
        <div class="tg-tabs" role="tablist">
            <button type="button" role="tab" data-tg-toggle="coverage" class="tg-tab @(_panelTab == "explore" ? "is-active" : "")"
                    aria-selected="@(_panelTab == "explore" ? "true" : "false")" title="Known camera coverage and where to go (C)" @onclick='() => SelectPanelTabAsync("explore")'>EXPLORE</button>
            <button type="button" role="tab" data-tg-toggle="route" class="tg-tab @(_panelTab == "directions" ? "is-active" : "")"
                    aria-selected="@(_panelTab == "directions" ? "true" : "false")" title="Plan a drive: directions, cameras, incidents and weather along the way" @onclick='() => SelectPanelTabAsync("directions")'>DIRECTIONS</button>
            <button type="button" role="tab" data-tg-toggle="favorites" class="tg-tab @(_panelTab == "saved" ? "is-active" : "")"
                    aria-selected="@(_panelTab == "saved" ? "true" : "false")" title="Favorite cameras and saved trips (F)" @onclick='() => SelectPanelTabAsync("saved")'>SAVED</button>
            <button type="button" role="tab" data-tg-toggle="areas" class="tg-tab @(_panelTab == "areas" ? "is-active" : "")"
                    aria-selected="@(_panelTab == "areas" ? "true" : "false")" title="Watched areas and incident captures" @onclick='() => SelectPanelTabAsync("areas")'>AREAS</button>
        </div>
        <div class="tg-tab-body" role="tabpanel">
            @switch (_panelTab)
            {
                case "explore":
                    @if (_cityTrafficOn)
                    {
                        <div class="tg-coverage-panel-header"><span>TRAFFIC IN VIEW</span></div>
                        <div class="tg-traffic">
                            @if (CityTrafficStatus is { } trafficStatus)
                            {
                                <p class="tg-traffic-note" role="status">@trafficStatus</p>
                            }
                            @if (_roadSummary is { Sections: > 0 } roadSummary)
                            {
                                <dl class="tg-incident-facts tg-traffic-facts">
                                    <dt>VEHICLE-MILES</dt><dd>@BigNumber(roadSummary.VehicleMilesPerDay) A DAY</dd>
                                    <dt>COUNTED ROADS</dt><dd>@roadSummary.MilesInView.ToString("N0") MI (@roadSummary.Sections.ToString("N0") SECTIONS)</dd>
                                    @if (roadSummary.TruckPercent is { } truckPercent)
                                    {
                                        <dt>TRUCKS</dt><dd>@truckPercent.ToString("0.#")% OF VEHICLE-MILES</dd>
                                    }
                                    <dt>SHOWING</dt><dd>@(_cityTrafficCoverage?.ToUpperInvariant())</dd>
                                </dl>
                                <div class="tg-traffic-subhead">
                                    BUSIEST ROADS
                                    @if (TomTom.IsConfigured)
                                    {
                                        <button type="button" class="tg-traffic-live-check" disabled="@_checkingBusiestLive" @onclick="CheckBusiestLiveAsync"
                                                title="Ask TomTom for the speed on each of these roads right now">
                                            @(_checkingBusiestLive ? "CHECKING…" : "LIVE SPEEDS")
                                        </button>
                                    }
                                </div>
                                <ul class="tg-coverage-list">
                                    @foreach (var road in roadSummary.Busiest)
                                    {
                                        <li class="tg-coverage-item">
                                            <span>
                                                <i class="tg-traffic-swatch tg-vol-@VolumeBand(road.VehiclesPerDay)" aria-hidden="true"></i>@road.Label@(road.Name is { } roadName ? $" · {roadName}" : "")
                                                <small class="tg-coverage-status">
                                                    @road.VehiclesPerDay.ToString("N0") A DAY@(road.TruckPercent is { } t ? $" · {t:0.#}% TRUCKS" : "")@(road.Lanes is { } lanes ? $" · {lanes} LANES" : "")
                                                </small>
                                                @if (_busiestLive.TryGetValue(road.Label, out var live))
                                                {
                                                    <small class="tg-coverage-status tg-traffic-live">
                                                        @if (live is null)
                                                        {
                                                            @:NO LIVE READING
                                                        }
                                                        else if (live.Closed)
                                                        {
                                                            <i class="tg-traffic-swatch tg-spd-0" aria-hidden="true"></i>@:CLOSED NOW
                                                        }
                                                        else
                                                        {
                                                            <i class="tg-traffic-swatch tg-spd-@SpeedBand(live.CurrentMph)" aria-hidden="true"></i>@($"NOW {live.CurrentMph:0} MPH · USUALLY {live.FreeFlowMph:0} ({live.PercentOfFreeFlow}%)")
                                                        }
                                                    </small>
                                                }
                                            </span>
                                            <button type="button" title="Fly to @road.Label" @onclick="() => FlyToRoadAsync(road)">GO</button>
                                        </li>
                                    }
                                </ul>
                            }
                            @if (_speedSummary is { } speedSummary)
                            {
                                <div class="tg-traffic-subhead">LIVE SPEEDS · @string.Join(", ", _speedSources)</div>
                                <dl class="tg-incident-facts tg-traffic-facts">
                                    <dt>LINKS</dt><dd>@speedSummary.Links REPORTING, TYPICAL @speedSummary.MedianMph.ToString("0") MPH</dd>
                                    <dt>SLOW</dt><dd>@speedSummary.SlowLinks UNDER @GwsBusinessSuite.Application.RoadTraffic.LiveSpeedSummary.SlowMph.ToString("0") MPH</dd>
                                    @if (speedSummary.Newest is { } newest)
                                    {
                                        <dt>AS OF</dt><dd>@newest.ToLocalGwsDate() @newest.ToLocalGwsTime()</dd>
                                    }
                                </dl>
                                <ul class="tg-coverage-list">
                                    @foreach (var link in speedSummary.Slowest)
                                    {
                                        <li class="tg-coverage-item">
                                            <span>
                                                <i class="tg-traffic-swatch tg-spd-@SpeedBand(link.SpeedMph)" aria-hidden="true"></i>@link.Name
                                                <small class="tg-coverage-status">@link.SpeedMph.ToString("0") MPH@(string.IsNullOrEmpty(link.Area) ? "" : $" · {link.Area.ToUpperInvariant()}")</small>
                                            </span>
                                        </li>
                                    }
                                </ul>
                            }
                            <div class="tg-traffic-subhead">LIVE NOW</div>
                            <dl class="tg-incident-facts tg-traffic-facts">
                                <dt>INCIDENTS</dt>
                                <dd>@(_trafficIncidents.Count == 0 ? "NONE LISTED" : string.Join(" · ", _trafficIncidents.Select(i => $"{i.Count} {i.Label.ToUpperInvariant()}")))</dd>
                                <dt>CAMERAS</dt><dd>@_camerasInViewTotal.ToString("N0") IN VIEW</dd>
                            </dl>
                            <div class="tg-traffic-legend" aria-label="Map key">
                                <span class="tg-traffic-legend-title">VEHICLES A DAY</span>
                                @for (var band = 0; band < VolumeBandLabels.Length; band++)
                                {
                                    <span><i class="tg-traffic-swatch tg-vol-@band" aria-hidden="true"></i>@VolumeBandLabels[band]</span>
                                }
                                @if (_liveFlowOn)
                                {
                                    <span class="tg-traffic-legend-title">LIVE FLOW (TOMTOM, VS. EACH ROAD'S USUAL SPEED)</span>
                                    <span><i class="tg-traffic-swatch tg-flow-free" aria-hidden="true"></i>FREE</span>
                                    <span><i class="tg-traffic-swatch tg-flow-slow" aria-hidden="true"></i>SLOWER</span>
                                    <span><i class="tg-traffic-swatch tg-flow-jam" aria-hidden="true"></i>SLOW</span>
                                    <span><i class="tg-traffic-swatch tg-flow-stop" aria-hidden="true"></i>STOPPED</span>
                                }
                                @if (_speedSummary is not null)
                                {
                                    <span class="tg-traffic-legend-title">LIVE MPH</span>
                                    @for (var band = 0; band < SpeedBandLabels.Length; band++)
                                    {
                                        <span><i class="tg-traffic-swatch tg-spd-@band" aria-hidden="true"></i>@SpeedBandLabels[band]</span>
                                    }
                                }
                            </div>
                            @if (_cityTrafficReleases.Count > 0 || _speedSources.Count > 0)
                            {
                                <p class="tg-traffic-source">
                                    SOURCES: FHWA HPMS@(_cityTrafficReleases.Count > 0 ? $" ({string.Join(", ", _cityTrafficReleases)} release{(_cityTrafficReleases.Count == 1 ? "" : "s")})" : "")@(_speedSources.Count > 0 ? $" · {string.Join(", ", _speedSources)} live speeds" : "")@(_liveFlowOn || _busiestLive.Count > 0 ? " · live flow © TomTom" : ""). CLICK A ROAD FOR ITS DETAILS.
                                </p>
                            }
                        </div>
                    }
                    @if (!_hasAnyProviderConfigured && !_bannerDismissed)
                    {
                        <div class="tg-favorites-empty tg-explore-note" role="note">
                            No setup needed: 25+ US states and several countries have live cameras and incidents
                            with no registration - pick a place below. Optional keys (Windy, Mapillary, Datumfeed) are
                            described in docs/OVERWATCH_USER_GUIDE.md.
                            <button type="button" class="tg-panel-close" aria-label="Dismiss" @onclick="DismissBannerAsync">&times;</button>
                        </div>
                    }
                    <div class="tg-coverage-panel-header">
                        <span>KNOWN COVERAGE</span>
                        <button type="button" class="tg-coverage-map-toggle" aria-pressed="@(_coverageOnMap ? "true" : "false")" @onclick="ToggleCoverageOnMapAsync">
                            @(_coverageOnMap ? "HIDE ON MAP" : "SHOW ON MAP")
                        </button>
                    </div>
                    <ul class="tg-coverage-list">
                        @foreach (var region in CameraCoverageRegions.All)
                        {
                            var status = RegionStatus(region);
                            <li class="tg-coverage-item">
                                <span>
                                    @region.Name
                                    <small class="tg-coverage-status @(status.Ok ? "is-ok" : "")">@status.Text</small>
                                </span>
                                <button type="button" @onclick="() => FlyToRegionAsync(region)">GO</button>
                            </li>
                        }
                    </ul>
                    break;
                case "directions":
                    <form class="tg-route-form" @onsubmit="WatchRouteAsync" @onsubmit:preventDefault>
                        @for (var i = 0; i < _routeStops.Count; i++)
                        {
                            var index = i;
                            <div class="tg-route-stop">
                                <input aria-label="@StopLabel(index)" placeholder="@StopPlaceholder(index)" value="@_routeStops[index]"
                                       @oninput="e => _routeStops[index] = e.Value?.ToString() ?? string.Empty" />
                                <button type="button" title="Click the globe to set this stop" aria-label="@($"Pick {StopLabel(index)} on the map")"
                                        class="@(_pickingStop == index ? "is-on" : "")" @onclick="() => PickStopOnMapAsync(index)">@(_pickingStop == index ? "CLICK MAP" : "MAP")</button>
                                @if (_routeStops.Count > 2)
                                {
                                    <button type="button" aria-label="@($"Remove {StopLabel(index)}")" @onclick="() => RemoveStop(index)">X</button>
                                }
                            </div>
                        }
                        <label class="tg-route-depart">
                            <span>LEAVE AT <small>(blank = now)</small></span>
                            <input type="datetime-local" aria-label="Departure time" value="@_departureLocal" @onchange="OnDepartureChangedAsync" />
                        </label>
                        <div class="tg-route-row">
                            <button type="button" disabled="@(_routeStops.Count >= GwsBusinessSuite.Application.RouteWatch.RouteWatchService.MaxStops)" @onclick="AddStop">+ STOP</button>
                            <button type="submit" disabled="@(_routeBusy || _routeStops.Count(s => !string.IsNullOrWhiteSpace(s)) < 2)">
                                @(_routeBusy ? "ROUTING..." : "WATCH ROUTE")
                            </button>
                        </div>
                    </form>
                    <form class="tg-route-form" @onsubmit="SaveTripAsync" @onsubmit:preventDefault>
                        <div class="tg-route-row">
                            <input aria-label="Trip name" placeholder="NAME THIS TRIP" maxlength="80" value="@_tripName" @oninput="e => _tripName = e.Value?.ToString() ?? string.Empty" />
                            <button type="submit" disabled="@(string.IsNullOrWhiteSpace(_tripName) || _routeStops.Count(s => !string.IsNullOrWhiteSpace(s)) < 2)">SAVE TRIP</button>
                        </div>
                    </form>
                    @if (!string.IsNullOrWhiteSpace(_tripMessage))
                    {
                        <div class="tg-favorites-empty" role="status">@_tripMessage</div>
                    }
                    @if (_route is { } route)
                    {
                        @if (!string.IsNullOrWhiteSpace(route.Error))
                        {
                            <div class="tg-favorites-empty" role="status">@route.Error</div>
                        }
                        else
                        {
                            <div class="tg-route-summary" role="status">
                                @route.DistanceMiles.ToString("N0") MI · @FormatDuration(route.DurationMinutes) ·
                                @route.Incidents.Count INCIDENTS · @route.Cameras.Count CAMERAS · @route.Alerts.Count ALERTS@(_routeNews.Count > 0 ? $" · {_routeNews.Count} NEWS" : "")
                            </div>
                            <div class="tg-route-row tg-route-actions">
                                <a class="tg-link-btn" href="@GwsBusinessSuite.Application.RouteWatch.RouteDirectionsText.PrintLink(_routeStops)" target="_blank" rel="noopener"
                                   title="Open a printable page of these directions">PRINT</a>
                                <button type="button" title="Copy the directions as text" @onclick="() => CopyDirectionsAsync(route)">COPY</button>
                                <button type="button" title="Share these directions" @onclick="() => ShareDirectionsAsync(route)">SHARE</button>
                                <button type="button" title="A short briefing on this drive, written by the model on this computer" @onclick="() => BriefRouteAsync(route)">BRIEF ME</button>
                                <button type="button" title="Follow this route with your device's location" @onclick="() => StartDriveAsync(route)">DRIVE</button>
                                <button type="button" @onclick="ClearRouteAsync">CLEAR ROUTE</button>
                            </div>
                            @if (!string.IsNullOrEmpty(_directionsMessage))
                            {
                                <div class="tg-favorites-empty" role="status">@_directionsMessage</div>
                            }
                            <div class="tg-route-subheader">WHEN SHOULD I LEAVE?</div>
                            @if (_departurePlan is not { } plan)
                            {
                                <div class="tg-route-row tg-route-actions">
                                    <button type="button" disabled="@_planBusy" @onclick="() => PlanDepartureAsync(route)">
                                        @(_planBusy ? "CHECKING FORECASTS..." : $"CHECK THE NEXT {GwsBusinessSuite.Application.RouteWatch.DeparturePlanner.WindowHours} HOURS")
                                    </button>
                                </div>
                            }
                            else
                            {
                                var chosen = _chosenDeparture ?? plan.Best;
                                var maxScore = Math.Max(1, plan.Options.Max(o => o.Score));
                                @if (plan.Best is { } best)
                                {
                                    <div class="tg-route-summary tg-depart-best" role="status">
                                        BEST: LEAVE @best.DepartUtc.ToLocalGwsTime() (ARRIVE @best.ArriveUtc.ToLocalGwsTime()) · @best.Reasons[0]
                                    </div>
                                }
                                <div class="tg-depart-chart" role="list" aria-label="Departure times, every 30 minutes">
                                    @foreach (var option in plan.Options)
                                    {
                                        <button type="button" role="listitem" class="tg-depart-bar is-@option.Rating @(option == chosen ? "is-chosen" : "")"
                                                style="--tg-bar: @((int)Math.Round(15 + 85 * option.Score / maxScore))%"
                                                title="@($"Leave {option.DepartUtc.ToLocalGwsTime()}: {option.Rating} - {string.Join("; ", option.Reasons)}")"
                                                aria-label="@($"Leave {option.DepartUtc.ToLocalGwsTime()}, {option.Rating}")" @onclick="() => _chosenDeparture = option">
                                            <span></span>
                                        </button>
                                    }
                                </div>
                                <div class="tg-depart-axis">
                                    <span>@plan.Options[0].DepartUtc.ToLocalGwsTime()</span>
                                    <span>@plan.Options[plan.Options.Count / 2].DepartUtc.ToLocalGwsTime()</span>
                                    <span>@plan.Options[^1].DepartUtc.ToLocalGwsTime()</span>
                                </div>
                                @if (chosen is not null)
                                {
                                    <div class="tg-depart-detail">
                                        <strong>LEAVE @chosen.DepartUtc.ToLocalGwsDateTime() · @chosen.Rating.ToUpperInvariant()</strong>
                                        <ul>
                                            @foreach (var reason in chosen.Reasons)
                                            {
                                                <li>@reason</li>
                                            }
                                        </ul>
                                        <div class="tg-route-row">
                                            <button type="button" @onclick="() => UseDepartureAsync(chosen)">USE THIS TIME</button>
                                            <button type="button" @onclick="() => PlanDepartureAsync(route)" disabled="@_planBusy">REFRESH</button>
                                        </div>
                                    </div>
                                }
                                <div class="tg-favorites-empty">@plan.Note</div>
                            }
                            @if (route.Steps is { Count: > 0 } steps)
                            {
                                <details class="tg-directions" open>
                                    <summary class="tg-route-subheader">STEP-BY-STEP DIRECTIONS (@steps.Count)</summary>
                                    <ol class="tg-directions-list">
                                        @foreach (var step in steps)
                                        {
                                            <li>
                                                <button type="button" class="tg-direction-step" title="Show this on the map" @onclick="() => FlyToStepAsync(step)">
                                                    <i class="bi @StepIcon(step.Kind)" aria-hidden="true"></i>
                                                    <span class="tg-direction-text">@step.Instruction</span>
                                                    @if (step.DistanceMiles > 0)
                                                    {
                                                        <small>@GwsBusinessSuite.Application.RouteWatch.RouteDirections.FormatDistance(step.DistanceMiles)</small>
                                                    }
                                                </button>
                                            </li>
                                        }
                                    </ol>
                                </details>
                            }
                            <ul class="tg-coverage-list">
                                @if (route.Legs is { Count: > 1 } legs)
                                {
                                    @for (var legIndex = 0; legIndex < legs.Count; legIndex++)
                                    {
                                        var leg = legs[legIndex];
                                        <li class="tg-coverage-item tg-route-leg">
                                            <span>MI @leg.StartsAtMile.ToString("0") · LEG @(legIndex + 1)
                                                <small>@leg.From > @leg.To · @leg.DistanceMiles.ToString("N0") mi · @FormatDuration(leg.DurationMinutes)</small></span>
                                        </li>
                                    }
                                }
                                @foreach (var stretch in _drivingLight)
                                {
                                    <li class="tg-coverage-item @(stretch.Kind == GwsBusinessSuite.Application.RouteWatch.DrivingLightKind.Dark ? "tg-route-dark" : "tg-route-glare")">
                                        <span>MI @stretch.StartMile.ToString("0")-@stretch.EndMile.ToString("0") · @(stretch.Kind == GwsBusinessSuite.Application.RouteWatch.DrivingLightKind.Dark ? "DARK" : "SUN GLARE")
                                            <small>@FormatClock(stretch.StartUtc)-@FormatClock(stretch.EndUtc) · @stretch.Heading@(stretch.Kind == GwsBusinessSuite.Application.RouteWatch.DrivingLightKind.SunGlare ? " · low sun ahead" : " · headlights")</small></span>
                                    </li>
                                }
                                @foreach (var alert in route.Alerts)
                                {
                                    <li class="tg-coverage-item tg-route-alert"><span>ALERT · @alert.Event<small>@alert.AreaDescription</small></span></li>
                                }
                                @foreach (var item in route.RoadWeather ?? [])
                                {
                                    <li class="tg-coverage-item @(item.Station.Risk == GwsBusinessSuite.Application.RoadWeather.RoadIceRisk.IceLikely ? "tg-route-ice" : "tg-route-cold")">
                                        <span>MI @item.MilesAlong.ToString("0") · @(item.Station.Risk == GwsBusinessSuite.Application.RoadWeather.RoadIceRisk.IceLikely ? "ICE LIKELY" : "NEAR FREEZING")
                                            <small>@item.Station.Name - @item.Station.Reason</small></span>
                                    </li>
                                }
                                @foreach (var item in route.Signs ?? [])
                                {
                                    <li class="tg-coverage-item tg-route-sign">
                                        <span>MI @item.MilesAlong.ToString("0") · SIGN@(item.Sign.Direction is { } signDirection ? " · " + signDirection.ToUpperInvariant() : "")
                                            <small>@item.Sign.Text</small></span>
                                    </li>
                                }
                                @foreach (var item in _routeNews)
                                {
                                    <li class="tg-coverage-item">
                                        <span>NEWS · @item.Reason.ToUpperInvariant()<small>@item.Signal.Title</small></span>
                                        <button type="button" @onclick="() => OpenRouteNewsAsync(item.Signal)">VIEW</button>
                                    </li>
                                }
                                @foreach (var item in route.Incidents)
                                {
                                    <li class="tg-coverage-item">
                                        <span>MI @item.MilesAlong.ToString("0") · @IncidentCategories.Label(item.Incident.Category).ToUpperInvariant()
                                            <small>@item.Incident.RoadwayName - @item.Incident.Description</small></span>
                                    </li>
                                }
                                @foreach (var item in route.Cameras)
                                {
                                    <li class="tg-coverage-item">
                                        <span>MI @item.MilesAlong.ToString("0") · CAMERA<small>@item.Camera.Name</small></span>
                                        <button type="button" @onclick="() => OpenRouteCameraAsync(item.Camera)">VIEW</button>
                                    </li>
                                }
                            </ul>
                            <div class="tg-route-subheader">ASK THE CAMERAS <small>(a vision model on this computer's Ollama reads each camera)</small></div>
                            @if (_visionModels.Count == 0)
                            {
                                <div class="tg-favorites-empty" role="status">@(_conditionError ?? "Looking for Ollama on this computer...")</div>
                            }
                            else
                            {
                                <form class="tg-route-form" @onsubmit="AskCamerasAsync" @onsubmit:preventDefault>
                                    <div class="tg-route-row">
                                        <select aria-label="Vision model" value="@_conditionModel" @onchange="e => _conditionModel = e.Value?.ToString() ?? string.Empty">
                                            @foreach (var model in _visionModels)
                                            {
                                                <option value="@model">@model@(GwsBusinessSuite.Application.RouteWatch.CameraConditions.LooksVisionCapable(model) ? "" : " (may not see images)")</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="tg-route-row">
                                        <input aria-label="Question for the cameras" placeholder="OPTIONAL QUESTION, E.G. IS IT SNOWING?" maxlength="200"
                                               value="@_conditionQuestion" @oninput="e => _conditionQuestion = e.Value?.ToString() ?? string.Empty" />
                                        <button type="submit" disabled="@(_conditionBusy || RouteConditionCameras(route).Count == 0)">
                                            @(_conditionBusy ? $"READING {_conditionResults.Count}/{RouteConditionCameras(route).Count}" : $"CHECK {RouteConditionCameras(route).Count} CAMERAS")
                                        </button>
                                    </div>
                                </form>
                                @if (!string.IsNullOrWhiteSpace(_conditionError))
                                {
                                    <div class="tg-favorites-empty" role="status">@_conditionError</div>
                                }
                            }
                            @if (_conditionResults.Count > 0)
                            {
                                <div class="tg-route-summary" role="status">@ConditionSummary()</div>
                                <ul class="tg-coverage-list">
                                    @foreach (var (camera, reading) in _conditionResults)
                                    {
                                        <li class="tg-coverage-item tg-condition-@reading.Level">
                                            <span>MI @camera.MilesAlong.ToString("0") · @ConditionLabel(reading)
                                                <small>@camera.Camera.Name@(string.IsNullOrWhiteSpace(reading.Answer) ? "" : " - " + reading.Answer)@(string.IsNullOrWhiteSpace(reading.Note) ? "" : " - " + reading.Note)</small></span>
                                            <button type="button" @onclick="() => OpenRouteCameraAsync(camera.Camera)">VIEW</button>
                                        </li>
                                    }
                                </ul>
                            }
                        }
                    }
                    break;
                case "saved":
                    <div class="tg-coverage-panel-header">FAVORITE CAMERAS</div>
                    @if (_favorites.Count == 0)
                    {
                        <div class="tg-favorites-empty">No favorited cameras yet - open a camera's feed and click its star to save it here.</div>
                    }
                    else
                    {
                        <ul class="tg-coverage-list">
                            @foreach (var favorite in _favorites)
                            {
                                <li class="tg-coverage-item">
                                    <span>@favorite.Name</span>
                                    <span class="tg-area-actions">
                                        @if (favorite.StreamKind == CameraStreamKind.Snapshot)
                                        {
                                            <button type="button" title="Play the frames saved for this camera (one every 10 minutes when the picture changed, up to 24 hours)"
                                                    @onclick="() => OpenTimelapseAsync(favorite)">TIME-LAPSE</button>
                                        }
                                        <button type="button" @onclick="() => GoToFavoriteAsync(favorite)">GO</button>
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                    @if (_trips.Count == 0)
                    {
                        <div class="tg-route-subheader">SAVED TRIPS</div>
                        <div class="tg-favorites-empty">No saved trips yet - plan a route under DIRECTIONS and save it.</div>
                    }
                    @if (_trips.Count > 0)
                    {
                        <div class="tg-route-subheader">SAVED TRIPS</div>
                        <ul class="tg-coverage-list">
                            @foreach (var trip in _trips)
                            {
                                <li class="tg-coverage-item">
                                    <span>@trip.Name<small>@string.Join(" > ", trip.Stops)</small></span>
                                    <span class="tg-area-actions">
                                        <button type="button" @onclick="() => PlotTripAsync(trip)">PLOT</button>
                                        <button type="button" aria-label="@($"Delete trip {trip.Name}")" @onclick="() => DeleteTripAsync(trip)">X</button>
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                    <div class="tg-route-subheader">MAP NOTES</div>
                    @if (_noteDraft is { } draft)
                    {
                        <form class="tg-route-form" @onsubmit="SaveNoteAsync" @onsubmit:preventDefault>
                            <div class="tg-favorites-empty" role="status">
                                @if (draft.Kind == GwsBusinessSuite.Infrastructure.Services.MapNoteKinds.Pin)
                                {
                                    @(draft.Points.Count == 0 ? "Click the map where the pin goes." : "Pin placed. Click PLACE AGAIN to move it.")
                                }
                                else
                                {
                                    @($"Click the map to add each corner ({draft.Points.Count} so far, 3 or more needed).")
                                }
                            </div>
                            <div class="tg-area-actions">
                                @if (draft.Kind == GwsBusinessSuite.Infrastructure.Services.MapNoteKinds.Pin && draft.Points.Count > 0)
                                {
                                    <button type="button" @onclick="RestartNotePickAsync">PLACE AGAIN</button>
                                }
                                @if (draft.Kind == GwsBusinessSuite.Infrastructure.Services.MapNoteKinds.Area && draft.Points.Count > 0)
                                {
                                    <button type="button" @onclick="UndoNotePointAsync">UNDO CORNER</button>
                                }
                            </div>
                            <input aria-label="Note title" placeholder="TITLE" maxlength="80" value="@draft.Title" @oninput="e => draft.Title = e.Value?.ToString() ?? string.Empty" />
                            <textarea aria-label="Note" placeholder="NOTE (OPTIONAL)" maxlength="2000" rows="3" class="tg-note-body"
                                      @oninput="e => draft.Body = e.Value?.ToString() ?? string.Empty">@draft.Body</textarea>
                            <div class="tg-note-colors" role="radiogroup" aria-label="Colour">
                                @foreach (var colour in GwsBusinessSuite.Infrastructure.Services.MapNoteService.Colors)
                                {
                                    <button type="button" role="radio" aria-checked="@(draft.Color == colour ? "true" : "false")" aria-label="@($"Colour {colour}")"
                                            class="tg-note-swatch @(draft.Color == colour ? "is-on" : "")" style="background:@colour" @onclick="() => SetNoteColorAsync(colour)"></button>
                                }
                            </div>
                            <div class="tg-area-actions">
                                <button type="submit" disabled="@(string.IsNullOrWhiteSpace(draft.Title))">SAVE</button>
                                <button type="button" @onclick="CancelNoteAsync">CANCEL</button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="tg-route-row tg-note-new">
                            <button type="button" @onclick='() => StartNoteAsync(GwsBusinessSuite.Infrastructure.Services.MapNoteKinds.Pin)'>+ PIN</button>
                            <button type="button" @onclick='() => StartNoteAsync(GwsBusinessSuite.Infrastructure.Services.MapNoteKinds.Area)'>+ AREA</button>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(_noteMessage))
                    {
                        <div class="tg-favorites-empty" role="status">@_noteMessage</div>
                    }
                    @if (_notes.Count == 0 && _noteDraft is null)
                    {
                        <div class="tg-favorites-empty">Drop a pin or draw an area to mark something on the map: a staging spot, a camera blind spot, a road to avoid. Only you see your notes unless you share one.</div>
                    }
                    else if (_notes.Count > 0)
                    {
                        <ul class="tg-coverage-list">
                            @foreach (var note in _notes)
                            {
                                <li class="tg-coverage-item">
                                    <span><i class="tg-note-dot" style="background:@note.Color" aria-hidden="true"></i>@note.Title<small>@(note.Kind == GwsBusinessSuite.Infrastructure.Services.MapNoteKinds.Area ? "AREA" : "PIN")@(note.IsShared ? " · SHARED" : "") · @note.UpdatedAt.ToLocalGwsDateTime()</small></span>
                                    <span class="tg-area-actions">
                                        <button type="button" @onclick="() => OpenNoteAsync(note)">GO</button>
                                        <button type="button" @onclick="() => EditNoteAsync(note)">EDIT</button>
                                        <button type="button" aria-label="@($"Delete note {note.Title}")" @onclick="() => DeleteNoteAsync(note)">X</button>
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                    break;
                case "areas":
                    <div class="tg-coverage-panel-header">CAMERA WATCH</div>
                    @if (_cameraWatchStatus is { } watch)
                    {
                        <div class="tg-favorites-empty" role="status">
                            @if (watch.LastCheckedAt is { } lastChecked)
                            {
                                <text>Your Mac's vision model last read the cameras at @lastChecked.ToLocalGwsDateTime() (@watch.CheckedLastHour in the last hour, @watch.Watched watched). You get a bell alert when one turns bad.</text>
                            }
                            else
                            {
                                <text>Not running yet. Open the GWS Mac app with Ollama and a vision model (e.g. gemma4): it reads your favorite cameras and the cameras in your watched areas (@watch.Watched now) every 10 minutes.</text>
                            }
                        </div>
                        @if (watch.NeedAttention.Count > 0)
                        {
                            <ul class="tg-coverage-list">
                                @foreach (var camera in watch.NeedAttention)
                                {
                                    <li class="tg-coverage-item tg-condition-@camera.LastLevel">
                                        <span>@camera.CameraName<small>@camera.LastLevel.ToUpperInvariant() · @camera.LastSummary · @DateTimeOffset.FromUnixTimeSeconds(camera.LastCheckedUnix).ToLocalGwsTime()</small></span>
                                        <button type="button" @onclick="() => FlyToPointAsync(camera.Latitude, camera.Longitude)">GO</button>
                                    </li>
                                }
                            </ul>
                        }
                    }
                    <div class="tg-coverage-panel-header">WATCHED AREAS</div>
                    <form class="tg-route-form" @onsubmit="AddAreaAsync" @onsubmit:preventDefault>
                        <input aria-label="Area name" placeholder="NAME FOR THE CURRENT VIEW" maxlength="80" value="@_areaName" @oninput="e => _areaName = e.Value?.ToString() ?? string.Empty" />
                        <div class="tg-area-options">
                            <label><input type="checkbox" @bind="_areaIncidents" /> INCIDENTS</label>
                            <label><input type="checkbox" @bind="_areaWeather" /> WEATHER</label>
                            <label><input type="checkbox" @bind="_areaHazards" /> HAZARDS</label>
                            <label title="World News stories placed at a city in the area: disasters, transport, conflict and health"><input type="checkbox" @bind="_areaNews" /> NEWS</label>
                        </div>
                        <select aria-label="Minimum severity" value="@_areaSeverity" @onchange="e => _areaSeverity = e.Value?.ToString() ?? OverwatchAreaSeverityAny">
                            <option value="major">MAJOR ONLY</option>
                            <option value="moderate">MODERATE AND UP</option>
                            <option value="any">ANYTHING</option>
                        </select>
                        <button type="submit" disabled="@(_areaBusy || string.IsNullOrWhiteSpace(_areaName))">WATCH THIS VIEW</button>
                    </form>
                    @if (!string.IsNullOrWhiteSpace(_areaMessage))
                    {
                        <div class="tg-favorites-empty" role="status">@_areaMessage</div>
                    }
                    @if (_areas.Count == 0)
                    {
                        <div class="tg-favorites-empty">Frame an area on the globe, name it, and Overwatch checks it every 10 minutes - new crashes, closures, severe weather and hazards show up in the notification bell, and the nearest cameras to a new crash or closure start recording (CAPTURES).</div>
                    }
                    else
                    {
                        <ul class="tg-coverage-list">
                            @foreach (var area in _areas)
                            {
                                <li class="tg-coverage-item">
                                    <span>@area.Name
                                        <small>@AreaDescription(area)</small></span>
                                    <span class="tg-area-actions">
                                        <button type="button" @onclick="() => GoToAreaAsync(area)">GO</button>
                                        <button type="button" aria-label="@($"Brief me on {area.Name}")" @onclick="() => BriefAreaAsync(area)">BRIEF</button>
                                        <button type="button" aria-label="@($"Stop watching {area.Name}")" @onclick="() => RemoveAreaAsync(area)">X</button>
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                    <div class="tg-coverage-panel-header">MORNING BRIEFING</div>
                    <form class="tg-route-form" @onsubmit="SaveMorningBriefingAsync" @onsubmit:preventDefault>
                        <div class="tg-area-options">
                            <label><input type="checkbox" @bind="_morningEnabled" /> EVERY DAY AT</label>
                            <select aria-label="Hour to send the morning briefing" value="@_morningHour" @onchange="e => _morningHour = int.TryParse(e.Value?.ToString(), out var hour) ? hour : 7">
                                @for (var hour = 0; hour < 24; hour++)
                                {
                                    <option value="@hour">@hour.ToString("00"):00</option>
                                }
                            </select>
                        </div>
                        <input type="email" aria-label="Email the briefing to (optional)" placeholder="ALSO EMAIL TO (OPTIONAL)" maxlength="254"
                               value="@_morningEmail" @oninput="e => _morningEmail = e.Value?.ToString() ?? string.Empty" />
                        <button type="submit" disabled="@_morningBusy">SAVE</button>
                    </form>
                    <div class="tg-favorites-empty" role="status">@(_morningMessage ?? "A plain summary of each watched area and your 5 most recent saved trips, to the bell (and email" + (Briefings.CanEmail() ? "" : " once SMTP is set up in Settings") + ").")</div>
                    @if (_captures.Count > 0)
                    {
                        <div class="tg-route-subheader">CAPTURES <small>(cameras recorded around new incidents)</small></div>
                        <ul class="tg-coverage-list">
                            @foreach (var capture in _captures)
                            {
                                <li class="tg-coverage-item tg-capture-item">
                                    <span>@capture.Title
                                        <small>@capture.AreaName · @capture.StartedAt.ToLocalTime().ToString("dd-MM-yy HH:mm", System.Globalization.CultureInfo.InvariantCulture)@(capture.Until > DateTimeOffset.UtcNow ? " · RECORDING" : "")</small></span>
                                    <span class="tg-area-actions">
                                        @foreach (var camera in capture.Cameras)
                                        {
                                            var frameCount = CaptureFrameCount(camera);
                                            <button type="button" disabled="@(frameCount == 0)" title="@camera.Name (@camera.MilesAway.ToString("0.0") mi away)"
                                                    @onclick="() => OpenCaptureCameraAsync(capture, camera)">CAM @(capture.Cameras.IndexOf(camera) + 1) (@frameCount)</button>
                                        }
                                        @if (capture.LinkUrl is not null)
                                        {
                                            <a class="tg-link-btn" href="@capture.LinkUrl" title="This story on World News: every source and the full timeline">NEWS</a>
                                        }
                                        <a class="tg-link-btn" href="@($"/admin/api/overwatch/incident-report?capture={capture.Id}")" target="_blank" rel="noopener"
                                           title="A PDF of this capture: details, map, weather and the recorded frames">REPORT</a>
                                        <button type="button" aria-label="@($"Delete capture {capture.Title}")" @onclick="() => DeleteCapture(capture)">X</button>
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                    break;
            }
        </div>
    </aside>

    @* Map controls (bottom-right). *@
    <div class="tg-map-controls" role="group" aria-label="Map controls">
        <button type="button" class="tg-icon-btn" aria-label="Zoom in" title="Zoom in" @onclick="() => ZoomAsync(true)"><i class="bi bi-plus-lg" aria-hidden="true"></i></button>
        <button type="button" class="tg-icon-btn" aria-label="Zoom out" title="Zoom out" @onclick="() => ZoomAsync(false)"><i class="bi bi-dash-lg" aria-hidden="true"></i></button>
        <button type="button" class="tg-icon-btn" aria-label="Whole globe" title="Whole globe" @onclick="GoHomeAsync"><i class="bi bi-globe-americas" aria-hidden="true"></i></button>
        <button type="button" class="tg-icon-btn @(_timeMachineOn ? "is-active" : "")" aria-label="Time machine: see the past 24 hours" title="Time machine: see the past 24 hours"
                aria-pressed="@(_timeMachineOn ? "true" : "false")" @onclick="ToggleTimeMachineAsync"><i class="bi bi-clock-history" aria-hidden="true"></i></button>
        <button type="button" class="tg-icon-btn @(_briefFacts is not null ? "is-active" : "")" aria-label="Brief me on this view" title="Brief me on this view"
                @onclick="BriefViewAsync"><i class="bi bi-card-text" aria-hidden="true"></i></button>
        <button type="button" class="tg-icon-btn tg-streetview-btn @(_streetPicking ? "is-active" : "")" data-tg-streetview draggable="true"
                aria-label="Street view: click here, then click the map (or drag me onto the map)"
                title="Street view: drag me onto the map, or click me and then click the map" aria-pressed="@(_streetPicking ? "true" : "false")"
                @onclick="ToggleStreetViewPickAsync"><i class="bi bi-person-standing" aria-hidden="true"></i></button>
        <button type="button" class="tg-icon-btn" id="tg-share-button" aria-label="Copy a link to this exact view" title="Copy a link to this exact view"><i class="bi bi-share" aria-hidden="true"></i></button>
        @* Purely client-side (app.js toggleFocusMode): hides the admin bar and sidebar. *@
        <button type="button" data-gws-focus-toggle class="tg-icon-btn tg-toggle-focus" title="Fullscreen" aria-label="Fullscreen" aria-pressed="false">
            <i class="bi bi-arrows-fullscreen" aria-hidden="true"></i>
        </button>
    </div>

    @if (_hasAnyProviderConfigured && _hasSettledOnce && _visibleCameras.Count == 0 && !_emptyHintDismissed)
    {
        var suggestions = GwsBusinessSuite.Application.CameraIntel.CoverageGapHelper.Nearest(_lastBbox, CameraCoverageRegions.All);
        <div class="tg-empty-hint" role="status">
            <div class="tg-empty-hint-body">
                <span>NO CAMERAS IN THIS VIEW@(_incidentsOn && _lastIncidents.Count == 0 ? " AND NO INCIDENTS LISTED" : "").
                    @(suggestions.Count > 0 ? "Nearest areas with camera coverage:" : "Zoom out for scattered webcams.")</span>
                @if (suggestions.Count > 0)
                {
                    <ul class="tg-gap-list">
                        @foreach (var suggestion in suggestions)
                        {
                            <li>
                                <span>@suggestion.Region.Name <small>@suggestion.Miles.ToString("N0") mi @suggestion.Direction</small></span>
                                <button type="button" @onclick="() => FlyToRegionAsync(suggestion.Region)">GO</button>
                            </li>
                        }
                    </ul>
                }
            </div>
            <button type="button" class="tg-empty-hint-close" aria-label="Dismiss" @onclick="() => _emptyHintDismissed = true">&times;</button>
        </div>
    }


    @if (_initError is null)
    {
        <div class="tg-boot @(_bootComplete ? "tg-boot-hidden" : "")">
            <div class="tg-boot-line">INITIALIZING TACTICAL UPLINK...</div>
            <div class="tg-boot-bar"><div class="tg-boot-bar-fill"></div></div>
            <div class="tg-boot-line">STANDBY</div>
        </div>
    }
    else
    {
        <div class="tg-boot">
            <div class="tg-boot-line">UPLINK FAILED</div>
            <div class="tg-boot-line" style="opacity:.75;font-size:0.7rem;max-width:70%;text-align:center;">@_initError</div>
        </div>
    }
</div>

@code {
    // "v" for "view" - a Base64Url-encoded SharedGridView (see SharedGridViewCodec), read the
    // same way Login.razor reads its own query parameters.
    [SupplyParameterFromQuery(Name = "v")]
    public string? SharedViewToken { get; set; }

    // A watched area to frame on load - the notification bell links here.
    [SupplyParameterFromQuery(Name = "area")]
    public Guid? AreaId { get; set; }

    // ?detection={alertId} - a camera-watch bell alert opens its before/after frames.
    [SupplyParameterFromQuery(Name = "detection")]
    public Guid? DetectionId { get; set; }

    // ?note={id}&key={shareKey} - a shared map note (the owner needs no key).
