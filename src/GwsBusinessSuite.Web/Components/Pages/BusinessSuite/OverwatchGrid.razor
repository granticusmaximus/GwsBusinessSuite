    // Drop point -> the nearest 360° panorama (Overwatch's own viewer), or flat photos if there's none.
    private async Task ShowStreetViewAsync(double latitude, double longitude)
    {
        _layersOpen = _infoOpen = _helpOpen = false;
        _streetBusy = true;
        _streetView = null;
        _streetIndex = 0;
        StateHasChanged();
        await JS.InvokeVoidAsync("tacticalGlobe.setStreetViewMarker", "tg-viewport", latitude, longitude);
        // The globe flies down to the street while the panorama is looked up.
        var flight = JS.InvokeVoidAsync("tacticalGlobe.flyToStreetLevel", "tg-viewport", latitude, longitude, 0).AsTask();
        try
        {
            var found = await StreetLevelImagery.GetSceneAsync(latitude, longitude);
            try
            {
                await flight;
            }
            catch (JSException)
            {
                // Only the transition failed; the panorama still opens.
            }
            if (found is { } scene)
            {
                _streetScene = scene;
                _streetSceneNeedsOpen = true;
            }
            else
            {
                _streetView = await StreetLevelImagery.FindNearAsync(latitude, longitude);
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "Street view lookup failed");
            _streetView = new StreetViewResult(latitude, longitude, []);
        }
        finally
        {
            _streetBusy = false;
        }
        StateHasChanged();
    }

    // street-view.js calls this when an arrow is clicked: the chosen neighbour becomes the scene.
    [JSInvokable]
    public async Task<object?> MoveStreetViewAsync(string panoramaId)
    {
        if (_streetScene is not { } current) return null;
        var next = await StreetLevelImagery.GetSceneAsync(current.Current.Latitude, current.Current.Longitude, panoramaId);
        if (next is null) return null;
        _streetScene = next;
        await JS.InvokeVoidAsync("tacticalGlobe.setStreetViewMarker", "tg-viewport", next.Current.Latitude, next.Current.Longitude);
        StateHasChanged();
        return StreetSceneForViewer(next);
    }

