    // ---- City traffic: HPMS road volumes + live speeds on the globe, summed up in EXPLORE. ----
    private bool _cityTrafficOn;
    private bool _cityTrafficLoading;
    private string? _cityTrafficNote;
    private string? _cityTrafficCoverage;
    private IReadOnlyList<string> _cityTrafficReleases = [];
    private GwsBusinessSuite.Application.RoadTraffic.RoadTrafficSummary? _roadSummary;
    private GwsBusinessSuite.Application.RoadTraffic.LiveSpeedSummary? _speedSummary;
    private IReadOnlyList<string> _speedSources = [];
    private IReadOnlyList<(string Label, int Count)> _trafficIncidents = [];
    private int _cityTrafficGeneration;

    // Matches tactical-globe.js's volumeBands / speedColour.
    private static readonly int[] VolumeBandFloors = [0, 5000, 15000, 40000, 100000, 200000];
    private static readonly string[] VolumeBandLabels = ["<5K", "5-15K", "15-40K", "40-100K", "100-200K", "200K+"];
    private static readonly string[] SpeedBandLabels = ["<15", "15-30", "30-45", "45+"];
    // The globe draws at most this many sections (the busiest); the summary counts them all.
    private const int MaxDrawnRoads = 4000;

    private static int VolumeBand(int vehiclesPerDay) => Array.FindLastIndex(VolumeBandFloors, floor => vehiclesPerDay >= floor);
    private static int SpeedBand(double mph) => mph < 15 ? 0 : mph < 30 ? 1 : mph < 45 ? 2 : 3;

    private static string BigNumber(double value) => value >= 1_000_000
        ? $"{value / 1_000_000:0.#} MILLION"
        : value.ToString("N0");

    private string? CityTrafficStatus => _cityTrafficLoading && _roadSummary is null
        ? "LOADING ROAD TRAFFIC…"
        : string.IsNullOrWhiteSpace(_cityTrafficNote) ? null : _cityTrafficNote;

    private async Task ToggleCityTrafficAsync()
    {
        _cityTrafficOn = !_cityTrafficOn;
        _cityTrafficGeneration++;
        if (!_cityTrafficOn)
        {
            (_cityTrafficLoading, _cityTrafficNote, _cityTrafficCoverage, _roadSummary, _speedSummary) = (false, null, null, null, null);
            (_cityTrafficReleases, _speedSources, _trafficIncidents) = ([], [], []);
            await JS.InvokeVoidAsync("tacticalGlobe.setRoadTraffic", "tg-viewport", Array.Empty<object>(), Array.Empty<object>());
            return;
        }
        // The summary lives in EXPLORE, so that's where turning it on takes you.
        await SelectPanelTabAsync("explore", keepOpen: true);
        await PushCityTrafficAsync();
    }

    private async Task PushCityTrafficAsync()
    {
        var view = _lastBbox;
        var generation = ++_cityTrafficGeneration;
        _cityTrafficLoading = true;
        StateHasChanged();
        try
        {
            var roadsTask = RoadTrafficService.GetAsync(view);
            var speedsTask = LiveRoadSpeedService.GetAsync(view);
            var incidentsTask = TrafficIncidentDirectoryService.GetIncidentsInBoundingBoxAsync(view);
            await Task.WhenAll(roadsTask, speedsTask, incidentsTask);
            var (roads, speeds, incidents) = (await roadsTask, await speedsTask, await incidentsTask);
            if (!_cityTrafficOn || generation != _cityTrafficGeneration) return;

            _roadSummary = roads.Roads.Count > 0 ? GwsBusinessSuite.Application.RoadTraffic.RoadTrafficSummary.From(roads.Roads, view) : null;
            _busiestLive = [];
            _speedSummary = GwsBusinessSuite.Application.RoadTraffic.LiveSpeedSummary.From(speeds.Links);
            _speedSources = speeds.Sources;
            _cityTrafficCoverage = roads.Coverage;
            _cityTrafficReleases = roads.Releases;
            var drawn = roads.Roads.Count <= MaxDrawnRoads ? roads.Roads
                : roads.Roads.OrderByDescending(r => r.VehiclesPerDay).Take(MaxDrawnRoads).OrderBy(r => r.VehiclesPerDay).ToList();
            var drawnNote = drawn.Count < roads.Roads.Count
                ? $"The busiest {MaxDrawnRoads:N0} of {roads.Roads.Count:N0} sections are drawn; zoom in for the rest."
                : null;
            _cityTrafficNote = string.Join(" ", new[] { roads.Note, speeds.Note, drawnNote }.Where(n => !string.IsNullOrWhiteSpace(n)));
            _trafficIncidents = incidents.GroupBy(i => i.Category)
                .Select(g => (IncidentCategories.Label(g.Key), g.Count()))
                .OrderByDescending(g => g.Item2).ToList();
            await JS.InvokeVoidAsync("tacticalGlobe.setRoadTraffic", "tg-viewport",
                drawn.Select(RoadPayload), speeds.Links.Select(SpeedPayload), new { liveLookup = TomTom.IsConfigured });
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "Overwatch city traffic layer failed");
            _cityTrafficNote = "City traffic couldn't be shown just now.";
        }
        finally
        {
            if (generation == _cityTrafficGeneration) _cityTrafficLoading = false;
        }
    }

    private static object RoadPayload(GwsBusinessSuite.Application.RoadTraffic.RoadSegment road) => new
    {
        id = $"{road.State}{road.Id}", label = road.Label, name = road.Name == road.Label ? null : road.Name, cls = road.RoadClass, aadt = road.VehiclesPerDay, trucks = road.TrucksPerDay,
        future = road.FutureVehiclesPerDay, peak = road.PeakHourPercent, dir = road.PeakDirectionPercent, lanes = road.Lanes,
        limit = road.SpeedLimitMph, signals = road.Signals, stops = road.StopSigns, toll = road.Toll, ramp = road.Ramp,
        oneWay = road.OneWay, release = $"{road.State} {road.ReleaseYear}",
        paths = road.Paths.Select(path => path.Select(p => new[] { Math.Round(p.Longitude, 5), Math.Round(p.Latitude, 5) }))
    };

    private static object SpeedPayload(GwsBusinessSuite.Application.RoadTraffic.LiveRoadSpeed link) => new
    {
        id = link.Id, name = link.Name, area = link.Area, mph = link.SpeedMph, travel = link.TravelTimeSeconds,
        asOf = $"{link.AsOf.ToLocalGwsDate()} {link.AsOf.ToLocalGwsTime()}", source = link.Source, sourceUrl = link.SourceUrl,
        path = link.Path.Select(p => new[] { Math.Round(p.Longitude, 5), Math.Round(p.Latitude, 5) })
    };

