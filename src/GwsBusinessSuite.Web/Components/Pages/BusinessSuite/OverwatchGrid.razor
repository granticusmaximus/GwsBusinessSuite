    // Raised by tactical-globe.js's camera.moveEnd handler once the view settles after a
    // drag/zoom (see initGlobe) - degrees, matching Cesium's own Rectangle-to-degrees output.
    // Every layer is an independent external lookup, so they all start together (each directory
    // service also fans out across its own providers in parallel).
    // Perf (2026-10-12, Overwatch standout item 11): every layer used to be awaited together and
    // only then drawn, so the camera pins - the core of the page - waited for the slowest optional
    // layer on every pan (ODIN and the hazard feeds allow up to 25 s). Each layer now draws as
    // soon as its own data arrives, and a view generation stops a slow answer for an old view
    // from overwriting a newer one. Layers slower than SlowLayer are logged with their time.
    private static readonly TimeSpan SlowLayer = TimeSpan.FromSeconds(4);
    private int _viewGeneration;

    [JSInvokable]
    public async Task OnGlobeViewChanged(double north, double south, double east, double west)
    {
        _lastBbox = new BoundingBox(north, south, east, west);
        _hasSettledOnce = true;
        var generation = ++_viewGeneration;
        if (_timeMachineOn && !_tmPlaying) _ = InvokeAsync(async () => { await LoadTimeMachineAsync(); StateHasChanged(); });

        var centerLatitude = (north + south) / 2.0;
        var centerLongitude = (east + west) / 2.0;
        bool Current() => generation == _viewGeneration;

        await Task.WhenAll(
            TimedAsync("cameras", async () =>
            {
                var result = await CameraDirectoryService.GetCamerasForViewAsync(_lastBbox,
                    include: _hideUnhealthy ? c => !IsKnownUnhealthy(c.Id) : null);
                if (!Current()) return;
                _visibleCameras = result.Cameras.ToList();
                _camerasInViewTotal = result.TotalInView;
                // Reset the dismiss so a future empty area shows the hint again - this isn't a
                // one-time app-level notice like the provider-setup banner, it's per-location
                // information that should reappear whenever it becomes true again.
                if (_visibleCameras.Count > 0) _emptyHintDismissed = false;
                StateHasChanged();
                await JS.InvokeVoidAsync("tacticalGlobe.setCameraPins", _visibleCameras.Select(ToPinPayload).ToList());
            }),
            _alertsOn ? TimedAsync("alerts", async () =>
            {
                var alerts = await NwsAlertsService.GetActiveAlertsAsync(_lastBbox);
                if (Current() && _alertsOn) await ApplyAlertsAsync(alerts);
            }) : Task.CompletedTask,
            _incidentsOn ? TimedAsync("incidents", async () =>
            {
                var incidents = await TrafficIncidentDirectoryService.GetIncidentsInBoundingBoxAsync(_lastBbox);
                if (Current() && _incidentsOn) await ApplyIncidentsAsync(incidents);
            }) : Task.CompletedTask,
            _worldNewsOn ? TimedAsync("world news", () => Current() ? PushWorldNewsAsync() : Task.CompletedTask) : Task.CompletedTask,
            // Weather-on-zoom: always kept current for wherever the view is centered, not gated
            // behind a toggle - matches cameras/pins being always-on rather than opt-in.
            TimedAsync("weather", async () =>
            {
                var weather = await NwsForecastService.GetSnapshotAsync(centerLatitude, centerLongitude);
                if (!Current()) return;
                await JS.InvokeVoidAsync("tacticalGlobe.setWeatherSnapshot", weather is null ? null : new
                {
                    currentTemperatureFahrenheit = weather.CurrentTemperatureFahrenheit,
                    currentConditions = weather.CurrentConditions,
                    forecastTemperatureFahrenheit = weather.ForecastTemperatureFahrenheit,
                    shortForecast = weather.ShortForecast,
                    detailedForecast = weather.DetailedForecast,
                    windSpeed = weather.WindSpeed,
                    windDirection = weather.WindDirection,
                    chanceOfPrecipitationPercent = weather.ChanceOfPrecipitationPercent
                });
            }),
            _hazardsOn ? TimedAsync("hazards", PushHazardsAsync) : Task.CompletedTask,
            _radarOn ? TimedAsync("radar", () => PushRadarAsync(centerLatitude, centerLongitude)) : Task.CompletedTask,
            _signsOn ? TimedAsync("signs", PushSignsAsync) : Task.CompletedTask,
            _roadWeatherOn ? TimedAsync("road temps", PushRoadWeatherAsync) : Task.CompletedTask,
            _aircraftOn || _airQualityOn ? TimedAsync("air", PushAirLayersAsync) : Task.CompletedTask,
            _shipsOn ? TimedAsync("ships", PushShipsAsync) : Task.CompletedTask,
            _outagesOn ? TimedAsync("power outages", PushOutagesAsync) : Task.CompletedTask,
            _cityTrafficOn ? TimedAsync("city traffic", PushCityTrafficAsync) : Task.CompletedTask);
        if (Current()) StateHasChanged();
    }

    // Runs one layer's load-and-draw; logs it when slow, and keeps one layer's failure from
    // stopping the others (they all run side by side).
    private async Task TimedAsync(string layer, Func<Task> load)
    {
        var started = System.Diagnostics.Stopwatch.GetTimestamp();
        try
        {
            await load();
        }
        catch (Exception ex) when (ex is not OperationCanceledException and not JSDisconnectedException)
        {
            Logger.LogWarning(ex, "Overwatch layer {Layer} failed", layer);
        }
        var elapsed = System.Diagnostics.Stopwatch.GetElapsedTime(started);
        if (elapsed > SlowLayer) Logger.LogInformation("Overwatch layer {Layer} took {Seconds:0.0} s", layer, elapsed.TotalSeconds);
    }

    // Bound to both the RADAR button and tactical-globe.js's "R" keydown shortcut (which
    // synthesizes a click on the same button rather than duplicating this logic in JS).
    private async Task ToggleRadarAsync()
    {
        _radarOn = !_radarOn;
        if (_radarOn && _lastBbox is { } bbox)
        {
            await PushRadarAsync((bbox.North + bbox.South) / 2.0, (bbox.East + bbox.West) / 2.0);
        }
