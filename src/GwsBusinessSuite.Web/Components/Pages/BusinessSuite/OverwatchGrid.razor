    private async Task PickStopOnMapAsync(int index)
    {
        if (_pickingStop == index)
        {
            await CancelPickAsync();
            return;
        }
        _streetPicking = false;
        _pickingStop = index;
        await JS.InvokeVoidAsync("tacticalGlobe.startPickPoint", "tg-viewport");
