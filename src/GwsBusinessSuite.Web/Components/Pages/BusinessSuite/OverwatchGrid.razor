    // Each lookup counts against TomTom's daily allowance, so this runs only when asked.
    private async Task CheckBusiestLiveAsync()
    {
        if (_roadSummary is not { } summary) return;
        _checkingBusiestLive = true;
        try
        {
            var roads = summary.Busiest;
            var flows = await Task.WhenAll(roads.Select(r => TomTom.GetFlowAtAsync(r.Latitude, r.Longitude)));
            if (!ReferenceEquals(summary, _roadSummary)) return;
            _busiestLive = roads.Zip(flows).ToDictionary(p => p.First.Label, p => p.Second);
        }
        finally
        {
            _checkingBusiestLive = false;
        }
    }

