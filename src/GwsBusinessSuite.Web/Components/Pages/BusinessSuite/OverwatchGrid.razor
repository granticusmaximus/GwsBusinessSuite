    // Split from PushIncidentsAsync for the same reason as ApplyAlertsAsync above - lets
    // OnGlobeViewChanged fetch incidents in parallel with cameras/alerts/weather.
    private List<TrafficIncident> _lastIncidents = new();
    private readonly HashSet<string> _hiddenIncidentCategories = new();

    private async Task ToggleIncidentCategoryAsync(string category)
    {
        if (!_hiddenIncidentCategories.Remove(category)) _hiddenIncidentCategories.Add(category);
        await ApplyIncidentsAsync(_lastIncidents);
    }

    private async Task ApplyIncidentsAsync(IReadOnlyList<TrafficIncident> incidents)
    {
        _lastIncidents = incidents.ToList();
        var payload = incidents.Where(i => !_hiddenIncidentCategories.Contains(i.Category)).Select(i => new
        {
            id = i.Id,
            roadwayName = i.RoadwayName,
            description = i.Description,
            eventType = i.EventType,
            severity = i.Severity,
            category = i.Category,
            categoryLabel = IncidentCategories.Label(i.Category),
            severityLevel = i.SeverityLevel,
            lanes = i.Lanes,
            endsAt = i.EndsAt?.ToLocalTime().ToString("dd-MM-yy HH:mm", System.Globalization.CultureInfo.InvariantCulture),
            lat = i.Latitude,
            lon = i.Longitude,
            sourceName = i.SourceName,
            sourceAttributionUrl = i.SourceAttributionUrl
        }).ToList();
        await JS.InvokeVoidAsync("tacticalGlobe.setTrafficIncidents", payload);
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        // The prerendered instance never initializes the browser viewport.
        if (_dotNetRef is null) return;
        try
        {
            await JS.InvokeVoidAsync("tacticalGlobe.dispose", "tg-viewport");
        }
        catch (JSDisconnectedException)
        {
        }
        _dotNetRef?.Dispose();
        if (_localModels is not null) await _localModels.DisposeAsync();
    }
