    public Task OnMapPointPicked(double latitude, double longitude)
    {
        if (_streetPicking)
        {
            _streetPicking = false;
            return ShowStreetViewAsync(latitude, longitude);
        }
        if (_pickingStop is { } index && index < _routeStops.Count)
        {
            _routeStops[index] = string.Create(System.Globalization.CultureInfo.InvariantCulture, $"{latitude:0.#####}, {longitude:0.#####}");
        }
        _pickingStop = null;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task WatchRouteAsync()
    {
        _routeBusy = true;
        await CancelPickAsync();
        var stops = _routeStops.Where(s => !string.IsNullOrWhiteSpace(s)).ToList();
        try
        {
            _route = await RouteWatchService.WatchTripAsync(stops);
            if (_route.Error is null)
            {
                await JS.InvokeVoidAsync("tacticalGlobe.setRoute",
                    _route.Path.Select(p => new[] { p.Longitude, p.Latitude }).ToList(), "tg-viewport",
                    (_route.Stops ?? []).Select(st => new { lat = st.Latitude, lon = st.Longitude }).ToList());
            }
            await UpdateDrivingLightAsync();
            _conditionResults.Clear();
            if (_route.Error is null) await LoadVisionModelsAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "Route watch failed");
            _route = GwsBusinessSuite.Application.RouteWatch.RouteWatchResult.Failed(stops.FirstOrDefault() ?? "", stops.LastOrDefault() ?? "", "Route watch failed. Try again in a moment.");
        }
        finally
        {
            _routeBusy = false;
        }
    }

    private async Task SaveTripAsync()
    {
        _tripMessage = null;
        try
        {
            var saved = await OverwatchTripService.SaveAsync(_username, _tripName, _routeStops);
            _tripMessage = $"Saved \"{saved.Name}\".";
            _tripName = string.Empty;
            _trips = (await OverwatchTripService.ListAsync(_username)).ToList();
        }
        catch (ArgumentException ex)
        {
            _tripMessage = ex.Message;
        }
    }

    private async Task PlotTripAsync(GwsBusinessSuite.Infrastructure.Services.OverwatchTripView trip)
    {
        _routeStops.Clear();
        _routeStops.AddRange(trip.Stops);
        while (_routeStops.Count < 2) _routeStops.Add(string.Empty);
        _tripName = trip.Name;
        _panelTab = _lastPanelTab = "directions";
        await WatchRouteAsync();
    }

    private async Task DeleteTripAsync(GwsBusinessSuite.Infrastructure.Services.OverwatchTripView trip)
    {
        await OverwatchTripService.DeleteAsync(_username, trip.Id);
        _trips = (await OverwatchTripService.ListAsync(_username)).ToList();
        _tripMessage = $"Deleted \"{trip.Name}\".";
    }

