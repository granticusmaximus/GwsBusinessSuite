    // ---- Time machine (TimeMachineService): the past 24 hours, 10 minutes at a time ----
    private const int TimeMachineSteps = 144;
    private bool _timeMachineOn;
    private int _tmMinutesAgo = 60;
    private bool _tmBusy;
    private bool _tmPlaying;
    private CancellationTokenSource? _tmPlay;
    private DateTimeOffset _tmNow = DateTimeOffset.UtcNow;
    private GwsBusinessSuite.Infrastructure.Services.TimeMachineSnapshot? _timeMachine;
    private (bool Radar, bool Incidents, bool Hazards) _tmSavedLayers;

    private DateTimeOffset TimeMachineAt => _tmNow.AddMinutes(-_tmMinutesAgo);

    private async Task ToggleTimeMachineAsync()
    {
        if (!_timeMachineOn)
        {
            // Live layers off while looking at the past, so the two never mix; restored on LIVE.
            _tmSavedLayers = (_radarOn, _incidentsOn, _hazardsOn);
            if (_radarOn) await ToggleRadarAsync();
            if (_incidentsOn) await ToggleIncidentsAsync();
            if (_hazardsOn) await ToggleHazardsAsync();
            _timeMachineOn = true;
            _tmNow = DateTimeOffset.UtcNow;
            _tmMinutesAgo = 60;
            await LoadTimeMachineAsync();
            return;
        }
        StopTimeMachinePlay();
        _timeMachineOn = false;
        _timeMachine = null;
        await JS.InvokeVoidAsync("tacticalGlobe.clearTimeMachine", "tg-viewport");
        if (_tmSavedLayers.Radar && !_radarOn) await ToggleRadarAsync();
        if (_tmSavedLayers.Incidents && !_incidentsOn) await ToggleIncidentsAsync();
        if (_tmSavedLayers.Hazards && !_hazardsOn) await ToggleHazardsAsync();
    }

    private void OnTimeMachineSliding(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var step)) _tmMinutesAgo = (TimeMachineSteps - Math.Clamp(step, 0, TimeMachineSteps)) * 10;
    }

    private async Task OnTimeMachineChangedAsync(ChangeEventArgs args)
    {
        OnTimeMachineSliding(args);
        StopTimeMachinePlay();
        await LoadTimeMachineAsync();
    }

    private async Task LoadTimeMachineAsync()
    {
        if (!_timeMachineOn) return;
        _tmBusy = true;
        try
        {
            var snapshot = await TimeMachine.GetAsync(_username, _lastBbox, TimeMachineAt);
            _timeMachine = snapshot;
            await JS.InvokeVoidAsync("tacticalGlobe.setTimeMachine", "tg-viewport", new
            {
                radarTileUrl = snapshot.RadarTileUrl,
                incidents = snapshot.Incidents.Select(i => new
                {
                    lat = i.Latitude, lon = i.Longitude, category = i.Category,
                    title = $"{GwsBusinessSuite.Application.TrafficIncidents.IncidentCategories.Label(i.Category)}: {i.RoadwayName}"
                }),
                earthquakes = snapshot.Earthquakes.Select(q => new { lat = q.Latitude, lon = q.Longitude, title = q.Title })
            });
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "Time machine failed to load");
        }
        finally
        {
            _tmBusy = false;
        }
    }

    // ---- Briefings (OverwatchBriefingService): the server gathers numbered facts, and the model
    // on this computer's Ollama writes them up citing [n]. Without Ollama the plain summary shows. ----
    private static readonly TimeSpan BriefingTimeout = TimeSpan.FromMinutes(2);
    private GwsBusinessSuite.Application.Briefings.BriefingFacts? _briefFacts;
    private GwsBusinessSuite.Application.Briefings.BriefingText? _briefText;
    private GwsBusinessSuite.Domain.Entities.OverwatchAreaAlert? _morningBrief;
    private List<string> _briefModels = new();
    private string _briefModel = string.Empty;
    private string _briefDraft = string.Empty;
    private string? _briefError;
    private bool _briefBusy;
    private bool _briefFailed;
    private CancellationTokenSource? _briefCts;
    private bool _morningEnabled;
    private int _morningHour = 7;
    private string _morningEmail = string.Empty;
    private string? _morningMessage;
    private bool _morningBusy;

    private Task BriefViewAsync() =>
        BriefAsync(() => Briefings.GetViewFactsAsync(_username, "this view", _lastBbox));

    private Task BriefAreaAsync(GwsBusinessSuite.Infrastructure.Services.OverwatchAreaView area) =>
        BriefAsync(async () =>
        {
            await GoToAreaAsync(area);
            return await Briefings.GetViewFactsAsync(_username, area.Name, area.Bounds);
        });

    private Task BriefRouteAsync(GwsBusinessSuite.Application.RouteWatch.RouteWatchResult route) =>
        BriefAsync(() => Briefings.GetRouteFactsAsync(_username, $"{route.From} to {route.To}", route));

    private async Task BriefAsync(Func<Task<GwsBusinessSuite.Application.Briefings.BriefingFacts>> gather)
    {
        CloseBriefing();
        _briefBusy = true;
        _briefError = null;
        try
        {
            _briefFacts = await gather();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "Briefing facts failed");
            _briefBusy = false;
            _briefFacts = new("this view", DateTimeOffset.UtcNow, []);
            _briefFailed = true;
            _briefError = "Couldn't gather what's happening here just now. Try again in a minute.";
            return;
        }
        StateHasChanged();
        await LoadBriefModelsAsync();
        if (_briefModels.Count == 0)
        {
            _briefBusy = false;
            return;
        }
        await WriteBriefingAsync();
    }

    private async Task LoadBriefModelsAsync()
    {
        if (_briefModels.Count > 0) return;
        try
        {
            _localModels ??= new GwsBusinessSuite.Web.Services.BrowserLocalOllamaService(JS);
            var status = await _localModels.ProbeAsync();
            if (!status.IsReachable)
            {
                _briefError = (status.Error ?? "Ollama isn't reachable on this computer.") + " Showing the plain summary instead.";
                return;
            }
            // Embedding models can't write text.
            _briefModels = status.Models.Where(m => !m.Contains("embed", StringComparison.OrdinalIgnoreCase))
                .OrderBy(m => m, StringComparer.OrdinalIgnoreCase).ToList();
            _briefModel = _briefModels.FirstOrDefault(m => m.StartsWith("gemma", StringComparison.OrdinalIgnoreCase)) ?? _briefModels.FirstOrDefault() ?? string.Empty;
            if (_briefModels.Count == 0) _briefError = "No models are installed in this computer's Ollama. Showing the plain summary instead.";
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "Couldn't list local Ollama models for a briefing");
            _briefError = "Couldn't reach Ollama on this computer. Showing the plain summary instead.";
        }
    }

    private async Task WriteBriefingAsync()
    {
        if (_briefFacts is not { } facts || _localModels is null || string.IsNullOrWhiteSpace(_briefModel)) return;
        _briefCts?.Cancel();
        var cts = _briefCts = new CancellationTokenSource(BriefingTimeout);
        _briefBusy = true;
        _briefError = null;
        _briefText = null;
        _briefDraft = string.Empty;
        var lastPaint = DateTime.UtcNow;
        try
        {
            await foreach (var chunk in _localModels.GenerateStreamAsync(_briefModel,
                               GwsBusinessSuite.Application.Briefings.OverwatchBriefing.SystemPrompt,
                               GwsBusinessSuite.Application.Briefings.OverwatchBriefing.UserPrompt(facts), cts.Token))
            {
                _briefDraft += chunk;
                if (DateTime.UtcNow - lastPaint > TimeSpan.FromMilliseconds(250))
                {
                    lastPaint = DateTime.UtcNow;
                    StateHasChanged();
                }
            }
            if (_briefCts == cts) _briefText = GwsBusinessSuite.Application.Briefings.OverwatchBriefing.Clean(_briefDraft, facts);
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            if (_briefCts == cts && _briefFacts is not null) _briefError = "The model took too long. Showing the plain summary instead.";
        }
        catch (InvalidOperationException ex)
        {
            // The relay's own failures are already worded for the person reading them.
            _briefError = ex.Message;
        }
        finally
        {
            if (_briefCts == cts) _briefBusy = false;
        }
    }

    private void CloseBriefing()
    {
        _briefCts?.Cancel();
        _briefCts = null;
        _briefFacts = null;
        _briefText = null;
        _briefDraft = string.Empty;
        _briefError = null;
        _briefBusy = false;
        _briefFailed = false;
        _morningBrief = null;
    }

    private async Task SaveMorningBriefingAsync()
    {
        _morningBusy = true;
        try
        {
            await Briefings.SaveSettingsAsync(_username, _morningEnabled, _morningHour, _morningEmail);
            _morningMessage = _morningEnabled
                ? $"Saved. Your briefing comes daily at {_morningHour:00}:00{(_morningEmail.Trim().Length > 0 ? (Briefings.CanEmail() ? " by bell and email" : " to the bell (email once SMTP is set up)") : " to the bell")}."
                : "Saved. The morning briefing is off.";
        }
        catch (ArgumentException ex)
        {
            _morningMessage = ex.Message;
        }
        finally
        {
            _morningBusy = false;
        }
    }

    // ---- Drive mode: DriveGuide does the route maths; tactical-globe.js watches the GPS and speaks. ----
    private static readonly TimeSpan DriveIncidentCheck = TimeSpan.FromMinutes(5);
    private GwsBusinessSuite.Application.RouteWatch.DriveGuide? _drive;
    private GwsBusinessSuite.Application.RouteWatch.DriveState? _driveState;
    private readonly List<GwsBusinessSuite.Application.RouteWatch.RouteIncident> _driveClosures = new();
    private (double Latitude, double Longitude)? _driveHere;
    private double? _driveSpeedMph;
    private bool _driveVoice = true;
    private bool _driveBusy;
    private string? _driveMessage;
    private long _driveCameraTick;
    private CancellationTokenSource? _driveCts;

    private async Task StartDriveAsync(GwsBusinessSuite.Application.RouteWatch.RouteWatchResult route)
    {
        await EndDriveAsync();
        _drive = new GwsBusinessSuite.Application.RouteWatch.DriveGuide(route);
        _driveMessage = null;
        var started = await JS.InvokeAsync<string>("tacticalGlobe.startDrive", "tg-viewport");
        if (started != "started")
        {
            _drive = null;
            _directionsMessage = "Drive mode needs this device's location, which this browser doesn't offer.";
            return;
        }
        var cts = _driveCts = new CancellationTokenSource();
        _ = WatchDriveIncidentsAsync(cts.Token);
    }

    [JSInvokable]
    public Task OnDrivePosition(double latitude, double longitude, double? accuracyMeters, double? speedMetersPerSecond) =>
        InvokeAsync(async () =>
        {
            if (_drive is not { } guide) return;
            _driveHere = (latitude, longitude);
            _driveSpeedMph = speedMetersPerSecond is { } mps && mps >= 0 ? mps * 2.23694 : null;
            _driveCameraTick = DateTimeOffset.UtcNow.ToUnixTimeSeconds() / 30;
            var update = guide.Update(new GwsBusinessSuite.Application.RouteWatch.DriveFix(latitude, longitude, accuracyMeters, speedMetersPerSecond));
            _driveState = update.State;
            if (_driveMessage is not null && _driveMessage.StartsWith("Location", StringComparison.Ordinal)) _driveMessage = null;
            foreach (var line in update.Announcements) await SpeakAsync(line);
            StateHasChanged();
        });

    [JSInvokable]
    public Task OnDriveError(string message) =>
        InvokeAsync(() =>
        {
            _driveMessage = message;
            StateHasChanged();
        });

    // Every few minutes: closures that appeared on the road ahead since the route was planned.
    private async Task WatchDriveIncidentsAsync(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(DriveIncidentCheck, ct);
                if (_drive is not { } guide) return;
                IReadOnlyList<TrafficIncident> fresh;
                try
                {
                    fresh = await TrafficIncidentDirectoryService.GetIncidentsInBoundingBoxAsync(guide.RemainingBounds(), ct);
                }
                catch (Exception ex) when (ex is not OperationCanceledException)
                {
                    Logger.LogWarning(ex, "Drive mode incident check failed");
                    continue;
                }
                await InvokeAsync(async () =>
                {
                    if (!ReferenceEquals(_drive, guide)) return;
                    var added = guide.AddFreshIncidents(fresh);
                    _driveClosures.AddRange(added);
                    foreach (var closure in added)
                    {
                        await SpeakAsync($"New closure reported {GwsBusinessSuite.Application.RouteWatch.DriveGuide.MilesText(closure.MilesAlong - (_driveState?.MilesAlong ?? 0))} ahead on {closure.Incident.RoadwayName}. Press reroute to go around it.");
                    }
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task RerouteAroundAsync(GwsBusinessSuite.Application.RouteWatch.RouteIncident closure)
    {
        if (_drive is not { } guide || _driveHere is not { } here) return;
        var ahead = guide.StopsAhead();
        if (ahead.Count == 0) return;
        _driveBusy = true;
        try
        {
            var via = await RouteWatchService.FindDetourViaAsync(new(here.Latitude, here.Longitude), new(ahead[0].Latitude, ahead[0].Longitude),
                new(closure.Incident.Latitude, closure.Incident.Longitude));
            if (via is null)
            {
                _driveMessage = "The router found no way around that closure. Check the cameras near it, or replan later.";
                return;
            }
            await ReplanDriveAsync([Coordinates(here.Latitude, here.Longitude), Coordinates(via.Latitude, via.Longitude), .. ahead.Select(s => s.Label)],
                "New route around the closure.");
        }
        finally
        {
            _driveBusy = false;
        }
    }

    private async Task ReplanFromHereAsync()
    {
        if (_drive is not { } guide || _driveHere is not { } here) return;
        _driveBusy = true;
        try
        {
            await ReplanDriveAsync([Coordinates(here.Latitude, here.Longitude), .. guide.StopsAhead().Select(s => s.Label)], "Route updated from here.");
        }
        finally
        {
            _driveBusy = false;
        }
    }

    private async Task ReplanDriveAsync(IReadOnlyList<string> stops, string spoken)
    {
        _routeStops.Clear();
        _routeStops.AddRange(stops);
        await WatchRouteAsync();
        if (_route is { Error: null } route)
        {
            _drive = new GwsBusinessSuite.Application.RouteWatch.DriveGuide(route);
            _driveState = null;
            _driveClosures.Clear();
            _driveMessage = null;
            await SpeakAsync(spoken);
            if (_driveHere is { } here) await OnDrivePosition(here.Latitude, here.Longitude, null, null);
        }
        else
        {
            _driveMessage = _route?.Error ?? "Couldn't replan just now.";
        }
    }

    private async Task RecenterDriveAsync()
    {
        await JS.InvokeVoidAsync("tacticalGlobe.setDriveFollow", "tg-viewport", true);
        if (_driveHere is { } here) await FlyToPointAsync(here.Latitude, here.Longitude);
    }

    private async Task EndDriveAsync()
    {
        _driveCts?.Cancel();
        _driveCts = null;
        if (_drive is not null) await JS.InvokeVoidAsync("tacticalGlobe.stopDrive", "tg-viewport");
        _drive = null;
        _driveState = null;
        _driveClosures.Clear();
        _driveHere = null;
        _driveSpeedMph = null;
        _driveMessage = null;
    }

    private async Task SpeakAsync(string text)
    {
        if (_driveVoice) await JS.InvokeAsync<bool>("tacticalGlobe.speak", text);
    }

    private static string Coordinates(double latitude, double longitude) =>
        string.Create(System.Globalization.CultureInfo.InvariantCulture, $"{latitude:0.#####}, {longitude:0.#####}");

    private static string DriveDistance(double miles) =>
        miles < 0.2 ? $"{Math.Max(0, miles * 5280):0} FT" : $"{miles:0.0} MI";

    // Still-image cameras refresh about every 30 seconds while driving.
    private string DriveCameraUrl(CameraFeed camera) =>
        camera.StreamUrl + (camera.StreamUrl.Contains('?') ? "&" : "?") + "_t=" + _driveCameraTick;

    // ---- Map notes (MapNoteService): pins and drawn areas, drawn on the globe by setMapNotes. ----
    private sealed class NoteDraft
    {
        public Guid? Id { get; init; }
        public required string Kind { get; init; }
        public string Title { get; set; } = string.Empty;
        public string Body { get; set; } = string.Empty;
        public string Color { get; set; } = GwsBusinessSuite.Infrastructure.Services.MapNoteService.Colors[0];
        public List<GwsBusinessSuite.Infrastructure.Services.MapNotePoint> Points { get; init; } = new();
        public bool Picking { get; set; }
    }

    private List<GwsBusinessSuite.Infrastructure.Services.MapNoteView> _notes = new();
    private GwsBusinessSuite.Infrastructure.Services.MapNoteView? _openNote;
    // A note someone else shared with this user via a link: shown on the map while this page is open.
    private GwsBusinessSuite.Infrastructure.Services.MapNoteView? _sharedNote;
    private NoteDraft? _noteDraft;
    private string? _noteMessage;

    private async Task PushNotesAsync()
    {
        var shown = _notes.Where(n => _noteDraft?.Id != n.Id).ToList();
        if (_sharedNote is { } shared && shown.All(n => n.Id != shared.Id)) shown.Add(shared);
        await JS.InvokeVoidAsync("tacticalGlobe.setMapNotes", "tg-viewport",
            shown.Select(n => new { id = n.Id, kind = n.Kind, title = n.Title, color = n.Color, points = n.Points.Select(p => new[] { p.Latitude, p.Longitude }) }),
            _noteDraft is { } draft ? new { points = draft.Points.Select(p => new[] { p.Latitude, p.Longitude }), color = draft.Color } : null);
    }

    private async Task StartNoteAsync(string kind)
    {
        await CancelPickAsync();
        _noteMessage = null;
        _noteDraft = new NoteDraft { Kind = kind, Picking = true };
        await JS.InvokeVoidAsync("tacticalGlobe.startPickPoint", "tg-viewport");
    }

    private async Task AddNotePointAsync(NoteDraft draft, double latitude, double longitude)
    {
        if (draft.Kind == GwsBusinessSuite.Infrastructure.Services.MapNoteKinds.Pin)
        {
            draft.Points.Clear();
            draft.Points.Add(new(latitude, longitude));
            draft.Picking = false;
        }
        else if (draft.Points.Count < GwsBusinessSuite.Infrastructure.Services.MapNoteService.MaxAreaPoints)
        {
            draft.Points.Add(new(latitude, longitude));
            // Keep listening for the next corner until SAVE or CANCEL.
            await JS.InvokeVoidAsync("tacticalGlobe.startPickPoint", "tg-viewport");
        }
        await PushNotesAsync();
        StateHasChanged();
    }

    private async Task RestartNotePickAsync()
    {
        if (_noteDraft is not { } draft) return;
        draft.Picking = true;
        await JS.InvokeVoidAsync("tacticalGlobe.startPickPoint", "tg-viewport");
    }

    private async Task UndoNotePointAsync()
    {
        if (_noteDraft is not { Points.Count: > 0 } draft) return;
        draft.Points.RemoveAt(draft.Points.Count - 1);
        await PushNotesAsync();
    }

    private async Task SetNoteColorAsync(string colour)
    {
        if (_noteDraft is not { } draft) return;
        draft.Color = colour;
        await PushNotesAsync();
    }

    private async Task SaveNoteAsync()
    {
        if (_noteDraft is not { } draft) return;
        try
        {
            var saved = await MapNotes.SaveAsync(_username, draft.Id, draft.Kind, draft.Title, draft.Body, draft.Color, draft.Points);
            await JS.InvokeVoidAsync("tacticalGlobe.cancelPickPoint", "tg-viewport");
            _noteDraft = null;
            _notes = (await MapNotes.ListAsync(_username)).ToList();
            _noteMessage = $"Saved \"{saved.Title}\".";
            if (_openNote?.Id == saved.Id) _openNote = saved;
            await PushNotesAsync();
        }
        catch (ArgumentException ex)
        {
            _noteMessage = ex.Message;
        }
    }

    private async Task CancelNoteAsync()
    {
        _noteDraft = null;
        _noteMessage = null;
        await JS.InvokeVoidAsync("tacticalGlobe.cancelPickPoint", "tg-viewport");
        await PushNotesAsync();
    }

    private async Task EditNoteAsync(GwsBusinessSuite.Infrastructure.Services.MapNoteView note)
    {
        await CancelPickAsync();
        _openNote = null;
        _noteMessage = null;
        _noteDraft = new NoteDraft
        {
            Id = note.Id, Kind = note.Kind, Title = note.Title, Body = note.Body, Color = note.Color, Points = note.Points.ToList()
        };
        _panelTab = _lastPanelTab = "saved";
        await PushNotesAsync();
    }

    private async Task DeleteNoteAsync(GwsBusinessSuite.Infrastructure.Services.MapNoteView note)
    {
        await MapNotes.DeleteAsync(_username, note.Id);
        _notes = (await MapNotes.ListAsync(_username)).ToList();
        if (_openNote?.Id == note.Id) _openNote = null;
        _noteMessage = $"Deleted \"{note.Title}\".";
        await PushNotesAsync();
    }

    private async Task OpenNoteAsync(GwsBusinessSuite.Infrastructure.Services.MapNoteView note)
    {
        _noteMessage = null;
        _openNote = note;
        await FlyToNoteAsync(note);
    }

    private async Task FlyToNoteAsync(GwsBusinessSuite.Infrastructure.Services.MapNoteView note)
    {
        if (note.Points.Count == 0) return;
        if (note.Points.Count == 1)
        {
            await FlyToPointAsync(note.Points[0].Latitude, note.Points[0].Longitude);
            return;
        }
        var pad = 0.005;
        await JS.InvokeVoidAsync("tacticalGlobe.flyToBounds", "tg-viewport",
            note.Points.Min(p => p.Longitude) - pad, note.Points.Min(p => p.Latitude) - pad,
            note.Points.Max(p => p.Longitude) + pad, note.Points.Max(p => p.Latitude) + pad);
    }

    [JSInvokable]
    public Task OnMapNoteClicked(string id) =>
        InvokeAsync(() =>
        {
            if (!Guid.TryParse(id, out var noteId)) return;
            _openNote = _notes.FirstOrDefault(n => n.Id == noteId) ?? (_sharedNote?.Id == noteId ? _sharedNote : null);
            _noteMessage = null;
            StateHasChanged();
        });

    private async Task ShareNoteAsync(GwsBusinessSuite.Infrastructure.Services.MapNoteView note)
    {
        var key = await MapNotes.ShareAsync(_username, note.Id);
        if (key is null) return;
        var link = Navigation.ToAbsoluteUri(GwsBusinessSuite.Infrastructure.Services.MapNoteService.ShareLink(note.Id, key)).ToString();
        var result = await JS.InvokeAsync<string>("tacticalGlobe.shareText", (string?)null, link, (string?)null);
        _notes = (await MapNotes.ListAsync(_username)).ToList();
        _openNote = _notes.FirstOrDefault(n => n.Id == note.Id);
        _noteMessage = result == "copied"
            ? "Link copied. Any signed-in admin with it can open this note (read-only)."
            : $"Copy this link: {link}";
    }

    private async Task UnshareNoteAsync(GwsBusinessSuite.Infrastructure.Services.MapNoteView note)
    {
        await MapNotes.UnshareAsync(_username, note.Id);
        _notes = (await MapNotes.ListAsync(_username)).ToList();
        _openNote = _notes.FirstOrDefault(n => n.Id == note.Id);
        _noteMessage = "Unshared. The old link no longer opens it.";
    }

    // Play: steps forward 10 minutes every 2 seconds until it reaches now.
    private async Task ToggleTimeMachinePlayAsync()
    {
        if (_tmPlaying)
        {
            StopTimeMachinePlay();
            return;
        }
        if (_tmMinutesAgo == 0) _tmMinutesAgo = 24 * 60;
        _tmPlaying = true;
        var play = _tmPlay = new CancellationTokenSource();
        try
        {
            while (!play.IsCancellationRequested && _tmMinutesAgo > 0)
            {
                await LoadTimeMachineAsync();
                StateHasChanged();
                await Task.Delay(TimeSpan.FromSeconds(2), play.Token);
                _tmMinutesAgo = Math.Max(0, _tmMinutesAgo - 10);
            }
            if (!play.IsCancellationRequested) await LoadTimeMachineAsync();
        }
        catch (TaskCanceledException) { }
        finally
        {
            if (_tmPlay == play) { _tmPlaying = false; _tmPlay = null; }
            StateHasChanged();
        }
    }

    private void StopTimeMachinePlay()
    {
        _tmPlay?.Cancel();
        _tmPlay = null;
        _tmPlaying = false;
    }

    private Task FlyToPointAsync(double latitude, double longitude) =>
        JS.InvokeVoidAsync("tacticalGlobe.flyTo", "tg-viewport", latitude, longitude, 4000, 1.5).AsTask();

    private string? _directionsMessage;

    private async Task CopyDirectionsAsync(GwsBusinessSuite.Application.RouteWatch.RouteWatchResult route)
    {
        var text = GwsBusinessSuite.Application.RouteWatch.RouteDirectionsText.Format(route, DateTimeOffset.Now)
            + "\n\n" + Navigation.ToAbsoluteUri(GwsBusinessSuite.Application.RouteWatch.RouteDirectionsText.OverwatchLink(_routeStops));
        _directionsMessage = await JS.InvokeAsync<string>("tacticalGlobe.shareText", null, text, null) == "copied"
            ? "Directions copied."
            : "Couldn't copy - your browser blocked it.";
    }

    // The device's share sheet where the browser has one (Safari, phones); otherwise copies.
    private async Task ShareDirectionsAsync(GwsBusinessSuite.Application.RouteWatch.RouteWatchResult route)
    {
        var url = Navigation.ToAbsoluteUri(GwsBusinessSuite.Application.RouteWatch.RouteDirectionsText.OverwatchLink(_routeStops)).ToString();
        var text = GwsBusinessSuite.Application.RouteWatch.RouteDirectionsText.Format(route, DateTimeOffset.Now);
        var result = await JS.InvokeAsync<string>("tacticalGlobe.shareText", $"Directions: {route.From} to {route.To}", text, url);
        _directionsMessage = result switch
        {
            "shared" => null,
            "copied" => "Sharing isn't available in this browser - directions and link copied instead.",
            "cancelled" => null,
            _ => "Couldn't share - your browser blocked it."
