    // Live speed per busiest road (by label); null means TomTom had no reading there.
    private Dictionary<string, GwsBusinessSuite.Application.RoadTraffic.LiveRoadFlow?> _busiestLive = [];

    private async Task ToggleLiveFlowAsync()
