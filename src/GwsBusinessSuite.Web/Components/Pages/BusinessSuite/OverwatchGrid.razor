    // Called from the stream panel's favorite-star button (tactical-globe.js threads the current
    // camera payload through). Returns the new favorite state so the star's visual can update
    // without a second round-trip.
    [JSInvokable]
    public async Task<bool> ToggleCameraFavoriteAsync(
        string cameraId, string name, double lat, double lon, string streamUrl, string streamKind,
        string sourceName, string sourceAttributionUrl)
    {
        var wasFavorite = _favoriteCameraIds.Contains(cameraId);
        if (wasFavorite)
        {
            await CameraFavoritesService.RemoveFavoriteAsync(_username, cameraId);
            _favoriteCameraIds.Remove(cameraId);
        }
        else
        {
            var camera = new CameraFeed(cameraId, name, lat, lon, streamUrl,
                Enum.Parse<CameraStreamKind>(streamKind), sourceName, sourceAttributionUrl);
            await CameraFavoritesService.AddFavoriteAsync(_username, camera);
            _favoriteCameraIds.Add(cameraId);
        }
        _favorites = (await CameraFavoritesService.GetFavoritesAsync(_username)).ToList();
        StateHasChanged();
        return !wasFavorite;
    }

