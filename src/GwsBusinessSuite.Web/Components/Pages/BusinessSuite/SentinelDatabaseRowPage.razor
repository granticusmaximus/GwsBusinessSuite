@implements IAsyncDisposable
@using System.Text.Json.Nodes
@using GwsBusinessSuite.Application.Wiki
@using GwsBusinessSuite.Application.CmsBuilder
@using GwsBusinessSuite.Domain.Entities
@inject IWikiDatabaseService WikiDatabaseService
@inject INotionSyncService NotionSyncService
@inject IWikiService WikiService
@inject ISentinelWorkspaceService SentinelWorkspaceService
@inject IMediaLibraryService MediaLibraryService
@inject ICurrentUserAccessor CurrentUserAccessor
@inject IJSRuntime JS
@inject ILogger<SentinelDatabaseRowPage> Logger

<div class="@($"sentinel-row-page-host {OpenModeClass}")" role="dialog" aria-modal="true" aria-label="@($"{RowTitle} database page")">
    @if (ResolvedOpenMode != WikiDatabaseOpenPageModes.FullPage)
    {
        <button type="button" class="sentinel-row-page-backdrop" aria-label="Close database page" @onclick="CloseAsync"></button>
    }

    <section class="sentinel-row-page-panel">
        <header class="sentinel-row-page-header">
            <div class="min-w-0">
                <div class="small text-secondary text-truncate">@(Database.Icon ?? "🗄️") @Database.Title</div>
                <h2 class="sentinel-row-page-title text-truncate">@RowTitle</h2>
            </div>
            <div class="sentinel-row-page-header-actions">
                <span class="sentinel-row-page-mode-label">@OpenModeLabel</span>
                <button type="button" class="btn btn-sm btn-light sentinel-row-page-close" aria-label="Close" @onclick="CloseAsync">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </header>

        <div class="sentinel-row-page-body">
            <div class="sentinel-row-page-content">
                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div class="alert alert-danger">@ErrorMessage</div>
                }

                @if (!string.IsNullOrWhiteSpace(_coverImageUrl))
                {
                    <div class="sentinel-page-cover">
                        <img src="@_coverImageUrl" alt="Row cover" loading="lazy" />
                        <div class="sentinel-page-cover-actions">
                            <button type="button" class="btn btn-sm btn-dark" @onclick="ToggleCoverPickerAsync">
                                <i class="bi bi-image me-1"></i>Change cover
                            </button>
                            <button type="button" class="btn btn-sm btn-dark" @onclick="RemoveCover">
                                <i class="bi bi-trash3 me-1"></i>Remove
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="sentinel-page-affordances">
                        <button type="button" @onclick="ToggleCoverPickerAsync">
                            <i class="bi bi-image"></i>Add cover
                        </button>
                    </div>
                }

                @if (_showCoverPicker)
                {
                    <div class="wiki-media-picker border rounded-3 p-2 mb-3">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <InputFile OnChange="OnCoverFileSelectedAsync" disabled="@_isUploadingCover" class="form-control form-control-sm" accept="image/*" />
                            @if (_isUploadingCover)
                            {
                                <span class="spinner-border spinner-border-sm text-secondary flex-shrink-0"></span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(_mediaPickerError))
                        {
                            <div class="text-danger small mb-0">@_mediaPickerError</div>
                        }
                        else if (_mediaAssets.Count == 0)
                        {
                            <p class="text-secondary small mb-0">No media uploaded yet. Upload an image above.</p>
                        }
                        else
                        {
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var asset in _mediaAssets)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary p-1" title="@asset.FileName"
                                            @onclick="() => SelectCover(asset)">
                                        <img src="@asset.ThumbnailUrl" alt="@asset.AltText" loading="lazy" style="width:64px;height:64px;object-fit:cover;" />
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }

                <div class="sentinel-page-heading">
                    <input class="sentinel-icon-input" @bind="_icon" @bind:after="ScheduleAutosave" placeholder="📄" maxlength="4" aria-label="Row icon" />
                    <span class="sentinel-row-page-title-static text-truncate">@RowTitle</span>
                </div>

                @if (PageProperties.Count > 0)
                {
                    <div class="sentinel-row-page-properties">
                        @foreach (var property in PageProperties)
                        {
                            var display = WikiPropertyValues.GetDisplayText(property, Values, Row.CreatedAt);
                            <div class="sentinel-row-page-property">
                                <div class="sentinel-row-page-property-name">@property.Name</div>
                                <div class="sentinel-row-page-property-value" title="@display">@(string.IsNullOrWhiteSpace(display) ? "—" : display)</div>
                            </div>
                        }
                    </div>
                }

                <div class="sentinel-row-page-editor-heading">
                    <label class="form-label fw-semibold mb-0">Page content</label>
                    <span class="small text-secondary">Type <code>/</code> for blocks and <code>[[</code> for page links</span>
                </div>
                <div class="wiki-block-editor sentinel-row-block-editor" @ref="_editorContainer"></div>

                <details class="sentinel-page-properties mt-3">
                    <summary><i class="bi bi-clock-history"></i><span>History</span><i class="bi bi-chevron-right"></i></summary>
                    <div class="card border-0 sentinel-support-panel">
                        <div class="card-header bg-white border-bottom py-2 d-flex justify-content-between align-items-center gap-3">
                            <div class="small text-secondary">Bounded version snapshots - the last @MaxHistoryDisplay are kept.</div>
                            <span class="badge text-bg-secondary">@History.Count version@(History.Count == 1 ? "" : "s")</span>
                        </div>
                        <div class="card-body p-0">
                            @if (!string.IsNullOrEmpty(HistoryErrorMessage))
                            {
                                <div class="alert alert-danger m-3 mb-0 py-2 small">@HistoryErrorMessage</div>
                            }
                            @if (History.Count == 0)
                            {
                                <div class="p-3">
                                    <p class="text-secondary mb-0 small">No versions yet - saving this page will create the first one.</p>
                                </div>
                            }
                            else
                            {
                                <div class="list-group list-group-flush">
                                    @for (var i = 0; i < History.Count; i++)
                                    {
                                        var revision = History[i];
                                        var previousRevision = i + 1 < History.Count ? History[i + 1] : null;
                                        <div class="list-group-item">
                                            <div class="d-flex justify-content-between align-items-start gap-2">
                                                <div>
                                                    <div class="fw-semibold small">
                                                        <code class="me-1">v@(revision.RevisionNumber)</code>@(string.IsNullOrWhiteSpace(revision.Label) ? "Saved" : revision.Label)
                                                    </div>
                                                    <div class="small text-secondary mt-1">
                                                        @revision.AuthorName &middot; @revision.When.ToLocalTime().ToString("g")
                                                    </div>
                                                </div>
                                                <div class="d-flex gap-1 flex-shrink-0">
                                                    @if (previousRevision is not null)
                                                    {
                                                        <button class="btn btn-xs btn-outline-secondary" @onclick="() => ToggleDiffAsync(revision, previousRevision)">
                                                            Diff
                                                        </button>
                                                    }
                                                    <button class="btn btn-xs btn-outline-primary" @onclick="() => RevertToRevisionAsync(revision.Id)"
                                                            disabled="@IsHistoryBusy">
                                                        Revert
                                                    </button>
                                                </div>
                                            </div>
                                            @if (DiffRevisionKey == revision.Id)
                                            {
                                                <div class="mt-3 border-top pt-3">
                                                    @if (string.IsNullOrEmpty(DiffText))
                                                    {
                                                        <div class="small text-secondary">No block changes between these versions.</div>
                                                    }
                                                    else
                                                    {
                                                        <div class="p-2 rounded-3 border bg-body-tertiary">
                                                            @foreach (var line in DiffText.Split('\n'))
                                                            {
                                                                <div class="@DiffLineClass(line)" style="white-space:pre-wrap;font-family:var(--bs-font-monospace, monospace);font-size:0.8125rem;">@line</div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </details>

                @if (RowMentions.Count > 0)
                {
                    <details class="sentinel-page-properties mt-3" open>
                        <summary><i class="bi bi-link-45deg"></i><span>Mentioned in</span><i class="bi bi-chevron-right"></i></summary>
                        <div class="list-group list-group-flush">
                            @foreach (var mention in RowMentions)
                            {
                                <button type="button" class="list-group-item list-group-item-action py-1 px-2 small" @onclick="() => OpenMentioningPageAsync(mention.SourcePageId)" title="@mention.Preview">
                                    <i class="bi bi-file-earmark-text text-secondary me-1"></i>@mention.SourcePageTitle
                                </button>
                            }
                        </div>
                    </details>
                }
            </div>
        </div>

        <footer class="sentinel-row-page-footer">
            <span class="small text-secondary">@(string.IsNullOrEmpty(_saveStatus) ? "Changes save automatically. Use Save page to record a named version." : _saveStatus)</span>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-outline-secondary" @onclick="CloseAsync" disabled="@IsBusy">Close</button>
                @if (!string.IsNullOrWhiteSpace(Row.NotionId))
                {
                    <button type="button" class="btn btn-warning" @onclick="PushToNotionAsync" disabled="@IsBusy">
                        <i class="bi bi-cloud-arrow-up-fill me-1"></i>Push to Notion
                    </button>
                }
                <button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@IsBusy">
                    <i class="bi bi-floppy-fill me-1"></i>Save page
                </button>
            </div>
        </footer>
    </section>
</div>

@code {
    private const int MaxHistoryDisplay = 20;

    [Parameter, EditorRequired] public required WikiDatabase Database { get; set; }
    [Parameter, EditorRequired] public required WikiDatabaseRow Row { get; set; }
    [Parameter] public string OpenMode { get; set; } = WikiDatabaseOpenPageModes.SidePeek;
    [Parameter] public IReadOnlyList<WikiDatabaseProperty> PageProperties { get; set; } = [];
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<Guid> OnOpenPage { get; set; }

    private ElementReference _editorContainer;
    private IJSObjectReference? _module;
    private DotNetObjectReference<SentinelDatabaseRowPage>? _dotNetRef;
    private bool _initialized;
    private bool IsBusy;
    private string ErrorMessage = string.Empty;
    private string _blocksJson = "[]";
    private string _icon = string.Empty;
    private string _coverImageUrl = string.Empty;
    private string _saveStatus = string.Empty;
    private CancellationTokenSource? _autosaveCts;

    private bool _showCoverPicker;
    private bool _isUploadingCover;
    private string _mediaPickerError = string.Empty;
    private List<MediaAssetSummary> _mediaAssets = new();

    private List<WikiRevisionView> History { get; set; } = new();
    private bool IsHistoryBusy { get; set; }
    private string HistoryErrorMessage { get; set; } = string.Empty;
    private Guid? DiffRevisionKey { get; set; }
    private string? DiffText { get; set; }
    private Guid? _historyLoadedForRowId;
    private Guid? _loadedRowId;
    private List<SentinelBacklink> RowMentions { get; set; } = new();

    private JsonObject Values => WikiPropertyValues.ParseObject(Row.PropertyValuesJson);
    private WikiDatabaseProperty? TitleProperty => Database.Properties.FirstOrDefault(property => property.Type == WikiDatabasePropertyTypes.Title);
    private string RowTitle => TitleProperty is null
        ? "Untitled"
        : WikiPropertyValues.GetText(Values, TitleProperty.Id) is { Length: > 0 } title ? title : "Untitled";
    private string ResolvedOpenMode => WikiDatabaseOpenPageModes.Resolve(OpenMode, string.Empty);
    private string OpenModeClass => ResolvedOpenMode switch
    {
        WikiDatabaseOpenPageModes.CenterPeek => "sentinel-row-page-center",
        WikiDatabaseOpenPageModes.FullPage => "sentinel-row-page-full",
        _ => "sentinel-row-page-side"
    };
    private string OpenModeLabel => ResolvedOpenMode switch
    {
        WikiDatabaseOpenPageModes.CenterPeek => "Center peek",
        WikiDatabaseOpenPageModes.FullPage => "Full page",
        _ => "Side peek"
    };

    protected override void OnParametersSet()
    {
        // Only re-sync local editing state when this parameter set is actually a different
        // row. Now that autosave persists in the background without necessarily refreshing
        // the parent's Row snapshot, blindly resyncing on every parameter set (e.g. a parent
        // re-render triggered by something unrelated to this row) would silently revert
        // whatever the user is mid-typing back to a stale copy.
        if (_loadedRowId == Row.Id) return;
        _loadedRowId = Row.Id;
        _blocksJson = Row.BlocksJson;
        _icon = Row.Icon ?? string.Empty;
        _coverImageUrl = Row.CoverImageUrl ?? string.Empty;
        _saveStatus = string.Empty;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_initialized)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/wiki-block-editor.js?v=5");
            await _module.InvokeVoidAsync("initialize", _editorContainer, _dotNetRef, _blocksJson);
            _initialized = true;
        }

        if (_historyLoadedForRowId != Row.Id)
        {
            _historyLoadedForRowId = Row.Id;
            await LoadHistoryAsync();
            try
            {
                RowMentions = (await SentinelWorkspaceService.GetRowMentionsAsync(Database.Id, Row.Id)).ToList();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Unable to load mentions for Sentinel row {RowId}.", Row.Id);
            }
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task OpenMentioningPageAsync(Guid wikiPageId) => OnOpenPage.InvokeAsync(wikiPageId);

    [JSInvokable]
    public Task OnBlocksChanged(string blocksJson)
    {
        _blocksJson = blocksJson;
        ScheduleAutosave();
        return Task.CompletedTask;
    }

    // Silent background persistence, distinct from the explicit "Save page" button: debounced
    // so a burst of keystrokes/undo-redo becomes one write, and passes
    // CreateRevisionCheckpoint=false so it never mints a version-history entry on its own -
    // only an explicit save (or a revert) does that. This means a browser refresh or a lost
    // Blazor circuit loses at most ~1.5s of edits instead of everything since the page opened.
    private void ScheduleAutosave()
    {
        _autosaveCts?.Cancel();
        _autosaveCts?.Dispose();
        var cts = new CancellationTokenSource();
        _autosaveCts = cts;
        _saveStatus = "Editing…";
        _ = AutosaveAfterDelayAsync(cts.Token);
    }

    private async Task AutosaveAfterDelayAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(1.5), cancellationToken);
        }
        catch (TaskCanceledException)
        {
            return;
        }
        if (cancellationToken.IsCancellationRequested) return;

        try
        {
            var user = await CurrentUserAccessor.GetCurrentUsernameAsync();
            await WikiDatabaseService.SaveRowAsync(Database.Id, new WikiDatabaseRowEditor
            {
                Id = Row.Id,
                BlocksJson = _blocksJson,
                Icon = _icon,
                CoverImageUrl = _coverImageUrl,
                Values = Values.ToDictionary(pair => pair.Key, pair => pair.Value),
                CreateRevisionCheckpoint = false
            }, user, cancellationToken);

            if (cancellationToken.IsCancellationRequested) return;
            _saveStatus = "Saved";
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) when (!cancellationToken.IsCancellationRequested)
        {
            Logger.LogError(ex, "Autosave failed for Sentinel row {RowId}.", Row.Id);
            _saveStatus = "Autosave failed - use Save page to retry";
            await InvokeAsync(StateHasChanged);
        }
    }

    private void RemoveCover()
    {
        _coverImageUrl = string.Empty;
        ScheduleAutosave();
    }

    [JSInvokable]
    public async Task<IReadOnlyList<WikiLinkSuggestion>> SearchWikiLinkSuggestions(string query) =>
        WikiMarkdownHelper.SearchLinkSuggestions(query, await WikiService.ListPagesAsync());

    [JSInvokable]
    public Task NavigateToWikiPageId(string pageId) =>
        Guid.TryParse(pageId, out var id) ? OnOpenPage.InvokeAsync(id) : Task.CompletedTask;

    private async Task ToggleCoverPickerAsync()
    {
        _showCoverPicker = !_showCoverPicker;
        if (!_showCoverPicker)
        {
            return;
        }

        _mediaPickerError = string.Empty;
        try
        {
            _mediaAssets = (await MediaLibraryService.ListAsync()).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to load media library for the Sentinel row cover picker.");
            _mediaPickerError = $"Unable to load media library. {ex.Message}";
        }
    }

    private void SelectCover(MediaAssetSummary asset)
    {
        _coverImageUrl = asset.Url;
        _showCoverPicker = false;
        ScheduleAutosave();
    }

    // Same upload path as the standalone Media Library page (Media.razor.OnFileSelectedAsync)
    // so a row cover no longer requires leaving the row page first.
    private async Task OnCoverFileSelectedAsync(InputFileChangeEventArgs e)
    {
        _mediaPickerError = string.Empty;
        _isUploadingCover = true;
        try
        {
            const long maxBytes = 25 * 1024 * 1024;
            using var stream = e.File.OpenReadStream(maxAllowedSize: maxBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            var uploaded = await MediaLibraryService.UploadAsync(e.File.Name, ms.ToArray(), string.Empty);
            _coverImageUrl = uploaded.Url;
            _mediaAssets = (await MediaLibraryService.ListAsync()).ToList();
            _showCoverPicker = false;
            ScheduleAutosave();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Cover image upload failed for Sentinel row {RowId}.", Row.Id);
            _mediaPickerError = $"Upload failed. {ex.Message}";
        }
        finally
        {
            _isUploadingCover = false;
        }
    }

    private async Task LoadHistoryAsync()
    {
        HistoryErrorMessage = string.Empty;
        try
        {
            History = (await WikiDatabaseService.GetRowHistoryAsync(Row.Id)).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to load Sentinel row history for {RowId}.", Row.Id);
            HistoryErrorMessage = $"Unable to load history. {ex.Message}";
        }
    }

    private async Task ToggleDiffAsync(WikiRevisionView revision, WikiRevisionView previousRevision)
    {
        if (DiffRevisionKey == revision.Id)
        {
            DiffRevisionKey = null;
            DiffText = null;
            return;
        }

        try
        {
            DiffText = await WikiDatabaseService.GetRowStructuralDiffAsync(Row.Id, previousRevision.Id, revision.Id);
            DiffRevisionKey = revision.Id;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to load diff for Sentinel row {RowId} between revisions.", Row.Id);
            HistoryErrorMessage = $"Unable to load diff. {ex.Message}";
        }
    }

    private async Task RevertToRevisionAsync(Guid revisionId)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Revert to this version? This creates a new version with the old content - nothing is lost.");
        if (!confirmed) return;

        // A pending autosave racing this revert could silently resurrect the pre-revert
        // content a moment later; cancel it first so the revert's result is the one that wins.
        _autosaveCts?.Cancel();

        IsHistoryBusy = true;
        try
        {
            var user = await CurrentUserAccessor.GetCurrentUsernameAsync();
            var reverted = await WikiDatabaseService.RevertRowToRevisionAsync(Database.Id, Row.Id, revisionId, user);
            _blocksJson = reverted.BlocksJson;
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("setBlocks", _editorContainer, _blocksJson);
            }
            DiffRevisionKey = null;
            _saveStatus = "Saved";
            await LoadHistoryAsync();
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to revert Sentinel row {RowId} to revision {RevisionId}.", Row.Id, revisionId);
            HistoryErrorMessage = $"Unable to revert. {ex.Message}";
        }
        finally
        {
            IsHistoryBusy = false;
        }
    }

    private static string DiffLineClass(string line) =>
        line.StartsWith('+') ? "text-success"
        : line.StartsWith('-') ? "text-danger"
        : line.StartsWith('~') ? "text-warning"
        : "text-secondary";

    private async Task SaveAsync()
    {
        // An explicit save is the meaningful checkpoint (default CreateRevisionCheckpoint =
        // true) - cancel any in-flight silent autosave first so it can't race this and, e.g.,
        // overwrite with a stale in-between snapshot after this call returns.
        _autosaveCts?.Cancel();
        IsBusy = true;
        ErrorMessage = string.Empty;
        try
        {
            var user = await CurrentUserAccessor.GetCurrentUsernameAsync();
            await WikiDatabaseService.SaveRowAsync(Database.Id, new WikiDatabaseRowEditor
            {
                Id = Row.Id,
                BlocksJson = _blocksJson,
                Icon = _icon,
                CoverImageUrl = _coverImageUrl,
                Values = Values.ToDictionary(pair => pair.Key, pair => pair.Value)
            }, user);
            _saveStatus = "Saved";
            await LoadHistoryAsync();
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to save Sentinel database row page {RowId}.", Row.Id);
            ErrorMessage = $"Unable to save page. {ex.Message}";
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task PushToNotionAsync()
    {
        await SaveAsync();
        if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            return;
        }

        IsBusy = true;
        try
        {
            var result = await NotionSyncService.PushDatabaseRowAsync(Row.Id);
            if (result.IsSuccess)
            {
                _saveStatus = "Pushed to Notion";
            }
            else
            {
                ErrorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to push Sentinel database row {RowId} to Notion.", Row.Id);
            ErrorMessage = $"Unable to push row. {ex.Message}";
        }
        finally
        {
            IsBusy = false;
        }
    }

    private Task CloseAsync() => OnClose.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        _autosaveCts?.Cancel();
        _autosaveCts?.Dispose();
        if (_initialized && _module is not null)
        {
            try { await _module.InvokeVoidAsync("dispose", _editorContainer); }
            catch (JSDisconnectedException) { }
        }
        if (_module is not null) await _module.DisposeAsync();
        _dotNetRef?.Dispose();
    }
}
