    private async Task AddPropertyAsync()
    {
        if (string.IsNullOrWhiteSpace(_newPropertyName))
        {
            return;
        }

        await Work(async () =>
        {
            var user = await CurrentUserNameAsync();
            var editor = new WikiDatabasePropertyEditor
            {
                Name = _newPropertyName,
                Type = _newPropertyType,
                Options = [],
                FormulaExpression = _newPropertyType == WikiDatabasePropertyTypes.Formula ? _newFormulaExpression : null,
                RelatedDatabaseId = _newPropertyType == WikiDatabasePropertyTypes.Relation ? _newRelatedDatabaseId : null,
                ReciprocalRelationEnabled = _newPropertyType == WikiDatabasePropertyTypes.Relation
                    ? _newReciprocalRelationEnabled
                    : null,
                ReciprocalPropertyName = _newPropertyType == WikiDatabasePropertyTypes.Relation
                    ? _newReciprocalPropertyName
                    : null
            };
            if (_newPropertyType == WikiDatabasePropertyTypes.Rollup)
            {
                var relation = RelationProperties.FirstOrDefault()
                    ?? throw new InvalidOperationException("Add a Relation property before creating a Rollup.");
                var relatedDatabase = GetRelatedDatabase(relation)
                    ?? throw new InvalidOperationException("The relation's target database is unavailable.");
                editor.RelationPropertyId = relation.Id;
                editor.RollupPropertyId = relatedDatabase.Properties.OrderBy(property => property.SortOrder).FirstOrDefault()?.Id
                    ?? throw new InvalidOperationException("The related database has no properties to roll up.");
                editor.RollupAggregation = WikiDatabaseRollupAggregations.Count;
            }
            await WikiDatabaseService.SavePropertyAsync(WikiDatabaseId, editor, user);
            _newPropertyName = string.Empty;
            _newReciprocalRelationEnabled = false;
            _newReciprocalPropertyName = string.Empty;
            await ReloadAsync();
        });
    }

