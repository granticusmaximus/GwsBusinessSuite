        {
            if (!current.Contains(relationId)) current.Add(relationId);
        }
        else
        {
            current.Remove(relationId);
        }

        return SaveRowValueAsync(row, values => WikiPropertyValues.SetMultiSelect(values, property.Id, current));
    }

    private async Task LoadRelatedDatabasesAsync()
    {
        _relatedDatabases.Clear();
        if (Database is null) return;

        _relatedDatabases[Database.Id] = Database;
        var targetIds = Database.Properties
            .Where(property => property.Type == WikiDatabasePropertyTypes.Relation)
            .Select(property => WikiDatabasePropertyConfig.Parse(property).RelatedDatabaseId)
            .Where(id => id.HasValue && id.Value != Database.Id)
            .Select(id => id!.Value)
            .Distinct();
        foreach (var targetId in targetIds)
        {
            if (await WikiDatabaseService.GetDatabaseAsync(targetId) is { } relatedDatabase)
            {
                _relatedDatabases[targetId] = relatedDatabase;
            }
        }
    }

    private WikiDatabase? GetRelatedDatabase(WikiDatabaseProperty relationProperty)
    {
        var relatedDatabaseId = WikiDatabasePropertyConfig.Parse(relationProperty).RelatedDatabaseId;
        return relatedDatabaseId is { } id && _relatedDatabases.TryGetValue(id, out var database) ? database : null;
    }

    private IReadOnlyList<WikiDatabaseProperty> GetRollupTargetProperties(WikiDatabaseProperty? relationProperty) =>
        relationProperty is null
            ? []
            : GetRelatedDatabase(relationProperty)?.Properties.OrderBy(property => property.SortOrder).ToList() ?? [];

    private static WikiDatabasePropertyEditor CreatePropertyEditor(WikiDatabaseProperty property)
    {
        var config = WikiDatabasePropertyConfig.Parse(property);
        return new WikiDatabasePropertyEditor
        {
            Id = property.Id,
            Name = property.Name,
            Type = property.Type,
            Options = config.Options,
            FormulaExpression = config.FormulaExpression,
            RelatedDatabaseId = config.RelatedDatabaseId,
            ReciprocalPropertyId = config.ReciprocalPropertyId,
            RelationPropertyId = config.RelationPropertyId,
            RollupPropertyId = config.RollupPropertyId,
            RollupAggregation = config.RollupAggregation
        };
    }

    private WikiDatabaseProperty? GetReciprocalProperty(WikiDatabaseProperty relationProperty)
    {
        var config = WikiDatabasePropertyConfig.Parse(relationProperty);
        return config.ReciprocalPropertyId is { } reciprocalId
            ? GetRelatedDatabase(relationProperty)?.Properties.FirstOrDefault(property => property.Id == reciprocalId)
            : null;
    }

    private static string GetDatabaseRowTitle(WikiDatabase database, WikiDatabaseRow row)
    {
        var titleProperty = database.Properties.FirstOrDefault(property => property.Type == WikiDatabasePropertyTypes.Title);
        return titleProperty is null ? "Untitled" : GetText(row, titleProperty) ?? "Untitled";
    }

    private static string RelationSummary(WikiDatabase database, IReadOnlyList<string> selectedRowIds)
    {
        var selected = database.Rows.Where(row => selectedRowIds.Contains(row.Id.ToString()))
            .Select(row => GetDatabaseRowTitle(database, row))
            .ToList();
        return selected.Count switch
        {
            0 => "Select related rows",
            1 => selected[0],
            _ => $"{selected.Count} related rows"
        };
    }

    private static string RollupAggregationLabel(string aggregation) => aggregation switch
    {
        WikiDatabaseRollupAggregations.Count => "Count rows",
        WikiDatabaseRollupAggregations.CountValues => "Count values",
        WikiDatabaseRollupAggregations.Sum => "Sum",
        WikiDatabaseRollupAggregations.Average => "Average",
        WikiDatabaseRollupAggregations.Minimum => "Minimum",
        WikiDatabaseRollupAggregations.Maximum => "Maximum",
        WikiDatabaseRollupAggregations.ShowUnique => "Show unique",
        _ => aggregation
    };

    private static string PropertyTypeLabel(string type) => type switch
    {
        WikiDatabasePropertyTypes.MultiSelect => "Multi-select",
        WikiDatabasePropertyTypes.CreatedTime => "Created time",
        WikiDatabasePropertyTypes.Rollup => "Rollup",
        _ => type
    };

    private static string? GetText(WikiDatabaseRow row, WikiDatabaseProperty property) =>
        WikiPropertyValues.GetText(WikiPropertyValues.ParseObject(row.PropertyValuesJson), property.Id);

    private static decimal? GetNumber(WikiDatabaseRow row, WikiDatabaseProperty property) =>
        WikiPropertyValues.GetNumber(WikiPropertyValues.ParseObject(row.PropertyValuesJson), property.Id);

    private static bool GetCheckbox(WikiDatabaseRow row, WikiDatabaseProperty property) =>
        WikiPropertyValues.GetCheckbox(WikiPropertyValues.ParseObject(row.PropertyValuesJson), property.Id);

    private static string GetDateInputValue(WikiDatabaseRow row, WikiDatabaseProperty property) =>
        WikiPropertyValues.GetDate(WikiPropertyValues.ParseObject(row.PropertyValuesJson), property.Id)?.ToString("yyyy-MM-dd") ?? string.Empty;

    private static IReadOnlyList<string> GetMultiSelect(WikiDatabaseRow row, WikiDatabaseProperty property) =>
        WikiPropertyValues.GetMultiSelect(WikiPropertyValues.ParseObject(row.PropertyValuesJson), property.Id);

    private static string ViewIcon(string type) => type switch
    {
        WikiDatabaseViewTypes.Board => "bi-kanban",
        WikiDatabaseViewTypes.List => "bi-list-ul",
        WikiDatabaseViewTypes.Gallery => "bi-grid",
        WikiDatabaseViewTypes.Calendar => "bi-calendar3",
        WikiDatabaseViewTypes.Timeline => "bi-calendar-range",
        WikiDatabaseViewTypes.Chart => "bi-bar-chart",
        WikiDatabaseViewTypes.Form => "bi-ui-checks",
        WikiDatabaseViewTypes.Map => "bi-map",
        WikiDatabaseViewTypes.Feed => "bi-view-list",
        WikiDatabaseViewTypes.Dashboard => "bi-speedometer2",
        _ => "bi-table"
    };

    private static bool IsAdvancedView(string type) => AdvancedViewOptions.Any(option => option.Type == type);
}
