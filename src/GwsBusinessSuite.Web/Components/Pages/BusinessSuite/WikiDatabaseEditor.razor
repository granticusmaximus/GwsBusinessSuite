    private string CalculationFor(WikiDatabaseProperty property) =>
        (ActiveViewConfig?.Calculations ?? new Dictionary<string, string>())
            .GetValueOrDefault(property.Id.ToString(), string.Empty);

    private static bool SupportsNumericCalculation(WikiDatabaseProperty property) =>
        property.Type is WikiDatabasePropertyTypes.Number or WikiDatabasePropertyTypes.Formula or WikiDatabasePropertyTypes.Rollup;

    private string CalculationText(WikiDatabaseProperty property)
    {
        var calculation = CalculationFor(property);
        var values = VisibleRows.Select(row => CalculationValue(property, row)).Where(value => value.HasValue)
            .Select(value => value!.Value).ToList();
        return calculation switch
        {
            "count" => $"{VisibleRows.Count(row => !string.IsNullOrWhiteSpace(WikiPropertyValues.GetDisplayText(property, WikiPropertyValues.ParseObject(row.PropertyValuesJson), row.CreatedAt)))} values",
            "sum" => values.Sum().ToString("0.##"),
            "average" => values.Count == 0 ? "—" : values.Average().ToString("0.##"),
            "minimum" => values.Count == 0 ? "—" : values.Min().ToString("0.##"),
            "maximum" => values.Count == 0 ? "—" : values.Max().ToString("0.##"),
            _ => string.Empty
        };
    }

    private static decimal? CalculationValue(WikiDatabaseProperty property, WikiDatabaseRow row)
    {
        var values = WikiPropertyValues.ParseObject(row.PropertyValuesJson);
        if (property.Type == WikiDatabasePropertyTypes.Number)
        {
            return WikiPropertyValues.GetNumber(values, property.Id);
        }
        return WikiPropertyValues.GetComputedValue(values, property.Id) is decimal computed ? computed : null;
    }

