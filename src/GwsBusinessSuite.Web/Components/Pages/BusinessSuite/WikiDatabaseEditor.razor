@using System.Text.Json.Nodes
@using GwsBusinessSuite.Application.Wiki
@using GwsBusinessSuite.Domain.Entities
@using GwsBusinessSuite.Application.Automation
@inject IWikiDatabaseService WikiDatabaseService
@inject INotionSyncService NotionSyncService
@inject ICurrentUserAccessor CurrentUserAccessor
@inject IAutomationWorkflowService AutomationWorkflowService
@inject IAutomationExecutionService AutomationExecutionService
@inject ISentinelAiService SentinelAiService
@inject IJSRuntime JS
@inject ILogger<WikiDatabaseEditor> Logger

@if (_loading)
{
    <div class="text-secondary py-5 text-center"><span class="spinner-border spinner-border-sm me-2"></span>Loading database…</div>
}
else if (Database is null)
{
    <div class="alert alert-danger">Database not found.</div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="wiki-db-header card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between gap-2">
            <div class="wiki-db-title d-flex align-items-center gap-2 flex-grow-1 min-w-0">
                <input class="form-control form-control-sm text-center" style="width:3rem;" @bind="_titleIcon" @bind:after="SaveMetadataAsync" maxlength="4" placeholder="🗄️" disabled="@(IsBusy || Database.IsLocked || !CanEdit)" />
                <input class="form-control form-control-sm fw-semibold" @bind="_title" @bind:after="SaveMetadataAsync" disabled="@(IsBusy || Database.IsLocked || !CanEdit)" />
            </div>
            <div class="wiki-db-actions d-flex gap-2 flex-shrink-0">
                <SentinelSharePanel TargetId="Database.Id" IsDatabase="true" TargetName="Database.Title" />
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="DuplicateDatabaseAsync" disabled="@IsBusy">
                    <i class="bi bi-copy me-1"></i>Duplicate
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _showRowTemplates = !_showRowTemplates" disabled="@IsBusy">
                    <i class="bi bi-file-earmark-plus me-1"></i>Templates@(RowTemplates.Count > 0 ? $" ({RowTemplates.Count})" : "")
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _showCsvImport = !_showCsvImport" disabled="@IsBusy" title="Append rows from a CSV file">
                    <i class="bi bi-filetype-csv me-1"></i>Import
                </button>
                <a class="btn btn-sm btn-outline-secondary" href="@($"admin/sentinel/databases/{Database.Id}/export.csv")" title="Export every row as a CSV file" download>
                    <i class="bi bi-download me-1"></i>Export
                </a>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _showProperties = !_showProperties" disabled="@(IsBusy || Database.IsLocked)">
                    <i class="bi bi-list-columns-reverse me-1"></i>Properties
                </button>
                <button type="button" class="btn btn-sm @(Database.IsLocked ? "btn-secondary" : "btn-outline-secondary")" @onclick="ToggleDatabaseLockAsync" disabled="@(IsBusy || !CanEdit)"
                        title="@(Database.IsLocked ? "Unlock shared structure and view settings" : "Lock shared structure while keeping rows editable")">
                    <i class="bi @(Database.IsLocked ? "bi-lock-fill" : "bi-unlock") me-1"></i>@(Database.IsLocked ? "Unlock" : "Lock")
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ToggleTrashedRowsAsync" disabled="@IsBusy" title="Trashed rows">
                    <i class="bi bi-trash3 me-1"></i>Trash@(TrashedRows.Count > 0 ? $" ({TrashedRows.Count})" : "")
                </button>
                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="DeleteDatabaseAsync" disabled="@IsBusy" title="Move to Trash">
                    <i class="bi bi-trash me-1"></i>Trash Database
                </button>
            </div>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="alert alert-danger py-2 small">@ErrorMessage</div>
            }
            @if (Database.IsLocked)
            {
                <div class="alert alert-secondary py-2 small d-flex align-items-center gap-2">
                    <i class="bi bi-lock-fill" aria-hidden="true"></i>
                    <span>Database structure is locked. Rows remain editable; unlock to change properties, shared views, metadata, or row templates.</span>
                </div>
            }

            @if (_showRowTemplates)
            {
                <div class="wiki-db-row-template-editor border rounded-3 p-3 mb-3">
                    <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                        <div>
                            <div class="fw-semibold small">Row templates</div>
                            <div class="small text-secondary">Save an existing row's page content and reusable properties as a starting point.</div>
                        </div>
                    </div>
                    @if (Database.Rows.Count == 0)
                    {
                        <div class="alert alert-light border small mb-0">Create and customize a row before saving your first template.</div>
                    }
                    else
                    {
                        <div class="row g-2 align-items-end mb-3">
                            <div class="col-lg-4">
                                <label class="form-label small text-secondary mb-1">Template name</label>
                                <input class="form-control form-control-sm" @bind="_newRowTemplateName" maxlength="120" placeholder="Standard task" disabled="@(IsBusy || !CanEdit)" />
                            </div>
                            <div class="col-lg-5">
                                <label class="form-label small text-secondary mb-1">Use this row as the source</label>
                                <select class="form-select form-select-sm" @bind="_rowTemplateSourceRowId" disabled="@(IsBusy || !CanEdit)">
                                    @foreach (var row in Database.Rows.OrderBy(row => row.SortOrder))
                                    {
                                        <option value="@row.Id">@GetDatabaseRowTitle(Database, row)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-lg-3 d-grid">
                                <button type="button" class="btn btn-sm btn-primary" @onclick="CreateRowTemplateAsync"
                                        disabled="@(IsBusy || !CanEdit || Database.IsLocked || string.IsNullOrWhiteSpace(_newRowTemplateName) || _rowTemplateSourceRowId is null)">
                                    <i class="bi bi-plus-lg me-1"></i>Save template
                                </button>
                            </div>
                        </div>
                    }

                    @if (RowTemplates.Count == 0)
                    {
                        <div class="small text-secondary">No row templates yet.</div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush border rounded-3 overflow-hidden">
                            @foreach (var template in RowTemplates)
                            {
                                <div class="list-group-item d-flex align-items-center justify-content-between gap-3 py-2">
                                    <div class="d-flex align-items-center gap-2 min-w-0">
                                        <span aria-hidden="true">@(string.IsNullOrWhiteSpace(template.Icon) ? "📄" : template.Icon)</span>
                                        <span class="small fw-semibold text-truncate">@template.Name</span>
                                    </div>
                                    <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => AddRowFromTemplateAsync(template.Id)" disabled="@(IsBusy || !CanEdit)">
                                            <i class="bi bi-plus-lg me-1"></i>New row
                                        </button>
                                        <button type="button" class="btn btn-sm btn-link text-danger text-decoration-none" @onclick="() => DeleteRowTemplateAsync(template.Id)" disabled="@(IsBusy || !CanEdit || Database.IsLocked)" title="Delete template">
                                            <i class="bi bi-trash"></i><span class="visually-hidden">Delete @template.Name</span>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            @if (_showCsvImport)
            {
                <div class="wiki-db-csv-import border rounded-3 p-3 mb-3">
                    <div class="row g-3 align-items-end">
                        <div class="col-lg-8">
                            <div class="fw-semibold small">Import CSV rows</div>
                            <div class="small text-secondary mb-2">The first column becomes the Title. Matching headers reuse existing properties; new headers become Text properties. Existing rows are never replaced.</div>
                            <InputFile OnChange="ImportCsvAsync" accept=".csv,text/csv" class="form-control form-control-sm" disabled="@(IsBusy || !CanEdit)" />
                        </div>
                        <div class="col-lg-4 small text-secondary">
                            UTF-8 CSV, up to 5 MB. Computed and system-managed properties are skipped.@(Database.IsLocked ? " Because this database is locked, every header after Title must match an existing property." : string.Empty)
                        </div>
                    </div>
                    @if (_csvImportResult is { } result)
                    {
                        <div class="alert alert-success py-2 small mt-3 mb-0">
                            Imported <strong>@result.RowsImported</strong> row(s), skipped <strong>@result.RowsSkipped</strong>, and created <strong>@result.PropertiesCreated</strong> propert@(result.PropertiesCreated == 1 ? "y" : "ies").
                        </div>
                        @if (result.Warnings.Count > 0)
                        {
                            <details class="mt-2 small">
                                <summary>@result.Warnings.Count import warning@(result.Warnings.Count == 1 ? "" : "s")</summary>
                                <ul class="mb-0 mt-1">
                                    @foreach (var warning in result.Warnings.Take(20))
                                    {
                                        <li>@warning</li>
                                    }
                                </ul>
                            </details>
                        }
                    }
                </div>
            }

            @if (_showProperties)
            {
                <div class="wiki-db-property-editor border rounded-3 p-3 mb-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="fw-semibold small">Properties</div>
                        @if (!string.IsNullOrWhiteSpace(Database.NotionId) && UnpushedPropertyCount > 0)
                        {
                            <button type="button" class="btn btn-sm btn-outline-warning" @onclick="PushSchemaToNotionAsync" disabled="@IsBusy">
                                <i class="bi bi-cloud-arrow-up-fill me-1"></i>Push @UnpushedPropertyCount new propert@(UnpushedPropertyCount == 1 ? "y" : "ies") to Notion
                            </button>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_schemaPushMessage))
                    {
                        <div class="small mb-2 @(_schemaPushSucceeded ? "text-success" : "text-danger")">@_schemaPushMessage</div>
                    }
                    @foreach (var property in Database.Properties.OrderBy(p => p.SortOrder))
                    {
                        <div class="row g-2 align-items-center mb-2">
                            <div class="col-md-4">
                                <input class="form-control form-control-sm" value="@property.Name"
                                       disabled="@(property.Type == WikiDatabasePropertyTypes.Title || IsBusy)"
                                       @onchange="e => RenamePropertyAsync(property, e.Value?.ToString() ?? property.Name)" />
                            </div>
                            <div class="col-md-3"><span class="badge text-bg-secondary">@property.Type</span></div>
                            @if (property.Type is WikiDatabasePropertyTypes.Select or WikiDatabasePropertyTypes.MultiSelect)
                            {
                                <div class="col-md-4">
                                    <input class="form-control form-control-sm" placeholder="Option A, Option B, ..."
                                           value="@string.Join(", ", WikiDatabasePropertyConfig.GetOptions(property).Select(o => o.Label))"
                                           @onchange="e => SetPropertyOptionsAsync(property, e.Value?.ToString() ?? string.Empty)" disabled="@IsBusy" />
                                </div>
                            }
                            @if (property.Type == WikiDatabasePropertyTypes.Status)
                            {
                                <div class="col-12">
                                    <label class="form-label small text-secondary mb-1">Status options</label>
                                    @foreach (var option in WikiDatabasePropertyConfig.GetOptions(property))
                                    {
                                        <div class="d-flex gap-2 align-items-center mb-1">
                                            <input class="form-control form-control-sm" value="@option.Label"
                                                   @onchange="e => RenameStatusOptionAsync(property, option.Id, e.Value?.ToString() ?? option.Label)" disabled="@IsBusy" />
                                            <select class="form-select form-select-sm" style="max-width:10rem;" value="@option.Group"
                                                    @onchange="e => SetStatusOptionGroupAsync(property, option.Id, e.Value?.ToString())" disabled="@IsBusy">
                                                @foreach (var group in WikiDatabaseStatusGroups.All)
                                                {
                                                    <option value="@group">@StatusGroupLabel(group)</option>
                                                }
                                            </select>
                                            <button type="button" class="btn btn-xs btn-link text-danger p-0" @onclick="() => RemoveStatusOptionAsync(property, option.Id)" disabled="@IsBusy">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </div>
                                    }
                                    <button type="button" class="btn btn-sm btn-link px-0" @onclick="() => AddStatusOptionAsync(property)" disabled="@IsBusy">
                                        <i class="bi bi-plus-lg me-1"></i>Add status option
                                    </button>
                                </div>
                            }
                            @if (property.Type == WikiDatabasePropertyTypes.Button)
                            {
                                var buttonConfig = WikiDatabasePropertyConfig.Parse(property);
                                <div class="col-12">
                                    <div class="row g-2">
                                        <div class="col-md-4">
                                            <label class="form-label small text-secondary mb-1">Button label</label>
                                            <input class="form-control form-control-sm" value="@buttonConfig.ButtonLabel"
                                                   @onchange="e => SetButtonLabelAsync(property, e.Value?.ToString() ?? string.Empty)" disabled="@IsBusy" />
                                        </div>
                                        <div class="col-md-8">
                                            <label class="form-label small text-secondary mb-1">Runs automation</label>
                                            <select class="form-select form-select-sm" value="@buttonConfig.AutomationWorkflowId"
                                                    @onchange="e => SetButtonWorkflowAsync(property, e.Value?.ToString())" disabled="@IsBusy">
                                                <option value="">— No automation selected —</option>
                                                @foreach (var workflow in _workflowChoices)
                                                {
                                                    <option value="@workflow.Id">@workflow.Name</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (property.Type == WikiDatabasePropertyTypes.UniqueId)
                            {
                                <div class="col-md-4">
                                    <label class="form-label small text-secondary mb-1">Prefix (optional)</label>
                                    <input class="form-control form-control-sm" placeholder="TASK-" maxlength="10"
                                           value="@WikiDatabasePropertyConfig.Parse(property).UniqueIdPrefix"
                                           @onchange="e => SetUniqueIdPrefixAsync(property, e.Value?.ToString() ?? string.Empty)" disabled="@IsBusy" />
                                </div>
                            }
                            @if (property.Type == WikiDatabasePropertyTypes.AiField)
                            {
                                var aiConfig = WikiDatabasePropertyConfig.Parse(property);
                                <div class="col-12">
                                    <div class="row g-2">
                                        <div class="col-md-8">
                                            <label class="form-label small text-secondary mb-1">Prompt</label>
                                            <ProfessionalWysiwygEditor Value="@aiConfig.AiPromptTemplate"
                                                                       ValueChanged="value => SetAiPromptTemplateAsync(property, value)"
                                                                       Compact="true" MinHeight="90px" Placeholder="Summarize [Notes] in one sentence."
                                                                       AriaLabel="AI field prompt" Disabled="@IsBusy" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small text-secondary mb-1">Ollama model</label>
                                            <input class="form-control form-control-sm" placeholder="llama3.1"
                                                   value="@aiConfig.AiModel"
                                                   @onchange="e => SetAiModelAsync(property, e.Value?.ToString() ?? string.Empty)" disabled="@IsBusy" />
                                        </div>
                                    </div>
                                    <div class="form-text">Reference properties as <code>[Property name]</code>. Only generated when someone clicks "Generate" on the cell.</div>
                                </div>
                            }
                            <div class="col-md-1 text-end">
                                @if (property.Type != WikiDatabasePropertyTypes.Title)
                                {
                                    <button type="button" class="btn btn-xs btn-link text-danger p-0" @onclick="() => DeletePropertyAsync(property)" disabled="@IsBusy">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                }
                            </div>
                            @if (property.Type == WikiDatabasePropertyTypes.Formula)
                            {
                                <div class="col-12">
                                    <label class="form-label small text-secondary mb-1">Formula</label>
                                    <input class="form-control form-control-sm font-monospace"
                                           value="@WikiDatabasePropertyConfig.Parse(property).FormulaExpression"
                                           @onchange="e => SetFormulaAsync(property, e.Value?.ToString() ?? string.Empty)"
                                           disabled="@IsBusy" placeholder="[Hours] * [Rate]" />
                                    <div class="form-text">Reference properties as <code>[Property name]</code>. Function names are case-insensitive.</div>
                                    <details class="sentinel-formula-reference mt-2">
                                        <summary>Formula reference</summary>
                                        <div class="sentinel-formula-reference-grid">
                                            <div>
                                                <strong>Logic</strong>
                                                <code>if</code> <code>and</code> <code>or</code> <code>not</code> <code>empty</code> <code>coalesce</code>
                                            </div>
                                            <div>
                                                <strong>Numbers</strong>
                                                <code>+ - * / % ^</code> <code>round</code> <code>abs</code> <code>ceil</code> <code>floor</code> <code>min</code> <code>max</code> <code>pow</code>
                                            </div>
                                            <div>
                                                <strong>Text</strong>
                                                <code>concat</code> <code>length</code> <code>lower</code> <code>upper</code> <code>trim</code> <code>contains</code> <code>startsWith</code> <code>endsWith</code> <code>replace</code>
                                            </div>
                                            <div>
                                                <strong>Dates</strong>
                                                <code>now</code> <code>today</code> <code>dateAdd</code> <code>dateBetween</code> <code>formatDate</code>
                                            </div>
                                        </div>
                                        <div class="sentinel-formula-example">
                                            <code>if([Done], "Complete", upper([Status]))</code>
                                            <code>dateBetween([Due], today(), "days")</code>
                                        </div>
                                    </details>
                                </div>
                            }
                            else if (property.Type == WikiDatabasePropertyTypes.Relation)
                            {
                                var relationConfig = WikiDatabasePropertyConfig.Parse(property);
                                var reciprocalProperty = GetReciprocalProperty(property);
                                <div class="col-12">
                                    <label class="form-label small text-secondary mb-1">Related database</label>
                                    <select class="form-select form-select-sm" value="@relationConfig.RelatedDatabaseId"
                                            @onchange="e => SetRelationDatabaseAsync(property, e.Value?.ToString())" disabled="@IsBusy">
                                        @foreach (var databaseChoice in _databaseChoices)
                                        {
                                            <option value="@databaseChoice.Id">@(databaseChoice.Icon ?? "🗄️") @databaseChoice.Title</option>
                                        }
                                    </select>
                                    @if (reciprocalProperty is null)
                                    {
                                        <button type="button" class="btn btn-sm btn-link px-0 mt-1"
                                                @onclick="() => EnableReciprocalRelationAsync(property)" disabled="@IsBusy">
                                            <i class="bi bi-arrow-left-right me-1"></i>Add reciprocal property
                                        </button>
                                    }
                                    else
                                    {
                                        <div class="sentinel-reciprocal-editor mt-2">
                                            <i class="bi bi-arrow-left-right text-success" title="Two-way relation"></i>
                                            <input class="form-control form-control-sm" value="@reciprocalProperty.Name"
                                                   @onchange="e => RenameReciprocalRelationAsync(property, e.Value?.ToString() ?? string.Empty)"
                                                   disabled="@IsBusy" aria-label="Reciprocal property name" />
                                            <button type="button" class="btn btn-sm btn-link text-danger"
                                                    @onclick="() => DisableReciprocalRelationAsync(property)" disabled="@IsBusy"
                                                    title="Make this relation one-way">
                                                Remove reciprocal
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                            else if (property.Type == WikiDatabasePropertyTypes.Rollup)
                            {
                                var rollupConfig = WikiDatabasePropertyConfig.Parse(property);
                                var selectedRelation = Database.Properties.FirstOrDefault(candidate => candidate.Id == rollupConfig.RelationPropertyId);
                                var relatedDatabase = selectedRelation is null ? null : GetRelatedDatabase(selectedRelation);
                                <div class="col-12">
                                    <div class="row g-2">
                                        <div class="col-md-4">
                                            <label class="form-label small text-secondary mb-1">Relation</label>
                                            <select class="form-select form-select-sm" value="@rollupConfig.RelationPropertyId"
                                                    @onchange="e => SetRollupRelationAsync(property, e.Value?.ToString())" disabled="@IsBusy">
                                                @foreach (var relation in RelationProperties)
                                                {
                                                    <option value="@relation.Id">@relation.Name</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small text-secondary mb-1">Property</label>
                                            <select class="form-select form-select-sm" value="@rollupConfig.RollupPropertyId"
                                                    @onchange="e => SetRollupTargetAsync(property, e.Value?.ToString())" disabled="@(IsBusy || relatedDatabase is null)">
                                                @foreach (var targetProperty in GetRollupTargetProperties(selectedRelation))
                                                {
                                                    <option value="@targetProperty.Id">@targetProperty.Name</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small text-secondary mb-1">Calculate</label>
                                            <select class="form-select form-select-sm" value="@rollupConfig.RollupAggregation"
                                                    @onchange="e => SetRollupAggregationAsync(property, e.Value?.ToString())" disabled="@IsBusy">
                                                @foreach (var aggregation in WikiDatabaseRollupAggregations.All)
                                                {
                                                    <option value="@aggregation">@RollupAggregationLabel(aggregation)</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    <div class="row g-2 align-items-center mt-2">
                        <div class="col-md-4"><input class="form-control form-control-sm" placeholder="New property name" @bind="_newPropertyName" /></div>
                        <div class="col-md-3">
                            <select class="form-select form-select-sm" @bind="_newPropertyType">
                                @foreach (var type in AddablePropertyTypes)
                                {
                                    <option value="@type">@type</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-5">
                            @if (_newPropertyType == WikiDatabasePropertyTypes.Formula)
                            {
                                <input class="form-control form-control-sm mb-2 font-monospace" placeholder="[Hours] * [Rate]" @bind="_newFormulaExpression" />
                                <div class="form-text mb-2">Use <code>[Property name]</code> references with logic, number, text, or date functions. The full reference appears after creation.</div>
                            }
                            else if (_newPropertyType == WikiDatabasePropertyTypes.Relation)
                            {
                                <select class="form-select form-select-sm mb-2" @bind="_newRelatedDatabaseId">
                                    @foreach (var databaseChoice in _databaseChoices)
                                    {
                                        <option value="@databaseChoice.Id">@(databaseChoice.Icon ?? "🗄️") @databaseChoice.Title</option>
                                    }
                                </select>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" id="new-reciprocal-relation" @bind="_newReciprocalRelationEnabled" />
                                    <label class="form-check-label small" for="new-reciprocal-relation">Show on the related database</label>
                                </div>
                                @if (_newReciprocalRelationEnabled)
                                {
                                    <input class="form-control form-control-sm mb-2" placeholder="Reciprocal property name (defaults to this database)"
                                           @bind="_newReciprocalPropertyName" />
                                }
                            }
                            else if (_newPropertyType == WikiDatabasePropertyTypes.Rollup)
                            {
                                <div class="small text-secondary mb-2">A new rollup starts with the first available relation and target property; configure it above after creation.</div>
                            }
                            else if (_newPropertyType == WikiDatabasePropertyTypes.Status)
                            {
                                <div class="small text-secondary mb-2">Add status options above after creation.</div>
                            }
                            else if (_newPropertyType == WikiDatabasePropertyTypes.Button)
                            {
                                <input class="form-control form-control-sm mb-2" placeholder="Button label" @bind="_newButtonLabel" />
                                <select class="form-select form-select-sm mb-2" @bind="_newAutomationWorkflowId">
                                    <option value="">— No automation selected —</option>
                                    @foreach (var workflow in _workflowChoices)
                                    {
                                        <option value="@workflow.Id">@workflow.Name</option>
                                    }
                                </select>
                            }
                            else if (_newPropertyType == WikiDatabasePropertyTypes.UniqueId)
                            {
                                <input class="form-control form-control-sm mb-2" placeholder="Prefix (optional, e.g. TASK-)" maxlength="10" @bind="_newUniqueIdPrefix" />
                            }
                            else if (_newPropertyType == WikiDatabasePropertyTypes.AiField)
                            {
                                <ProfessionalWysiwygEditor @bind-Value="_newAiPromptTemplate" Compact="true" MinHeight="90px" CssClass="mb-2"
                                                           Placeholder="Summarize [Notes] in one sentence." AriaLabel="New AI field prompt" />
                                <input class="form-control form-control-sm mb-2" placeholder="Ollama model, e.g. llama3.1" @bind="_newAiModel" />
                                <div class="form-text mb-2">Use <code>[Property name]</code> references. Generated on demand from a "Generate" button on the cell, never automatically.</div>
                            }
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddPropertyAsync" disabled="@(IsBusy || string.IsNullOrWhiteSpace(_newPropertyName))">
                                <i class="bi bi-plus-lg me-1"></i>Add property
                            </button>
                        </div>
                    </div>
                </div>
            }

            @if (_showTrashedRows)
            {
                <div class="wiki-db-property-editor border rounded-3 p-3 mb-3">
                    <div class="fw-semibold small mb-2">Trashed rows</div>
                    @if (TrashedRows.Count == 0)
                    {
                        <p class="small text-secondary mb-0">No trashed rows.</p>
                    }
                    else
                    {
                        @foreach (var trashedRow in TrashedRows)
                        {
                            <div class="d-flex justify-content-between align-items-start gap-2 py-1 border-bottom">
                                <div>
                                    <div class="fw-semibold small">@GetDatabaseRowTitle(Database, trashedRow)</div>
                                    <div class="small text-secondary">trashed @trashedRow.TrashedAt?.ToLocalTime().ToString("g")</div>
                                </div>
                                <div class="d-flex gap-1 flex-shrink-0">
                                    <button type="button" class="btn btn-xs btn-outline-primary" @onclick="() => RestoreTrashedRowAsync(trashedRow.Id)" disabled="@IsBusy">Restore</button>
                                    <button type="button" class="btn btn-xs btn-outline-danger" @onclick="() => DeleteTrashedRowPermanentlyAsync(trashedRow.Id)" disabled="@IsBusy">Delete Permanently</button>
                                </div>
                            </div>
                        }
                    }
                </div>
            }

            @if (_autofillRow is not null)
            {
                <div class="wiki-db-property-editor border rounded-3 p-3 mb-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="fw-semibold small">✦ SentinelGPT autofill — @GetDatabaseRowTitle(Database, _autofillRow)</div>
                        <button type="button" class="btn btn-xs btn-link p-0" @onclick="CloseAutofillPanel" disabled="@IsBusy">Cancel</button>
                    </div>
                    @foreach (var warning in _autofillWarnings)
                    {
                        <div class="small text-warning mb-1">@warning</div>
                    }
                    @if (_autofillSuggestions.Count == 0)
                    {
                        <p class="small text-secondary mb-0">No suggestions to review.</p>
                    }
                    else
                    {
                        @foreach (var suggestion in _autofillSuggestions)
                        {
                            <label class="d-flex align-items-center gap-2 mb-1 small">
                                <input type="checkbox" class="form-check-input"
                                       checked="@_autofillSelectedPropertyIds.Contains(suggestion.PropertyId)"
                                       @onchange="e => ToggleAutofillSuggestion(suggestion.PropertyId, (bool)(e.Value ?? false))" disabled="@IsBusy" />
                                <strong>@suggestion.PropertyName:</strong> @suggestion.DisplayLabel
                            </label>
                        }
                        <button type="button" class="btn btn-sm btn-outline-primary mt-2"
                                @onclick="ApplyAutofillAsync" disabled="@(IsBusy || _autofillSelectedPropertyIds.Count == 0)">
                            Apply selected
                        </button>
                    }
                </div>
            }

            <ul class="nav nav-tabs mb-3">
                @foreach (var view in Database.Views.OrderBy(v => v.SortOrder))
                {
                    <li class="nav-item">
                        <button type="button" class="nav-link @(view.Id == _activeViewId ? "active" : "")" @onclick="() => SelectViewAsync(view.Id)">
                            <i class="bi @ViewIcon(view.Type) me-1"></i>@view.Name
                        </button>
                    </li>
                }
                <li class="nav-item">
                    <button type="button" class="nav-link text-secondary" @onclick="AddBoardViewAsync" disabled="@(IsBusy || Database.IsLocked)" title="Add a Board view grouped by a Select property">
                        <i class="bi bi-plus-lg me-1"></i>Board
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link text-secondary" @onclick="AddListViewAsync" disabled="@(IsBusy || Database.IsLocked)">
                        <i class="bi bi-plus-lg me-1"></i>List
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link text-secondary" @onclick="AddGalleryViewAsync" disabled="@(IsBusy || Database.IsLocked)">
                        <i class="bi bi-plus-lg me-1"></i>Gallery
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link text-secondary" @onclick="AddCalendarViewAsync" disabled="@(IsBusy || Database.IsLocked)" title="Add a Calendar view using a Date property">
                        <i class="bi bi-plus-lg me-1"></i>Calendar
                    </button>
                </li>
                @foreach (var advancedView in AdvancedViewOptions)
                {
                    <li class="nav-item">
                        <button type="button" class="nav-link text-secondary" @onclick="() => AddAdvancedViewAsync(advancedView.Type, advancedView.Name)" disabled="@(IsBusy || Database.IsLocked)">
                            <i class="bi bi-plus-lg me-1"></i>@advancedView.Name
                        </button>
                    </li>
                }
            </ul>

            @if (ActiveView is not null)
            {
                <div class="sentinel-view-layout-bar" aria-label="Database page layout">
                    <span class="sentinel-view-layout-label">
                        <i class="bi bi-layout-sidebar-inset-reverse"></i>
                        Open pages in
                    </span>
                    <div class="sentinel-view-layout-controls">
                        <div class="btn-group btn-group-sm sentinel-open-mode-group" role="group" aria-label="Choose how database pages open">
                            <button type="button"
                                    class="btn @(ActiveOpenPageMode == WikiDatabaseOpenPageModes.SidePeek ? "btn-secondary" : "btn-outline-secondary")"
                                    aria-pressed="@(ActiveOpenPageMode == WikiDatabaseOpenPageModes.SidePeek)"
                                    title="Open pages in a panel beside the database"
                                    disabled="@IsBusy"
                                    @onclick="() => SetOpenPageModeAsync(WikiDatabaseOpenPageModes.SidePeek)">
                                <i class="bi bi-layout-sidebar-reverse me-1"></i>Side peek
                            </button>
                            <button type="button"
                                    class="btn @(ActiveOpenPageMode == WikiDatabaseOpenPageModes.CenterPeek ? "btn-secondary" : "btn-outline-secondary")"
                                    aria-pressed="@(ActiveOpenPageMode == WikiDatabaseOpenPageModes.CenterPeek)"
                                    title="Open pages in a centered overlay"
                                    disabled="@IsBusy"
                                    @onclick="() => SetOpenPageModeAsync(WikiDatabaseOpenPageModes.CenterPeek)">
                                <i class="bi bi-window-stack me-1"></i>Center peek
                            </button>
                            <button type="button"
                                    class="btn @(ActiveOpenPageMode == WikiDatabaseOpenPageModes.FullPage ? "btn-secondary" : "btn-outline-secondary")"
                                    aria-pressed="@(ActiveOpenPageMode == WikiDatabaseOpenPageModes.FullPage)"
                                    title="Open pages in a focused full-page workspace"
                                    disabled="@IsBusy"
                                    @onclick="() => SetOpenPageModeAsync(WikiDatabaseOpenPageModes.FullPage)">
                                <i class="bi bi-arrows-fullscreen me-1"></i>Full page
                            </button>
                        </div>

                        <details class="sentinel-page-properties-menu">
                            <summary class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-sliders2 me-1"></i>
                                Page properties
                                <span class="badge text-bg-secondary ms-1">@VisiblePageProperties.Count/@PageProperties.Count</span>
                            </summary>
                            <div class="sentinel-page-properties-popover">
                                <div class="sentinel-page-properties-heading">
                                    <strong>Property presentation</strong>
                                    <span>Choose what appears beneath a row title and in what order.</span>
                                </div>
                                @if (PageProperties.Count == 0)
                                {
                                    <div class="small text-secondary p-2">Add a property to configure the row page layout.</div>
                                }
                                else
                                {
                                    @for (var index = 0; index < PageProperties.Count; index++)
                                    {
                                        var property = PageProperties[index];
                                        var propertyInputId = $"page-property-{ActiveView.Id:N}-{property.Id:N}";
                                        <div class="sentinel-page-property-option">
                                            <input id="@propertyInputId"
                                                   class="form-check-input"
                                                   type="checkbox"
                                                   checked="@IsPagePropertyVisible(property)"
                                                   disabled="@IsBusy"
                                                   @onchange="e => SetPagePropertyVisibilityAsync(property, (bool)(e.Value ?? false))" />
                                            <label for="@propertyInputId" class="sentinel-page-property-option-name" title="@property.Name">
                                                <span>@property.Name</span>
                                                <small>@PropertyTypeLabel(property.Type)</small>
                                            </label>
                                            <div class="btn-group btn-group-sm" role="group" aria-label="@($"Move {property.Name}")">
                                                <button type="button"
                                                        class="btn btn-link"
                                                        title="Move up"
                                                        aria-label="@($"Move {property.Name} up")"
                                                        disabled="@(IsBusy || index == 0)"
                                                        @onclick="() => MovePagePropertyAsync(property, -1)">
                                                    <i class="bi bi-chevron-up"></i>
                                                </button>
                                                <button type="button"
                                                        class="btn btn-link"
                                                        title="Move down"
                                                        aria-label="@($"Move {property.Name} down")"
                                                        disabled="@(IsBusy || index == PageProperties.Count - 1)"
                                                        @onclick="() => MovePagePropertyAsync(property, 1)">
                                                    <i class="bi bi-chevron-down"></i>
                                                </button>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </details>
                    </div>
                </div>

                <details class="sentinel-view-options mb-3">
                    <summary class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-funnel me-1"></i>View options
                        @if ((ActiveViewConfig?.Filters.Count ?? 0) + (ActiveViewConfig?.Sorts.Count ?? 0) > 0)
                        {
                            <span class="badge text-bg-primary ms-1">@((ActiveViewConfig?.Filters.Count ?? 0) + (ActiveViewConfig?.Sorts.Count ?? 0))</span>
                        }
                    </summary>
                    <div class="border rounded-3 p-3 mt-2 bg-body-tertiary">
                        <div class="row g-2 align-items-end">
                            <div class="col-md-5">
                                <label class="form-label small fw-semibold">View name</label>
                                <input class="form-control form-control-sm" value="@ActiveView.Name"
                                       @onchange="e => RenameActiveViewAsync(e.Value?.ToString() ?? ActiveView.Name)" disabled="@IsBusy" />
                            </div>
                            <div class="col-md-7 text-md-end">
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        @onclick="DeleteActiveViewAsync" disabled="@(IsBusy || Database.Views.Count <= 1)">
                                    <i class="bi bi-trash me-1"></i>Delete view
                                </button>
                            </div>
                        </div>

                        <div class="form-check form-switch mt-3">
                            <input class="form-check-input" type="checkbox" id="personal-filters-toggle" role="switch"
                                   checked="@HasPersonalOverride" disabled="@IsBusy"
                                   @onchange="e => ((bool)(e.Value ?? false) ? EnablePersonalFiltersAsync() : DisablePersonalFiltersAsync())" />
                            <label class="form-check-label small" for="personal-filters-toggle">
                                Personalize filters &amp; sort <span class="text-secondary">(only visible to you - everyone else keeps seeing the shared version)</span>
                            </label>
                        </div>

                        <div class="fw-semibold small mt-3 mb-2">Filters</div>
                        @foreach (var filter in ActiveViewConfig?.Filters ?? [])
                        {
                            <div class="d-flex align-items-center gap-2 mb-1 small">
                                <span class="badge text-bg-light border">@PropertyName(filter.PropertyId)</span>
                                <span>@FilterOperatorLabel(filter.Operator)</span>
                                @if (!string.IsNullOrWhiteSpace(filter.Value))
                                {
                                    <strong>@FilterValueLabel(filter)</strong>
                                }
                                <button type="button" class="btn btn-xs btn-link text-danger ms-auto"
                                        @onclick="() => RemoveFilterAsync(filter)" disabled="@IsBusy">Remove</button>
                            </div>
                        }
                        <div class="row g-2 align-items-end">
                            <div class="col-md-4">
                                <select class="form-select form-select-sm" @bind="_filterPropertyId">
                                    @foreach (var property in FilterableProperties)
                                    {
                                        <option value="@property.Id">@property.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <select class="form-select form-select-sm" @bind="_filterOperator">
                                    @foreach (var filterOperator in FilterOperators)
                                    {
                                        <option value="@filterOperator.Value">@filterOperator.Label</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                @if (SelectedFilterProperty?.Type == WikiDatabasePropertyTypes.Select)
                                {
                                    <select class="form-select form-select-sm" @bind="_filterValue">
                                        @foreach (var option in WikiDatabasePropertyConfig.GetOptions(SelectedFilterProperty))
                                        {
                                            <option value="@option.Id">@option.Label</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input class="form-control form-control-sm"
                                           type="@FilterValueInputType"
                                           @bind="_filterValue"
                                           placeholder="@FilterValuePlaceholder"
                                           disabled="@FilterNeedsNoValue" />
                                }
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="btn btn-sm btn-outline-primary w-100"
                                        @onclick="AddFilterAsync" disabled="@(IsBusy || _filterPropertyId == Guid.Empty)">Add</button>
                            </div>
                        </div>

                        <details class="mt-3">
                            <summary class="small fw-semibold">
                                Advanced filters (AND/OR groups)
                                @if (ActiveViewConfig?.FilterGroup is { IsEmpty: false })
                                {
                                    <span class="badge text-bg-primary ms-1">Active</span>
                                }
                            </summary>
                            <div class="mt-2">
                                <p class="small text-secondary">When an advanced filter group has any conditions or nested groups, it replaces the simple filters above.</p>
                                <WikiDatabaseFilterGroupEditor Group="@(ActiveViewConfig?.FilterGroup ?? WikiDatabaseFilterGroup.Empty)"
                                                                Properties="FilterableProperties" IsBusy="IsBusy" Depth="0"
                                                                GroupChanged="UpdateFilterGroupAsync" />
                                @if (ActiveViewConfig?.FilterGroup is { IsEmpty: false })
                                {
                                    <button type="button" class="btn btn-sm btn-link text-danger px-0" @onclick="ClearFilterGroupAsync" disabled="@IsBusy">
                                        Clear advanced filters
                                    </button>
                                }
                            </div>
                        </details>

                        <div class="fw-semibold small mt-3 mb-2">Sorts</div>
                        @foreach (var sort in ActiveViewConfig?.Sorts ?? [])
                        {
                            <div class="d-flex align-items-center gap-2 mb-1 small">
                                <span class="badge text-bg-light border">@PropertyName(sort.PropertyId)</span>
                                <span>@(sort.Direction == "descending" ? "Descending" : "Ascending")</span>
                                <button type="button" class="btn btn-xs btn-link text-danger ms-auto"
                                        @onclick="() => RemoveSortAsync(sort)" disabled="@IsBusy">Remove</button>
                            </div>
                        }
                        <div class="row g-2 align-items-end">
                            <div class="col-md-5">
                                <select class="form-select form-select-sm" @bind="_sortPropertyId">
                                    @foreach (var property in Database.Properties.OrderBy(property => property.SortOrder))
                                    {
                                        <option value="@property.Id">@property.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <select class="form-select form-select-sm" @bind="_sortDirection">
                                    <option value="ascending">Ascending</option>
                                    <option value="descending">Descending</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <button type="button" class="btn btn-sm btn-outline-primary w-100"
                                        @onclick="AddSortAsync" disabled="@(IsBusy || _sortPropertyId == Guid.Empty)">Add sort</button>
                            </div>
                        </div>
                    </div>
                </details>
            }

            @{ var titleProperty = Database.Properties.First(p => p.Type == WikiDatabasePropertyTypes.Title); }

            @if (ActiveView is { Type: WikiDatabaseViewTypes.Board })
            {
                var groupByProperty = Database.Properties.FirstOrDefault(p => p.Id.ToString() == ActiveViewConfig?.GroupByPropertyId)
                    ?? Database.Properties.FirstOrDefault(p => p.Type == WikiDatabasePropertyTypes.Select);
                if (groupByProperty is null)
                {
                    <div class="text-secondary small">This Board view's Select property was removed. Add a Select property to use it again.</div>
                }
                else
                {
                    var groups = WikiDatabaseViewLogic.GroupForBoard(VisibleRows, groupByProperty);
                    <div class="wiki-db-board d-flex gap-3 overflow-auto pb-2">
                        @foreach (var group in groups)
                        {
                            <div class="wiki-db-board-column" @ondragover:preventDefault @ondrop="() => DropOnColumnAsync(groupByProperty, group.OptionId)">
                                <div class="wiki-db-board-column-header fw-semibold small mb-2">@group.Label <span class="text-secondary">(@group.Rows.Count)</span></div>
                                @foreach (var row in group.Rows)
                                {
                                    <div class="wiki-db-board-card" draggable="true" @ondragstart="() => StartDragRow(row)" @ondragend="EndDragRow">
                                        <div class="d-flex align-items-center justify-content-between gap-2">
                                            <div class="fw-semibold small text-truncate">@(GetText(row, titleProperty) ?? "Untitled")</div>
                                            <button type="button" class="btn btn-xs btn-link p-0" @onclick="() => OpenRow(row)" title="Open as page">
                                                Open
                                            </button>
                                        </div>
                                        @foreach (var property in Database.Properties.Where(p => p.Id != titleProperty.Id && p.Id != groupByProperty.Id).Take(3))
                                        {
                                            var text = WikiPropertyValues.GetDisplayText(property, WikiPropertyValues.ParseObject(row.PropertyValuesJson), row.CreatedAt);
                                            @if (!string.IsNullOrWhiteSpace(text))
                                            {
                                                <span class="badge text-bg-light border me-1">@text</span>
                                            }
                                        }
                                        @* Drag-and-drop (above) has no keyboard equivalent - a card could never be
                                           moved between columns without a mouse. A plain <select> is fully
                                           keyboard/screen-reader operable with no custom widget needed. The
                                           "No status" column's real OptionId is "" (WikiDatabaseViewLogic
                                           .GroupForBoard), same as an unset <select> - MovePlaceholderValue is a
                                           value no real option can ever have, so the two stay distinguishable. *@
                                        <select class="form-select form-select-sm wiki-db-board-card-move mt-2"
                                                aria-label="@($"Move \"{GetText(row, titleProperty) ?? "Untitled"}\" to another column")"
                                                @onchange="e => MoveRowToOptionAsync(row, groupByProperty, (string)e.Value!)"
                                                disabled="@IsBusy">
                                            <option value="@MovePlaceholderValue" selected>Move to&hellip;</option>
                                            @foreach (var target in groups.Where(candidate => candidate.OptionId != group.OptionId))
                                            {
                                                <option value="@target.OptionId">@target.Label</option>
                                            }
                                        </select>
                                    </div>
                                }
                                <button type="button" class="btn btn-sm btn-link" @onclick="() => AddRowToGroupAsync(groupByProperty, group.OptionId)" disabled="@IsBusy">
                                    <i class="bi bi-plus-lg me-1"></i>New
                                </button>
                            </div>
                        }
                    </div>
                }
            }
            else if (ActiveView is { Type: WikiDatabaseViewTypes.Calendar })
            {
                var dateProperty = Database.Properties.FirstOrDefault(property =>
                        property.Type == WikiDatabasePropertyTypes.Date
                        && property.Id.ToString() == ActiveViewConfig?.GroupByPropertyId)
                    ?? Database.Properties.FirstOrDefault(property => property.Type == WikiDatabasePropertyTypes.Date);
                if (dateProperty is null)
                {
                    <div class="text-secondary small">This Calendar view's Date property was removed or changed. Add a Date property to use it again.</div>
                }
                else
                {
                    var calendarRows = WikiDatabaseViewLogic.ApplyFilters(
                        Database.Rows.ToList(), Database.Properties.ToList(), ActiveViewConfig?.Filters ?? [], ActiveViewConfig?.FilterGroup);
                    calendarRows = WikiDatabaseViewLogic.ApplySort(
                        calendarRows, Database.Properties.ToList(), ActiveViewConfig?.Sorts ?? []);
                    var calendar = WikiDatabaseViewLogic.BuildCalendarMonth(calendarRows, dateProperty, _calendarMonth);
                    <div class="sentinel-db-calendar-toolbar">
                        <div class="d-flex align-items-center gap-1">
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="PreviousCalendarMonth" title="Previous month"><i class="bi bi-chevron-left"></i></button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ShowCurrentCalendarMonth">Today</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="NextCalendarMonth" title="Next month"><i class="bi bi-chevron-right"></i></button>
                        </div>
                        <strong>@calendar.Month.ToString("MMMM yyyy")</strong>
                        <span class="small text-secondary">@dateProperty.Name</span>
                    </div>
                    <div class="sentinel-db-calendar-scroll">
                        <div class="sentinel-db-calendar-weekdays" aria-hidden="true">
                            @foreach (var weekday in CalendarWeekdays)
                            {
                                <span>@weekday</span>
                            }
                        </div>
                        <div class="sentinel-db-calendar-grid">
                            @foreach (var day in calendar.Days)
                            {
                                <div class="sentinel-db-calendar-day @(!day.IsCurrentMonth ? "is-outside" : "") @(day.Date == DateOnly.FromDateTime(DateTime.Today) ? "is-today" : "")">
                                    <div class="sentinel-db-calendar-day-header">
                                        <span>@day.Date.Day</span>
                                        <button type="button" @onclick="() => AddRowOnDateAsync(dateProperty, day.Date)" disabled="@IsBusy" title="@($"Add row on {day.Date:MMM d}")">+</button>
                                    </div>
                                    <div class="sentinel-db-calendar-items">
                                        @foreach (var row in day.Rows)
                                        {
                                            <button type="button" class="sentinel-db-calendar-item" @onclick="() => OpenRow(row)">
                                                @(GetText(row, titleProperty) ?? "Untitled")
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    @if (calendar.UndatedRows.Count > 0)
                    {
                        <div class="sentinel-db-calendar-undated">
                            <span class="small text-secondary">No date</span>
                            @foreach (var row in calendar.UndatedRows)
                            {
                                <button type="button" @onclick="() => OpenRow(row)">@(GetText(row, titleProperty) ?? "Untitled")</button>
                            }
                        </div>
                    }
                }
            }
            else if (ActiveView is { Type: WikiDatabaseViewTypes.Gallery })
            {
                <div class="sentinel-db-gallery">
                    @foreach (var row in VisibleRows)
                    {
                        <button type="button" class="sentinel-db-gallery-card text-start" @onclick="() => OpenRow(row)">
                            <div class="sentinel-db-gallery-cover"><i class="bi bi-file-earmark-text"></i></div>
                            <div class="p-3">
                                <div class="fw-semibold text-truncate">@(GetText(row, titleProperty) ?? "Untitled")</div>
                                @foreach (var property in Database.Properties.Where(property => property.Id != titleProperty.Id).Take(3))
                                {
                                    var text = WikiPropertyValues.GetDisplayText(property, WikiPropertyValues.ParseObject(row.PropertyValuesJson), row.CreatedAt);
                                    @if (!string.IsNullOrWhiteSpace(text))
                                    {
                                        <div class="small text-secondary text-truncate mt-1">@property.Name: @text</div>
                                    }
                                }
                            </div>
                        </button>
                    }
                </div>
                <button type="button" class="btn btn-sm btn-outline-primary mt-3" @onclick="AddRowAsync" disabled="@IsBusy">
                    <i class="bi bi-plus-lg me-1"></i>New page
                </button>
            }
            else if (ActiveView is { Type: WikiDatabaseViewTypes.List })
            {
                <div class="list-group list-group-flush border rounded-3">
                    @foreach (var row in VisibleRows)
                    {
                        <button type="button" class="list-group-item list-group-item-action d-flex align-items-center gap-3" @onclick="() => OpenRow(row)">
                            <i class="bi bi-file-earmark-text text-secondary"></i>
                            <span class="fw-semibold text-truncate">@(GetText(row, titleProperty) ?? "Untitled")</span>
                            <span class="small text-secondary ms-auto">@row.UpdatedAt?.ToLocalTime().ToString("MMM d")</span>
                        </button>
                    }
                </div>
                <button type="button" class="btn btn-sm btn-outline-primary mt-3" @onclick="AddRowAsync" disabled="@IsBusy">
                    <i class="bi bi-plus-lg me-1"></i>New page
                </button>
            }
            else if (ActiveView is { } advancedView && IsAdvancedView(advancedView.Type))
            {
                <SentinelDatabaseAdvancedView Database="Database" View="advancedView"
                                              Config="@(ActiveViewConfig ?? WikiDatabaseViewConfig.Empty)"
                                              CanEdit="CanEdit"
                                              OnOpenRow="OpenRowById" OnChanged="AdvancedViewChangedAsync" />
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                @foreach (var property in Database.Properties.OrderBy(p => p.SortOrder))
                                {
                                    <th>@property.Name</th>
                                }
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rowDisplay in TableRows)
                            {
                                var row = rowDisplay.Row;
                                <tr>
                                    @foreach (var property in Database.Properties.OrderBy(p => p.SortOrder))
                                    {
                                        <td>
                                            @switch (property.Type)
                                            {
                                                case WikiDatabasePropertyTypes.Title:
                                                    <div class="d-flex align-items-center gap-1" style="padding-left:@(rowDisplay.Depth * 1.25)rem">
                                                        @if (rowDisplay.HasChildren)
                                                        {
                                                            <button type="button" class="btn btn-xs btn-link p-0 flex-shrink-0"
                                                                    @onclick="() => ToggleSubItems(row.Id)"
                                                                    aria-label="@(_collapsedSubItemRowIds.Contains(row.Id) ? "Expand sub-items" : "Collapse sub-items")"
                                                                    title="@(_collapsedSubItemRowIds.Contains(row.Id) ? "Expand sub-items" : "Collapse sub-items")">
                                                                <i class="bi @(_collapsedSubItemRowIds.Contains(row.Id) ? "bi-chevron-right" : "bi-chevron-down")"></i>
                                                            </button>
                                                        }
                                                        else if (rowDisplay.Depth > 0)
                                                        {
                                                            <i class="bi bi-arrow-return-right text-secondary small flex-shrink-0" aria-hidden="true"></i>
                                                        }
                                                        <input class="form-control form-control-sm" value="@GetText(row, property)" disabled="@IsBusy"
                                                               @onchange="e => SetTextAsync(row, property, e.Value?.ToString())" />
                                                    </div>
                                                    break;
                                                case WikiDatabasePropertyTypes.Text:
                                                case WikiDatabasePropertyTypes.Url:
                                                    <input class="form-control form-control-sm" value="@GetText(row, property)" disabled="@IsBusy"
                                                           @onchange="e => SetTextAsync(row, property, e.Value?.ToString())" />
                                                    break;
                                                case WikiDatabasePropertyTypes.Number:
                                                    <input type="number" class="form-control form-control-sm" value="@GetNumber(row, property)" disabled="@IsBusy"
                                                           @onchange="e => SetNumberAsync(row, property, e.Value?.ToString())" />
                                                    break;
                                                case WikiDatabasePropertyTypes.Checkbox:
                                                    <input type="checkbox" checked="@GetCheckbox(row, property)" disabled="@IsBusy"
                                                           @onchange="e => SetCheckboxAsync(row, property, (bool)(e.Value ?? false))" />
                                                    break;
                                                case WikiDatabasePropertyTypes.Date:
                                                    <input type="date" class="form-control form-control-sm" value="@GetDateInputValue(row, property)" disabled="@IsBusy"
                                                           @onchange="e => SetDateAsync(row, property, e.Value?.ToString())" />
                                                    break;
                                                case WikiDatabasePropertyTypes.Select:
                                                case WikiDatabasePropertyTypes.Status:
                                                    <select class="form-select form-select-sm" disabled="@IsBusy" @onchange="e => SetSelectAsync(row, property, e.Value?.ToString())">
                                                        <option value="">—</option>
                                                        @foreach (var option in WikiDatabasePropertyConfig.GetOptions(property))
                                                        {
                                                            <option value="@option.Id" selected="@(GetText(row, property) == option.Id)">@option.Label</option>
                                                        }
                                                    </select>
                                                    break;
                                                case WikiDatabasePropertyTypes.MultiSelect:
                                                    @foreach (var option in WikiDatabasePropertyConfig.GetOptions(property))
                                                    {
                                                        <div class="form-check form-check-inline">
                                                            <input class="form-check-input" type="checkbox" disabled="@IsBusy"
                                                                   checked="@GetMultiSelect(row, property).Contains(option.Id)"
                                                                   @onchange="e => ToggleMultiSelectAsync(row, property, option.Id, (bool)(e.Value ?? false))" />
                                                            <label class="form-check-label small">@option.Label</label>
                                                        </div>
                                                    }
                                                    break;
                                                case WikiDatabasePropertyTypes.Person:
                                                case WikiDatabasePropertyTypes.Files:
                                                    <input class="form-control form-control-sm" value="@string.Join(", ", GetMultiSelect(row, property))" disabled="@IsBusy"
                                                           @onchange="e => SetMultiValueAsync(row, property, e.Value?.ToString())" placeholder="Comma-separated values" />
                                                    break;
                                                case WikiDatabasePropertyTypes.Relation:
                                                    var relatedDatabase = GetRelatedDatabase(property);
                                                    var selectedRowIds = GetMultiSelect(row, property);
                                                    if (relatedDatabase is null)
                                                    {
                                                        <span class="small text-danger">Choose a related database</span>
                                                    }
                                                    else
                                                    {
                                                        <details class="sentinel-relation-picker">
                                                            <summary>@RelationSummary(relatedDatabase, selectedRowIds)</summary>
                                                            <div class="sentinel-relation-options">
                                                                @foreach (var relatedRow in relatedDatabase.Rows.OrderBy(candidate => candidate.SortOrder))
                                                                {
                                                                    var relatedTitle = GetDatabaseRowTitle(relatedDatabase, relatedRow);
                                                                    <label class="form-check mb-1">
                                                                        <input class="form-check-input" type="checkbox" checked="@selectedRowIds.Contains(relatedRow.Id.ToString())"
                                                                               @onchange="e => ToggleRelationAsync(row, property, relatedRow.Id, (bool)(e.Value ?? false))" disabled="@IsBusy" />
                                                                        <span class="form-check-label small">@relatedTitle</span>
                                                                    </label>
                                                                }
                                                                @if (relatedDatabase.Rows.Count == 0)
                                                                {
                                                                    <span class="small text-secondary">No rows are available in @relatedDatabase.Title.</span>
                                                                }
                                                            </div>
                                                        </details>
                                                    }
                                                    break;
                                                case WikiDatabasePropertyTypes.Place:
                                                    <input class="form-control form-control-sm" value="@GetText(row, property)" disabled="@IsBusy"
                                                           @onchange="e => SetTextAsync(row, property, e.Value?.ToString())" placeholder="Address or place" />
                                                    break;
                                                case WikiDatabasePropertyTypes.Email:
                                                    <input type="email" class="form-control form-control-sm" value="@GetText(row, property)" disabled="@IsBusy"
                                                           @onchange="e => SetTextAsync(row, property, e.Value?.ToString())" placeholder="name@example.com" />
                                                    break;
                                                case WikiDatabasePropertyTypes.Phone:
                                                    <input type="tel" class="form-control form-control-sm" value="@GetText(row, property)" disabled="@IsBusy"
                                                           @onchange="e => SetTextAsync(row, property, e.Value?.ToString())" placeholder="+1 555-0100" />
                                                    break;
                                                case WikiDatabasePropertyTypes.Formula:
                                                case WikiDatabasePropertyTypes.Rollup:
                                                    <span class="small text-secondary">@WikiPropertyValues.GetDisplayText(property, WikiPropertyValues.ParseObject(row.PropertyValuesJson), row.CreatedAt)</span>
                                                    break;
                                                case WikiDatabasePropertyTypes.CreatedTime:
                                                    <span class="small text-secondary">@row.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</span>
                                                    break;
                                                case WikiDatabasePropertyTypes.LastEditedTime:
                                                    <span class="small text-secondary">@(row.UpdatedAt ?? row.CreatedAt).ToLocalTime().ToString("MMM d, yyyy")</span>
                                                    break;
                                                case WikiDatabasePropertyTypes.CreatedBy:
                                                    <span class="small text-secondary">@row.CreatedBy</span>
                                                    break;
                                                case WikiDatabasePropertyTypes.LastEditedBy:
                                                    <span class="small text-secondary">@(row.UpdatedBy ?? row.CreatedBy)</span>
                                                    break;
                                                case WikiDatabasePropertyTypes.Button:
                                                    var buttonConfig = WikiDatabasePropertyConfig.Parse(property);
                                                    var buttonLabel = string.IsNullOrWhiteSpace(buttonConfig.ButtonLabel)
                                                        ? property.Name
                                                        : buttonConfig.ButtonLabel;
                                                    var isButtonRunning = _runningButtons.Contains((row.Id, property.Id));
                                                    <button type="button" class="btn btn-sm btn-outline-secondary"
                                                            disabled="@(IsBusy || !CanEdit || isButtonRunning || buttonConfig.AutomationWorkflowId is null)"
                                                            title="@(buttonConfig.AutomationWorkflowId is null ? "No automation selected for this button yet - configure it in the property editor." : $"Run '{buttonLabel}'")"
                                                            @onclick="() => RunButtonWorkflowAsync(row, property)">
                                                        @if (isButtonRunning)
                                                        {
                                                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                                        }
                                                        @buttonLabel
                                                    </button>
                                                    break;
                                                case WikiDatabasePropertyTypes.UniqueId:
                                                    <span class="small text-secondary">@WikiPropertyValues.GetDisplayText(property, WikiPropertyValues.ParseObject(row.PropertyValuesJson), row.CreatedAt)</span>
                                                    break;
                                                case WikiDatabasePropertyTypes.Verification:
                                                    var verification = WikiPropertyValues.GetVerification(WikiPropertyValues.ParseObject(row.PropertyValuesJson), property.Id);
                                                    var isVerified = verification.Status == WikiVerificationState.Verified;
                                                    <button type="button" class="btn btn-sm @(isVerified ? "btn-success" : "btn-outline-secondary")" disabled="@IsBusy"
                                                            title="@(isVerified ? $"Verified by {verification.VerifiedBy}" : "Mark as verified")"
                                                            @onclick="() => SetVerificationAsync(row, property, !isVerified)">
                                                        <i class="bi @(isVerified ? "bi-patch-check-fill" : "bi-patch-check")"></i>
                                                        @(isVerified ? "Verified" : "Not verified")
                                                    </button>
                                                    break;
                                                case WikiDatabasePropertyTypes.AiField:
                                                    var aiValue = GetText(row, property);
                                                    var isAiFieldRunning = _runningAiFields.Contains((row.Id, property.Id));
                                                    var aiFieldConfig = WikiDatabasePropertyConfig.Parse(property);
                                                    var aiFieldNotConfigured = string.IsNullOrWhiteSpace(aiFieldConfig.AiPromptTemplate) || string.IsNullOrWhiteSpace(aiFieldConfig.AiModel);
                                                    <div class="d-flex align-items-center gap-2">
                                                        @if (!string.IsNullOrWhiteSpace(aiValue))
                                                        {
                                                            <span class="small text-truncate" style="max-width:16rem;" title="@aiValue">@aiValue</span>
                                                        }
                                                        <button type="button" class="btn btn-xs btn-link p-0 flex-shrink-0"
                                                                disabled="@(IsBusy || !CanEdit || isAiFieldRunning || aiFieldNotConfigured)"
                                                                title="@(aiFieldNotConfigured ? "Set a prompt and model in the property editor first." : "Generate with AI")"
                                                                @onclick="() => GenerateAiFieldAsync(row, property)">
                                                            @if (isAiFieldRunning)
                                                            {
                                                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-stars me-1"></i>
                                                            }
                                                            @(string.IsNullOrWhiteSpace(aiValue) ? "Generate" : "Regenerate")
                                                        </button>
                                                    </div>
                                                    break;
                                            }
                                        </td>
                                    }
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <button type="button" class="btn btn-xs btn-link p-0" @onclick="() => OpenRow(row)" disabled="@IsBusy">Open</button>
                                            <button type="button" class="btn btn-xs btn-link p-0" @onclick="() => AddSubItemAsync(row)" disabled="@IsBusy" title="Add a row nested beneath this one">
                                                <i class="bi bi-node-plus me-1"></i>Sub-item
                                            </button>
                                            <button type="button" class="btn btn-xs btn-link p-0" @onclick="() => RequestAutofillAsync(row)" disabled="@(IsBusy || !CanEdit)" title="Suggest values for this row's empty properties with SentinelGPT">
                                                <i class="bi bi-magic me-1"></i>Autofill
                                            </button>
                                            <button type="button" class="btn btn-xs btn-link text-danger p-0" @onclick="() => TrashRowAsync(row)" disabled="@IsBusy" title="Move to Trash">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                @foreach (var property in Database.Properties.OrderBy(p => p.SortOrder))
                                {
                                    <td>
                                        <select class="form-select form-select-sm sentinel-db-calculation"
                                                value="@CalculationFor(property)"
                                                @onchange="e => SetCalculationAsync(property, e.Value?.ToString())"
                                                disabled="@IsBusy"
                                                aria-label="@($"Calculate {property.Name}")">
                                            <option value="">Calculate</option>
                                            <option value="count">Count values</option>
                                            @if (SupportsNumericCalculation(property))
                                            {
                                                <option value="sum">Sum</option>
                                                <option value="average">Average</option>
                                                <option value="minimum">Minimum</option>
                                                <option value="maximum">Maximum</option>
                                            }
                                        </select>
                                        @if (!string.IsNullOrWhiteSpace(CalculationFor(property)))
                                        {
                                            <div class="small fw-semibold mt-1">@CalculationText(property)</div>
                                        }
                                    </td>
                                }
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddRowAsync" disabled="@IsBusy">
                    <i class="bi bi-plus-lg me-1"></i>New row
                </button>
            }
        </div>
    </div>
}

@if (Database is not null && _openRow is not null)
{
    <SentinelDatabaseRowPage Database="Database"
                             Row="_openRow"
                             OpenMode="@ActiveOpenPageMode"
                             PageProperties="@VisiblePageProperties"
                             OnSaved="RowPageSavedAsync"
                             OnClose="CloseRow"
                             OnOpenPage="OnOpenPage" />
}

@code {
    [Parameter, EditorRequired] public Guid WikiDatabaseId { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback<Guid> OnDuplicated { get; set; }
    [Parameter] public EventCallback<Guid> OnOpenPage { get; set; }
    // Set by a caller (e.g. Wiki.razor when a wiki-embedded inline Kanban card is clicked)
    // to open straight to a specific row's detail panel instead of just the database.
    [Parameter] public Guid? InitialOpenRowId { get; set; }
    // Defaults true so callers that don't pass it (there are none today besides Wiki.razor,
    // but a default here still matters for anything added later) get the pre-existing
    // unrestricted behavior rather than silently locking themselves out. Wiki.razor computes
    // the real value from SentinelAccessService before rendering this component - see
    // OpenDatabaseAsync.
    [Parameter] public bool CanEdit { get; set; } = true;

    private Guid? _appliedInitialOpenRowId;

    private static readonly IReadOnlyList<string> AddablePropertyTypes =
    [
        WikiDatabasePropertyTypes.Text, WikiDatabasePropertyTypes.Number, WikiDatabasePropertyTypes.Select,
        WikiDatabasePropertyTypes.MultiSelect, WikiDatabasePropertyTypes.Status, WikiDatabasePropertyTypes.Date,
        WikiDatabasePropertyTypes.Checkbox, WikiDatabasePropertyTypes.Url, WikiDatabasePropertyTypes.Email,
        WikiDatabasePropertyTypes.Phone, WikiDatabasePropertyTypes.Person, WikiDatabasePropertyTypes.Files,
        WikiDatabasePropertyTypes.Place, WikiDatabasePropertyTypes.Formula, WikiDatabasePropertyTypes.Relation,
        WikiDatabasePropertyTypes.Rollup, WikiDatabasePropertyTypes.Button, WikiDatabasePropertyTypes.CreatedTime,
        WikiDatabasePropertyTypes.LastEditedTime, WikiDatabasePropertyTypes.CreatedBy, WikiDatabasePropertyTypes.LastEditedBy,
        WikiDatabasePropertyTypes.UniqueId, WikiDatabasePropertyTypes.Verification, WikiDatabasePropertyTypes.AiField
    ];
    private static readonly IReadOnlyList<(string Type, string Name)> AdvancedViewOptions =
    [
        (WikiDatabaseViewTypes.Timeline, "Timeline"),
        (WikiDatabaseViewTypes.Chart, "Chart"),
        (WikiDatabaseViewTypes.Form, "Form"),
        (WikiDatabaseViewTypes.Map, "Map"),
        (WikiDatabaseViewTypes.Feed, "Feed"),
        (WikiDatabaseViewTypes.Dashboard, "Dashboard")
    ];
    private static readonly IReadOnlyList<string> CalendarWeekdays = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

    private WikiDatabase? Database;
    private bool _loading = true;
    private bool IsBusy;
    private string ErrorMessage = string.Empty;
    // Tracks in-flight Button-property automation runs so the clicked button can show a spinner
    // and every button stays disabled against a double-fire while its own run is in progress -
    // keyed per (row, property) rather than a single flag since a table can have several rows
    // with Button properties open at once.
    private readonly HashSet<(Guid RowId, Guid PropertyId)> _runningButtons = [];
    // Same per-(row, property) double-fire guard, for AI field "Generate" cells.
    private readonly HashSet<(Guid RowId, Guid PropertyId)> _runningAiFields = [];
    // DatabaseAutofill review state - one row at a time, mirroring the rest of SentinelGPT's
    // "suggest, then a human approves" pattern rather than writing model output straight to the
    // row. Selection defaults to every suggestion checked (see RequestAutofillAsync).
    private WikiDatabaseRow? _autofillRow;
    private IReadOnlyList<DatabaseAutofillSuggestion> _autofillSuggestions = [];
    private IReadOnlyList<string> _autofillWarnings = [];
    private HashSet<Guid> _autofillSelectedPropertyIds = [];
    private bool _showProperties;
    private bool _showRowTemplates;
    private bool _showCsvImport;
    private bool _showTrashedRows;
    private List<WikiDatabaseRow> TrashedRows { get; set; } = new();
    private List<WikiDatabaseRowTemplate> RowTemplates { get; set; } = new();
    private string _newRowTemplateName = string.Empty;
    private Guid? _rowTemplateSourceRowId;
    private WikiDatabaseCsvImportResult? _csvImportResult;
    private string _schemaPushMessage = string.Empty;
    private bool _schemaPushSucceeded;
    private Guid? _activeViewId;
    private Guid? _draggedRowId;
    private WikiDatabaseRow? _openRow;
    private readonly HashSet<Guid> _collapsedSubItemRowIds = [];
    private string _title = string.Empty;
    private string _titleIcon = string.Empty;
    private string _newPropertyName = string.Empty;
    private string _newPropertyType = WikiDatabasePropertyTypes.Text;
    private string _newFormulaExpression = "0";
    private Guid? _newRelatedDatabaseId;
    private bool _newReciprocalRelationEnabled;
    private string _newReciprocalPropertyName = string.Empty;
    private string _newButtonLabel = "Run";
    private Guid? _newAutomationWorkflowId;
    private string _newUniqueIdPrefix = string.Empty;
    private string _newAiPromptTemplate = string.Empty;
    private string _newAiModel = string.Empty;
    private List<WikiDatabase> _databaseChoices = [];
    private List<AutomationWorkflowSummary> _workflowChoices = [];
    private readonly Dictionary<Guid, WikiDatabase> _relatedDatabases = [];
    private DateOnly _calendarMonth = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private Guid _filterPropertyId;
    private string _filterOperator = "contains";
    private string _filterValue = string.Empty;
    private Guid _sortPropertyId;
    private string _sortDirection = "ascending";

    private WikiDatabaseView? ActiveView =>
        Database?.Views.FirstOrDefault(v => v.Id == _activeViewId) ?? Database?.Views.OrderBy(v => v.SortOrder).FirstOrDefault();
    // Personal overrides only ever replace Filters/Sorts/FilterGroup - every other view setting
    // (grouping, page property order, calculations, etc.) always comes from the shared config.
    private WikiDatabaseViewConfig? ActiveViewConfig => ActiveView is null
        ? null
        : _personalOverride is { } personal
            ? WikiDatabaseViewConfigJson.Parse(ActiveView.ConfigJson) with
            {
                Filters = personal.Filters,
                Sorts = personal.Sorts,
                FilterGroup = personal.FilterGroup
            }
            : WikiDatabaseViewConfigJson.Parse(ActiveView.ConfigJson);
    private WikiDatabaseViewConfig? _personalOverride;
    private bool HasPersonalOverride => _personalOverride is not null;
    private string ActiveOpenPageMode => ActiveView is null
        ? WikiDatabaseOpenPageModes.SidePeek
        : WikiDatabaseOpenPageModes.Resolve(ActiveViewConfig?.OpenPageMode, ActiveView.Type);
    private IReadOnlyList<WikiDatabaseProperty> PageProperties => Database is null
        ? []
        : WikiDatabasePagePresentation.OrderProperties(
            Database.Properties.ToList(),
            ActiveViewConfig ?? WikiDatabaseViewConfig.Empty);
    private IReadOnlyList<WikiDatabaseProperty> VisiblePageProperties => Database is null
        ? []
        : WikiDatabasePagePresentation.VisibleProperties(
            Database.Properties.ToList(),
            ActiveViewConfig ?? WikiDatabaseViewConfig.Empty);
    private IReadOnlyList<WikiDatabaseProperty> RelationProperties =>
        Database?.Properties.Where(property => property.Type == WikiDatabasePropertyTypes.Relation).OrderBy(property => property.SortOrder).ToList() ?? [];
    private IReadOnlyList<WikiDatabaseProperty> FilterableProperties =>
        Database?.Properties.Where(property => property.Type is
                WikiDatabasePropertyTypes.Title or WikiDatabasePropertyTypes.Text or WikiDatabasePropertyTypes.Url
                or WikiDatabasePropertyTypes.Number or WikiDatabasePropertyTypes.Select
                or WikiDatabasePropertyTypes.Checkbox or WikiDatabasePropertyTypes.Date
                or WikiDatabasePropertyTypes.Formula or WikiDatabasePropertyTypes.Rollup)
            .OrderBy(property => property.SortOrder).ToList() ?? [];
    private WikiDatabaseProperty? SelectedFilterProperty =>
        FilterableProperties.FirstOrDefault(property => property.Id == _filterPropertyId);
    private IReadOnlyList<(string Value, string Label)> FilterOperators => SelectedFilterProperty?.Type switch
    {
        WikiDatabasePropertyTypes.Checkbox =>
            [("isChecked", "Is checked"), ("isNotChecked", "Is not checked")],
        WikiDatabasePropertyTypes.Number or WikiDatabasePropertyTypes.Formula or WikiDatabasePropertyTypes.Rollup =>
            [("equals", "Equals"), ("greaterThan", "Greater than"), ("lessThan", "Less than")],
        WikiDatabasePropertyTypes.Date =>
            [("equals", "Is"), ("before", "Before"), ("after", "After")],
        WikiDatabasePropertyTypes.Select =>
            [("equals", "Is")],
        _ => [("contains", "Contains"), ("equals", "Equals")]
    };
    private bool FilterNeedsNoValue => SelectedFilterProperty?.Type == WikiDatabasePropertyTypes.Checkbox;
    private string FilterValueInputType => SelectedFilterProperty?.Type switch
    {
        WikiDatabasePropertyTypes.Number or WikiDatabasePropertyTypes.Formula or WikiDatabasePropertyTypes.Rollup => "number",
        WikiDatabasePropertyTypes.Date => "date",
        _ => "text"
    };
    private string FilterValuePlaceholder => FilterNeedsNoValue ? "No value needed" : "Value";
    private int UnpushedPropertyCount => Database?.Properties.Count(
        property => property.NotionId is null && property.Type != WikiDatabasePropertyTypes.Title) ?? 0;
    private IReadOnlyList<WikiDatabaseRow> VisibleRows
    {
        get
        {
            if (Database is null) return [];
            var config = ActiveViewConfig ?? WikiDatabaseViewConfig.Empty;
            var filtered = WikiDatabaseViewLogic.ApplyFilters(
                Database.Rows.ToList(), Database.Properties.ToList(), config.Filters, config.FilterGroup);
            return WikiDatabaseViewLogic.ApplySort(filtered, Database.Properties.ToList(), config.Sorts);
        }
    }
    private IReadOnlyList<SubItemRowDisplay> TableRows
    {
        get
        {
            var rows = VisibleRows;
            if (rows.Count == 0)
            {
                return [];
            }

            var rowIds = rows.Select(row => row.Id).ToHashSet();
            var childrenByParent = rows
                .Where(row => row.ParentRowId is { } parentRowId && rowIds.Contains(parentRowId))
                .GroupBy(row => row.ParentRowId!.Value)
                .ToDictionary(group => group.Key, group => group.ToList());
            var result = new List<SubItemRowDisplay>(rows.Count);
            var visited = new HashSet<Guid>();

            foreach (var root in rows.Where(row => row.ParentRowId is null || !rowIds.Contains(row.ParentRowId.Value)))
            {
                AppendSubItemRow(root, 0, childrenByParent, visited, result);
            }

            // The service rejects cycles, but keep malformed legacy/imported data visible
            // rather than losing it from the table if a cycle ever reaches storage.
            foreach (var unvisited in rows.Where(row => !visited.Contains(row.Id)))
            {
                AppendSubItemRow(unvisited, 0, childrenByParent, visited, result);
            }
            return result;
        }
    }

    private void AppendSubItemRow(
        WikiDatabaseRow row,
        int depth,
        IReadOnlyDictionary<Guid, List<WikiDatabaseRow>> childrenByParent,
        HashSet<Guid> visited,
        List<SubItemRowDisplay> result)
    {
        if (!visited.Add(row.Id))
        {
            return;
        }

        var hasChildren = childrenByParent.TryGetValue(row.Id, out var children) && children.Count > 0;
        result.Add(new SubItemRowDisplay(row, depth, hasChildren));
        if (!hasChildren || _collapsedSubItemRowIds.Contains(row.Id))
        {
            return;
        }
        foreach (var child in children!)
        {
            AppendSubItemRow(child, depth + 1, childrenByParent, visited, result);
        }
    }

    private sealed record SubItemRowDisplay(WikiDatabaseRow Row, int Depth, bool HasChildren);

    protected override async Task OnParametersSetAsync()
    {
        if (Database?.Id != WikiDatabaseId)
        {
            _activeViewId = null;
            await ReloadAsync();
        }

        if (InitialOpenRowId is { } rowId && rowId != _appliedInitialOpenRowId)
        {
            _appliedInitialOpenRowId = rowId;
            OpenRowById(rowId);
        }
    }

    private Task<string> CurrentUserNameAsync() => CurrentUserAccessor.GetCurrentUsernameAsync();

    private async Task LoadPersonalOverrideAsync()
    {
        _personalOverride = ActiveView is null
            ? null
            : await WikiDatabaseService.GetPersonalViewOverrideAsync(ActiveView.Id, await CurrentUserNameAsync());
    }

    private async Task SelectViewAsync(Guid viewId)
    {
        _activeViewId = viewId;
        await LoadPersonalOverrideAsync();
    }

    private async Task EnablePersonalFiltersAsync()
    {
        if (ActiveView is not { } activeView) return;
        await Work(async () =>
        {
            var user = await CurrentUserNameAsync();
            var shared = WikiDatabaseViewConfigJson.Parse(activeView.ConfigJson);
            _personalOverride = await WikiDatabaseService.SavePersonalViewOverrideAsync(
                activeView.Id, shared, user);
        });
    }

    private async Task DisablePersonalFiltersAsync()
    {
        if (ActiveView is not { } activeView) return;
        await Work(async () =>
        {
            await WikiDatabaseService.ClearPersonalViewOverrideAsync(activeView.Id, await CurrentUserNameAsync());
            _personalOverride = null;
        });
    }

    private async Task ReloadAsync()
    {
        try
        {
            Database = await WikiDatabaseService.GetDatabaseAsync(WikiDatabaseId);
            _databaseChoices = (await WikiDatabaseService.ListDatabasesAsync()).OrderBy(database => database.Title).ToList();
            _workflowChoices = (await AutomationWorkflowService.ListAsync()).OrderBy(workflow => workflow.Name).ToList();
            if (Database is not null)
            {
                _title = Database.Title;
                _titleIcon = Database.Icon ?? string.Empty;
                if (_activeViewId is null || Database.Views.All(v => v.Id != _activeViewId))
                {
                    _activeViewId = Database.Views.OrderBy(v => v.SortOrder).FirstOrDefault()?.Id;
                }
                await LoadRelatedDatabasesAsync();
                _newRelatedDatabaseId ??= _databaseChoices.FirstOrDefault()?.Id;
                _filterPropertyId = FilterableProperties.FirstOrDefault()?.Id ?? Guid.Empty;
                _sortPropertyId = Database.Properties.OrderBy(property => property.SortOrder).FirstOrDefault()?.Id ?? Guid.Empty;
                _filterOperator = FilterOperators.FirstOrDefault().Value ?? "contains";
                _filterValue = SelectedFilterProperty?.Type == WikiDatabasePropertyTypes.Select
                    ? WikiDatabasePropertyConfig.GetOptions(SelectedFilterProperty).FirstOrDefault()?.Id ?? string.Empty
                    : string.Empty;
                TrashedRows = (await WikiDatabaseService.ListTrashedRowsAsync(WikiDatabaseId)).ToList();
                RowTemplates = (await WikiDatabaseService.ListRowTemplatesAsync(WikiDatabaseId)).ToList();
                if (_rowTemplateSourceRowId is null || Database.Rows.All(row => row.Id != _rowTemplateSourceRowId))
                {
                    _rowTemplateSourceRowId = Database.Rows.OrderBy(row => row.SortOrder).FirstOrDefault()?.Id;
                }
                await LoadPersonalOverrideAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to load wiki database {WikiDatabaseId}.", WikiDatabaseId);
            ErrorMessage = $"Unable to load database. {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task Work(Func<Task> action)
    {
        IsBusy = true;
        ErrorMessage = string.Empty;
        try
        {
            // Covers the large majority of this component's mutations (property/view/row
            // edits all route through Work) in one place rather than checking CanEdit
            // individually in every method - see the Parameter's own comment for where this
            // value comes from.
            if (!CanEdit)
            {
                throw new UnauthorizedAccessException("You don't have permission to edit this Sentinel database.");
            }
            await action();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Wiki database operation failed for {WikiDatabaseId}.", WikiDatabaseId);
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }

