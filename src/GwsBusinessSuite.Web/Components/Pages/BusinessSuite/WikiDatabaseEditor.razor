                WikiDatabaseId,
                activeView.Id,
                name,
                activeView.Type,
                ActiveViewConfig ?? WikiDatabaseViewConfig.Empty,
                await CurrentUserNameAsync());
            activeView.Name = savedView.Name;
            await OnChanged.InvokeAsync();
        });
    }

