    // A value no real Select option can ever have (see the <select>'s own comment), used to
    // tell "nothing chosen yet" apart from the "No status" column, whose real OptionId is "".
    private const string MovePlaceholderValue = "__wiki-db-board-move-placeholder__";

    // Keyboard/screen-reader equivalent of DropOnColumnAsync's drag-and-drop - same underlying
    // move (append to the end of the target column), just triggered from the per-card <select>
    // instead of a drop event.
    private async Task MoveRowToOptionAsync(WikiDatabaseRow row, WikiDatabaseProperty groupByProperty, string optionId)
    {
        if (optionId == MovePlaceholderValue)
        {
            return;
        }

        await Work(async () =>
        {
            var user = await CurrentUserNameAsync();
            await WikiDatabaseService.MoveRowAsync(WikiDatabaseId, row.Id, groupByProperty.Id, string.IsNullOrEmpty(optionId) ? null : optionId, int.MaxValue, user);
            await ReloadAsync();
        });
    }

    private async Task SaveRowValueAsync(WikiDatabaseRow row, Action<JsonObject> mutate) => await Work(async () =>
    {
        var values = WikiPropertyValues.ParseObject(row.PropertyValuesJson);
        mutate(values);
        var user = await CurrentUserNameAsync();
        var editor = new WikiDatabaseRowEditor
        {
            Id = row.Id,
            ParentRowId = row.ParentRowId,
            Values = values.ToDictionary(kv => kv.Key, kv => kv.Value)
        };
        await WikiDatabaseService.SaveRowAsync(WikiDatabaseId, editor, user);
        await ReloadAsync();
    });

