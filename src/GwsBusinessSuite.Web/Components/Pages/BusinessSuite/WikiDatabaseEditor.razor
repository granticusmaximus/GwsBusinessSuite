    private async Task SetOpenPageModeAsync(string openPageMode)
    {
        if (ActiveView is not { } activeView)
        {
            return;
        }

        var normalizedMode = WikiDatabaseOpenPageModes.Resolve(openPageMode, activeView.Type);
        if (normalizedMode == ActiveOpenPageMode)
        {
            return;
        }

        await UpdateActiveViewConfigAsync(config => config with
        {
            OpenPageMode = normalizedMode
        });
    }

    private bool IsPagePropertyVisible(WikiDatabaseProperty property) =>
        !(ActiveViewConfig?.HiddenPagePropertyIds ?? []).Contains(property.Id.ToString(), StringComparer.Ordinal);

    private Task SetPagePropertyVisibilityAsync(WikiDatabaseProperty property, bool visible) =>
        UpdateActiveViewConfigAsync(config =>
        {
            var hidden = (config.HiddenPagePropertyIds ?? []).ToHashSet(StringComparer.Ordinal);
            if (visible)
            {
                hidden.Remove(property.Id.ToString());
            }
            else
            {
                hidden.Add(property.Id.ToString());
            }

            var knownIds = PageProperties.Select(item => item.Id.ToString()).ToList();
            var orderedHidden = knownIds.Where(hidden.Contains)
                .Concat(hidden.Where(propertyId => !knownIds.Contains(propertyId, StringComparer.Ordinal)))
                .ToList();
            return config with { HiddenPagePropertyIds = orderedHidden };
        });

    private Task MovePagePropertyAsync(WikiDatabaseProperty property, int offset) =>
        UpdateActiveViewConfigAsync(config =>
        {
            var order = PageProperties.Select(item => item.Id.ToString()).ToList();
            var index = order.IndexOf(property.Id.ToString());
            var targetIndex = index + offset;
            if (index < 0 || targetIndex < 0 || targetIndex >= order.Count)
            {
                return config;
            }

            (order[index], order[targetIndex]) = (order[targetIndex], order[index]);
            return config with { PagePropertyOrder = order };
        });

    private async Task UpdateActiveViewConfigAsync(Func<WikiDatabaseViewConfig, WikiDatabaseViewConfig> update)
    {
        if (ActiveView is not { } activeView)
        {
            return;
        }

        await Work(async () =>
        {
            var updatedConfig = update(WikiDatabaseViewConfigJson.Parse(activeView.ConfigJson));
            var savedView = await WikiDatabaseService.SaveViewAsync(
                WikiDatabaseId,
                activeView.Id,
                activeView.Name,
                activeView.Type,
                updatedConfig,
                await CurrentUserNameAsync());
            activeView.ConfigJson = savedView.ConfigJson;
            await OnChanged.InvokeAsync();
        });
    }

    // Filters/Sorts/FilterGroup specifically: when this view is personalized, mutations write
    // to this user's own override instead of the shared WikiDatabaseView every other user sees.
    // Every other config aspect (grouping, page property order, etc.) always goes through
    // UpdateActiveViewConfigAsync above and stays shared.
    private async Task UpdateFilterSortConfigAsync(Func<WikiDatabaseViewConfig, WikiDatabaseViewConfig> update)
    {
        if (ActiveView is not { } activeView)
        {
            return;
        }

        if (!HasPersonalOverride)
        {
            await UpdateActiveViewConfigAsync(update);
            return;
        }

        await Work(async () =>
        {
            var updatedConfig = update(ActiveViewConfig ?? WikiDatabaseViewConfig.Empty);
            _personalOverride = await WikiDatabaseService.SavePersonalViewOverrideAsync(
                activeView.Id, updatedConfig, await CurrentUserNameAsync());
        });
    }

    private async Task RenameActiveViewAsync(string name)
    {
        if (ActiveView is not { } activeView || string.IsNullOrWhiteSpace(name)) return;
        await Work(async () =>
