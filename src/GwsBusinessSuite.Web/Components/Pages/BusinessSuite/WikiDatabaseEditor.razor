    private async Task AddFilterAsync()
    {
        var property = SelectedFilterProperty;
        if (property is null) return;
        var supportedOperators = FilterOperators.Select(item => item.Value).ToHashSet(StringComparer.Ordinal);
        var filterOperator = supportedOperators.Contains(_filterOperator)
            ? _filterOperator
            : FilterOperators[0].Value;
        var filterValue = FilterNeedsNoValue ? string.Empty : _filterValue.Trim();
        await UpdateFilterSortConfigAsync(config => config with
        {
            Filters = config.Filters.Concat(
                [new WikiDatabaseFilter(property.Id.ToString(), filterOperator, filterValue)]).ToList()
        });
        _filterOperator = FilterOperators[0].Value;
        _filterValue = property.Type == WikiDatabasePropertyTypes.Select
            ? WikiDatabasePropertyConfig.GetOptions(property).FirstOrDefault()?.Id ?? string.Empty
            : string.Empty;
    }

    private Task RemoveFilterAsync(WikiDatabaseFilter filter) =>
        UpdateFilterSortConfigAsync(config => config with
        {
            Filters = config.Filters.Where(candidate => candidate != filter).ToList()
        });

    private Task UpdateFilterGroupAsync(WikiDatabaseFilterGroup updated) =>
        UpdateFilterSortConfigAsync(config => config with { FilterGroup = updated });

    private Task ClearFilterGroupAsync() =>
        UpdateFilterSortConfigAsync(config => config with { FilterGroup = null });

    private async Task AddSortAsync()
    {
        if (_sortPropertyId == Guid.Empty) return;
        await UpdateFilterSortConfigAsync(config => config with
        {
            Sorts = config.Sorts
                .Where(sort => sort.PropertyId != _sortPropertyId.ToString())
                .Append(new WikiDatabaseSort(_sortPropertyId.ToString(), _sortDirection))
                .ToList()
        });
    }

    private Task RemoveSortAsync(WikiDatabaseSort sort) =>
        UpdateFilterSortConfigAsync(config => config with
        {
            Sorts = config.Sorts.Where(candidate => candidate != sort).ToList()
        });

    private Task SetCalculationAsync(WikiDatabaseProperty property, string? calculation) =>
        UpdateActiveViewConfigAsync(config =>
        {
            var calculations = (config.Calculations ?? new Dictionary<string, string>())
                .ToDictionary(item => item.Key, item => item.Value, StringComparer.Ordinal);
            if (string.IsNullOrWhiteSpace(calculation))
            {
                calculations.Remove(property.Id.ToString());
            }
            else
            {
                calculations[property.Id.ToString()] = calculation;
            }
            return config with { Calculations = calculations };
        });

    private string CalculationFor(WikiDatabaseProperty property) =>
        (ActiveViewConfig?.Calculations ?? new Dictionary<string, string>())
            .GetValueOrDefault(property.Id.ToString(), string.Empty);

    private static bool SupportsNumericCalculation(WikiDatabaseProperty property) =>
        property.Type is WikiDatabasePropertyTypes.Number or WikiDatabasePropertyTypes.Formula or WikiDatabasePropertyTypes.Rollup;

    private string CalculationText(WikiDatabaseProperty property)
    {
        var calculation = CalculationFor(property);
        var values = VisibleRows.Select(row => CalculationValue(property, row)).Where(value => value.HasValue)
            .Select(value => value!.Value).ToList();
        return calculation switch
        {
            "count" => $"{VisibleRows.Count(row => !string.IsNullOrWhiteSpace(WikiPropertyValues.GetDisplayText(property, WikiPropertyValues.ParseObject(row.PropertyValuesJson), row.CreatedAt)))} values",
            "sum" => values.Sum().ToString("0.##"),
            "average" => values.Count == 0 ? "—" : values.Average().ToString("0.##"),
            "minimum" => values.Count == 0 ? "—" : values.Min().ToString("0.##"),
            "maximum" => values.Count == 0 ? "—" : values.Max().ToString("0.##"),
            _ => string.Empty
        };
    }

    private static decimal? CalculationValue(WikiDatabaseProperty property, WikiDatabaseRow row)
    {
        var values = WikiPropertyValues.ParseObject(row.PropertyValuesJson);
        if (property.Type == WikiDatabasePropertyTypes.Number)
        {
            return WikiPropertyValues.GetNumber(values, property.Id);
        }
        return WikiPropertyValues.GetComputedValue(values, property.Id) is decimal computed ? computed : null;
    }

