    private async Task RunButtonWorkflowAsync(WikiDatabaseRow row, WikiDatabaseProperty property)
    {
        if (WikiDatabasePropertyConfig.Parse(property).AutomationWorkflowId is not { } workflowId)
        {
            return;
        }

        var key = (row.Id, property.Id);
        if (!_runningButtons.Add(key))
        {
            return;
        }
        StateHasChanged();

        await Work(async () =>
        {
            // Same payload shape as database.rowChangedTrigger's own input (see
            // WikiDatabaseService.SaveRowAsync) so a workflow author can reuse expressions like
            // {{ $json.rowId }} regardless of whether it's wired to run from a row edit or a
            // Button click.
            var payload = new JsonObject
            {
                ["wikiDatabaseId"] = WikiDatabaseId.ToString(),
                ["rowId"] = row.Id.ToString(),
                ["values"] = WikiPropertyValues.ParseObject(row.PropertyValuesJson)
            };
            var execution = await AutomationExecutionService.ExecuteAsync(
                workflowId, payload.ToJsonString(), AutomationExecutionModes.Manual);
            if (execution.Status == AutomationExecutionStatuses.Failed)
            {
                throw new InvalidOperationException(string.IsNullOrWhiteSpace(execution.ErrorMessage)
                    ? "The automation failed."
                    : execution.ErrorMessage);
            }
            // A database.setRowProperty action further along the workflow may have written back
            // to this row (or another one) - refresh so the table reflects it immediately rather
            // than waiting for the next unrelated reload.
            await ReloadAsync();
        });

        _runningButtons.Remove(key);
        StateHasChanged();
    }

