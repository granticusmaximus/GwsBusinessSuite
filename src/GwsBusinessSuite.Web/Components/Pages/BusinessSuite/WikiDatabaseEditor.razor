    private Task ToggleMultiSelectAsync(WikiDatabaseRow row, WikiDatabaseProperty property, string optionId, bool isChecked)
    {
        var current = WikiPropertyValues.GetMultiSelect(WikiPropertyValues.ParseObject(row.PropertyValuesJson), property.Id).ToList();
        if (isChecked)
        {
            if (!current.Contains(optionId)) current.Add(optionId);
        }
        else
        {
            current.Remove(optionId);
        }

        return SaveRowValueAsync(row, values => WikiPropertyValues.SetMultiSelect(values, property.Id, current));
    }

    private Task ToggleRelationAsync(WikiDatabaseRow row, WikiDatabaseProperty property, Guid relatedRowId, bool isChecked)
    {
        var relationId = relatedRowId.ToString();
        var current = GetMultiSelect(row, property).ToList();
        if (isChecked)
        {
            if (!current.Contains(relationId)) current.Add(relationId);
        }
        else
        {
            current.Remove(relationId);
        }

        return SaveRowValueAsync(row, values => WikiPropertyValues.SetMultiSelect(values, property.Id, current));
    }

    private async Task LoadRelatedDatabasesAsync()
    {
        _relatedDatabases.Clear();
        if (Database is null) return;

        _relatedDatabases[Database.Id] = Database;
        var targetIds = Database.Properties
            .Where(property => property.Type == WikiDatabasePropertyTypes.Relation)
            .Select(property => WikiDatabasePropertyConfig.Parse(property).RelatedDatabaseId)
            .Where(id => id.HasValue && id.Value != Database.Id)
            .Select(id => id!.Value)
            .Distinct();
        foreach (var targetId in targetIds)
        {
            if (await WikiDatabaseService.GetDatabaseAsync(targetId) is { } relatedDatabase)
            {
                _relatedDatabases[targetId] = relatedDatabase;
            }
        }
    }

    private WikiDatabase? GetRelatedDatabase(WikiDatabaseProperty relationProperty)
    {
        var relatedDatabaseId = WikiDatabasePropertyConfig.Parse(relationProperty).RelatedDatabaseId;
        return relatedDatabaseId is { } id && _relatedDatabases.TryGetValue(id, out var database) ? database : null;
    }

    private IReadOnlyList<WikiDatabaseProperty> GetRollupTargetProperties(WikiDatabaseProperty? relationProperty) =>
        relationProperty is null
            ? []
            : GetRelatedDatabase(relationProperty)?.Properties.OrderBy(property => property.SortOrder).ToList() ?? [];

