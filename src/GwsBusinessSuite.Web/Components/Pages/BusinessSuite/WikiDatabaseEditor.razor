    private async Task AddFilterAsync()
    {
        var property = SelectedFilterProperty;
        if (property is null) return;
        var supportedOperators = FilterOperators.Select(item => item.Value).ToHashSet(StringComparer.Ordinal);
        var filterOperator = supportedOperators.Contains(_filterOperator)
            ? _filterOperator
            : FilterOperators[0].Value;
        var filterValue = FilterNeedsNoValue ? string.Empty : _filterValue.Trim();
        await UpdateActiveViewConfigAsync(config => config with
        {
            Filters = config.Filters.Concat(
                [new WikiDatabaseFilter(property.Id.ToString(), filterOperator, filterValue)]).ToList()
        });
        _filterOperator = FilterOperators[0].Value;
        _filterValue = property.Type == WikiDatabasePropertyTypes.Select
            ? WikiDatabasePropertyConfig.GetOptions(property).FirstOrDefault()?.Id ?? string.Empty
            : string.Empty;
    }

