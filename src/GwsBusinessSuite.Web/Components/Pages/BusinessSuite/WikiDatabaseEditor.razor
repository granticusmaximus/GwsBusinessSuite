    private async Task ImportCsvAsync(InputFileChangeEventArgs args)
    {
        const long maxCsvBytes = WikiDatabaseCsvImportLimits.MaxFileBytes;
        if (args.File.Size > maxCsvBytes)
        {
            ErrorMessage = $"CSV files are limited to {maxCsvBytes / 1024 / 1024} MB.";
            return;
        }

        await Work(async () =>
        {
            await using var stream = args.File.OpenReadStream(maxCsvBytes);
            using var reader = new StreamReader(stream, detectEncodingFromByteOrderMarks: true);
            var csv = await reader.ReadToEndAsync();
            var user = await CurrentUserNameAsync();
            _csvImportResult = await WikiDatabaseService.ImportCsvAsync(WikiDatabaseId, csv, user);
            await ReloadAsync();
            await OnChanged.InvokeAsync();
        });
    }

