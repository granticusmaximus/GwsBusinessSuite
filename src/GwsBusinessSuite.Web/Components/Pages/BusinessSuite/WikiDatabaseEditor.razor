    private async Task AddAdvancedViewAsync(string type, string name)
    {
        var preferredProperty = type switch
        {
            WikiDatabaseViewTypes.Timeline => Database?.Properties.FirstOrDefault(property => property.Type == WikiDatabasePropertyTypes.Date),
            WikiDatabaseViewTypes.Chart => Database?.Properties.FirstOrDefault(property => property.Type is WikiDatabasePropertyTypes.Select
                or WikiDatabasePropertyTypes.MultiSelect or WikiDatabasePropertyTypes.Checkbox or WikiDatabasePropertyTypes.Text
                or WikiDatabasePropertyTypes.Formula or WikiDatabasePropertyTypes.Rollup),
            WikiDatabaseViewTypes.Map => Database?.Properties.FirstOrDefault(property => property.Type == WikiDatabasePropertyTypes.Place),
            _ => null
        };

        if (type == WikiDatabaseViewTypes.Timeline && preferredProperty is null)
        {
            ErrorMessage = "Add a Date property before creating a Timeline view.";
            return;
        }
        if (type == WikiDatabaseViewTypes.Map && preferredProperty is null)
        {
            ErrorMessage = "Add a Place property before creating a Map view.";
            return;
        }

        await Work(async () =>
        {
            var user = await CurrentUserNameAsync();
            WikiDatabaseProperty? dependencyProperty = null;
            if (type == WikiDatabaseViewTypes.Timeline)
            {
                dependencyProperty = Database?.Properties.FirstOrDefault(property =>
                    property.Type == WikiDatabasePropertyTypes.Relation
                    && property.Name.Equals("Depends on", StringComparison.OrdinalIgnoreCase)
                    && WikiDatabasePropertyConfig.Parse(property).RelatedDatabaseId == WikiDatabaseId);
                dependencyProperty ??= await WikiDatabaseService.SavePropertyAsync(
                    WikiDatabaseId,
                    new WikiDatabasePropertyEditor
                    {
                        Name = "Depends on",
                        Type = WikiDatabasePropertyTypes.Relation,
                        RelatedDatabaseId = WikiDatabaseId,
                        ReciprocalRelationEnabled = false
                    },
                    user);
            }
            var config = new WikiDatabaseViewConfig(
                [], [], preferredProperty?.Id.ToString(),
                DependencyPropertyId: dependencyProperty?.Id.ToString());
            var view = await WikiDatabaseService.SaveViewAsync(WikiDatabaseId, null, name, type, config, user);
            await ReloadAsync();
            _activeViewId = view.Id;
            _personalOverride = null;
        });
    }

