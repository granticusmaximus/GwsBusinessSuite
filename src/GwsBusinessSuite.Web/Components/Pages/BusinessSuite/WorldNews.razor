@page "/admin/world-news"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "AdminOnly")]
@implements IDisposable
@using GwsBusinessSuite.Application.Abstractions
@using GwsBusinessSuite.Infrastructure.Services
@using GwsBusinessSuite.WorldNewsKit
@inject WorldNewsService News
@inject WorldNewsMapService WorldNewsMap
@inject ICurrentUserAccessor CurrentUserAccessor

<PageTitle>World News</PageTitle>

<PageHeader Title="World News" Icon="bi-globe-europe-africa"
            Description="What newsrooms around the world are reporting, with every outlet's coverage of the same event grouped together across languages, events linked into stories that develop over days, and the biggest events summarized in English.">
    <Meta>
        <p class="small text-secondary mb-0">@StatusLine</p>
    </Meta>
    <Actions>
        <button type="button" class="btn btn-primary" @onclick="ReadNow" disabled="@News.IsRefreshing">
            <i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>@(News.IsRefreshing ? "Reading…" : "Read now")
        </button>
    </Actions>
    <Filters>
        <div class="btn-group world-news-view" role="group" aria-label="Show">
            <button type="button" class="btn @(_view == WorldNewsView.Events ? "btn-primary" : "btn-outline-secondary")"
                    aria-pressed="@(_view == WorldNewsView.Events ? "true" : "false")" @onclick="() => ShowAsync(WorldNewsView.Events)">Events</button>
            <button type="button" class="btn @(_view == WorldNewsView.Situations ? "btn-primary" : "btn-outline-secondary")"
                    aria-pressed="@(_view == WorldNewsView.Situations ? "true" : "false")" @onclick="() => ShowAsync(WorldNewsView.Situations)">Situations</button>
            <button type="button" class="btn @(_view == WorldNewsView.World ? "btn-primary" : "btn-outline-secondary")"
                    aria-pressed="@(_view == WorldNewsView.World ? "true" : "false")" @onclick="() => ShowAsync(WorldNewsView.World)">World</button>
        </div>
        <input type="search" class="form-control world-news-search" placeholder="@($"Filter {ViewName}")" aria-label="@($"Filter {ViewName}")"
               @bind="_filter" @bind:event="oninput" @bind:after="() => _shown = PageSize" />
        <select class="form-select world-news-range" aria-label="Time range" @bind="_rangeHours" @bind:after="ChangeRangeAsync">
            @if (_view == WorldNewsView.World)
            {
                <option value="3">Last 3 hours</option>
                <option value="24">Last 24 hours</option>
            }
            else
            {
                <option value="24">Last 24 hours</option>
                <option value="72">Last 3 days</option>
                <option value="168">Last 7 days</option>
            }
        </select>
        @if (_view == WorldNewsView.Situations)
        {
            <button type="button" class="btn @(_surgeAlerts ? "btn-primary" : "btn-outline-secondary")" aria-pressed="@(_surgeAlerts ? "true" : "false")"
                    title="Get a notification when a disaster, transport, conflict or health story's coverage doubles within two hours"
                    @onclick="ToggleSurgeAlertsAsync">
                <i class="bi @(_surgeAlerts ? "bi-lightning-charge-fill" : "bi-lightning-charge") me-1" aria-hidden="true"></i>Surge alerts
            </button>
        }
    </Filters>
</PageHeader>

@if (_view == WorldNewsView.World)
{
    @if (_world is null)
    {
        <ListSkeleton Message="Building the world view…" />
    }
    else if (_world.BiggestStories.Count == 0)
    {
        <EmptyState Icon="bi-globe-americas" Title="No recent world news"
                    Message="No reports arrived in this time range. Try the last 24 hours or read the news now." />
    }
    else
    {
        <div class="world-news-world">
            <section class="world-news-world-panel" aria-labelledby="world-countries-title">
                <h2 id="world-countries-title">Most mentioned countries</h2>
                <ol class="world-news-country-ranking">
                    @foreach (var country in VisibleCountries)
                    {
                        <li>
                            <span class="world-news-country-name">@country.Name</span>
                            <span>@Count(country.ReportCount, "report") · @Count(country.EventCount, "event")</span>
                        </li>
                    }
                </ol>
            </section>
            <section class="world-news-world-panel" aria-labelledby="world-biggest-title">
                <h2 id="world-biggest-title">Biggest stories</h2>
                <div class="world-news-world-stories">
                    @foreach (var story in VisibleBiggestStories)
                    {
                        <button type="button" class="world-news-event" @onclick="() => OpenEventAsync(story.Event)">
                            <span class="world-news-event-title">@(story.Event.Headline ?? story.Event.Title)</span>
                            <span class="world-news-event-meta">@WorldStorySummary(story)</span>
                            @if (story.SituationId is not null)
                            {
                                <span class="world-news-situation-tag"><i class="bi bi-diagram-3" aria-hidden="true"></i> Developing situation</span>
                            }
                        </button>
                    }
                </div>
            </section>
        </div>
        <section class="world-news-country-grid" aria-label="Top stories by country">
            @foreach (var country in VisibleCountries)
            {
                <article class="world-news-country-card">
                    <h2>@country.Name</h2>
                    <p>@Count(country.OutletCount, "outlet") · @Count(country.ReportCount, "report")</p>
                    <ol>
                        @foreach (var story in country.TopStories)
                        {
                            <li>
                                <button type="button" @onclick="() => OpenEventAsync(story.Event)">
                                    <span>@(story.Event.Headline ?? story.Event.Title)</span>
                                    <small>@WorldStorySummary(story)</small>
                                </button>
                            </li>
                        }
                    </ol>
                </article>
            }
        </section>
    }
}
else if (_view == WorldNewsView.Situations)
{
    @if (_situations is null)
    {
        <ListSkeleton Message="Loading situations…" />
    }
    else if (_situations.Count == 0)
    {
        <EmptyState Icon="bi-diagram-3" Title="No situations yet"
                    Message="A situation is one story developing over days: two or more events linked by what they report. They form as later reads find new events on the same story." />
    }
    else
    {
        <div class="world-news @(_situation is null ? "" : "has-selection")">
            <div class="world-news-list" aria-label="Situations">
                @if (VisibleSituations.Count == 0)
                {
                    <EmptyState Icon="bi-search" Message="No situations match that filter." />
                }
                @foreach (var situation in VisibleSituations.Take(_shown))
                {
                    <button type="button" class="world-news-event @(situation.Id == _situation?.Id ? "is-selected" : "")"
                            aria-pressed="@(situation.Id == _situation?.Id ? "true" : "false")" @onclick="() => SelectSituationAsync(situation)">
                        <span class="world-news-event-title">@situation.Title</span>
                        <span class="world-news-event-meta"><StatusPill Tone="@Tone(situation)">@State(situation)</StatusPill> @SituationSummary(situation)</span>
                        @if (situation.Latest != situation.Title)
                        {
                            <span class="world-news-event-meta world-news-latest">Latest: @situation.Latest</span>
                        }
                    </button>
                }
                @if (VisibleSituations.Count > _shown)
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary world-news-more" @onclick="() => _shown += PageSize">
                        Show @Math.Min(PageSize, VisibleSituations.Count - _shown) more of @(VisibleSituations.Count - _shown)
                    </button>
                }
            </div>

            <section class="world-news-detail" aria-live="polite">
                @if (_situation is null)
                {
                    <EmptyState Icon="bi-hand-index" Message="Pick a situation to see how the story developed, event by event." />
                }
                else
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary world-news-back" @onclick="() => _situation = null">
                        <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Situations
                    </button>
                    <h2 class="world-news-detail-title">@_situation.Title</h2>
                    <button type="button" class="btn btn-sm @(_watching ? "btn-primary" : "btn-outline-primary") mb-2" @onclick="ToggleWatchAsync">
                        <i class="bi @(_watching ? "bi-bell-fill" : "bi-bell") me-1" aria-hidden="true"></i>@(_watching ? "Watching" : "Watch situation")
                    </button>
                    @if (_place is { } place)
                    {
                        @* Overwatch is a full page load: Cesium doesn't start under enhanced navigation. *@
                        <a class="btn btn-sm btn-outline-secondary mb-2 ms-1" href="@($"admin/osint?news={Uri.EscapeDataString(_situation.Id)}")"
                           data-enhance-nav="false" title="See this situation on the Overwatch globe, placed at @place.Label">
                            <i class="bi bi-globe2 me-1" aria-hidden="true"></i>Show on Overwatch
                        </a>
                    }
                    <button type="button" class="btn btn-sm btn-link mb-2" aria-expanded="@(_placing ? "true" : "false")" @onclick="TogglePlacing">
                        Wrong place?
                    </button>
                    @if (_placing)
                    {
                        <div class="world-news-placing">
                            <p class="world-news-placing-now">@PlacementNow()</p>
                            <form class="world-news-placing-form" @onsubmit="SavePlacement">
                                <label>
                                    Country
                                    <select class="form-select form-select-sm" @bind="_placeCountry">
                                        <option value="">Choose a country</option>
                                        @foreach (var country in WorldNewsPlaces.Instance.Countries)
                                        {
                                            <option value="@country.Code">@country.Name</option>
                                        }
                                    </select>
                                </label>
                                <label>
                                    City (optional)
                                    <input class="form-control form-control-sm" @bind="_placeCity" @bind:event="oninput" maxlength="80" />
                                </label>
                                <button type="submit" class="btn btn-sm btn-primary" disabled="@string.IsNullOrEmpty(_placeCountry)">Place here</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="HidePlacement">Keep off the globe</button>
                                @if (_correction is not null)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="UndoPlacement">Undo correction</button>
                                }
                            </form>
                            @if (_placeMessage is not null)
                            {
                                <p class="world-news-placing-message" role="alert">@_placeMessage</p>
                            }
                        </div>
                    }
                    <p class="world-news-detail-meta">
                        <StatusPill Tone="@Tone(_situation)">@State(_situation)</StatusPill>
                        @Count(_situation.EventCount, "event"), @Count(_situation.OutletCount, "outlet"), @Count(_situation.ArticleCount, "report").
                        First seen @_situation.FirstSeen.ToLocalGwsDateTime(), latest @_situation.LastSeen.ToLocalGwsDateTime().
                    </p>
                    <dl class="world-news-facts">
                        <dt>Languages</dt>
                        <dd>@string.Join(", ", _situation.Languages.Order())</dd>
                        <dt>Reported from</dt>
                        <dd>@string.Join(", ", _situation.Countries.Order())</dd>
                        <dt>Kind</dt>
                        <dd>@SituationKinds.Label(WorldNewsMapService.KindOf(_situation))</dd>
                    </dl>
                    <h3 class="world-news-language">How it developed <span>(@_situationEvents.Count)</span></h3>
                    <ol class="world-news-timeline">
                        @foreach (var e in _situationEvents)
                        {
                            <li>
                                <button type="button" class="world-news-event" @onclick="() => OpenEventAsync(e)">
                                    <span class="world-news-event-meta">@e.FirstSeen.ToLocalGwsDateTime()</span>
                                    <span class="world-news-event-title">@(e.Headline ?? e.Title)</span>
                                    <span class="world-news-event-meta">@Summary(e)</span>
                                </button>
                            </li>
                        }
                    </ol>
                }
            </section>
        </div>
    }
}
else if (_events is null)
{
    <ListSkeleton Message="Loading world news…" />
}
else if (_events.Count == 0)
{
    <EmptyState Icon="bi-globe-europe-africa" Title="No events yet"
                Message="The server reads the news every 15 minutes. The first read takes a few minutes while every headline is grouped.">
        <button type="button" class="btn btn-sm btn-primary mt-2" @onclick="ReadNow" disabled="@News.IsRefreshing">
            <i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Read now
        </button>
    </EmptyState>
}
else
{
    <div class="world-news @(_selected is null ? "" : "has-selection")">
        <div class="world-news-list" aria-label="Events">
            @if (VisibleEvents.Count == 0)
            {
                <EmptyState Icon="bi-search" Message="No events match that filter." />
            }
            @foreach (var e in VisibleEvents.Take(_shown))
            {
                <button type="button" class="world-news-event @(e.Id == _selected?.Id ? "is-selected" : "")"
                        aria-pressed="@(e.Id == _selected?.Id ? "true" : "false")" @onclick="() => SelectAsync(e)">
                    <span class="world-news-event-title">@(e.Headline ?? e.Title)</span>
                    <span class="world-news-event-meta">@Summary(e)</span>
                </button>
            }
            @* A page of events at a time: all 300 made a 170 KB page, sent again by the live render. *@
            @if (VisibleEvents.Count > _shown)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary world-news-more" @onclick="() => _shown += PageSize">
                    Show @Math.Min(PageSize, VisibleEvents.Count - _shown) more of @(VisibleEvents.Count - _shown)
                </button>
            }
        </div>

        <section class="world-news-detail" aria-live="polite">
            @if (_selected is null)
            {
                <EmptyState Icon="bi-hand-index" Message="Pick an event to see every report on it, in every language." />
            }
            else
            {
                <button type="button" class="btn btn-sm btn-outline-secondary world-news-back" @onclick="() => _selected = null">
                    <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Events
                </button>
                <h2 class="world-news-detail-title">@(_selected.Headline ?? _selected.Title)</h2>
                @if (_selected.Headline is not null)
                {
                    <p class="world-news-original">Original headline: @_selected.Title</p>
                }
                <p class="world-news-detail-meta">
                    @Count(_selected.OutletCount, "outlet"), @Count(_selected.ArticleCount, "report").
                    First seen @_selected.FirstSeen.ToLocalGwsDateTime(), latest @_selected.LastSeen.ToLocalGwsDateTime().
                </p>
                <section class="world-news-summary" aria-label="Summary">
                    @if (_summary is not null)
                    {
                        <p class="world-news-summary-text">@_summary.Text</p>
                    }
                    <p class="world-news-summary-meta">@SummaryNote</p>
                    <a class="btn btn-sm btn-outline-secondary" href="@($"admin/world-news/events/{_selected.Id}/document.md")" download
                       title="Every source on this event in time order, with links and the outlets' descriptions, as a Markdown file">
                        <i class="bi bi-download me-1" aria-hidden="true"></i>Download document
                    </a>
                </section>
                <dl class="world-news-facts">
                    <dt>Languages</dt>
                    <dd>@string.Join(", ", _selected.Languages.Order())</dd>
                    <dt>Reported from</dt>
                    <dd>@string.Join(", ", _selected.Countries.Order())</dd>
                </dl>
                @foreach (var language in _articles.GroupBy(a => a.Language).OrderByDescending(g => g.Count()).ThenBy(g => g.Key))
                {
                    <h3 class="world-news-language">@language.Key <span>(@language.Count())</span></h3>
                    <ul class="world-news-reports">
                        @foreach (var a in language.OrderByDescending(a => a.SeenAt))
                        {
                            <li>
                                <a class="world-news-report" href="@a.Url" target="_blank" rel="noopener noreferrer">
                                    <span class="world-news-report-title">@a.Title</span>
                                    <span class="world-news-report-meta">@a.Outlet · @a.Country · @a.SeenAt.ToLocalGwsDateTime()</span>
                                </a>
                            </li>
                        }
                    </ul>
                }
            }
        </section>
    </div>
}

@code {
    private enum WorldNewsView { Events, Situations, World }

    private WorldNewsView _view = WorldNewsView.Events;
    private IReadOnlyList<SituationOverview>? _situations;
    private SituationOverview? _situation;
    private IReadOnlyList<EventOverview> _situationEvents = [];
    private IReadOnlyList<EventOverview>? _events;
    private EventOverview? _selected;
    private IReadOnlyList<WorldArticle> _articles = [];
    private EventSummary? _summary;
    private WorldSnapshot? _world;
    private string _filter = string.Empty;
    private int _rangeHours = 24;
    private const int PageSize = 60;
    private int _shown = PageSize;
    private string _username = string.Empty;
    private bool _watching;
    private bool _placing;
    private bool _surgeAlerts;
    private WorldNewsLocation? _place;
    private SituationPlacement? _correction;
    private string _placeCountry = string.Empty;
    private string _placeCity = string.Empty;
    private string? _placeMessage;

    [SupplyParameterFromQuery(Name = "situation")]
    public string? SituationId { get; set; }

    private IReadOnlyList<EventOverview> VisibleEvents => string.IsNullOrWhiteSpace(_filter)
        ? _events ?? []
        : (_events ?? []).Where(e => e.Title.Contains(_filter.Trim(), StringComparison.CurrentCultureIgnoreCase)
            || e.Headline?.Contains(_filter.Trim(), StringComparison.CurrentCultureIgnoreCase) == true).ToList();

    private string ViewName => _view switch { WorldNewsView.Situations => "situations", WorldNewsView.World => "countries and stories", _ => "events" };

    private IReadOnlyList<WorldCountry> VisibleCountries => (_world?.Countries ?? []).Where(country =>
        string.IsNullOrWhiteSpace(_filter) || country.Name.Contains(_filter.Trim(), StringComparison.CurrentCultureIgnoreCase)
        || country.TopStories.Any(story => StoryMatches(story, _filter))).ToList();

    private IReadOnlyList<WorldStory> VisibleBiggestStories => (_world?.BiggestStories ?? []).Where(story => StoryMatches(story, _filter)).ToList();

    private IReadOnlyList<SituationOverview> VisibleSituations => string.IsNullOrWhiteSpace(_filter)
        ? _situations ?? []
        : (_situations ?? []).Where(s => s.Title.Contains(_filter.Trim(), StringComparison.CurrentCultureIgnoreCase)
            || s.Latest.Contains(_filter.Trim(), StringComparison.CurrentCultureIgnoreCase)).ToList();

    private string SummaryNote => _summary is null
        ? "No summary yet. After each read, the busiest events covered by 3 or more outlets are summarized in English."
        : $"Summary by {_summary.Model} from {Count(_summary.ArticleCount, "report")}, {_summary.CreatedAt.ToLocalGwsDateTime()}"
          + (_summary.Version > 1 ? $" (version {_summary.Version}; rewritten as coverage grows)." : ".")
          + " Written by AI from headlines and outlets' descriptions: check the sources before relying on a detail.";

    private string StatusLine => ((News.LastRefreshed is { } at ? $"Read {at.ToLocalGwsDateTime()}. " : string.Empty) + News.Status).Trim();

    protected override async Task OnInitializedAsync()
    {
        News.Changed += OnNewsChanged;
        _username = await CurrentUserAccessor.GetCurrentUsernameAsync();
        _surgeAlerts = !string.IsNullOrWhiteSpace(_username) && await Task.Run(() => News.Store.IsWatchingSurges(_username));
        if (!string.IsNullOrWhiteSpace(SituationId)) _view = WorldNewsView.Situations;
        await LoadAsync();
        if (!string.IsNullOrWhiteSpace(SituationId)
            && (_situations?.FirstOrDefault(s => s.Id == SituationId) ?? await Task.Run(() => News.Store.Situation(SituationId))) is { } situation)
        {
            _view = WorldNewsView.Situations;
            await SelectSituationAsync(situation);
        }
    }

    private async Task LoadAsync()
    {
        _events = await Task.Run(() => News.TopEvents(_rangeHours));
        if (_selected is not null) _selected = _events.FirstOrDefault(e => e.Id == _selected.Id);
        if (_selected is not null) _summary = await Task.Run(() => News.Store.LatestSummary(_selected.Id));
        if (_view == WorldNewsView.World)
        {
            _world = await Task.Run(() => News.World(_rangeHours));
            return;
        }
        if (_view != WorldNewsView.Situations) return;
        _situations = await Task.Run(() => News.TopSituations(_rangeHours));
        if (_situation is not null) _situation = _situations.FirstOrDefault(s => s.Id == _situation.Id);
        if (_situation is not null) _situationEvents = await Task.Run(() => News.Store.EventsForSituation(_situation.Id));
        LoadPlacement();
    }

    private Task ShowAsync(WorldNewsView view)
    {
        if (view == WorldNewsView.World) _rangeHours = 3;
        else if (view != WorldNewsView.World && _rangeHours == 3) _rangeHours = 24;
        _view = view;
        _shown = PageSize;
        return LoadAsync();
    }

    private async Task SelectSituationAsync(SituationOverview situation)
    {
        _situation = situation;
        _situationEvents = await Task.Run(() => News.Store.EventsForSituation(situation.Id));
        _watching = await Task.Run(() => News.Store.IsWatching(_username, situation.Id));
        _placing = false;
        LoadPlacement();
    }

    // Where Overwatch puts the open situation, and any hand correction of it.
    private void LoadPlacement()
    {
        if (_situation is null) return;
        _correction = WorldNewsMap.Correction(_situation.Id);
        _place = WorldNewsMap.Place(_situation, DateTimeOffset.UtcNow - WorldNewsMapService.Window);
    }

    private void TogglePlacing()
    {
        _placing = !_placing;
        _placeMessage = null;
        var current = _correction is { Hidden: false } ? WorldNewsPlaces.Instance.Country(_correction.CountryCode) : null;
        var named = _situation is null ? null : WorldNewsMapService.Named(_situation);
        _placeCountry = current?.Code ?? named?.CountryCode ?? string.Empty;
        _placeCity = _correction is { Hidden: false } ? _correction.City ?? string.Empty : named?.City ?? string.Empty;
    }

    private string PlacementNow()
    {
        if (_situation is null) return string.Empty;
        var shown = _place is null ? " It isn't on the globe now: that needs 3 or more outlets and news in the last 24 hours." : string.Empty;
        if (_correction is { Hidden: true })
            return $"Kept off the globe by {_correction.UpdatedBy} on {_correction.UpdatedAt.ToLocalGwsDateTime()}.";
        if (_correction is not null)
            return $"Placed by hand at {_place?.Label ?? _correction.City ?? _correction.CountryCode} by {_correction.UpdatedBy} on {_correction.UpdatedAt.ToLocalGwsDateTime()}.{shown}";
        return WorldNewsMapService.Named(_situation) is { } named
            ? $"The headlines place it at {named.Label} ({named.PlacementText}).{shown}"
            : "The headlines don't name a place, so it isn't on the globe. Pick one below to put it there.";
    }

    private void SavePlacement()
    {
        if (_situation is null) return;
        _placeMessage = WorldNewsMap.Correct(_situation.Id, _placeCountry, _placeCity, _username, DateTimeOffset.UtcNow);
        if (_placeMessage is not null) return;
        _placing = false;
        LoadPlacement();
    }

    private void HidePlacement()
    {
        if (_situation is null) return;
        WorldNewsMap.Hide(_situation.Id, _username, DateTimeOffset.UtcNow);
        _placing = false;
        LoadPlacement();
    }

    private void UndoPlacement()
    {
        if (_situation is null) return;
        WorldNewsMap.ClearCorrection(_situation.Id);
        _placing = false;
        LoadPlacement();
    }

    private async Task ToggleSurgeAlertsAsync()
    {
        if (string.IsNullOrWhiteSpace(_username)) return;
        _surgeAlerts = !_surgeAlerts;
        var on = _surgeAlerts;
        await Task.Run(() => News.Store.WatchSurges(_username, on, DateTimeOffset.UtcNow));
    }

    private async Task ToggleWatchAsync()
    {
        if (_situation is null || string.IsNullOrWhiteSpace(_username)) return;
        if (_watching) await Task.Run(() => News.Store.Unwatch(_username, _situation.Id));
        else await Task.Run(() => News.Store.Watch(_username, _situation.Id, DateTimeOffset.UtcNow));
        _watching = !_watching;
    }

    // An event in a situation opens in the Events view, with all its reports.
    private async Task OpenEventAsync(EventOverview e)
    {
        if (_rangeHours == 3) _rangeHours = 24;
        _view = WorldNewsView.Events;
        await SelectAsync(e);
    }

    private Task ChangeRangeAsync()
    {
        _shown = PageSize;
        return LoadAsync();
    }

    private async Task SelectAsync(EventOverview e)
    {
        _selected = e;
        _summary = null;
        (_articles, _summary) = await Task.Run(() => (News.Store.ArticlesForEvent(e.Id), News.Store.LatestSummary(e.Id)));
    }

    // A read takes from seconds to a few minutes; the page follows it through News.Changed.
    private void ReadNow() => _ = News.RefreshAsync(CancellationToken.None);

    private void OnNewsChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    private static string Summary(EventOverview e) =>
        $"{Count(e.OutletCount, "outlet")} · {Count(e.Languages.Count, "language")} · {Count(e.Countries.Count, "country", "countries")} · {e.LastSeen.ToLocalGwsDateTime()}";

    private static string State(SituationOverview s) => SituationLinker.IsActive(s.LastSeen, DateTimeOffset.UtcNow) ? "Active" : "Quiet";

    private static StatusTone Tone(SituationOverview s) =>
        SituationLinker.IsActive(s.LastSeen, DateTimeOffset.UtcNow) ? StatusTone.Success : StatusTone.Neutral;

    private static string SituationSummary(SituationOverview s) =>
        $"{Count(s.EventCount, "event")} · {Count(s.OutletCount, "outlet")} · {Count(s.Languages.Count, "language")} · {s.LastSeen.ToLocalGwsDateTime()}";

    private static string WorldStorySummary(WorldStory story) =>
        $"{Count(story.RecentOutlets, "outlet")} · {Count(story.RecentReports, "report")} · {Count(story.Event.Countries.Count, "country", "countries")}";

    private static bool StoryMatches(WorldStory story, string filter) => string.IsNullOrWhiteSpace(filter)
        || story.Event.Title.Contains(filter.Trim(), StringComparison.CurrentCultureIgnoreCase)
        || story.Event.Headline?.Contains(filter.Trim(), StringComparison.CurrentCultureIgnoreCase) == true;

    private static string Count(int n, string one, string? many = null) => $"{n:N0} {(n == 1 ? one : many ?? one + "s")}";

    public void Dispose() => News.Changed -= OnNewsChanged;
}
