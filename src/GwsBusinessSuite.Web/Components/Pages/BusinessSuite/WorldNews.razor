@page "/admin/world-news"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "AdminOnly")]
@implements IAsyncDisposable
@using GwsBusinessSuite.Application.Abstractions
@using GwsBusinessSuite.Infrastructure.Services
@using GwsBusinessSuite.WorldNewsKit
@using GwsBusinessSuite.Application.Assistant
@inject WorldNewsService News
@inject WorldNewsMapService WorldNewsMap
@inject ICurrentUserAccessor CurrentUserAccessor
@inject IJSRuntime JS
@inject GwsBusinessSuite.Application.Hazards.ConflictEventService Gdelt

<PageTitle>World News</PageTitle>

@* World News (design pass 12-11-26): three tabs in the reader's words, one search box that also
   opens the report archive, kind chips on every tab, and rows that say what, where and how widely
   covered. State lives in the address (WorldNewsBrowse.Url), mirrored by js/world-news.js. *@
<div class="world-news-page" @ref="_root">
<PageHeader Title="World News" Icon="bi-globe-europe-africa"
            Description="What newsrooms around the world are reporting, each story's coverage grouped across languages.">
    <Meta>
        <p class="world-news-updated small mb-0" title="@News.Status">@UpdatedLine</p>
    </Meta>
    <Actions>
        <a class="btn btn-outline-secondary" href="admin/world-news/search" title="Find every story with similar reports, and the cyber attacks in the news now">
            <i class="bi bi-search me-1" aria-hidden="true"></i>Search
        </a>
        <a class="btn btn-outline-secondary" href="admin/world-news/desk" title="The story budget and the tips readers have sent">
            <i class="bi bi-journal-text me-1" aria-hidden="true"></i>Desk
        </a>
        <a class="btn btn-outline-secondary" href="admin/world-news/methodology" title="How stories are labelled, and how well the labels hold up">
            <i class="bi bi-clipboard-check me-1" aria-hidden="true"></i>Methodology
        </a>
        <a class="btn btn-outline-secondary" href="admin/world-news/sources" title="Every feed's health, the crawl's numbers and where coverage is thin">
            <i class="bi bi-broadcast me-1" aria-hidden="true"></i>Sources
        </a>
        <button type="button" class="btn btn-outline-secondary world-news-refresh" @onclick="ReadNow" disabled="@News.IsRefreshing"
                aria-label="@(News.IsRefreshing ? "Reading the news" : "Read the news now")"
                title="Read the news now. It also reads every 15 minutes on its own.">
            <i class="bi bi-arrow-clockwise @(News.IsRefreshing ? "world-news-spin" : "")" aria-hidden="true"></i>
            <span class="world-news-refresh-text">@(News.IsRefreshing ? "Reading…" : "Refresh")</span>
        </button>
    </Actions>
    <Filters>
        <div class="world-news-tabs" role="tablist" aria-label="World News">
            @foreach (var tab in Tabs)
            {
                <button type="button" role="tab" class="world-news-tab @(_view == tab ? "is-active" : "")"
                        aria-selected="@(_view == tab ? "true" : "false")" @onclick="() => ShowAsync(tab)">@WorldNewsBrowse.TabLabel(tab)</button>
            }
        </div>
        <div class="world-news-search-wrap">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" class="form-control world-news-search" placeholder="@SearchPlaceholder" aria-label="Search stories and reports"
                   aria-keyshortcuts="/" @bind="_filter" @bind:event="oninput" @bind:after="ChangeTextFilterAsync" />
        </div>
        <select class="form-select world-news-range" aria-label="Time range" @bind="_rangeHours" @bind:after="ChangeRangeAsync">
            @foreach (var range in WorldNewsBrowse.Ranges(_view))
            {
                <option value="@range.Hours">@range.Label</option>
            }
        </select>
        <button type="button" class="btn btn-outline-secondary world-news-filters-toggle" aria-expanded="@(_filtersOpen ? "true" : "false")"
                aria-controls="world-news-filter-panel" @onclick="() => _filtersOpen = !_filtersOpen">
            <i class="bi bi-sliders me-1" aria-hidden="true"></i>Filters
            @if (SourceFilterCount > 0)
            {
                <span class="world-news-badge" aria-label="@($"{SourceFilterCount} on")">@SourceFilterCount</span>
            }
        </button>
    </Filters>
</PageHeader>

@if (_silences.Count > 0)
{
    @* Unusual silence (World News trust plan 1.12, 13-11-26): quiet can be an internet shutdown or a blackout. *@
    <p class="world-news-silence" role="status">
        <i class="bi bi-volume-mute me-1" aria-hidden="true"></i>
        <strong>Unusually quiet:</strong>
        @string.Join(", ", _silences.Take(5).Select(silence => $"{silence.Country} ({silence.PercentOfUsual}% of usual coverage)")).
        <a href="admin/osint">Check internet outages on Overwatch</a>
    </p>
}

@if (_surges.Count > 0)
{
    @* B8 (13-11-26): GDELT's quarter-hour feed, every outlet it reads: the last hour against the rest of the day. *@
    <p class="world-news-silence" role="status">
        <i class="bi bi-graph-up-arrow me-1" aria-hidden="true"></i>
        <strong>Surging worldwide:</strong>
        @for (var i = 0; i < _surges.Count; i++)
        {
            var surge = _surges[i];
            <a href="@($"admin/world-news?q={Uri.EscapeDataString(surge.Country)}")" title="@($"{surge.Recent} articles in the last hour; usually about {surge.Usual:0} an hour")">@surge.Country</a>
            <span> (@surge.Times.ToString("0.#")× usual)@(i < _surges.Count - 1 ? ", " : ".")</span>
        }
        <small class="text-secondary">GDELT, every outlet it reads, last hour.</small>
    </p>
}

<div class="world-news-chips" role="group" aria-label="Kind of story">
    <button type="button" class="world-news-chip @(_kind.Length == 0 ? "is-active" : "")" aria-pressed="@(_kind.Length == 0 ? "true" : "false")"
            @onclick="() => SetKindAsync(string.Empty)">All</button>
    @foreach (var kind in ChipKinds)
    {
        <button type="button" class="world-news-chip @(_kind == kind ? "is-active" : "")" data-kind="@kind"
                aria-pressed="@(_kind == kind ? "true" : "false")" @onclick="() => SetKindAsync(kind)" title="@SituationKinds.Label(kind)">@WorldNewsBrowse.ChipLabel(kind)</button>
    }
    @if (_view != WorldNewsTab.Reports && WhereOptions.Count > 0)
    {
        <select class="form-select form-select-sm world-news-where" aria-label="Where the story is" @bind="_where" @bind:after="ChangeWhereAsync">
            <option value="">Anywhere</option>
            @foreach (var country in WhereOptions)
            {
                <option value="@country">@country</option>
            }
        </select>
    }
</div>

@if (_filtersOpen)
{
    <div class="world-news-filter-panel" id="world-news-filter-panel">
        <label>
            Reported from
            <input type="search" class="form-control form-control-sm" list="world-news-countries" placeholder="Any country"
                   @bind="_reportCountry" @bind:event="oninput" @bind:after="ChangeSourceFilterAsync" />
        </label>
        <label>
            Language
            <input type="search" class="form-control form-control-sm" list="world-news-languages" placeholder="Any language"
                   @bind="_reportLanguage" @bind:event="oninput" @bind:after="ChangeSourceFilterAsync" />
        </label>
        @if (_view == WorldNewsTab.Reports)
        {
            <label>
                Outlet
                <input type="search" class="form-control form-control-sm" placeholder="Any outlet"
                       @bind="_reportOutlet" @bind:event="oninput" @bind:after="ChangeSourceFilterAsync" />
            </label>
        }
        else
        {
            <button type="button" class="btn btn-sm btn-link world-news-archive-link" @onclick="SearchReportsAsync">
                Browse every report<i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
            </button>
        }
        <datalist id="world-news-countries">
            @foreach (var country in SourceCountryOptions)
            {
                <option value="@country"></option>
            }
        </datalist>
        <datalist id="world-news-languages">
            @foreach (var language in LanguageOptions)
            {
                <option value="@language"></option>
            }
        </datalist>
    </div>
}

@if (ActiveFilters.Count > 0)
{
    <div class="world-news-active" aria-label="Active filters">
        @foreach (var filter in ActiveFilters)
        {
            <button type="button" class="world-news-active-chip" @onclick="filter.Clear" aria-label="@($"Remove {filter.Label}")">
                @filter.Label<i class="bi bi-x" aria-hidden="true"></i>
            </button>
        }
        <button type="button" class="btn btn-sm btn-link world-news-clear" @onclick="ClearFiltersAsync">Clear all</button>
    </div>
}

@if (_view != WorldNewsTab.Reports && !string.IsNullOrWhiteSpace(_filter))
{
    <button type="button" class="world-news-search-all" @onclick="SearchReportsAsync">
        <i class="bi bi-archive me-2" aria-hidden="true"></i>Search every report for “@_filter.Trim()”<i class="bi bi-arrow-right ms-auto" aria-hidden="true"></i>
    </button>
}
@if (!string.IsNullOrWhiteSpace(_filter))
{
    @* World News search (13-11-26): the same words, by meaning too, across every kind of story. *@
    <a class="world-news-search-all" href="@($"admin/world-news/search?q={Uri.EscapeDataString(_filter.Trim())}")">
        <i class="bi bi-intersect me-2" aria-hidden="true"></i>Find stories with similar reports to “@_filter.Trim()”<i class="bi bi-arrow-right ms-auto" aria-hidden="true"></i>
    </a>
}

@if (_view == WorldNewsTab.Reports)
{
    <h2 class="world-news-section-title">Report archive</h2>
    @if (_reports is null)
    {
        <ListSkeleton Message="Loading reports…" />
    }
    else if (_reports.Count == 0)
    {
        <EmptyState Icon="bi-newspaper" Title="No reports match"
                    Message="Try a wider time range or remove a filter." />
    }
    else
    {
        <ol class="world-news-archive-list" aria-label="News reports">
            @foreach (var report in _reports)
            {
                <li>
                    @if (ArticleHref(report) is { } href)
                    {
                        <a class="world-news-archive-report" href="@href" target="_blank" rel="noopener noreferrer">
                            <span class="world-news-report-title">@report.Title</span>
                            <span class="world-news-report-meta">@report.Outlet · @report.Country · @report.Language · <time>@Time(report.SeenAt)</time></span>
                            @if (!string.IsNullOrWhiteSpace(report.Snippet))
                            {
                                <span class="world-news-report-snippet">@report.Snippet</span>
                            }
                        </a>
                    }
                    else
                    {
                        <div class="world-news-archive-report">
                            <span class="world-news-report-title">@report.Title</span>
                            <span class="world-news-report-meta">@report.Outlet · @report.Country · @report.Language · <time>@Time(report.SeenAt)</time></span>
                        </div>
                    }
                </li>
            }
        </ol>
        @if (_hasMoreReports)
        {
            <button type="button" class="btn btn-sm btn-outline-secondary world-news-more" @onclick="LoadMoreReportsAsync">Show more reports</button>
        }
    }
}
else if (_view == WorldNewsTab.Today)
{
    @if (_world is null)
    {
        <ListSkeleton Message="Building today's view…" />
    }
    else if (_world.BiggestStories.Count == 0)
    {
        <EmptyState Icon="bi-globe-americas" Title="No recent world news"
                    Message="Nothing arrived in this time range. Try the last 24 hours, or refresh." />
    }
    else if (TodayStories.Count == 0)
    {
        <EmptyState Icon="bi-search" Title="Nothing matches" Message="No top stories match those filters." />
    }
    else
    {
        var lead = TodayStories[0];
        var leadFacts = FactsFor(lead.Event);
        <section class="world-news-lead" aria-labelledby="world-news-lead-title">
            <div class="world-news-row-top">
                <span class="world-news-lead-label">Lead story</span>
                @KindTag(leadFacts)
                @if (leadFacts.Place is not null)
                {
                    <span class="world-news-place"><i class="bi bi-geo-alt" aria-hidden="true"></i>@leadFacts.Place</span>
                }
            </div>
            <h2 id="world-news-lead-title" class="world-news-lead-title">@(lead.Event.Headline ?? lead.Event.Title)</h2>
            @if (_leadSummary is { EventId: var summaryId } && summaryId == lead.Event.Id)
            {
                <p class="world-news-lead-summary">@_leadSummary.Text</p>
            }
            <p class="world-news-lead-meta">
                @WorldNewsBrowse.Seen(lead.RecentOutlets, lead.Event.Languages.Count) · from @WorldNewsBrowse.Count(lead.Event.Countries.Count, "country", "countries") in the last @WorldNewsBrowse.Count(_rangeHours, "hour")
            </p>
            <div class="world-news-lead-actions">
                <a class="btn btn-primary world-news-lead-open" href="@EventHref(lead.Event)" @onclick="() => OpenEventAsync(lead.Event)" @onclick:preventDefault>
                    Read the story<i class="bi bi-arrow-right ms-2" aria-hidden="true"></i>
                </a>
                @if (lead.SituationId is { } leadSituation)
                {
                    <a class="btn btn-outline-secondary" href="@SituationHref(leadSituation)" @onclick="() => OpenSituationAsync(leadSituation)" @onclick:preventDefault>
                        <i class="bi bi-diagram-3 me-1" aria-hidden="true"></i>How it developed
                    </a>
                }
            </div>
        </section>

        <div class="world-news-today">
            <section class="world-news-panel" aria-labelledby="world-news-more-title">
                <h2 id="world-news-more-title" class="world-news-panel-title">More top stories</h2>
                <div class="world-news-list world-news-list-flat">
                    @{ var busiest = TodayStories.Max(s => s.RecentOutlets); }
                    @foreach (var story in TodayStories.Skip(1))
                    {
                        @Row(EventHref(story.Event), story.Event.Headline ?? story.Event.Title, FactsFor(story.Event),
                            WorldNewsBrowse.Seen(story.RecentOutlets, story.Event.Languages.Count), Time(story.Event.LastSeen),
                            WorldNewsBrowse.ReachPercent(story.RecentOutlets, busiest), false,
                            () => OpenEventAsync(story.Event), story.SituationId is null ? null : "Developing story")
                    }
                </div>
            </section>
            <section class="world-news-panel" aria-labelledby="world-countries-title">
                <h2 id="world-countries-title" class="world-news-panel-title">Most mentioned countries</h2>
                <ol class="world-news-country-ranking">
                    @foreach (var country in VisibleCountries.Take(16))
                    {
                        <li>
                            <span class="world-news-country-name">@country.Name</span>
                            <span class="world-news-country-count">@WorldNewsBrowse.Count(country.ReportCount, "report")</span>
                        </li>
                    }
                </ol>
            </section>
        </div>

        <section class="world-news-country-grid" aria-label="Top stories by country">
            @foreach (var country in VisibleCountries)
            {
                <article class="world-news-country-card">
                    <h2>@country.Name</h2>
                    <p>@WorldNewsBrowse.Count(country.OutletCount, "outlet") · @WorldNewsBrowse.Count(country.ReportCount, "report")</p>
                    <ol>
                        @foreach (var story in country.TopStories)
                        {
                            <li>
                                <a href="@EventHref(story.Event)" @onclick="() => OpenEventAsync(story.Event)" @onclick:preventDefault>
                                    <span>@(story.Event.Headline ?? story.Event.Title)</span>
                                    <small>@WorldNewsBrowse.Seen(story.RecentOutlets, story.Event.Languages.Count)</small>
                                </a>
                            </li>
                        }
                    </ol>
                </article>
            }
        </section>
    }
}
else if (_view == WorldNewsTab.Developing)
{
    @if (_situations is null)
    {
        <ListSkeleton Message="Loading developing stories…" />
    }
    else if (_situations.Count == 0)
    {
        <EmptyState Icon="bi-diagram-3" Title="No developing stories yet"
                    Message="A developing story is one story followed over days: two or more events linked by what they report. They form as later reads find new events on the same story." />
    }
    else
    {
        <div class="world-news @(_situation is null ? "" : "has-selection")">
            <div class="world-news-list" aria-label="Developing stories">
                <div class="world-news-list-head">
                    <span>@WorldNewsBrowse.Count(VisibleSituations.Count, "story", "stories")</span>
                    <button type="button" class="world-news-surge @(_surgeAlerts ? "is-on" : "")" aria-pressed="@(_surgeAlerts ? "true" : "false")"
                            title="Get a notification when a disaster, transport, conflict or health story's coverage doubles within two hours"
                            @onclick="ToggleSurgeAlertsAsync">
                        <i class="bi @(_surgeAlerts ? "bi-lightning-charge-fill" : "bi-lightning-charge") me-1" aria-hidden="true"></i>Surge alerts @(_surgeAlerts ? "on" : "off")
                    </button>
                    <button type="button" class="world-news-surge @(_watchlistOpen ? "is-on" : "")" aria-expanded="@(_watchlistOpen ? "true" : "false")"
                            title="Follow a topic, place, person or company and get a notification when a confirmed story matches"
                            @onclick="ToggleWatchlistAsync">
                        <i class="bi bi-binoculars me-1" aria-hidden="true"></i>Watchlist@(_watchlist.Count > 0 ? $" ({_watchlist.Count})" : "")
                    </button>
                </div>
                @if (_watchlistOpen)
                {
                    @* Watchlists (World News trust plan 1.11, 13-11-26). *@
                    <div class="world-news-watchlist" role="region" aria-label="Your watchlist">
                        <form class="world-news-watchlist-add" @onsubmit="AddWatchAsync" @onsubmit:preventDefault>
                            <input class="form-control form-control-sm" placeholder="A topic, place, person or company" aria-label="Add to your watchlist"
                                   @bind="_newWatch" @bind:event="oninput" maxlength="200" />
                            <button type="submit" class="btn btn-sm btn-primary" disabled="@string.IsNullOrWhiteSpace(_newWatch)">Watch</button>
                        </form>
                        <p class="world-news-watchlist-help">
                            You get a notification when a story matches and at least two independent sources have it.
                            Use "quotes" for a phrase, OR, NOT, and * for word endings.
                        </p>
                        @if (_watchError is not null) { <p class="text-danger small mb-1" role="alert">@_watchError</p> }
                        <ul class="world-news-watchlist-items">
                            @foreach (var watch in _watchlist)
                            {
                                <li>
                                    <span>@watch.Query</span>
                                    <button type="button" class="btn btn-sm btn-link p-0" aria-label="@($"Stop watching {watch.Query}")" @onclick="() => RemoveWatchAsync(watch.Id)">Remove</button>
                                </li>
                            }
                        </ul>
                    </div>
                }
                @if (VisibleSituations.Count == 0)
                {
                    <EmptyState Icon="bi-search" Message="No developing stories match those filters." />
                }
                @{ var busiestSituation = VisibleSituations.Count == 0 ? 0 : VisibleSituations.Max(s => s.OutletCount); }
                @foreach (var situation in VisibleSituations.Take(_shown))
                {
                    var latest = situation.Latest != situation.Title ? $"Latest: {situation.Latest}" : null;
                    @Row(SituationHref(situation.Id), situation.Title, FactsFor(situation),
                        $"{WorldNewsBrowse.Count(situation.EventCount, "event")} · {WorldNewsBrowse.Seen(situation.OutletCount, situation.Languages.Count)}",
                        Time(situation.LastSeen), WorldNewsBrowse.ReachPercent(situation.OutletCount, busiestSituation),
                        situation.Id == _situation?.Id, () => SelectSituationAsync(situation), latest, StateLabel(situation), Tone(situation))
                }
                @if (VisibleSituations.Count > _shown)
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary world-news-more" @onclick="() => _shown += PageSize">
                        Show @Math.Min(PageSize, VisibleSituations.Count - _shown) more of @(VisibleSituations.Count - _shown)
                    </button>
                }
            </div>

            <section class="world-news-detail" aria-live="polite">
                @if (_situation is null)
                {
                    <EmptyState Icon="bi-hand-index" Message="Pick a story to see how it developed, event by event." />
                }
                else
                {
                    var facts = FactsFor(_situation);
                    <button type="button" class="btn btn-sm btn-outline-secondary world-news-back" @onclick="ClearSelection" aria-keyshortcuts="Escape">
                        <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Developing
                    </button>
                    <div class="world-news-row-top">
                        <StatusPill Tone="@Tone(_situation)">@StateLabel(_situation)</StatusPill>
                        @KindTag(facts)
                        @if (facts.Place is not null)
                        {
                            <span class="world-news-place"><i class="bi bi-geo-alt" aria-hidden="true"></i>@facts.Place</span>
                        }
                    </div>
                    <h2 class="world-news-detail-title">@_situation.Title</h2>
                    <p class="world-news-detail-meta">
                        @WorldNewsBrowse.Count(_situation.EventCount, "event") · @WorldNewsBrowse.Seen(_situation.OutletCount, _situation.Languages.Count) ·
                        @WorldNewsBrowse.Count(_situation.ArticleCount, "report") · first @Time(_situation.FirstSeen), latest @Time(_situation.LastSeen)
                    </p>
                    <div class="world-news-detail-actions">
                        <button type="button" class="btn btn-sm @(_watching ? "btn-primary" : "btn-outline-primary")" @onclick="ToggleWatchAsync">
                            <i class="bi @(_watching ? "bi-bell-fill" : "bi-bell") me-1" aria-hidden="true"></i>@(_watching ? "Watching" : "Watch story")
                        </button>
                        @if (_place is { } place)
                        {
                            @* Overwatch is a full page load: Cesium doesn't start under enhanced navigation. *@
                            <a class="btn btn-sm btn-outline-secondary" href="@($"admin/osint?news={Uri.EscapeDataString(_situation.Id)}")"
                               data-enhance-nav="false" title="See this story on the Overwatch globe, placed at @place.Label">
                                <i class="bi bi-globe2 me-1" aria-hidden="true"></i>Show on Overwatch
                            </a>
                        }
                        <button type="button" class="btn btn-sm btn-outline-secondary world-news-share" @onclick="() => ShareAsync(SituationHref(_situation.Id), _situation.Title)">
                            <i class="bi bi-box-arrow-up me-1" aria-hidden="true"></i>@(_shareNote ?? "Share")
                        </button>
                        <button type="button" class="btn btn-sm btn-link" aria-expanded="@(_placing ? "true" : "false")" @onclick="TogglePlacing">
                            Wrong place?
                        </button>
                    </div>
                    @if (_placing)
                    {
                        <div class="world-news-placing">
                            <p class="world-news-placing-now">@PlacementNow()</p>
                            <form class="world-news-placing-form" @onsubmit="SavePlacement">
                                <label>
                                    Country
                                    <select class="form-select form-select-sm" @bind="_placeCountry">
                                        <option value="">Choose a country</option>
                                        @foreach (var country in WorldNewsPlaces.Instance.Countries)
                                        {
                                            <option value="@country.Code">@country.Name</option>
                                        }
                                    </select>
                                </label>
                                <label>
                                    City (optional)
                                    <input class="form-control form-control-sm" @bind="_placeCity" @bind:event="oninput" maxlength="80" />
                                </label>
                                <button type="submit" class="btn btn-sm btn-primary" disabled="@string.IsNullOrEmpty(_placeCountry)">Place here</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="HidePlacement">Keep off the globe</button>
                                @if (_correction is not null)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="UndoPlacement">Undo correction</button>
                                }
                            </form>
                            @if (_placeMessage is not null)
                            {
                                <p class="world-news-placing-message" role="alert">@_placeMessage</p>
                            }
                        </div>
                    }
                    <dl class="world-news-facts">
                        <dt>Languages</dt>
                        <dd>@string.Join(", ", _situation.Languages.Order())</dd>
                        <dt>Reported from</dt>
                        <dd>@string.Join(", ", _situation.Countries.Order())</dd>
                        @if (WorldNewsMapService.KindOf(_situation) == SituationKinds.Cyber)
                        {
                            var status = CyberStatus.Of([_situation.Title, _situation.Latest, .. _situationEvents.Select(e => e.Title)]);
                            <dt>Status</dt>
                            <dd>@CyberStatus.Label(status) <span class="text-secondary">(@CyberStatus.Meaning(status))</span></dd>
                        }
                    </dl>
                    <h3 class="world-news-language">How it developed <span>(@_situationEvents.Count)</span></h3>
                    <ol class="world-news-timeline">
                        @foreach (var e in _situationEvents)
                        {
                            <li>
                                <a class="world-news-timeline-event" href="@EventHref(e)" @onclick="() => OpenEventAsync(e)" @onclick:preventDefault>
                                    <time class="world-news-event-meta">@Time(e.FirstSeen)</time>
                                    <span class="world-news-event-title">@(e.Headline ?? e.Title)</span>
                                    <span class="world-news-event-meta">@WorldNewsBrowse.Seen(e.OutletCount, e.Languages.Count)</span>
                                </a>
                            </li>
                        }
                    </ol>
                }
            </section>
        </div>
    }
}
else if (_events is null)
{
    <ListSkeleton Message="Loading world news…" />
}
else if (_events.Count == 0)
{
    <EmptyState Icon="bi-globe-europe-africa" Title="No stories yet"
                Message="The server reads the news every 15 minutes. The first read takes a few minutes while every headline is grouped.">
        <button type="button" class="btn btn-sm btn-primary mt-2" @onclick="ReadNow" disabled="@News.IsRefreshing">
            <i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Read now
        </button>
    </EmptyState>
}
else
{
    <div class="world-news @(_selected is null ? "" : "has-selection")">
        <div class="world-news-list" aria-label="Latest stories">
            @if (VisibleEvents.Count == 0)
            {
                <EmptyState Icon="bi-search" Message="No stories match those filters." />
            }
            @{ var busiestEvent = VisibleEvents.Count == 0 ? 0 : VisibleEvents.Max(e => e.OutletCount); }
            @foreach (var e in VisibleEvents.Take(_shown))
            {
                @Row(EventHref(e), e.Headline ?? e.Title, FactsFor(e), WorldNewsBrowse.Seen(e.OutletCount, e.Languages.Count),
                    Time(e.LastSeen), WorldNewsBrowse.ReachPercent(e.OutletCount, busiestEvent), e.Id == _selected?.Id, () => SelectAsync(e))
            }
            @* A page of events at a time: all 300 made a 170 KB page, sent again by the live render. *@
            @if (VisibleEvents.Count > _shown)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary world-news-more" @onclick="() => _shown += PageSize">
                    Show @Math.Min(PageSize, VisibleEvents.Count - _shown) more of @(VisibleEvents.Count - _shown)
                </button>
            }
        </div>

        <section class="world-news-detail" aria-live="polite">
            @if (_selected is null)
            {
                <EmptyState Icon="bi-hand-index" Message="Pick a story to see every report on it, in every language." />
            }
            else
            {
                var facts = FactsFor(_selected);
                <button type="button" class="btn btn-sm btn-outline-secondary world-news-back" @onclick="ClearSelection" aria-keyshortcuts="Escape">
                    <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Latest
                </button>
                <div class="world-news-row-top">
                    @KindTag(facts)
                    @if (facts.Place is not null)
                    {
                        <span class="world-news-place"><i class="bi bi-geo-alt" aria-hidden="true"></i>@facts.Place</span>
                    }
                </div>
                <h2 class="world-news-detail-title">@(_selected.Headline ?? _selected.Title)</h2>
                @if (_selected.Headline is not null)
                {
                    <p class="world-news-original">Original headline: @_selected.Title</p>
                }
                <p class="world-news-detail-meta">
                    @WorldNewsBrowse.Seen(_selected.OutletCount, _selected.Languages.Count) · @WorldNewsBrowse.Count(_selected.ArticleCount, "report") ·
                    first @Time(_selected.FirstSeen), latest @Time(_selected.LastSeen)
                </p>
                <div class="world-news-detail-actions">
                    <button type="button" class="btn btn-sm btn-primary" disabled="@_documentLoading" @onclick="OpenDocumentAsync"
                            title="The overview, how the coverage compares, and every source with its link, in a window on this page">
                        <i class="bi bi-file-earmark-text me-1" aria-hidden="true"></i>Read document
                    </button>
                    <a class="btn btn-sm btn-outline-secondary" href="@PdfHref(_selected.Id)" download title="The same document as a PDF">
                        <i class="bi bi-file-earmark-pdf me-1" aria-hidden="true"></i>PDF
                    </a>
                    <button type="button" class="btn btn-sm btn-outline-secondary world-news-share" @onclick="() => ShareAsync(StoryHref(_selected.Id), _selected.Headline ?? _selected.Title)">
                        <i class="bi bi-box-arrow-up me-1" aria-hidden="true"></i>@(_shareNote ?? "Share")
                    </button>
                </div>
                @if (_documentError is not null)
                {
                    <p class="world-news-summary-meta text-danger" role="alert">@_documentError</p>
                }
                <section class="world-news-summary" aria-label="Summary">
                    @if (_summary is not null)
                    {
                        <p class="world-news-summary-text">@_summary.Text</p>
                        @if (_summary.Comparison is { Count: > 0 } comparison)
                        {
                            <h3 class="world-news-comparison-heading">@EventDocument.ComparisonHeading</h3>
                            <ul class="world-news-comparison">
                                @foreach (var point in comparison)
                                {
                                    <li>@point</li>
                                }
                            </ul>
                        }
                    }
                    <p class="world-news-summary-meta">@SummaryNote</p>
                </section>
                @if (_claims.Count > 0)
                {
                    <section class="world-news-claims" aria-label="Coverage figures">
                        <h3 class="world-news-language">Coverage figures</h3>
                        <p class="world-news-claims-note">
                            Read straight from each report's headline and description, without AI. Point at an outlet to see the sentence a figure came from.
                        </p>
                        @foreach (var claim in _claims)
                        {
                            <div class="world-news-claim">
                                <div class="world-news-claim-head">
                                    <strong>@claim.Label</strong>
                                    @if (claim.Corroborated)
                                    {
                                        <StatusPill Tone="StatusTone.Warning">Coverage disagrees</StatusPill>
                                    }
                                    else if (claim.Disputed)
                                    {
                                        <StatusPill Tone="StatusTone.Neutral">Figures vary</StatusPill>
                                    }
                                    else if (claim.Consensus)
                                    {
                                        <StatusPill Tone="StatusTone.Success">@WorldNewsBrowse.Count(claim.Values[0].Outlets, "outlet") agree</StatusPill>
                                    }
                                </div>
                                @if (claim.MayHaveRisen)
                                {
                                    <p class="world-news-claims-note">The lower figures all came first, so the number may have risen as reports were updated.</p>
                                }
                                <ul class="world-news-claim-values">
                                    @foreach (var value in claim.Values.Take(6))
                                    {
                                        <li>
                                            <span class="world-news-claim-value">@ValueText(value)</span>
                                            <span class="world-news-claim-sources">
                                                @foreach (var source in value.Sources.Take(5))
                                                {
                                                    <a href="@source.Article.Url" target="_blank" rel="noopener noreferrer" title="@source.Excerpt">@source.Article.Outlet</a>
                                                }
                                                @if (value.Sources.Count > 5)
                                                {
                                                    <span>and @(value.Sources.Count - 5) more</span>
                                                }
                                            </span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </section>
                }
                <dl class="world-news-facts">
                    <dt>Languages</dt>
                    <dd>@string.Join(", ", _selected.Languages.Order())</dd>
                    <dt>Reported from</dt>
                    <dd>@string.Join(", ", _selected.Countries.Order())</dd>
                </dl>
                @foreach (var language in _articles.GroupBy(a => a.Language).OrderByDescending(g => g.Count()).ThenBy(g => g.Key))
                {
                    <h3 class="world-news-language world-news-language-sticky">@language.Key <span>(@language.Count())</span></h3>
                    <ul class="world-news-reports">
                        @foreach (var a in language.OrderByDescending(a => a.SeenAt))
                        {
                            <li>
                                <a class="world-news-report" href="@a.Url" target="_blank" rel="noopener noreferrer">
                                    <span class="world-news-report-title">@a.Title</span>
                                    <span class="world-news-report-meta">@a.Outlet · @a.Country · <time>@Time(a.SeenAt)</time></span>
                                </a>
                            </li>
                        }
                    </ul>
                }
            }
        </section>
    </div>
}
</div>

@if (_document is not null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal d-block world-news-document-modal" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="world-news-document-title"
         @ref="_documentDialog" @onkeydown="OnDocumentKeyDown">
        <div class="modal-dialog modal-xl modal-dialog-scrollable modal-fullscreen-lg-down">
            <div class="modal-content">
                <div class="modal-header gap-2">
                    <h2 class="modal-title h5 text-truncate" id="world-news-document-title">@_document.Title</h2>
                    <a class="btn btn-sm btn-outline-secondary ms-auto flex-shrink-0" href="@StoryHref(_document.EventId)" title="This story on its own page, to bookmark or share">
                        <i class="bi bi-box-arrow-up-right me-1" aria-hidden="true"></i>Open as page
                    </a>
                    <a class="btn btn-sm btn-outline-secondary flex-shrink-0" href="@PdfHref(_document.EventId)" download title="This document as a PDF">
                        <i class="bi bi-file-earmark-pdf me-1" aria-hidden="true"></i>Download PDF
                    </a>
                    <button type="button" class="btn-close flex-shrink-0" aria-label="Close" @onclick="CloseDocument"></button>
                </div>
                <div class="modal-body">
                    <WorldNewsStoryView EventId="@_document.EventId" />
                </div>
            </div>
        </div>
    </div>
}

@code {
    private static readonly WorldNewsTab[] Tabs = [WorldNewsTab.Today, WorldNewsTab.Developing, WorldNewsTab.Latest];
    private static readonly IReadOnlyList<string> ChipKinds = SituationKinds.All.Where(kind => kind != SituationKinds.Other).ToList();
    // The page's own two-pane breakpoint (@container gws-main 900px in WorldNews.razor.css).
    private const int TwoPaneWidth = 900;

    private WorldNewsTab _view = WorldNewsTab.Today;
    private IReadOnlyList<SituationOverview>? _situations;
    private SituationOverview? _situation;
    private IReadOnlyList<EventOverview> _situationEvents = [];
    private IReadOnlyList<EventOverview>? _events;
    private EventOverview? _selected;
    private IReadOnlyList<WorldArticle> _articles = [];
    private IReadOnlyList<WorldArticle>? _reports;
    private bool _hasMoreReports;
    private int _reportOffset;
    private string _reportCountry = string.Empty;
    private string _reportLanguage = string.Empty;
    private string _reportOutlet = string.Empty;
    private string _kind = string.Empty;
    private string _where = string.Empty;
    private EventSummary? _summary;
    private EventSummary? _leadSummary;
    private IReadOnlyList<CoverageClaim> _claims = [];
    private WorldSnapshot? _world;
    private string _filter = string.Empty;
    private int _rangeHours = WorldNewsBrowse.TodayRangeHours;
    private const int PageSize = 60;
    private int _shown = PageSize;
    private string _username = string.Empty;
    private bool _watching;
    private bool _placing;
    private bool _surgeAlerts;
    private bool _filtersOpen;
    private WorldNewsLocation? _place;
    private SituationPlacement? _correction;
    private string _placeCountry = string.Empty;
    private string _placeCity = string.Empty;
    private string? _placeMessage;
    private string? _shareNote;
    private readonly Dictionary<string, WorldNewsRowFacts> _facts = new(StringComparer.Ordinal);

    private ElementReference _root;
    private IJSObjectReference? _module;
    private IJSObjectReference? _keys;
    private bool? _wide;
    private string? _lastUrl;

    [SupplyParameterFromQuery(Name = "view")] public string? ViewQuery { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? TextQuery { get; set; }
    [SupplyParameterFromQuery(Name = "range")] public string? RangeQuery { get; set; }
    [SupplyParameterFromQuery(Name = "kind")] public string? KindQuery { get; set; }
    [SupplyParameterFromQuery(Name = "where")] public string? WhereQuery { get; set; }
    [SupplyParameterFromQuery(Name = "country")] public string? CountryQuery { get; set; }
    [SupplyParameterFromQuery(Name = "language")] public string? LanguageQuery { get; set; }
    [SupplyParameterFromQuery(Name = "outlet")] public string? OutletQuery { get; set; }

    [SupplyParameterFromQuery(Name = "situation")]
    public string? SituationId { get; set; }

    // ?event=<id>&read=1 (Overwatch's READ DOCUMENT): that event, with its document open.
    [SupplyParameterFromQuery(Name = "event")]
    public string? EventQuery { get; set; }

    // Text, not bool: "read=1" would fail to parse as a bool and take the page down.
    [SupplyParameterFromQuery(Name = "read")]
    public string? ReadQuery { get; set; }

    private WorldNewsBrowseState State => new(_view, _filter, _rangeHours, _kind, _where, _reportCountry, _reportLanguage, _reportOutlet,
        _view == WorldNewsTab.Latest ? _selected?.Id : null, _view == WorldNewsTab.Developing ? _situation?.Id : null);

    private string EventHref(EventOverview e) => WorldNewsBrowse.Url(State with { Tab = WorldNewsTab.Latest, EventId = e.Id, SituationId = null,
        RangeHours = _view == WorldNewsTab.Latest ? _rangeHours : WorldNewsBrowse.DefaultRangeHours });

    private string SituationHref(string id) => WorldNewsBrowse.Url(State with { Tab = WorldNewsTab.Developing, SituationId = id, EventId = null,
        RangeHours = _view == WorldNewsTab.Developing ? _rangeHours : WorldNewsBrowse.DefaultRangeHours });

    private string SearchPlaceholder => _view == WorldNewsTab.Reports ? "Search every report" : "Search stories";

    private string UpdatedLine => News.IsRefreshing
        ? "Reading the news…"
        : News.LastRefreshed is { } at ? $"Updated {Time(at)}" : "Not read yet";

    private static string Time(DateTimeOffset at) => WorldNewsBrowse.TimeLabel(at, DateTimeOffset.UtcNow);

    private WorldNewsRowFacts FactsFor(EventOverview e) =>
        _facts.TryGetValue(e.Id, out var facts) ? facts : _facts[e.Id] = WorldNewsBrowse.Facts(e);

    private WorldNewsRowFacts FactsFor(SituationOverview s) =>
        _facts.TryGetValue("s:" + s.Id, out var facts) ? facts : _facts["s:" + s.Id] = WorldNewsBrowse.Facts(s);

    private IReadOnlyList<EventOverview> VisibleEvents => (_events ?? [])
        .Where(e => WorldNewsBrowse.Matches(e.Title, e.Headline, FactsFor(e), e.Countries, e.Languages, State)).ToList();

    private IReadOnlyList<SituationOverview> VisibleSituations => (_situations ?? [])
        .Where(s => WorldNewsBrowse.Matches(s.Title, s.Latest, FactsFor(s), s.Countries, s.Languages, State)).ToList();

    private IReadOnlyList<WorldStory> TodayStories => (_world?.BiggestStories ?? [])
        .Where(story => WorldNewsBrowse.Matches(story.Event.Title, story.Event.Headline, FactsFor(story.Event), story.Event.Countries, story.Event.Languages, State))
        .ToList();

    private IReadOnlyList<WorldCountry> VisibleCountries => (_world?.Countries ?? []).Where(country =>
        (string.IsNullOrWhiteSpace(_filter) || country.Name.Contains(_filter.Trim(), StringComparison.CurrentCultureIgnoreCase)
            || country.TopStories.Any(story => WorldNewsBrowse.Contains(story.Event.Headline ?? story.Event.Title, _filter)))
        && (_where.Length == 0 || string.Equals(country.Name, _where, StringComparison.OrdinalIgnoreCase))).ToList();

    // Where options: the countries the headlines in view are placed in.
    private IReadOnlyList<string> WhereOptions => (_view switch
        {
            WorldNewsTab.Today => (_world?.BiggestStories ?? []).Select(s => FactsFor(s.Event).PlaceCountry),
            WorldNewsTab.Developing => (_situations ?? []).Select(s => FactsFor(s).PlaceCountry),
            _ => (_events ?? []).Select(e => FactsFor(e).PlaceCountry)
        })
        .OfType<string>().Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.CurrentCulture).ToList();

    private IEnumerable<(IReadOnlyList<string> Countries, IReadOnlyList<string> Languages)> Coverage => _view switch
    {
        WorldNewsTab.Today => (_world?.BiggestStories ?? []).Select(s => (s.Event.Countries, s.Event.Languages)),
        WorldNewsTab.Developing => (_situations ?? []).Select(s => (s.Countries, s.Languages)),
        WorldNewsTab.Reports => (_reports ?? []).Select(r => ((IReadOnlyList<string>)[r.Country], (IReadOnlyList<string>)[r.Language])),
        _ => (_events ?? []).Select(e => (e.Countries, e.Languages))
    };

    private IReadOnlyList<string> SourceCountryOptions => Coverage.SelectMany(c => c.Countries).Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.CurrentCulture).ToList();
    private IReadOnlyList<string> LanguageOptions => Coverage.SelectMany(c => c.Languages).Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.CurrentCulture).ToList();

    private int SourceFilterCount => new[] { _reportCountry, _reportLanguage, _reportOutlet }.Count(value => !string.IsNullOrWhiteSpace(value));

    private sealed record ActiveFilter(string Label, Func<Task> Clear);

    private IReadOnlyList<ActiveFilter> ActiveFilters
    {
        get
        {
            var filters = new List<ActiveFilter>();
            if (!string.IsNullOrWhiteSpace(_filter)) filters.Add(new($"“{_filter.Trim()}”", () => { _filter = string.Empty; return ChangeTextFilterAsync(); }));
            if (_where.Length > 0) filters.Add(new($"In {_where}", () => { _where = string.Empty; return ChangeWhereAsync(); }));
            if (!string.IsNullOrWhiteSpace(_reportCountry)) filters.Add(new($"Reported from {_reportCountry.Trim()}", () => { _reportCountry = string.Empty; return ChangeSourceFilterAsync(); }));
            if (!string.IsNullOrWhiteSpace(_reportLanguage)) filters.Add(new($"In {_reportLanguage.Trim()}", () => { _reportLanguage = string.Empty; return ChangeSourceFilterAsync(); }));
            if (!string.IsNullOrWhiteSpace(_reportOutlet)) filters.Add(new($"Outlet {_reportOutlet.Trim()}", () => { _reportOutlet = string.Empty; return ChangeSourceFilterAsync(); }));
            return filters;
        }
    }

    // One list row: kind and place, the headline, how widely it's covered, and when. A real link,
    // so right-click Copy link and Open in new tab work; a plain click opens it in place.
    private RenderFragment Row(string href, string title, WorldNewsRowFacts facts, string seen, string time, int reach, bool selected,
        Func<Task> open, string? extra = null, string? state = null, StatusTone tone = StatusTone.Neutral) =>
        @<a class="world-news-event @(selected ? "is-selected" : "")" href="@href" aria-current="@(selected ? "true" : "false")"
            title="@title" @onclick="open" @onclick:preventDefault>
            <span class="world-news-row-top">
                @if (state is not null)
                {
                    <StatusPill Tone="@tone">@state</StatusPill>
                }
                @KindTag(facts)
                @if (facts.Place is not null)
                {
                    <span class="world-news-place"><i class="bi bi-geo-alt" aria-hidden="true"></i>@facts.Place</span>
                }
                <time class="world-news-time">@time</time>
            </span>
            <span class="world-news-event-title">@title</span>
            @if (extra is not null)
            {
                <span class="world-news-event-meta world-news-latest">@extra</span>
            }
            <span class="world-news-row-bottom">
                <span class="world-news-reach" aria-hidden="true"><span style="width: @(reach)%"></span></span>
                <span class="world-news-event-meta">@seen</span>
            </span>
        </a>;

    private RenderFragment KindTag(WorldNewsRowFacts facts) =>
        @<text>@if (facts.Kind != SituationKinds.Other)
        {
            <span class="world-news-kind" data-kind="@facts.Kind">@facts.KindLabel</span>
        }</text>;

    private string SummaryNote => _summary is null
        ? "No summary yet. After each read, the busiest events covered by 3 or more outlets are summarized in English."
        : $"Summary by {_summary.Model} from {WorldNewsBrowse.Count(_summary.ArticleCount, "report")}, {_summary.CreatedAt.ToLocalGwsDateTime()}"
          + (_summary.Version > 1 ? $" (version {_summary.Version}; rewritten as coverage grows)." : ".")
          + " Written by AI from headlines and outlets' descriptions"
          + (_summary.Model.EndsWith(" on the Mac", StringComparison.Ordinal)
              ? ": check the sources before relying on a detail."
              : " by the server's small model, which can mix up who did what: check the sources before relying on a detail.");

    protected override async Task OnInitializedAsync()
    {
        News.Changed += OnNewsChanged;
        _username = await CurrentUserAccessor.GetCurrentUsernameAsync();
        _surgeAlerts = !string.IsNullOrWhiteSpace(_username) && await Task.Run(() => News.Store.IsWatchingSurges(_username));
        _silences = await Task.Run(() => News.Store.Silences(DateTimeOffset.UtcNow));
        _ = LoadSurgesAsync();
        ApplyQuery();
        await LoadAsync();
        if (!string.IsNullOrWhiteSpace(EventQuery)
            && (_events?.FirstOrDefault(e => e.Id == EventQuery) ?? await Task.Run(() => News.Store.Event(EventQuery))) is { } linked)
        {
            await OpenEventAsync(linked);
            if (ReadQuery is "1" or "true") await OpenDocumentAsync();
            return;
        }
        if (!string.IsNullOrWhiteSpace(SituationId)
            && (_situations?.FirstOrDefault(s => s.Id == SituationId) ?? await Task.Run(() => News.Store.Situation(SituationId))) is { } situation)
        {
            if (_view != WorldNewsTab.Developing)
            {
                _view = WorldNewsTab.Developing;
                _rangeHours = WorldNewsBrowse.RangeFor(_view, _rangeHours);
                await LoadAsync();
            }
            await SelectSituationAsync(situation);
        }
    }

    // The address the page was opened with: a shared link, a reload, or an old-style link.
    private void ApplyQuery()
    {
        _view = WorldNewsBrowse.ParseTab(ViewQuery, EventQuery, SituationId);
        _filter = TextQuery?.Trim() ?? string.Empty;
        _rangeHours = WorldNewsBrowse.RangeFor(_view, int.TryParse(RangeQuery, out var hours) ? hours : 0);
        _kind = KindQuery is { } kind && ChipKinds.Contains(kind) ? kind : string.Empty;
        _where = WhereQuery?.Trim() ?? string.Empty;
        _reportCountry = CountryQuery?.Trim() ?? string.Empty;
        _reportLanguage = LanguageQuery?.Trim() ?? string.Empty;
        _reportOutlet = OutletQuery?.Trim() ?? string.Empty;
        _filtersOpen = SourceFilterCount > 0;
    }

    private async Task LoadAsync()
    {
        if (_view == WorldNewsTab.Reports)
        {
            await LoadReportsAsync(reset: true);
            return;
        }
        if (_view == WorldNewsTab.Today)
        {
            _world = await Task.Run(() => News.World(_rangeHours));
            var lead = TodayStories.FirstOrDefault();
            _leadSummary = lead is null ? null : await Task.Run(() => News.Store.LatestSummary(lead.Event.Id));
            return;
        }
        if (_view == WorldNewsTab.Developing)
        {
            _situations = await Task.Run(() => News.TopSituations(_rangeHours));
            if (_situation is not null) _situation = _situations.FirstOrDefault(s => s.Id == _situation.Id);
            if (_situation is not null) _situationEvents = await Task.Run(() => News.Store.EventsForSituation(_situation.Id));
            LoadPlacement();
            return;
        }
        _events = await Task.Run(() => News.TopEvents(_rangeHours));
        if (_selected is not null) _selected = _events.FirstOrDefault(e => e.Id == _selected.Id);
        if (_selected is not null) _summary = await Task.Run(() => News.Store.LatestSummary(_selected.Id));
    }

    private async Task ShowAsync(WorldNewsTab view)
    {
        // Today always opens on "right now"; the other tabs keep a range they share.
        _rangeHours = view == WorldNewsTab.Today ? WorldNewsBrowse.TodayRangeHours : WorldNewsBrowse.RangeFor(view, _rangeHours);
        _view = view;
        _shown = PageSize;
        await LoadAsync();
        await SelectFirstWhenWideAsync();
    }

    private Task SearchReportsAsync()
    {
        _filtersOpen = _filtersOpen || SourceFilterCount > 0;
        return ShowAsync(WorldNewsTab.Reports);
    }

    private async Task SetKindAsync(string kind)
    {
        _kind = kind;
        _shown = PageSize;
        if (_view == WorldNewsTab.Reports) await LoadReportsAsync(reset: true);
        else if (_view == WorldNewsTab.Today) await LoadAsync();
    }

    private Task ChangeWhereAsync()
    {
        _shown = PageSize;
        return _view == WorldNewsTab.Today ? LoadAsync() : Task.CompletedTask;
    }

    private Task ChangeTextFilterAsync()
    {
        _shown = PageSize;
        return _view == WorldNewsTab.Reports ? LoadReportsAsync(reset: true) : Task.CompletedTask;
    }

    private Task ChangeSourceFilterAsync()
    {
        _shown = PageSize;
        return _view == WorldNewsTab.Reports ? LoadReportsAsync(reset: true) : Task.CompletedTask;
    }

    private Task ClearFiltersAsync()
    {
        _filter = _where = _reportCountry = _reportLanguage = _reportOutlet = string.Empty;
        _shown = PageSize;
        return LoadAsync();
    }

    private async Task LoadReportsAsync(bool reset)
    {
        if (reset)
        {
            _reports = null;
            _reportOffset = 0;
            _hasMoreReports = false;
        }
        var page = await Task.Run(() => News.Store.RecentReports(DateTimeOffset.UtcNow.AddHours(-_rangeHours),
            PageSize + 1, _reportOffset, _filter, _reportCountry, _reportLanguage, _reportOutlet, _kind));
        var shown = page.Take(PageSize).ToArray();
        _reports = reset ? shown : [.. _reports ?? [], .. shown];
        _reportOffset += shown.Length;
        _hasMoreReports = page.Count > PageSize;
    }

    private Task LoadMoreReportsAsync() => LoadReportsAsync(reset: false);

    private static string? ArticleHref(WorldArticle article) =>
        Uri.TryCreate(article.Url, UriKind.Absolute, out var uri)
        && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps) ? uri.ToString() : null;

    private async Task SelectSituationAsync(SituationOverview situation)
    {
        _situation = situation;
        _shareNote = null;
        _situationEvents = await Task.Run(() => News.Store.EventsForSituation(situation.Id));
        _watching = await Task.Run(() => News.Store.IsWatching(_username, situation.Id));
        _placing = false;
        LoadPlacement();
    }

    private async Task OpenSituationAsync(string situationId)
    {
        _rangeHours = WorldNewsBrowse.DefaultRangeHours;
        _view = WorldNewsTab.Developing;
        _shown = PageSize;
        await LoadAsync();
        if ((_situations?.FirstOrDefault(s => s.Id == situationId) ?? await Task.Run(() => News.Store.Situation(situationId))) is { } situation)
            await SelectSituationAsync(situation);
    }

    // Narrow windows show the list again; wide ones keep a story open, so this only shows there.
    private void ClearSelection()
    {
        _selected = null;
        _situation = null;
        _shareNote = null;
    }

    // Where Overwatch puts the open situation, and any hand correction of it.
    private void LoadPlacement()
    {
        if (_situation is null) return;
        _correction = WorldNewsMap.Correction(_situation.Id);
        _place = WorldNewsMap.Place(_situation, DateTimeOffset.UtcNow - WorldNewsMapService.Window);
    }

    private void TogglePlacing()
    {
        _placing = !_placing;
        _placeMessage = null;
        var current = _correction is { Hidden: false } ? WorldNewsPlaces.Instance.Country(_correction.CountryCode) : null;
        var named = _situation is null ? null : WorldNewsMapService.Named(_situation);
        _placeCountry = current?.Code ?? named?.CountryCode ?? string.Empty;
        _placeCity = _correction is { Hidden: false } ? _correction.City ?? string.Empty : named?.City ?? string.Empty;
    }

    private string PlacementNow()
    {
        if (_situation is null) return string.Empty;
        var shown = _place is null ? " It isn't on the globe now: that needs 3 or more outlets and news in the last 24 hours." : string.Empty;
        if (_correction is { Hidden: true })
            return $"Kept off the globe by {_correction.UpdatedBy} on {_correction.UpdatedAt.ToLocalGwsDateTime()}.";
        if (_correction is not null)
            return $"Placed by hand at {_place?.Label ?? _correction.City ?? _correction.CountryCode} by {_correction.UpdatedBy} on {_correction.UpdatedAt.ToLocalGwsDateTime()}.{shown}";
        return WorldNewsMapService.Named(_situation) is { } named
            ? $"The headlines place it at {named.Label} ({named.PlacementText}).{shown}"
            : "The headlines don't name a place, so it isn't on the globe. Pick one below to put it there.";
    }

    private void SavePlacement()
    {
        if (_situation is null) return;
        _placeMessage = WorldNewsMap.Correct(_situation.Id, _placeCountry, _placeCity, _username, DateTimeOffset.UtcNow);
        if (_placeMessage is not null) return;
        _placing = false;
        _facts.Remove("s:" + _situation.Id);
        LoadPlacement();
    }

    private void HidePlacement()
    {
        if (_situation is null) return;
        WorldNewsMap.Hide(_situation.Id, _username, DateTimeOffset.UtcNow);
        _placing = false;
        LoadPlacement();
    }

    private void UndoPlacement()
    {
        if (_situation is null) return;
        WorldNewsMap.ClearCorrection(_situation.Id);
        _placing = false;
        LoadPlacement();
    }

    private IReadOnlyList<CoverageSilence> _silences = [];
    private IReadOnlyList<GwsBusinessSuite.Application.Hazards.CoverageSurge> _surges = [];

    // Off the first render: the first visit of the day fetches GDELT's recent quarter-hour files.
    private async Task LoadSurgesAsync()
    {
        try
        {
            _surges = await Gdelt.SurgesAsync(_surgeCts.Token);
            if (_surges.Count > 0) await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    private readonly CancellationTokenSource _surgeCts = new();
    private bool _watchlistOpen;
    private IReadOnlyList<KeywordWatch> _watchlist = [];
    private string _newWatch = string.Empty;
    private string? _watchError;

    private async Task ToggleWatchlistAsync()
    {
        _watchlistOpen = !_watchlistOpen;
        if (_watchlistOpen && !string.IsNullOrWhiteSpace(_username)) _watchlist = await Task.Run(() => News.Store.KeywordWatches(_username));
    }

    private async Task AddWatchAsync()
    {
        if (string.IsNullOrWhiteSpace(_username) || string.IsNullOrWhiteSpace(_newWatch)) return;
        var query = _newWatch;
        var added = await Task.Run(() => News.Store.AddKeywordWatch(_username, query, DateTimeOffset.UtcNow));
        _watchError = added is null ? $"That can't be watched (nothing to search for, or you already watch {WorldNewsStore.MaxKeywordWatches})." : null;
        if (added is not null) _newWatch = string.Empty;
        _watchlist = await Task.Run(() => News.Store.KeywordWatches(_username));
    }

    private async Task RemoveWatchAsync(string id)
    {
        if (string.IsNullOrWhiteSpace(_username)) return;
        await Task.Run(() => News.Store.RemoveKeywordWatch(_username, id));
        _watchlist = await Task.Run(() => News.Store.KeywordWatches(_username));
    }

    private async Task ToggleSurgeAlertsAsync()
    {
        if (string.IsNullOrWhiteSpace(_username)) return;
        _surgeAlerts = !_surgeAlerts;
        var on = _surgeAlerts;
        await Task.Run(() => News.Store.WatchSurges(_username, on, DateTimeOffset.UtcNow));
    }

    private async Task ToggleWatchAsync()
    {
        if (_situation is null || string.IsNullOrWhiteSpace(_username)) return;
        if (_watching) await Task.Run(() => News.Store.Unwatch(_username, _situation.Id));
        else await Task.Run(() => News.Store.Watch(_username, _situation.Id, DateTimeOffset.UtcNow));
        _watching = !_watching;
    }

    // A story from Today, a situation's timeline or a country card opens in Latest, with all its reports.
    private async Task OpenEventAsync(EventOverview e)
    {
        var range = _view == WorldNewsTab.Latest ? _rangeHours : WorldNewsBrowse.DefaultRangeHours;
        if (_view != WorldNewsTab.Latest || _events is null)
        {
            _view = WorldNewsTab.Latest;
            _rangeHours = range;
            _shown = PageSize;
            await LoadAsync();
        }
        await SelectAsync(_events?.FirstOrDefault(item => item.Id == e.Id) ?? e);
    }

    private async Task ChangeRangeAsync()
    {
        _shown = PageSize;
        await LoadAsync();
        await SelectFirstWhenWideAsync();
    }

    private async Task SelectAsync(EventOverview e)
    {
        _selected = e;
        _summary = null;
        _claims = [];
        _documentError = null;
        _shareNote = null;
        (_articles, _summary, _claims) = await Task.Run(() =>
        {
            var articles = News.Store.ArticlesForEvent(e.Id);
            return (articles, News.Store.LatestSummary(e.Id), CoverageClaims.For(articles));
        });
    }

    // A wide window always has a story open beside the list (as Mail does); a narrow one shows
    // the list first, since the story would cover it.
    private async Task SelectFirstWhenWideAsync()
    {
        if (_wide != true) return;
        if (_view == WorldNewsTab.Latest && _selected is null && VisibleEvents.FirstOrDefault() is { } first) await SelectAsync(first);
        else if (_view == WorldNewsTab.Developing && _situation is null && VisibleSituations.FirstOrDefault() is { } top) await SelectSituationAsync(top);
    }

    private async Task ShareAsync(string href, string title)
    {
        if (_module is null) return;
        try
        {
            var result = await _module.InvokeAsync<string>("share", href, title);
            _shareNote = result switch { "copied" => "Link copied", "failed" => "Couldn't share", _ => null };
        }
        catch (JSException)
        {
            _shareNote = "Couldn't share";
        }
    }

    private static string ValueText(ClaimValue value) => EventDocument.ValueText(value);

    // A read takes from seconds to a few minutes; the page follows it through News.Changed.
    private void ReadNow() => _ = News.RefreshAsync(CancellationToken.None);

    private void OnNewsChanged() => _ = InvokeAsync(async () =>
    {
        _facts.Clear();
        await LoadAsync();
        StateHasChanged();
    });

    private static string StateLabel(SituationOverview s) => SituationLinker.IsActive(s.LastSeen, DateTimeOffset.UtcNow) ? "Active" : "Quiet";

    private static StatusTone Tone(SituationOverview s) =>
        SituationLinker.IsActive(s.LastSeen, DateTimeOffset.UtcNow) ? StatusTone.Success : StatusTone.Neutral;

    // The event's document in a dialog (WorldNewsStoryView, as on the story page), which writes
    // SentinelGPT's analysis when it's due.
    private sealed record OpenDocument(string EventId, string Title);

    private OpenDocument? _document;
    private bool _documentLoading;
    private string? _documentError;
    private ElementReference _documentDialog;
    private bool _focusDocument;

    private static string PdfHref(string eventId) => $"admin/world-news/events/{Uri.EscapeDataString(eventId)}/document.pdf";

    private static string StoryHref(string eventId) => $"admin/world-news/events/{Uri.EscapeDataString(eventId)}";

    private async Task OpenDocumentAsync()
    {
        if (_selected is not { } e) return;
        _documentLoading = true;
        _documentError = null;
        try
        {
            // Merged or pruned since the list was read.
            if (await Task.Run(() => News.Store.Event(e.Id)) is not { } current)
            {
                _documentError = "This event isn't there any more (events are merged and pruned as coverage changes).";
                return;
            }
            _document = new OpenDocument(current.Id, current.Headline ?? current.Title);
            _focusDocument = true;
        }
        finally
        {
            _documentLoading = false;
        }
    }

    private void CloseDocument() => _document = null;

    private void OnDocumentKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseDocument();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/world-news.js");
                _keys = await _module.InvokeAsync<IJSObjectReference>("attach", _root);
                _wide = await _module.InvokeAsync<bool>("isWide", _root, TwoPaneWidth);
                if (_wide == true && _selected is null && _situation is null && _view is WorldNewsTab.Latest or WorldNewsTab.Developing)
                {
                    await SelectFirstWhenWideAsync();
                    StateHasChanged();
                }
            }
            catch (JSDisconnectedException)
            {
                return;
            }
        }
        // The address follows the page, so a reload or a copied link opens this same view.
        var url = WorldNewsBrowse.Url(State);
        if (_module is not null && url != _lastUrl)
        {
            _lastUrl = url;
            try
            {
                await _module.InvokeVoidAsync("setUrl", url);
            }
            catch (JSDisconnectedException)
            {
            }
        }
        // Focus goes into the dialog when it opens, so Escape reaches it and screen readers land there.
        if (!_focusDocument || _document is null) return;
        _focusDocument = false;
        try
        {
            await _documentDialog.FocusAsync();
        }
        catch (JSException)
        {
            // The dialog closed before the browser got to it.
        }
    }

    public async ValueTask DisposeAsync()
    {
        await _surgeCts.CancelAsync();
        _surgeCts.Dispose();
        News.Changed -= OnNewsChanged;
        try
        {
            if (_keys is not null)
            {
                await _keys.InvokeVoidAsync("dispose");
                await _keys.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit has gone; the browser dropped the listeners with the page.
        }
    }
}
