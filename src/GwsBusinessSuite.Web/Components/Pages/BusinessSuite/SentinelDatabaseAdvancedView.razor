@using System.Text.Json.Nodes
@using GwsBusinessSuite.Application.Abstractions
@using GwsBusinessSuite.Application.Wiki
@using GwsBusinessSuite.Domain.Entities
@implements IAsyncDisposable
@inject IWikiDatabaseService WikiDatabaseService
@inject ICurrentUserAccessor CurrentUserAccessor
@inject IJSRuntime JS

@if (View.Type == WikiDatabaseViewTypes.Timeline)
{
    var dateProperty = ResolveProperty(WikiDatabasePropertyTypes.Date);
    if (dateProperty is null)
    {
        <div class="alert alert-secondary py-2">Add a Date property to use Timeline.</div>
    }
    else
    {
        var dependencyProperty = ResolveTimelineDependencyProperty();
        var schedule = WikiDatabaseViewLogic.BuildTimelineSchedule(VisibleRows, dateProperty, dependencyProperty);
        <div class="sentinel-db-timeline" aria-label="Timeline for @Database.Title" @ref="_timelineContainerRef"
             data-schedule-start="@schedule.StartDate?.ToString("yyyy-MM-dd")" data-schedule-end="@schedule.EndDate?.ToString("yyyy-MM-dd")"
             data-can-edit="@(CanEdit ? "true" : "false")">
            <header>
                <div>
                    <strong>Timeline</strong>
                    @if (schedule.StartDate is { } startDate && schedule.EndDate is { } endDate)
                    {
                        <span>@startDate.ToString("MMM d, yyyy") – @endDate.ToString("MMM d, yyyy")</span>
                    }
                    else
                    {
                        <span>Add a date to a row to place it on the schedule.</span>
                    }
                </div>
                @if (dependencyProperty is not null)
                {
                    <span class="badge text-bg-secondary">@dependencyProperty.Name dependencies</span>
                }
            </header>

            @foreach (var item in schedule.DatedItems)
            {
                <article class="sentinel-db-timeline-row">
                    <div class="sentinel-db-timeline-label">
                        <button type="button" @onclick="() => OnOpenRow.InvokeAsync(item.Row.Id)">@Title(item.Row)</button>
                        <time>@item.Date?.ToString("MMM d, yyyy")</time>
                        @if (dependencyProperty is not null)
                        {
                            <details>
                                <summary>@DependencySummary(item)</summary>
                                <div class="sentinel-db-timeline-dependency-picker">
                                    @foreach (var candidate in VisibleRows.Where(row => row.Id != item.Row.Id).OrderBy(Title))
                                    {
                                        <label class="form-check mb-1">
                                            <input class="form-check-input" type="checkbox"
                                                   checked="@item.DependsOnRowIds.Contains(candidate.Id)"
                                                   disabled="@(!CanEdit || _savingDependencyRowId == item.Row.Id)"
                                                   @onchange="e => ToggleTimelineDependencyAsync(item.Row, dependencyProperty, candidate.Id, (bool)(e.Value ?? false))" />
                                            <span class="form-check-label small">@Title(candidate)</span>
                                        </label>
                                    }
                                    @if (VisibleRows.Count <= 1)
                                    {
                                        <span class="small text-secondary">Add another row before creating a dependency.</span>
                                    }
                                </div>
                            </details>
                        }
                    </div>
                    <div class="sentinel-db-timeline-track" style="@TimelineBarStyle(item, schedule)"
                         data-row-id="@item.Row.Id" data-date="@item.Date?.ToString("yyyy-MM-dd")">
                        <button type="button" class="sentinel-db-timeline-bar"
                                @onclick="() => OnOpenRow.InvokeAsync(item.Row.Id)"
                                title="@(CanEdit ? $"{Title(item.Row)} — {item.Date:MMM d, yyyy} (drag to reschedule)" : $"{Title(item.Row)} — {item.Date:MMM d, yyyy}")">
                            <span>@Title(item.Row)</span>
                        </button>
                        @if (item.DependsOnRowIds.Count > 0)
                        {
                            <div class="sentinel-db-timeline-links">
                                <i class="bi bi-arrow-return-right" aria-hidden="true"></i>
                                <span>After @string.Join(", ", item.DependsOnRowIds.Select(DependencyTitle))</span>
                            </div>
                        }
                    </div>
                </article>
            }

            @if (schedule.UndatedItems.Count > 0)
            {
                <section class="sentinel-db-timeline-undated">
                    <strong>Unscheduled</strong>
                    <div>
                        @foreach (var item in schedule.UndatedItems)
                        {
                            <button type="button" @onclick="() => OnOpenRow.InvokeAsync(item.Row.Id)">@Title(item.Row)</button>
                        }
                    </div>
                </section>
            }
            @if (!string.IsNullOrWhiteSpace(_timelineMessage))
            {
                <div class="alert alert-danger py-2 small mb-0">@_timelineMessage</div>
            }
        </div>
    }
}
else if (View.Type == WikiDatabaseViewTypes.Chart)
{
    var chartProperty = ResolveChartProperty();
    if (chartProperty is null)
    {
        <div class="alert alert-secondary py-2">Add a Select, Multi-select, Checkbox, text, Formula, or Rollup property to use Chart.</div>
    }
    else
    {
        var buckets = WikiDatabaseViewLogic.BuildChart(VisibleRows, chartProperty);
        var maximum = Math.Max(1, buckets.Select(bucket => bucket.Count).DefaultIfEmpty().Max());
        <div class="sentinel-db-chart-toolbar" role="group" aria-label="Chart type">
            @foreach (var type in new[] { WikiDatabaseChartTypes.Bar, WikiDatabaseChartTypes.Line, WikiDatabaseChartTypes.Donut })
            {
                <button type="button" class="btn btn-sm @(ChartType == type ? "btn-secondary" : "btn-outline-secondary")"
                        @onclick="() => SetChartTypeAsync(type)" disabled="@(!CanEdit || _savingChartType)">
                    @System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(type)
                </button>
            }
        </div>

        @if (ChartType == WikiDatabaseChartTypes.Line)
        {
            <svg class="sentinel-db-chart-line" viewBox="0 0 100 100" preserveAspectRatio="none" role="img" aria-label="Line chart grouped by @chartProperty.Name">
                <polyline points="@LinePoints(buckets, maximum)" fill="none" stroke="#f59e0b" stroke-width="2.5" vector-effect="non-scaling-stroke" />
            </svg>
            <div class="sentinel-db-chart-legend">
                @foreach (var bucket in buckets)
                {
                    <span title="@bucket.Label">@bucket.Label <strong>@bucket.Count</strong></span>
                }
            </div>
        }
        else if (ChartType == WikiDatabaseChartTypes.Donut)
        {
            var segments = DonutSegments(buckets);
            <svg class="sentinel-db-chart-donut" viewBox="0 0 100 100" role="img" aria-label="Donut chart grouped by @chartProperty.Name">
                <g transform="rotate(-90 50 50)">
                    @for (var index = 0; index < segments.Count; index++)
                    {
                        var segment = segments[index];
                        <circle cx="50" cy="50" r="40" fill="none" stroke="@segment.Color" stroke-width="16"
                                stroke-dasharray="@(FormattableString.Invariant($"{segment.DashArrayValue:0.##} 999"))"
                                stroke-dashoffset="@(FormattableString.Invariant($"{segment.DashOffset:0.##}"))" />
                    }
                </g>
            </svg>
            <div class="sentinel-db-chart-legend">
                @for (var index = 0; index < buckets.Count; index++)
                {
                    var bucket = buckets[index];
                    <span title="@bucket.Label"><i style="background:@ChartPalette[index % ChartPalette.Count]"></i>@bucket.Label <strong>@bucket.Count</strong></span>
                }
            </div>
        }
        else
        {
            <div class="sentinel-db-chart" role="img" aria-label="Chart grouped by @chartProperty.Name">
                @foreach (var bucket in buckets)
                {
                    <div class="sentinel-db-chart-row">
                        <span title="@bucket.Label">@bucket.Label</span>
                        <div><i style="width:@((bucket.Count * 100d / maximum).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></i></div>
                        <strong>@bucket.Count</strong>
                    </div>
                }
            </div>
        }
    }
}
else if (View.Type == WikiDatabaseViewTypes.Form)
{
    <EditForm Model="_formValues" OnValidSubmit="SubmitFormAsync" class="sentinel-db-form">
        <h5>New @Database.Title entry</h5>
        @foreach (var property in Database.Properties.OrderBy(property => property.SortOrder)
            .Where(property => property.Type is not (WikiDatabasePropertyTypes.CreatedTime or WikiDatabasePropertyTypes.Formula or WikiDatabasePropertyTypes.Rollup)))
        {
            <label>
                <span>@property.Name</span>
                @if (property.Type == WikiDatabasePropertyTypes.Checkbox)
                {
                    <input type="checkbox" checked="@FormBool(property.Id)" @onchange="eventArgs => SetFormCheckbox(property.Id, eventArgs.Value)" />
                }
                else if (property.Type is WikiDatabasePropertyTypes.Select or WikiDatabasePropertyTypes.MultiSelect or WikiDatabasePropertyTypes.Relation)
                {
                    <select multiple="@(property.Type is WikiDatabasePropertyTypes.MultiSelect or WikiDatabasePropertyTypes.Relation)" value="@FormValue(property.Id)"
                            @onchange="eventArgs => _formValues[property.Id] = eventArgs.Value?.ToString() ?? string.Empty">
                        <option value="">—</option>
                        @foreach (var option in WikiDatabasePropertyConfig.GetOptions(property))
                        {
                            <option value="@option.Id">@option.Label</option>
                        }
                    </select>
                }
                else
                {
                    <input type="@(property.Type == WikiDatabasePropertyTypes.Number ? "number" : property.Type == WikiDatabasePropertyTypes.Date ? "date" : property.Type == WikiDatabasePropertyTypes.Url ? "url" : "text")"
                           value="@FormValue(property.Id)" @onchange="eventArgs => _formValues[property.Id] = eventArgs.Value?.ToString() ?? string.Empty" />
                }
            </label>
        }
        <button type="submit" class="btn btn-primary" disabled="@_saving">Submit</button>
        @if (!string.IsNullOrWhiteSpace(_formMessage))
        {
            <span class="small text-success">@_formMessage</span>
        }
    </EditForm>
}
else if (View.Type == WikiDatabaseViewTypes.Map)
{
    var placeProperty = ResolveProperty(WikiDatabasePropertyTypes.Place);
    if (placeProperty is null)
    {
        <div class="alert alert-secondary py-2">Add a Place property to use Map.</div>
    }
    else
    {
        <div class="sentinel-db-map-canvas" @ref="_mapContainerRef" aria-label="Map for @Database.Title"></div>
        <div class="sentinel-db-map">
            @foreach (var row in VisibleRows)
            {
                var place = WikiPropertyValues.GetText(WikiPropertyValues.ParseObject(row.PropertyValuesJson), placeProperty.Id);
                if (!string.IsNullOrWhiteSpace(place))
                {
                    <article>
                        <i class="bi bi-geo-alt-fill"></i>
                        <div><button type="button" @onclick="() => OnOpenRow.InvokeAsync(row.Id)">@Title(row)</button><span>@place</span></div>
                        <a href="@OpenStreetMapUrl(place)" target="_blank" rel="noopener noreferrer">Map ↗</a>
                    </article>
                }
            }
        </div>
    }
}
else if (View.Type == WikiDatabaseViewTypes.Feed)
{
    <div class="sentinel-db-feed">
        @foreach (var row in VisibleRows.OrderByDescending(row => row.UpdatedAt ?? row.CreatedAt))
        {
            <article>
                <div class="sentinel-db-feed-icon">@(Database.Icon ?? "◈")</div>
                <div>
                    <button type="button" @onclick="() => OnOpenRow.InvokeAsync(row.Id)">@Title(row)</button>
                    <time>@(row.UpdatedAt ?? row.CreatedAt).ToLocalTime().ToString("g")</time>
                    @foreach (var property in Database.Properties.Where(property => property.Type != WikiDatabasePropertyTypes.Title).Take(3))
                    {
                        var text = WikiPropertyValues.GetDisplayText(property, WikiPropertyValues.ParseObject(row.PropertyValuesJson), row.CreatedAt);
                        if (!string.IsNullOrWhiteSpace(text))
                        {
                            <span>@property.Name: @text</span>
                        }
                    }
                </div>
            </article>
        }
    </div>
}
else if (View.Type == WikiDatabaseViewTypes.Dashboard)
{
    var numericProperties = Database.Properties.Where(property => property.Type is WikiDatabasePropertyTypes.Number
        or WikiDatabasePropertyTypes.Formula or WikiDatabasePropertyTypes.Rollup).ToList();
    var checkedCount = Database.Properties.FirstOrDefault(property => property.Type == WikiDatabasePropertyTypes.Checkbox) is { } checkbox
        ? VisibleRows.Count(row => WikiPropertyValues.GetCheckbox(WikiPropertyValues.ParseObject(row.PropertyValuesJson), checkbox.Id))
        : 0;
    <div class="sentinel-db-dashboard">
        <article><span>Total entries</span><strong>@VisibleRows.Count</strong></article>
        <article><span>Updated this week</span><strong>@VisibleRows.Count(row => (row.UpdatedAt ?? row.CreatedAt) >= DateTimeOffset.UtcNow.AddDays(-7))</strong></article>
        <article><span>Completed</span><strong>@checkedCount</strong></article>
        @foreach (var property in numericProperties.Take(3))
        {
            var total = VisibleRows.Sum(row => property.Type == WikiDatabasePropertyTypes.Number
                ? WikiPropertyValues.GetNumber(WikiPropertyValues.ParseObject(row.PropertyValuesJson), property.Id) ?? 0
                : WikiPropertyValues.GetComputedValue(WikiPropertyValues.ParseObject(row.PropertyValuesJson), property.Id) is decimal computed ? computed : 0);
            <article><span>@property.Name total</span><strong>@total</strong></article>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public WikiDatabase Database { get; set; } = null!;
    [Parameter, EditorRequired] public WikiDatabaseView View { get; set; } = null!;
    [Parameter, EditorRequired] public WikiDatabaseViewConfig Config { get; set; } = WikiDatabaseViewConfig.Empty;
    [Parameter] public bool CanEdit { get; set; } = true;
    [Parameter] public EventCallback<Guid> OnOpenRow { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private readonly Dictionary<Guid, string> _formValues = [];
    private bool _saving;
    private string? _formMessage;
    private Guid? _savingDependencyRowId;
    private string? _timelineMessage;
    private bool _savingChartType;
    private ElementReference _timelineContainerRef;
    private ElementReference _mapContainerRef;
    private IJSObjectReference? _timelineDragModule;
    private IJSObjectReference? _mapModule;
    private DotNetObjectReference<SentinelDatabaseAdvancedView>? _selfRef;
    private string? _mapMarkersRenderedFor;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (View.Type == WikiDatabaseViewTypes.Timeline)
            {
                _timelineDragModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/wikiTimelineDrag.js");
                _selfRef ??= DotNetObjectReference.Create(this);
                await _timelineDragModule.InvokeVoidAsync("initialize", _timelineContainerRef, _selfRef);
            }
            else if (View.Type == WikiDatabaseViewTypes.Map)
            {
                var placeProperty = ResolveProperty(WikiDatabasePropertyTypes.Place);
                if (placeProperty is not null)
                {
                    var markers = VisibleRows
                        .Select(row => (Row: row, Place: WikiPropertyValues.GetText(WikiPropertyValues.ParseObject(row.PropertyValuesJson), placeProperty.Id)))
                        .Where(item => !string.IsNullOrWhiteSpace(item.Place))
                        .Select(item => new { id = item.Row.Id, title = Title(item.Row), place = item.Place })
                        .ToList();
                    var markersJson = System.Text.Json.JsonSerializer.Serialize(markers);
                    // Re-initializing re-geocodes every marker (no server-side coordinate cache -
                    // see wikiMapView.js), so only do it again when the marker set actually
                    // changed, not on every unrelated re-render this component goes through.
                    if (markersJson != _mapMarkersRenderedFor)
                    {
                        _mapModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/wikiMapView.js");
                        _selfRef ??= DotNetObjectReference.Create(this);
                        await _mapModule.InvokeVoidAsync("initialize", _mapContainerRef, _selfRef, markersJson);
                        _mapMarkersRenderedFor = markersJson;
                    }
                }
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit may already be gone by the time this fires.
        }
    }

    // Leaflet marker popups (wikiMapView.js) route back through here instead of a native
    // wikilink so opening a row from the map uses the exact same OnOpenRow callback every other
    // view (Table, Board, Feed, ...) already uses.
    [JSInvokable]
    public async Task OpenMapRowAsync(string rowId)
    {
        if (Guid.TryParse(rowId, out var parsedRowId))
        {
            await OnOpenRow.InvokeAsync(parsedRowId);
        }
    }

    // Drag-to-reschedule (Phase 5.1) - wikiTimelineDrag.js's pointer drag ends by calling this
    // with the row's new single Date value (see that file's own header comment for why this is
    // a move, not a start/end resize - the Timeline schedule has no end-date concept today).
    [JSInvokable]
    public async Task UpdateTimelineRowDateAsync(string rowId, string newDateIso)
    {
        if (!CanEdit || !Guid.TryParse(rowId, out var parsedRowId) || !DateTimeOffset.TryParse(newDateIso, out var newDate))
        {
            return;
        }

        var dateProperty = ResolveProperty(WikiDatabasePropertyTypes.Date);
        var row = Database.Rows.FirstOrDefault(item => item.Id == parsedRowId);
        if (dateProperty is null || row is null)
        {
            return;
        }

        _timelineMessage = null;
        try
        {
            var values = WikiPropertyValues.ParseObject(row.PropertyValuesJson);
            WikiPropertyValues.SetDate(values, dateProperty.Id, newDate);

            var username = await CurrentUserAccessor.GetCurrentUsernameAsync();
            await WikiDatabaseService.SaveRowAsync(Database.Id, new WikiDatabaseRowEditor
            {
                Id = row.Id,
                ParentRowId = row.ParentRowId,
                Values = values.ToDictionary(item => item.Key, item => item.Value)
            }, username);
            await OnChanged.InvokeAsync();
            StateHasChanged();
        }
        catch (Exception exception)
        {
            _timelineMessage = exception.Message;
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_timelineDragModule is not null)
        {
            try { await _timelineDragModule.DisposeAsync(); }
            catch (JSDisconnectedException) { /* circuit already gone */ }
        }
        if (_mapModule is not null)
        {
            try { await _mapModule.DisposeAsync(); }
            catch (JSDisconnectedException) { /* circuit already gone */ }
        }
        _selfRef?.Dispose();
    }

    private static IReadOnlyList<string> ChartPalette => WikiDatabaseViewLogic.ChartPalette;

    private string ChartType => Config.ChartType is WikiDatabaseChartTypes.Line or WikiDatabaseChartTypes.Donut
        ? Config.ChartType
        : WikiDatabaseChartTypes.Bar;

    private async Task SetChartTypeAsync(string chartType)
    {
        if (!CanEdit || _savingChartType)
        {
            return;
        }

        _savingChartType = true;
        try
        {
            var username = await CurrentUserAccessor.GetCurrentUsernameAsync();
            await WikiDatabaseService.SaveViewAsync(Database.Id, View.Id, View.Name, View.Type, Config with { ChartType = chartType }, username);
            await OnChanged.InvokeAsync();
        }
        finally
        {
            _savingChartType = false;
        }
    }

    private static string LinePoints(IReadOnlyList<WikiDatabaseChartBucket> buckets, int maximum) =>
        WikiDatabaseViewLogic.LinePoints(buckets, maximum);

    private static IReadOnlyList<WikiDatabaseDonutSegment> DonutSegments(IReadOnlyList<WikiDatabaseChartBucket> buckets) =>
        WikiDatabaseViewLogic.DonutSegments(buckets);

    private IReadOnlyList<WikiDatabaseRow> VisibleRows
    {
        get
        {
            var filtered = WikiDatabaseViewLogic.ApplyFilters(Database.Rows.ToList(), Database.Properties.ToList(), Config.Filters, Config.FilterGroup);
            return WikiDatabaseViewLogic.ApplySort(filtered, Database.Properties.ToList(), Config.Sorts);
        }
    }

    private WikiDatabaseProperty? ResolveProperty(string type) =>
        Database.Properties.FirstOrDefault(property => property.Type == type && property.Id.ToString() == Config.GroupByPropertyId)
        ?? Database.Properties.FirstOrDefault(property => property.Type == type);

    private WikiDatabaseProperty? ResolveChartProperty() =>
        Database.Properties.FirstOrDefault(property => property.Id.ToString() == Config.GroupByPropertyId)
        ?? Database.Properties.FirstOrDefault(property => property.Type is WikiDatabasePropertyTypes.Select
            or WikiDatabasePropertyTypes.MultiSelect or WikiDatabasePropertyTypes.Checkbox or WikiDatabasePropertyTypes.Text
            or WikiDatabasePropertyTypes.Formula or WikiDatabasePropertyTypes.Rollup);

    private WikiDatabaseProperty? ResolveTimelineDependencyProperty()
    {
        if (!Guid.TryParse(Config.DependencyPropertyId, out var propertyId))
        {
            return null;
        }

        var property = Database.Properties.FirstOrDefault(candidate =>
            candidate.Id == propertyId && candidate.Type == WikiDatabasePropertyTypes.Relation);
        return property is not null
            && WikiDatabasePropertyConfig.Parse(property).RelatedDatabaseId == Database.Id
                ? property
                : null;
    }

    private string Title(WikiDatabaseRow row)
    {
        var property = Database.Properties.First(item => item.Type == WikiDatabasePropertyTypes.Title);
        return WikiPropertyValues.GetText(WikiPropertyValues.ParseObject(row.PropertyValuesJson), property.Id) ?? "Untitled";
    }

    private string DependencyTitle(Guid rowId) =>
        Database.Rows.FirstOrDefault(row => row.Id == rowId) is { } row ? Title(row) : "Unavailable row";

    private string DependencySummary(WikiDatabaseTimelineItem item) => item.DependsOnRowIds.Count switch
    {
        0 => "No dependencies",
        1 => $"Depends on {DependencyTitle(item.DependsOnRowIds[0])}",
        _ => $"{item.DependsOnRowIds.Count} dependencies"
    };

    private static string TimelineBarStyle(
        WikiDatabaseTimelineItem item,
        WikiDatabaseTimelineSchedule schedule)
    {
        if (item.Date is not { } date || schedule.StartDate is not { } start || schedule.EndDate is not { } end)
        {
            return "--timeline-left:0%;--timeline-width:100%;";
        }

        var totalDays = Math.Max(1, end.DayNumber - start.DayNumber + 1);
        var left = (date.DayNumber - start.DayNumber) * 100d / totalDays;
        var width = Math.Max(3d, 100d / totalDays);
        return FormattableString.Invariant($"--timeline-left:{left:0.###}%;--timeline-width:{width:0.###}%;");
    }

    private async Task ToggleTimelineDependencyAsync(
        WikiDatabaseRow row,
        WikiDatabaseProperty dependencyProperty,
        Guid dependencyRowId,
        bool selected)
    {
        if (!CanEdit)
        {
            return;
        }

        _savingDependencyRowId = row.Id;
        _timelineMessage = null;
        try
        {
            var values = WikiPropertyValues.ParseObject(row.PropertyValuesJson);
            var dependencies = WikiPropertyValues.GetMultiSelect(values, dependencyProperty.Id)
                .Where(value => Guid.TryParse(value, out _))
                .ToHashSet(StringComparer.Ordinal);
            if (selected)
            {
                dependencies.Add(dependencyRowId.ToString());
            }
            else
            {
                dependencies.Remove(dependencyRowId.ToString());
            }
            WikiPropertyValues.SetMultiSelect(values, dependencyProperty.Id, dependencies.ToList());

            var username = await CurrentUserAccessor.GetCurrentUsernameAsync();
            await WikiDatabaseService.SaveRowAsync(Database.Id, new WikiDatabaseRowEditor
            {
                Id = row.Id,
                ParentRowId = row.ParentRowId,
                Values = values.ToDictionary(item => item.Key, item => item.Value)
            }, username);
            await OnChanged.InvokeAsync();
        }
        catch (Exception exception)
        {
            _timelineMessage = exception.Message;
        }
        finally
        {
            _savingDependencyRowId = null;
        }
    }

    private string FormValue(Guid propertyId) => _formValues.GetValueOrDefault(propertyId, string.Empty);
    private bool FormBool(Guid propertyId) => string.Equals(FormValue(propertyId), "true", StringComparison.OrdinalIgnoreCase);
    private void SetFormCheckbox(Guid propertyId, object? value) => _formValues[propertyId] = value is true ? "true" : "false";

    private async Task SubmitFormAsync()
    {
        _saving = true;
        _formMessage = null;
        try
        {
            var values = new JsonObject();
            foreach (var property in Database.Properties)
            {
                var value = FormValue(property.Id);
                switch (property.Type)
                {
                    case WikiDatabasePropertyTypes.Number:
                        WikiPropertyValues.SetNumber(values, property.Id, decimal.TryParse(value, out var number) ? number : null);
                        break;
                    case WikiDatabasePropertyTypes.Checkbox:
                        WikiPropertyValues.SetCheckbox(values, property.Id, string.Equals(value, "true", StringComparison.OrdinalIgnoreCase));
                        break;
                    case WikiDatabasePropertyTypes.Date:
                        WikiPropertyValues.SetDate(values, property.Id, DateTimeOffset.TryParse(value, out var date) ? date : null);
                        break;
                    case WikiDatabasePropertyTypes.MultiSelect:
                    case WikiDatabasePropertyTypes.Person:
                    case WikiDatabasePropertyTypes.Files:
                    case WikiDatabasePropertyTypes.Relation:
                        WikiPropertyValues.SetMultiSelect(values, property.Id, value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries));
                        break;
                    case WikiDatabasePropertyTypes.CreatedTime:
                    case WikiDatabasePropertyTypes.Formula:
                    case WikiDatabasePropertyTypes.Rollup:
                        break;
                    default:
                        WikiPropertyValues.SetText(values, property.Id, value);
                        break;
                }
            }

            var username = await CurrentUserAccessor.GetCurrentUsernameAsync();
            await WikiDatabaseService.SaveRowAsync(Database.Id,
                new WikiDatabaseRowEditor { Values = values.ToDictionary(item => item.Key, item => item.Value) }, username);
            _formValues.Clear();
            _formMessage = "Entry submitted.";
            await OnChanged.InvokeAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private static string OpenStreetMapUrl(string place) =>
        $"https://www.openstreetmap.org/search?query={Uri.EscapeDataString(place)}";
}
