@page "/admin/settings"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "AdminOnly")]
@using Microsoft.AspNetCore.Authorization
@using GwsBusinessSuite.Application.CmsBuilder
@using GwsBusinessSuite.Application.ContentStudio
@using GwsBusinessSuite.Application.DeveloperApi
@using GwsBusinessSuite.Application.SemanticSearch
@using GwsBusinessSuite.Application.Settings
@using GwsBusinessSuite.Domain.Entities
@using GwsBusinessSuite.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@inject ISiteSettingsService SiteSettingsService
@inject ICmsBuilderService CmsBuilderService
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IOptions<ContentStudioOptions> StudioOptions
@inject IOptions<SemanticSearchOptions> SemanticOptions
@inject IHybridSearchService HybridSearchService
@inject IConfiguration Configuration
@inject ILogger<Settings> Logger
@inject IDeveloperApiKeyService DeveloperApiKeyService
@inject ICurrentUserAccessor CurrentUserAccessor
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Settings</PageTitle>

<div class="page-header">
    <h1><i class="bi bi-gear-fill me-2 text-primary"></i>Settings</h1>
    <p>Site-wide configuration for reading, writing, media, and SentinelGPT generation defaults.</p>
</div>

@if (!string.IsNullOrWhiteSpace(StatusMessage))
{
    <div class="alert alert-success gws-settings-notice" role="status" aria-live="polite">
        <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>@StatusMessage
    </div>
}
@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@ErrorMessage</div>
}

@if (!_loaded)
{
    <div class="d-flex align-items-center gap-2 text-secondary">
        <span class="spinner-border spinner-border-sm"></span>
        <span>Loading settings…</span>
    </div>
}
else
{
    <div class="gws-settings-layout">
        <nav class="gws-settings-nav" aria-label="Settings categories">
            @foreach (var tab in Tabs)
            {
                <button type="button" class="gws-settings-nav-item @(ActiveTab == tab.Key ? "active" : string.Empty)"
                        aria-label="@tab.Key" aria-current="@(ActiveTab == tab.Key ? "page" : null)" @onclick="() => SelectTab(tab.Key)">
                    <i class="bi @tab.Icon" aria-hidden="true"></i>
                    <span><strong>@tab.Key</strong><small>@tab.Description</small></span>
                    <i class="bi bi-chevron-right ms-auto" aria-hidden="true"></i>
                </button>
            }
        </nav>

        <section class="gws-settings-content" aria-label="@ActiveTab settings">

    @if (ActiveTab == "General")
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label small text-secondary">Site name</label>
                    <input class="form-control" @bind="SiteNameInput" />
                </div>
                <div class="mb-3">
                    <label class="form-label small text-secondary">Site slug</label>
                    <input class="form-control" @bind="SiteSlugInput" />
                    <div class="form-text">Changing this affects any URLs or references built from the site slug.</div>
                </div>
                <div class="gws-settings-actions"><span>Changes affect the public site immediately.</span><button class="btn btn-primary" @onclick="SaveGeneralAsync" disabled="@IsBusy">@(IsBusy ? "Saving…" : "Save changes")</button></div>
            </div>
        </div>
    }
    else if (ActiveTab == "Reading")
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label small text-secondary">Blog posts per page</label>
                    <select class="form-select" @bind="PostsPerPageInput">
                        <option value="10">10</option>
                        <option value="12">12</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                    </select>
                    <div class="form-text">Applies to the public /blog listing.</div>
                </div>
                <div class="gws-settings-actions"><span>Controls the public blog listing.</span><button class="btn btn-primary" @onclick="SaveReadingAsync" disabled="@IsBusy">@(IsBusy ? "Saving…" : "Save changes")</button></div>
            </div>
        </div>
    }
    else if (ActiveTab == "Writing")
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label small text-secondary">Default category for new posts</label>
                    <select class="form-select" @bind="DefaultCategoryIdInput">
                        <option value="">None</option>
                        @foreach (var category in Categories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label small text-secondary">Default author byline</label>
                    <input class="form-control" @bind="DefaultAuthorBylineInput" placeholder="e.g. Grant Watson" />
                    <div class="form-text">Leave blank to have new posts default to whatever the editor currently uses.</div>
                </div>
                <div class="gws-settings-actions"><span>Used as defaults for new posts.</span><button class="btn btn-primary" @onclick="SaveWritingAsync" disabled="@IsBusy">@(IsBusy ? "Saving…" : "Save changes")</button></div>
            </div>
        </div>
    }
    else if (ActiveTab == "Media")
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label small text-secondary">Max upload size (MB)</label>
                    <input class="form-control" type="number" min="1" max="100" @bind="MaxUploadSizeMbInput" />
                    <div class="form-text">Applies to hero images and the media library.</div>
                </div>
                <div class="gws-settings-actions"><span>Applies to future uploads.</span><button class="btn btn-primary" @onclick="SaveMediaAsync" disabled="@IsBusy">@(IsBusy ? "Saving…" : "Save changes")</button></div>
            </div>
        </div>
    }
    else if (ActiveTab == "SentinelGPT")
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label small text-secondary">Model override</label>
                    <input class="form-control" @bind="OllamaModelOverrideInput" placeholder="@StudioOptions.Value.Model" />
                    <div class="form-text">Leave blank to use the server default (<code>@StudioOptions.Value.Model</code>).</div>
                </div>
                <div class="mb-3">
                    <label class="form-label small text-secondary">Generation timeout override (minutes)</label>
                    <input class="form-control" type="number" min="1" max="180" @bind="OllamaTimeoutOverrideInput" placeholder="@StudioOptions.Value.GenerationTimeoutMinutes" />
                    <div class="form-text">Leave blank to use the server default (@StudioOptions.Value.GenerationTimeoutMinutes minutes).</div>
                </div>
                <div class="form-text mb-3">The SentinelGPT local-model endpoint (@StudioOptions.Value.BaseUrl) is a deployment setting and isn't editable here.</div>
                <div class="mb-3">
                    <label class="form-label small text-secondary">Hero image model</label>
                    <input class="form-control" @bind="HeroImageModelOverrideInput" placeholder="e.g. x/z-image-turbo" />
                    <div class="form-text">
                        Model used by Content Studio's "Generate with SentinelGPT" hero image button. Must be an
                        installed model with image-generation capability. Local image generation is
                        <strong>experimental and currently macOS-only</strong>, so this may
                        not work against a Linux-hosted local model service. Leave blank to disable the button.
                    </div>
                </div>
                <div class="border rounded-3 p-3 mb-3 bg-body-tertiary">
                    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                        <div>
                            <div class="fw-semibold"><i class="bi bi-diagram-3 me-1 text-primary"></i>Semantic knowledge index</div>
                            <div class="small text-secondary mt-1">
                                @if (SemanticIndexStatus is null)
                                {
                                    <span>Status unavailable.</span>
                                }
                                else
                                {
                                    <span>@SemanticIndexStatus.DocumentCount documents · model <code>@SemanticIndexStatus.Model</code></span>
                                    @if (SemanticIndexStatus.LastIndexedAt is { } indexedAt)
                                    {
                                        <span> · updated @indexedAt.ToLocalTime().ToString("g")</span>
                                    }
                                }
                            </div>
                            <div class="form-text">Meaning-based matches augment keyword search across Sentinel, CRM, and CMS content. Install <code>@SemanticOptions.Value.Model</code> in SentinelGPT model management before rebuilding.</div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="RebuildSemanticIndexAsync" disabled="@IsBusy">
                            <i class="bi bi-arrow-repeat me-1"></i>Rebuild index
                        </button>
                    </div>
                </div>
                <div class="gws-settings-actions"><span>Overrides deployment defaults for this site.</span><button class="btn btn-primary" @onclick="SaveAiAsync" disabled="@IsBusy">@(IsBusy ? "Saving…" : "Save changes")</button></div>
            </div>
        </div>
    }
    else if (ActiveTab == "Developer API")
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom">
                <h2 class="h5 mb-1">Issue an API key</h2>
                <p class="small text-secondary mb-0">The full key is shown once. Store it in your integration's secret manager.</p>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(NewPlaintextApiKey))
                {
                    <div class="alert alert-warning" role="alert">
                        <strong>Copy this key now. It cannot be shown again.</strong>
                        <div class="input-group mt-2">
                            <input id="new-developer-api-key" class="form-control font-monospace" readonly value="@NewPlaintextApiKey" />
                            <button class="btn btn-outline-dark" type="button" @onclick="CopyApiKeyAsync"><i class="bi bi-copy me-1"></i>Copy</button>
                        </div>
                    </div>
                }
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small text-secondary">Key name</label>
                        <input class="form-control" maxlength="100" @bind="NewApiKeyName" placeholder="e.g. Reporting integration" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small text-secondary">Requests per minute</label>
                        <input class="form-control" type="number" min="1" max="600" @bind="NewApiRateLimit" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small text-secondary">Expires</label>
                        <select class="form-select" @bind="NewApiExpiryDays">
                            <option value="30">30 days</option>
                            <option value="90">90 days</option>
                            <option value="365">1 year</option>
                            <option value="0">Never</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label small text-secondary d-block">Scopes</label>
                        <div class="row g-2">
                            @foreach (var scope in DeveloperApiScopes.All)
                            {
                                <div class="col-sm-6 col-xl-4">
                                    <label class="form-check border rounded p-2 ps-5 w-100">
                                        <input class="form-check-input" type="checkbox" checked="@SelectedApiScopes.Contains(scope)"
                                               @onchange="args => ToggleApiScope(scope, args.Value as bool? == true)" />
                                        <span class="form-check-label font-monospace small">@scope</span>
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="gws-settings-actions mt-3">
                    <span>Grant only the scopes this integration needs.</span>
                    <button class="btn btn-primary" @onclick="IssueApiKeyAsync" disabled="@(IsBusy || string.IsNullOrWhiteSpace(NewApiKeyName) || SelectedApiScopes.Count == 0)">
                        @(IsBusy ? "Issuing…" : "Issue key")
                    </button>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom"><h2 class="h5 mb-0">Issued keys</h2></div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th>Name</th><th>Prefix</th><th>Scopes</th><th>Usage</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @if (ApiKeys.Count == 0)
                        {
                            <tr><td colspan="6" class="text-center text-secondary py-4">No developer API keys have been issued.</td></tr>
                        }
                        @foreach (var key in ApiKeys)
                        {
                            <tr>
                                <td><strong>@key.Name</strong><div class="small text-secondary">Created @key.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</div></td>
                                <td><code>@key.KeyPrefix…</code></td>
                                <td><div class="d-flex flex-wrap gap-1">@foreach (var scope in key.Scopes) { <span class="badge text-bg-light border">@scope</span> }</div></td>
                                <td><span>@key.RequestCount.ToString("N0") requests</span><div class="small text-secondary">@(key.LastUsedAt?.ToLocalTime().ToString("MMM d, h:mm tt") ?? "Never used") · @key.RateLimitPerMinute/min</div></td>
                                <td>
                                    @if (key.RevokedAt is not null) { <span class="badge text-bg-secondary">Revoked</span> }
                                    else if (key.ExpiresAt <= DateTimeOffset.UtcNow) { <span class="badge text-bg-warning">Expired</span> }
                                    else { <span class="badge text-bg-success">Active</span> }
                                </td>
                                <td class="text-end">
                                    @if (key.RevokedAt is null)
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => RevokeApiKeyAsync(key)" disabled="@IsBusy">Revoke</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom"><h2 class="h5 mb-0">API reference</h2></div>
            <div class="card-body">
                <p>Send the key as <code>Authorization: Bearer YOUR_KEY</code>. Responses use JSON and validation failures use Problem Details.</p>
                <div class="table-responsive mb-3">
                    <table class="table table-sm">
                        <thead><tr><th>Resource</th><th>Read</th><th>Write</th></tr></thead>
                        <tbody>
                            <tr><td>Contacts</td><td><code>GET /api/v1/contacts</code></td><td><code>POST /api/v1/contacts</code>, <code>PUT /api/v1/contacts/&#123;id&#125;</code></td></tr>
                            <tr><td>Deals</td><td><code>GET /api/v1/deals</code></td><td><code>POST /api/v1/deals</code>, <code>PUT /api/v1/deals/&#123;id&#125;</code></td></tr>
                            <tr><td>CMS pages</td><td><code>GET /api/v1/cms-pages</code></td><td><code>POST /api/v1/cms-pages</code>, <code>PUT /api/v1/cms-pages/&#123;id&#125;</code></td></tr>
                        </tbody>
                    </table>
                </div>
                <pre class="bg-dark text-light rounded p-3 mb-0"><code>curl "@($"{Navigation.BaseUri.TrimEnd('/')}/api/v1/contacts?page=1&pageSize=50")" \
  -H "Authorization: Bearer YOUR_KEY"</code></pre>
            </div>
        </div>
    }
        </section>
    </div>
}

@code {
    private static readonly SettingsTab[] Tabs =
    [
        new("General", "bi-sliders", "Site identity and URLs"),
        new("Reading", "bi-book", "Public blog display"),
        new("Writing", "bi-pencil", "Post defaults"),
        new("Media", "bi-image", "Upload limits"),
        new("SentinelGPT", "bi-stars", "Models and generation"),
        new("Developer API", "bi-braces-asterisk", "Keys, scopes, and docs")
    ];
    private string ActiveTab { get; set; } = "General";

    private bool _loaded;
    private bool IsBusy { get; set; }
    private string StatusMessage { get; set; } = string.Empty;
    private string ErrorMessage { get; set; } = string.Empty;

    private CmsSite? CurrentSite { get; set; }
    private string SiteNameInput { get; set; } = string.Empty;
    private string SiteSlugInput { get; set; } = string.Empty;

    private int PostsPerPageInput { get; set; } = 12;
    private string DefaultCategoryIdInput { get; set; } = string.Empty;
    private string DefaultAuthorBylineInput { get; set; } = string.Empty;
    private int MaxUploadSizeMbInput { get; set; } = 8;
    private string OllamaModelOverrideInput { get; set; } = string.Empty;
    private int? OllamaTimeoutOverrideInput { get; set; }
    private string HeroImageModelOverrideInput { get; set; } = string.Empty;
    private SemanticIndexStatus? SemanticIndexStatus { get; set; }
    private List<DeveloperApiKeyView> ApiKeys { get; set; } = [];
    private HashSet<string> SelectedApiScopes { get; } = [DeveloperApiScopes.ContactsRead];
    private string NewApiKeyName { get; set; } = string.Empty;
    private int NewApiRateLimit { get; set; } = 60;
    private int NewApiExpiryDays { get; set; } = 90;
    private string NewPlaintextApiKey { get; set; } = string.Empty;

    private List<ArticleCategory> Categories { get; set; } = new();

    private void SelectTab(string tab)
    {
        ActiveTab = tab;
        StatusMessage = string.Empty;
        ErrorMessage = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        var slug = Configuration["Canvas:SiteSlug"] ?? "grantwatson-dev";
        CurrentSite = await CmsBuilderService.GetSiteBySlugAsync(slug);
        if (CurrentSite is not null)
        {
            SiteNameInput = CurrentSite.Name;
            SiteSlugInput = CurrentSite.Slug;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        Categories = await db.ArticleCategories.OrderBy(c => c.Name).ToListAsync();

        var settings = await SiteSettingsService.GetSettingsAsync();
        PostsPerPageInput = settings.PostsPerPage;
        DefaultCategoryIdInput = settings.DefaultArticleCategoryId?.ToString() ?? string.Empty;
        DefaultAuthorBylineInput = settings.DefaultAuthorByline ?? string.Empty;
        MaxUploadSizeMbInput = settings.MaxMediaUploadSizeMb;
        OllamaModelOverrideInput = settings.OllamaModelOverride ?? string.Empty;
        OllamaTimeoutOverrideInput = settings.OllamaTimeoutMinutesOverride;
        HeroImageModelOverrideInput = settings.HeroImageModelOverride ?? string.Empty;
        SemanticIndexStatus = await HybridSearchService.GetStatusAsync();
        ApiKeys = (await DeveloperApiKeyService.ListAsync()).ToList();

        _loaded = true;
    }

    private async Task<SiteSettingsView> GetCurrentSettingsAsync() => await SiteSettingsService.GetSettingsAsync();

    private async Task SaveGeneralAsync()
    {
        if (CurrentSite is null) return;

        await RunSaveAsync(async () =>
        {
            var saved = await CmsBuilderService.SaveSiteAsync(new CmsSiteEditorModel
            {
                SiteId = CurrentSite.Id,
                Name = SiteNameInput,
                Slug = SiteSlugInput,
                Theme = CurrentSite.Theme,
                CustomCss = CurrentSite.CustomCss,
                NavMenuJson = CurrentSite.NavMenuJson,
                FooterNavMenuJson = CurrentSite.FooterNavMenuJson,
                AccentColorHex = CurrentSite.AccentColorHex,
                FontPairingKey = CurrentSite.FontPairingKey,
                LogoUrl = CurrentSite.LogoUrl,
                FaviconUrl = CurrentSite.FaviconUrl
            });
            CurrentSite = saved;
        });
    }

    private async Task SaveReadingAsync()
    {
        await RunSaveAsync(async () =>
        {
            var current = await GetCurrentSettingsAsync();
            await SiteSettingsService.SaveSettingsAsync(current with { PostsPerPage = PostsPerPageInput });
        });
    }

    private async Task SaveWritingAsync()
    {
        await RunSaveAsync(async () =>
        {
            var current = await GetCurrentSettingsAsync();
            var categoryId = Guid.TryParse(DefaultCategoryIdInput, out var parsed) ? parsed : (Guid?)null;
            await SiteSettingsService.SaveSettingsAsync(current with
            {
                DefaultArticleCategoryId = categoryId,
                DefaultAuthorByline = DefaultAuthorBylineInput
            });
        });
    }

    private async Task SaveMediaAsync()
    {
        await RunSaveAsync(async () =>
        {
            var current = await GetCurrentSettingsAsync();
            await SiteSettingsService.SaveSettingsAsync(current with { MaxMediaUploadSizeMb = MaxUploadSizeMbInput });
        });
    }

    private async Task SaveAiAsync()
    {
        await RunSaveAsync(async () =>
        {
            var current = await GetCurrentSettingsAsync();
            await SiteSettingsService.SaveSettingsAsync(current with
            {
                OllamaModelOverride = OllamaModelOverrideInput,
                OllamaTimeoutMinutesOverride = OllamaTimeoutOverrideInput,
                HeroImageModelOverride = HeroImageModelOverrideInput
            });
        });
    }

    private async Task RebuildSemanticIndexAsync()
    {
        await RunSaveAsync(async () =>
        {
            await HybridSearchService.RebuildAsync();
            SemanticIndexStatus = await HybridSearchService.GetStatusAsync();
        }, "Semantic knowledge index rebuilt.");
    }

    private void ToggleApiScope(string scope, bool selected)
    {
        if (selected) SelectedApiScopes.Add(scope);
        else SelectedApiScopes.Remove(scope);
    }

    private async Task IssueApiKeyAsync()
    {
        await RunSaveAsync(async () =>
        {
            var performedBy = await CurrentUserAccessor.GetCurrentUsernameAsync();
            DateTimeOffset? expiresAt = NewApiExpiryDays == 0 ? null : DateTimeOffset.UtcNow.AddDays(NewApiExpiryDays);
            var issued = await DeveloperApiKeyService.IssueAsync(
                NewApiKeyName, SelectedApiScopes, NewApiRateLimit, expiresAt, performedBy);
            NewPlaintextApiKey = issued.PlaintextKey;
            NewApiKeyName = string.Empty;
            ApiKeys = (await DeveloperApiKeyService.ListAsync()).ToList();
        }, "API key issued. Copy it now; the plaintext is not stored.");
    }

    private async Task RevokeApiKeyAsync(DeveloperApiKeyView key)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Revoke API key '{key.Name}'? Calls using it will stop immediately.")) return;
        await RunSaveAsync(async () =>
        {
            var performedBy = await CurrentUserAccessor.GetCurrentUsernameAsync();
            await DeveloperApiKeyService.RevokeAsync(key.Id, performedBy);
            ApiKeys = (await DeveloperApiKeyService.ListAsync()).ToList();
        }, "API key revoked.");
    }

    private async Task CopyApiKeyAsync()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", NewPlaintextApiKey);
        StatusMessage = "API key copied to clipboard.";
    }

    private async Task RunSaveAsync(Func<Task> save, string successMessage = "Settings saved.")
    {
        IsBusy = true;
        StatusMessage = string.Empty;
        ErrorMessage = string.Empty;
        try
        {
            await save();
            StatusMessage = successMessage;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save site settings.");
            ErrorMessage = $"Unable to save settings. {ex.Message}";
        }
        finally
        {
            IsBusy = false;
        }
    }

    private sealed record SettingsTab(string Key, string Icon, string Description);
}
