@using GwsBusinessSuite.Application.Abstractions
@using GwsBusinessSuite.Application.Support
@inject ISupportEmailInService EmailIn
@inject ICurrentUserAccessor CurrentUserAccessor
@inject ILogger<SupportEmailInPanel> Logger

@* Email-to-ticket settings and log (Support page; the page itself is admin-only). *@
<div class="card border-0 shadow-sm mb-4" aria-label="Email to ticket">
    <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
        <span class="fw-semibold"><i class="bi bi-envelope-arrow-down me-1" aria-hidden="true"></i>Email-to-ticket</span>
        <button type="button" class="btn-close" aria-label="Close" @onclick="() => OnClose.InvokeAsync()"></button>
    </div>
    <div class="card-body">
    <p class="small text-secondary mb-2">
        Support checks this mailbox every two minutes. A new email becomes a ticket (the sender is matched to a
        contact, or added as one). Ticket emails carry a <code>[Ticket #…]</code> tag and ask clients to reply to this
        address, so their answers join the same ticket. Out-of-office replies, bounces and mailing lists are ignored.
        A sender their mail server can't confirm still gets a ticket, tagged <code>unverified-sender</code>, but can't
        add to an existing one and gets no automatic receipt.
    </p>

    @if (_loading)
    {
        <p class="small text-secondary">Loading...</p>
    }
    else
    {
        <div class="form-check form-switch mb-2">
            <input class="form-check-input" type="checkbox" id="support-email-enabled" @bind="_enabled" />
            <label class="form-check-label small" for="support-email-enabled">Check the mailbox for new mail</label>
        </div>
        <div class="row g-2 mb-2">
            <div class="col-8">
                <label class="form-label small mb-1" for="support-email-host">IMAP server</label>
                <input id="support-email-host" class="form-control form-control-sm" @bind="_host" @bind:event="oninput" />
            </div>
            <div class="col-4">
                <label class="form-label small mb-1" for="support-email-port">Port</label>
                <input id="support-email-port" type="number" class="form-control form-control-sm" @bind="_port" @bind:event="oninput" />
            </div>
        </div>
        <label class="form-label small mb-1" for="support-email-user">Mailbox address</label>
        <input id="support-email-user" class="form-control form-control-sm mb-2" placeholder="support@gwsapp.net" @bind="_username" @bind:event="oninput" />
        <label class="form-label small mb-1" for="support-email-password">App password</label>
        <input id="support-email-password" type="password" class="form-control form-control-sm mb-1" autocomplete="new-password"
               placeholder="@(_hasPassword ? "Saved - leave empty to keep it" : "16-character app password")" @bind="_password" @bind:event="oninput" />
        <div class="form-text mb-2">For Google Workspace: turn on 2-Step Verification for the mailbox, then create an app password in its Google Account.</div>
        <div class="row g-2 mb-2">
            <div class="col-6">
                <label class="form-label small mb-1" for="support-email-folder">Folder</label>
                <input id="support-email-folder" class="form-control form-control-sm" @bind="_folder" @bind:event="oninput" />
            </div>
            <div class="col-6">
                <label class="form-label small mb-1" for="support-email-authserv">Trusted receiving server</label>
                <input id="support-email-authserv" class="form-control form-control-sm" @bind="_authServId" @bind:event="oninput" />
            </div>
        </div>
        <div class="d-flex gap-2 mb-2">
            <button type="button" class="btn btn-sm btn-primary" disabled="@_busy" @onclick="SaveAsync">Save</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(_busy || !_hasPassword)" @onclick="TestAsync">Test connection</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(_busy || !_enabled || !_hasPassword)" @onclick="CheckNowAsync">Check now</button>
        </div>
        @if (_message is not null)
        {
            <div class="alert @(_messageIsError ? "alert-danger" : "alert-success") small py-2" role="status">@_message</div>
        }
        @if (_settings is { } settings)
        {
            <p class="small text-secondary mb-2">
                Last checked: @(settings.LastPollUnix is { } polled ? Format(polled) : "never")
                @if (settings.LastError is { } lastError)
                {
                    <br /><span class="text-danger">Last error: @lastError</span>
                }
            </p>
        }

        <div class="fw-semibold small mb-1">Recent messages</div>
        @if (_recent.Count == 0)
        {
            <p class="small text-secondary mb-0">Nothing received yet.</p>
        }
        else
        {
            <ul class="list-unstyled mb-0 small">
                @foreach (var item in _recent)
                {
                    <li class="py-1 border-bottom">
                        <span class="badge @(item.Status is SupportEmailIn.Statuses.Created or SupportEmailIn.Statuses.Replied ? "text-bg-success" : item.Status == SupportEmailIn.Statuses.Failed ? "text-bg-danger" : "text-bg-secondary")">@item.Status</span>
                        @if (item.TicketId is { } ticketId)
                        {
                            <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="() => OnOpenTicket.InvokeAsync(ticketId)">@(string.IsNullOrWhiteSpace(item.Subject) ? "(no subject)" : item.Subject)</button>
                        }
                        else
                        {
                            <span>@(string.IsNullOrWhiteSpace(item.Subject) ? "(no subject)" : item.Subject)</span>
                        }
                        <div class="text-secondary">@item.FromAddress · @Format(item.ProcessedAtUnix)</div>
                        @if (item.Reason is { } reason)
                        {
                            <div class="text-secondary">@reason</div>
                        }
                    </li>
                }
            </ul>
        }
    }
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<Guid> OnOpenTicket { get; set; }
    // Raised after Check now handled mail, so the ticket list can refresh.
    [Parameter] public EventCallback OnTicketsChanged { get; set; }

    private SupportMailboxView? _settings;
    private IReadOnlyList<SupportInboundEmailView> _recent = [];
    private bool _loading = true;
    private bool _busy;
    private bool _enabled;
    private string _host = string.Empty;
    private int _port = 993;
    private string _username = string.Empty;
    private string _password = string.Empty;
    private string _folder = "INBOX";
    private string _authServId = "mx.google.com";
    private bool _hasPassword;
    private string? _message;
    private bool _messageIsError;

    protected override async Task OnInitializedAsync()
    {
        Apply(await EmailIn.GetSettingsAsync());
        _recent = await EmailIn.ListRecentAsync(25);
        _loading = false;
    }

    private void Apply(SupportMailboxView settings)
    {
        _settings = settings;
        _enabled = settings.Enabled;
        _host = settings.Host;
        _port = settings.Port;
        _username = settings.Username;
        _folder = settings.Folder;
        _authServId = settings.AuthServId;
        _hasPassword = settings.HasPassword;
        _password = string.Empty;
    }

    private async Task SaveAsync() => await RunAsync(async username =>
    {
        Apply(await EmailIn.SaveSettingsAsync(
            new SupportMailboxUpdate(_enabled, _host, _port, _username, string.IsNullOrEmpty(_password) ? null : _password, _folder, _authServId),
            username));
        return "Saved.";
    });

    private async Task TestAsync() => await RunAsync(username => EmailIn.TestConnectionAsync(username));

    private async Task CheckNowAsync() => await RunAsync(async _ =>
    {
        var handled = await EmailIn.PollAsync();
        _settings = await EmailIn.GetSettingsAsync();
        _recent = await EmailIn.ListRecentAsync(25);
        if (handled > 0) await OnTicketsChanged.InvokeAsync();
        return _settings.LastError is { } error ? throw new SupportEmailInException($"Couldn't check the mailbox: {error}")
            : handled == 0 ? "No new mail." : $"Handled {handled} message(s).";
    });

    private async Task RunAsync(Func<string, Task<string>> action)
    {
        _busy = true;
        _message = null;
        try
        {
            _message = await action(await CurrentUserAccessor.GetCurrentUsernameAsync());
            _messageIsError = false;
        }
        catch (SupportEmailInException ex)
        {
            _message = ex.Message;
            _messageIsError = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Email-to-ticket settings action failed");
            _message = "That didn't work - see the server log.";
            _messageIsError = true;
        }
        finally { _busy = false; }
    }

    private static string Format(long unix) => DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToGwsDateTime();
}
