@page "/admin/mail"
@* Not prerendered: a prerender would read the mailbox once more for nothing. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IAsyncDisposable
@* Everyone signed in to the admin has their own Mail (only ever their own mailbox). *@
@attribute [Authorize(Policy = "ContentAccess")]
@using Microsoft.AspNetCore.Authorization
@using GwsBusinessSuite.Application.Automation
@using GwsBusinessSuite.Application.Mail
@using GwsBusinessSuite.Application.Operations
@inject IMailService MailService
@inject IGoogleOAuthService GoogleOAuth
@inject ICurrentUserAccessor CurrentUserAccessor
@inject IJSRuntime JS
@inject GwsBusinessSuite.Infrastructure.Services.MailUnreadCounter MailUnread

@* Mail (31-10-26): your own mailbox - Gmail through your Google connection, or any provider over
   IMAP/SMTP - read live from it. Messages are sanitized on the server and shown in a sandboxed
   frame; remote images wait for "Show images". *@

<PageTitle>Mail</PageTitle>

<PageHeader Title="Mail" Icon="bi-envelope" Description="@(_account is null ? "Connect your mailbox to read and answer your email here." : _account.Address)">
    <Actions>
        @if (_account is not null)
        {
            <button type="button" class="btn btn-primary btn-sm mail-header-compose" @onclick="() => StartCompose(ComposeKind.New)"><i class="bi bi-pencil-square me-1" aria-hidden="true"></i>Compose</button>
        }
    </Actions>
</PageHeader>

@if (_error is not null)
{
    <div class="alert alert-danger d-flex align-items-start gap-2" role="alert">
        <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i><div class="flex-grow-1">@_error</div>
        <button type="button" class="btn-close" aria-label="Dismiss" @onclick="() => _error = null"></button>
    </div>
}
@if (_warning is not null)
{
    <div class="alert alert-warning d-flex align-items-start gap-2" role="status">
        <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i><div class="flex-grow-1">@_warning</div>
        <button type="button" class="btn-close" aria-label="Dismiss" @onclick="() => _warning = null"></button>
    </div>
}
@if (_status is not null)
{
    <div class="alert alert-success d-flex align-items-start gap-2" role="status">
        <i class="bi bi-check-circle-fill" aria-hidden="true"></i><div class="flex-grow-1">@_status</div>
        <button type="button" class="btn-close" aria-label="Dismiss" @onclick="() => _status = null"></button>
    </div>
}

@if (!_loaded)
{
    <LoadingIndicator Message="Opening Mail…" />
}
else if (_account is null || _changingAccount)
{
    <div class="mail-setup">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h2 class="h6"><i class="bi bi-google me-1" aria-hidden="true"></i>Gmail or Google Workspace</h2>
                <p class="small text-secondary">Sign in with Google and allow Gmail. Nothing is copied into the app: mail is read from Gmail when you open it.</p>
                @if (GoogleOAuth.IsConfigured)
                {
                    <a class="btn btn-primary btn-sm" href="/auth/google/connect?purpose=mail" data-enhance-nav="false"><i class="bi bi-google me-1" aria-hidden="true"></i>Connect Gmail</a>
                }
                else
                {
                    <div class="alert alert-warning small mb-0">
                        Google sign-in isn't turned on yet. Until it is, use an app password below: Gmail works that way too.
                        <details class="mt-1">
                            <summary>How an admin turns it on</summary>
                            Add <code>GoogleOAuth__ClientId</code>, <code>GoogleOAuth__ClientSecret</code> and
                            <code>GoogleOAuth__RedirectUri</code> to the server's <code>.env</code>.
                        </details>
                    </div>
                }
            </div>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h2 class="h6"><i class="bi bi-envelope-at me-1" aria-hidden="true"></i>Any other mailbox (IMAP)</h2>
                <p class="small text-secondary">iCloud, Outlook, Fastmail, Yahoo, your host's mail... Use an app password, not your normal one.</p>
                <div class="d-flex flex-wrap gap-1 mb-2" role="group" aria-label="Mail provider presets">
                    @foreach (var preset in Presets)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => ApplyPreset(preset)">@preset.Name</button>
                    }
                </div>
                <div class="row g-2">
                    <div class="col-12 col-md-6">
                        <label class="form-label small mb-1" for="mail-address">Email address</label>
                        <input id="mail-address" type="email" class="form-control form-control-sm" autocomplete="email" @bind="_setup.Address" @bind:event="oninput" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label small mb-1" for="mail-name">Your name (shown to people you write to)</label>
                        <input id="mail-name" class="form-control form-control-sm" autocomplete="name" @bind="_setup.DisplayName" @bind:event="oninput" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label small mb-1" for="mail-password">App password</label>
                        <input id="mail-password" type="password" class="form-control form-control-sm" autocomplete="new-password" @bind="_setup.Password" @bind:event="oninput" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label small mb-1" for="mail-login">Sign-in (if it isn't the email address)</label>
                        <input id="mail-login" class="form-control form-control-sm" autocomplete="off" @bind="_setup.Login" @bind:event="oninput" />
                    </div>
                    <div class="col-8 col-md-4">
                        <label class="form-label small mb-1" for="mail-imap-host">IMAP server</label>
                        <input id="mail-imap-host" class="form-control form-control-sm" @bind="_setup.ImapHost" @bind:event="oninput" />
                    </div>
                    <div class="col-4 col-md-2">
                        <label class="form-label small mb-1" for="mail-imap-port">Port</label>
                        <input id="mail-imap-port" type="number" class="form-control form-control-sm" @bind="_setup.ImapPort" @bind:event="oninput" />
                    </div>
                    <div class="col-8 col-md-4">
                        <label class="form-label small mb-1" for="mail-smtp-host">SMTP server</label>
                        <input id="mail-smtp-host" class="form-control form-control-sm" @bind="_setup.SmtpHost" @bind:event="oninput" />
                    </div>
                    <div class="col-4 col-md-2">
                        <label class="form-label small mb-1" for="mail-smtp-port">Port</label>
                        <input id="mail-smtp-port" type="number" class="form-control form-control-sm" @bind="_setup.SmtpPort" @bind:event="oninput" />
                    </div>
                </div>
                @if (Presets.FirstOrDefault(p => p.ImapHost == _setup.ImapHost.Trim()) is { } chosen)
                {
                    <div class="form-text">@chosen.Hint</div>
                }
                <div class="d-flex flex-wrap gap-2 mt-2">
                    <button type="button" class="btn btn-primary btn-sm" disabled="@(_busy || string.IsNullOrWhiteSpace(_setup.Address))" @onclick="SaveImapAsync">
                        @(_busy ? "Signing in…" : "Connect")
                    </button>
                    @if (_changingAccount && _accounts.Count > 0)
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => _changingAccount = false">Cancel</button>
                    }
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="mail-shell @(Reading ? "mail-shell--reading" : "mail-shell--list")">
        <nav class="mail-folders" aria-label="Mail folders">
            <button type="button" class="mail-account-button" @ref="_accountButton" aria-haspopup="menu" aria-expanded="@(_accountMenuOpen ? "true" : "false")"
                    title="@_account.Address" @onclick="OpenAccountMenu">
                <span class="mail-avatar" aria-hidden="true">@Initial(_account)</span>
                <span class="mail-account-address text-truncate">@_account.Address</span>
                @if (_accounts.Count > 1 && _unread.Where(pair => pair.Key != _account.Id).Sum(pair => pair.Value) is > 0 and var elsewhere)
                {
                    <span class="mail-count" title="Unread in your other mailboxes">@elsewhere</span>
                }
                <i class="bi bi-chevron-down" aria-hidden="true"></i>
                <span class="visually-hidden">Switch or add a mailbox</span>
            </button>
            <button type="button" class="mail-compose-button" @onclick="() => StartCompose(ComposeKind.New)" title="Compose (c)">
                <i class="bi bi-pencil" aria-hidden="true"></i><span>Compose</span>
            </button>
            @foreach (var (key, label, icon) in MailFolders.All)
            {
                <button type="button" class="mail-folder @(key == _folder ? "active" : string.Empty)" aria-current="@(key == _folder ? "page" : null)"
                        @onclick="() => OpenFolderAsync(key)">
                    <i class="bi @icon" aria-hidden="true"></i><span>@label</span>
                    @if (key == MailFolders.Inbox && _unread.GetValueOrDefault(_account.Id) is > 0 and var unread)
                    {
                        <span class="mail-count">@unread<span class="visually-hidden"> unread</span></span>
                    }
                </button>
            }
            @if (_customFolders.Count > 0)
            {
                <div class="mail-folders-heading small text-secondary">@(_account.Provider == MailProviders.Google ? "Labels" : "Folders")</div>
                @foreach (var folder in _customFolders)
                {
                    <button type="button" class="mail-folder @(folder.Key == _folder ? "active" : string.Empty)" aria-current="@(folder.Key == _folder ? "page" : null)"
                            title="@folder.Label" @onclick="() => OpenFolderAsync(folder.Key)">
                        <i class="bi @(_account.Provider == MailProviders.Google ? "bi-tag" : "bi-folder") " aria-hidden="true"></i><span class="text-truncate">@folder.Label</span>
                    </button>
                }
            }
            <button type="button" class="mail-folder mail-shortcuts-link small" @onclick="() => _showShortcuts = true">
                <i class="bi bi-keyboard" aria-hidden="true"></i><span>Shortcuts (?)</span>
            </button>
        </nav>

        <section class="mail-list" aria-label="Messages" @ref="_listRef">
            <div class="mail-list-head">
            <form class="mail-search" @onsubmit="SearchAsync" @onsubmit:preventDefault>
                <input type="search" class="form-control form-control-sm" placeholder="Search mail (/)" aria-label="Search mail" @bind="_search" @bind:event="oninput" />
            </form>
            <div class="mail-list-toolbar" role="toolbar" aria-label="Messages">
                <span class="mail-select">
                    <button type="button" class="mail-tool" role="checkbox" aria-checked="@SelectAllState" aria-label="Select all"
                            title="Select" disabled="@(_messages.Count == 0)" @onclick="ToggleSelectAll">
                        <i class="bi @(SelectAllState == "true" ? "bi-check-square-fill" : SelectAllState == "mixed" ? "bi-dash-square-fill" : "bi-square")" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="mail-tool mail-tool--narrow" @ref="_selectButton" aria-haspopup="menu" aria-expanded="@(_selectMenuOpen ? "true" : "false")"
                            aria-label="Select which messages" disabled="@(_messages.Count == 0)" @onclick="OpenSelectMenu">
                        <i class="bi bi-caret-down-fill" aria-hidden="true"></i>
                    </button>
                </span>
                @if (_checked.Count == 0)
                {
                    <button type="button" class="mail-tool" title="Refresh" aria-label="Refresh" disabled="@_loadingList" @onclick="() => LoadListAsync(reset: true)">
                        <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                    </button>
                    <span class="mail-list-count small text-secondary">@ListCount</span>
                }
                else
                {
                    var selected = Checked;
                    <span class="mail-selected small">@selected.Count selected</span>
                    @if (_folder is not MailFolders.Archive and not MailFolders.Trash)
                    {
                        <button type="button" class="mail-tool" title="Archive (e)" aria-label="Archive selected" @onclick="() => ApplyAsync(selected, MailActions.Archive)">
                            <i class="bi bi-archive" aria-hidden="true"></i>
                        </button>
                    }
                    <button type="button" class="mail-tool" title="@(InTrash ? "Delete forever" : "Delete (#)")" aria-label="@(InTrash ? "Delete selected forever" : "Delete selected")"
                            @onclick="() => ApplyAsync(selected, MailActions.Trash)">
                        <i class="bi bi-trash" aria-hidden="true"></i>
                    </button>
                    @if (selected.Any(m => m.Unread))
                    {
                        <button type="button" class="mail-tool" title="Mark as read (Shift+I)" aria-label="Mark selected as read" @onclick="() => ApplyAsync(selected, MailActions.MarkRead)">
                            <i class="bi bi-envelope-open" aria-hidden="true"></i>
                        </button>
                    }
                    @if (selected.Any(m => !m.Unread))
                    {
                        <button type="button" class="mail-tool" title="Mark as unread (Shift+U)" aria-label="Mark selected as unread" @onclick="() => ApplyAsync(selected, MailActions.MarkUnread)">
                            <i class="bi bi-envelope" aria-hidden="true"></i>
                        </button>
                    }
                    <button type="button" class="mail-tool" title="@(selected.Any(m => !m.Starred) ? "Star" : "Unstar")" aria-label="@(selected.Any(m => !m.Starred) ? "Star selected" : "Unstar selected")"
                            @onclick="() => ApplyAsync(selected, selected.Any(m => !m.Starred) ? MailActions.Star : MailActions.Unstar)">
                        <i class="bi @(selected.Any(m => !m.Starred) ? "bi-star" : "bi-star-fill")" aria-hidden="true"></i>
                    </button>
                }
            </div>
            </div>
            @if (_loadingList && _messages.Count == 0)
            {
                <LoadingIndicator Message="Getting your mail…" />
            }
            else if (_messages.Count == 0)
            {
                <p class="text-secondary small p-3 mb-0">@(string.IsNullOrWhiteSpace(_search) ? "Nothing here." : "No messages match.")</p>
            }
            else
            {
                <ul class="mail-items list-unstyled mb-0">
                    @foreach (var message in _messages)
                    {
                        var isChecked = _checked.Contains(message.Id);
                        <li class="mail-item @(message.Unread ? "unread" : string.Empty) @(message.Id == _selectedId ? "selected" : string.Empty) @(isChecked ? "checked" : string.Empty) @(message.Id == _cursorId ? "cursor" : string.Empty)"
                            @key="message.Id" data-id="@message.Id" @oncontextmenu="e => OpenMenu(e, message)" @oncontextmenu:preventDefault="true">
                            <span class="mail-item-swipe mail-item-swipe--read" aria-hidden="true">
                                <i class="bi @(message.Unread ? "bi-envelope-open" : "bi-envelope")"></i>@(message.Unread ? "Read" : "Unread")
                            </span>
                            <span class="mail-item-swipe mail-item-swipe--delete" aria-hidden="true">
                                @(InTrash ? "Delete forever" : "Delete")<i class="bi bi-trash"></i>
                            </span>
                            <div class="mail-item-row">
                                <input type="checkbox" class="form-check-input mail-item-check" checked="@isChecked" title="Select (x)"
                                       aria-label="@($"Select {(string.IsNullOrWhiteSpace(message.Subject) ? "(no subject)" : message.Subject)}")" @onclick="e => ToggleCheck(message, e)" />
                                <button type="button" class="mail-item-star @(message.Starred ? "on" : string.Empty)" title="@(message.Starred ? "Unstar" : "Star")"
                                        aria-label="@(message.Starred ? "Unstar" : "Star")" aria-pressed="@(message.Starred ? "true" : "false")"
                                        @onclick="() => ApplyAsync([message], message.Starred ? MailActions.Unstar : MailActions.Star)">
                                    <i class="bi @(message.Starred ? "bi-star-fill" : "bi-star")" aria-hidden="true"></i>
                                </button>
                                <button type="button" class="mail-item-open" @onclick="() => OpenMessageAsync(message)">
                                    <span class="mail-item-from text-truncate">@(_folder is MailFolders.Sent or MailFolders.Drafts ? "To: " + Names(message.To) : Name(message.From))</span>
                                    <span class="mail-item-text text-truncate">
                                        <span class="mail-item-subject">@(string.IsNullOrWhiteSpace(message.Subject) ? "(no subject)" : message.Subject)</span>
                                        @if (!string.IsNullOrWhiteSpace(message.Snippet))
                                        {
                                            <span class="mail-item-snippet"><span class="mail-item-dash"> - </span>@message.Snippet</span>
                                        }
                                    </span>
                                    <span class="mail-item-date">
                                        @if (message.HasAttachments)
                                        {
                                            <i class="bi bi-paperclip me-1" aria-label="Has attachments"></i>
                                        }
                                        @ListDate(message.Date)
                                    </span>
                                </button>
                                <span class="mail-item-quick" role="group" aria-label="Quick actions">
                                    @if (_folder is not MailFolders.Archive and not MailFolders.Trash)
                                    {
                                        <button type="button" title="Archive" aria-label="Archive" @onclick="() => ApplyAsync([message], MailActions.Archive)"><i class="bi bi-archive" aria-hidden="true"></i></button>
                                    }
                                    <button type="button" title="@(InTrash ? "Delete forever" : "Delete")" aria-label="@(InTrash ? "Delete forever" : "Delete")" @onclick="() => ApplyAsync([message], MailActions.Trash)"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                    <button type="button" title="@(message.Unread ? "Mark as read" : "Mark as unread")" aria-label="@(message.Unread ? "Mark as read" : "Mark as unread")"
                                            @onclick="() => ApplyAsync([message], message.Unread ? MailActions.MarkRead : MailActions.MarkUnread)">
                                        <i class="bi @(message.Unread ? "bi-envelope-open" : "bi-envelope")" aria-hidden="true"></i>
                                    </button>
                                </span>
                            </div>
                        </li>
                    }
                </ul>
                @if (_nextPage is not null)
                {
                    <div class="p-2 text-center">
                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_loadingList" @onclick="() => LoadListAsync(reset: false)">
                            @(_loadingList ? "Loading…" : "Load more")
                        </button>
                    </div>
                }
            }
        </section>

        <section class="mail-reader" aria-label="Message">
            @if (_compose is not null)
            {
                <form class="mail-compose" @onsubmit="SendAsync" @onsubmit:preventDefault>
                    <div class="mail-reader-bar">
                        <button type="button" class="btn btn-sm btn-link mail-back" @onclick="CloseReader"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back</button>
                        <strong class="me-auto">@_compose.Title</strong>
                    </div>
                    @if (_accounts.Count > 1)
                    {
                        <label class="form-label small mb-1" for="mail-from">From</label>
                        @if (_compose.Kind == ComposeKind.New)
                        {
                            <select id="mail-from" class="form-select form-select-sm mb-2" @bind="_compose.From">
                                @foreach (var account in _accounts)
                                {
                                    <option value="@account.Id">@FromLabel(account)</option>
                                }
                            </select>
                        }
                        else
                        {
                            <input id="mail-from" class="form-control form-control-sm mb-2" readonly value="@FromLabel(_account)" title="A reply, forward or draft goes from the mailbox it's in" />
                        }
                    }
                    <label class="form-label small mb-1" for="mail-to">To</label>
                    <input id="mail-to" class="form-control form-control-sm mb-2" placeholder="name@example.com, …" @bind="_compose.To" @bind:event="oninput" />
                    @if (_compose.ShowCc)
                    {
                        <label class="form-label small mb-1" for="mail-cc">Cc</label>
                        <input id="mail-cc" class="form-control form-control-sm mb-2" @bind="_compose.Cc" @bind:event="oninput" />
                        <label class="form-label small mb-1" for="mail-bcc">Bcc</label>
                        <input id="mail-bcc" class="form-control form-control-sm mb-2" @bind="_compose.Bcc" @bind:event="oninput" />
                    }
                    else
                    {
                        <button type="button" class="btn btn-link btn-sm p-0 mb-2 align-self-start" @onclick="() => _compose.ShowCc = true">Add Cc / Bcc</button>
                    }
                    <label class="form-label small mb-1" for="mail-subject">Subject</label>
                    <input id="mail-subject" class="form-control form-control-sm mb-2" @bind="_compose.Subject" @bind:event="oninput" />
                    <div class="mail-toolbar" role="toolbar" aria-label="Formatting">
                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Bold (⌘B)" aria-label="Bold" disabled="@_compose.Preview" @onclick="@(() => FormatAsync("bold"))"><i class="bi bi-type-bold" aria-hidden="true"></i></button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Italic (⌘I)" aria-label="Italic" disabled="@_compose.Preview" @onclick="@(() => FormatAsync("italic"))"><i class="bi bi-type-italic" aria-hidden="true"></i></button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Bulleted list" aria-label="Bulleted list" disabled="@_compose.Preview" @onclick="@(() => FormatAsync("bullets"))"><i class="bi bi-list-ul" aria-hidden="true"></i></button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Numbered list" aria-label="Numbered list" disabled="@_compose.Preview" @onclick="@(() => FormatAsync("numbers"))"><i class="bi bi-list-ol" aria-hidden="true"></i></button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Link (⌘K)" aria-label="Link" disabled="@_compose.Preview" @onclick="@(() => FormatAsync("link"))"><i class="bi bi-link-45deg" aria-hidden="true"></i></button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Quote" aria-label="Quote" disabled="@_compose.Preview" @onclick="@(() => FormatAsync("quote"))"><i class="bi bi-quote" aria-hidden="true"></i></button>
                        <button type="button" class="btn btn-sm @(_compose.Preview ? "btn-secondary" : "btn-outline-secondary") ms-auto" aria-pressed="@_compose.Preview"
                                @onclick="() => _compose.Preview = !_compose.Preview"><i class="bi bi-eye me-1" aria-hidden="true"></i>Preview</button>
                    </div>
                    <label class="visually-hidden" for="mail-body">Message</label>
                    <textarea id="mail-body" class="form-control mail-compose-body" hidden="@_compose.Preview" @ref="_bodyRef" @bind="_compose.Body" @bind:event="oninput"></textarea>
                    @if (_compose.Preview)
                    {
                        <iframe class="mail-body mail-compose-preview" title="Preview" sandbox="" referrerpolicy="no-referrer"
                                srcdoc="@GwsBusinessSuite.Infrastructure.Services.MailFormatting.PreviewDocument(_compose.Body)"></iframe>
                    }
                    @if (_compose.Kind == ComposeKind.Forward && _detail?.Attachments.Count > 0)
                    {
                        <div class="small text-secondary mt-1"><i class="bi bi-paperclip" aria-hidden="true"></i> The @_detail.Attachments.Count attachment(s) go with it.</div>
                    }
                    <div class="mail-compose-files mt-2">
                        <label class="btn btn-outline-secondary btn-sm mb-0" for="mail-attach"><i class="bi bi-paperclip me-1" aria-hidden="true"></i>Attach files</label>
                        <InputFile id="mail-attach" class="visually-hidden" multiple OnChange="AttachAsync" />
                        @foreach (var file in _compose.Files)
                        {
                            <span class="badge text-bg-light border mail-compose-file">
                                @file.FileName · @Size(file.Content.Length)
                                <button type="button" class="btn-close ms-1" aria-label="Remove @file.FileName" @onclick="() => _compose.Files.Remove(file)"></button>
                            </span>
                        }
                    </div>
                    <div class="d-flex gap-2 mt-2">
                        <button type="submit" class="btn btn-primary btn-sm" disabled="@(_busy || string.IsNullOrWhiteSpace(_compose.To + _compose.Cc + _compose.Bcc))">
                            <i class="bi bi-send me-1" aria-hidden="true"></i>@(_busy ? "Sending…" : "Send")
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@_busy" @onclick="SaveDraftAsync"><i class="bi bi-file-earmark me-1" aria-hidden="true"></i>Save draft</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@_busy" @onclick="() => _compose = null">@(_compose.DraftId is null ? "Discard" : "Close")</button>
                    </div>
                </form>
            }
            else if (_loadingDetail)
            {
                <LoadingIndicator Message="Opening the message…" />
            }
            else if (_detail is not null)
            {
                <div class="mail-reader-bar">
                    <button type="button" class="btn btn-sm btn-link mail-back" @onclick="CloseReader"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back</button>
                    @if (_folder == MailFolders.Drafts)
                    {
                        <button type="button" class="btn btn-sm btn-primary me-auto" @onclick="() => StartCompose(ComposeKind.EditDraft)"><i class="bi bi-pencil me-1" aria-hidden="true"></i>Edit draft</button>
