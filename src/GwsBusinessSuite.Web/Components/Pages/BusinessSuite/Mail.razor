    private IReadOnlyDictionary<Guid, int> _unread = new Dictionary<Guid, int>();
    private IReadOnlyList<MailMessageSummary>? _confirmForever;
    private bool _confirmRemove;

    private async Task RefreshUnreadAsync()
    {
        try
        {
            _unread = await GatedAsync(() => MailService.GetUnreadByAccountAsync(_username));
        }
        catch (MailException)
