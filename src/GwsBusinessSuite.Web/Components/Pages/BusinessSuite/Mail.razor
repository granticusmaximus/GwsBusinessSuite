    private Guid AccountId => _account?.Id ?? Guid.Empty;
    private SetupState _setup = new();
    private string _folder = MailFolders.Inbox;
    private string _search = string.Empty;
    private readonly List<MailMessageSummary> _messages = [];
    private string? _nextPage;
    private bool _loadingList;
    private string? _selectedId;
    private MailMessageDetail? _detail;
    private bool _loadingDetail;
    private ComposeState? _compose;
    private bool _busy;
    private string? _error;
    private string? _status;
    // Survives the mailbox loading (RunAsync clears _error): connected, but sending is blocked.
    private string? _warning;

    protected override async Task OnInitializedAsync()
    {
        _username = await CurrentUserAccessor.GetCurrentUsernameAsync();
        (_status, _error) = GoogleResult switch
        {
            "connected" => ("Gmail is connected.", (string?)null),
            "denied" => (null, "Google sign-in was cancelled."),
            "failed" => (null, "Gmail didn't connect. On Google's screen, tick the box that lets the app read, send and organise your mail, then try again."),
            "not-configured" => (null, "Google sign-in isn't set up on this server yet."),
            _ => (null, null)
        };
        _accounts = (await MailService.ListAccountsAsync(_username)).ToList();
        _loaded = true;
        await SelectAccountAsync(_accounts.FirstOrDefault(account => account.Id == AccountQuery) ?? _accounts.FirstOrDefault());
        _ = KeepCheckingAsync(_closing.Token);
    }

    // New mail shows up while the page is open: the first page is checked every two minutes and
    // anything new goes on top (what's already listed stays where it is).
    private static readonly TimeSpan CheckEvery = TimeSpan.FromMinutes(2);
    private readonly CancellationTokenSource _closing = new();

    private async Task KeepCheckingAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(CheckEvery);
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (_account is null || _loadingList || _busy || !string.IsNullOrWhiteSpace(_search)) continue;
                try
                {
                    var page = await GatedAsync(() => MailService.ListAsync(_username, AccountId, _folder, null, null, cancellationToken));
                    var fresh = page.Messages.Where(message => _messages.All(existing => existing.Id != message.Id)).ToList();
                    if (fresh.Count == 0) continue;
                    _messages.InsertRange(0, fresh);
                    MailUnread.Invalidate(_username);
                    await RefreshUnreadAsync();
                    await InvokeAsync(StateHasChanged);
                }
                catch (MailException)
                {
                    // A blip; the next check tries again, and Refresh shows any real problem.
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        _closing.Cancel();
        _closing.Dispose();
        _snackTimer?.Cancel();
        _snackTimer?.Dispose();
        try
        {
            if (_composeModule is not null) await _composeModule.DisposeAsync();
            if (_listModule is not null)
            {
                if (_swipeHandle is { } swipe) await _listModule.InvokeVoidAsync("detach", swipe);
                if (_keysHandle is { } keys) await _listModule.InvokeVoidAsync("detach", keys);
                await _listModule.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone with the page.
        }
    }

    private async Task AttachAsync(InputFileChangeEventArgs e)
    {
        if (_compose is null) return;
        _error = null;
        foreach (var file in e.GetMultipleFiles(MailLimits.MaxAttachments))
        {
            var total = _compose.Files.Sum(f => (long)f.Content.Length) + file.Size;
            if (_compose.Files.Count >= MailLimits.MaxAttachments || total > MailLimits.MaxAttachmentBytes)
            {
                _error = $"Attachments can add up to {MailLimits.MaxAttachmentBytes / (1024 * 1024)} MB ({MailLimits.MaxAttachments} files).";
                break;
            }
            using var stream = new MemoryStream();
            await file.OpenReadStream(MailLimits.MaxAttachmentBytes).CopyToAsync(stream);
            _compose.Files.Add(new MailAttachmentUpload(file.Name, file.ContentType, stream.ToArray()));
        }
    }

    private async Task OpenFolderAsync(string folder)
    {
        _folder = folder;
        _search = string.Empty;
