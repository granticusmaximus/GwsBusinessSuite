            {
                <button type="button" role="menuitem" class="mail-menu-item" @onclick="() => MenuOpenAsync(menu.Message, null)"><i class="bi bi-envelope-open" aria-hidden="true"></i>Open</button>
                @if (_folder != MailFolders.Drafts)
                {
                    <button type="button" role="menuitem" class="mail-menu-item" @onclick="() => MenuOpenAsync(menu.Message, ComposeKind.Reply)"><i class="bi bi-reply" aria-hidden="true"></i>Reply</button>
