    private Task SearchAsync() => LoadListAsync(reset: true);

    private async Task LoadListAsync(bool reset)
    {
        _loadingList = true;
        if (reset)
        {
            _messages.Clear();
            _nextPage = null;
            _checked.Clear();
            _anchorId = null;
        }
