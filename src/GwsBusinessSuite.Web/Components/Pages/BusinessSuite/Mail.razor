        public string ImapHost { get; set; } = string.Empty;
        public int ImapPort { get; set; } = 993;
        public string SmtpHost { get; set; } = string.Empty;
        public int SmtpPort { get; set; } = 587;
        public string SmtpSecurity { get; set; } = MailServerSecurity.StartTls;
    }

    private sealed record Preset(string Name, string ImapHost, string SmtpHost, int SmtpPort, string SmtpSecurity, string Hint);

    private static readonly Preset[] Presets =
    [
        new("Gmail", "imap.gmail.com", "smtp.gmail.com", 587, MailServerSecurity.StartTls,
            "Gmail over IMAP: turn on 2-Step Verification, then make an app password under Google Account > Security > App passwords."),
        new("iCloud", "imap.mail.me.com", "smtp.mail.me.com", 587, MailServerSecurity.StartTls,
            "iCloud Mail: make an app-specific password at account.apple.com > Sign-In and Security. The sign-in is your iCloud address."),
        new("Outlook / Microsoft 365", "outlook.office365.com", "smtp.office365.com", 587, MailServerSecurity.StartTls,
