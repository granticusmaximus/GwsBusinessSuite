    private async Task OpenMessageAsync(MailMessageSummary message, bool showImages = false)
    {
        CloseMenus();
        _compose = null;
        _selectedId = message.Id;
        _cursorId = message.Id;
        _loadingDetail = true;
        _detail = null;
