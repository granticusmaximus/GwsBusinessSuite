                        @onclick="() => ChooseAccountAsync(account)">
                    <span class="mail-avatar mail-avatar--small" aria-hidden="true">@Initial(account)</span>
                    <span class="mail-menu-account">
                        <span class="text-truncate">@account.Address</span>
                        <span class="small text-secondary">@(account.Provider == MailProviders.Google ? "Gmail" : "IMAP")@(account.LastError is null ? string.Empty : " · needs attention")</span>
                    </span>
                    @if (_unread.GetValueOrDefault(account.Id) is > 0 and var count)
                    {
                        <span class="mail-count">@count<span class="visually-hidden"> unread</span></span>
                    }
                </button>
            }
            <div class="mail-menu-separator" role="separator"></div>
            @if (_accounts.Count < MailLimits.MaxAccounts)
            {
                <button type="button" role="menuitem" class="mail-menu-item" @onclick="StartAddAccount"><i class="bi bi-plus-lg" aria-hidden="true"></i>Add another mailbox</button>
            }
            @if (_account.Provider == MailProviders.Imap)
            {
                <button type="button" role="menuitem" class="mail-menu-item" @onclick="StartEditAccount"><i class="bi bi-pencil" aria-hidden="true"></i>Edit this mailbox</button>
            }
            <button type="button" role="menuitem" class="mail-menu-item mail-menu-item--danger" @onclick="() => { _accountMenuOpen = false; _confirmRemove = true; }">
                <i class="bi bi-box-arrow-right" aria-hidden="true"></i><span class="text-truncate">Remove @_account.Address</span>
            </button>
        </div>
    }

    <ConfirmModal Show="@(_confirmForever is not null)" Title="Delete forever?" ConfirmText="Delete forever"
                  Message="@($"{Count(_confirmForever?.Count ?? 0, "message")} will be deleted for good. This can't be undone.")"
                  OnConfirm="ConfirmForeverAsync" OnCancel="() => _confirmForever = null" />
    <ConfirmModal Show="_confirmRemove" Title="Remove this mailbox?" ConfirmText="Remove"
                  Message="@($"{_account.Address} leaves Mail. Nothing from it is kept in the app, and you can connect it again any time.")"
                  OnConfirm="DisconnectAsync" OnCancel="() => _confirmRemove = false" />

    @if (_showShortcuts)
    {
        <div class="modal-backdrop fade show"></div>
        <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="mail-shortcuts-title" @onkeydown="OnShortcutsKeyDown">
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="mail-shortcuts-title">Keyboard shortcuts</h2>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="() => _showShortcuts = false"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-secondary">The same keys as Gmail. They work while you aren't typing.</p>
                    <dl class="mail-shortcuts">
                        @foreach (var (keys, what) in Shortcuts)
                        {
                            <dt>@foreach (var key in keys) { <kbd>@key</kbd> }</dt>
                            <dd>@what</dd>
                        }
                    </dl>
                    <p class="small text-secondary mb-0">
                        Swipe a message right with two fingers (or your finger on a touch screen) to mark it read or unread, and left to delete it.
                        Right-click a message, or press the Menu key, for everything else.
                    </p>
                </div>
            </div></div>
        </div>
    }
}

<div class="mail-snack-region" role="status" aria-live="polite">
    @if (_snack is { } snack)
    {
        <div class="mail-snack">
            <span>@snack.Text</span>
            @if (snack.Undo is not null)
            {
                <button type="button" class="mail-snack-undo" @onclick="UndoAsync">Undo</button>
            }
            <button type="button" class="mail-snack-close" aria-label="Dismiss" @onclick="DismissSnack"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "google")] public string? GoogleResult { get; set; }
    [SupplyParameterFromQuery(Name = "account")] public Guid? AccountQuery { get; set; }

    private enum ComposeKind { New, Reply, ReplyAll, Forward, EditDraft }

    private sealed class ComposeState
    {
        public ComposeKind Kind { get; init; }
