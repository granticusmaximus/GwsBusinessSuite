    // Right: read or unread. Left: delete. True when the message left the list.
    [JSInvokable]
    public async Task<bool> OnSwipe(string id, string side)
    {
        var removed = false;
        await InvokeAsync(async () =>
        {
            if (_messages.FirstOrDefault(m => m.Id == id) is not { } message) return;
            if (side == "read") await ApplyAsync([message], message.Unread ? MailActions.MarkRead : MailActions.MarkUnread);
            else removed = await ApplyAsync([message], MailActions.Trash);
            StateHasChanged();
        });
        return removed;
    }

    [JSInvokable]
    public Task OnShortcut(string key) => InvokeAsync(async () =>
    {
        await ShortcutAsync(key);
        StateHasChanged();
    });

    private IReadOnlyList<MailMessageSummary> ShortcutTargets() =>
        _checked.Count > 0 ? Checked : OpenSummary is { } open ? [open] : Cursor is { } cursor ? [cursor] : [];

    private async Task ShortcutAsync(string key)
    {
        if (key == "Escape")
        {
            if (_menu is not null || _selectMenuOpen || _accountMenuOpen) CloseMenus();
            else if (_showShortcuts) _showShortcuts = false;
            else if (Reading) CloseReader();
            else _checked.Clear();
            return;
        }
        if (_account is null || _changingAccount || _compose is not null || _confirmForever is not null || _confirmRemove) return;
        if (key == "?")
        {
            _showShortcuts = !_showShortcuts;
            return;
        }
        if (_showShortcuts) return;
        switch (key)
        {
            case "j" or "k":
                MoveCursor(key == "j" ? 1 : -1);
                if (_detail is not null && Cursor is { } next) await OpenMessageAsync(next);
                break;
            case "o" or "Enter":
                if (Cursor is { } cursor) await OpenMessageAsync(cursor);
                break;
            case "u":
                CloseReader();
                _focusCursor = true;
                break;
            case "x":
                if (Cursor is { } toCheck && !_checked.Add(toCheck.Id)) _checked.Remove(toCheck.Id);
                break;
            case "s":
                if (ShortcutTargets() is { Count: > 0 } toStar)
                    await ApplyAsync(toStar, toStar.Any(m => !m.Starred) ? MailActions.Star : MailActions.Unstar);
                break;
            case "e":
                if (_folder is not MailFolders.Archive and not MailFolders.Trash) await ApplyAsync(ShortcutTargets(), MailActions.Archive);
                break;
            case "#":
                await ApplyAsync(ShortcutTargets(), MailActions.Trash);
                break;
            case "I":
                await ApplyAsync(ShortcutTargets(), MailActions.MarkRead);
                break;
            case "U":
                var unreadTargets = ShortcutTargets();
                if (await ApplyAsync(unreadTargets, MailActions.MarkUnread) && _detail is not null && unreadTargets.Any(m => m.Id == _detail.Id)) CloseReader();
                break;
            case "r" or "a" or "f":
                if (_detail is not null && _folder != MailFolders.Drafts)
                    StartCompose(key == "r" ? ComposeKind.Reply : key == "a" ? ComposeKind.ReplyAll : ComposeKind.Forward);
                break;
            case "c":
                StartCompose(ComposeKind.New);
                break;
        }
    }

    private void MoveCursor(int step)
    {
        if (_messages.Count == 0) return;
        var at = _messages.FindIndex(m => m.Id == (_cursorId ?? _selectedId));
        var next = at < 0 ? 0 : Math.Clamp(at + step, 0, _messages.Count - 1);
        _cursorId = _messages[next].Id;
        _focusCursor = true;
    }

    private void OnShortcutsKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Escape" or "?") _showShortcuts = false;
    }

    private static readonly (string[] Keys, string What)[] Shortcuts =
    [
        (["j", "k"], "Next / previous message"), (["o", "Enter"], "Open"), (["u"], "Back to the list"), (["x"], "Select"),
        (["s"], "Star or unstar"), (["e"], "Archive"), (["#"], "Delete"), (["Shift", "I"], "Mark as read"), (["Shift", "U"], "Mark as unread"),
        (["r"], "Reply"), (["a"], "Reply all"), (["f"], "Forward"), (["c"], "Compose"), (["/"], "Search"), (["Esc"], "Close or clear the selection"),
        (["?"], "These shortcuts")
    ];

