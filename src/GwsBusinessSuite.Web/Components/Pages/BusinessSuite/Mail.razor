    // ---- Many messages at once (06-11-26): the toolbar, right-click, swipes and shortcuts all come here.

    private bool InTrash => _folder == MailFolders.Trash;
    private bool Reading => _compose is not null || _detail is not null || _loadingDetail;
    private List<MailMessageSummary> Checked => _messages.Where(m => _checked.Contains(m.Id)).ToList();
    private MailMessageSummary? Cursor => _messages.FirstOrDefault(m => m.Id == _cursorId);
    private string SelectAllState => _checked.Count == 0 ? "false" : _messages.All(m => _checked.Contains(m.Id)) ? "true" : "mixed";
    private string ListCount => _messages.Count == 0 ? string.Empty : $"{_messages.Count}{(_nextPage is null ? string.Empty : "+")} {(_messages.Count == 1 && _nextPage is null ? "message" : "messages")}";

    // Shows the change at once, then asks the mailbox; puts it back if the mailbox refuses. Archive
    // and Delete leave an Undo bar. Deleting from Trash is for good, so it asks first. True when done.
    private async Task<bool> ApplyAsync(IReadOnlyList<MailMessageSummary> targets, string action, bool confirmed = false)
    {
        CloseMenus();
        if (_account is not { } account || targets.Count == 0) return false;
        if (action == MailActions.Trash && InTrash) action = MailActions.DeleteForever;
        if (action == MailActions.DeleteForever && !confirmed)
        {
            _confirmForever = targets;
            return false;
        }
        var folder = _folder;
        var ids = targets.Select(t => t.Id).ToList();
        var chosen = ids.ToHashSet(StringComparer.Ordinal);
        var before = _messages.Select((message, index) => (Message: message, Index: index)).Where(x => chosen.Contains(x.Message.Id)).ToList();
        var removes = MailActions.Removes(action);
        if (removes)
        {
            // The keyboard cursor moves on to the next message, as in Gmail.
            var cursorAt = _cursorId is not null && chosen.Contains(_cursorId) ? _messages.FindIndex(m => m.Id == _cursorId) : -1;
            _messages.RemoveAll(m => chosen.Contains(m.Id));
            _checked.ExceptWith(ids);
            if (cursorAt >= 0)
            {
                var next = _messages.Skip(cursorAt).FirstOrDefault() ?? _messages.LastOrDefault();
                _cursorId = next?.Id;
                _focusCursor = next is not null;
            }
            if (_detail is not null && chosen.Contains(_detail.Id)) CloseReader();
        }
        else
        {
            foreach (var id in ids) Replace(id, m => Changed(m, action));
        }
        _error = null;
        StateHasChanged();
        try
        {
            var result = await GatedAsync(() => MailService.ApplyAsync(_username, account.Id, ids, action));
            if (removes) ShowSnack(SnackText(action, ids.Count), result.Undo, account.Id);
            if (action is MailActions.MarkRead or MailActions.MarkUnread || removes)
            {
                MailUnread.Invalidate(_username);
                StateHasChanged();
                await RefreshUnreadAsync();
            }
            return true;
        }
        catch (MailException ex)
        {
            if (_account?.Id == account.Id && _folder == folder)
            {
                if (removes)
                {
                    foreach (var (message, index) in before) _messages.Insert(Math.Min(index, _messages.Count), message);
                }
                else
                {
                    foreach (var (message, _) in before) Replace(message.Id, _ => message);
                }
            }
            _error = ex.Message;
            return false;
        }
    }

    private static MailMessageSummary Changed(MailMessageSummary message, string action) => action switch
    {
        MailActions.MarkRead => message with { Unread = false },
        MailActions.MarkUnread => message with { Unread = true },
        MailActions.Star => message with { Starred = true },
        MailActions.Unstar => message with { Starred = false },
        _ => message
    };

    private static string SnackText(string action, int count) => action switch
    {
        MailActions.Archive => count == 1 ? "Message archived." : $"{count} messages archived.",
        MailActions.DeleteForever => count == 1 ? "Message deleted for good." : $"{count} messages deleted for good.",
        _ => count == 1 ? "Message moved to Trash." : $"{count} messages moved to Trash."
    };

    private async Task ConfirmForeverAsync()
    {
        if (_confirmForever is not { } targets) return;
        _confirmForever = null;
        await ApplyAsync(targets, MailActions.DeleteForever, confirmed: true);
    }

    // ---- The Undo bar (Gmail's, bottom left, for 8 seconds).

    private static readonly TimeSpan SnackFor = TimeSpan.FromSeconds(8);
    private sealed record Snack(string Text, MailUndo? Undo, Guid AccountId);
    private Snack? _snack;
    private CancellationTokenSource? _snackTimer;

    private void ShowSnack(string text, MailUndo? undo, Guid accountId)
    {
        _snackTimer?.Cancel();
        _snackTimer?.Dispose();
        _snack = new Snack(text, undo, accountId);
        var timer = _snackTimer = new CancellationTokenSource();
        _ = HideSnackLaterAsync(timer.Token);
    }

    private async Task HideSnackLaterAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(SnackFor, cancellationToken);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        await InvokeAsync(() =>
        {
            _snack = null;
            StateHasChanged();
        });
    }

    private void DismissSnack()
    {
        _snackTimer?.Cancel();
        _snack = null;
    }

    private async Task UndoAsync()
    {
        if (_snack is not { Undo: { } undo } snack) return;
        DismissSnack();
        try
        {
            await GatedAsync(async () =>
            {
                await MailService.UndoAsync(_username, snack.AccountId, undo);
                return true;
            });
            MailUnread.Invalidate(_username);
            ShowSnack(undo.Ids.Count == 1 ? "Message put back." : $"{undo.Ids.Count} messages put back.", null, snack.AccountId);
            // Back in its folder an IMAP message has a new id, so the list is read again.
            if (_account?.Id == snack.AccountId) await LoadListAsync(reset: true);
            await RefreshUnreadAsync();
        }
        catch (MailException ex)
        {
            _error = ex.Message;
        }
    }

    // ---- Selection: the boxes, Shift-click for a range, and the select menu.

    private readonly HashSet<string> _checked = new(StringComparer.Ordinal);
    private string? _anchorId;
    private string? _cursorId;
    private bool _focusCursor;

    private void ToggleCheck(MailMessageSummary message, MouseEventArgs e)
    {
        var on = !_checked.Contains(message.Id);
        var from = _anchorId is null ? -1 : _messages.FindIndex(m => m.Id == _anchorId);
        var to = _messages.FindIndex(m => m.Id == message.Id);
        if (e.ShiftKey && from >= 0 && to >= 0)
        {
            foreach (var item in _messages.Skip(Math.Min(from, to)).Take(Math.Abs(to - from) + 1))
            {
                if (on) _checked.Add(item.Id);
                else _checked.Remove(item.Id);
            }
        }
        else if (on) _checked.Add(message.Id);
        else _checked.Remove(message.Id);
        _anchorId = message.Id;
        _cursorId = message.Id;
    }

    private void ToggleSelectAll()
    {
        if (_checked.Count > 0) _checked.Clear();
        else _checked.UnionWith(_messages.Select(m => m.Id));
    }

    private void SelectWhere(Func<MailMessageSummary, bool> which)
    {
        CloseMenus();
        _checked.Clear();
        _checked.UnionWith(_messages.Where(which).Select(m => m.Id));
