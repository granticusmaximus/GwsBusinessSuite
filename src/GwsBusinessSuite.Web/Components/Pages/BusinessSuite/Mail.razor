            @if (targets.Any(m => !m.Unread))
            {
                <button type="button" role="menuitem" class="mail-menu-item" @onclick="() => MenuApplyAsync(MailActions.MarkUnread)"><i class="bi bi-envelope" aria-hidden="true"></i>Mark as unread</button>
            }
            @if (targets.Any(m => !m.Starred))
            {
                <button type="button" role="menuitem" class="mail-menu-item" @onclick="() => MenuApplyAsync(MailActions.Star)"><i class="bi bi-star" aria-hidden="true"></i>Star</button>
            }
            else
            {
                <button type="button" role="menuitem" class="mail-menu-item" @onclick="() => MenuApplyAsync(MailActions.Unstar)"><i class="bi bi-star-fill" aria-hidden="true"></i>Remove star</button>
            }
            <div class="mail-menu-separator" role="separator"></div>
            @if (_folder is not MailFolders.Archive and not MailFolders.Trash)
            {
                <button type="button" role="menuitem" class="mail-menu-item" @onclick="() => MenuApplyAsync(MailActions.Archive)"><i class="bi bi-archive" aria-hidden="true"></i>Archive</button>
