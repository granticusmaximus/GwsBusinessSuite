<button type="button" class="theme-toggle" @onclick="Toggle" title="@(IsDark ? "Switch to light mode" : "Switch to dark mode")">
    <i class="bi @(IsDark ? "bi-sun" : "bi-moon-stars")"></i>
</button>

@code {
    [Parameter] public bool IsDark { get; set; }
    [Parameter] public EventCallback<bool> IsDarkChanged { get; set; }

    private Task Toggle() => IsDarkChanged.InvokeAsync(!IsDark);
}
