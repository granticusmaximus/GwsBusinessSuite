@page "/admin/crm"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "AdminOnly")]
@using GwsBusinessSuite.Application.Crm
@using GwsBusinessSuite.Domain.Entities
@inject ICrmService CrmService
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ILogger<Crm> Logger

<PageTitle>CRM</PageTitle>

<div class="page-header">
    <h1><i class="bi bi-people-fill me-2 text-primary"></i>CRM</h1>
    <p>Track leads, contacts, and deals with local SQLite persistence.</p>
</div>

<ul class="nav nav-pills mb-4">
    <li class="nav-item">
        <button type="button" class="nav-link @(ActiveTab == "Contacts" ? "active" : string.Empty)" @onclick='() => SwitchTabAsync("Contacts")'>
            <i class="bi bi-person-lines-fill me-1"></i>Contacts
        </button>
    </li>
    <li class="nav-item">
        <button type="button" class="nav-link @(ActiveTab == "Pipeline" ? "active" : string.Empty)" @onclick='() => SwitchTabAsync("Pipeline")'>
            <i class="bi bi-kanban-fill me-1"></i>Pipeline@(Deals.Count > 0 ? $" ({Deals.Count})" : "")
        </button>
    </li>
</ul>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="alert alert-danger d-flex align-items-start gap-2 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill mt-1 flex-shrink-0"></i>
        <div>@ErrorMessage</div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(StatusMessage))
{
    <div class="alert alert-info d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-check-circle-fill flex-shrink-0"></i>
        <div>@StatusMessage</div>
    </div>
}

@if (DueFollowUps.Count > 0)
{
    <div class="alert alert-warning d-flex align-items-start gap-2 mb-4" role="alert">
        <i class="bi bi-alarm-fill mt-1 flex-shrink-0"></i>
        <div>
            <div class="fw-semibold">@DueFollowUps.Count follow-up(s) due</div>
            <ul class="mb-0 mt-1 ps-3">
                @foreach (var contact in DueFollowUps)
                {
                    <li>
                        <a href="/admin/crm/contacts/@contact.Id">@contact.FullName</a>
                        &mdash; due @contact.FollowUpDate?.ToLocalTime().ToString("MMM d, yyyy")
                    </li>
                }
            </ul>
        </div>
    </div>
}

@if (ActiveTab == "Contacts")
{
    <div class="card border-0 shadow-sm">
        <div
            class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between gap-2">
            <span class="fw-semibold">@(ShowTrash ? "Trash" : "Contacts")</span>
            <div class="d-flex gap-2">
                <button class="btn btn-sm @(ShowTrash ? "btn-secondary" : "btn-outline-secondary")" @onclick="ToggleTrashViewAsync" disabled="@IsBusy">
                    <i class="bi bi-trash3 me-1"></i>Trash@(TrashedContacts.Count > 0 ? $" ({TrashedContacts.Count})" : "")
                </button>
                @if (!ShowTrash)
                {
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => ShowQuickCreate = !ShowQuickCreate" disabled="@IsBusy">
                        <i class="bi bi-plus-lg me-1"></i>New Contact
                    </button>
                }
            </div>
        </div>
        @if (!ShowTrash && ShowQuickCreate)
        {
            <div class="card-body border-bottom py-3">
                <div class="row g-2">
                    <div class="col-md-5">
                        <input class="form-control form-control-sm" placeholder="Full name"
                               value="@QuickCreateName" @oninput="e => QuickCreateName = e.Value?.ToString() ?? string.Empty" />
                    </div>
                    <div class="col-md-5">
                        <input class="form-control form-control-sm" placeholder="Email (optional)"
                               value="@QuickCreateEmail" @oninput="e => QuickCreateEmail = e.Value?.ToString() ?? string.Empty" />
                    </div>
                    <div class="col-md-2 d-flex gap-2">
                        <button class="btn btn-sm btn-primary" @onclick="QuickCreateContactAsync" disabled="@(IsBusy || string.IsNullOrWhiteSpace(QuickCreateName))">Save</button>
                    </div>
                </div>
            </div>
        }
        <div class="card-body p-0">
            @if (ShowTrash)
            {
                    @if (TrashedContacts.Count == 0)
                    {
                        <div class="p-4 text-secondary">
                            <p class="mb-0">Trash is empty.</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var contact in TrashedContacts)
                            {
                                <div class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                        <div>
                                            <div class="fw-semibold">@contact.FullName</div>
                                            <div class="small text-secondary">trashed @contact.TrashedAt?.ToLocalTime().ToString("g")</div>
                                        </div>
                                        <div class="d-flex gap-1 flex-shrink-0">
                                            <button class="btn btn-xs btn-outline-primary" @onclick="() => RestoreContactAsync(contact.Id)" disabled="@IsBusy">Restore</button>
                                            <button class="btn btn-xs btn-outline-danger" @onclick="() => DeletePermanentlyAsync(contact.Id)" disabled="@IsBusy">Delete Permanently</button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="p-2 border-bottom d-flex gap-2">
                        <input type="search" class="form-control form-control-sm" placeholder="Search name, email, company..."
                               value="@SearchText" @oninput="e => SearchText = e.Value?.ToString() ?? string.Empty" />
                        <select class="form-select form-select-sm" style="max-width:9rem;" value="@StatusFilter"
                                @onchange="OnStatusFilterChange">
                            <option value="All">All statuses</option>
                            @foreach (var option in ContactStatuses.All)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>
                    @if (VisibleContacts.Count == 0)
                    {
                        <div class="p-4 text-secondary">
                            <p class="mb-0">@(Contacts.Count == 0 ? "No contacts yet. Add your first lead or customer to get started." : "No contacts match your search.")</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var contact in VisibleContacts)
                            {
                                <a href="/admin/crm/contacts/@contact.Id"
                                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-start gap-2">
                                    <div>
                                        <div class="fw-semibold">@contact.FullName</div>
                                        <div class="small text-secondary">
                                            @(!string.IsNullOrWhiteSpace(contact.Company) ? contact.Company : "No company")
                                        </div>
                                    </div>
                                    <span class="badge text-bg-secondary">
                                        @contact.Status
                                    </span>
                                </a>
                            }
                        </div>
                    }
                }
            </div>
        </div>
}

@if (ActiveTab == "Pipeline")
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between gap-2">
            <span class="fw-semibold">@(EditingDealId.HasValue ? "Edit Deal" : "New Deal")</span>
        </div>
        <div class="card-body">
            <EditForm Model="DealEditor" OnValidSubmit="SaveDealAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Contact</label>
                        <InputSelect class="form-select" @bind-Value="DealEditor.ContactId">
                            <option value="@Guid.Empty">Select a contact...</option>
                            @foreach (var contact in Contacts)
                            {
                                <option value="@contact.Id">@contact.FullName</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Title</label>
                        <InputText class="form-control" @bind-Value="DealEditor.Title" placeholder="e.g. Annual support renewal" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Stage</label>
                        <InputSelect class="form-select" @bind-Value="DealEditor.Stage">
                            @foreach (var option in DealStages.All)
                            {
                                <option value="@option">@option</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Value (USD)</label>
                        <InputNumber class="form-control" @bind-Value="DealEditor.ValueUsd" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Expected Close Date <span class="text-muted">(optional)</span></label>
                        <InputDate class="form-control" @bind-Value="DealEditor.ExpectedCloseDate" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Notes</label>
                        <InputText class="form-control" @bind-Value="DealEditor.Notes" placeholder="Optional" />
                    </div>
                </div>
                <div class="mt-3 d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary" disabled="@(IsBusy || Contacts.Count == 0)">
                        <i class="bi bi-floppy-fill me-1"></i>Save Deal
                    </button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="CreateNewDeal" disabled="@IsBusy">Reset</button>
                </div>
                @if (Contacts.Count == 0)
                {
                    <div class="form-text text-warning mt-2">Add a contact first - every deal needs one.</div>
                }
            </EditForm>
        </div>
    </div>

    <div class="row g-3">
        @foreach (var stage in DealStages.Open)
        {
            <div class="col-lg-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-bottom py-2 fw-semibold small text-uppercase">
                        @stage <span class="text-secondary">(@DealsByStage(stage).Count)</span>
                    </div>
                    <div class="card-body p-2 d-flex flex-column gap-2">
                        @foreach (var deal in DealsByStage(stage))
                        {
                            <div class="border rounded p-2">
                                <div class="fw-semibold small">@deal.Title</div>
                                <div class="small text-secondary">@deal.ContactName</div>
                                <div class="small">@deal.ValueUsd.ToString("C0")</div>
                                <div class="d-flex align-items-center gap-1 mt-2">
                                    <select class="form-select form-select-sm" value="@deal.Stage" @onchange="e => MoveDealStageAsync(deal.Id, e.Value?.ToString() ?? deal.Stage)" disabled="@IsBusy">
                                        @foreach (var option in DealStages.All)
                                        {
                                            <option value="@option">@option</option>
                                        }
                                    </select>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" title="Edit" @onclick="() => EditDeal(deal)" disabled="@IsBusy">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" title="Delete" @onclick="() => DeleteDealAsync(deal.Id)" disabled="@IsBusy">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            </div>
                        }
                        @if (DealsByStage(stage).Count == 0)
                        {
                            <p class="text-secondary small mb-0">No deals.</p>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (ClosedDeals.Count > 0)
    {
        <div class="card border-0 shadow-sm mt-3">
            <div class="card-header bg-white border-bottom py-2 fw-semibold small text-uppercase">Closed (@ClosedDeals.Count)</div>
            <div class="list-group list-group-flush">
                @foreach (var deal in ClosedDeals)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center gap-2">
                        <div>
                            <span class="fw-semibold">@deal.Title</span>
                            <span class="text-secondary"> &mdash; @deal.ContactName &mdash; @deal.ValueUsd.ToString("C0")</span>
                        </div>
                        <span class="badge @(deal.Stage == DealStages.Won ? "text-bg-success" : "text-bg-secondary")">@deal.Stage</span>
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    private List<Contact> Contacts { get; set; } = new();
    private List<Contact> TrashedContacts { get; set; } = new();
    private List<Contact> DueFollowUps { get; set; } = new();
    private bool ShowTrash { get; set; }
    private bool ShowQuickCreate { get; set; }
    private string QuickCreateName { get; set; } = string.Empty;
    private string QuickCreateEmail { get; set; } = string.Empty;
    private bool IsBusy { get; set; }
    private string StatusMessage { get; set; } = string.Empty;
    private string ErrorMessage { get; set; } = string.Empty;
    private string SearchText { get; set; } = string.Empty;
    private string StatusFilter { get; set; } = "All";
    private string ActiveTab { get; set; } = "Contacts";
    private List<DealView> Deals { get; set; } = new();
    private DealEditorModel DealEditor { get; set; } = new();
    private Guid? EditingDealId { get; set; }

    private async Task SwitchTabAsync(string tab)
    {
        ActiveTab = tab;
        if (tab == "Pipeline")
        {
            await LoadDealsAsync();
        }
    }

    private List<DealView> DealsByStage(string stage) => Deals.Where(deal => deal.Stage == stage).ToList();

    private List<DealView> ClosedDeals => Deals.Where(deal => deal.Stage is DealStages.Won or DealStages.Lost).ToList();

    private async Task LoadDealsAsync()
    {
        try
        {
            Deals = (await CrmService.ListDealsAsync()).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to load CRM deals.");
            ErrorMessage = $"Unable to load deals. {ex.Message}";
        }
    }

    private void CreateNewDeal()
    {
        EditingDealId = null;
        DealEditor = new DealEditorModel { ContactId = Contacts.FirstOrDefault()?.Id ?? Guid.Empty };
        ErrorMessage = string.Empty;
    }

    private void EditDeal(DealView deal)
    {
        EditingDealId = deal.Id;
        DealEditor = new DealEditorModel
        {
            DealId = deal.Id,
            ContactId = deal.ContactId,
            Title = deal.Title,
            Stage = deal.Stage,
            ValueUsd = deal.ValueUsd,
            ExpectedCloseDate = deal.ExpectedCloseDate,
            Notes = deal.Notes
        };
        ErrorMessage = string.Empty;
    }

    private async Task SaveDealAsync()
    {
        if (IsBusy || DealEditor.ContactId == Guid.Empty) return;

        IsBusy = true;
        ErrorMessage = string.Empty;
        StatusMessage = string.Empty;
        try
        {
            var saved = await CrmService.SaveDealAsync(DealEditor);
            StatusMessage = $"Saved deal '{saved.Title}'.";
            CreateNewDeal();
            await LoadDealsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to save CRM deal.");
            ErrorMessage = $"Unable to save deal. {ex.Message}";
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task MoveDealStageAsync(Guid dealId, string stage)
    {
        if (IsBusy) return;

        IsBusy = true;
        ErrorMessage = string.Empty;
        try
        {
            await CrmService.SetDealStageAsync(dealId, stage);
            await LoadDealsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to move CRM deal {DealId} to stage {Stage}.", dealId, stage);
            ErrorMessage = $"Unable to update the deal's stage. {ex.Message}";
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task DeleteDealAsync(Guid dealId)
    {
        if (IsBusy) return;

        var confirmed = await JS.InvokeAsync<bool>("confirm", "Delete this deal? This cannot be undone.");
        if (!confirmed) return;

        IsBusy = true;
        ErrorMessage = string.Empty;
        try
        {
            await CrmService.DeleteDealAsync(dealId);
            StatusMessage = "Deleted the deal.";
            await LoadDealsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to delete CRM deal {DealId}.", dealId);
            ErrorMessage = $"Unable to delete deal. {ex.Message}";
        }
        finally
        {
            IsBusy = false;
        }
    }

    private void OnStatusFilterChange(ChangeEventArgs e) => StatusFilter = e.Value?.ToString() ?? "All";

    private List<Contact> VisibleContacts
    {
        get
        {
            IEnumerable<Contact> query = Contacts;
            if (StatusFilter != "All")
            {
                query = query.Where(c => c.Status == StatusFilter);
            }

            if (!string.IsNullOrWhiteSpace(SearchText))
            {
                query = query.Where(c =>
                    c.FullName.Contains(SearchText, StringComparison.OrdinalIgnoreCase)
                    || (c.Email ?? string.Empty).Contains(SearchText, StringComparison.OrdinalIgnoreCase)
                    || (c.Company ?? string.Empty).Contains(SearchText, StringComparison.OrdinalIgnoreCase));
            }

            return query.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
        CreateNewDeal();
    }

    private async Task LoadDashboardAsync()
    {
        try
        {
            var dashboard = await CrmService.GetDashboardAsync();
            Contacts = dashboard.Contacts.ToList();
            DueFollowUps = dashboard.DueFollowUps.ToList();
            Deals = dashboard.OpenDeals.ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to load CRM dashboard.");
            ErrorMessage = $"Unable to load contacts. {ex.Message}";
        }
    }

    private async Task ToggleTrashViewAsync()
    {
        ShowTrash = !ShowTrash;
        if (ShowTrash)
        {
            IsBusy = true;
            try
            {
                TrashedContacts = (await CrmService.ListTrashedContactsAsync()).ToList();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Unable to load trashed CRM contacts.");
                ErrorMessage = $"Unable to load Trash. {ex.Message}";
            }
            finally
            {
                IsBusy = false;
            }
        }
    }

    private async Task QuickCreateContactAsync()
    {
        if (IsBusy || string.IsNullOrWhiteSpace(QuickCreateName)) return;

        IsBusy = true;
        ErrorMessage = string.Empty;
        try
        {
            var saved = await CrmService.SaveContactAsync(new ContactEditorModel { FullName = QuickCreateName, Email = QuickCreateEmail });
            Navigation.NavigateTo($"/admin/crm/contacts/{saved.Id}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to create CRM contact.");
            ErrorMessage = $"Unable to create contact. {ex.Message}";
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task RestoreContactAsync(Guid contactId)
    {
        if (IsBusy) return;

        IsBusy = true;
        ErrorMessage = string.Empty;
        StatusMessage = string.Empty;

        try
        {
            await CrmService.RestoreContactAsync(contactId);
            TrashedContacts = (await CrmService.ListTrashedContactsAsync()).ToList();
            await LoadDashboardAsync();
            StatusMessage = "Restored the contact from Trash.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to restore CRM contact {ContactId}.", contactId);
            ErrorMessage = $"Unable to restore contact. {ex.Message}";
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task DeletePermanentlyAsync(Guid contactId)
    {
        if (IsBusy) return;

        var confirmed = await JS.InvokeAsync<bool>("confirm", "Permanently delete this contact? This cannot be undone.");
        if (!confirmed) return;

        IsBusy = true;
        ErrorMessage = string.Empty;
        StatusMessage = string.Empty;

        try
        {
            await CrmService.DeleteContactPermanentlyAsync(contactId);
            TrashedContacts = (await CrmService.ListTrashedContactsAsync()).ToList();
            StatusMessage = "Permanently deleted the contact.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to permanently delete CRM contact {ContactId}.", contactId);
            ErrorMessage = $"Unable to permanently delete contact. {ex.Message}";
        }
        finally
        {
            IsBusy = false;
        }
    }

}
