@using System.Globalization
@using GwsBusinessSuite.Application.GovernmentIntelligence

@if (Votes.Count == 0)
{
    <p class="vote-empty">No Georgia floor-vote data was returned.</p>
}
else
{
    <div class="vote-list">
        @foreach (var vote in Votes)
        {
            <article class="vote-card">
                <div class="vote-meta">
                    <span>@vote.Chamber vote @vote.RollCallNumber</span>
                    <time>@FormatTimestamp(vote.VotedAt)</time>
                </div>
                <h3>@vote.Measure · @vote.Title</h3>
                <p>@vote.Caption</p>
                @if (!string.IsNullOrWhiteSpace(vote.Status))
                {
                    <div class="vote-status">@vote.Status</div>
                }
                <div class="vote-tally" aria-label="Vote totals">
                    <span class="yea"><strong>@vote.YeaCount</strong> Yea</span>
                    <span><strong>@vote.NayCount</strong> Nay</span>
                    @if (vote.NotVotingCount > 0) { <span><strong>@vote.NotVotingCount</strong> Not voting</span> }
                    @if (vote.ExcusedCount > 0) { <span><strong>@vote.ExcusedCount</strong> Excused</span> }
                </div>
                <div class="vote-actions">
                    @if (vote.Votes.Count > 0)
                    {
                        <details>
                            <summary>Member breakdown</summary>
                            <div class="vote-table-wrap">
                                <table>
                                    <thead><tr><th>Member</th><th>Vote</th></tr></thead>
                                    <tbody>
                                        @foreach (var member in vote.Votes)
                                        {
                                            <tr><td>@member.Name</td><td>@member.Vote</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </details>
                    }
                    <a href="@vote.DetailUrl" target="_blank" rel="noopener noreferrer">Official bill detail <i class="bi bi-arrow-up-right"></i></a>
                </div>
                @if (vote.Legislation is not null)
                {
                    <LegislationBriefPanel Brief="vote.Legislation" SummaryLabel="Legislation brief" />
                }
            </article>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<StateLegislativeVoteSummary> Votes { get; set; } = [];

    private static string FormatTimestamp(DateTimeOffset? value) =>
        value is null ? "Date unavailable" : value.Value.ToString("MMM d, yyyy", CultureInfo.InvariantCulture);
}
