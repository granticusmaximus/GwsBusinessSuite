@page "/admin/sentinel-gpt"
@page "/admin/sentinel/gpt"
@page "/admin/ollama-console"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "AdminOnly")]
@implements IAsyncDisposable
@using GwsBusinessSuite.Application.Abstractions
@using GwsBusinessSuite.Application.ContentStudio
@using GwsBusinessSuite.Application.Settings
@using GwsBusinessSuite.Application.Wiki
@using GwsBusinessSuite.Domain.Entities
@using GwsBusinessSuite.Infrastructure.Services
@using GwsBusinessSuite.Web.Services
@using Microsoft.Extensions.Options
@inject ISentinelAiService SentinelGptService
@inject SentinelGptGenerationCoordinator GenerationCoordinator
@inject IOllamaService LocalModelService
@inject OllamaPerformanceTracker PerformanceTracker
@inject ICurrentUserAccessor CurrentUserAccessor
@inject ISiteSettingsService SiteSettingsService
@inject IOptions<ContentStudioOptions> StudioOptions
@inject ILogger<SentinelGpt> Logger
@inject IJSRuntime JS

<PageTitle>SentinelGPT</PageTitle>

<div class="sentinel-gpt-shell">
    <aside class="sentinel-gpt-history" aria-label="SentinelGPT chats">
        <a href="admin/sentinel-gpt" class="sentinel-gpt-brand sentinel-gpt-app-brand">
            <span class="sentinel-gpt-shield">S</span>
            <span><strong>SentinelGPT</strong><small>GWS private assistant</small></span>
        </a>
        <button type="button" class="sentinel-gpt-new-chat" @onclick="StartNewChat" disabled="@_generating">
            <i class="bi bi-plus-lg"></i><span>New chat</span>
        </button>

        <div class="sentinel-gpt-history-scroll">
            @if (_loadingConversations)
            {
                <div class="sentinel-gpt-history-empty"><span class="spinner-border spinner-border-sm"></span> Loading chats…</div>
            }
            else if (_conversations.Count == 0)
            {
                <div class="sentinel-gpt-history-empty">Your conversations will appear here.</div>
            }
            else
            {
                @foreach (var group in ConversationGroups)
                {
                    <section>
                        <div class="sentinel-gpt-section-label">@group.Label</div>
                        @foreach (var conversation in group.Items)
                        {
                            <button type="button"
                                    class="sentinel-gpt-history-item @(_conversationId == conversation.Id ? "active" : null)"
                                    @onclick="() => OpenConversationAsync(conversation.Id)">
                                <i class="bi bi-chat"></i>
                                <span><strong>@conversation.Title</strong><small>@ConversationMeta(conversation)</small></span>
                            </button>
                        }
                    </section>
                }
            }
        </div>
    </aside>

    <main class="sentinel-gpt-chat">
        <header class="sentinel-gpt-chat-header">
            <div>
                <h1>SentinelGPT</h1>
                <span class="@(_connected ? "is-connected" : "is-offline")">
                    <i></i>@(_connected
                        ? _includeInternet ? "Local model · Web research" : "Local · Private"
                        : "Local model unavailable")
                </span>
            </div>
            <div class="sentinel-gpt-header-actions">
                <span class="sentinel-gpt-web-status @(SentinelGptService.IsInternetConfigured ? "is-ready" : null)"
                      title="@(SentinelGptService.IsInternetConfigured ? "Ollama web search is configured" : "Set OllamaWeb__ApiKey to enable internet research")">
                    <i class="bi bi-globe2"></i>@(SentinelGptService.IsInternetConfigured ? "Web ready" : "Web offline")
                </span>
                <span class="sentinel-gpt-model-pill"><i class="bi bi-cpu"></i>@_configuredModel</span>
                <button type="button" @onclick="ToggleSettings" aria-label="SentinelGPT settings" title="Model settings">
                    <i class="bi bi-gear"></i>
                </button>
            </div>
        </header>

        @if (_settingsOpen)
        {
            <section class="sentinel-gpt-settings">
                <div>
                    <strong>Local model</strong>
                    <small>@(_connected ? $"Connected in {_latencyMs} ms" : _connectionError)</small>
                </div>
                <select value="@_configuredModel" @onchange="ChangeConfiguredModelAsync" disabled="@(!_connected || _models.Count == 0)">
                    @foreach (var model in _models)
                    {
                        <option value="@model">@model</option>
                    }
                </select>
                <div class="sentinel-gpt-model-install">
                    <input @bind="_pullModelName" placeholder="Install a model, e.g. llama3.2" />
                    <button type="button" @onclick="PullModelAsync" disabled="@(_modelBusy || string.IsNullOrWhiteSpace(_pullModelName))">
                        @if (_modelBusy) { <span class="spinner-border spinner-border-sm"></span> }
                        else { <i class="bi bi-download"></i> }
                        Install
                    </button>
                </div>
                <button type="button" class="sentinel-gpt-recheck" @onclick="CheckConnectionAsync" disabled="@_checkingConnection">
                    <i class="bi bi-arrow-clockwise"></i> Recheck
                </button>
                <div class="sentinel-gpt-internet-setting">
                    <strong>Internet research</strong>
                    <small>@(SentinelGptService.IsInternetConfigured ? "API key loaded securely on the server" : "Not configured — set OllamaWeb__ApiKey")</small>
                </div>
                <div class="sentinel-gpt-performance-setting">
                    <div>
                        <strong>Last response performance</strong>
                        @if (_lastPerformance is null)
                        {
                            <small>Send a message to capture production timing.</small>
                        }
                        else
                        {
                            <small>@PerformanceHint(_lastPerformance)</small>
                        }
                    </div>
                    @if (_lastPerformance is { } performance)
                    {
                        <div class="sentinel-gpt-performance-metrics">
                            <span><b>@FormatDuration(performance.FirstTokenMilliseconds)</b> first token</span>
                            <span><b>@performance.TokensPerSecond.ToString("0.0")</b> tokens/sec</span>
                            <span><b>@FormatDuration(performance.QueueWaitMilliseconds)</b> queued</span>
                            <span><b>@FormatDuration(performance.LoadMilliseconds)</b> model load</span>
                            <span><b>@FormatDuration(performance.TotalMilliseconds)</b> total</span>
                        </div>
                    }
                </div>
            </section>
        }

        <section class="sentinel-gpt-thread"
                 @ref="_threadElement"
                 aria-live="polite"
                 aria-label="SentinelGPT conversation"
                 tabindex="0">
            @if (_runs.Count == 0 && !_generating)
            {
                <div class="sentinel-gpt-welcome">
                    <span class="sentinel-gpt-avatar">S</span>
                    <div>
                        <h2>What should we work on?</h2>
                        <p>Ask questions, summarize pages, research your workspace, or turn what Sentinel knows into a useful draft.</p>
                        <div class="sentinel-gpt-starters">
                            <button type="button" @onclick='() => UseStarter("Summarize my open work items and flag anything overdue.")'>Summarize open work</button>
                            <button type="button" @onclick='() => UseStarter("What changed recently across my Sentinel workspace?")'>Review recent changes</button>
                            <button type="button" @onclick='() => UseStarter("Create a concise plan from my latest meeting notes.")'>Plan from meeting notes</button>
                            <button type="button" @onclick='() => UseWebStarter("Research the latest information relevant to GWS Business Suite and cite the sources.")'>Research the web</button>
                        </div>
                    </div>
                </div>
            }

            @foreach (var run in _runs)
            {
                <article class="sentinel-gpt-exchange">
                    <div class="sentinel-gpt-message sentinel-gpt-user-message">
                        <div>@run.Instruction</div>
                        <time>@run.CreatedAt.ToLocalTime().ToString("t")</time>
                    </div>
                    <div class="sentinel-gpt-assistant-row">
                        <span class="sentinel-gpt-avatar">S</span>
                        <div>
                            <div class="sentinel-gpt-message sentinel-gpt-assistant-message">@run.Output</div>
                            @if (run.Citations.Count > 0)
                            {
                                <details class="sentinel-gpt-sources">
                                    <summary><i class="bi bi-file-earmark-text"></i>Sources · @string.Join(" · ", run.Citations.Take(3).Select(item => item.Title))</summary>
                                    <div>
                                        @foreach (var citation in run.Citations)
                                        {
                                            <a href="@CitationUrl(citation)"
                                               target="@(citation.SourceType == "web" ? "_blank" : null)"
                                               rel="@(citation.SourceType == "web" ? "noopener noreferrer" : null)">
                                                <i class="bi @CitationIcon(citation)"></i>@citation.Title
                                            </a>
                                        }
                                    </div>
                                </details>
                            }
                            <div class="sentinel-gpt-response-meta">
                                <time>@run.CreatedAt.ToLocalTime().ToString("t") · @run.Model</time>
                                @if (run.Action != SentinelAiActions.ModelManagement)
                                {
                                    <div class="sentinel-gpt-feedback" aria-label="Teach SentinelGPT from this answer">
                                        <button type="button"
                                                class="@(run.Status == SentinelAiRunStatuses.Approved ? "is-selected" : null)"
                                                title="Approve this answer as reusable SentinelGPT learning memory"
                                                aria-label="Approve answer as learning memory"
                                                disabled="@_reviewingRunIds.Contains(run.Id)"
                                                @onclick="() => ReviewRunAsync(run, true)">
                                            <i class="bi bi-hand-thumbs-up"></i>
                                        </button>
                                        <button type="button"
                                                class="@(run.Status == SentinelAiRunStatuses.Rejected ? "is-selected is-rejected" : null)"
                                                title="Reject this answer so SentinelGPT does not learn from it"
                                                aria-label="Reject answer"
                                                disabled="@_reviewingRunIds.Contains(run.Id)"
                                                @onclick="() => ReviewRunAsync(run, false)">
                                            <i class="bi bi-hand-thumbs-down"></i>
                                        </button>
                                        @if (run.Status == SentinelAiRunStatuses.Approved)
                                        {
                                            <span>Saved to learning memory</span>
                                        }
                                        else if (run.Status == SentinelAiRunStatuses.Rejected)
                                        {
                                            <span>Excluded from learning memory</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </article>
            }

            @if (_generating)
            {
                <article class="sentinel-gpt-exchange">
                    <div class="sentinel-gpt-message sentinel-gpt-user-message">
                        <div>@_pendingInstruction</div>
                        <time>Now</time>
                    </div>
                    <div class="sentinel-gpt-assistant-row">
                        <span class="sentinel-gpt-avatar">S</span>
                        <div class="sentinel-gpt-message sentinel-gpt-assistant-message is-streaming">
                            @if (string.IsNullOrEmpty(_liveOutput))
                            {
                                <span class="sentinel-gpt-thinking-copy">
                                    <span class="sentinel-gpt-thinking"><i></i><i></i><i></i></span>
                                    @(!string.IsNullOrWhiteSpace(_toolActivity) ? _toolActivity : "Thinking")
                                </span>
                            }
                            else
                            {
                                <span class="sentinel-gpt-output">@_liveOutput</span>
                            }
                        </div>
                    </div>
                </article>
            }

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="sentinel-gpt-error"><i class="bi bi-exclamation-circle"></i>@_error</div>
            }

            @if (!string.IsNullOrWhiteSpace(_notice))
            {
                <div class="sentinel-gpt-notice"><i class="bi bi-stop-circle"></i>@_notice</div>
            }

            @if (!string.IsNullOrWhiteSpace(_confirmationPrompt))
            {
                <div class="sentinel-gpt-confirmation">
                    <div><i class="bi bi-exclamation-triangle"></i><span><strong>Confirmation required</strong>@_confirmationPrompt</span></div>
                    <div>
                        <button type="button" class="sentinel-gpt-confirm" @onclick="ConfirmModelCommandAsync" disabled="@_generating">Confirm</button>
                        <button type="button" @onclick="CancelModelCommand" disabled="@_generating">Cancel</button>
                    </div>
                </div>
            }
        </section>

        <footer class="sentinel-gpt-composer-wrap">
            <div class="sentinel-gpt-composer">
                <button type="button" aria-label="Attach context" title="Workspace context is automatically selected">
                    <i class="bi bi-paperclip"></i>
                </button>
                <textarea rows="1"
                          data-sentinel-gpt-composer
                          @bind="_instruction"
                          @bind:event="oninput"
                          @onkeydown="HandleComposerKeyDownAsync"
                          maxlength="@SentinelGptDefaults.MaxInstructionLength"
                          placeholder="Message SentinelGPT…"
                          title="Enter to send. Shift+Enter for a new line."
                          disabled="@_generating"></textarea>
                <button type="button" class="sentinel-gpt-context-pill @(_includeInternet ? "is-enabled" : null)"
                        @onclick="ToggleInternet"
                        disabled="@_generating"
                        title="@(SentinelGptService.IsInternetConfigured ? "Include live internet research" : "Internet research is not configured")">
                    <i class="bi bi-globe2"></i><span>@(_includeInternet ? "Web on" : "Web off")</span>
                    <i class="bi @(_includeInternet ? "bi-toggle-on" : "bi-toggle-off")"></i>
                </button>
                <button type="button" class="sentinel-gpt-context-pill @(_useDeepAnalysis ? "is-enabled" : null)"
                        @onclick="ToggleDeepAnalysis"
                        disabled="@_generating"
                        title="@(_useDeepAnalysis ? "Deep analysis uses Qwen and DeepSeek before SentinelGPT" : "Fast mode uses SentinelGPT directly")">
                    <i class="bi @(_useDeepAnalysis ? "bi-stars" : "bi-lightning-charge")"></i>
                    <span>@(_useDeepAnalysis ? "Deep" : "Fast")</span>
                </button>
                <button type="button" aria-label="Voice input" title="Voice input">
                    <i class="bi bi-mic"></i>
                </button>
                @if (_generating && _activeGenerationId is not null)
                {
                    <button type="button"
                            class="sentinel-gpt-send sentinel-gpt-stop"
                            @onclick="StopGeneration"
                            disabled="@_stoppingGeneration"
                            aria-label="Stop generating"
                            title="Stop generating">
                        <i class="bi bi-stop-fill"></i>
                    </button>
                }
                else
                {
                    <button type="button" class="sentinel-gpt-send" @onclick="SendAsync"
                            disabled="@(_generating || string.IsNullOrWhiteSpace(_instruction) || !_connected)"
                            aria-label="Send message">
                        <i class="bi bi-arrow-up"></i>
                    </button>
                }
            </div>
            <small>
                @if (RemainingPromptCharacters <= 2_000)
                {
                    <span class="sentinel-gpt-character-count">@RemainingPromptCharacters.ToString("N0") characters remaining · </span>
                }
                Enter to send · Shift+Enter for a new line. @(_includeInternet
                    ? "Web on: this prompt is sent to Ollama web search. Do not include secrets."
                    : _useDeepAnalysis
                        ? "Deep analysis consults Qwen and DeepSeek before SentinelGPT."
                        : "Fast mode: SentinelGPT responds directly.")
            </small>
        </footer>
    </main>
</div>

@code {
    private string _username = string.Empty;
    private string _instruction = string.Empty;
    private string _pendingInstruction = string.Empty;
    private string _liveOutput = string.Empty;
    private string _toolActivity = string.Empty;
    private string _error = string.Empty;
    private string _notice = string.Empty;
    private string _pendingModelCommand = string.Empty;
    private string _confirmationPrompt = string.Empty;
    private string _configuredModel = SentinelGptDefaults.Model;
    private string _connectionError = string.Empty;
    private string _pullModelName = string.Empty;
    private long _latencyMs;
    private bool _connected;
    private bool _checkingConnection;
    private bool _loadingConversations = true;
    private bool _generating;
    private bool _settingsOpen;
    private bool _modelBusy;
    private bool _stoppingGeneration;
    private bool _includeInternet;
    private bool _useDeepAnalysis;
    private Guid? _conversationId;
    private Guid? _activeGenerationId;
    private List<SentinelGptConversationView> _conversations = [];
    private List<SentinelAiRunView> _runs = [];
    private List<string> _models = [];
    private HashSet<Guid> _reviewingRunIds = [];
    private SiteSettingsView? _settings;
    private OllamaPerformanceSnapshot? _lastPerformance;
    private readonly CancellationTokenSource _componentLifetime = new();
    private ElementReference _threadElement;
    private bool _scrollThreadAfterRender;
    private int RemainingPromptCharacters =>
        Math.Max(0, SentinelGptDefaults.MaxInstructionLength - _instruction.Length);

    private IEnumerable<(string Label, IReadOnlyList<SentinelGptConversationView> Items)> ConversationGroups
    {
        get
        {
            var today = DateTimeOffset.Now.Date;
            var todayItems = _conversations.Where(item => item.UpdatedAt.ToLocalTime().Date == today).ToList();
            var earlier = _conversations.Where(item => item.UpdatedAt.ToLocalTime().Date != today).ToList();
            if (todayItems.Count > 0) yield return ("Today", todayItems);
            if (earlier.Count > 0) yield return ("Earlier", earlier);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _username = await CurrentUserAccessor.GetCurrentUsernameAsync();
        _settings = await SiteSettingsService.GetSettingsAsync();
        _configuredModel = _settings.OllamaModelOverride ?? SentinelGptDefaults.Model;
        _lastPerformance = PerformanceTracker.GetLatest(_configuredModel);
        await Task.WhenAll(CheckConnectionAsync(), LoadConversationsAsync());
        var activeGeneration = GenerationCoordinator.GetActive(_username);
        if (activeGeneration is not null)
        {
            ApplyGenerationSnapshot(activeGeneration);
            _generating = true;
            _activeGenerationId = activeGeneration.Id;
            RequestThreadScroll();
            _ = InvokeAsync(() => ResumeGenerationAsync(activeGeneration.Id));
        }
        else if (_conversations.Count > 0)
        {
            await OpenConversationAsync(_conversations[0].Id);
        }
        else
        {
            StartNewChat();
        }
    }

    private static string SentinelUrl(Guid id, bool isDatabase) =>
        isDatabase ? $"admin/sentinel?database={id}" : $"admin/sentinel?page={id}";

    private static string CitationUrl(SentinelAiCitation citation) =>
        !string.IsNullOrWhiteSpace(citation.Url)
            ? citation.Url
            : citation.TargetId is { } id
                ? SentinelUrl(id, citation.IsDatabase)
                : "#";

    private static string CitationIcon(SentinelAiCitation citation) =>
        citation.SourceType switch
        {
            "web" => "bi-globe2",
            "gws" => "bi-grid-1x2",
            _ => citation.IsDatabase ? "bi-grid-3x3-gap" : "bi-file-earmark-text"
        };

    private async Task LoadConversationsAsync()
    {
        _loadingConversations = true;
        try
        {
            _conversations = (await SentinelGptService.ListConversationsAsync(_username)).ToList();
        }
        finally
        {
            _loadingConversations = false;
        }
    }

    private void StartNewChat()
    {
        if (_generating) return;
        _conversationId = Guid.NewGuid();
        _runs = [];
        _instruction = string.Empty;
        _liveOutput = string.Empty;
        _toolActivity = string.Empty;
        _error = string.Empty;
        _notice = string.Empty;
        _pendingModelCommand = string.Empty;
        _confirmationPrompt = string.Empty;
    }

    private async Task OpenConversationAsync(Guid id)
    {
        if (_generating) return;
        _conversationId = id;
        _error = string.Empty;
        _notice = string.Empty;
        _runs = (await SentinelGptService.ListConversationRunsAsync(id, _username)).ToList();
        RequestThreadScroll();
    }

    private async Task ReviewRunAsync(SentinelAiRunView run, bool approved)
    {
        if (!_reviewingRunIds.Add(run.Id)) return;
        _error = string.Empty;
        try
        {
            await SentinelGptService.ReviewAsync(run.Id, approved, _username);
            var index = _runs.FindIndex(item => item.Id == run.Id);
            if (index >= 0)
            {
                _runs[index] = run with
                {
                    Status = approved ? SentinelAiRunStatuses.Approved : SentinelAiRunStatuses.Rejected
                };
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "SentinelGPT feedback could not be saved for run {RunId}", run.Id);
            _error = $"The learning feedback could not be saved: {ex.Message}";
        }
        finally
        {
            _reviewingRunIds.Remove(run.Id);
        }
    }

    private async Task SendAsync()
    {
        var instruction = _instruction.Trim();
        if (_generating || !_connected || instruction.Length == 0) return;

        _conversationId ??= Guid.NewGuid();
        _pendingInstruction = instruction;
        _instruction = string.Empty;
        _liveOutput = string.Empty;
        _toolActivity = string.Empty;
        _error = string.Empty;
        _notice = string.Empty;
        _generating = true;
        RequestThreadScroll();
        await InvokeAsync(StateHasChanged);
        try
        {
            var command = await SentinelGptService.ExecuteModelCommandAsync(
                _conversationId.Value, instruction, _username, confirmed: false);
            if (command.Handled)
            {
                if (command.RequiresConfirmation)
                {
                    _pendingModelCommand = instruction;
                    _confirmationPrompt = command.ConfirmationPrompt ?? "Confirm this model operation.";
                }
                else if (command.CompletedRun is not null)
                {
                    _runs.Add(command.CompletedRun);
                    RequestThreadScroll();
                    _settings = await SiteSettingsService.GetSettingsAsync();
                    _configuredModel = _settings.OllamaModelOverride ?? SentinelGptDefaults.Model;
                    _lastPerformance = PerformanceTracker.GetLatest(_configuredModel);
                    await CheckConnectionAsync();
                }
            }
            else
            {
                var generation = await GenerationCoordinator.StartAsync(
                    _conversationId.Value, null, instruction, _username, _includeInternet, _useDeepAnalysis);
                _activeGenerationId = generation.Id;
                await MonitorGenerationAsync(generation.Id);
            }
            if ((command.Handled && !command.RequiresConfirmation) || !command.Handled)
            {
                await LoadConversationsAsync();
            }
        }
        catch (OperationCanceledException) when (_componentLifetime.IsCancellationRequested)
        {
            // The component was disposed (navigation, refresh, or a lost circuit).
            // The server-owned coordinator intentionally continues the model request.
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "SentinelGPT generation failed");
            _error = $"SentinelGPT could not complete that response: {ex.Message}";
        }
        finally
        {
            _generating = false;
            _pendingInstruction = string.Empty;
            _liveOutput = string.Empty;
            _toolActivity = string.Empty;
            _activeGenerationId = null;
        }
    }

    private async Task ResumeGenerationAsync(Guid generationId)
    {
        try
        {
            await MonitorGenerationAsync(generationId);
            await LoadConversationsAsync();
        }
        catch (OperationCanceledException) when (_componentLifetime.IsCancellationRequested)
        {
            return;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "SentinelGPT resumed generation failed");
            _error = $"SentinelGPT could not complete that response: {ex.Message}";
        }
        finally
        {
            _generating = false;
            _pendingInstruction = string.Empty;
            _liveOutput = string.Empty;
            _toolActivity = string.Empty;
            _activeGenerationId = null;
            if (!_componentLifetime.IsCancellationRequested)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task MonitorGenerationAsync(Guid generationId)
    {
        while (true)
        {
            _componentLifetime.Token.ThrowIfCancellationRequested();
            var snapshot = GenerationCoordinator.Get(generationId, _username)
                ?? throw new InvalidOperationException(
                    "The active SentinelGPT response is no longer available. Refresh the conversation history.");
            ApplyGenerationSnapshot(snapshot);

            if (snapshot.Status == SentinelGptGenerationStatuses.Failed)
            {
                throw new InvalidOperationException(
                    snapshot.Error ?? "SentinelGPT generation failed.");
            }

            if (snapshot.Status == SentinelGptGenerationStatuses.Cancelled)
            {
                _notice = "Response stopped.";
                return;
            }

            if (snapshot.Status == SentinelGptGenerationStatuses.Completed)
            {
                _lastPerformance = PerformanceTracker.GetLatest(_configuredModel);
                if (snapshot.CompletedRun is { } completed
                    && _runs.All(item => item.Id != completed.Id))
                {
                    _runs.Add(completed);
                    RequestThreadScroll();
                }
                return;
            }

            await InvokeAsync(StateHasChanged);
            await Task.Delay(100, _componentLifetime.Token);
        }
    }

    private void ApplyGenerationSnapshot(SentinelGptGenerationSnapshot snapshot)
    {
        _conversationId = snapshot.ConversationId;
        _pendingInstruction = snapshot.Instruction;
        _includeInternet = snapshot.IncludeInternet;
        _useDeepAnalysis = snapshot.UseDeepAnalysis;
        _liveOutput = snapshot.Output;
        _toolActivity = snapshot.Activity;
        RequestThreadScroll();
    }

    private void StopGeneration()
    {
        if (_activeGenerationId is not { } generationId || _stoppingGeneration)
        {
            return;
        }

        _stoppingGeneration = true;
        _error = string.Empty;
        if (!GenerationCoordinator.Cancel(generationId, _username))
        {
            _notice = "That response already finished.";
        }
        _stoppingGeneration = false;
    }

    private void RequestThreadScroll() => _scrollThreadAfterRender = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_scrollThreadAfterRender || _componentLifetime.IsCancellationRequested)
        {
            return;
        }

        _scrollThreadAfterRender = false;
        try
        {
            await JS.InvokeVoidAsync("sentinelGptChat.scrollToBottom", _threadElement);
        }
        catch (JSDisconnectedException)
        {
            // The response coordinator continues even when this browser circuit is gone.
        }
    }

    private async Task HandleComposerKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !args.ShiftKey && !args.IsComposing)
        {
            await SendAsync();
        }
    }

    private void UseStarter(string prompt) => _instruction = prompt;
    private void UseWebStarter(string prompt)
    {
        _instruction = prompt;
        if (SentinelGptService.IsInternetConfigured)
        {
            _includeInternet = true;
            _error = string.Empty;
        }
        else
        {
            _error = "Internet research is not configured yet. Set OllamaWeb__ApiKey on the server and restart the app.";
        }
    }

    private void ToggleInternet()
    {
        if (!SentinelGptService.IsInternetConfigured)
        {
            _includeInternet = false;
            _error = "Internet research is not configured yet. Set OllamaWeb__ApiKey on the server and restart the app.";
            return;
        }

        _includeInternet = !_includeInternet;
        _error = string.Empty;
    }

    private void ToggleDeepAnalysis()
    {
        _useDeepAnalysis = !_useDeepAnalysis;
        _error = string.Empty;
    }

    private async Task ConfirmModelCommandAsync()
    {
        if (_generating || string.IsNullOrWhiteSpace(_pendingModelCommand)) return;
        var instruction = _pendingModelCommand;
        _conversationId ??= Guid.NewGuid();
        _pendingInstruction = instruction;
        _confirmationPrompt = string.Empty;
        _error = string.Empty;
        _toolActivity = "Updating the local model";
        _generating = true;
        try
        {
            var result = await SentinelGptService.ExecuteModelCommandAsync(
                _conversationId.Value, instruction, _username, confirmed: true);
            if (result.CompletedRun is not null)
            {
                _runs.Add(result.CompletedRun);
            }
            _pendingModelCommand = string.Empty;
            await CheckConnectionAsync();
            await LoadConversationsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "SentinelGPT model command failed");
            _error = $"The model operation could not be completed: {ex.Message}";
        }
        finally
        {
            _generating = false;
            _pendingInstruction = string.Empty;
            _toolActivity = string.Empty;
        }
    }

    private void CancelModelCommand()
    {
        _pendingModelCommand = string.Empty;
        _confirmationPrompt = string.Empty;
    }

    private void ToggleSettings() => _settingsOpen = !_settingsOpen;

    private async Task CheckConnectionAsync()
    {
        _checkingConnection = true;
        var stopwatch = System.Diagnostics.Stopwatch.StartNew();
        try
        {
            _models = (await LocalModelService.ListModelsAsync()).OrderBy(model => model).ToList();
            stopwatch.Stop();
            _latencyMs = stopwatch.ElapsedMilliseconds;
            _connected = true;
            _connectionError = string.Empty;
        }
        catch (Exception ex)
        {
            _connected = false;
            _models = [];
            _connectionError = ex.Message;
        }
        finally
        {
            _checkingConnection = false;
        }
    }

    private async Task ChangeConfiguredModelAsync(ChangeEventArgs args)
    {
        if (_settings is null || string.IsNullOrWhiteSpace(args.Value?.ToString())) return;
        _configuredModel = args.Value!.ToString()!;
        _lastPerformance = PerformanceTracker.GetLatest(_configuredModel);
        _settings = _settings with { OllamaModelOverride = _configuredModel };
        await SiteSettingsService.SaveSettingsAsync(_settings);
    }

    private async Task PullModelAsync()
    {
        var model = _pullModelName.Trim();
        if (model.Length == 0 || _modelBusy) return;
        _modelBusy = true;
        _error = string.Empty;
        try
        {
            await LocalModelService.PullModelAsync(model);
            _pullModelName = string.Empty;
            await CheckConnectionAsync();
        }
        catch (Exception ex)
        {
            _error = $"Could not install model '{model}': {ex.Message}";
        }
        finally
        {
            _modelBusy = false;
        }
    }

    private static string ConversationMeta(SentinelGptConversationView conversation) =>
        conversation.ExchangeCount == 1
            ? conversation.UpdatedAt.ToLocalTime().ToString("t")
            : $"{conversation.ExchangeCount} exchanges · {conversation.UpdatedAt.ToLocalTime():MMM d}";

    private static string FormatDuration(double milliseconds) =>
        milliseconds < 1_000
            ? $"{milliseconds:0} ms"
            : $"{milliseconds / 1_000:0.0} s";

    private static string PerformanceHint(OllamaPerformanceSnapshot performance)
    {
        if (performance.QueueWaitMilliseconds >= 1_000)
            return "The response waited for another local AI workload.";
        if (performance.LoadMilliseconds >= 1_000)
            return "The model was cold-loaded; the next response should start faster.";
        if (performance.PromptMilliseconds >= performance.TotalMilliseconds * .45)
            return "Prompt evaluation was the largest measured cost; shorter context will help.";
        return "The model was ready and generation was the primary measured cost.";
    }

    public ValueTask DisposeAsync()
    {
        _componentLifetime.Cancel();
        _componentLifetime.Dispose();
        return ValueTask.CompletedTask;
    }
}
