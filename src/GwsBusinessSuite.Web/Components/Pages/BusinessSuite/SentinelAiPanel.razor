@implements IAsyncDisposable
@using GwsBusinessSuite.Application.Abstractions
@using GwsBusinessSuite.Application.Wiki
@using GwsBusinessSuite.Domain.Entities
@using GwsBusinessSuite.Web.Services
@inject ISentinelAiService SentinelAiService
@inject SentinelGptGenerationCoordinator GenerationCoordinator
@inject ICurrentUserAccessor CurrentUserAccessor

<div class="sentinel-ai-panel">
    <button type="button" class="sentinel-ai-toggle" @onclick="ToggleAsync">
        <span>✦</span><strong>Ask SentinelGPT</strong><small>Grounded in this workspace</small><i class="bi bi-chevron-down"></i>
    </button>
    @if (_open)
    {
        <div class="sentinel-ai-body">
            <div class="sentinel-ai-actions">
                @foreach (var option in Actions)
                {
                    <button type="button" class="@(_action == option.Action ? "active" : "")" @onclick="() => _action = option.Action">@option.Label</button>
                }
            </div>
            <ProfessionalWysiwygEditor @bind-Value="_instruction" Compact="true" MinHeight="120px"
                                       Placeholder="@InstructionPlaceholder" AriaLabel="SentinelGPT instruction" />
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-warning" @onclick="RunAsync" disabled="@(_running || string.IsNullOrWhiteSpace(_instruction))">
                    @if (_running) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    Generate
                </button>
                @if (_running)
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="StopGeneration">Stop</button>
                }
                <span class="small text-danger">@_error</span>
            </div>
            @if (_running && _liveOutput.Length > 0)
            {
                <div class="sentinel-ai-result sentinel-ai-streaming">
                    <div><span>Generating…</span></div>
                    <pre>@_liveOutput</pre>
                </div>
            }
            else if (_current is not null)
            {
                <div class="sentinel-ai-result">
                    <div><span>Draft · @_current.Model</span><small>Review before inserting</small></div>
                    <pre>@_current.Output</pre>
                    @if (_current.Citations.Count > 0)
                    {
                        <div class="sentinel-ai-citations">
                            <small class="text-secondary">Sources:</small>
                            @foreach (var citation in _current.Citations)
                            {
                                <span class="badge text-bg-light border">
                                    <i class="bi @(citation.IsDatabase ? "bi-grid-3x3-gap-fill" : "bi-file-earmark-text")"></i>
                                    @citation.Title
                                </span>
                            }
                        </div>
                    }
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-primary" @onclick="ApproveAndInsertAsync">Approve &amp; insert</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="RejectAsync">Reject</button>
                    </div>
                </div>
            }
            @if (_runs.Count > 0)
            {
                <details class="sentinel-ai-history">
                    <summary>Recent SentinelGPT runs (@_runs.Count)</summary>
                    @foreach (var run in _runs.Take(8))
                    {
                        <div><span>@run.Action</span><small>@run.Status · @run.CreatedAt.ToLocalTime().ToString("g")</small></div>
                    }
                </details>
            }
        </div>
    }
</div>

@code {
    [Parameter] public Guid? WikiPageId { get; set; }
    [Parameter] public EventCallback<string> OnInsert { get; set; }

    private static readonly IReadOnlyList<(string Action, string Label)> Actions =
    [
        (SentinelAiActions.Ask, "Ask"), (SentinelAiActions.Summarize, "Summarize"),
        (SentinelAiActions.Rewrite, "Rewrite"), (SentinelAiActions.Translate, "Translate"),
        (SentinelAiActions.Research, "Research"), (SentinelAiActions.MeetingNotes, "Meeting notes")
    ];
    // Owns only the polling loop's lifetime, not the generation itself - the coordinator keeps
    // the actual Ollama request running server-side even after this component (and its circuit)
    // is gone, matching the pattern already used by SentinelGpt.razor's chat page.
    private readonly CancellationTokenSource _componentLifetime = new();
    private bool _open;
    private bool _running;
    private bool _stoppingGeneration;
    private string _action = SentinelAiActions.Ask;
    private string _instruction = string.Empty;
    private string _error = string.Empty;
    private string _liveOutput = string.Empty;
    private SentinelAiRunView? _current;
    private List<SentinelAiRunView> _runs = [];
    private Guid? _activeGenerationId;
    private string _username = string.Empty;

    private string InstructionPlaceholder => _action switch
    {
        SentinelAiActions.MeetingNotes => "Paste a transcript or rough meeting notes…",
        SentinelAiActions.Translate => "Paste text and specify the target language…",
        SentinelAiActions.Rewrite => "Paste text and describe the desired tone…",
        SentinelAiActions.Research => "What should SentinelGPT investigate across the workspace?",
        _ => "Ask about this page or the wider workspace…"
    };

    protected override async Task OnInitializedAsync()
    {
        _username = await CurrentUserAccessor.GetCurrentUsernameAsync();

        // Resume an in-flight generation this panel started before a page refresh or a
        // reconnected circuit - the coordinator kept it running the whole time. Scoped to
        // WikiPageId so a generation started on a different page can never be adopted here.
        var active = GenerationCoordinator.GetActive(_username, WikiPageId);
        if (active is { ConversationId: null })
        {
            _open = true;
            _running = true;
            _activeGenerationId = active.Id;
            _action = active.Action ?? _action;
            _instruction = active.Instruction;
            _liveOutput = active.Output;
            _ = InvokeAsync(() => MonitorGenerationAsync(active.Id));
            return;
        }

        // Nothing running for this page right now - but a generation may have finished while
        // this panel wasn't open to see it (navigation, refresh, lost circuit). Surface the
        // most recent still-unreviewed run directly instead of leaving it buried in "Recent
        // runs".
        var recent = await SentinelAiService.ListRunsAsync(WikiPageId, maxResults: 1);
        if (recent.Count > 0 && recent[0].Status == SentinelAiRunStatuses.Completed)
        {
            _current = recent[0];
            _action = recent[0].Action;
            _open = true;
        }
    }

    private async Task ToggleAsync()
    {
        _open = !_open;
        if (_open) _runs = (await SentinelAiService.ListRunsAsync(WikiPageId)).ToList();
    }

    private async Task RunAsync()
    {
        _running = true;
        _error = string.Empty;
        _liveOutput = string.Empty;
        _current = null;

        Guid generationId;
        try
        {
            var generation = await GenerationCoordinator.StartActionAsync(WikiPageId, _action, _instruction, _username);
            generationId = generation.Id;
            _activeGenerationId = generationId;
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
            _running = false;
            return;
        }

        await MonitorGenerationAsync(generationId);
    }

    private async Task MonitorGenerationAsync(Guid generationId)
    {
        try
        {
            while (true)
            {
                _componentLifetime.Token.ThrowIfCancellationRequested();
                var snapshot = GenerationCoordinator.Get(generationId, _username);
                if (snapshot is null)
                {
                    _error = "The active SentinelGPT response is no longer available.";
                    return;
                }

                _liveOutput = snapshot.Output;

                if (snapshot.Status == SentinelGptGenerationStatuses.Failed)
                {
                    _error = snapshot.Error ?? "SentinelGPT generation failed.";
                    return;
                }

                if (snapshot.Status == SentinelGptGenerationStatuses.Cancelled)
                {
                    return;
                }

                if (snapshot.Status == SentinelGptGenerationStatuses.Completed)
                {
                    if (snapshot.CompletedRun is { } completed)
                    {
                        _current = completed;
                        _runs.Insert(0, completed);
                    }
                    return;
                }

                await InvokeAsync(StateHasChanged);
                await Task.Delay(100, _componentLifetime.Token);
            }
        }
        catch (OperationCanceledException) when (_componentLifetime.IsCancellationRequested)
        {
            // The component was disposed (navigation, tab close, lost circuit). The
            // server-owned coordinator intentionally keeps generating.
        }
        finally
        {
            _running = false;
            _liveOutput = string.Empty;
            _activeGenerationId = null;
            if (!_componentLifetime.IsCancellationRequested)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void StopGeneration()
    {
        if (_activeGenerationId is not { } generationId || _stoppingGeneration) return;
        _stoppingGeneration = true;
        GenerationCoordinator.Cancel(generationId, _username);
        _stoppingGeneration = false;
    }

    private async Task ApproveAndInsertAsync()
    {
        if (_current is null) return;
        await SentinelAiService.ReviewAsync(_current.Id, true, _username);
        await OnInsert.InvokeAsync(_current.Output);
        _current = null;
    }

    private async Task RejectAsync()
    {
        if (_current is null) return;
        await SentinelAiService.ReviewAsync(_current.Id, false, _username);
        _current = null;
    }

    public ValueTask DisposeAsync()
    {
        _componentLifetime.Cancel();
        _componentLifetime.Dispose();
        return ValueTask.CompletedTask;
    }
}
