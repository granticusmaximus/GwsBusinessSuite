@page "/admin/billing"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "AdminOnly")]
@using Microsoft.AspNetCore.Authorization
@using GwsBusinessSuite.Application.Billing
@using GwsBusinessSuite.Application.Crm
@using GwsBusinessSuite.Domain.Entities
@inject IBillingService BillingService
@inject ICrmService CrmService
@inject IJSRuntime JS

<PageTitle>Billing</PageTitle>

<div class="page-header">
    <h1><i class="bi bi-receipt me-2 text-primary"></i>Billing</h1>
    <p>Draft invoices locally, then send them through Stripe's hosted invoice page.</p>
</div>

@if (!BillingService.IsStripeConfigured)
{
    <div class="alert alert-warning d-flex align-items-start gap-2 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill mt-1 flex-shrink-0"></i>
        <div>
            Stripe is not configured yet. Drafts can still be composed here, but
            <strong>Send</strong> is disabled until <code>Stripe:SecretKey</code> and
            <code>Stripe:PublishableKey</code> are set in configuration.
        </div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="alert alert-danger d-flex align-items-start gap-2 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill mt-1 flex-shrink-0"></i>
        <div>@ErrorMessage</div>
    </div>
}
@if (!string.IsNullOrWhiteSpace(StatusMessage))
{
    <div class="alert alert-success d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-check-circle-fill flex-shrink-0"></i>
        <div>@StatusMessage</div>
    </div>
}

@if (IsLoading)
{
    <LoadingIndicator Message="Loading billing…" />
}
else
{

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
                <span class="fw-semibold">@(EditingId is null ? "New Draft" : "Edit Draft")</span>
                @if (EditingId is not null)
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ResetEditor">
                        <i class="bi bi-plus-lg me-1"></i>New
                    </button>
                }
            </div>
            <div class="card-body">
                <EditForm Model="Editor" OnValidSubmit="SaveDraftAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Contact</label>
                    <select class="form-select" @bind="Editor.ContactId" @bind:after="OnContactChangedAsync">
                        <option value="@Guid.Empty">Select a contact...</option>
                        @foreach (var contact in Contacts)
                        {
                            <option value="@contact.Id">@contact.FullName</option>
                        }
                    </select>
                </div>

                @if (ContactDeals.Count > 0)
                {
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Related Deal (optional)</label>
                        <select class="form-select" @bind="DealIdInput">
                            <option value="">None</option>
                            @foreach (var deal in ContactDeals)
                            {
                                <option value="@deal.Id">@deal.Title</option>
                            }
                        </select>
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label fw-semibold small">Title</label>
                    <input class="form-control" @bind="Editor.Title" placeholder="e.g. October retainer" />
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-7">
                        <label class="form-label fw-semibold small" for="invoice-due">Due Date (optional)</label>
                        <input id="invoice-due" type="date" class="form-control" @bind="DueDateInput" />
                    </div>
                    <div class="col-5">
                        <label class="form-label fw-semibold small" for="invoice-currency">Currency</label>
                        <select id="invoice-currency" class="form-select" @bind="Editor.Currency">
                            @foreach (var currency in InvoiceCurrencies.All)
                            {
                                <option value="@currency.Code">@currency.Code.ToUpperInvariant() · @currency.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-check mb-3">
                    <input type="checkbox" class="form-check-input" id="invoice-auto-remind" @bind="Editor.AutoRemind" />
                    <label class="form-check-label small" for="invoice-auto-remind">
                        Remind the client automatically if it's overdue (a day after the due date, then weekly, up to @InvoiceReminders.MaxAutomatic times)
                    </label>
                </div>

                <div class="mb-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <label class="form-label fw-semibold small mb-0">Line Items</label>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddLineItem">
                            <i class="bi bi-plus-lg me-1"></i>Add
                        </button>
                    </div>
                    @for (var i = 0; i < Editor.LineItems.Count; i++)
                    {
                        var index = i;
                        var line = Editor.LineItems[index];
                        <div class="row g-2 mb-2 align-items-center">
                            <div class="col-6">
                                <input class="form-control form-control-sm" placeholder="Description" @bind="line.Description" />
                            </div>
                            <div class="col-2">
                                <input type="number" min="1" class="form-control form-control-sm" @bind="line.Quantity" />
                            </div>
                            <div class="col-3">
                                <input type="number" min="0" step="@(InvoiceCurrencies.Find(Editor.Currency)?.Decimals == 0 ? "1" : "0.01")" class="form-control form-control-sm" @bind="line.UnitPriceUsd" aria-label="Unit price in @Editor.Currency.ToUpperInvariant()" />
                            </div>
                            <div class="col-1">
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveLineItem(index)" aria-label="Remove line">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </div>
                        </div>
                    }
                    @if (Editor.LineItems.Count == 0)
                    {
                        <p class="text-secondary small mb-0">No line items yet.</p>
                    }
                    else
                    {
                        <p class="text-end fw-semibold mb-0">
                            Total: @InvoiceCurrencies.Format(Editor.LineItems.Sum(item => item.Quantity * item.UnitPriceUsd), Editor.Currency)
                        </p>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small">Notes</label>
                    <ProfessionalWysiwygEditor @bind-Value="Editor.Notes" Compact="true" MinHeight="100px" AriaLabel="Billing notes" />
                </div>

                <button type="submit" class="btn btn-primary w-100" disabled="@IsBusy">
                    <i class="bi bi-save me-1"></i>Save Draft
                </button>
                </EditForm>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3 fw-semibold">Invoices</div>
            <div class="card-body p-0">
                @if (Invoices.Count == 0)
                {
                    <EmptyState Icon="bi-receipt" Message="No invoices yet." />
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var invoice in Invoices)
                        {
                            <div class="list-group-item" id="invoice-@invoice.Id">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div>
                                        <div class="fw-semibold">
                                            @invoice.Title
                                            <span class="badge @StatusBadgeClass(invoice.Status) ms-1">@invoice.Status</span>
                                            @if (invoice.IsOverdue(DateTimeOffset.UtcNow))
                                            {
                                                <span class="badge text-bg-warning ms-1">Overdue</span>
                                            }
                                        </div>
                                        <div class="d-flex align-items-center gap-2 flex-wrap mt-1">
                                            <RelationshipChip ContactId="invoice.ContactId" ContactName="@invoice.ContactName" />
                                            <span class="text-secondary small">
                                                @invoice.TotalText
                                                @if (invoice.DueDate is not null)
                                                {
                                                    <span> &middot; due @invoice.DueDate.Value.ToLocalTime().ToString("dd-MM-yy")</span>
                                                }
                                                @if (invoice.PaidAt is { } paidAt)
                                                {
                                                    <span> &middot; paid @paidAt.ToLocalTime().ToString("dd-MM-yy")</span>
                                                }
                                                @if (invoice.RemindersSent > 0)
                                                {
                                                    <span> &middot; @invoice.RemindersSent reminder@(invoice.RemindersSent == 1 ? "" : "s"), last @invoice.LastReminderAt?.ToLocalTime().ToString("dd-MM-yy")</span>
                                                }
                                                @if (invoice.AutoRemind && invoice.Status == InvoiceStatuses.Sent)
                                                {
                                                    <span> &middot; auto-remind on</span>
                                                }
                                            </span>
                                        </div>
                                    </div>
                                    <div class="d-flex gap-2 flex-shrink-0">
                                        @if (invoice.Status == InvoiceStatuses.Draft)
                                        {
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => LoadIntoEditorAsync(invoice)" disabled="@IsBusy">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-primary" title="@(BillingService.IsStripeConfigured ? "Send via Stripe" : "Stripe is not configured")"
                                                    disabled="@(IsBusy || !BillingService.IsStripeConfigured)" @onclick="() => SendInvoiceAsync(invoice.Id)">
                                                <i class="bi bi-send me-1"></i>Send
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" disabled="@IsBusy" @onclick="() => DeleteDraftAsync(invoice.Id)">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary" title="Show line items"
                                                    aria-expanded="@(_expandedInvoiceId == invoice.Id ? "true" : "false")"
                                                    @onclick="() => _expandedInvoiceId = _expandedInvoiceId == invoice.Id ? null : invoice.Id">
                                                <i class="bi bi-list-ul"></i>
                                            </button>
                                            @if (!string.IsNullOrWhiteSpace(invoice.StripeHostedInvoiceUrl))
                                            {
                                                <a class="btn btn-sm btn-outline-secondary" href="@invoice.StripeHostedInvoiceUrl" target="_blank" rel="noopener" title="Open the Stripe invoice page">
                                                    <i class="bi bi-box-arrow-up-right me-1"></i>Stripe
                                                </a>
                                            }
                                            @if (invoice.Status == InvoiceStatuses.Sent)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-primary" disabled="@(IsBusy || !BillingService.IsStripeConfigured)"
                                                        title="Email the invoice to the client again" @onclick="() => SendReminderAsync(invoice.Id)">
                                                    <i class="bi bi-bell me-1"></i>Remind
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger" disabled="@IsBusy" @onclick="() => VoidInvoiceAsync(invoice.Id)">
                                                    Void
                                                </button>
                                            }
                                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@IsBusy" title="Copy into a new draft"
                                                    @onclick="() => DuplicateAsync(invoice.Id)">
                                                <i class="bi bi-copy"></i>
                                            </button>
                                        }
                                    </div>
                                </div>
                                @if (_expandedInvoiceId == invoice.Id)
                                {
                                    <table class="table table-sm small mt-2 mb-0">
                                        <thead><tr><th>Item</th><th class="text-end">Qty</th><th class="text-end">Unit</th><th class="text-end">Total</th></tr></thead>
                                        <tbody>
                                            @foreach (var line in invoice.LineItems)
                                            {
                                                <tr>
                                                    <td>@line.Description</td>
                                                    <td class="text-end">@line.Quantity</td>
                                                    <td class="text-end text-nowrap">@InvoiceCurrencies.Format(line.UnitPriceUsd, invoice.Currency)</td>
                                                    <td class="text-end text-nowrap">@InvoiceCurrencies.Format(line.TotalUsd, invoice.Currency)</td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot><tr><th colspan="3" class="text-end">Total</th><th class="text-end text-nowrap">@invoice.TotalText</th></tr></tfoot>
                                    </table>
                                    @if (invoice.SentAt is { } sentAt)
                                    {
                                        <div class="small text-secondary mt-1">Sent @sentAt.ToLocalTime().ToString("dd-MM-yy HH:mm")</div>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

}

<ConfirmModal Show="PendingDeleteDraftId.HasValue" Title="Delete draft invoice" Message="Permanently delete this draft invoice? This cannot be undone."
              ConfirmText="Delete" Busy="IsBusy" OnConfirm="ConfirmDeleteDraftAsync" OnCancel="() => PendingDeleteDraftId = null" />

@code {
    private List<Contact> Contacts { get; set; } = [];
    private IReadOnlyList<InvoiceView> Invoices { get; set; } = [];
    private IReadOnlyList<DealView> ContactDeals { get; set; } = [];
    private InvoiceEditorModel Editor { get; set; } = new();
    private Guid? EditingId { get; set; }
    private bool IsLoading { get; set; } = true;
    private bool IsBusy { get; set; }
    private string ErrorMessage { get; set; } = string.Empty;
    private string StatusMessage { get; set; } = string.Empty;
    private Guid? PendingDeleteDraftId { get; set; }

    private string DealIdInput
    {
        get => Editor.DealId?.ToString() ?? string.Empty;
        set => Editor.DealId = Guid.TryParse(value, out var id) ? id : null;
    }

    private DateTime? DueDateInput
    {
        get => Editor.DueDate?.LocalDateTime.Date;
        set => Editor.DueDate = value is { } date ? new DateTimeOffset(date, TimeSpan.Zero) : null;
    }

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        try
        {
            Contacts = (await CrmService.ListContactsAsync()).ToList();
            await RefreshInvoicesAsync();
        }
        finally
        {
            IsLoading = false;
        }
    }

    // ?invoice={id} (from a contact's history) opens that invoice's line items and scrolls to it.
    [SupplyParameterFromQuery(Name = "invoice")] public Guid? InvoiceQuery { get; set; }
    private Guid? _openedInvoiceQuery;
    private bool _scrollToInvoice;

    protected override void OnParametersSet()
    {
        if (InvoiceQuery is not { } invoiceId || invoiceId == _openedInvoiceQuery) return;
        _openedInvoiceQuery = invoiceId;
        if (Invoices.All(invoice => invoice.Id != invoiceId))
        {
            ErrorMessage = "That invoice wasn't found. It may have been deleted.";
            return;
        }
        _expandedInvoiceId = invoiceId;
        _scrollToInvoice = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_scrollToInvoice || _expandedInvoiceId is not { } invoiceId) return;
        _scrollToInvoice = false;
        await JS.InvokeVoidAsync("gwsScroll.toId", $"invoice-{invoiceId}");
    }

    private async Task RefreshInvoicesAsync()
    {
        Invoices = await BillingService.ListInvoicesAsync();
    }

    private async Task OnContactChangedAsync()
    {
        ContactDeals = Editor.ContactId != Guid.Empty
            ? await CrmService.ListDealsForContactAsync(Editor.ContactId)
            : [];
        Editor.DealId = null;
    }

    private void AddLineItem() => Editor.LineItems.Add(new InvoiceLineItemEditorModel { Quantity = 1 });

    private void RemoveLineItem(int index) => Editor.LineItems.RemoveAt(index);

    private void ResetEditor()
    {
        Editor = new InvoiceEditorModel();
        EditingId = null;
        ContactDeals = [];
        ErrorMessage = string.Empty;
    }

    private async Task LoadIntoEditorAsync(InvoiceView invoice)
    {
        Editor = new InvoiceEditorModel
        {
            Id = invoice.Id,
            ContactId = invoice.ContactId,
            DealId = invoice.DealId,
            Title = invoice.Title,
            DueDate = invoice.DueDate,
            Notes = invoice.Notes,
            Currency = invoice.Currency,
            AutoRemind = invoice.AutoRemind,
            LineItems = invoice.LineItems
                .Select(item => new InvoiceLineItemEditorModel { Id = item.Id, Description = item.Description, Quantity = item.Quantity, UnitPriceUsd = item.UnitPriceUsd })
                .ToList()
        };
        EditingId = invoice.Id;
        ContactDeals = await CrmService.ListDealsForContactAsync(invoice.ContactId);
        ErrorMessage = string.Empty;
    }

    private async Task SaveDraftAsync()
    {
        ErrorMessage = string.Empty;
        StatusMessage = string.Empty;
        if (Editor.ContactId == Guid.Empty)
        {
            ErrorMessage = "Select a contact first.";
            return;
        }

        IsBusy = true;
        try
        {
            await BillingService.SaveDraftAsync(Editor);
            StatusMessage = "Draft saved.";
            ResetEditor();
            await RefreshInvoicesAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task SendInvoiceAsync(Guid invoiceId)
    {
        ErrorMessage = string.Empty;
        StatusMessage = string.Empty;
        IsBusy = true;
        try
        {
            await BillingService.SendInvoiceAsync(invoiceId);
            StatusMessage = "Invoice sent.";
            await RefreshInvoicesAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or Stripe.StripeException)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task VoidInvoiceAsync(Guid invoiceId)
    {
        IsBusy = true;
        try
        {
            await BillingService.VoidInvoiceAsync(invoiceId);
            StatusMessage = "Invoice voided.";
            await RefreshInvoicesAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }

    private Guid? _expandedInvoiceId;

    private async Task DuplicateAsync(Guid invoiceId)
    {
        ErrorMessage = string.Empty;
        StatusMessage = string.Empty;
        IsBusy = true;
        try
        {
            var copy = await BillingService.DuplicateAsync(invoiceId);
            await RefreshInvoicesAsync();
            await LoadIntoEditorAsync(copy);
            StatusMessage = "Copied into a new draft - it's open in the editor.";
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task SendReminderAsync(Guid invoiceId)
    {
        ErrorMessage = string.Empty;
        StatusMessage = string.Empty;
        IsBusy = true;
        try
        {
            await BillingService.SendReminderAsync(invoiceId);
            StatusMessage = "Reminder sent: Stripe emailed the invoice to the client again.";
            await RefreshInvoicesAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or Stripe.StripeException)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }

    private void DeleteDraftAsync(Guid invoiceId) => PendingDeleteDraftId = invoiceId;

    private async Task ConfirmDeleteDraftAsync()
    {
        if (PendingDeleteDraftId is not Guid invoiceId) return;
        PendingDeleteDraftId = null;

        IsBusy = true;
        try
        {
            await BillingService.DeleteDraftAsync(invoiceId);
            StatusMessage = "Draft deleted.";
            await RefreshInvoicesAsync();
        }
        finally
        {
            IsBusy = false;
        }
    }

    private static string StatusBadgeClass(string status) => status switch
    {
        InvoiceStatuses.Draft => "text-bg-secondary",
        InvoiceStatuses.Sent => "text-bg-primary",
        InvoiceStatuses.Paid => "text-bg-success",
        InvoiceStatuses.Void => "text-bg-danger",
        _ => "text-bg-secondary"
    };
}
