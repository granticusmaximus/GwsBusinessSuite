@page "/admin/billing"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "AdminOnly")]
@using Microsoft.AspNetCore.Authorization
@using GwsBusinessSuite.Application.Billing
@using GwsBusinessSuite.Application.Crm
@using GwsBusinessSuite.Domain.Entities
@using GwsBusinessSuite.Application.AdminPortal
@using System.Text.Json
@using System.Globalization
@inject IBillingService BillingService
@inject ICrmService CrmService
@inject IJSRuntime JS
@inject ILogger<Billing> Logger
@inject GwsBusinessSuite.Web.Services.ToastState Toasts

<PageTitle>Billing</PageTitle>

<PageHeader Title="Billing" Icon="bi-receipt" Description="Draft invoices locally, then send them through Stripe's hosted invoice page.">
    <Actions>
        <button type="button" class="btn btn-primary" data-gws-focus="#invoice-contact" @onclick="ResetEditor">
            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>New invoice
        </button>
    </Actions>
</PageHeader>

<RecordInspector Open="InspectedInvoice is not null" Title="@(InspectedInvoice?.Title ?? "Invoice")" Subtitle="@InspectedInvoice?.ContactName"
                 Icon="bi-receipt" OnClose="() => _inspectedInvoiceId = null">
    <Actions>
        @if (InspectedInvoice is { } actionInvoice)
        {
            <a class="btn btn-sm btn-outline-secondary" href="@PdfUrl(actionInvoice.Id)" download>
                <i class="bi bi-file-earmark-pdf me-1" aria-hidden="true"></i>PDF
            </a>
            @if (actionInvoice.Status == InvoiceStatuses.Draft)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@IsBusy" @onclick="() => EditFromInspectorAsync(actionInvoice)">
                    <i class="bi bi-pencil me-1" aria-hidden="true"></i>Edit
                </button>
                <button type="button" class="btn btn-sm btn-outline-primary" title="@(BillingService.IsStripeConfigured ? "Send via Stripe" : "Stripe is not configured")"
                        disabled="@(IsBusy || !BillingService.IsStripeConfigured)" @onclick="() => SendInvoiceAsync(actionInvoice.Id)">
                    <i class="bi bi-send me-1" aria-hidden="true"></i>Send
                </button>
                <button type="button" class="btn btn-sm btn-outline-danger" disabled="@IsBusy" @onclick="() => DeleteDraftAsync(actionInvoice.Id)">
                    <i class="bi bi-trash3 me-1" aria-hidden="true"></i>Delete
                </button>
            }
            else
            {
                @if (!string.IsNullOrWhiteSpace(actionInvoice.StripeHostedInvoiceUrl))
                {
                    <a class="btn btn-sm btn-outline-secondary" href="@actionInvoice.StripeHostedInvoiceUrl" target="_blank" rel="noopener" title="Open the Stripe invoice page">
                        <i class="bi bi-box-arrow-up-right me-1" aria-hidden="true"></i>Stripe
                    </a>
                }
                @if (actionInvoice.Status == InvoiceStatuses.Sent)
                {
                    <button type="button" class="btn btn-sm btn-outline-primary" disabled="@(IsBusy || !BillingService.IsStripeConfigured)"
                            title="Email the invoice to the client again" @onclick="() => SendReminderAsync(actionInvoice.Id)">
                        <i class="bi bi-bell me-1" aria-hidden="true"></i>Remind
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger" disabled="@IsBusy" @onclick="() => VoidInvoiceAsync(actionInvoice.Id)">Void</button>
                }
                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@IsBusy" title="Copy into a new draft" @onclick="() => DuplicateAsync(actionInvoice.Id)">
                    <i class="bi bi-copy me-1" aria-hidden="true"></i>Duplicate
                </button>
            }
        }
    </Actions>
    <ChildContent>
        @if (InspectedInvoice is { } shown)
        {
            <dl class="gws-inspector-facts">
                <dt>Status</dt>
                <dd>
                    <StatusPill Tone="StatusTones.ForInvoice(shown.Status)">@shown.Status</StatusPill>
                    @if (shown.IsOverdue(DateTimeOffset.UtcNow))
                    {
                        <StatusPill Tone="StatusTone.Warning">Overdue</StatusPill>
                    }
                </dd>
                <dt>Client</dt><dd><a href="/admin/crm/contacts/@shown.ContactId">@shown.ContactName</a></dd>
                <dt>Total</dt><dd>@shown.TotalText</dd>
                @if (shown.DueDate is { } due)
                {
                    <dt>Due</dt><dd>@due.ToLocalTime().ToString("dd-MM-yy")</dd>
                }
                @if (shown.SentAt is { } sent)
                {
                    <dt>Sent</dt><dd>@sent.ToLocalTime().ToString("dd-MM-yy HH:mm")</dd>
                }
                @if (shown.PaidAt is { } paid)
                {
                    <dt>Paid</dt><dd>@paid.ToLocalTime().ToString("dd-MM-yy")</dd>
                }
                @if (shown.RemindersSent > 0)
                {
                    <dt>Reminders</dt><dd>@shown.RemindersSent, last @shown.LastReminderAt?.ToLocalTime().ToString("dd-MM-yy")</dd>
                }
                @if (shown.AutoRemind && shown.Status == InvoiceStatuses.Sent)
                {
                    <dt>Auto-remind</dt><dd>On</dd>
                }
                <dt>Created</dt><dd>@shown.CreatedAt.ToLocalTime().ToString("dd-MM-yy")</dd>
            </dl>
            @if (!string.IsNullOrWhiteSpace(shown.Notes))
            {
                <section class="gws-inspector-section" aria-label="Notes">
                    <h3>Notes</h3>
                    <p class="small mb-0 gws-preserve-lines">@shown.Notes</p>
                </section>
            }
            <section class="gws-inspector-section" aria-label="Line items">
                <h3>Line items</h3>
                <table class="table table-sm small mb-0">
                    <thead><tr><th>Item</th><th class="text-end">Qty</th><th class="text-end">Unit</th><th class="text-end">Total</th></tr></thead>
                    <tbody>
                        @foreach (var line in shown.LineItems)
                        {
                            <tr>
                                <td>@line.Description</td>
                                <td class="text-end">@line.Quantity</td>
                                <td class="text-end text-nowrap">@InvoiceCurrencies.Format(line.UnitPriceUsd, shown.Currency)</td>
                                <td class="text-end text-nowrap">@InvoiceCurrencies.Format(line.TotalUsd, shown.Currency)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot><tr><th colspan="3" class="text-end">Total</th><th class="text-end text-nowrap">@shown.TotalText</th></tr></tfoot>
                </table>
            </section>
        }
    </ChildContent>
</RecordInspector>

@if (!BillingService.IsStripeConfigured)
{
    <div class="alert alert-warning d-flex align-items-start gap-2 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill mt-1 flex-shrink-0"></i>
        <div>
            Stripe is not configured yet. Drafts can still be composed here, but
            <strong>Send</strong> is disabled until <code>Stripe:SecretKey</code> and
            <code>Stripe:PublishableKey</code> are set in configuration.
        </div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="alert alert-danger d-flex align-items-start gap-2 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill mt-1 flex-shrink-0"></i>
        <div>@ErrorMessage</div>
    </div>
}
@if (!string.IsNullOrWhiteSpace(StatusMessage))
{
    <div class="alert alert-success d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-check-circle-fill flex-shrink-0"></i>
        <div>@StatusMessage</div>
    </div>
}

@if (IsLoading)
{
    <ListSkeleton Message="Loading billing…" />
}
else
{

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
                <span class="fw-semibold">@(EditingId is null ? "New Draft" : "Edit Draft")</span>
            </div>
            <div class="card-body">
                <EditForm Model="Editor" OnValidSubmit="SaveDraftAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="mb-3">
                    <label class="form-label fw-semibold small" for="invoice-contact">Contact</label>
                    <select id="invoice-contact" class="form-select" @bind="Editor.ContactId" @bind:after="OnContactChangedAsync">
                        <option value="@Guid.Empty">Select a contact...</option>
                        @foreach (var contact in Contacts)
                        {
                            <option value="@contact.Id">@contact.FullName</option>
                        }
                    </select>
                </div>

                @if (ContactDeals.Count > 0)
                {
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Related Deal (optional)</label>
                        <select class="form-select" @bind="DealIdInput">
                            <option value="">None</option>
                            @foreach (var deal in ContactDeals)
                            {
                                <option value="@deal.Id">@deal.Title</option>
                            }
                        </select>
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label fw-semibold small">Title</label>
                    <input class="form-control" @bind="Editor.Title" placeholder="e.g. October retainer" />
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-7">
                        <label class="form-label fw-semibold small" for="invoice-due">Due Date (optional)</label>
                        <input id="invoice-due" type="date" class="form-control" @bind="DueDateInput" />
                    </div>
                    <div class="col-5">
                        <label class="form-label fw-semibold small" for="invoice-currency">Currency</label>
                        <select id="invoice-currency" class="form-select" @bind="Editor.Currency">
                            @foreach (var currency in InvoiceCurrencies.All)
                            {
                                <option value="@currency.Code">@currency.Code.ToUpperInvariant() · @currency.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-check mb-3">
                    <input type="checkbox" class="form-check-input" id="invoice-auto-remind" @bind="Editor.AutoRemind" />
                    <label class="form-check-label small" for="invoice-auto-remind">
                        Remind the client automatically if it's overdue (a day after the due date, then weekly, up to @InvoiceReminders.MaxAutomatic times)
                    </label>
                </div>

                <div class="mb-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <label class="form-label fw-semibold small mb-0">Line Items</label>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddLineItem">
                            <i class="bi bi-plus-lg me-1"></i>Add
                        </button>
                    </div>
                    @for (var i = 0; i < Editor.LineItems.Count; i++)
                    {
                        var index = i;
                        var line = Editor.LineItems[index];
                        <div class="row g-2 mb-2 align-items-center">
                            <div class="col-6">
                                <input class="form-control form-control-sm" placeholder="Description" @bind="line.Description" />
                            </div>
                            <div class="col-2">
                                <input type="number" min="1" class="form-control form-control-sm" @bind="line.Quantity" />
                            </div>
                            <div class="col-3">
                                <input type="number" min="0" step="@(InvoiceCurrencies.Find(Editor.Currency)?.Decimals == 0 ? "1" : "0.01")" class="form-control form-control-sm" @bind="line.UnitPriceUsd" aria-label="Unit price in @Editor.Currency.ToUpperInvariant()" />
                            </div>
                            <div class="col-1">
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveLineItem(index)" aria-label="Remove line">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </div>
                        </div>
                    }
                    @if (Editor.LineItems.Count == 0)
                    {
                        <p class="text-secondary small mb-0">No line items yet.</p>
                    }
                    else
                    {
                        <p class="text-end fw-semibold mb-0">
                            Total: @InvoiceCurrencies.Format(Editor.LineItems.Sum(item => item.Quantity * item.UnitPriceUsd), Editor.Currency)
                        </p>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small">Notes</label>
                    <ProfessionalWysiwygEditor @bind-Value="Editor.Notes" Compact="true" MinHeight="100px" AriaLabel="Billing notes" />
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <button type="submit" class="btn btn-primary flex-grow-1" disabled="@IsBusy">
                        <i class="bi bi-save me-1"></i>Save Draft
                    </button>
                    @* The PDF is drawn from what's saved, so this saves first (tech-forward follow-up, 27-10-26). *@
                    <button type="button" class="btn btn-outline-secondary" disabled="@IsBusy" @onclick="() => SaveAsync(downloadPdf: true)">
                        <i class="bi bi-file-earmark-pdf me-1" aria-hidden="true"></i>Save &amp; download PDF
                    </button>
                </div>
                </EditForm>
            </div>
        </div>

        @* Who invoices are from, printed at the top of every PDF. Open until it's filled in. *@
        <details class="card border-0 shadow-sm mt-4 gws-invoice-issuer" open="@_issuer.IsEmpty">
            <summary class="card-header bg-white border-bottom py-3 fw-semibold">
                Your details on invoices
                @if (_issuer.IsEmpty) { <span class="small text-secondary fw-normal ms-2">Not set: PDFs print without a From block</span> }
            </summary>
            <div class="card-body">
                <div class="mb-2">
                    <label class="form-label fw-semibold small" for="issuer-name">Business name</label>
                    <input id="issuer-name" class="form-control" @bind="_issuerForm.BusinessName" @bind:event="oninput" />
                </div>
                <div class="mb-2">
                    <label class="form-label fw-semibold small" for="issuer-email">Email</label>
                    <input id="issuer-email" type="email" class="form-control" @bind="_issuerForm.Email" />
                </div>
                <div class="mb-2">
                    <label class="form-label fw-semibold small" for="issuer-address">Address</label>
                    <textarea id="issuer-address" class="form-control" rows="3" @bind="_issuerForm.Address"></textarea>
                </div>
                <div class="mb-2">
                    <label class="form-label fw-semibold small" for="issuer-tax">Tax ID (optional)</label>
                    <input id="issuer-tax" class="form-control" @bind="_issuerForm.TaxId" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small" for="issuer-payment">Payment details (optional)</label>
                    <textarea id="issuer-payment" class="form-control" rows="3" placeholder="Bank details or terms, printed under the total" @bind="_issuerForm.PaymentNotes"></textarea>
                </div>
                <button type="button" class="btn btn-outline-primary" disabled="@(IsBusy || string.IsNullOrWhiteSpace(_issuerForm.BusinessName))" @onclick="SaveIssuerAsync">
                    <i class="bi bi-check2 me-1" aria-hidden="true"></i>Save details
                </button>
            </div>
        </details>
    </div>

    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3 fw-semibold">Invoices</div>
            <div class="p-2 border-bottom d-flex gap-2 gws-list-filters">
                <input type="search" class="form-control form-control-sm" placeholder="Search invoice or client..." @bind="InvoiceSearch" @bind:event="oninput" />
                <select class="form-select form-select-sm w-auto" @bind="InvoiceStatusFilter">
                    <option value="">All statuses</option>
                    @foreach (var status in InvoiceStatuses.All) { <option value="@status">@status</option> }
                </select>
            </div>
            <ListViewToolbar ListKey="billing.invoices" FilterJson="@InvoiceFilterJson" Columns="InvoiceColumns"
                             VisibleColumns="_visibleInvoiceColumns" VisibleColumnsChanged="SetInvoiceColumnsAsync"
                             OnApply="ApplyInvoiceViewAsync" />
            <div class="card-body p-0">
                @if (Invoices.Count == 0)
                {
                    <EmptyState Icon="bi-receipt" Title="No invoices yet" Message="Draft one for a contact, then send it through Stripe.">
                        <button type="button" class="btn btn-sm btn-primary mt-2" data-gws-focus="#invoice-contact">
                            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>New invoice
                        </button>
                    </EmptyState>
                }
                else if (VisibleInvoices.Count == 0)
                {
                    <EmptyState Icon="bi-receipt" Message="No invoices match this view." />
                }
                else
                {
                    @if (SelectedShown.Count > 0)
                    {
                        @* Bulk actions for the checked rows (tech-forward T3). Status isn't one: Stripe moves an
                           invoice from Sent to Paid, and voiding or reminding reaches the client, so those stay
                           one invoice at a time. *@
                        <div class="gws-bulk-bar" role="region" aria-label="Actions for the selected invoices">
                            <span class="gws-bulk-count"><strong>@SelectedShown.Count</strong> selected</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@IsBusy" @onclick="() => BulkAutoRemindAsync(true)"><i class="bi bi-bell me-1" aria-hidden="true"></i>Auto-remind on</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@IsBusy" @onclick="() => BulkAutoRemindAsync(false)"><i class="bi bi-bell-slash me-1" aria-hidden="true"></i>Off</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ExportSelectedAsync"><i class="bi bi-download me-1" aria-hidden="true"></i>Export CSV</button>
                            @if (SelectedDrafts.Count > 0)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger" disabled="@IsBusy" @onclick="() => _pendingBulkDelete = SelectedDrafts"><i class="bi bi-trash3 me-1" aria-hidden="true"></i>Delete @SelectedDrafts.Count draft@(SelectedDrafts.Count == 1 ? "" : "s")</button>
                            }
                            <button type="button" class="btn btn-sm btn-link ms-auto" @onclick="_selection.Clear">Clear</button>
                        </div>
                    }
                    <div class="table-responsive gws-list-table-wrap">
                    <table class="table table-hover align-middle mb-0 gws-list-table">
                        <thead><tr>
                            <th class="gws-select-cell"><input type="checkbox" class="form-check-input" aria-label="Select all shown invoices"
                                checked="@_selection.AllSelected(ShownInvoiceIds)" @onchange="e => _selection.SetAll(ShownInvoiceIds, e.Value is true)" /></th>
                            <th>Invoice</th>
                            @if (InvoiceColumnVisible("client")) { <th>Client</th> }
                            @if (InvoiceColumnVisible("total")) { <th class="text-end">Total</th> }
                            @if (InvoiceColumnVisible("due")) { <th>Due</th> }
                            @if (InvoiceColumnVisible("status")) { <th>Status</th> }
                            <th><span class="visually-hidden">Actions</span></th>
                        </tr></thead><tbody>
                        @foreach (var invoice in VisibleInvoices)
                        {
                            <tr class="@(invoice.Id == _inspectedInvoiceId ? "gws-row-selected" : string.Empty) @(_selection.IsSelected(invoice.Id) ? "gws-row-checked" : string.Empty) @StatusTones.Stripe(invoice.IsOverdue(DateTimeOffset.UtcNow) ? StatusTone.Warning : null)" id="invoice-@invoice.Id">
                                <td class="gws-select-cell"><input type="checkbox" class="form-check-input" data-row-select aria-label="Select @invoice.Title"
                                    checked="@_selection.IsSelected(invoice.Id)" @onclick="e => _selection.Toggle(invoice.Id, e.ShiftKey, ShownInvoiceIds)" /></td>
                                <td><button type="button" class="btn btn-link p-0 fw-semibold text-start" title="Open this invoice beside the list" data-preview="invoice:@invoice.Id" aria-pressed="@(invoice.Id == _inspectedInvoiceId ? "true" : "false")" @onclick="() => _inspectedInvoiceId = invoice.Id">@invoice.Title</button>@if (invoice.AutoRemind && invoice.Status is InvoiceStatuses.Draft or InvoiceStatuses.Sent) { <i class="bi bi-bell ms-2 text-secondary" title="Reminds the client automatically when overdue" aria-hidden="true"></i><span class="visually-hidden">(auto-remind on)</span> }@if (invoice.IsOverdue(DateTimeOffset.UtcNow)) { <StatusPill Tone="StatusTone.Warning" CssClass="ms-2">Overdue</StatusPill> }</td>
                                @if (InvoiceColumnVisible("client")) { <td><RelationshipChip ContactId="invoice.ContactId" ContactName="@invoice.ContactName" /></td> }
                                @if (InvoiceColumnVisible("total")) { <td class="gws-num text-end">@invoice.TotalText</td> }
                                @if (InvoiceColumnVisible("due"))
                                {
                                    @* A draft's due date edits in place (tech-forward T3); once sent, Stripe holds it. *@
                                    @if (invoice.Status == InvoiceStatuses.Draft)
                                    {
                                        <td><input type="date" class="form-control form-control-sm gws-inline-date" aria-label="Due date of @invoice.Title" @key="_inlineRevision"
                                                   value="@(invoice.DueDate?.UtcDateTime.ToString("yyyy-MM-dd"))" @onchange="e => SetDueDateAsync(invoice, e.Value as string)" /></td>
                                    }
                                    else
                                    {
                                        <td class="gws-num">@(invoice.DueDate?.ToLocalTime().ToString("dd-MM-yy") ?? "—")</td>
                                    }
                                }
                                @if (InvoiceColumnVisible("status")) { <td><StatusPill Tone="StatusTones.ForInvoice(invoice.Status)">@invoice.Status</StatusPill></td> }
                                <td><div class="d-flex gap-1 justify-content-end">
                                        <a class="btn btn-sm btn-outline-secondary" href="@PdfUrl(invoice.Id)" download title="Download PDF" aria-label="Download @invoice.Title as a PDF"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i></a>
                                        @if (invoice.Status == InvoiceStatuses.Draft)
                                        {
                                            <button class="btn btn-sm btn-outline-secondary" title="Edit" @onclick="() => LoadIntoEditorAsync(invoice)" disabled="@IsBusy"><i class="bi bi-pencil"></i></button>
                                            <button class="btn btn-sm btn-outline-primary" title="@(BillingService.IsStripeConfigured ? "Send via Stripe" : "Stripe is not configured")" disabled="@(IsBusy || !BillingService.IsStripeConfigured)" @onclick="() => SendInvoiceAsync(invoice.Id)"><i class="bi bi-send"></i></button>
                                            <button class="btn btn-sm btn-outline-danger" title="Delete" disabled="@IsBusy" @onclick="() => DeleteDraftAsync(invoice.Id)"><i class="bi bi-trash3"></i></button>
                                        }
                                        else
                                        {
                                            @if (!string.IsNullOrWhiteSpace(invoice.StripeHostedInvoiceUrl))
                                            {
                                                <a class="btn btn-sm btn-outline-secondary" href="@invoice.StripeHostedInvoiceUrl" target="_blank" rel="noopener" title="Open the Stripe invoice page">
                                                    <i class="bi bi-box-arrow-up-right me-1"></i>Stripe
                                                </a>
                                            }
                                            @if (invoice.Status == InvoiceStatuses.Sent)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-primary" disabled="@(IsBusy || !BillingService.IsStripeConfigured)"
                                                        title="Email the invoice to the client again" @onclick="() => SendReminderAsync(invoice.Id)">
                                                    <i class="bi bi-bell me-1"></i>Remind
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger" disabled="@IsBusy" @onclick="() => VoidInvoiceAsync(invoice.Id)">
                                                    Void
                                                </button>
                                            }
                                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@IsBusy" title="Copy into a new draft"
                                                    @onclick="() => DuplicateAsync(invoice.Id)">
                                                <i class="bi bi-copy"></i>
                                            </button>
                                        }
                                </div></td>
                            </tr>
                        }
                    </tbody></table></div>
                }
            </div>
        </div>
    </div>
</div>

}

<ConfirmModal Show="_pendingBulkDelete.Count > 0" Title="Delete draft invoices"
              Message="@($"Permanently delete {_pendingBulkDelete.Count} draft invoice{(_pendingBulkDelete.Count == 1 ? "" : "s")}? This cannot be undone. Other invoices you selected are left alone.")"
              ConfirmText="Delete" Busy="IsBusy" OnConfirm="ConfirmBulkDeleteAsync" OnCancel="() => _pendingBulkDelete = []" />
<ConfirmModal Show="PendingDeleteDraftId.HasValue" Title="Delete draft invoice" Message="Permanently delete this draft invoice? This cannot be undone."
              ConfirmText="Delete" Busy="IsBusy" OnConfirm="ConfirmDeleteDraftAsync" OnCancel="() => PendingDeleteDraftId = null" />

@code {
    private List<Contact> Contacts { get; set; } = [];
    private IReadOnlyList<InvoiceView> Invoices { get; set; } = [];
    private IReadOnlyList<DealView> ContactDeals { get; set; } = [];
    private InvoiceEditorModel Editor { get; set; } = new();
    private Guid? EditingId { get; set; }
    private bool IsLoading { get; set; } = true;
    private bool IsBusy { get; set; }
    private string ErrorMessage { get; set; } = string.Empty;
    private string StatusMessage { get; set; } = string.Empty;
    private Guid? PendingDeleteDraftId { get; set; }
    private string InvoiceSearch { get; set; } = string.Empty;
    private string InvoiceStatusFilter { get; set; } = string.Empty;
    private static readonly IReadOnlyList<ListColumnOption> InvoiceColumns =
    [
        new("invoice", "Invoice", true), new("client", "Client"), new("total", "Total"),
        new("due", "Due"), new("status", "Status")
    ];
    private IReadOnlySet<string> _visibleInvoiceColumns = new HashSet<string>(["invoice", "client", "total", "due", "status"], StringComparer.Ordinal);
    private string InvoiceFilterJson => JsonSerializer.Serialize(new InvoiceViewFilter(InvoiceSearch, InvoiceStatusFilter));
    private readonly ListSelection<Guid> _selection = new();
    private int _inlineRevision;
    private List<InvoiceView> _pendingBulkDelete = [];
    private IReadOnlyList<Guid> ShownInvoiceIds => VisibleInvoices.Select(invoice => invoice.Id).ToList();
    // Bulk actions reach only checked rows that are on show, so a search hiding one can't touch it.
    private List<InvoiceView> SelectedShown => VisibleInvoices.Where(invoice => _selection.IsSelected(invoice.Id)).ToList();
    private List<InvoiceView> SelectedDrafts => SelectedShown.Where(invoice => invoice.Status == InvoiceStatuses.Draft).ToList();
    private IReadOnlyList<InvoiceView> VisibleInvoices => Invoices
        .Where(invoice => string.IsNullOrWhiteSpace(InvoiceStatusFilter) || invoice.Status == InvoiceStatusFilter)
        .Where(invoice => string.IsNullOrWhiteSpace(InvoiceSearch)
            || invoice.Title.Contains(InvoiceSearch, StringComparison.OrdinalIgnoreCase)
            || invoice.ContactName.Contains(InvoiceSearch, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private string DealIdInput
    {
        get => Editor.DealId?.ToString() ?? string.Empty;
        set => Editor.DealId = Guid.TryParse(value, out var id) ? id : null;
    }

    private DateTime? DueDateInput
    {
        get => Editor.DueDate?.LocalDateTime.Date;
        set => Editor.DueDate = value is { } date ? new DateTimeOffset(date, TimeSpan.Zero) : null;
    }

    private BillingIssuer _issuer = BillingIssuer.Empty;
    private readonly IssuerForm _issuerForm = new();

    private sealed class IssuerForm
    {
        public string BusinessName { get; set; } = string.Empty;
        public string? Email { get; set; }
        public string? Address { get; set; }
        public string? TaxId { get; set; }
        public string? PaymentNotes { get; set; }
    }

    private void FillIssuerForm()
    {
        (_issuerForm.BusinessName, _issuerForm.Email, _issuerForm.Address, _issuerForm.TaxId, _issuerForm.PaymentNotes) =
            (_issuer.BusinessName, _issuer.Email, _issuer.Address, _issuer.TaxId, _issuer.PaymentNotes);
    }

    private async Task SaveIssuerAsync()
    {
        IsBusy = true;
        try
        {
            await BillingService.SaveIssuerAsync(new BillingIssuer(_issuerForm.BusinessName, _issuerForm.Email, _issuerForm.Address, _issuerForm.TaxId, _issuerForm.PaymentNotes));
            _issuer = await BillingService.GetIssuerAsync();
            FillIssuerForm();
            Toasts.Show("Saved. Every invoice PDF now shows these details.", tone: StatusTone.Success);
        }
        finally
        {
            IsBusy = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        try
        {
            Contacts = (await CrmService.ListContactsAsync()).ToList();
            _issuer = await BillingService.GetIssuerAsync();
            FillIssuerForm();
            await RefreshInvoicesAsync();
        }
        finally
        {
            IsLoading = false;
        }
    }

    // ?invoice={id} (from a contact's history or inspector) opens that invoice beside the list and scrolls to it.
    [SupplyParameterFromQuery(Name = "invoice")] public Guid? InvoiceQuery { get; set; }
    private Guid? _openedInvoiceQuery;
    private bool _scrollToInvoice;

    protected override void OnParametersSet()
    {
        if (InvoiceQuery is not { } invoiceId || invoiceId == _openedInvoiceQuery) return;
        _openedInvoiceQuery = invoiceId;
        if (Invoices.All(invoice => invoice.Id != invoiceId))
        {
            ErrorMessage = "That invoice wasn't found. It may have been deleted.";
            return;
        }
        _inspectedInvoiceId = invoiceId;
        _scrollToInvoice = true;
    }

    // ⌘K's "New invoice" (tech-forward T1) arrives as ?new=1: a fresh draft with its first field
    // focused, one render after the page's own (FocusOnNavigate moves focus to the h1 first).
    [SupplyParameterFromQuery(Name = "new")] public string? NewQuery { get; set; }
    private bool _newHandled;
    private bool _focusNew;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (NewQuery == "1" && !_newHandled && !IsLoading)
        {
            _newHandled = true;
            _focusNew = true;
            ResetEditor();
            StateHasChanged();
            return;
        }
        if (_focusNew)
        {
            _focusNew = false;
            await JS.InvokeVoidAsync("gwsFocus.field", "#invoice-contact");
        }
        if (!_scrollToInvoice || _inspectedInvoiceId is not { } invoiceId) return;
        _scrollToInvoice = false;
        await JS.InvokeVoidAsync("gwsScroll.toId", $"invoice-{invoiceId}");
    }

    private async Task RefreshInvoicesAsync()
    {
        Invoices = await BillingService.ListInvoicesAsync();
        _selection.Retain(Invoices.Select(invoice => invoice.Id));
    }

    // Inline due date (tech-forward T3): saves at once, Undo puts the old date back, and a refusal
    // (the draft was sent meanwhile) re-draws the list.
    private async Task SetDueDateAsync(InvoiceView invoice, string? value)
    {
        DateTime? due = DateTime.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsed) ? parsed : null;
        var previous = invoice.DueDate?.UtcDateTime.Date;
        if (due == previous) return;
        try
        {
            await BillingService.SetDraftDueDateAsync(invoice.Id, due);
            await RefreshInvoicesAsync();
            Toasts.Show(due is { } date ? $"\"{invoice.Title}\" is due {date:dd-MM-yy}." : $"\"{invoice.Title}\" has no due date.", async () =>
            {
                await BillingService.SetDraftDueDateAsync(invoice.Id, previous);
                await RefreshInvoicesAsync();
                StateHasChanged();
            });
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogWarning(ex, "Changing invoice {InvoiceId}'s due date was refused.", invoice.Id);
            _inlineRevision++;
            await RefreshInvoicesAsync();
            Toasts.Show($"Couldn't change the due date. {ex.Message}", tone: StatusTone.Danger);
        }
    }

    private async Task BulkAutoRemindAsync(bool autoRemind)
    {
        var changed = await BillingService.SetAutoRemindAsync(SelectedShown.Select(invoice => invoice.Id).ToList(), autoRemind);
        await RefreshInvoicesAsync();
        if (changed.Count == 0)
        {
            Toasts.Show(autoRemind ? "Those invoices already remind automatically, or can't (paid or void)." : "None of those invoices were set to remind.");
            return;
        }
        Toasts.Show($"Auto-remind {(autoRemind ? "on" : "off")} for {changed.Count} invoice{(changed.Count == 1 ? "" : "s")}.", async () =>
        {
            await BillingService.SetAutoRemindAsync(changed, !autoRemind);
            await RefreshInvoicesAsync();
            StateHasChanged();
        });
    }

    private async Task ConfirmBulkDeleteAsync()
    {
        var targets = _pendingBulkDelete;
        _pendingBulkDelete = [];
        IsBusy = true;
        try
        {
            foreach (var invoice in targets) await BillingService.DeleteDraftAsync(invoice.Id);
            Toasts.Show($"Deleted {targets.Count} draft{(targets.Count == 1 ? "" : "s")}.");
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogWarning(ex, "A bulk draft delete stopped part way.");
            Toasts.Show($"Some drafts weren't deleted. {ex.Message}", tone: StatusTone.Danger);
        }
        finally
        {
            await RefreshInvoicesAsync();
            IsBusy = false;
        }
    }

    // A file to open in a spreadsheet: ISO dates and plain numbers, not the screen's dd-MM-yy and
    // currency text.
    private async Task ExportSelectedAsync()
    {
        var rows = SelectedShown.Select(invoice => (IReadOnlyList<string?>)[invoice.Title, invoice.ContactName, invoice.Status, invoice.Currency,
            invoice.TotalUsd.ToString("0.00", CultureInfo.InvariantCulture), invoice.DueDate?.ToLocalTime().ToString("yyyy-MM-dd"),
            invoice.SentAt?.ToLocalTime().ToString("yyyy-MM-dd"), invoice.PaidAt?.ToLocalTime().ToString("yyyy-MM-dd"), invoice.AutoRemind ? "Yes" : "No"]);
        var csv = CsvExport.Build(["Invoice", "Client", "Status", "Currency", "Total", "Due", "Sent", "Paid", "Auto-remind"], rows);
        await JS.InvokeVoidAsync("gwsDownload.text", $"invoices-{DateTime.Now:yyyy-MM-dd-HHmm}.csv", csv, "text/csv");
    }

    private bool InvoiceColumnVisible(string key) => _visibleInvoiceColumns.Contains(key);

    private Task SetInvoiceColumnsAsync(IReadOnlySet<string> columns)
    {
        _visibleInvoiceColumns = columns;
        return Task.CompletedTask;
    }

    private Task ApplyInvoiceViewAsync(AdminListViewDefinition view)
    {
        try
        {
            var filter = JsonSerializer.Deserialize<InvoiceViewFilter>(view.FilterJson);
            InvoiceSearch = filter?.Search ?? string.Empty;
            InvoiceStatusFilter = filter is not null && InvoiceStatuses.All.Contains(filter.Status)
                ? filter.Status
                : string.Empty;
        }
        catch (JsonException)
        {
            InvoiceSearch = string.Empty;
            InvoiceStatusFilter = string.Empty;
        }

        var columns = view.Columns.Where(column => InvoiceColumns.Any(option => option.Key == column)).ToHashSet(StringComparer.Ordinal);
        columns.Add("invoice");
        _visibleInvoiceColumns = columns;
        return Task.CompletedTask;
    }

    private sealed record InvoiceViewFilter(string Search, string Status);

    private async Task OnContactChangedAsync()
    {
        ContactDeals = Editor.ContactId != Guid.Empty
            ? await CrmService.ListDealsForContactAsync(Editor.ContactId)
            : [];
        Editor.DealId = null;
    }

    private void AddLineItem() => Editor.LineItems.Add(new InvoiceLineItemEditorModel { Quantity = 1 });

    private void RemoveLineItem(int index) => Editor.LineItems.RemoveAt(index);

    private void ResetEditor()
    {
        Editor = new InvoiceEditorModel();
        EditingId = null;
        ContactDeals = [];
        ErrorMessage = string.Empty;
    }

    private async Task LoadIntoEditorAsync(InvoiceView invoice)
    {
        Editor = new InvoiceEditorModel
        {
            Id = invoice.Id,
            ContactId = invoice.ContactId,
            DealId = invoice.DealId,
            Title = invoice.Title,
            DueDate = invoice.DueDate,
            Notes = invoice.Notes,
            Currency = invoice.Currency,
            AutoRemind = invoice.AutoRemind,
            LineItems = invoice.LineItems
                .Select(item => new InvoiceLineItemEditorModel { Id = item.Id, Description = item.Description, Quantity = item.Quantity, UnitPriceUsd = item.UnitPriceUsd })
                .ToList()
        };
        EditingId = invoice.Id;
        ContactDeals = await CrmService.ListDealsForContactAsync(invoice.ContactId);
        ErrorMessage = string.Empty;
    }

    private Task SaveDraftAsync() => SaveAsync(downloadPdf: false);

    private static string PdfUrl(Guid invoiceId) => $"/admin/billing/invoices/{invoiceId}/pdf";

    private async Task SaveAsync(bool downloadPdf)
    {
        ErrorMessage = string.Empty;
        StatusMessage = string.Empty;
        if (Editor.ContactId == Guid.Empty)
        {
            ErrorMessage = "Select a contact first.";
            return;
        }

        IsBusy = true;
        try
        {
            var saved = await BillingService.SaveDraftAsync(Editor);
            StatusMessage = downloadPdf ? "Draft saved. Its PDF is downloading." : "Draft saved.";
            ResetEditor();
            await RefreshInvoicesAsync();
            if (downloadPdf) await JS.InvokeVoidAsync("gwsDownload.url", PdfUrl(saved.Id));
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task SendInvoiceAsync(Guid invoiceId)
    {
        ErrorMessage = string.Empty;
        StatusMessage = string.Empty;
        IsBusy = true;
        try
        {
            await BillingService.SendInvoiceAsync(invoiceId);
