    // The invoice open in the inspector (shell redesign R3); follows the list as it refreshes.
    private Guid? _inspectedInvoiceId;
    private InvoiceView? InspectedInvoice => _inspectedInvoiceId is { } id ? Invoices.FirstOrDefault(i => i.Id == id) : null;

    // A draft opened for editing goes to the editor form, so the inspector makes way.
    private async Task EditFromInspectorAsync(InvoiceView invoice)
    {
        _inspectedInvoiceId = null;
        await LoadIntoEditorAsync(invoice);
    }

    private async Task DuplicateAsync(Guid invoiceId)
    {
        ErrorMessage = string.Empty;
        StatusMessage = string.Empty;
        IsBusy = true;
        try
        {
            var copy = await BillingService.DuplicateAsync(invoiceId);
            await RefreshInvoicesAsync();
            await LoadIntoEditorAsync(copy);
            StatusMessage = "Copied into a new draft - it's open in the editor.";
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }

