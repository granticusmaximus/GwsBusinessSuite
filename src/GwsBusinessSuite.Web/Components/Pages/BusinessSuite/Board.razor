    // Your filters for this board, kept as a preference so they follow you to any device.
    private sealed record BoardFilters(bool Mine = false, bool Blocked = false, string? Priority = null, string? Label = null, string? Assignee = null, string? Due = null,
        bool SprintOnly = false)
    {
        public static BoardFilters None { get; } = new();
        public bool IsActive => this != None;
        private static readonly System.Text.Json.JsonSerializerOptions Json = new(System.Text.Json.JsonSerializerDefaults.Web);
        public string ToJson() => System.Text.Json.JsonSerializer.Serialize(this, Json);
        public static BoardFilters Parse(string json)
        {
            try { return System.Text.Json.JsonSerializer.Deserialize<BoardFilters>(json, Json) ?? None; }
            catch (System.Text.Json.JsonException) { return None; }
        }
    }

    private static string? Chosen(object? value) => value is string text && text.Length > 0 ? text : null;

    private async Task SetFiltersAsync(BoardFilters filters)
    {
