    private IReadOnlySet<Guid> FaceFieldIds => (Settings.CardFaceFields ?? DefaultFaceFields()).ToHashSet();

    private List<Guid> DefaultFaceFields() => _board is null ? [] : new Guid?[]
    {
        _board.Fields.KeyPropertyId, _board.Fields.PriorityPropertyId, _board.Fields.LabelsPropertyId,
        _board.Fields.DuePropertyId, _board.Fields.AssigneePropertyId, _board.Fields.EstimatePropertyId,
        _board.Fields.SprintPropertyId
    }.Where(id => id is not null).Select(id => id!.Value).ToList();

    private bool ShowFace(Guid? propertyId) => propertyId is { } id && FaceFieldIds.Contains(id);

    private IReadOnlyList<KanbanCardProperty> CustomFaceProperties(KanbanCard card)
    {
        var builtIn = DefaultFaceFields().ToHashSet();
        return (card.Properties ?? []).Where(property => FaceFieldIds.Contains(property.PropertyId) && !builtIn.Contains(property.PropertyId)).ToList();
    }

    private Task SetFaceFieldAsync(Guid propertyId, bool shown)
    {
        var fields = FaceFieldIds.ToList();
        if (shown && !fields.Contains(propertyId)) fields.Add(propertyId);
        if (!shown) fields.Remove(propertyId);
        return SaveSettingsAsync(Settings with { CardFaceFields = fields });
    }

