    // "62.5%" of a ring or a bar, 0 to 100.
    private static string WipFill(int value, int total) =>
        (total <= 0 ? 0 : Math.Clamp(value * 100.0 / total, 0, 100)).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%";

    private sealed record ViewerView(string Name, string Title);

    // Everyone else with this board open, one avatar per person ("you" in another window too).
    private IReadOnlyList<ViewerView> Viewers => Presence.Others(DatabaseId, _presenceSession)
        .GroupBy(viewer => viewer.Username, StringComparer.OrdinalIgnoreCase)
        .Select(group =>
        {
            var me = string.Equals(group.Key, _me, StringComparison.OrdinalIgnoreCase);
            var card = group.Select(viewer => viewer.OpenCardId).OfType<Guid>().Select(CardById).OfType<KanbanCard>().FirstOrDefault();
            var who = me ? "You, in another window" : $"{group.Key} is here";
            return new ViewerView(group.Key, card is null ? who : $"{who}, in {card.Key ?? card.Title}");
        })
        .ToList();

    private KanbanCard? CardById(Guid id) => _columns.SelectMany(column => column.Cards).FirstOrDefault(card => card.RowId == id);

    // Who else has this card open in their drawer, if anyone.
    private string? BusyWith(KanbanCard card) =>
        Presence.Others(DatabaseId, _presenceSession).FirstOrDefault(viewer => viewer.OpenCardId == card.RowId)?.Username;

