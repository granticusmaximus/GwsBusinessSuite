    private async Task ArchiveColumnAsync(ColumnState column)
    {
        _menuKey = null;
        var ids = column.Cards.Select(card => card.RowId).ToList();
        try
        {
            var archived = await BoardService.ArchiveCardsAsync(DatabaseId, ids, _me);
            await RefreshAsync();
            Toasts.Show($"{archived} {(archived == 1 ? "card" : "cards")} archived.", async () =>
            {
                await BoardService.UnarchiveCardsAsync(DatabaseId, ids, _me);
                await RefreshAsync();
                StateHasChanged();
            }, StatusTone.Success);
        }
        catch (InvalidOperationException ex)
        {
            Toasts.Show($"Couldn't archive them. {ex.Message}", tone: StatusTone.Danger);
        }
    }

