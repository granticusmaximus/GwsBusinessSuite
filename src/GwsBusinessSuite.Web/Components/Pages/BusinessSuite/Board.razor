    // Your filters for this board, kept as a preference so they follow you to any device.
    private sealed record BoardFilters(bool Mine = false, bool Blocked = false, string? Priority = null, string? Label = null, string? Assignee = null, string? Due = null,
        bool SprintOnly = false)
    {
        public static BoardFilters None { get; } = new();
        public bool IsActive => this != None;
        private static readonly System.Text.Json.JsonSerializerOptions Json = new(System.Text.Json.JsonSerializerDefaults.Web);
        public string ToJson() => System.Text.Json.JsonSerializer.Serialize(this, Json);
        public static BoardFilters Parse(string json)
        {
            try { return System.Text.Json.JsonSerializer.Deserialize<BoardFilters>(json, Json) ?? None; }
            catch (System.Text.Json.JsonException) { return None; }
        }
    }

    private static string? Chosen(object? value) => value is string text && text.Length > 0 ? text : null;

    private async Task SetFiltersAsync(BoardFilters filters)
    {
        _filters = filters;
        try
        {
            await Preferences.SetAsync(_me, UserPreferenceRules.BoardFilters(DatabaseId), filters.ToJson());
        }
        catch (ArgumentException ex)
        {
            Logger.LogWarning(ex, "Saving board filters failed.");
        }
    }

    private IEnumerable<string> KnownAssignees => _columns.SelectMany(column => column.Cards).SelectMany(card => card.Assignees)
        .Append(_me).Where(person => !string.IsNullOrWhiteSpace(person)).Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase);

    private sealed record LaneInfo(string Key, string Label, string Color);

    // The lanes in order, or null with no swimlanes. Priority and sprint lanes show every option (so
    // an empty lane can take a drop); assignee lanes show who holds cards, you, and Unassigned.
    private IReadOnlyList<LaneInfo>? Lanes => Settings.SwimlaneBy switch
    {
        KanbanSwimlanes.Priority when _board?.Fields.PriorityPropertyId is not null =>
            [.. PriorityOptions.Select(option => new LaneInfo(option.Id, option.Label, option.Color)), new LaneInfo(string.Empty, "No priority", "#78716c")],
        KanbanSwimlanes.Sprint when _board?.Fields.SprintPropertyId is not null =>
            [.. (_board.SprintOptions ?? []).Select(option => new LaneInfo(option.Id, option.Label, option.Color)), new LaneInfo(string.Empty, "No sprint", "#78716c")],
        KanbanSwimlanes.Assignee when _board?.Fields.AssigneePropertyId is not null =>
            [.. KnownAssignees.Select(person => new LaneInfo(person, person, $"hsl({Hue(person)} 55% 45%)")), new LaneInfo(string.Empty, "Unassigned", "#78716c")],
        _ => null
    };

    private string LaneOf(KanbanCard card) => Settings.SwimlaneBy switch
    {
        KanbanSwimlanes.Priority => card.PriorityOptionId ?? string.Empty,
        KanbanSwimlanes.Sprint => card.SprintOptionId ?? string.Empty,
        KanbanSwimlanes.Assignee => card.Assignees.FirstOrDefault() ?? string.Empty,
        _ => string.Empty
    };

    private void ToggleLane(string key)
    {
        if (!_collapsedLanes.Remove(key)) _collapsedLanes.Add(key);
    }

    private static string WipClass(ColumnState column) => column.WipLimit is not { } limit ? string.Empty
        : column.Cards.Count > limit ? "is-over-limit"
        : column.Cards.Count == limit ? "is-at-limit"
        : string.Empty;

    // Whole days a card has sat in an in-progress column; null elsewhere.
    private static int? AgeDays(KanbanCard card, ColumnState column) =>
        column.IsInProgress && card.EnteredColumnAt is { } entered ? (int)Math.Floor((DateTimeOffset.UtcNow - entered).TotalDays) : null;

    // Fades in steps: from half the board's age setting, at it, and at twice it.
    private string AgingClass(KanbanCard card, ColumnState column)
    {
        if (AgeDays(card, column) is not { } days) return string.Empty;
        var limit = Math.Max(1, Settings.AgingDays);
        return days >= limit * 2 ? "is-aging-3" : days >= limit ? "is-aging-2" : days * 2 >= limit ? "is-aging-1" : string.Empty;
    }

    private void ToggleColumnMenu(ColumnState column) => _menuKey = _menuKey == column.Key ? null : column.Key;

    private Task SetWipAsync(ColumnState column, string? value)
    {
        if (column.OptionId is not { } optionId) return Task.CompletedTask;
        var limits = new Dictionary<string, int>(Settings.WipLimits);
        if (int.TryParse(value, out var limit) && limit > 0) limits[optionId] = limit; else limits.Remove(optionId);
        _menuKey = null;
        return SaveSettingsAsync(Settings with { WipLimits = limits });
    }

    private Task SetAgingAsync(ChangeEventArgs e) =>
        int.TryParse(e.Value as string, out var days) ? SaveSettingsAsync(Settings with { AgingDays = days }) : Task.CompletedTask;

    private Task SetSwimlanesAsync(ChangeEventArgs e) => SaveSettingsAsync(Settings with { SwimlaneBy = Chosen(e.Value) });

    private async Task SaveSettingsAsync(KanbanSettings settings)
    {
        try
        {
            await BoardService.SaveSettingsAsync(DatabaseId, settings, await CurrentUserAccessor.GetCurrentUsernameAsync());
            await LoadAsync();
        }
        catch (ArgumentException ex)
        {
            _settingsKey++;
            Toasts.Show($"Couldn't save that. {ex.Message}", tone: StatusTone.Danger);
        }
    }

    // b on a card: blocked or not, with Undo putting the flag and its reason back.
    [JSInvokable]
    public async Task ToggleBlocked(string rowId)
    {
        if (!Guid.TryParse(rowId, out var id) || _columns.SelectMany(column => column.Cards).FirstOrDefault(card => card.RowId == id) is not { } card) return;
        try
        {
            var performedBy = await CurrentUserAccessor.GetCurrentUsernameAsync();
            await BoardService.SetBlockedAsync(DatabaseId, id, !card.Blocked, null, performedBy);
            await RefreshAsync();
            StateHasChanged();
            Toasts.Show($"{card.Key ?? card.Title} {(card.Blocked ? "unblocked" : "marked blocked")}.", async () =>
            {
                await BoardService.SetBlockedAsync(DatabaseId, id, card.Blocked, card.BlockedReason, performedBy);
                await RefreshAsync();
                StateHasChanged();
            });
        }
        catch (InvalidOperationException ex)
        {
            Toasts.Show($"Couldn't change that card. {ex.Message}", tone: StatusTone.Danger);
        }
    }

    // A column's header (both layouts): name, count or WIP against its limit, its menu, and the quick-add box.
    private RenderFragment ColumnHead(ColumnState column, int count) => @<text>
        <header class="kb-column-head">
            <span class="kb-column-dot" aria-hidden="true"></span>
            <h2 class="kb-column-title">@column.Label</h2>
            @if (column.WipLimit is { } limit)
            {
                <span class="kb-wip @WipClass(column)" title="@column.Cards.Count of a limit of @limit in progress" style="--fill: @WipFill(column.Cards.Count, limit)"><span class="kb-wip-ring" aria-hidden="true"></span>@column.Cards.Count / @limit</span>
            }
            else
            {
                <span class="kb-column-count">@count</span>
            }
            @if (RulesFor(column) is { Count: > 0 } rules)
            {
                <button type="button" class="kb-column-rules" title="@(string.Join("\n", rules.Select(rule => rule.Summary)))" aria-label="@column.Label has @rules.Count @(rules.Count == 1 ? "rule" : "rules")"
                        @onclick="() => OpenAutomate(column.Key)"><i class="bi bi-lightning-charge-fill" aria-hidden="true"></i>@rules.Count</button>
            }
            @if (column.OptionId is not null)
            {
                <button type="button" class="kb-column-add kb-column-menu-toggle" title="Column settings" aria-label="@column.Label settings" aria-expanded="@(_menuKey == column.Key ? "true" : "false")"
                        @onclick="() => ToggleColumnMenu(column)"><i class="bi bi-three-dots" aria-hidden="true"></i></button>
            }
        </header>
        @if (_menuKey == column.Key)
        {
            <div class="kb-column-menu">
                <label for="kb-wip-input">WIP limit</label>
                <input id="kb-wip-input" type="number" min="1" max="999" class="form-control form-control-sm" value="@column.WipLimit" placeholder="None"
                       @onchange="e => SetWipAsync(column, e.Value as string)" />
                @if (column.WipLimit is not null)
                {
                    <button type="button" class="btn btn-sm btn-link" @onclick="() => SetWipAsync(column, null)">No limit</button>
                }
                <button type="button" class="kb-column-menu-item" @onclick="() => OpenAutomate(column.Key)">
                    <i class="bi bi-lightning-charge" aria-hidden="true"></i>Add a rule for @column.Label
                </button>
                @if (column.IsComplete && column.Cards.Count > 0)
                {
                    <button type="button" class="kb-column-menu-item" @onclick="() => ArchiveColumnAsync(column)">
                        <i class="bi bi-archive" aria-hidden="true"></i>Archive these @column.Cards.Count @(column.Cards.Count == 1 ? "card" : "cards")
                    </button>
                }
                @if (Lanes is null)
                {
                    <button type="button" class="kb-column-menu-item" @onclick="() => FocusColumn(column.Key)">
                        <i class="bi bi-bullseye" aria-hidden="true"></i>Focus on @column.Label
                    </button>
                }
                @if (_templates.Count > 0)
                {
                    <span class="kb-column-menu-label">New card from a template</span>
                    @foreach (var template in _templates)
                    {
                        <button type="button" class="kb-column-menu-item" @key="template.Id" @onclick="() => NewFromTemplateAsync(template, column)">
                            <span aria-hidden="true">@(string.IsNullOrWhiteSpace(template.Icon) ? "📄" : template.Icon)</span>@template.Name
                        </button>
                    }
                }
            </div>
        }
    </text>;

    // A calm, permanently discoverable composer at the foot of every column.
    private RenderFragment ColumnComposer(ColumnState column) => @<div class="kb-composer">
        @if (_quickAddKey == column.Key)
        {
            <form class="kb-quick-add is-open" @onsubmit="() => AddCardAsync(column)" @onsubmit:preventDefault>
                <label class="visually-hidden" for="kb-quick-add">New card in @column.Label</label>
                <input id="kb-quick-add" class="form-control form-control-sm" placeholder="Card title, then Enter" autocomplete="off" maxlength="300"
                       @ref="_quickAddInput" @bind="_newTitle" @bind:event="oninput" @onkeydown="QuickAddKey" />
                @* One-line cards (K8): what the tokens set, as chips, before Enter. *@
                @if (QuickCard is { Tokens.Count: > 0 } quick)
                {
                    <div class="kb-quick-chips" aria-live="polite">
                        @foreach (var token in quick.Tokens)
                        {
                            <span class="kb-quick-chip" style="--tone: @(token.Color ?? "var(--gws-sidebar-accent)")"><i class="bi @QuickIcon(token.Kind)" aria-hidden="true"></i>@token.Label</span>
                        }
                    </div>
                }
                <span class="kb-quick-add-hint">Enter adds · <code>!high #label @@name fri ~3</code> · Esc closes</span>
