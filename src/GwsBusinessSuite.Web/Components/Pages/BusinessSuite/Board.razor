    // The drawer's Status field: the card moves to the top of the new column, as a drop there would.
    private async Task SetOpenCardStatusAsync(string columnKey)
    {
        if (_openRow is null || _columns.FirstOrDefault(column => column.Key == columnKey) is not { } target) return;
        var first = target.Cards.FirstOrDefault(card => card.RowId != _openRow.Id);
        await MoveCard(_openRow.Id.ToString(), columnKey, first?.RowId.ToString() ?? string.Empty, null);
        await RefreshAsync();
    }

