    // Enter adds and keeps the box open for the next card, at the top of the column.
    private KanbanQuickCard? QuickCard => _board is null || string.IsNullOrWhiteSpace(_newTitle)
        ? null
        : KanbanQuickParse.Parse(_newTitle, _board, DateOnly.FromDateTime(DateTime.Now), _me);

    private static string QuickIcon(string kind) => kind switch
    {
        KanbanQuickTokens.Priority => "bi-reception-3",
        KanbanQuickTokens.Label => "bi-tag",
        KanbanQuickTokens.Person => "bi-person",
        KanbanQuickTokens.Due => "bi-calendar-event",
        _ => "bi-speedometer2"
    };

    private async Task AddCardAsync(ColumnState column)
    {
        var title = _newTitle.Trim();
        if (title.Length == 0) return;
        if (QuickCard is not { } quick || quick.Title.Length == 0)
        {
            Toasts.Show("A card needs a title as well as its !priority, #labels or @people.", tone: StatusTone.Warning);
            return;
        }
        _newTitle = string.Empty;
        try
        {
            var performedBy = await CurrentUserAccessor.GetCurrentUsernameAsync();
            await BoardService.AddQuickCardAsync(DatabaseId, column.OptionId, quick, performedBy);
            await LoadAsync();
            _focusQuickAdd = true;
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            _newTitle = title;
            Toasts.Show($"Couldn't add that card. {ex.Message}", tone: StatusTone.Danger);
        }
    }

