    private string BackgroundKey => KanbanLook.IsImage(Settings.Background) ? KanbanLook.ImageBackground : Settings.Background ?? KanbanLook.NoBackground;

    private string RootClass
    {
        get
        {
            var classes = new List<string> { $"kb-size-{Settings.CardSize}" };
            if (BackgroundKey != KanbanLook.NoBackground) classes.Add($"has-backdrop kb-bg-{BackgroundKey}");
            if (_zoomed) classes.Add("is-zoomed");
            return string.Join(' ', classes);
        }
    }

    // A board's accent recolours everything that uses the app's accent inside it. Both values were
    // checked when they were saved (a #hex colour; an https:// or site path with no quotes, spaces
    // or brackets), so they're safe in a style attribute.
    private string? RootStyle
    {
        get
        {
            var style = string.Empty;
            if (Settings.Accent is { } accent) style += $"--gws-sidebar-accent: {accent}; ";
            if (KanbanLook.IsImage(Settings.Background)) style += $"--kb-image: url({Settings.Background});";
            return style.Length == 0 ? null : style.Trim();
        }
    }

    private async Task SetBackgroundImageAsync(ChangeEventArgs e)
    {
        var url = (e.Value as string)?.Trim() ?? string.Empty;
        if (url.Length == 0)
        {
            if (KanbanLook.IsImage(Settings.Background)) await SaveSettingsAsync(Settings with { Background = null });
            return;
        }
        if (!KanbanLook.IsImage(url))
        {
            Toasts.Show("Use an image address that starts with https://, or one from Media (/media/…).", tone: StatusTone.Warning);
            _settingsKey++;
            return;
        }
        await SaveSettingsAsync(Settings with { Background = url });
    }

