    // ---- Live (K6): a save anywhere else - another window, Sentinel, a rule, a repeating card -
    // reloads the board a moment later and lights up the cards that changed. This circuit's own
    // saves go through its own DbContext and are already on screen, so they're skipped; nothing
    // reloads mid-drag, and the open card's drawer keeps its own state. ----
    private readonly HashSet<Guid> _livePending = [];
    private HashSet<Guid> _liveFlash = [];
    private string? _liveActor;
    private string? _liveNote;
    private CancellationTokenSource? _liveDelay;

    private void OnDatabaseChanged(WikiDatabaseChanged change)
    {
        if (change.WikiDatabaseId != DatabaseId || ReferenceEquals(change.Origin, CircuitDb)) return;
        _ = InvokeAsync(() => QueueLiveReload(change));
    }

    private void QueueLiveReload(WikiDatabaseChanged change)
    {
        if (_openRow?.Id is { } open && change.RowIds.Count > 0 && change.RowIds.All(id => id == open)) return;
        _livePending.UnionWith(change.RowIds);
        // A person's change and the rule it set off arrive together; credit the person.
        if (_liveActor is null || LiveActorName(_liveActor) is "a rule" or "a repeating card") _liveActor = change.Actor;
        _liveDelay?.Cancel();
        _liveDelay = new CancellationTokenSource();
        _ = ApplyLiveAsync(_liveDelay.Token);
    }

    private async Task ApplyLiveAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(400, token);
            while (_handle is not null && await _handle.InvokeAsync<bool>("isDragging", token)) await Task.Delay(500, token);
            if (_handle is not null) await _handle.InvokeVoidAsync("prepareGlide", token);
            await LoadAsync();
            _liveFlash = [.. _livePending];
            _livePending.Clear();
            _liveNote = $"Updated by {LiveActorName(_liveActor)}";
            _liveActor = null;
            StateHasChanged();
            await Task.Delay(2600, token);
            _liveFlash = [];
            _liveNote = null;
            StateHasChanged();
        }
        catch (OperationCanceledException) { }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

