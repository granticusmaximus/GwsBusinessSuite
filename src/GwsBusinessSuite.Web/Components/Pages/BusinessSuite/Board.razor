@page "/admin/boards/{DatabaseId:guid}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "AdminOnly")]
@implements IAsyncDisposable
@using GwsBusinessSuite.Application.Boards
@using System.Text.Json.Nodes
@using GwsBusinessSuite.Application.Wiki
@using GwsBusinessSuite.Domain.Entities
@inject IKanbanBoardService BoardService
@inject IWikiDatabaseService Databases
@inject ICurrentUserAccessor CurrentUserAccessor
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<Board> Logger
@inject GwsBusinessSuite.Web.Services.ToastState Toasts
@inject IUserPreferenceService Preferences
@inject ISentinelDatabaseRuleService RuleService
@inject WikiDatabaseChangeNotifier ChangeNotifier
@inject IAppDbContext CircuitDb
@using GwsBusinessSuite.Application.AdminPortal

<PageTitle>@(_board?.Title ?? "Board")</PageTitle>

@if (_loading)
{
    <ListSkeleton Message="Loading the board…" Grid="true" Rows="4" CssClass="px-0" />
}
else if (_board is null)
{
    <EmptyState Icon="bi-kanban" Title="That board isn't here" Message="It may have been trashed in Sentinel, or it no longer has a Status property to make columns from.">
        <a class="btn btn-sm btn-primary mt-2" href="admin/boards">All boards</a>
    </EmptyState>
}
else
{
    @* data-gws-no-shortcuts: the board has its own keys (kanban-board.js), so app.js's list keys stay off. *@
    <div class="kb" @ref="_root" data-gws-no-shortcuts>
        <header class="kb-header">
            <a class="kb-back" href="admin/boards" title="All boards"><i class="bi bi-arrow-left" aria-hidden="true"></i><span class="visually-hidden">All boards</span></a>
            <span class="kb-icon" aria-hidden="true">@(string.IsNullOrWhiteSpace(_board.Icon) ? "🗂️" : _board.Icon)</span>
            <h1 class="kb-title">@_board.Title</h1>
            <span class="kb-summary">@OpenCount open · @TotalCount @(TotalCount == 1 ? "card" : "cards")</span>
            @* Live (K6): changes saved anywhere else show here within a moment. *@
            <span class="kb-live @(_liveNote is null ? "" : "is-fresh")" title="Live: changes made anywhere else appear here as they happen" role="status">
                <span class="kb-live-dot" aria-hidden="true"></span>@(_liveNote ?? "Live")
            </span>
            <div class="kb-views" role="group" aria-label="View">
                <a class="kb-view @(Insights ? "" : "is-on")" href="admin/boards/@DatabaseId" aria-current="@(Insights ? null : "page")"><i class="bi bi-kanban" aria-hidden="true"></i>Board</a>
                <a class="kb-view @(Insights ? "is-on" : "")" href="admin/boards/@DatabaseId?view=insights" aria-current="@(Insights ? "page" : null)"><i class="bi bi-graph-up" aria-hidden="true"></i>Insights</a>
            </div>
            <div class="kb-tools">
                <label class="visually-hidden" for="kb-filter">Filter cards</label>
                <input id="kb-filter" type="search" class="form-control form-control-sm kb-filter" placeholder="Filter cards" @bind="_filter" @bind:event="oninput" />
                <button type="button" class="btn btn-sm btn-outline-secondary" title="Rules, card templates and repeating cards" @onclick="() => OpenAutomate(null)">
                    <i class="bi bi-magic me-1" aria-hidden="true"></i>Automate
                </button>
                <a class="btn btn-sm btn-outline-secondary" href="admin/sentinel?database=@_board.DatabaseId" title="The same board in Sentinel, with table, calendar and timeline views">
                    <i class="bi bi-journal-bookmark me-1" aria-hidden="true"></i>Sentinel
                </a>
                <button type="button" class="btn btn-sm btn-outline-secondary" title="Board settings" aria-expanded="@(_showSettings ? "true" : "false")"
                        @onclick="() => _showSettings = !_showSettings"><i class="bi bi-sliders" aria-hidden="true"></i><span class="visually-hidden">Board settings</span></button>
                <button type="button" class="btn btn-sm btn-outline-secondary kb-help-toggle" title="Keyboard shortcuts (?)" aria-expanded="@(_showHelp ? "true" : "false")"
                        @onclick="() => _showHelp = !_showHelp"><i class="bi bi-keyboard" aria-hidden="true"></i><span class="visually-hidden">Keyboard shortcuts</span></button>
            </div>
        </header>

        @if (_showHelp)
        {
            <section class="kb-help" aria-label="Board keyboard shortcuts">
                <dl>
                    <dt><kbd>←</kbd> <kbd>→</kbd> <kbd>↑</kbd> <kbd>↓</kbd> or <kbd>h</kbd> <kbd>j</kbd> <kbd>k</kbd> <kbd>l</kbd></dt><dd>Move between cards</dd>
                    <dt><kbd>Enter</kbd></dt><dd>Open the card</dd>
                    <dt><kbd>e</kbd></dt><dd>Open it and rename</dd>
                    <dt><kbd>c</kbd></dt><dd>New card in this column</dd>
                    <dt><kbd>[</kbd> <kbd>]</kbd></dt><dd>Move the card a column left or right</dd>
                    <dt><kbd>Alt</kbd> + <kbd>↑</kbd> <kbd>↓</kbd></dt><dd>Move it up or down</dd>
                    <dt><kbd>1</kbd>–<kbd>4</kbd>, <kbd>0</kbd></dt><dd>Priority: urgent, high, medium, low; none</dd>
                    <dt><kbd>b</kbd></dt><dd>Mark blocked, or unblocked</dd>
                    <dt><kbd>x</kbd>, <kbd>⇧</kbd>/<kbd>⌘</kbd>-click</dt><dd>Select cards (⇧ selects a range)</dd>
                    <dt><kbd>Esc</kbd></dt><dd>Clear the selection</dd>
                    <dt><kbd>?</kbd></dt><dd>Show or hide this list</dd>
                </dl>
            </section>
        }

        @if (_board.Fields.SprintPropertyId is not null)
        {
            <KanbanSprintBar Board="_board" Sprints="_sprints" OnChanged="RefreshAsync" />
        }

        @if (_showSettings)
        {
            <section class="kb-settings" aria-label="Board settings">
                <label for="kb-aging">Show a card's age after</label>
                <input id="kb-aging" type="number" min="1" max="365" class="form-control form-control-sm" value="@Settings.AgingDays" @key="@($"aging-{_settingsKey}")"
                       @onchange="SetAgingAsync" />
                <span>days in an in-progress column</span>
                @if (_board.Fields.SprintPropertyId is null)
                {
                    <button type="button" class="btn btn-sm btn-outline-primary ms-auto" @onclick="UseSprintsAsync"><i class="bi bi-lightning-charge me-1" aria-hidden="true"></i>Use sprints</button>
                }
            </section>
        }

        @if (Insights)
        {
            <KanbanInsightsView DatabaseId="DatabaseId" OnOpenCard="OpenRow" />
        }
        else
        {
        @* Filters (K3) are yours alone, remembered per board; swimlanes belong to the board. *@
        <div class="kb-filters" role="group" aria-label="Filter the board">
            <button type="button" class="kb-chip @(_filters.Mine ? "is-on" : "")" aria-pressed="@(_filters.Mine ? "true" : "false")"
                    @onclick="() => SetFiltersAsync(_filters with { Mine = !_filters.Mine })"><i class="bi bi-person" aria-hidden="true"></i>My cards</button>
            @if (ActiveSprint is { } running)
            {
                <button type="button" class="kb-chip @(_filters.SprintOnly ? "is-on" : "")" aria-pressed="@(_filters.SprintOnly ? "true" : "false")"
                        @onclick="() => SetFiltersAsync(_filters with { SprintOnly = !_filters.SprintOnly })"><i class="bi bi-lightning-charge" aria-hidden="true"></i>@running.Name</button>
            }
            <button type="button" class="kb-chip @(_filters.Blocked ? "is-on" : "")" aria-pressed="@(_filters.Blocked ? "true" : "false")"
                    @onclick="() => SetFiltersAsync(_filters with { Blocked = !_filters.Blocked })"><i class="bi bi-slash-circle" aria-hidden="true"></i>Blocked</button>
            @if (PriorityOptions.Count > 0)
            {
                <select class="form-select form-select-sm kb-filter-select @(_filters.Priority is null ? "" : "is-on")" aria-label="Filter by priority" value="@(_filters.Priority ?? "")"
                        @onchange="e => SetFiltersAsync(_filters with { Priority = Chosen(e.Value) })">
                    <option value="">Any priority</option>
                    @foreach (var option in PriorityOptions) { <option value="@option.Id">@option.Label</option> }
                    <option value="none">No priority</option>
                </select>
            }
            @if (LabelOptions.Count > 0)
            {
                <select class="form-select form-select-sm kb-filter-select @(_filters.Label is null ? "" : "is-on")" aria-label="Filter by label" value="@(_filters.Label ?? "")"
                        @onchange="e => SetFiltersAsync(_filters with { Label = Chosen(e.Value) })">
                    <option value="">Any label</option>
                    @foreach (var option in LabelOptions) { <option value="@option.Label">@option.Label</option> }
                </select>
            }
            @if (_board.Fields.AssigneePropertyId is not null)
            {
                <select class="form-select form-select-sm kb-filter-select @(_filters.Assignee is null ? "" : "is-on")" aria-label="Filter by assignee" value="@(_filters.Assignee ?? "")"
                        @onchange="e => SetFiltersAsync(_filters with { Assignee = Chosen(e.Value) })">
                    <option value="">Anyone</option>
                    @foreach (var person in KnownAssignees) { <option value="@person">@person</option> }
                    <option value="none">Unassigned</option>
                </select>
            }
            @if (_board.Fields.DuePropertyId is not null)
            {
                <select class="form-select form-select-sm kb-filter-select @(_filters.Due is null ? "" : "is-on")" aria-label="Filter by due date" value="@(_filters.Due ?? "")"
                        @onchange="e => SetFiltersAsync(_filters with { Due = Chosen(e.Value) })">
                    <option value="">Any due date</option>
                    <option value="overdue">Overdue</option>
                    <option value="week">Due within 7 days</option>
                    <option value="none">No due date</option>
                </select>
            }
            @if (_filters.IsActive)
            {
                <button type="button" class="btn btn-sm btn-link" @onclick="() => SetFiltersAsync(BoardFilters.None)">Clear filters</button>
            }
            <span class="kb-filters-lanes">
                <label for="kb-lanes">Swimlanes</label>
                <select id="kb-lanes" class="form-select form-select-sm kb-filter-select" value="@(Settings.SwimlaneBy ?? "")" @key="@($"lanes-{_settingsKey}")" @onchange="SetSwimlanesAsync">
                    <option value="">None</option>
                    @if (_board.Fields.PriorityPropertyId is not null) { <option value="@KanbanSwimlanes.Priority">Priority</option> }
                    @if (_board.Fields.AssigneePropertyId is not null) { <option value="@KanbanSwimlanes.Assignee">Assignee</option> }
                    @if (_board.Fields.SprintPropertyId is not null) { <option value="@KanbanSwimlanes.Sprint">Sprint</option> }
                </select>
            </span>
        </div>

        @if (SelectedCards.Count > 0)
        {
            <div class="kb-bulk" role="region" aria-label="Actions for the selected cards">
                <span class="kb-bulk-count"><strong>@SelectedCards.Count</strong> selected</span>
                <select class="form-select form-select-sm w-auto" aria-label="Move the selected cards to a column" @key="@($"move-{_bulkKey}")" @onchange="BulkMoveAsync">
                    <option value="">Move to…</option>
                    @foreach (var column in _columns.Where(column => column.OptionId is not null)) { <option value="@column.Key">@column.Label</option> }
                </select>
                @if (PriorityOptions.Count > 0)
                {
                    <select class="form-select form-select-sm w-auto" aria-label="Set the selected cards' priority" @key="@($"priority-{_bulkKey}")" @onchange="BulkPriorityAsync">
                        <option value="">Priority…</option>
                        @foreach (var option in PriorityOptions) { <option value="@option.Id">@option.Label</option> }
                        <option value="none">None</option>
                    </select>
                }
                @if (LabelOptions.Count > 0)
                {
                    <select class="form-select form-select-sm w-auto" aria-label="Add a label to the selected cards" @key="@($"label-{_bulkKey}")" @onchange="BulkLabelAsync">
                        <option value="">Add label…</option>
                        @foreach (var option in LabelOptions) { <option value="@option.Id">@option.Label</option> }
                    </select>
                }
                @if (_board.Fields.AssigneePropertyId is not null)
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="BulkAssignMeAsync"><i class="bi bi-person-check me-1" aria-hidden="true"></i>Assign to me</button>
                }
                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="BulkTrashAsync"><i class="bi bi-trash3 me-1" aria-hidden="true"></i>Trash</button>
                <button type="button" class="btn btn-sm btn-link ms-auto" @onclick="() => ClearSelection()">Clear</button>
            </div>
        }

        @if (Lanes is { } lanes)
        {
            @* Swimlanes (K3): one row per lane across every column; a card dropped in another lane takes
               that lane's priority, assignee or sprint. *@
            <div class="kb-board-lanes" data-kb-scroller>
                <div class="kb-lane-heads">
                    @foreach (var column in _columns)
                    {
                        <div class="kb-lane-head @WipClass(column)" @key="column.Key" style="--column-color: @column.Color">@ColumnHead(column, Visible(column).Count)</div>
                    }
                </div>
                @foreach (var lane in lanes)
                {
                    var collapsed = _collapsedLanes.Contains(lane.Key);
                    var laneCount = _columns.Sum(column => Visible(column).Count(card => LaneOf(card) == lane.Key));
                    <section class="kb-lane @(collapsed ? "is-collapsed" : "")" @key="@($"lane-{lane.Key}")" aria-label="@lane.Label, @laneCount @(laneCount == 1 ? "card" : "cards")">
                        <button type="button" class="kb-lane-title" aria-expanded="@(collapsed ? "false" : "true")" @onclick="() => ToggleLane(lane.Key)">
                            <i class="bi bi-chevron-down" aria-hidden="true"></i>
                            <span class="kb-lane-dot" style="--tone: @lane.Color" aria-hidden="true"></span>@lane.Label
                            <span class="kb-column-count">@laneCount</span>
                        </button>
                        @if (!collapsed)
                        {
                            <div class="kb-lane-row">
                                @foreach (var column in _columns)
                                {
                                    <div class="kb-cell" @key="column.Key" data-kb-column="@column.Key" data-kb-lane="@lane.Key" style="--column-color: @column.Color"
                                         aria-label="@column.Label, @lane.Label">
                                        <ol class="kb-cards" data-kb-cards>
                                            @foreach (var card in Visible(column).Where(card => LaneOf(card) == lane.Key))
                                            {
                                                @CardView(card, column)
                                            }
                                        </ol>
                                    </div>
                                }
                            </div>
                        }
                    </section>
                }
            </div>
        }
        else
        {
            <div class="kb-columns" data-kb-scroller>
                @foreach (var column in _columns)
                {
                    var cards = Visible(column);
                    <section class="kb-column @WipClass(column)" @key="column.Key" data-kb-column="@column.Key" style="--column-color: @column.Color" aria-label="@column.Label, @cards.Count @(cards.Count == 1 ? "card" : "cards")">
                        @ColumnHead(column, cards.Count)
                        @if (cards.Count == 0 && _quickAddKey != column.Key)
                        {
                            <button type="button" class="kb-empty" @onclick="() => OpenQuickAdd(column)">
                                @(_filters.IsActive || !string.IsNullOrWhiteSpace(_filter) ? "No cards match" : "Drop a card here, or add one")
                            </button>
                        }
                        <ol class="kb-cards" data-kb-cards>
                            @foreach (var card in cards)
                            {
                                @CardView(card, column)
                            }
                        </ol>
                    </section>
                }
            </div>
        }
        }
    </div>

    @if (_openRow is not null && _database is not null)
    {
        @* The card drawer (K2): Sentinel's own page panel - the card's page, history, autosave - with
           the board's fields on top. Its saves keep property values (KeepPropertyValues), so a field
           changed here is never reverted by the page's autosave. *@
        <SentinelDatabaseRowPage @key="_openRow.Id" Database="_database" Row="_openRow" OpenMode="@WikiDatabaseOpenPageModes.SidePeek"
                                 OnSaved="RefreshAsync" OnClose="CloseCard" OnOpenPage="OpenSentinelPage">
            <FieldsContent>
                <KanbanCardFields Board="_board" Database="_database" Row="_openRow" OnChanged="RefreshAsync"
                                  OnStatusChanged="SetOpenCardStatusAsync" OnOpenSubItem="OpenRow" />
            </FieldsContent>
        </SentinelDatabaseRowPage>
    }

    @if (_automate is { } automate)
    {
        <KanbanAutomations Board="_board" Rules="_rules" Templates="_templates" Column="@automate.Column" ShowTemplates="automate.Templates"
                           OnChanged="RefreshAsync" OnClose="CloseAutomate" />
    }
}

@code {
    [Parameter] public Guid DatabaseId { get; set; }
    // ?card={rowId}: the card open in the drawer, so a card has a link of its own.
    [SupplyParameterFromQuery(Name = "card")] public Guid? CardQuery { get; set; }
    // ?view=insights: the board's flow charts (K5) instead of its columns.
    [SupplyParameterFromQuery(Name = "view")] public string? ViewQuery { get; set; }
    private bool Insights => ViewQuery == "insights";

    private WikiDatabase? _database;
    private WikiDatabaseRow? _openRow;
    private Guid _loadedDatabase;
    private bool _focusTitle;
    private bool _showHelp;
    private bool _showSettings;
    private int _settingsKey;
    private string? _menuKey;
    private string _me = string.Empty;
    private BoardFilters _filters = BoardFilters.None;
    private readonly HashSet<string> _collapsedLanes = [];
    private int _bulkKey;
    private readonly ListSelection<Guid> _selection = new();

    private KanbanBoard? _board;
    private List<ColumnState> _columns = [];
    private bool _loading = true;
    private string _filter = string.Empty;
    private string? _quickAddKey;
    private string _newTitle = string.Empty;
    private bool _focusQuickAdd;
    private ElementReference _root;
    private ElementReference _quickAddInput;
    private IJSObjectReference? _module;
    private IJSObjectReference? _handle;
    private DotNetObjectReference<Board>? _self;

    // The board as shown: columns hold their cards in order, and a move changes this at once,
    // before the save (the save's failure reloads the board).
    private sealed class ColumnState(KanbanColumn column)
    {
        public string? OptionId { get; } = column.OptionId;
        public string Key { get; } = column.OptionId ?? string.Empty;
        public string Label { get; } = column.Label;
        public string Color { get; } = column.Color;
        public bool IsComplete { get; } = column.Group == WikiDatabaseStatusGroups.Complete;
        public bool IsInProgress { get; } = column.Group == WikiDatabaseStatusGroups.InProgress;
        public int? WipLimit { get; } = column.WipLimit;
        public List<KanbanCard> Cards { get; } = column.Cards.ToList();
    }

    private int TotalCount => _columns.Sum(column => column.Cards.Count);
    private int OpenCount => _columns.Where(column => !column.IsComplete).Sum(column => column.Cards.Count);

    protected override void OnInitialized() => ChangeNotifier.Changed += OnDatabaseChanged;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedDatabase != DatabaseId)
        {
            _loadedDatabase = DatabaseId;
            _selection.Clear();
            _me = await CurrentUserAccessor.GetCurrentUsernameAsync();
            _filters = BoardFilters.Parse(await Preferences.GetAsync(_me, UserPreferenceRules.BoardFilters(DatabaseId)));
            await LoadAsync();
        }
        await SyncDrawerAsync();
    }

    private async Task SyncDrawerAsync()
    {
        if (CardQuery is not { } id || _board is null)
        {
            _openRow = null;
            return;
        }
        if (_openRow?.Id == id) return;
        _database = await Databases.GetDatabaseAsync(DatabaseId);
        _openRow = _database?.Rows.FirstOrDefault(row => row.Id == id);
    }

    // After a change anywhere: the board, and the open card's fresh row.
    private async Task RefreshAsync()
    {
        await LoadAsync();
        if (_openRow is not null)
        {
            _database = await Databases.GetDatabaseAsync(DatabaseId);
            _openRow = _database?.Rows.FirstOrDefault(row => row.Id == _openRow.Id);
            if (_openRow is null) CloseCard();
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            _board = await BoardService.GetBoardAsync(DatabaseId);
            _columns = _board?.Columns.Select(column => new ColumnState(column)).ToList() ?? [];
            _sprints = _board?.Fields.SprintPropertyId is not null ? await BoardService.ListSprintsAsync(DatabaseId) : [];
            _rules = _board is not null ? await RuleService.ListAsync(DatabaseId) : [];
            _templates = _board is not null ? await Databases.ListRowTemplatesAsync(DatabaseId) : [];
            _selection.Retain(_columns.SelectMany(column => column.Cards).Select(card => card.RowId));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Loading board {DatabaseId} failed.", DatabaseId);
            _board = null;
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_board is not null && _handle is null)
        {
            _self ??= DotNetObjectReference.Create(this);
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/kanban-board.js");
            _handle = await _module.InvokeAsync<IJSObjectReference>("init", _root, _self);
        }
        if (_focusQuickAdd)
        {
            _focusQuickAdd = false;
            await _quickAddInput.FocusAsync();
        }
        if (_focusTitle && _openRow is not null)
        {
            _focusTitle = false;
            await JS.InvokeVoidAsync("gwsFocus.field", "#kb-card-title");
        }
    }

    private IReadOnlyList<KanbanCard> Visible(ColumnState column)
    {
        var filter = _filter.Trim();
        if (filter.Length == 0 && !_filters.IsActive) return column.Cards;
        var today = DateOnly.FromDateTime(DateTime.Today);
        return column.Cards.Where(card =>
            (filter.Length == 0
                || card.Title.Contains(filter, StringComparison.CurrentCultureIgnoreCase)
                || card.Key?.Contains(filter, StringComparison.OrdinalIgnoreCase) == true
                || card.Labels.Any(label => label.Label.Contains(filter, StringComparison.CurrentCultureIgnoreCase))
                || card.Assignees.Any(person => person.Contains(filter, StringComparison.CurrentCultureIgnoreCase)))
            && (!_filters.Mine || card.Assignees.Contains(_me, StringComparer.OrdinalIgnoreCase))
            && (!_filters.Blocked || card.Blocked)
            && (!_filters.SprintOnly || ActiveSprint is not { } sprint || card.SprintOptionId == sprint.OptionId)
            && (_filters.Priority is null || (_filters.Priority == "none" ? card.PriorityOptionId is null : card.PriorityOptionId == _filters.Priority))
            && (_filters.Label is null || card.Labels.Any(label => label.Label == _filters.Label))
            && (_filters.Assignee is null || (_filters.Assignee == "none" ? card.Assignees.Count == 0 : card.Assignees.Contains(_filters.Assignee, StringComparer.OrdinalIgnoreCase)))
            && (_filters.Due switch
            {
                "overdue" => !column.IsComplete && card.Due is { } due && AsWritten(due) < today,
                "week" => card.Due is { } due && AsWritten(due) >= today && AsWritten(due).DayNumber - today.DayNumber <= 7,
                "none" => card.Due is null,
                _ => true
            })).ToList();
    }

    // ---- Filters, swimlanes, WIP and age (K3) ----

    private KanbanSettings Settings => _board?.Settings ?? KanbanSettings.Default;

    // Sprints (K4), loaded with the board when it has a Sprint property.
    private IReadOnlyList<KanbanSprintView> _sprints = [];

    // ---- Automate (K6): rules per column, card templates, repeats ----
    private sealed record AutomateState(string? Column, bool Templates);
    private AutomateState? _automate;
    private IReadOnlyList<SentinelDatabaseRuleView> _rules = [];
    private IReadOnlyList<WikiDatabaseRowTemplate> _templates = [];

    // The rules that run when a card enters this column.
    private IReadOnlyList<SentinelDatabaseRuleView> RulesFor(ColumnState column) => column.OptionId is null ? [] : _rules
        .Where(rule => rule.WhenPropertyId == _board?.Fields.StatusPropertyId && rule.WhenValue == column.OptionId)
        .ToList();

    private void OpenAutomate(string? column)
    {
        _menuKey = null;
        _automate = new AutomateState(column, false);
    }

    private void CloseAutomate() => _automate = null;

    private async Task NewFromTemplateAsync(WikiDatabaseRowTemplate template, ColumnState column)
    {
        _menuKey = null;
        try
        {
            var rowId = await BoardService.AddCardFromTemplateAsync(DatabaseId, template.Id, column.OptionId, _me);
            await LoadAsync();
            OpenRow(rowId);
        }
        catch (Exception ex) when (ex is InvalidOperationException or KeyNotFoundException or ArgumentException)
        {
            Toasts.Show($"Couldn't make the card. {ex.Message}", tone: StatusTone.Danger);
        }
    }

    // ---- Live (K6): a save anywhere else - another window, Sentinel, a rule, a repeating card -
    // reloads the board a moment later and lights up the cards that changed. This circuit's own
    // saves go through its own DbContext and are already on screen, so they're skipped; nothing
    // reloads mid-drag, and the open card's drawer keeps its own state. ----
    private readonly HashSet<Guid> _livePending = [];
    private HashSet<Guid> _liveFlash = [];
    private string? _liveActor;
    private string? _liveNote;
    private CancellationTokenSource? _liveDelay;

    private void OnDatabaseChanged(WikiDatabaseChanged change)
    {
        if (change.WikiDatabaseId != DatabaseId || ReferenceEquals(change.Origin, CircuitDb)) return;
        _ = InvokeAsync(() => QueueLiveReload(change));
    }

    private void QueueLiveReload(WikiDatabaseChanged change)
    {
        if (_openRow?.Id is { } open && change.RowIds.Count > 0 && change.RowIds.All(id => id == open)) return;
        _livePending.UnionWith(change.RowIds);
        // A person's change and the rule it set off arrive together; credit the person.
        if (_liveActor is null || LiveActorName(_liveActor) is "a rule" or "a repeating card") _liveActor = change.Actor;
        _liveDelay?.Cancel();
        _liveDelay = new CancellationTokenSource();
        _ = ApplyLiveAsync(_liveDelay.Token);
    }

    private async Task ApplyLiveAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(400, token);
            while (_handle is not null && await _handle.InvokeAsync<bool>("isDragging", token)) await Task.Delay(500, token);
            await LoadAsync();
            _liveFlash = [.. _livePending];
            _livePending.Clear();
            _liveNote = $"Updated by {LiveActorName(_liveActor)}";
            _liveActor = null;
            StateHasChanged();
            await Task.Delay(2600, token);
            _liveFlash = [];
            _liveNote = null;
            StateHasChanged();
        }
        catch (OperationCanceledException) { }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    private string LiveActorName(string? actor) => actor switch
    {
        null or "" or "someone" => "someone",
        "automation-engine" or "automation-engine:chained" => "a rule",
        "recurrence-scheduler" => "a repeating card",
        _ when string.Equals(actor, _me, StringComparison.OrdinalIgnoreCase) => "you, elsewhere",
        _ => actor
    };
