                    <span class="kb-blocked" title="@(string.IsNullOrWhiteSpace(card.BlockedReason) ? "Blocked" : $"Blocked: {card.BlockedReason}")"><i class="bi bi-slash-circle" aria-hidden="true"></i>Blocked</span>
