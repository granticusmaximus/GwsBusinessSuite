    // 1-4 pick the priority options in order (Urgent, High, Medium, Low); 0 clears it.
    [JSInvokable]
    public async Task SetPriorityByNumber(string rowId, int number)
    {
        if (!Guid.TryParse(rowId, out var id) || _board?.Fields.PriorityPropertyId is not { } priorityId) return;
        var option = number == 0 ? null : PriorityOptions.ElementAtOrDefault(number - 1);
        if (number != 0 && option is null) return;
        await ApplyAsync([id], priorityId, _ => option is null ? null : JsonValue.Create(option.Id), $"{option?.Label ?? "no"} priority");
