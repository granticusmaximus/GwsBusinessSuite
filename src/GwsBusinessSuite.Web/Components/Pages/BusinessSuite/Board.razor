    private string ArchiveSummary => (_board?.ArchivedCount ?? 0) is var count && (_board?.Settings?.ArchiveAfterDays ?? KanbanArchive.DefaultDays) is var days
        ? $"{count} archived · {(days == 0 ? "auto-archive off" : $"after {days} days done")}"
        : string.Empty;

