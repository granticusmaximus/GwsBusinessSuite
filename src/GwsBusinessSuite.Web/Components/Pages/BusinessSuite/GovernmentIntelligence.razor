                    <p class="panel-note"><i class="bi bi-clock-history"></i> Committee schedule from Congress.gov refreshes hourly. "Watch" links to whatever video source the committee has published (its own site, YouTube, or the Senate's ISVP player) - it can appear before a meeting starts and may show it live, but isn't guaranteed for every meeting.</p>
                </section>

                <div class="chamber-grid">
                    <section class="civic-panel">
                        <CivicWatchPanelHeader Eyebrow="U.S. Senate" Title="Recent news" Count="@_snapshot.Federal.SenateNews.Count" Icon="bi-newspaper" />
                        <CivicWatchFederalNews Items="_snapshot.Federal.SenateNews" Chamber="Senate" />
                    </section>
                    <section class="civic-panel">
                        <CivicWatchPanelHeader Eyebrow="U.S. House" Title="Recent news" Count="@_snapshot.Federal.HouseNews.Count" Icon="bi-newspaper" />
                        <CivicWatchFederalNews Items="_snapshot.Federal.HouseNews" Chamber="House" />
                    </section>
                </div>

                <div class="chamber-grid">
                    <section class="civic-panel">
                        <CivicWatchPanelHeader Eyebrow="U.S. Senate" Title="Recent roll calls" Count="@_snapshot.Federal.SenateVotes.Count" Icon="bi-building" />
                        <CivicWatchFederalVotes Votes="_snapshot.Federal.SenateVotes" NewKeys="NewKeys" />
                    </section>
                    <section class="civic-panel">
                        <CivicWatchPanelHeader Eyebrow="U.S. House" Title="Recent roll calls" Count="@_snapshot.Federal.HouseVotes.Count" Icon="bi-building" />
                        <CivicWatchFederalVotes Votes="_snapshot.Federal.HouseVotes" NewKeys="NewKeys" />
                    </section>
                </div>

                <div class="chamber-grid">
                    <section class="civic-panel">
                        <CivicWatchPanelHeader Eyebrow="Your district" Title="Your members of Congress" Count="@FederalReps.Count" Icon="bi-person-badge" />
                        @RepresentativesBody(FederalReps, "federal")
                    </section>
                    <section class="civic-panel">
                        <CivicWatchPanelHeader Eyebrow="Watchlist" Title="Federal bills you follow" Count="@WatchedFor("us").Count" Icon="bi-bookmark-star" />
                        @WatchlistBody("us")
                    </section>
                </div>

                <div class="chamber-grid">
                    <section class="civic-panel">
                        <CivicWatchPanelHeader Eyebrow="Federal Register" Title="Rules and open comment periods" Count="@(_federalRegister?.Items.Count ?? 0)" Icon="bi-journal-richtext" />
                        @if (_federalRegister is null)
                        {
                            <CivicWatchEmptyState Icon="bi-hourglass-split" Message="Loading Federal Register…" />
                        }
                        else if (_federalRegister.Keywords.Count == 0)
                        {
                            <CivicWatchEmptyState Icon="bi-sliders" Message="Add Federal Register keywords in Settings to follow rules and comment periods." />
                        }
                        else if (!string.IsNullOrWhiteSpace(_federalRegister.Error))
                        {
                            <CivicWatchEmptyState Icon="bi-wifi-off" Message="@_federalRegister.Error" />
                        }
                        else
                        {
                            <div class="event-filter-row" role="group" aria-label="Filter Federal Register documents">
                                <button type="button" class="event-chip @(_openCommentOnly ? "" : "is-on")" @onclick="() => _openCommentOnly = false">All</button>
                                <button type="button" class="event-chip @(_openCommentOnly ? "is-on" : "")" @onclick="() => _openCommentOnly = true">Open for comment</button>
                            </div>
                            @if (FilteredRegister.Count == 0)
                            {
                                <CivicWatchEmptyState Icon="bi-funnel" Message="Nothing matches in the last 30 days." />
                            }
                            else
                            {
                                <div class="news-list">
                                    @foreach (var doc in FilteredRegister)
                                    {
                                        <a href="@doc.Url" target="_blank" rel="noopener noreferrer">
                                            <span class="news-source">@doc.Type · @FormatDateOnly(doc.PublishedOn) · "@doc.MatchedKeyword"</span>
                                            <strong>@doc.Title</strong>
                                            <small>@RegisterMeta(doc)</small>
                                            <i class="bi bi-arrow-up-right"></i>
                                        </a>
                                    }
                                </div>
                            }
                        }
                        <p class="panel-note"><i class="bi bi-info-circle"></i> Rules, proposed rules and notices from the last 30 days, ranked by relevance. Comments are filed on the document's own page.</p>
                    </section>
                    <section class="civic-panel">
                        <CivicWatchPanelHeader Eyebrow="Grants.gov" Title="Funding opportunities" Count="@(_grants?.Items.Count ?? 0)" Icon="bi-cash-coin" />
                        @if (_grants is null)
                        {
                            <CivicWatchEmptyState Icon="bi-hourglass-split" Message="Loading Grants.gov…" />
                        }
                        else if (_grants.Keywords.Count == 0)
                        {
                            <CivicWatchEmptyState Icon="bi-sliders" Message="Add grant keywords in Settings to see matching funding opportunities." />
                        }
                        else if (!string.IsNullOrWhiteSpace(_grants.Error))
                        {
                            <CivicWatchEmptyState Icon="bi-wifi-off" Message="@_grants.Error" />
                        }
                        else if (_grants.Items.Count == 0)
                        {
                            <CivicWatchEmptyState Icon="bi-funnel" Message="No open or forecasted opportunities match." />
                        }
                        else
                        {
                            <div class="news-list">
                                @foreach (var grant in _grants.Items)
                                {
                                    <a href="@grant.Url" target="_blank" rel="noopener noreferrer">
                                        <span class="news-source">@grant.Status · @grant.Agency</span>
                                        <strong>@grant.Title</strong>
                                        <small>@GrantMeta(grant)</small>
                                        <i class="bi bi-arrow-up-right"></i>
                                    </a>
                                }
                            </div>
                        }
                        <p class="panel-note"><i class="bi bi-info-circle"></i> Posted and forecasted federal opportunities, soonest closing first. Eligibility is on each listing.</p>
                    </section>
                </div>

                <CivicWatchResources Title="Federal government directory" Sections="_snapshot.Federal.ResourceSections" />
            }
        </div>
    }
</main>

@code {
    private const string IntroHintKey = "gws-civicwatch-intro-hint-dismissed";
    private bool _showIntroHint;

    private GovernmentIntelligenceSnapshot? _snapshot;
    private bool _loading;
    private string _activeSection = "community";
    private string _errorMessage = string.Empty;

    private int CommunityCount => _snapshot is null ? 0 :
        _snapshot.Community.Announcements.Count + _snapshot.Community.Meetings.Count + _snapshot.Community.LocalEvents.Count;
    private int StateCount => _snapshot is null ? 0 :
        _snapshot.State.PressReleases.Count + _snapshot.State.SignedLegislation.Count
        + _snapshot.State.HouseVotes.Count + _snapshot.State.SenateVotes.Count;
    private int FederalCount => _snapshot is null ? 0 :
        _snapshot.Federal.HouseVotes.Count + _snapshot.Federal.SenateVotes.Count;

    protected override async Task OnInitializedAsync()
    {
        await LoadSettingsAsync();
        await LoadSnapshotAsync(forceRefresh: false);
        _ = LoadExtrasAsync();
    }

    // ── Civic Watch extras (settings, changes, reps, watchlist, feeds) ─────
    private CivicWatchSettingsView? _settings;
    private SettingsForm? _settingsForm;
    private bool _showSettings;
    private bool _savingSettings;
    private string? _settingsMessage;
    private CivicChanges? _changes;
    private bool _showAllChanges;
    private CivicRepresentatives? _representatives;
    private IReadOnlyList<WatchedBillView>? _watched;
    private readonly Dictionary<string, string> _watchInput = new() { ["ga"] = string.Empty, ["us"] = string.Empty };
    private readonly Dictionary<string, string?> _watchMessage = new();
    private bool _watchBusy;
    private CivicKeywordFeed<FederalRegisterDocument>? _federalRegister;
    private CivicKeywordFeed<GrantOpportunity>? _grants;
    private bool _openCommentOnly;
    private IReadOnlyList<CivicMeetingDocumentView>? _meetingDocs;
    private CivicElectionInfo? _elections;

    private sealed class SettingsForm
    {
        public string HomeLabel { get; set; } = string.Empty;
        public string? HomeAddress { get; set; }
        public double HomeLatitude { get; set; }
        public double HomeLongitude { get; set; }
        public string FederalRegisterKeywords { get; set; } = string.Empty;
        public string GrantKeywords { get; set; } = string.Empty;
        public bool AlertsEnabled { get; set; }
        public string? AlertRecipient { get; set; }
    }

    private string AreaLabel => _settings?.HomeLabel ?? _snapshot?.AreaLabel ?? string.Empty;
    private IReadOnlySet<string>? NewKeys => _changes?.NewKeys;
    private bool IsNew(string desk, string url) => _changes?.NewKeys.Contains(CivicItemKeys.For(desk, url)) == true;

    private async Task LoadSettingsAsync()
    {
        try
        {
            _settings = await CivicService.GetSettingsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Civic Watch settings could not be loaded");
        }
    }

    // Every extra is independent and network-bound, so each loads on its own and a failure in
    // one leaves the rest of the page working.
    private async Task LoadExtrasAsync()
    {
        await Task.WhenAll(
            LoadPartAsync(async () => _changes = await CivicService.GetChangesAsync(TimeSpan.FromHours(24)), "changes"),
            LoadPartAsync(async () => _watched = await CivicService.ListWatchedBillsAsync(), "watchlist"),
            LoadPartAsync(async () => _representatives = await CivicService.GetRepresentativesAsync(), "representatives"),
            LoadPartAsync(async () => _meetingDocs = await CivicService.ListMeetingDocumentsAsync(), "meeting documents"),
            LoadPartAsync(async () => _elections = await CivicService.GetElectionsAsync(), "elections"),
            LoadPartAsync(async () => _federalRegister = await CivicService.GetFederalRegisterAsync(), "Federal Register"),
            LoadPartAsync(async () => _grants = await CivicService.GetGrantOpportunitiesAsync(), "Grants.gov"));
    }

    private async Task LoadPartAsync(Func<Task> load, string name)
    {
        try
        {
            await load();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Civic Watch: {Part} could not be loaded", name);
        }
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleSettings()
    {
        _showSettings = !_showSettings;
        _settingsMessage = null;
        if (_showSettings && _settings is { } s)
        {
            _settingsForm = new SettingsForm
            {
                HomeLabel = s.HomeLabel, HomeAddress = s.HomeAddress, HomeLatitude = s.HomeLatitude, HomeLongitude = s.HomeLongitude,
                FederalRegisterKeywords = s.FederalRegisterKeywords, GrantKeywords = s.GrantKeywords,
                AlertsEnabled = s.AlertsEnabled, AlertRecipient = s.AlertRecipient
            };
        }
    }

    private async Task SaveSettingsAsync()
    {
        if (_settingsForm is null || _settings is null) return;
        _savingSettings = true;
        _settingsMessage = null;
        try
        {
            var username = await CurrentUserAccessor.GetCurrentUsernameAsync();
            _settings = await CivicService.SaveSettingsAsync(_settings with
            {
                HomeLabel = _settingsForm.HomeLabel, HomeAddress = _settingsForm.HomeAddress,
                HomeLatitude = _settingsForm.HomeLatitude, HomeLongitude = _settingsForm.HomeLongitude,
                FederalRegisterKeywords = _settingsForm.FederalRegisterKeywords, GrantKeywords = _settingsForm.GrantKeywords,
                AlertsEnabled = _settingsForm.AlertsEnabled, AlertRecipient = _settingsForm.AlertRecipient
            }, username);
            _settingsForm.HomeLatitude = _settings.HomeLatitude;
            _settingsForm.HomeLongitude = _settings.HomeLongitude;
            _settingsMessage = _settings.StateCode is null
                ? "Saved. Districts couldn't be looked up for this point right now."
                : "Saved.";
            _representatives = null;
            _federalRegister = null;
            _grants = null;
            _ = Task.WhenAll(
                LoadPartAsync(async () => _representatives = await CivicService.GetRepresentativesAsync(), "representatives"),
                LoadPartAsync(async () => _federalRegister = await CivicService.GetFederalRegisterAsync(), "Federal Register"),
                LoadPartAsync(async () => _grants = await CivicService.GetGrantOpportunitiesAsync(), "Grants.gov"));
        }
        catch (ArgumentException ex)
        {
            _settingsMessage = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Civic Watch settings save failed");
            _settingsMessage = "Settings couldn't be saved.";
        }
        finally
        {
            _savingSettings = false;
        }
    }

    private static string DistrictSummary(CivicWatchSettingsView s)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(s.CountyName)) parts.Add($"{s.CountyName}, {s.StateCode}");
        else parts.Add(s.StateCode ?? string.Empty);
        if (s.CongressionalDistrict is { } cd) parts.Add(cd == 0 ? "at-large congressional district" : $"Congressional District {cd}");
        if (s.StateSenateDistrict is { } sd) parts.Add($"State Senate District {sd}");
        if (s.StateHouseDistrict is { } hd) parts.Add($"State House District {hd}");
        return string.Join(" · ", parts);
    }

    private static string DeskLabel(string desk) => desk switch
    {
        "state" => "Georgia",
        "federal" => "Congress",
        _ => "Community"
    };

    // ── Representatives ───────────────────────────────────────────────────
    private IReadOnlyList<CivicRepresentative> FederalReps =>
        _representatives?.Members.Where(m => m.Level == "federal").ToList() ?? [];
    private IReadOnlyList<CivicRepresentative> StateReps =>
        _representatives?.Members.Where(m => m.Level == "state").ToList() ?? [];

    private sealed record RepVote(string Label, string Vote, string Result, DateTimeOffset? When, string Url);

    private IReadOnlyList<RepVote> VotesFor(CivicRepresentative rep)
    {
        if (_snapshot is null) return [];
        if (rep.Level == "federal")
        {
            var votes = rep.Chamber == "Senate" ? _snapshot.Federal.SenateVotes : _snapshot.Federal.HouseVotes;
            return votes
                .Select(v => (Vote: v, Member: v.Votes.FirstOrDefault(m => string.Equals(m.MemberId, rep.MemberId, StringComparison.OrdinalIgnoreCase))))
                .Where(x => x.Member is not null)
                .Select(x => new RepVote(string.IsNullOrWhiteSpace(x.Vote.Measure) ? x.Vote.Title : x.Vote.Measure, x.Member!.Vote, x.Vote.Result, x.Vote.VotedAt, x.Vote.DetailUrl))
                .ToList();
        }
        var stateVotes = rep.Chamber == "Senate" ? _snapshot.State.SenateVotes : _snapshot.State.HouseVotes;
        return stateVotes
            .Select(v => (Vote: v, Member: v.Votes.FirstOrDefault(m => m.MemberId?.ToString(CultureInfo.InvariantCulture) == rep.MemberId)))
            .Where(x => x.Member is not null)
            .Select(x => new RepVote(string.IsNullOrWhiteSpace(x.Vote.Measure) ? x.Vote.Title : x.Vote.Measure, x.Member!.Vote, x.Vote.Status, x.Vote.VotedAt, x.Vote.DetailUrl))
            .ToList();
    }

    private RenderFragment RepresentativesBody(IReadOnlyList<CivicRepresentative> reps, string level) => @<text>
        @if (_representatives is null)
        {
            <CivicWatchEmptyState Icon="bi-hourglass-split" Message="Looking up your representatives…" />
        }
        else if (reps.Count == 0)
        {
            <CivicWatchEmptyState Icon="bi-geo" Message="@(_representatives.Note ?? "No representatives found for your saved location.")" />
        }
        else
        {
            <div class="rep-list">
                @foreach (var rep in reps)
                {
                    var votes = VotesFor(rep);
                    <article class="rep-card">
                        <div class="rep-head">
                            <span class="news-source">@(level == "federal" ? $"U.S. {rep.Chamber}" : $"Georgia {rep.Chamber}") · @RepDistrict(rep)</span>
                            <strong>@rep.Name <small>@rep.Party</small></strong>
                            <span class="rep-links">
                                @if (!string.IsNullOrWhiteSpace(rep.WebsiteUrl))
                                {
                                    <a href="@rep.WebsiteUrl" target="_blank" rel="noopener noreferrer">Website <i class="bi bi-arrow-up-right"></i></a>
                                }
                                @if (!string.IsNullOrWhiteSpace(rep.Phone))
                                {
                                    <a href="@($"tel:{rep.Phone}")">@rep.Phone</a>
                                }
                            </span>
                        </div>
                        @if (votes.Count == 0)
                        {
                            <small class="rep-novotes">No vote recorded in the recent roll calls shown on this page.</small>
                        }
                        else
                        {
                            <ul class="rep-votes">
                                @foreach (var vote in votes)
                                {
                                    <li>
                                        <b class="@RepVoteClass(vote.Vote)">@vote.Vote</b>
                                        <a href="@vote.Url" target="_blank" rel="noopener noreferrer">@vote.Label</a>
                                        <small>@vote.Result</small>
                                    </li>
                                }
                            </ul>
                        }
                    </article>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(_representatives.Note))
            {
                <p class="panel-note"><i class="bi bi-info-circle"></i> @_representatives.Note</p>
            }
        }
    </text>;

    private string RepDistrict(CivicRepresentative rep) =>
        rep.Level == "federal"
            ? rep.Chamber == "Senate" ? $"{rep.District} (statewide)" : rep.District
            : $"District {rep.District}";

    private static string RepVoteClass(string vote) => vote.ToLowerInvariant() switch
    {
        "yea" or "aye" or "yes" => "vote-yes",
        "nay" or "no" => "vote-no",
        _ => "vote-other"
    };

    // ── Bill watchlist ────────────────────────────────────────────────────
    private IReadOnlyList<WatchedBillView> WatchedFor(string jurisdiction) =>
        _watched?.Where(b => b.Jurisdiction == jurisdiction).ToList() ?? [];

    private RenderFragment WatchlistBody(string jurisdiction) => @<text>
        <form class="watch-form" @onsubmit="() => AddWatchedBillAsync(jurisdiction)" @onsubmit:preventDefault>
            <input class="form-control form-control-sm" aria-label="Bill to watch"
                   placeholder="@(jurisdiction == "ga" ? "e.g. HB 68 or SB 1" : "e.g. H.R. 1 or S. 25")"
                   value="@_watchInput[jurisdiction]" @oninput="e => _watchInput[jurisdiction] = e.Value?.ToString() ?? string.Empty" />
            <button type="submit" class="btn btn-sm btn-primary" disabled="@(_watchBusy || string.IsNullOrWhiteSpace(_watchInput[jurisdiction]))">Watch</button>
        </form>
        @if (_watchMessage.TryGetValue(jurisdiction, out var message) && !string.IsNullOrWhiteSpace(message))
        {
            <p class="settings-message" role="status">@message</p>
        }
        @if (_watched is null)
        {
            <CivicWatchEmptyState Icon="bi-hourglass-split" Message="Loading your watchlist…" />
        }
        else if (WatchedFor(jurisdiction).Count == 0)
        {
            <CivicWatchEmptyState Icon="bi-bookmark" Message="@(jurisdiction == "ga" ? "Follow a Georgia bill to see its status here and get alerts when it moves." : "Follow a federal bill in the current Congress to see its latest action here.")" />
        }
        else
        {
            <div class="news-list">
                @foreach (var bill in WatchedFor(jurisdiction))
                {
                    <div class="watch-row">
                        <a href="@bill.OfficialUrl" target="_blank" rel="noopener noreferrer">
                            <span class="news-source">@bill.Label@(bill.LastChangedAt is { } changed ? $" · changed {changed.ToLocalTime():MMM d}" : string.Empty)</span>
                            <strong>@bill.Title</strong>
                            <small>@bill.LatestStatus@(string.IsNullOrWhiteSpace(bill.LatestStatusDate) ? string.Empty : $" ({bill.LatestStatusDate})")@(bill.LastError is null ? string.Empty : $" · {bill.LastError}")</small>
                        </a>
                        <button type="button" class="btn btn-sm btn-link watch-remove" aria-label="@($"Stop watching {bill.Label}")"
                                @onclick="() => RemoveWatchedBillAsync(bill.Id)" disabled="@_watchBusy">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                }
            </div>
        }
        <p class="panel-note"><i class="bi bi-bell"></i> Checked hourly. Status changes are emailed when alerts are on in Settings, and start any workflow with a "Civic Watch Bill Status Changed" trigger.</p>
    </text>;

    private async Task AddWatchedBillAsync(string jurisdiction)
    {
        var text = _watchInput[jurisdiction];
        if (string.IsNullOrWhiteSpace(text)) return;
        _watchBusy = true;
        _watchMessage[jurisdiction] = null;
        try
        {
            var username = await CurrentUserAccessor.GetCurrentUsernameAsync();
            var added = await CivicService.AddWatchedBillAsync(jurisdiction, text, username);
            _watchInput[jurisdiction] = string.Empty;
            _watchMessage[jurisdiction] = $"Now watching {added.Label}.";
            _watched = await CivicService.ListWatchedBillsAsync();
        }
        catch (ArgumentException ex)
        {
            _watchMessage[jurisdiction] = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Civic Watch: adding a watched bill failed");
            _watchMessage[jurisdiction] = "That bill couldn't be added right now.";
        }
        finally
        {
            _watchBusy = false;
        }
    }

    private async Task RemoveWatchedBillAsync(Guid id)
    {
        _watchBusy = true;
        try
        {
            await CivicService.RemoveWatchedBillAsync(id);
            _watched = await CivicService.ListWatchedBillsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Civic Watch: removing a watched bill failed");
        }
        finally
        {
            _watchBusy = false;
        }
    }

    // ── Keyword feeds, documents, elections ───────────────────────────────
    private IReadOnlyList<FederalRegisterDocument> FilteredRegister =>
        _federalRegister is null
            ? []
            : _federalRegister.Items.Where(d => !_openCommentOnly || d.IsOpenForComment(DateOnly.FromDateTime(DateTime.Now))).ToList();

    private static string FormatDateOnly(DateOnly? value) =>
        value?.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) ?? "Date unavailable";

    private static string RegisterMeta(FederalRegisterDocument doc)
    {
        var parts = new List<string>();
        if (doc.CommentsCloseOn is { } close)
        {
            parts.Add(close >= DateOnly.FromDateTime(DateTime.Now)
                ? $"Comments close {close.ToString("MMM d", CultureInfo.InvariantCulture)}"
                : $"Comments closed {close.ToString("MMM d", CultureInfo.InvariantCulture)}");
        }
        if (!string.IsNullOrWhiteSpace(doc.Agencies)) parts.Add(doc.Agencies);
        return string.Join(" · ", parts);
    }

    private static string GrantMeta(GrantOpportunity grant)
    {
        var parts = new List<string> { grant.Number };
        if (grant.CloseDate is { } close) parts.Add($"Closes {close.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)}");
        else parts.Add("No close date posted");
        parts.Add($"\"{grant.MatchedKeyword}\"");
        return string.Join(" · ", parts.Where(p => !string.IsNullOrWhiteSpace(p)));
    }

    private static string ElectionMeta(CivicElection election)
    {
        var days = election.ElectionDate.DayNumber - DateOnly.FromDateTime(DateTime.Now).DayNumber;
        var when = days switch { 0 => "Today", 1 => "Tomorrow", _ => $"In {days} days" };
        return string.IsNullOrWhiteSpace(election.RegistrationDeadline)
            ? $"{when} · {election.ElectionDate.Year}"
            : $"{when} · register by {election.RegistrationDeadline}";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // dashboard-hints.js is loaded once, globally, from App.razor - but an uncaught
        // JSException here (e.g. a future script-loading regression) would otherwise crash this
        // component's whole circuit, same class of incident as OverwatchGrid.razor's own
        // JS-init try/catch. Worst case without it: the intro hint just doesn't show.
        try
        {
            var dismissed = await JS.InvokeAsync<bool>("gwsDashboardHints.isDismissed", IntroHintKey);
            if (!dismissed)
            {
                _showIntroHint = true;
                StateHasChanged();
            }
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Unable to check the Civic Watch intro hint's dismissed state.");
        }
    }

    private async Task DismissIntroHint()
    {
        _showIntroHint = false;
        try
        {
            await JS.InvokeVoidAsync("gwsDashboardHints.dismiss", IntroHintKey);
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Unable to persist the Civic Watch intro hint's dismissed state.");
        }
    }

    private const string CommunitySignalDescription = "Local announcements, public meetings, and events found for your area.";
    private const string StateSignalDescription = "Georgia governor press releases, signed legislation, and House/Senate floor votes.";
    private const string FederalSignalDescription = "U.S. House and Senate roll-call votes currently on record.";

    private async Task RefreshAsync()
    {
        _loading = true;
        _errorMessage = string.Empty;
        var acquired = await GovernmentIntelligenceRefreshBackgroundService.RefreshLock.WaitAsync(3000);
        try
        {
            if (!acquired)
            {
                _errorMessage = "A scheduled refresh is already running — try again in a moment.";
                return;
            }
            await LoadSnapshotAsync(forceRefresh: true);
            if (_snapshot is not null)
            {
                await CivicService.RecordSightingsAsync(_snapshot);
                _changes = await CivicService.GetChangesAsync(TimeSpan.FromHours(24));
            }
        }
        finally
        {
            if (acquired) GovernmentIntelligenceRefreshBackgroundService.RefreshLock.Release();
            _loading = false;
        }
    }

    private async Task LoadSnapshotAsync(bool forceRefresh)
    {
        _loading = true;
        _errorMessage = string.Empty;
        try
        {
            _snapshot = await GovernmentService.GetSnapshotAsync(forceRefresh);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load Civic Watch");
            _errorMessage = "Civic Watch could not load its official sources.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void SelectSection(string section) => _activeSection = section;
    private string TabClass(string section) => _activeSection == section ? "active" : string.Empty;
    private string SignalClass(string section) => $"signal-card {(_activeSection == section ? "active" : string.Empty)}";

    private string CurrentSummary() => _snapshot is null ? string.Empty : _activeSection switch
    {
        "state" => _snapshot.State.Summary,
        "federal" => _snapshot.Federal.Summary,
        _ => _snapshot.Community.Summary
    };

    private static string FormatTimestamp(DateTimeOffset? value) =>
        value is null ? "Unavailable" : value.Value.ToString("MMM d, yyyy · h:mm tt", CultureInfo.InvariantCulture);
    private static string FormatDateOnly(DateTimeOffset? value) =>
        value is null ? "Date unavailable" : value.Value.ToString("MMM d, yyyy", CultureInfo.InvariantCulture);
    private static string DateDay(DateOnly? value) => value?.Day.ToString("00", CultureInfo.InvariantCulture) ?? "—";
    private static string DateMonth(DateOnly? value) => value?.ToString("MMM", CultureInfo.InvariantCulture) ?? "TBD";
    // ── Local event filters ───────────────────────────────────────────────
    private const string AllCities = "All";
    private string _cityFilter = AllCities;
    private string _whenFilter = "all";
    private int _radiusFilter;

    private void OnWhenFilterChanged(ChangeEventArgs e) => _whenFilter = e.Value?.ToString() ?? "all";

    private void OnRadiusFilterChanged(ChangeEventArgs e) =>
        _radiusFilter = int.TryParse(e.Value?.ToString(), out var miles) ? miles : 0;

    private bool IsFiltered => _cityFilter != AllCities || _whenFilter != "all" || _radiusFilter > 0;

    private void ClearEventFilters()
    {
        _cityFilter = AllCities;
        _whenFilter = "all";
        _radiusFilter = 0;
    }

    // Only towns that actually have events right now get a chip - a filter for a town with
    // nothing on is just noise. Nearest-first so the closest options are the easiest to reach.
    private IReadOnlyList<string> AvailableCities =>
        _snapshot is null
            ? []
            : _snapshot.Community.LocalEvents
                .Select(e => e.City)
                .Where(c => !string.IsNullOrWhiteSpace(c) && c != CivicPlaces.Unknown)
                .Distinct()
                .OrderBy(c => CivicPlaces.TownCoordinates.TryGetValue(c, out var town)
                    ? CivicPlaces.MilesBetween(HomeLatitude, HomeLongitude, town.Latitude, town.Longitude)
                    : double.MaxValue)
                .ThenBy(c => c)
                .ToList();

    private IReadOnlyList<CivicEvent> FilteredEvents
    {
        get
        {
            if (_snapshot is null) return [];
            var events = _snapshot.Community.LocalEvents.AsEnumerable();

            if (_cityFilter != AllCities)
            {
                events = events.Where(e => e.City == _cityFilter);
            }

            if (_radiusFilter > 0)
            {
                // An event whose town could not be resolved has no distance, so it is excluded
                // from a distance filter rather than silently treated as nearby.
                events = events.Where(e => MilesFromHome(e) is { } miles && miles <= _radiusFilter);
            }

            if (_whenFilter != "all")
            {
                var now = DateTimeOffset.Now;
                events = _whenFilter switch
                {
                    "week" => events.Where(e => e.StartAt is { } d && d >= now && d <= now.AddDays(7)),
                    "month" => events.Where(e => e.StartAt is { } d && d >= now && d <= now.AddDays(30)),
                    "weekend" => events.Where(e => e.StartAt is { } d && d >= now && d <= NextWeekendEnd(now)
                                                   && d.DayOfWeek is DayOfWeek.Friday or DayOfWeek.Saturday or DayOfWeek.Sunday),
                    _ => events
                };
            }

            return events.OrderBy(e => e.StartAt ?? DateTimeOffset.MaxValue).ToList();
        }
    }

    // End of the coming weekend: Sunday 23:59 of the current week, or of next week if today is
    // already past it. Keeps "this weekend" meaningful on a Monday as well as a Saturday.
    private static DateTimeOffset NextWeekendEnd(DateTimeOffset now)
    {
        var daysUntilSunday = ((int)DayOfWeek.Sunday - (int)now.DayOfWeek + 7) % 7;
        return now.Date.AddDays(daysUntilSunday).AddDays(1).AddTicks(-1);
    }

    private static string EventDay(CivicEvent item) => item.StartAt?.Day.ToString("00", CultureInfo.InvariantCulture) ?? "—";
    private static string EventMonth(CivicEvent item) => item.StartAt?.ToString("MMM", CultureInfo.InvariantCulture) ?? "TBD";

    // ── Federal hearing filter ────────────────────────────────────────────
    private string _hearingFilter = "upcoming";

    // "Upcoming" keeps a small grace window (rather than a hard cutoff at "now") so a hearing
    // that just started a few minutes ago doesn't immediately vanish from the default view.
    private IReadOnlyList<CivicHearing> FilteredHearings =>
        _snapshot is null
            ? []
            : _snapshot.Federal.Hearings
                .Where(h => _hearingFilter != "upcoming" || h.StartAt is null || h.StartAt >= DateTimeOffset.UtcNow.AddHours(-6))
                .OrderBy(h => h.StartAt ?? DateTimeOffset.MaxValue)
                .ToList();

    private static string HearingDay(CivicHearing item) => item.StartAt?.Day.ToString("00", CultureInfo.InvariantCulture) ?? "—";
    private static string HearingMonth(CivicHearing item) => item.StartAt?.ToString("MMM", CultureInfo.InvariantCulture) ?? "TBD";

    private static string HearingStatusDescription(string status) => status switch
    {
        "Scheduled" => "This meeting is on the calendar and expected to happen as planned.",
        "Canceled" => "This meeting has been canceled and will not take place.",
        "Postponed" => "This meeting has been delayed to a date not yet announced.",
        "Rescheduled" => "This meeting has been moved to a new date.",
        _ => "Status as reported by Congress.gov."
    };
    private static string MeetingMeta(CivicMeeting meeting) =>
        string.IsNullOrWhiteSpace(meeting.Location) ? meeting.Source : $"{meeting.Location} · {meeting.Source}";
    private double HomeLatitude => _settings?.HomeLatitude ?? CivicPlaces.HomeLatitude;
    private double HomeLongitude => _settings?.HomeLongitude ?? CivicPlaces.HomeLongitude;

    // Measured from the configured home (venue coordinates, else the town centre). Falls back to
    // the source's own Kathleen-based figure only when neither is known.
    private double? MilesFromHome(CivicEvent item) =>
        CivicPlaces.MilesFrom(HomeLatitude, HomeLongitude, item) ?? (_settings is null ? item.MilesFromHome : null);

    private string EventMeta(CivicEvent item)
    {
        var when = item.StartAt?.ToString("h:mm tt", CultureInfo.InvariantCulture) ?? "Time unavailable";
        // Town first after the time: with several towns in one feed, "where" is the thing being
        // scanned for. Distance rides along with it so "is that worth the drive" is answerable
        // without opening the listing.
        var where = item.City != CivicPlaces.Unknown && !string.IsNullOrWhiteSpace(item.City)
            ? MilesFromHome(item) is { } miles && miles > 0
                ? $"{item.City} · {miles:0.#} mi"
                : item.City
            : null;

        var parts = new[] { when, where, string.IsNullOrWhiteSpace(item.Location) ? null : item.Location, item.Source };
        return string.Join(" · ", parts.Where(p => !string.IsNullOrWhiteSpace(p)));
    }
}
