@page "/admin/government-intelligence"
@rendermode InteractiveServer
@* Civic Watch is entirely public-source government data (no confidential business info), so it
   uses the broader PortalAccess policy (Admin/Author/Contributor) rather than AdminOnly -
   deliberately widened so more than one admin account can use this section. *@
@attribute [Authorize(Policy = "PortalAccess")]
@using System.Globalization
@using GwsBusinessSuite.Application.GovernmentIntelligence
@using GwsBusinessSuite.Infrastructure.Services
@inject IGovernmentIntelligenceService GovernmentService
@inject ICivicWatchService CivicService
@inject GwsBusinessSuite.Application.Abstractions.ICurrentUserAccessor CurrentUserAccessor
@inject ILogger<GovernmentIntelligence> Logger
@inject IJSRuntime JS

<PageTitle>Civic Watch</PageTitle>

<main class="civic-watch">
    <div class="page-header page-header-rich d-flex flex-wrap justify-content-between gap-3 align-items-end">
        <div>
            <span class="page-header-eyebrow"><i class="bi bi-broadcast-pin"></i> Public life, made legible</span>
            <h1>Civic Watch</h1>
            <p>One calm briefing for local meetings, Georgia government, and the votes moving through Congress.</p>
        </div>
        <div class="masthead-actions">
            <button type="button" class="btn btn-outline-secondary" @onclick="ToggleSettings" aria-expanded="@(_showSettings ? "true" : "false")">
                <i class="bi bi-sliders"></i>
                <span>Settings</span>
            </button>
            <button type="button" class="btn btn-outline-secondary" @onclick="RefreshAsync" disabled="@_loading">
                <i class="bi bi-arrow-clockwise @(_loading ? "gws-spin" : string.Empty)"></i>
                <span>@(_loading ? "Refreshing sources…" : "Refresh sources")</span>
            </button>
        </div>
    </div>

    @if (_showIntroHint)
    {
        <div class="gws-hint-banner mb-4" role="status">
            <i class="bi bi-lightbulb-fill" aria-hidden="true"></i>
            <span>
                Civic Watch has three tabs: <strong>Community</strong> (your local town/county government),
                <strong>State</strong> (Georgia government), and <strong>Federal</strong> (Congress). Each tab's
                number badge counts what's currently active there. Look for a "Represent &amp; Participate"
                section on the State and Federal tabs for ways to register to vote, find your polling place,
                or contact your representatives.
            </span>
            <button type="button" class="btn-close ms-auto" aria-label="Dismiss" @onclick="DismissIntroHint"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger d-flex align-items-start gap-2 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill mt-1 flex-shrink-0"></i>
            <div>@_errorMessage</div>
        </div>
    }

    @if (_showSettings && _settingsForm is not null)
    {
        <section class="civic-panel civic-settings" aria-label="Civic Watch settings">
            <CivicWatchPanelHeader Eyebrow="Settings" Title="Your location, keywords and alerts" Icon="bi-sliders" />
            <p class="settings-note">
                Distances, your districts and your representatives follow this location. The briefing's sources stay
                Houston County and Georgia - other places get distances, districts and federal representatives, but not their own local feeds.
            </p>
            <div class="settings-grid">
                <label>
                    <span>Area name</span>
                    <input class="form-control form-control-sm" @bind="_settingsForm.HomeLabel" @bind:event="oninput" maxlength="120" />
                </label>
                <label>
                    <span>Street address (optional)</span>
                    <input class="form-control form-control-sm" @bind="_settingsForm.HomeAddress" @bind:event="oninput"
                           placeholder="e.g. 201 Perry Pkwy, Perry, GA 31069" />
                    <small>Looked up with the U.S. Census geocoder and replaces the coordinates below. Stored only in this app.</small>
                </label>
                <label>
                    <span>Latitude</span>
                    <input type="number" step="0.0001" class="form-control form-control-sm" @bind="_settingsForm.HomeLatitude" />
                </label>
                <label>
                    <span>Longitude</span>
                    <input type="number" step="0.0001" class="form-control form-control-sm" @bind="_settingsForm.HomeLongitude" />
                </label>
                <label>
                    <span>Federal Register keywords (one per line)</span>
                    <textarea class="form-control form-control-sm" rows="3" value="@_settingsForm.FederalRegisterKeywords"
                              @oninput="e => _settingsForm.FederalRegisterKeywords = e.Value?.ToString() ?? string.Empty"
                              placeholder="cybersecurity&#10;artificial intelligence"></textarea>
                </label>
                <label>
                    <span>Grant keywords (one per line)</span>
                    <textarea class="form-control form-control-sm" rows="3" value="@_settingsForm.GrantKeywords"
                              @oninput="e => _settingsForm.GrantKeywords = e.Value?.ToString() ?? string.Empty"
                              placeholder="small business&#10;workforce training"></textarea>
                </label>
                <label class="settings-check">
                    <input type="checkbox" class="form-check-input" @bind="_settingsForm.AlertsEnabled" />
                    <span>Email me when a watched bill changes status</span>
                </label>
                <label>
                    <span>Alert email</span>
                    <input type="email" class="form-control form-control-sm" @bind="_settingsForm.AlertRecipient" @bind:event="oninput" />
                </label>
            </div>
            <p class="settings-districts">
                <i class="bi bi-geo"></i>
                @if (_settings?.StateCode is { } state)
                {
                    <span>@DistrictSummary(_settings)</span>
                }
                else
                {
                    <span>Districts not looked up yet - save to look them up.</span>
                }
            </p>
            @if (!string.IsNullOrWhiteSpace(_settingsMessage))
            {
                <p class="settings-message" role="status">@_settingsMessage</p>
            }
            <div class="settings-actions">
                <button type="button" class="btn btn-sm btn-primary" @onclick="SaveSettingsAsync" disabled="@_savingSettings">
                    @(_savingSettings ? "Saving…" : "Save settings")
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ToggleSettings">Close</button>
            </div>
        </section>
    }

    @if (_loading && _snapshot is null)
    {
        <div class="civic-loading" role="status">
            <span class="spinner-border spinner-border-sm"></span>
            <div><strong>Building your civic briefing</strong><small>Checking official local, state, and federal sources…</small></div>
        </div>
    }
    else if (_snapshot is not null)
    {
        <section class="civic-briefing">
            <div class="briefing-lead">
                <span class="briefing-label">Your coverage area</span>
                <h2>@AreaLabel</h2>
                <p>@CurrentSummary()</p>
                <div class="briefing-freshness">
                    <span></span>
                    Updated @FormatTimestamp(_snapshot.RetrievedAt)
                    <em>Official sources</em>
                </div>
            </div>
            <div class="briefing-signals" aria-label="Civic Watch source counts">
                <button class="@SignalClass("community")" title="@CommunitySignalDescription" @onclick='() => SelectSection("community")'>
                    <i class="bi bi-geo-alt"></i>
                    <span><strong>@CommunityCount</strong><small>Community</small></span>
                </button>
                <button class="@SignalClass("state")" title="@StateSignalDescription" @onclick='() => SelectSection("state")'>
                    <i class="bi bi-bank"></i>
                    <span><strong>@StateCount</strong><small>State</small></span>
                </button>
                <button class="@SignalClass("federal")" title="@FederalSignalDescription" @onclick='() => SelectSection("federal")'>
                    <i class="bi bi-building"></i>
                    <span><strong>@FederalCount</strong><small>Federal</small></span>
                </button>
            </div>
        </section>

        <nav class="scope-nav" aria-label="Civic Watch coverage">
            <button class="@TabClass("community")" title="@CommunitySignalDescription" @onclick='() => SelectSection("community")'>
                <i class="bi bi-geo-alt"></i>
                <span><strong>Community</strong><small>Local government, schools &amp; events</small></span>
                <b>@CommunityCount</b>
            </button>
            <button class="@TabClass("state")" title="@StateSignalDescription" @onclick='() => SelectSection("state")'>
                <i class="bi bi-bank"></i>
                <span><strong>State</strong><small>Governor, laws &amp; floor votes</small></span>
                <b>@StateCount</b>
            </button>
            <button class="@TabClass("federal")" title="@FederalSignalDescription" @onclick='() => SelectSection("federal")'>
                <i class="bi bi-building"></i>
                <span><strong>Federal</strong><small>House, Senate &amp; delegation votes</small></span>
                <b>@FederalCount</b>
            </button>
        </nav>

        @if (_changes is { Items.Count: > 0 })
        {
            <section class="civic-panel civic-changes" aria-label="What changed">
                <CivicWatchPanelHeader Eyebrow="Since yesterday" Title="What changed" Count="@_changes.Items.Count" Icon="bi-stars" />
                <div class="news-list">
                    @foreach (var item in _changes.Items.Take(_showAllChanges ? 40 : 5))
                    {
                        <a href="@item.Url" target="_blank" rel="noopener noreferrer">
                            <span class="news-source">@DeskLabel(item.Desk) · @item.Kind · @FormatTimestamp(item.FirstSeenAt.ToLocalTime())</span>
                            <strong>@item.Title</strong>
                            <i class="bi bi-arrow-up-right"></i>
                        </a>
                    }
                </div>
                @if (_changes.Items.Count > 5)
                {
                    <button type="button" class="event-clear mt-2" @onclick="() => _showAllChanges = !_showAllChanges">
                        @(_showAllChanges ? "Show fewer" : $"Show all {_changes.Items.Count}")
                    </button>
                }
            </section>
        }

        <div class="civic-content">
            @if (_activeSection == "community")
            {
                <section class="section-intro">
                    <span>Community desk</span>
                    <div>
                        <h2>What is happening close to home</h2>
                        <p>Official notices, public meetings, and events are separated by intent so you can scan what changed and act quickly.</p>
                    </div>
                </section>

                <div class="community-grid">
                    <section class="civic-panel">
                        <CivicWatchPanelHeader Eyebrow="County notices" Title="Latest announcements" Count="@_snapshot.Community.Announcements.Count" Icon="bi-megaphone" />
                        @if (_snapshot.Community.Announcements.Count == 0)
                        {
                            <CivicWatchEmptyState Icon="bi-inbox" Message="No county announcements were returned." />
                        }
                        else
                        {
                            <div class="news-list">
                                @foreach (var item in _snapshot.Community.Announcements)
                                {
                                    <a href="@item.Url" target="_blank" rel="noopener noreferrer">
                                        <span class="news-source">@item.Source@if (IsNew("community", item.Url)) { <span class="civic-new">New</span> }</span>
                                        <strong>@item.Title</strong>
                                        @if (!string.IsNullOrWhiteSpace(item.Summary)) { <small>@item.Summary</small> }
                                        <i class="bi bi-arrow-up-right"></i>
                                    </a>
                                }
                            </div>
                        }
                    </section>

                    <section class="civic-panel">
                        <CivicWatchPanelHeader Eyebrow="Public calendar" Title="Meetings" Count="@_snapshot.Community.Meetings.Count" Icon="bi-calendar3" />
                        @if (_snapshot.Community.Meetings.Count == 0)
                        {
                            <CivicWatchEmptyState Icon="bi-calendar2-x" Message="No county meeting dates were returned." />
                        }
                        else
                        {
                            <div class="date-list">
                                @foreach (var meeting in _snapshot.Community.Meetings)
                                {
                                    <a href="@meeting.Url" target="_blank" rel="noopener noreferrer">
                                        <time><strong>@DateDay(meeting.MeetingDate)</strong><small>@DateMonth(meeting.MeetingDate)</small></time>
                                        <span><strong>@meeting.Title@if (IsNew("community", meeting.Url)) { <span class="civic-new">New</span> }</strong><small>@MeetingMeta(meeting)</small></span>
                                        <i class="bi bi-arrow-up-right"></i>
                                    </a>
                                }
                            </div>
                        }
                    </section>

                    <section class="civic-panel">
                        <CivicWatchPanelHeader Eyebrow="Around town" Title="Local events" Count="@FilteredEvents.Count" Icon="bi-calendar-event" />

                        @* Filters sit above the list rather than behind a menu: with events from
                           several towns arriving in one feed, narrowing to "this weekend, within
                           10 miles" is the normal way to read this panel, not an edge case. *@
                        <div class="event-filters">
                            <div class="event-filter-row" role="group" aria-label="Filter events by town">
                                <button type="button" class="event-chip @(_cityFilter == AllCities ? "is-on" : "")"
                                        @onclick="() => _cityFilter = AllCities">
                                    All towns
                                </button>
                                @foreach (var city in AvailableCities)
                                {
                                    var count = _snapshot.Community.LocalEvents.Count(e => e.City == city);
                                    <button type="button" class="event-chip @(_cityFilter == city ? "is-on" : "")"
                                            @onclick="() => _cityFilter = city">
                                        @city <span class="event-chip-count">@count</span>
                                    </button>
                                }
                            </div>
                            <div class="event-filter-row">
                                <select class="event-select" value="@_whenFilter" @onchange="OnWhenFilterChanged"
                                        aria-label="Filter events by date">
                                    <option value="all">Any date</option>
                                    <option value="week">Next 7 days</option>
                                    <option value="weekend">This weekend</option>
                                    <option value="month">Next 30 days</option>
                                </select>
                                <select class="event-select" value="@_radiusFilter" @onchange="OnRadiusFilterChanged"
                                        aria-label="@($"Filter events by distance from {AreaLabel}")">
                                    <option value="0">Any distance</option>
                                    <option value="5">Within 5 mi</option>
                                    <option value="10">Within 10 mi</option>
                                    <option value="15">Within 15 mi</option>
                                    <option value="25">Within 25 mi</option>
                                </select>
                                @if (IsFiltered)
                                {
                                    <button type="button" class="event-clear" @onclick="ClearEventFilters">Clear</button>
                                }
                            </div>
                        </div>

                        @if (_snapshot.Community.LocalEvents.Count == 0)
                        {
                            <CivicWatchEmptyState Icon="bi-calendar2-x" Message="No local events were returned." />
                        }
                        else if (FilteredEvents.Count == 0)
                        {
                            <CivicWatchEmptyState Icon="bi-funnel" Message="No events match these filters. Try widening the date range or distance." />
                        }
                        else
                        {
                            <div class="date-list">
                                @foreach (var localEvent in FilteredEvents)
                                {
                                    <a href="@localEvent.Url" target="_blank" rel="noopener noreferrer">
                                        <time><strong>@EventDay(localEvent)</strong><small>@EventMonth(localEvent)</small></time>
                                        <span><strong>@localEvent.Title</strong><small>@EventMeta(localEvent)</small></span>
                                        <i class="bi bi-arrow-up-right"></i>
                                    </a>
                                }
                            </div>
                        }
                        <p class="panel-note"><i class="bi bi-clock-history"></i> Perry, Robins Region Chamber, Visit Macon and Eventbrite listings refresh hourly. Distances are straight-line miles from @AreaLabel.</p>
                    </section>
                </div>

                <div class="chamber-grid">
                    <section class="civic-panel">
                        <CivicWatchPanelHeader Eyebrow="County commission" Title="Agendas and minutes" Count="@(_meetingDocs?.Count ?? 0)" Icon="bi-file-earmark-text" />
                        @if (_meetingDocs is null)
                        {
                            <CivicWatchEmptyState Icon="bi-hourglass-split" Message="Loading commission documents…" />
                        }
                        else if (_meetingDocs.Count == 0)
                        {
                            <CivicWatchEmptyState Icon="bi-file-earmark-x" Message="No agendas or minutes collected yet. They are checked hourly." />
                        }
                        else
                        {
                            <div class="doc-list">
                                @foreach (var doc in _meetingDocs)
                                {
                                    <article>
                                        <div class="doc-head">
                                            <span class="news-source">@doc.Kind · @doc.MeetingDate.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)</span>
                                            <a href="@doc.Url" target="_blank" rel="noopener noreferrer">PDF <i class="bi bi-arrow-up-right"></i></a>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(doc.AiSummary))
                                        {
                                            <p class="doc-summary">@doc.AiSummary</p>
                                        }
                                        else
                                        {
                                            <small>@(doc.LastError ?? "SentinelGPT summary pending.")</small>
                                        }
                                    </article>
                                }
                            </div>
                        }
                        <p class="panel-note"><i class="bi bi-stars"></i> Summaries are written by SentinelGPT from the county's PDFs. Check the PDF before relying on a detail.</p>
                    </section>
                    <section class="civic-panel">
                        <CivicWatchPanelHeader Eyebrow="Board of Elections" Title="Upcoming elections" Count="@(_elections?.Upcoming.Count ?? 0)" Icon="bi-check2-square" />
                        @if (_elections is null)
                        {
                            <CivicWatchEmptyState Icon="bi-hourglass-split" Message="Loading election dates…" />
                        }
                        else
                        {
                            @if (!string.IsNullOrWhiteSpace(_elections.Error))
                            {
                                <CivicWatchEmptyState Icon="bi-wifi-off" Message="@_elections.Error" />
                            }
                            else if (_elections.Upcoming.Count == 0)
                            {
                                <CivicWatchEmptyState Icon="bi-calendar2-x" Message="No upcoming elections are posted yet." />
                            }
                            else
                            {
                                <div class="date-list">
                                    @foreach (var election in _elections.Upcoming)
                                    {
                                        <a href="https://www.houstoncountyga.gov/residents/election-dates-municipal-elections.cms" target="_blank" rel="noopener noreferrer">
                                            <time><strong>@election.ElectionDate.Day.ToString("00", CultureInfo.InvariantCulture)</strong><small>@election.ElectionDate.ToString("MMM", CultureInfo.InvariantCulture)</small></time>
                                            <span><strong>@election.Name</strong><small>@ElectionMeta(election)</small></span>
                                            <i class="bi bi-arrow-up-right"></i>
                                        </a>
                                    }
                                </div>
                            }
                            <div class="election-docs">
                                <a class="hearing-link" href="https://mvp.sos.ga.gov/" target="_blank" rel="noopener noreferrer"
                                   title="Georgia Secretary of State: your registration, polling place and personal sample ballot.">My Voter Page <i class="bi bi-arrow-up-right"></i></a>
                                @foreach (var doc in _elections.Documents)
                                {
                                    <a class="hearing-link" href="@doc.Url" target="_blank" rel="noopener noreferrer" title="@doc.Description">@doc.Title <i class="bi bi-arrow-up-right"></i></a>
                                }
                            </div>
                        }
                        <p class="panel-note"><i class="bi bi-person-check"></i> Your exact polling place and personal sample ballot are on Georgia's My Voter Page.</p>
                    </section>
                </div>

                <div class="community-lower">
                    <CivicWatchResources Title="Community services and records" Sections="_snapshot.Community.ResourceSections" />
                    <section class="civic-panel local-law-panel">
                        <CivicWatchPanelHeader Eyebrow="Local law" Title="Ordinances and board actions" Count="@_snapshot.Community.LegislationBriefs.Count" Icon="bi-journal-text" />
                        @if (_snapshot.Community.LegislationBriefs.Count == 0)
                        {
                            <CivicWatchEmptyState Icon="bi-journal" Message="No local legislation research briefs are available." />
                        }
                        else
                        {
                            @foreach (var brief in _snapshot.Community.LegislationBriefs)
                            {
                                <LegislationBriefPanel Brief="brief" SummaryLabel="Open local legislation guide" />
                            }
                        }
                    </section>
                </div>
            }
            else if (_activeSection == "state")
            {
                <section class="section-intro">
                    <span>Georgia desk</span>
                    <div>
                        <h2>Executive action and the votes behind state policy</h2>
                        <p>Start with the latest official updates, then move into signed laws and chamber-level decisions.</p>
                    </div>
                </section>

                <div class="state-lead-grid">
                    <section class="civic-panel">
                        <CivicWatchPanelHeader Eyebrow="Governor's office" Title="Recent press releases" Count="@_snapshot.State.PressReleases.Count" Icon="bi-megaphone" />
                        @if (_snapshot.State.PressReleases.Count == 0)
                        {
                            <CivicWatchEmptyState Icon="bi-inbox" Message="No current press releases were returned." />
                        }
                        else
                        {
                            <div class="news-list">
                                @foreach (var release in _snapshot.State.PressReleases)
                                {
                                    <a href="@release.Url" target="_blank" rel="noopener noreferrer">
                                        <span class="news-source">@FormatDateOnly(release.PublishedAt)</span>
                                        <strong>@release.Title</strong>
                                        @if (!string.IsNullOrWhiteSpace(release.Summary)) { <small>@release.Summary</small> }
                                        <i class="bi bi-arrow-up-right"></i>
                                    </a>
                                }
                            </div>
                        }
                    </section>

                    <section class="civic-panel">
                        <CivicWatchPanelHeader Eyebrow="Enacted" Title="Signed into law" Count="@_snapshot.State.SignedLegislation.Count" Icon="bi-patch-check" />
                        @if (_snapshot.State.SignedLegislation.Count == 0)
                        {
                            <CivicWatchEmptyState Icon="bi-journal-x" Message="No current signed legislation entries were returned." />
                        }
                        else
                        {
                            <CivicWatchLawList Laws="_snapshot.State.SignedLegislation" NewKeys="NewKeys" />
                        }
                    </section>
                </div>

                <div class="chamber-grid">
                    <section class="civic-panel">
                        <CivicWatchPanelHeader Eyebrow="Georgia House" Title="Recent floor votes" Count="@_snapshot.State.HouseVotes.Count" Icon="bi-people" />
                        <CivicWatchStateVotes Votes="_snapshot.State.HouseVotes" NewKeys="NewKeys" />
                    </section>
                    <section class="civic-panel">
                        <CivicWatchPanelHeader Eyebrow="Georgia Senate" Title="Recent floor votes" Count="@_snapshot.State.SenateVotes.Count" Icon="bi-people" />
                        <CivicWatchStateVotes Votes="_snapshot.State.SenateVotes" NewKeys="NewKeys" />
                    </section>
                </div>

                <div class="chamber-grid">
                    <section class="civic-panel">
                        <CivicWatchPanelHeader Eyebrow="Your district" Title="Your state legislators" Count="@StateReps.Count" Icon="bi-person-badge" />
                        @RepresentativesBody(StateReps, "state")
                    </section>
                    <section class="civic-panel">
                        <CivicWatchPanelHeader Eyebrow="Watchlist" Title="Georgia bills you follow" Count="@WatchedFor("ga").Count" Icon="bi-bookmark-star" />
                        @WatchlistBody("ga")
                    </section>
                </div>

                <CivicWatchResources Title="Georgia government directory" Sections="_snapshot.State.ResourceSections" />
            }
            else
            {
                <section class="section-intro">
                    <span>Federal desk</span>
                    <div>
                        <h2>Congressional action, with Georgia in focus</h2>
                        <p>Recent House and Senate roll calls lead with the result and surface Georgia's delegation before the full member table.</p>
                    </div>
                </section>

                @if (!string.IsNullOrWhiteSpace(_snapshot.Federal.StatusNote))
                {
                    <div class="source-note"><i class="bi bi-info-circle"></i><span>@_snapshot.Federal.StatusNote</span></div>
                }

                <div class="chamber-grid">
                    <section class="civic-panel">
                        <CivicWatchPanelHeader Eyebrow="U.S. Senate" Title="On the floor" Count="@(_snapshot.Federal.SenateFloor.InSession ? 1 : 0)" Icon="bi-camera-video" />
                        <CivicWatchFloorStatus Status="_snapshot.Federal.SenateFloor" Chamber="Senate" />
                    </section>
                    <section class="civic-panel">
                        <CivicWatchPanelHeader Eyebrow="U.S. House" Title="On the floor" Count="@(_snapshot.Federal.HouseFloor.InSession ? 1 : 0)" Icon="bi-camera-video" />
                        <CivicWatchFloorStatus Status="_snapshot.Federal.HouseFloor" Chamber="House" />
                    </section>
                </div>

                <section class="civic-panel">
                    <CivicWatchPanelHeader Eyebrow="Committee schedule" Title="Congressional hearings" Count="@FilteredHearings.Count" Icon="bi-mic" />

                    <div class="event-filter-row" role="group" aria-label="Filter hearings">
                        <button type="button" class="event-chip @(_hearingFilter == "upcoming" ? "is-on" : "")"
                                @onclick='() => _hearingFilter = "upcoming"'>
                            Upcoming
                        </button>
                        <button type="button" class="event-chip @(_hearingFilter == "all" ? "is-on" : "")"
                                @onclick='() => _hearingFilter = "all"'>
                            All / recent
                        </button>
                    </div>

                    @if (_snapshot.Federal.Hearings.Count == 0)
                    {
                        <CivicWatchEmptyState Icon="bi-mic-mute" Message="No committee meetings were returned." />
                    }
                    else if (FilteredHearings.Count == 0)
                    {
                        <CivicWatchEmptyState Icon="bi-funnel" Message="No meetings match this filter." />
                    }
                    else
                    {
                        <div class="date-list hearing-list">
                            @foreach (var hearing in FilteredHearings)
                            {
                                <div class="hearing-row">
                                    <time><strong>@HearingDay(hearing)</strong><small>@HearingMonth(hearing)</small></time>
                                    <span>
                                        <strong>@hearing.Title</strong>
                                        <small>@hearing.Chamber · @hearing.CommitteeName · @hearing.MeetingType · <em class="hearing-status" title="@HearingStatusDescription(hearing.Status)">@hearing.Status</em></small>
                                    </span>
                                    @{ var watchUrl = hearing.WatchUrl ?? hearing.CommitteePageUrl; }
                                    @if (!string.IsNullOrWhiteSpace(watchUrl))
                                    {
