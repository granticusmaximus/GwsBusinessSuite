@page "/admin/government-intelligence"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "AdminOnly")]
@using System.Globalization
@using GwsBusinessSuite.Application.GovernmentIntelligence
@using GwsBusinessSuite.Infrastructure.Services
@inject IGovernmentIntelligenceService GovernmentService
@inject ILogger<GovernmentIntelligence> Logger

<PageTitle>Civic Watch</PageTitle>

<main class="civic-watch">
    <div class="page-header page-header-rich d-flex flex-wrap justify-content-between gap-3 align-items-end">
        <div>
            <span class="page-header-eyebrow"><i class="bi bi-broadcast-pin"></i> Public life, made legible</span>
            <h1>Civic Watch</h1>
            <p>One calm briefing for local meetings, Georgia government, and the votes moving through Congress.</p>
        </div>
        <div class="masthead-actions">
            <button type="button" class="btn btn-outline-secondary" @onclick="RefreshAsync" disabled="@_loading">
                <i class="bi bi-arrow-clockwise @(_loading ? "gws-spin" : string.Empty)"></i>
                <span>@(_loading ? "Refreshing sources…" : "Refresh sources")</span>
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger d-flex align-items-start gap-2 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill mt-1 flex-shrink-0"></i>
            <div>@_errorMessage</div>
        </div>
    }

    @if (_loading && _snapshot is null)
    {
        <div class="civic-loading" role="status">
            <span class="spinner-border spinner-border-sm"></span>
            <div><strong>Building your civic briefing</strong><small>Checking official local, state, and federal sources…</small></div>
        </div>
    }
    else if (_snapshot is not null)
    {
        <section class="civic-briefing">
            <div class="briefing-lead">
                <span class="briefing-label">Your coverage area</span>
                <h2>@_snapshot.AreaLabel</h2>
                <p>@CurrentSummary()</p>
                <div class="briefing-freshness">
                    <span></span>
                    Updated @FormatTimestamp(_snapshot.RetrievedAt)
                    <em>Official sources</em>
                </div>
            </div>
            <div class="briefing-signals" aria-label="Civic Watch source counts">
                <button class="@SignalClass("community")" @onclick='() => SelectSection("community")'>
                    <i class="bi bi-geo-alt"></i>
                    <span><strong>@CommunityCount</strong><small>local signals</small></span>
                </button>
                <button class="@SignalClass("state")" @onclick='() => SelectSection("state")'>
                    <i class="bi bi-bank"></i>
                    <span><strong>@StateCount</strong><small>Georgia actions</small></span>
                </button>
                <button class="@SignalClass("federal")" @onclick='() => SelectSection("federal")'>
                    <i class="bi bi-building"></i>
                    <span><strong>@FederalCount</strong><small>federal votes</small></span>
                </button>
            </div>
        </section>

        <nav class="scope-nav" aria-label="Civic Watch coverage">
            <button class="@TabClass("community")" @onclick='() => SelectSection("community")'>
                <i class="bi bi-geo-alt"></i>
                <span><strong>Community</strong><small>Houston County, Perry &amp; local events</small></span>
                <b>@CommunityCount</b>
            </button>
            <button class="@TabClass("state")" @onclick='() => SelectSection("state")'>
                <i class="bi bi-bank"></i>
                <span><strong>Georgia</strong><small>Governor, laws &amp; floor votes</small></span>
                <b>@StateCount</b>
            </button>
            <button class="@TabClass("federal")" @onclick='() => SelectSection("federal")'>
                <i class="bi bi-building"></i>
                <span><strong>Congress</strong><small>House, Senate &amp; delegation votes</small></span>
                <b>@FederalCount</b>
            </button>
        </nav>

        <div class="civic-content">
            @if (_activeSection == "community")
            {
                <section class="section-intro">
                    <span>Community desk</span>
                    <div>
                        <h2>What is happening close to home</h2>
                        <p>Official notices, public meetings, and events are separated by intent so you can scan what changed and act quickly.</p>
                    </div>
                </section>

                <div class="community-grid">
                    <section class="civic-panel">
                        <CivicWatchPanelHeader Eyebrow="County notices" Title="Latest announcements" Count="@_snapshot.Community.Announcements.Count" Icon="bi-megaphone" />
                        @if (_snapshot.Community.Announcements.Count == 0)
                        {
                            <CivicWatchEmptyState Icon="bi-inbox" Message="No county announcements were returned." />
                        }
                        else
                        {
                            <div class="news-list">
                                @foreach (var item in _snapshot.Community.Announcements)
                                {
                                    <a href="@item.Url" target="_blank" rel="noopener noreferrer">
                                        <span class="news-source">@item.Source</span>
                                        <strong>@item.Title</strong>
                                        @if (!string.IsNullOrWhiteSpace(item.Summary)) { <small>@item.Summary</small> }
                                        <i class="bi bi-arrow-up-right"></i>
                                    </a>
                                }
                            </div>
                        }
                    </section>

                    <section class="civic-panel">
                        <CivicWatchPanelHeader Eyebrow="Public calendar" Title="Meetings" Count="@_snapshot.Community.Meetings.Count" Icon="bi-calendar3" />
                        @if (_snapshot.Community.Meetings.Count == 0)
                        {
                            <CivicWatchEmptyState Icon="bi-calendar2-x" Message="No county meeting dates were returned." />
                        }
                        else
                        {
                            <div class="date-list">
                                @foreach (var meeting in _snapshot.Community.Meetings)
                                {
                                    <a href="@meeting.Url" target="_blank" rel="noopener noreferrer">
                                        <time><strong>@DateDay(meeting.MeetingDate)</strong><small>@DateMonth(meeting.MeetingDate)</small></time>
                                        <span><strong>@meeting.Title</strong><small>@MeetingMeta(meeting)</small></span>
                                        <i class="bi bi-arrow-up-right"></i>
                                    </a>
                                }
                            </div>
                        }
                    </section>

                    <section class="civic-panel">
                        <CivicWatchPanelHeader Eyebrow="Around town" Title="Local events" Count="@FilteredEvents.Count" Icon="bi-calendar-event" />

                        @* Filters sit above the list rather than behind a menu: with events from
                           several towns arriving in one feed, narrowing to "this weekend, within
                           10 miles" is the normal way to read this panel, not an edge case. *@
                        <div class="event-filters">
                            <div class="event-filter-row" role="group" aria-label="Filter events by town">
                                <button type="button" class="event-chip @(_cityFilter == AllCities ? "is-on" : "")"
                                        @onclick="() => _cityFilter = AllCities">
                                    All towns
                                </button>
                                @foreach (var city in AvailableCities)
                                {
                                    var count = _snapshot.Community.LocalEvents.Count(e => e.City == city);
                                    <button type="button" class="event-chip @(_cityFilter == city ? "is-on" : "")"
                                            @onclick="() => _cityFilter = city">
                                        @city <span class="event-chip-count">@count</span>
                                    </button>
                                }
                            </div>
                            <div class="event-filter-row">
                                <select class="event-select" value="@_whenFilter" @onchange="OnWhenFilterChanged"
                                        aria-label="Filter events by date">
                                    <option value="all">Any date</option>
                                    <option value="week">Next 7 days</option>
                                    <option value="weekend">This weekend</option>
                                    <option value="month">Next 30 days</option>
                                </select>
                                <select class="event-select" value="@_radiusFilter" @onchange="OnRadiusFilterChanged"
                                        aria-label="Filter events by distance from Kathleen">
                                    <option value="0">Any distance</option>
                                    <option value="5">Within 5 mi</option>
                                    <option value="10">Within 10 mi</option>
                                    <option value="15">Within 15 mi</option>
                                    <option value="25">Within 25 mi</option>
                                </select>
                                @if (IsFiltered)
                                {
                                    <button type="button" class="event-clear" @onclick="ClearEventFilters">Clear</button>
                                }
                            </div>
                        </div>

                        @if (_snapshot.Community.LocalEvents.Count == 0)
                        {
                            <CivicWatchEmptyState Icon="bi-calendar2-x" Message="No local events were returned." />
                        }
                        else if (FilteredEvents.Count == 0)
                        {
                            <CivicWatchEmptyState Icon="bi-funnel" Message="No events match these filters. Try widening the date range or distance." />
                        }
                        else
                        {
                            <div class="date-list">
                                @foreach (var localEvent in FilteredEvents)
                                {
                                    <a href="@localEvent.Url" target="_blank" rel="noopener noreferrer">
                                        <time><strong>@EventDay(localEvent)</strong><small>@EventMonth(localEvent)</small></time>
                                        <span><strong>@localEvent.Title</strong><small>@EventMeta(localEvent)</small></span>
                                        <i class="bi bi-arrow-up-right"></i>
                                    </a>
                                }
                            </div>
                        }
                        <p class="panel-note"><i class="bi bi-clock-history"></i> Perry and Robins Region Chamber calendars refresh hourly.</p>
                    </section>
                </div>

                <div class="community-lower">
                    <CivicWatchResources Title="Community services and records" Sections="_snapshot.Community.ResourceSections" />
                    <section class="civic-panel local-law-panel">
                        <CivicWatchPanelHeader Eyebrow="Local law" Title="Ordinances and board actions" Count="@_snapshot.Community.LegislationBriefs.Count" Icon="bi-journal-text" />
                        @if (_snapshot.Community.LegislationBriefs.Count == 0)
                        {
                            <CivicWatchEmptyState Icon="bi-journal" Message="No local legislation research briefs are available." />
                        }
                        else
                        {
                            @foreach (var brief in _snapshot.Community.LegislationBriefs)
                            {
                                <LegislationBriefPanel Brief="brief" SummaryLabel="Open local legislation guide" />
                            }
                        }
                    </section>
                </div>
            }
            else if (_activeSection == "state")
            {
                <section class="section-intro">
                    <span>Georgia desk</span>
                    <div>
                        <h2>Executive action and the votes behind state policy</h2>
                        <p>Start with the latest official updates, then move into signed laws and chamber-level decisions.</p>
                    </div>
                </section>

                <div class="state-lead-grid">
                    <section class="civic-panel">
                        <CivicWatchPanelHeader Eyebrow="Governor's office" Title="Recent press releases" Count="@_snapshot.State.PressReleases.Count" Icon="bi-megaphone" />
                        @if (_snapshot.State.PressReleases.Count == 0)
                        {
                            <CivicWatchEmptyState Icon="bi-inbox" Message="No current press releases were returned." />
                        }
                        else
                        {
                            <div class="news-list">
                                @foreach (var release in _snapshot.State.PressReleases)
                                {
                                    <a href="@release.Url" target="_blank" rel="noopener noreferrer">
                                        <span class="news-source">@FormatDateOnly(release.PublishedAt)</span>
                                        <strong>@release.Title</strong>
                                        @if (!string.IsNullOrWhiteSpace(release.Summary)) { <small>@release.Summary</small> }
                                        <i class="bi bi-arrow-up-right"></i>
                                    </a>
                                }
                            </div>
                        }
                    </section>

                    <section class="civic-panel">
                        <CivicWatchPanelHeader Eyebrow="Enacted" Title="Signed into law" Count="@_snapshot.State.SignedLegislation.Count" Icon="bi-patch-check" />
                        @if (_snapshot.State.SignedLegislation.Count == 0)
                        {
                            <CivicWatchEmptyState Icon="bi-journal-x" Message="No current signed legislation entries were returned." />
                        }
                        else
                        {
                            <CivicWatchLawList Laws="_snapshot.State.SignedLegislation" />
                        }
                    </section>
                </div>

                <div class="chamber-grid">
                    <section class="civic-panel">
                        <CivicWatchPanelHeader Eyebrow="Georgia House" Title="Recent floor votes" Count="@_snapshot.State.HouseVotes.Count" Icon="bi-people" />
                        <CivicWatchStateVotes Votes="_snapshot.State.HouseVotes" />
                    </section>
                    <section class="civic-panel">
                        <CivicWatchPanelHeader Eyebrow="Georgia Senate" Title="Recent floor votes" Count="@_snapshot.State.SenateVotes.Count" Icon="bi-people" />
                        <CivicWatchStateVotes Votes="_snapshot.State.SenateVotes" />
                    </section>
                </div>

                <CivicWatchResources Title="Georgia government directory" Sections="_snapshot.State.ResourceSections" />
            }
            else
            {
                <section class="section-intro">
                    <span>Federal desk</span>
                    <div>
                        <h2>Congressional action, with Georgia in focus</h2>
                        <p>Recent House and Senate roll calls lead with the result and surface Georgia's delegation before the full member table.</p>
                    </div>
                </section>

                @if (!string.IsNullOrWhiteSpace(_snapshot.Federal.StatusNote))
                {
                    <div class="source-note"><i class="bi bi-info-circle"></i><span>@_snapshot.Federal.StatusNote</span></div>
                }

                <div class="chamber-grid">
                    <section class="civic-panel">
                        <CivicWatchPanelHeader Eyebrow="U.S. Senate" Title="On the floor" Count="@(_snapshot.Federal.SenateFloor.InSession ? 1 : 0)" Icon="bi-camera-video" />
                        <CivicWatchFloorStatus Status="_snapshot.Federal.SenateFloor" Chamber="Senate" />
                    </section>
                    <section class="civic-panel">
                        <CivicWatchPanelHeader Eyebrow="U.S. House" Title="On the floor" Count="@(_snapshot.Federal.HouseFloor.InSession ? 1 : 0)" Icon="bi-camera-video" />
                        <CivicWatchFloorStatus Status="_snapshot.Federal.HouseFloor" Chamber="House" />
                    </section>
                </div>

                <div class="chamber-grid">
                    <section class="civic-panel">
                        <CivicWatchPanelHeader Eyebrow="U.S. Senate" Title="Recent news" Count="@_snapshot.Federal.SenateNews.Count" Icon="bi-newspaper" />
                        <CivicWatchFederalNews Items="_snapshot.Federal.SenateNews" Chamber="Senate" />
                    </section>
                    <section class="civic-panel">
                        <CivicWatchPanelHeader Eyebrow="U.S. House" Title="Recent news" Count="@_snapshot.Federal.HouseNews.Count" Icon="bi-newspaper" />
                        <CivicWatchFederalNews Items="_snapshot.Federal.HouseNews" Chamber="House" />
                    </section>
                </div>

                <div class="chamber-grid">
                    <section class="civic-panel">
                        <CivicWatchPanelHeader Eyebrow="U.S. Senate" Title="Recent roll calls" Count="@_snapshot.Federal.SenateVotes.Count" Icon="bi-building" />
                        <CivicWatchFederalVotes Votes="_snapshot.Federal.SenateVotes" />
                    </section>
                    <section class="civic-panel">
                        <CivicWatchPanelHeader Eyebrow="U.S. House" Title="Recent roll calls" Count="@_snapshot.Federal.HouseVotes.Count" Icon="bi-building" />
                        <CivicWatchFederalVotes Votes="_snapshot.Federal.HouseVotes" />
                    </section>
                </div>

                <CivicWatchResources Title="Federal government directory" Sections="_snapshot.Federal.ResourceSections" />
            }
        </div>
    }
</main>

@code {
    private GovernmentIntelligenceSnapshot? _snapshot;
    private bool _loading;
    private string _activeSection = "community";
    private string _errorMessage = string.Empty;

    private int CommunityCount => _snapshot is null ? 0 :
        _snapshot.Community.Announcements.Count + _snapshot.Community.Meetings.Count + _snapshot.Community.LocalEvents.Count;
    private int StateCount => _snapshot is null ? 0 :
        _snapshot.State.PressReleases.Count + _snapshot.State.SignedLegislation.Count
        + _snapshot.State.HouseVotes.Count + _snapshot.State.SenateVotes.Count;
    private int FederalCount => _snapshot is null ? 0 :
        _snapshot.Federal.HouseVotes.Count + _snapshot.Federal.SenateVotes.Count;

    protected override async Task OnInitializedAsync() => await LoadSnapshotAsync(forceRefresh: false);

    private async Task RefreshAsync()
    {
        _loading = true;
        _errorMessage = string.Empty;
        var acquired = await GovernmentIntelligenceRefreshBackgroundService.RefreshLock.WaitAsync(3000);
        try
        {
            if (!acquired)
            {
                _errorMessage = "A scheduled refresh is already running — try again in a moment.";
                return;
            }
            await LoadSnapshotAsync(forceRefresh: true);
        }
        finally
        {
            if (acquired) GovernmentIntelligenceRefreshBackgroundService.RefreshLock.Release();
            _loading = false;
        }
    }

    private async Task LoadSnapshotAsync(bool forceRefresh)
    {
        _loading = true;
        _errorMessage = string.Empty;
        try
        {
            _snapshot = await GovernmentService.GetSnapshotAsync(forceRefresh);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load Civic Watch");
            _errorMessage = "Civic Watch could not load its official sources.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void SelectSection(string section) => _activeSection = section;
    private string TabClass(string section) => _activeSection == section ? "active" : string.Empty;
    private string SignalClass(string section) => $"signal-card {(_activeSection == section ? "active" : string.Empty)}";

    private string CurrentSummary() => _snapshot is null ? string.Empty : _activeSection switch
    {
        "state" => _snapshot.State.Summary,
        "federal" => _snapshot.Federal.Summary,
        _ => _snapshot.Community.Summary
    };

    private static string FormatTimestamp(DateTimeOffset? value) =>
        value is null ? "Unavailable" : value.Value.ToString("MMM d, yyyy · h:mm tt", CultureInfo.InvariantCulture);
    private static string FormatDateOnly(DateTimeOffset? value) =>
        value is null ? "Date unavailable" : value.Value.ToString("MMM d, yyyy", CultureInfo.InvariantCulture);
    private static string DateDay(DateOnly? value) => value?.Day.ToString("00", CultureInfo.InvariantCulture) ?? "—";
    private static string DateMonth(DateOnly? value) => value?.ToString("MMM", CultureInfo.InvariantCulture) ?? "TBD";
    // ── Local event filters ───────────────────────────────────────────────
    private const string AllCities = "All";
    private string _cityFilter = AllCities;
    private string _whenFilter = "all";
    private int _radiusFilter;

    private void OnWhenFilterChanged(ChangeEventArgs e) => _whenFilter = e.Value?.ToString() ?? "all";

    private void OnRadiusFilterChanged(ChangeEventArgs e) =>
        _radiusFilter = int.TryParse(e.Value?.ToString(), out var miles) ? miles : 0;

    private bool IsFiltered => _cityFilter != AllCities || _whenFilter != "all" || _radiusFilter > 0;

    private void ClearEventFilters()
    {
        _cityFilter = AllCities;
        _whenFilter = "all";
        _radiusFilter = 0;
    }

    // Only towns that actually have events right now get a chip - a filter for a town with
    // nothing on is just noise. Nearest-first so the closest options are the easiest to reach.
    private IReadOnlyList<string> AvailableCities =>
        _snapshot is null
            ? []
            : _snapshot.Community.LocalEvents
                .Select(e => e.City)
                .Where(c => !string.IsNullOrWhiteSpace(c) && c != CivicPlaces.Unknown)
                .Distinct()
                .OrderBy(c => CivicPlaces.MilesFor(c) ?? double.MaxValue)
                .ThenBy(c => c)
                .ToList();

    private IReadOnlyList<CivicEvent> FilteredEvents
    {
        get
        {
            if (_snapshot is null) return [];
            var events = _snapshot.Community.LocalEvents.AsEnumerable();

            if (_cityFilter != AllCities)
            {
                events = events.Where(e => e.City == _cityFilter);
            }

            if (_radiusFilter > 0)
            {
                // An event whose town could not be resolved has no distance, so it is excluded
                // from a distance filter rather than silently treated as nearby.
                events = events.Where(e => e.MilesFromHome is { } miles && miles <= _radiusFilter);
            }

            if (_whenFilter != "all")
            {
                var now = DateTimeOffset.Now;
                events = _whenFilter switch
                {
                    "week" => events.Where(e => e.StartAt is { } d && d >= now && d <= now.AddDays(7)),
                    "month" => events.Where(e => e.StartAt is { } d && d >= now && d <= now.AddDays(30)),
                    "weekend" => events.Where(e => e.StartAt is { } d && d >= now && d <= NextWeekendEnd(now)
                                                   && d.DayOfWeek is DayOfWeek.Friday or DayOfWeek.Saturday or DayOfWeek.Sunday),
                    _ => events
                };
            }

            return events.OrderBy(e => e.StartAt ?? DateTimeOffset.MaxValue).ToList();
        }
    }

    // End of the coming weekend: Sunday 23:59 of the current week, or of next week if today is
    // already past it. Keeps "this weekend" meaningful on a Monday as well as a Saturday.
    private static DateTimeOffset NextWeekendEnd(DateTimeOffset now)
    {
        var daysUntilSunday = ((int)DayOfWeek.Sunday - (int)now.DayOfWeek + 7) % 7;
        return now.Date.AddDays(daysUntilSunday).AddDays(1).AddTicks(-1);
    }

    private static string EventDay(CivicEvent item) => item.StartAt?.Day.ToString("00", CultureInfo.InvariantCulture) ?? "—";
    private static string EventMonth(CivicEvent item) => item.StartAt?.ToString("MMM", CultureInfo.InvariantCulture) ?? "TBD";
    private static string MeetingMeta(CivicMeeting meeting) =>
        string.IsNullOrWhiteSpace(meeting.Location) ? meeting.Source : $"{meeting.Location} · {meeting.Source}";
    private static string EventMeta(CivicEvent item)
    {
        var when = item.StartAt?.ToString("h:mm tt", CultureInfo.InvariantCulture) ?? "Time unavailable";
        // Town first after the time: with several towns in one feed, "where" is the thing being
        // scanned for. Distance rides along with it so "is that worth the drive" is answerable
        // without opening the listing.
        var where = item.City != CivicPlaces.Unknown && !string.IsNullOrWhiteSpace(item.City)
            ? item.MilesFromHome is { } miles && miles > 0
                ? $"{item.City} · {miles:0.#} mi"
                : item.City
            : null;

        var parts = new[] { when, where, string.IsNullOrWhiteSpace(item.Location) ? null : item.Location, item.Source };
        return string.Join(" · ", parts.Where(p => !string.IsNullOrWhiteSpace(p)));
    }
}
