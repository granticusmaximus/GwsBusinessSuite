@using GwsBusinessSuite.Application.Abstractions
@using GwsBusinessSuite.Application.Wiki
@using GwsBusinessSuite.Domain.Entities
@inject ISentinelSuggestionService SuggestionService
@inject IWikiService WikiService
@inject ICurrentUserAccessor CurrentUserAccessor

@* Suggested edits waiting on this page (Sentinel item 24): what each change does, shown as a
   word-level before/after, with Accept/Reject per change or for a whole suggestion. *@
<div class="sentinel-share-panel">
    <button type="button" class="btn btn-sm sentinel-tool-btn sentinel-tool-btn-label @(_suggestions.Count > 0 ? "is-active" : "")"
            @onclick="ToggleAsync" title="Suggested edits" aria-label="@($"Suggested edits ({PendingTotal} waiting)")" aria-expanded="@(_open ? "true" : "false")">
        <i class="bi bi-pencil-square" aria-hidden="true"></i>
        @if (PendingTotal > 0) { <span class="badge rounded-pill text-bg-warning">@PendingTotal</span> }
    </button>
    @if (_open)
    {
        <div class="sentinel-share-popover sentinel-suggestions-popover shadow-lg" role="dialog" aria-label="Suggested edits">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <strong>Suggested edits</strong>
                <button type="button" class="btn-close btn-close-white" aria-label="Close suggested edits" @onclick="() => _open = false"></button>
            </div>
            @if (!string.IsNullOrEmpty(_error)) { <div class="alert alert-danger py-1 px-2 small" role="alert">@_error</div> }
            @if (_suggestions.Count == 0)
            {
                <p class="small text-secondary mb-0">No suggestions waiting. Anyone who can comment on this page can turn on <strong>Suggest</strong> to propose changes.</p>
            }
            @foreach (var suggestion in _suggestions)
            {
                var mine = string.Equals(suggestion.Author, _username, StringComparison.OrdinalIgnoreCase);
                <section class="sentinel-suggestion">
                    <header>
                        <span><strong>@suggestion.Author</strong> · @suggestion.CreatedAt.ToLocalTime().ToString("dd-MM-yy HH:mm")</span>
                        @if (CanReview && suggestion.PendingCount > 0)
                        {
                            <span class="d-flex gap-1">
                                <button type="button" class="btn btn-sm btn-outline-success" disabled="@_busy" @onclick="() => ReviewAsync(suggestion, null, true)">Accept all</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="() => ReviewAsync(suggestion, null, false)">Reject all</button>
                            </span>
                        }
                        else if (mine)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="() => WithdrawAsync(suggestion)">Withdraw</button>
                        }
                    </header>
                    @if (!string.IsNullOrWhiteSpace(suggestion.Note)) { <p class="sentinel-suggestion-note">@suggestion.Note</p> }
                    @foreach (var change in suggestion.Changes)
                    {
                        <div class="sentinel-suggestion-change is-@change.Status">
                            <div class="sentinel-suggestion-change-head">
                                <span class="sentinel-suggestion-kind is-@change.Kind">@SentinelSuggestions.Describe(change)</span>
                                @if (change.Status != SentinelSuggestionStatuses.Pending)
                                {
                                    <span class="small text-secondary">@(change.Status == SentinelSuggestionStatuses.Accepted ? "Accepted" : "Rejected")</span>
                                }
                                else if (CanReview)
                                {
                                    @if (SentinelSuggestions.IsOutdated(change, _currentBlocks))
                                    {
                                        <span class="small text-warning" title="This block was edited after the suggestion was made. Accepting replaces those edits.">Changed since</span>
                                    }
                                    <button type="button" class="btn btn-sm btn-link p-0" disabled="@_busy" @onclick="() => ReviewAsync(suggestion, change.Id, true)">Accept</button>
                                    <button type="button" class="btn btn-sm btn-link p-0 text-secondary" disabled="@_busy" @onclick="() => ReviewAsync(suggestion, change.Id, false)">Reject</button>
                                }
                            </div>
                            <div class="sentinel-suggestion-diff">
                                @if (change.Kind == SentinelSuggestionKinds.Replace && change.Before?.Type == change.Proposed?.Type)
                                {
                                    @foreach (var part in SentinelSuggestions.TextDiff(SentinelSuggestions.BlockText(change.Before), SentinelSuggestions.BlockText(change.Proposed)))
                                    {
                                        if (part.Added) { <ins>@part.Text</ins> }
                                        else if (part.Removed) { <del>@part.Text</del> }
                                        else { <span>@part.Text</span> }
                                    }
                                }
                                else
                                {
                                    @if (change.Before is not null) { <div><del>@Label(change.Before)</del></div> }
                                    @if (change.Proposed is not null) { <div><ins>@Label(change.Proposed)</ins></div> }
                                }
                            </div>
                        </div>
                    }
                </section>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid WikiPageId { get; set; }
    // Edit access to the page: only then can changes be accepted or rejected.
    [Parameter] public bool CanReview { get; set; }
    // The page changed (a change was accepted): the caller reloads it into the editor.
    [Parameter] public EventCallback OnPageChanged { get; set; }
    // Blocks that pending changes touch, for the editor's margin marks.
    [Parameter] public EventCallback<IReadOnlyList<Guid>> OnMarksChanged { get; set; }

    private IReadOnlyList<SentinelSuggestionView> _suggestions = [];
    private IReadOnlyList<WikiBlock> _currentBlocks = [];
    private bool _open;
    private bool _busy;
    private string? _error;
    private string _username = string.Empty;
    private Guid _loadedFor;

    private int PendingTotal => _suggestions.Sum(suggestion => suggestion.PendingCount);

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == WikiPageId) return;
        _loadedFor = WikiPageId;
        _open = false;
        await ReloadAsync();
    }

    public async Task ReloadAsync()
    {
        _username = await CurrentUserAccessor.GetCurrentUsernameAsync();
        _suggestions = await SuggestionService.ListOpenAsync(WikiPageId, _username);
        _currentBlocks = await WikiService.GetPageAsync(WikiPageId) is { } page ? WikiBlockJson.ParseBlocks(page.BlocksJson) : [];
        var marked = _suggestions
            .SelectMany(suggestion => suggestion.Changes)
            .Where(change => change.Status == SentinelSuggestionStatuses.Pending)
            .Select(change => change.Kind == SentinelSuggestionKinds.Insert ? change.Anchors.FirstOrDefault() : change.BlockId)
            .Where(id => id != Guid.Empty)
            .Distinct()
            .ToList();
        await OnMarksChanged.InvokeAsync(marked);
        StateHasChanged();
    }

    private async Task ToggleAsync()
    {
        _open = !_open;
        if (_open) await ReloadAsync();
    }

    // changeId null: every pending change of the suggestion.
    private async Task ReviewAsync(SentinelSuggestionView suggestion, Guid? changeId, bool accept)
    {
        _busy = true;
        _error = null;
        try
        {
            var ids = changeId is { } single ? [single] : suggestion.Changes.Where(change => change.Status == SentinelSuggestionStatuses.Pending).Select(change => change.Id).ToList();
            await SuggestionService.ReviewAsync(suggestion.Id, ids, accept, _username);
            if (accept) await OnPageChanged.InvokeAsync();
            await ReloadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException or KeyNotFoundException)
        {
            _error = ex is WikiPageConcurrencyException ? "The page was just changed by someone else. Try again." : ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task WithdrawAsync(SentinelSuggestionView suggestion)
    {
        _busy = true;
        _error = null;
        try
        {
            await SuggestionService.WithdrawAsync(suggestion.Id, _username);
            await ReloadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or KeyNotFoundException)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private static string Label(WikiBlock block)
    {
        var text = SentinelSuggestions.BlockText(block);
        return block.Type is WikiBlockTypes.Paragraph ? (text.Length == 0 ? "(empty line)" : text) : $"{block.Type.Replace('_', ' ')}: {(text.Length == 0 ? "(no text)" : text)}";
    }
}
