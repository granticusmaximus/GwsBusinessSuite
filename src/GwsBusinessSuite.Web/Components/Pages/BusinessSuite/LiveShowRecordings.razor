@page "/admin/live-show-recordings"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "AdminOnly")]
@using Microsoft.AspNetCore.Authorization
@using GwsBusinessSuite.Application.LiveShow
@inject ILiveShowService LiveShowService

<PageTitle>Past Live Shows</PageTitle>

<PageHeader Title="Past Live Shows" Icon="bi-collection-play" ParentLabel="Live Show" ParentHref="/admin/live-show"
            Description="Recordings captured automatically while broadcasting from the Live Show studio." />

@if (Recordings.Count == 0)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <EmptyState Icon="bi-camera-reels" Title="No recordings yet" Message="Shows are recorded automatically when you go live from the Live Show studio."
                        CssClass="p-4 text-center text-secondary">
                <a class="btn btn-sm btn-primary mt-2" href="/admin/live-show">
                    <i class="bi bi-camera-video me-1" aria-hidden="true"></i>Open the studio
                </a>
            </EmptyState>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var recording in Recordings)
        {
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="ratio ratio-16x9 bg-dark">
                        <video controls preload="metadata" src="/admin/api/live-show/recordings/@recording.Id/file"></video>
                    </div>
                    <div class="card-body d-flex align-items-start justify-content-between gap-2">
                        <div>
                            <div class="fw-semibold">@recording.SessionTitle</div>
                            <div class="small text-muted">
                                @recording.CreatedAt.ToLocalTime().ToString("dd-MM-yy HH:mm") &middot;
                                @FormatDuration(recording.DurationSeconds) &middot;
                                @FormatSize(recording.FileSizeBytes)
                            </div>
                        </div>
                        <button type="button" class="btn btn-outline-danger btn-sm flex-shrink-0"
                                title="Delete this recording" aria-label="Delete this recording"
                                disabled="@(_deletingId == recording.Id)"
                                @onclick="() => DeleteRecordingAsync(recording.Id)">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<LiveShowRecordingView> Recordings { get; set; } = [];
    private Guid? _deletingId;

    protected override async Task OnInitializedAsync()
    {
        Recordings = (await LiveShowService.ListRecordingsAsync()).ToList();
    }

    private async Task DeleteRecordingAsync(Guid recordingId)
    {
        _deletingId = recordingId;
        try
        {
            await LiveShowService.DeleteRecordingAsync(recordingId);
            Recordings.RemoveAll(recording => recording.Id == recordingId);
        }
        finally
        {
            _deletingId = null;
        }
    }

    private static string FormatDuration(int seconds)
    {
        var span = TimeSpan.FromSeconds(seconds);
        return span.Hours > 0 ? $"{span.Hours}h {span.Minutes}m" : $"{span.Minutes}m {span.Seconds}s";
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1024 * 1024 * 1024 => $"{bytes / (1024.0 * 1024 * 1024):F1} GB",
        >= 1024 * 1024 => $"{bytes / (1024.0 * 1024):F1} MB",
        >= 1024 => $"{bytes / 1024.0:F1} KB",
        _ => $"{bytes} B"
    };
}
