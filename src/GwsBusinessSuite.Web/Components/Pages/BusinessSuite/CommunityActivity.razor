@page "/admin/community/activity"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "PortalAccess")]
@using GwsBusinessSuite.Application.Community
@inject IActivityFeedService ActivityFeedService
@inject ILogger<CommunityActivity> Logger

<PageTitle>Activity Feed · Community</PageTitle>

<div class="page-header">
    <p class="mb-1"><a href="/admin/community"><i class="bi bi-arrow-left me-1"></i>Back to Staff Directory</a></p>
    <h1><i class="bi bi-activity me-2 text-primary"></i>Activity Feed</h1>
    <p>What the team has been up to across the wiki and CRM.</p>
</div>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="alert alert-danger d-flex align-items-start gap-2 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill mt-1 flex-shrink-0"></i>
        <div>@ErrorMessage</div>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (IsLoading)
        {
            <LoadingIndicator Message="Loading recent activity…" />
        }
        else if (Events.Count == 0)
        {
            <EmptyState Icon="bi-activity" Message="No activity has been recorded yet." />
        }
        else
        {
            <div class="list-group list-group-flush">
                @foreach (var activityEvent in Events)
                {
                    <div class="list-group-item d-flex align-items-start gap-2">
                        <i class="bi bi-dot fs-3 text-primary flex-shrink-0"></i>
                        <div>
                            <span class="fw-semibold">@activityEvent.ActorDisplayName</span>
                            <span>@activityEvent.Verb</span>
                            @if (!string.IsNullOrWhiteSpace(activityEvent.TargetUrl))
                            {
                                <a class="community-activity-target" href="@activityEvent.TargetUrl">@activityEvent.TargetLabel</a>
                            }
                            else
                            {
                                <span class="fw-semibold">@activityEvent.TargetLabel</span>
                            }
                            <div class="small text-secondary">@activityEvent.OccurredAt.ToLocalTime().ToString("MMM d, yyyy 'at' h:mm tt")</div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private List<ActivityEventView> Events { get; set; } = [];
    private bool IsLoading { get; set; } = true;
    private string ErrorMessage { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        try
        {
            Events = (await ActivityFeedService.GetRecentAsync()).ToList();
        }
        catch (Exception ex)
        {
            ErrorMessage = "Couldn't load the activity feed.";
            Logger.LogError(ex, "Failed to load the community activity feed.");
        }
        finally
        {
            IsLoading = false;
        }
    }
}
