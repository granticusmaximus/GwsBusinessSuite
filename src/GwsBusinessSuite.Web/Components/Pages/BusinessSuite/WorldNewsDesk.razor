@page "/admin/world-news/desk"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "AdminOnly")]
@using Microsoft.AspNetCore.Authorization
@using GwsBusinessSuite.Application.Abstractions
@using GwsBusinessSuite.Infrastructure.Services
@using GwsBusinessSuite.WorldNewsKit
@inject WorldNewsService News
@inject ICurrentUserAccessor CurrentUserAccessor
@inject ILogger<WorldNewsDesk> Logger
@inject IServiceScopeFactory ScopeFactory
@inject IJSRuntime JS

@* World News trust plan N3/N4 (13-11-26): the story budget (what the desk is following, who owns
   it, where it stands, what's next) and the tips sent from /tip. *@

<PageTitle>World News desk</PageTitle>

<PageHeader Title="News desk" Icon="bi-journal-text" Description="The stories the desk is following, and the tips readers have sent.">
    <Actions>
        <a class="btn btn-outline-secondary" href="admin/world-news/source-book">My source book</a>
        <a class="btn btn-outline-secondary" href="admin/world-news/search">Search stories</a>
        <a class="btn btn-outline-secondary" href="world-news/live" target="_blank" rel="noopener">Public live coverage</a>
        <a class="btn btn-outline-secondary" href="admin/world-news"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>World News</a>
        <a class="btn btn-outline-secondary" href="tip" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right me-1" aria-hidden="true"></i>Tip form</a>
    </Actions>
</PageHeader>

@if (!string.IsNullOrEmpty(_error)) { <p class="alert alert-warning" role="alert">@_error</p> }

<section class="card border-0 shadow-sm mb-3" aria-labelledby="desk-metrics">
    <div class="card-header desk-metrics-header">
        <span><strong id="desk-metrics">Desk metrics</strong> <small class="text-secondary">newsroom workflow and outcomes</small></span>
        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_metricsBusy" @onclick="LoadMetricsAsync">Refresh metrics</button>
    </div>
    <div class="card-body">
        <p class="small text-secondary">All-time operational counts from retained desk records. A verdict held when the current trust label is at least as strong as the label signed by two people.</p>
        @if (_metricsBusy)
        {
            <LoadingIndicator Message="Calculating desk metrics..." />
        }
        else if (_metricsError is { } metricsError)
        {
            <p class="alert alert-warning mb-0" role="alert">@metricsError</p>
        }
        else if (_metrics is { } metrics)
        {
            <div class="desk-metric-grid">
                <div class="desk-metric"><span>On the budget</span><strong>@metrics.OnBudget</strong></div>
                <div class="desk-metric"><span>Median to verdict</span><strong>@FormatDuration(metrics.MedianTimeToVerdict)</strong></div>
                <div class="desk-metric"><span>Verdicts held up</span><strong>@FormatRatio(metrics.VerdictsHeld, metrics.VerdictsSigned, metrics.VerdictsHeldPercent)</strong></div>
                <div class="desk-metric"><span>Tips became stories</span><strong>@FormatRatio(metrics.TipsBecameStories, metrics.Tips, metrics.Tips == 0 ? null : (int)Math.Round(100.0 * metrics.TipsBecameStories / metrics.Tips))</strong></div>
                <div class="desk-metric"><span>Live updates</span><strong>@metrics.LiveUpdates</strong></div>
                <div class="desk-metric"><span>Corrections published</span><strong>@metrics.CorrectionsPublished</strong></div>
            </div>
            <h2 class="h6 mt-3">Open items per person</h2>
            @if (metrics.OpenPerPerson.Count == 0)
            {
                <p class="text-secondary mb-0">No open budget items.</p>
            }
            else
            {
                <ul class="desk-open-items">
                    @foreach (var item in metrics.OpenPerPerson)
                    {
                        <li><span>@(string.IsNullOrWhiteSpace(item.Owner) ? "Unassigned" : item.Owner)</span><strong>@item.Open</strong></li>
                    }
                </ul>
            }
        }
    </div>
</section>

<section class="card border-0 shadow-sm mb-3" aria-labelledby="desk-beats">
    <div class="card-header"><strong id="desk-beats">My beats</strong> <small class="text-secondary">your regions and kinds of story</small></div>
    <div class="card-body">
        <p class="small text-secondary">Regions follow reports' source countries, not verified event locations. New matching stories reach your bell once they pass the news alert checks; held stories wait.</p>
        @if (_beatError is { } beatError) { <p class="alert alert-warning" role="alert">@beatError</p> }
        <fieldset disabled="@_beatsBusy">
            <legend class="visually-hidden">Manage my beats</legend>
            <form class="desk-beat-form" @onsubmit="AddBeatAsync" @onsubmit:preventDefault>
                <label>Follow
                    <select class="form-select form-select-sm" @bind="_beatKind" @bind:after="BeatKindChanged">
                        <option value="@BeatRules.Region">Region</option>
                        <option value="@BeatRules.Topic">Kind of story</option>
                    </select>
                </label>
                <label>Beat
                    <select class="form-select form-select-sm" @bind="_beatValue">
                        @foreach (var value in BeatValues)
                        {
                            <option value="@value">@(_beatKind == BeatRules.Topic ? SituationKinds.Label(value) : value)</option>
                        }
                    </select>
                </label>
                <button type="submit" class="btn btn-sm btn-primary" disabled="@(_beats.Count >= BeatRules.MaxPerPerson)">Follow beat</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="LoadBeatsAsync">Refresh queue</button>
            </form>
            @if (_beats.Count > 0)
            {
                <ul class="list-unstyled desk-beat-list">
                    @foreach (var beat in _beats)
                    {
                        <li @key="beat.Id">
                            <span>@BeatRules.Label(beat)</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => RemoveBeatAsync(beat)"
                                    aria-label="@($"Stop following {BeatRules.Label(beat)}")">Unfollow</button>
                        </li>
                    }
                </ul>
            }
        </fieldset>
        @if (_beatsBusy)
        {
            <LoadingIndicator Message="Loading your beats..." />
        }
        else if (_beatError is null)
        {
            @if (_beats.Count == 0)
            {
                <p class="text-secondary mb-0">Follow a region or kind of story to build your personal queue.</p>
            }
            else
            {
                <h2 class="h6 mt-3">My queue</h2>
                <p class="small text-secondary">Up to 40 matching stories seen in the last 24 hours, most widely covered first. The queue includes stories still awaiting verification; an alert is not a desk verdict.</p>
                @if (_beatQueue.Count == 0)
                {
                    <p class="text-secondary mb-0">No recent stories match your beats yet.</p>
                }
                else
                {
                    <ol class="desk-beat-queue">
                        @foreach (var story in _beatQueue)
                        {
                            <li @key="story.Id">
                                <a href="@($"admin/world-news?event={Uri.EscapeDataString(story.Id)}")">@(story.Headline ?? story.Title)</a>
                                <span class="small text-secondary">@story.OutletCount outlets · @story.LastSeen.ToLocalGwsDateTime()</span>
                            </li>
                        }
                    </ol>
                }
            }
        }
    </div>
</section>

<section class="card border-0 shadow-sm mb-3" aria-labelledby="desk-morgue">
    <div class="card-header"><strong id="desk-morgue">Newsroom morgue</strong> <small class="text-secondary">search the retained archive and desk records</small></div>
    <div class="card-body">
        <p class="small text-secondary">Search reports, verdicts, approvals, notes, tips, live updates, corrections, dossiers and your own source book. Reports follow the 30-day archive; source-book matches are private to you.</p>
        <form class="desk-beat-form" role="search" @onsubmit="SearchMorgueAsync" @onsubmit:preventDefault>
            <label for="desk-morgue-query">Search terms</label>
            <input id="desk-morgue-query" type="search" class="form-control form-control-sm" maxlength="@MorgueSearch.MaxQueryLength"
                   @bind="_morgueQuery" @bind:event="oninput" />
            <button type="submit" class="btn btn-sm btn-primary" disabled="@(string.IsNullOrWhiteSpace(_morgueQuery) || _morgueBusy)">Search the morgue</button>
            @if (!string.IsNullOrWhiteSpace(_morgueQuery))
            {
                <a class="btn btn-sm btn-outline-secondary" href="@StorySearchHref">Search stories</a>
            }
        </form>
        @if (_morgueBusy) { <LoadingIndicator Message="Searching the newsroom archive..." /> }
        @if (_morgueError is { } morgueError) { <p class="alert alert-warning mt-3" role="alert">@morgueError</p> }
        @if (_morgueSearched && !_morgueBusy && _morgueError is null)
        {
            @if (_morgueHits.Count == 0)
            {
                <p class="text-secondary mt-3 mb-0">No retained records matched that search.</p>
            }
            else
            {
                <ol class="desk-beat-queue mt-3">
                    @foreach (var hit in _morgueHits)
                    {
                        <li>
                            <span class="small text-secondary">@MorgueKindLabel(hit.Kind) · @hit.At.ToLocalGwsDateTime()</span>
                            @if (hit.EventId.Length > 0)
                            {
                                <a href="@($"/admin/world-news?event={Uri.EscapeDataString(hit.EventId)}")">@(!string.IsNullOrWhiteSpace(hit.Title) ? hit.Title : "Open story")</a>
                            }
                            else if (!string.IsNullOrWhiteSpace(hit.Title))
                            {
                                <strong>@hit.Title</strong>
                            }
                            @if (!string.IsNullOrWhiteSpace(hit.Text)) { <p class="small mb-0">@hit.Text</p> }
                            @if (!string.IsNullOrWhiteSpace(hit.Username)) { <span class="small text-secondary">@hit.Username</span> }
                        </li>
                    }
                </ol>
                @if (_morgueHits.Count == MorgueSearch.MaxResults)
                {
                    <p class="small text-secondary mb-0">Showing the newest @MorgueSearch.MaxResults matches. Refine the search to narrow the results.</p>
                }
            }
        }
    </div>
</section>

<section class="card border-0 shadow-sm mb-3" aria-labelledby="desk-handover">
    <div class="card-header"><strong id="desk-handover">Shift handover</strong></div>
    <div class="card-body">
        <p class="small text-secondary">A factual draft of budget changes, single-source stories, holds, open challenges, tips and desk activity. Contains private newsroom material: share only within the desk.</p>
        <form class="desk-beat-form" @onsubmit="GenerateHandoverAsync" @onsubmit:preventDefault>
            <label>Look back
                <select class="form-select form-select-sm" @bind="_handoverHours" disabled="@_handoverBusy">
                    <option value="8">8 hours</option>
                    <option value="12">12 hours</option>
                    <option value="24">24 hours</option>
                    <option value="72">72 hours</option>
                </select>
            </label>
            <button type="submit" class="btn btn-sm btn-primary" disabled="@_handoverBusy">Generate handover</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(_handoverBusy || _handover is null)" @onclick="CopyHandoverAsync">Copy handover</button>
        </form>
        @if (_handoverBusy) { <LoadingIndicator Message="Preparing the shift handover..." /> }
        @if (_handoverError is { } handoverError) { <p class="alert alert-warning mt-3" role="alert">@handoverError</p> }
        @if (_handoverStatus is { } handoverStatus) { <p class="small text-secondary mt-2" role="status">@handoverStatus</p> }
        @if (_handover is not null)
        {
            <label class="form-label mt-3" for="desk-handover-text">Handover draft</label>
            <textarea id="desk-handover-text" class="form-control desk-handover-text" rows="16" readonly>@_handover</textarea>
            <p class="small text-secondary mt-2 mb-0">Includes the latest 1,000 label records in the period and up to 200 recent notes and live updates. Regenerate to include newer activity. No AI or external service is used.</p>
        }
    </div>
</section>

<section class="card border-0 shadow-sm mb-3" aria-labelledby="desk-budget">
    <div class="card-header"><strong id="desk-budget">The budget</strong> <small class="text-secondary">add a story from its page</small></div>
    @if (_budget.Count == 0)
    {
        <div class="card-body text-secondary">Nothing on the budget yet. Open a story and choose "Add to the budget".</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0 desk-table">
                <thead><tr><th>Story</th><th>Owner</th><th>Status</th><th>Next action</th><th>Updated</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
                <tbody>
                    @foreach (var row in _budget)
                    {
                        var edit = _edits[row.EventId];
                        <tr @key="row.EventId">
                            <td><a href="@($"admin/world-news?event={row.EventId}")">@row.Title</a></td>
                            <td><input class="form-control form-control-sm" aria-label="Owner" @bind="edit.Owner" @bind:event="oninput" /></td>
                            <td>
                                <select class="form-select form-select-sm" aria-label="Status" @bind="edit.Status">
                                    @foreach (var status in BudgetStatuses.All) { <option value="@status">@status</option> }
                                </select>
                            </td>
                            <td><input class="form-control form-control-sm" aria-label="Next action" @bind="edit.NextAction" @bind:event="oninput" /></td>
                            <td class="small text-secondary text-nowrap">@row.UpdatedAt.ToLocalGwsDateTime()<br />@row.UpdatedBy</td>
                            <td class="text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => SaveAsync(row)">Save</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => RemoveAsync(row)" aria-label="@($"Take {row.Title} off the budget")"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="card border-0 shadow-sm mb-3" aria-labelledby="desk-tips">
    <div class="card-header"><strong id="desk-tips">Tips</strong> <small class="text-secondary">sent from the public tip form; untrusted until checked</small></div>
    <div class="card-body">
        @if (_tips.Count == 0) { <p class="text-secondary mb-0">No tips yet. The form is at /tip.</p> }
        @foreach (var tip in _tips)
        {
            <div class="desk-tip" @key="tip.Id">
                <div class="small text-secondary">
                    <span class="desk-tip-status desk-tip-@tip.Status">@tip.Status</span>
                    @tip.CreatedAt.ToLocalGwsDateTime()
                    @if (!string.IsNullOrWhiteSpace(tip.Name)) { <span> · @tip.Name</span> }
                    @if (!string.IsNullOrWhiteSpace(tip.Contact)) { <span> · @tip.Contact</span> }
                    @if (tip.HandledBy is { Length: > 0 } by) { <span> · @by</span> }
                </div>
                <p class="mb-1 desk-tip-message">@tip.Message</p>
                @if (tip.Url is { Length: > 0 } url) { <a href="@url" target="_blank" rel="noopener noreferrer nofollow" class="small">@url</a> }
                @if (tip.EventId is { Length: > 0 } eventId) { <div class="small"><a href="@($"admin/world-news?event={eventId}")">Linked story</a></div> }
                @if (tip.Status != TipStatuses.Closed)
                {
                    <div class="desk-tip-actions">
                        <input class="form-control form-control-sm" placeholder="Story link or id (optional)" aria-label="Story for this tip" @bind="_tipStory[tip.Id]" @bind:event="oninput" />
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => SetTipAsync(tip, TipStatuses.Following)">Follow up</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => SetTipAsync(tip, TipStatuses.Closed)">Close</button>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private sealed class BudgetEdit
    {
        public string Owner { get; set; } = string.Empty;
        public string Status { get; set; } = BudgetStatuses.All[0];
        public string NextAction { get; set; } = string.Empty;
    }

    private IReadOnlyList<BudgetItem> _budget = [];
    private IReadOnlyList<NewsTip> _tips = [];
    private readonly Dictionary<string, BudgetEdit> _edits = new();
    private readonly Dictionary<string, string> _tipStory = new();
    private string? _error;
    private IReadOnlyList<Beat> _beats = [];
    private IReadOnlyList<EventOverview> _beatQueue = [];
    private string _beatKind = BeatRules.Region;
    private string _beatValue = WorldRegions.All[0];
    private string? _beatError;
    private bool _beatsBusy = true;
    private IReadOnlyList<string> BeatValues => _beatKind == BeatRules.Region ? WorldRegions.All : SituationKinds.All;
    private int _handoverHours = 8;
    private bool _handoverBusy;
    private string? _handover;
    private string? _handoverError;
    private string? _handoverStatus;
    private string _morgueQuery = string.Empty;
    private IReadOnlyList<MorgueHit> _morgueHits = [];
    private bool _morgueBusy;
    private bool _morgueSearched;
    private string? _morgueError;
    private DeskMetrics? _metrics;
    private bool _metricsBusy = true;
    private string? _metricsError;
    private string StorySearchHref => $"/admin/world-news/search?q={Uri.EscapeDataString(_morgueQuery.Trim())}";

    private static string FormatDuration(TimeSpan? duration) => duration switch
    {
        null => "Not enough data",
        { TotalDays: >= 1 } value => $"{(int)value.TotalDays}d {value.Hours}h",
        { TotalHours: >= 1 } value => $"{(int)value.TotalHours}h {value.Minutes}m",
        { } value => $"{Math.Max(0, (int)value.TotalMinutes)}m"
    };

    private static string FormatRatio(int value, int total, int? percent) =>
        percent is null ? $"{value} of {total}" : $"{value} of {total} ({percent}%)";

    private static string MorgueKindLabel(string kind) => kind switch
    {
        "report" => "Report",
        "verdict" => "Verdict",
        "approval" => "Approval",
        "source-use" => "Source history",
        "contact" => "My source book",
        "note" => "Desk note",
        "tip" => "Reader tip",
        "live" => "Live update",
        "correction" => "Correction",
        "dossier" => "Dossier",
        "budget" => "Budget",
        _ => "Desk record"
    };

    private async Task SearchMorgueAsync()
    {
        if (_morgueBusy || string.IsNullOrWhiteSpace(_morgueQuery)) return;
        _morgueBusy = true;
        _morgueSearched = false;
        _morgueError = null;
        try
        {
            var username = await CurrentUserAccessor.GetCurrentUsernameAsync();
            await using var scope = ScopeFactory.CreateAsyncScope();
            _morgueHits = await scope.ServiceProvider.GetRequiredService<WorldNewsDeskService>()
                .SearchMorgueAsync(_morgueQuery.Trim(), username);
            _morgueSearched = true;
        }
        catch (Exception ex) when (ex is Microsoft.Data.Sqlite.SqliteException or ArgumentException or InvalidOperationException or UnauthorizedAccessException)
        {
            Logger.LogWarning(ex, "World News: couldn't search the newsroom morgue");
            _morgueError = "The newsroom archive couldn't be searched. Refresh the desk and try again.";
        }
        finally { _morgueBusy = false; }
    }

    private async Task GenerateHandoverAsync()
    {
        if (_handoverBusy) return;
        _handoverBusy = true;
        _handover = null;
        _handoverError = _handoverStatus = null;
        try
        {
            var hours = _handoverHours;
            var username = await CurrentUserAccessor.GetCurrentUsernameAsync();
            await using var scope = ScopeFactory.CreateAsyncScope();
            _handover = await scope.ServiceProvider.GetRequiredService<WorldNewsDeskService>().HandoverAsync(hours, username);
        }
        catch (Exception ex) when (ex is Microsoft.Data.Sqlite.SqliteException or InvalidOperationException or UnauthorizedAccessException)
        {
            Logger.LogWarning(ex, "World News: couldn't prepare a shift handover");
            _handoverError = "The handover couldn't be prepared. Refresh the desk and try again.";
        }
        finally { _handoverBusy = false; }
    }

    private async Task CopyHandoverAsync()
    {
        if (_handover is null) return;
        _handoverError = _handoverStatus = null;
        try
        {
            await JS.InvokeVoidAsync("gwsAssistant.copy", _handover);
            _handoverStatus = "Handover copied. Share it only within the desk.";
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "World News: couldn't copy a shift handover");
            _handoverError = "Clipboard access failed. Select and copy the handover draft below.";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        await LoadBeatsAsync();
        await LoadMetricsAsync();
    }

    private async Task LoadMetricsAsync()
    {
        _metricsBusy = true;
        _metricsError = null;
        try
        {
            var username = await CurrentUserAccessor.GetCurrentUsernameAsync();
            await using var scope = ScopeFactory.CreateAsyncScope();
            _metrics = await scope.ServiceProvider.GetRequiredService<WorldNewsDeskService>().MetricsAsync(username);
        }
        catch (Exception ex) when (ex is Microsoft.Data.Sqlite.SqliteException or InvalidOperationException or UnauthorizedAccessException)
        {
            Logger.LogWarning(ex, "World News: couldn't calculate desk metrics");
            _metricsError = "Desk metrics couldn't be calculated. Refresh them and try again.";
        }
        finally { _metricsBusy = false; }
    }

    private void BeatKindChanged() => _beatValue = BeatValues[0];

    private async Task LoadBeatsAsync()
    {
        _beatsBusy = true;
        _beatError = null;
        try
        {
            var username = await CurrentUserAccessor.GetCurrentUsernameAsync();
            (_beats, _beatQueue) = await Task.Run(() =>
                (News.Store.Beats(username), News.Store.BeatQueue(username, DateTimeOffset.UtcNow.AddHours(-24))));
        }
        catch (Microsoft.Data.Sqlite.SqliteException ex)
        {
            Logger.LogWarning(ex, "World News: couldn't load personal beats");
            _beatError = "Your beats couldn't be loaded. Try refreshing the queue.";
        }
        finally { _beatsBusy = false; }
    }

    private async Task AddBeatAsync()
    {
        _beatError = BeatRules.Problem(_beatKind, _beatValue);
        if (_beatError is not null) return;
        _beatsBusy = true;
        try
        {
            var username = await CurrentUserAccessor.GetCurrentUsernameAsync();
            var kind = _beatKind;
            var value = _beatValue;
            var added = await Task.Run(() => News.Store.AddBeat(username, kind, value, DateTimeOffset.UtcNow));
            if (added is null)
            {
                _beatError = $"You're already following that beat, or you've reached the limit of {BeatRules.MaxPerPerson} beats.";
                return;
            }
            await LoadBeatsAsync();
        }
        catch (Microsoft.Data.Sqlite.SqliteException ex)
        {
            Logger.LogWarning(ex, "World News: couldn't follow a personal beat");
            _beatError = "That beat couldn't be followed. Refresh the queue before trying again.";
        }
        finally { _beatsBusy = false; }
    }

    private async Task RemoveBeatAsync(Beat beat)
    {
        _beatsBusy = true;
        _beatError = null;
        try
        {
            var username = await CurrentUserAccessor.GetCurrentUsernameAsync();
            await Task.Run(() => News.Store.RemoveBeat(username, beat.Id));
            await LoadBeatsAsync();
        }
        catch (Microsoft.Data.Sqlite.SqliteException ex)
        {
            Logger.LogWarning(ex, "World News: couldn't unfollow a personal beat");
            _beatError = "That beat couldn't be unfollowed. Refresh the queue before trying again.";
        }
        finally { _beatsBusy = false; }
    }

    private async Task LoadAsync()
    {
        (_budget, _tips) = await Task.Run(() => (News.Store.Budget(), News.Store.Tips()));
        _edits.Clear();
        foreach (var row in _budget) _edits[row.EventId] = new BudgetEdit { Owner = row.Owner, Status = row.Status, NextAction = row.NextAction };
        foreach (var tip in _tips) _tipStory.TryAdd(tip.Id, tip.EventId ?? string.Empty);
    }

    private async Task SaveAsync(BudgetItem row)
    {
        var edit = _edits[row.EventId];
        var by = await CurrentUserAccessor.GetCurrentUsernameAsync();
        await Task.Run(() => News.Store.SetBudgetItem(row with
        {
            Owner = edit.Owner.Trim(), Status = edit.Status, NextAction = edit.NextAction.Trim(),
            UpdatedAt = DateTimeOffset.UtcNow, UpdatedBy = by,
        }));
        await LoadAsync();
        await LoadMetricsAsync();
    }

    private async Task RemoveAsync(BudgetItem row)
    {
        await Task.Run(() => News.Store.RemoveBudgetItem(row.EventId));
        await LoadAsync();
        await LoadMetricsAsync();
    }

    private async Task SetTipAsync(NewsTip tip, string status)
    {
        _error = null;
        var eventId = TipRules.StoryIdFrom(_tipStory.GetValueOrDefault(tip.Id));
        if (eventId is not null && !await Task.Run(() => News.Store.HasEvent(eventId)))
        {
            _error = "That story wasn't found. Paste the story's link from World News, or leave it empty.";
            return;
        }
        var by = await CurrentUserAccessor.GetCurrentUsernameAsync();
        await Task.Run(() => News.Store.SetTipStatus(tip.Id, status, eventId, by));
        await LoadAsync();
        await LoadMetricsAsync();
    }
}
