@page "/sentinel/share/{Token}"
@page "/sentinel/share/{Token}/{PageId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@layout GwsBusinessSuite.Web.Components.Layout.PublicShareLayout
@using GwsBusinessSuite.Application.Automation
@using GwsBusinessSuite.Application.Wiki
@using GwsBusinessSuite.Domain.Entities
@using Microsoft.AspNetCore.DataProtection
@inject ISentinelAccessService AccessService
@inject IWikiService WikiService
@inject IWikiDatabaseService WikiDatabaseService
@inject IAutomationWorkflowService AutomationWorkflowService
@inject ISentinelPublishedSiteService PublishedSiteService
@inject IDataProtectionProvider DataProtection

@* A static page (no interactive render mode): it works without a live connection, links are
   ordinary links, the password form posts to SentinelShareEndpoints, and site search is a GET
   form. Code/equation/diagram blocks are drawn by js/sentinelPublicShare.js. *@
<PageTitle>@(_title ?? "Shared Sentinel page")</PageTitle>
<HeadContent>
    @if (_share?.AllowSearchIndexing != true)
    {
        <meta name="robots" content="noindex,nofollow" />
    }
</HeadContent>

<main class="sentinel-public-share">
    @if (_loading)
    {
        <div class="spinner-border" role="status"></div>
    }
    else if (_share is null)
    {
        <div class="sentinel-public-share-error"><h1>Link unavailable</h1><p>This share link is invalid, expired, or revoked.</p></div>
    }
    else if (_share.RequiresPassword && !_unlocked)
    {
        <div class="sentinel-public-share-error">
            <h1>Password required</h1>
            <p>This link is protected. Enter the password to view it.</p>
            <form method="post" action="@($"sentinel/share/{Token}/unlock")" class="input-group" style="max-width: 20rem; margin: 0 auto;">
                <AntiforgeryToken />
                @if (PageId is { } requestedPage)
                {
                    <input type="hidden" name="page" value="@requestedPage" />
                }
                <input type="password" name="password" class="form-control" placeholder="Password" aria-label="Password" required autofocus />
                <button type="submit" class="btn btn-primary">Unlock</button>
            </form>
            @if (Unlock == "wrong")
            {
                <p class="text-danger mt-2">Incorrect password, or too many attempts. Wait a moment and try again.</p>
            }
            else if (Unlock == "expired")
            {
                <p class="text-danger mt-2">The form expired. Enter the password again.</p>
            }
        </div>
    }
    else if (_notInSite)
    {
        <div class="sentinel-public-share-error"><h1>Page not found</h1><p>That page isn't part of this shared site.</p>
            @if (_site is not null) { <p><a href="@SentinelPublishedSite.PageUrl(Token, _site.RootId, _site.RootId)">Go to @_site.Title</a></p> }
        </div>
    }
    else if (_page is not null && _site is { Pages.Count: > 1 } site)
    {
        <div class="sentinel-public-site">
            <nav class="sentinel-public-site-nav" aria-label="@site.Title">
                <a class="sentinel-public-site-title" href="@SentinelPublishedSite.PageUrl(Token, site.RootId, site.RootId)">@site.Title</a>
                <form method="get" action="@SentinelPublishedSite.PageUrl(Token, site.RootId, _page.Id).TrimStart('/')" class="sentinel-public-site-search" role="search">
                    <input type="search" name="q" value="@Query" class="form-control form-control-sm" placeholder="Search this site" aria-label="Search this site" minlength="2" />
                </form>
                <ul class="sentinel-public-site-tree">
                    @foreach (var item in site.Pages)
                    {
                        <li style="--depth:@item.Depth">
                            <a href="@SentinelPublishedSite.PageUrl(Token, site.RootId, item.Id)" aria-current="@(item.Id == _page.Id ? "page" : null)">
                                @if (!string.IsNullOrWhiteSpace(item.Icon)) { <span aria-hidden="true">@item.Icon </span> }@item.Title
                            </a>
                        </li>
                    }
                </ul>
            </nav>
            <div class="sentinel-public-site-main">
                @if (_results is not null)
                {
                    <section class="sentinel-public-site-results" aria-label="Search results">
                        <h2>@(_results.Count == 0 ? $"Nothing in this site matches “{Query}”" : $"Results for “{Query}”")</h2>
                        @foreach (var result in _results)
                        {
                            <a href="@SentinelPublishedSite.PageUrl(Token, site.RootId, result.Id)">
                                <strong>@result.Title</strong>
                                @if (result.Snippet.Length > 0) { <span>@result.Snippet</span> }
                            </a>
                        }
                    </section>
                }
                @PageArticle(_page, site)
            </div>
        </div>
    }
    else if (_page is not null && _site is not null)
    {
        @PageArticle(_page, _site)
    }
    else if (_database is not null)
    {
        var titleProperty = _database.Properties.First(property => property.Type == WikiDatabasePropertyTypes.Title);
        <article>
            <div class="sentinel-public-brand">SENTINEL DATABASE</div>
            <h1><span>@_database.Icon</span> @_database.Title</h1>
            <div class="sentinel-public-database">
                @foreach (var row in _database.Rows.OrderBy(row => row.SortOrder))
                {
                    <section>
                        <strong>@(WikiPropertyValues.GetText(WikiPropertyValues.ParseObject(row.PropertyValuesJson), titleProperty.Id) ?? "Untitled")</strong>
                        @foreach (var property in _database.Properties.Where(property => property.Id != titleProperty.Id))
                        {
                            var value = WikiPropertyValues.GetDisplayText(property, WikiPropertyValues.ParseObject(row.PropertyValuesJson), row.CreatedAt);
                            if (!string.IsNullOrWhiteSpace(value)) { <span>@property.Name: @value</span> }
                        }
                    </section>
                }
            </div>
        </article>
    }
    else if (_automationStatus is not null)
    {
        <article>
            <div class="sentinel-public-brand">AUTOMATION STATUS</div>
            <h1><i class="bi bi-diagram-3-fill me-2"></i>@_automationStatus.Name</h1>
            @if (!string.IsNullOrWhiteSpace(_automationStatus.Description))
            {
                <p class="sentinel-public-automation-description">@_automationStatus.Description</p>
            }
            <div class="sentinel-public-automation-summary">
                <span class="badge @(_automationStatus.Status == "Active" ? "text-bg-success" : "text-bg-secondary")">@_automationStatus.Status</span>
                <span class="text-secondary small ms-2">
                    @(_automationStatus.LastExecutedAt is { } lastRun ? $"Last ran {lastRun.ToLocalTime():dd-MM-yy HH:mm}" : "Never run")
                </span>
            </div>
            <div class="sentinel-public-automation-runs">
                <h2 class="h6 text-secondary text-uppercase small fw-bold mt-4 mb-2">Recent runs</h2>
                @if (_automationStatus.RecentRuns.Count == 0)
                {
                    <p class="text-secondary small">No runs recorded yet.</p>
                }
                else
                {
                    <table class="table table-sm">
                        <thead><tr><th>Status</th><th>Started</th><th>Duration</th></tr></thead>
                        <tbody>
                            @foreach (var run in _automationStatus.RecentRuns)
                            {
                                <tr>
                                    <td><span class="badge @(run.Status == "Succeeded" ? "text-bg-success" : run.Status == "Failed" ? "text-bg-danger" : "text-bg-secondary")">@run.Status</span></td>
                                    <td>@(run.StartedAt?.ToLocalTime().ToString("dd-MM-yy HH:mm") ?? "—")</td>
                                    <td>@(run.StartedAt is { } started && run.FinishedAt is { } finished ? $"{(finished - started).TotalSeconds:0.#}s" : "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </article>
    }
</main>

@code {
    [Parameter] public string Token { get; set; } = string.Empty;
    [Parameter] public Guid? PageId { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }
    [SupplyParameterFromQuery(Name = "unlock")] public string? Unlock { get; set; }
    [CascadingParameter] public HttpContext? HttpContext { get; set; }
    private SentinelPublishedSite.Site? _site;
    private IReadOnlyList<SentinelPublishedSite.SearchResult>? _results;
    private bool _notInSite;
    private SentinelShareView? _share;
    private WikiPage? _page;
    private WikiDatabase? _database;
    private AutomationPublicStatusView? _automationStatus;
    private bool _loading = true;
    private string? _title;
    private bool _unlocked;

    protected override async Task OnInitializedAsync()
    {
        _share = await AccessService.ResolvePublicShareAsync(Token);
        if (_share is not null)
        {
            _unlocked = !_share.RequiresPassword || SentinelShareUnlock.IsUnlocked(HttpContext, DataProtection, _share.Id);
            if (_unlocked) await LoadTargetAsync();
        }
        _loading = false;
    }

    private async Task LoadTargetAsync()
    {
        if (_share is null) return;
        if (_share.IsAutomationWorkflow) _automationStatus = await AutomationWorkflowService.GetPublicStatusAsync(_share.TargetId);
        else if (_share.IsDatabase) _database = await WikiDatabaseService.GetDatabaseAsync(_share.TargetId);
        else
        {
            _site = await PublishedSiteService.GetSiteAsync(_share);
            if (_site is null) return;
            var pageId = PageId ?? _site.RootId;
            if (!_site.Contains(pageId))
            {
                _notInSite = true;
                return;
            }
            _page = await WikiService.GetPageAsync(pageId);
            if (_page is not null && !string.IsNullOrWhiteSpace(Query) && _site.Pages.Count > 1)
                _results = await PublishedSiteService.SearchAsync(_site, Query);
        }
        _title = _automationStatus?.Name ?? _database?.Title
            ?? (_page is null ? null : _site is { Pages.Count: > 1 } && _page.Id != _site.RootId ? $"{_page.Title} · {_site.Title}" : _site?.Title ?? _page.Title);
        if (_automationStatus is not null || _database is not null || _page is not null)
            await AccessService.RecordShareViewAsync(_share.Id);
    }

    private RenderFragment PageArticle(WikiPage shown, SentinelPublishedSite.Site site) => __builder =>
    {
        @if (!string.IsNullOrWhiteSpace(shown.CoverImageUrl))
        {
            <img class="sentinel-public-cover" src="@shown.CoverImageUrl" alt="" />
        }
        <article>
            <div class="sentinel-public-brand">SENTINEL</div>
            <h1><span>@shown.Icon</span> @shown.Title</h1>
            <div class="sentinel-public-content">@((MarkupString)SentinelPublishedSite.RewriteLinks(WikiBlockHtmlRenderer.RenderPage(WikiBlockJson.ParseBlocks(shown.BlocksJson)), site, Token))</div>
        </article>
    };
}
