@page "/sentinel/share/{Token}"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using GwsBusinessSuite.Application.Automation
@using GwsBusinessSuite.Application.Wiki
@using GwsBusinessSuite.Domain.Entities
@inject ISentinelAccessService AccessService
@inject IWikiService WikiService
@inject IWikiDatabaseService WikiDatabaseService
@inject IAutomationWorkflowService AutomationWorkflowService
@inject IJSRuntime JS

<PageTitle>@(_title ?? "Shared Sentinel page")</PageTitle>

<main class="sentinel-public-share">
    @if (_loading)
    {
        <div class="spinner-border" role="status"></div>
    }
    else if (_share is null)
    {
        <div class="sentinel-public-share-error"><h1>Link unavailable</h1><p>This share link is invalid, expired, or revoked.</p></div>
    }
    else if (_share.RequiresPassword && !_unlocked)
    {
        <div class="sentinel-public-share-error">
            <h1>Password required</h1>
            <p>This link is protected. Enter the password to view it.</p>
            <div class="input-group" style="max-width: 20rem; margin: 0 auto;">
                <input type="password" class="form-control" @bind="_password" @bind:event="oninput" @onkeydown="OnPasswordKeyDownAsync" placeholder="Password" autofocus />
                <button type="button" class="btn btn-primary" @onclick="SubmitPasswordAsync" disabled="@_verifying">Unlock</button>
            </div>
            @if (_passwordError)
            {
                <p class="text-danger mt-2">Incorrect password.</p>
            }
        </div>
    }
    else if (_page is not null)
    {
        @if (!string.IsNullOrWhiteSpace(_page.CoverImageUrl))
        {
            <img class="sentinel-public-cover" src="@_page.CoverImageUrl" alt="" />
        }
        <article>
            <div class="sentinel-public-brand">SENTINEL</div>
            <h1><span>@_page.Icon</span> @_page.Title</h1>
            <div class="sentinel-public-content">@((MarkupString)WikiBlockHtmlRenderer.RenderPage(WikiBlockJson.ParseBlocks(_page.BlocksJson)))</div>
        </article>
    }
    else if (_database is not null)
    {
        var titleProperty = _database.Properties.First(property => property.Type == WikiDatabasePropertyTypes.Title);
        <article>
            <div class="sentinel-public-brand">SENTINEL DATABASE</div>
            <h1><span>@_database.Icon</span> @_database.Title</h1>
            <div class="sentinel-public-database">
                @foreach (var row in _database.Rows.OrderBy(row => row.SortOrder))
                {
                    <section>
                        <strong>@(WikiPropertyValues.GetText(WikiPropertyValues.ParseObject(row.PropertyValuesJson), titleProperty.Id) ?? "Untitled")</strong>
                        @foreach (var property in _database.Properties.Where(property => property.Id != titleProperty.Id))
                        {
                            var value = WikiPropertyValues.GetDisplayText(property, WikiPropertyValues.ParseObject(row.PropertyValuesJson), row.CreatedAt);
                            if (!string.IsNullOrWhiteSpace(value)) { <span>@property.Name: @value</span> }
                        }
                    </section>
                }
            </div>
        </article>
    }
    else if (_automationStatus is not null)
    {
        <article>
            <div class="sentinel-public-brand">AUTOMATION STATUS</div>
            <h1><i class="bi bi-diagram-3-fill me-2"></i>@_automationStatus.Name</h1>
            @if (!string.IsNullOrWhiteSpace(_automationStatus.Description))
            {
                <p class="sentinel-public-automation-description">@_automationStatus.Description</p>
            }
            <div class="sentinel-public-automation-summary">
                <span class="badge @(_automationStatus.Status == "Active" ? "text-bg-success" : "text-bg-secondary")">@_automationStatus.Status</span>
                <span class="text-secondary small ms-2">
                    @(_automationStatus.LastExecutedAt is { } lastRun ? $"Last ran {lastRun.ToLocalTime():MMM d, h:mm tt}" : "Never run")
                </span>
            </div>
            <div class="sentinel-public-automation-runs">
                <h2 class="h6 text-secondary text-uppercase small fw-bold mt-4 mb-2">Recent runs</h2>
                @if (_automationStatus.RecentRuns.Count == 0)
                {
                    <p class="text-secondary small">No runs recorded yet.</p>
                }
                else
                {
                    <table class="table table-sm">
                        <thead><tr><th>Status</th><th>Started</th><th>Duration</th></tr></thead>
                        <tbody>
                            @foreach (var run in _automationStatus.RecentRuns)
                            {
                                <tr>
                                    <td><span class="badge @(run.Status == "Succeeded" ? "text-bg-success" : run.Status == "Failed" ? "text-bg-danger" : "text-bg-secondary")">@run.Status</span></td>
                                    <td>@(run.StartedAt?.ToLocalTime().ToString("MMM d, h:mm tt") ?? "—")</td>
                                    <td>@(run.StartedAt is { } started && run.FinishedAt is { } finished ? $"{(finished - started).TotalSeconds:0.#}s" : "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </article>
    }
</main>

@code {
    [Parameter] public string Token { get; set; } = string.Empty;
    private SentinelShareView? _share;
    private WikiPage? _page;
    private WikiDatabase? _database;
    private AutomationPublicStatusView? _automationStatus;
    private bool _loading = true;
    private string? _title;
    private bool _unlocked;
    private string _password = string.Empty;
    private bool _passwordError;
    private bool _verifying;

    protected override async Task OnParametersSetAsync()
    {
        _share = await AccessService.ResolvePublicShareAsync(Token);
        if (_share is not null && !_share.RequiresPassword)
        {
            await LoadTargetAsync();
        }
        _loading = false;
    }

    private async Task LoadTargetAsync()
    {
        if (_share is null) return;
        if (_share.IsAutomationWorkflow) _automationStatus = await AutomationWorkflowService.GetPublicStatusAsync(_share.TargetId);
        else if (_share.IsDatabase) _database = await WikiDatabaseService.GetDatabaseAsync(_share.TargetId);
        else _page = await WikiService.GetPageAsync(_share.TargetId);
        _title = _automationStatus?.Name ?? _database?.Title ?? _page?.Title;
        await AccessService.RecordShareViewAsync(_share.Id);
    }

    private async Task SubmitPasswordAsync()
    {
        if (_share is null || string.IsNullOrEmpty(_password)) return;
        _verifying = true;
        _passwordError = false;
        var correct = await AccessService.VerifySharePasswordAsync(_share.Id, _password);
        _verifying = false;
        if (correct)
        {
            _unlocked = true;
            _password = string.Empty;
            await LoadTargetAsync();
        }
        else
        {
            _passwordError = true;
        }
    }

    private async Task OnPasswordKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SubmitPasswordAsync();
    }

    // This is a read-only view (no live block editor), so equation/code blocks need the same
    // KaTeX/highlight.js pass the editor applies itself in wiki-block-editor.js's
    // attachRichPreview - wikiRichContentHydrate.js is the shared implementation both use.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_page is not null)
        {
            try { await JS.InvokeVoidAsync("wikiRichContentHydrate", ".sentinel-public-content"); }
            catch (JSDisconnectedException) { /* circuit gone */ }
        }
    }
}
