@page "/book/{Slug}"
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@using GwsBusinessSuite.Application.Scheduling
@inject IBookingService BookingService
@inject IJSRuntime JS

<PageTitle>@(BookingType?.Title ?? "Book a time")</PageTitle>

<div class="gws-booking-shell">
    @if (_loading)
    {
        <p class="text-secondary">Loading...</p>
    }
    else if (BookingType is null)
    {
        <div class="alert alert-warning">This booking link isn't available.</div>
    }
    else if (_confirmedBooking is not null)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 2.5rem;"></i>
                <h2 class="h5 mt-3">You're booked!</h2>
                <p class="text-secondary">
                    @BookingType.Title &middot; @BookingTimeZones.Format(_confirmedBooking.StartsAt, ViewZone)
                </p>
                <p class="small text-secondary">A confirmation has been emailed to @_confirmedBooking.AttendeeEmail.</p>
            </div>
        </div>
    }
    else
    {
        <div class="page-header">
            <h1>@BookingType.Title</h1>
            @if (!string.IsNullOrWhiteSpace(BookingType.Description))
            {
                <p>@BookingType.Description</p>
            }
            <p class="text-secondary small">@BookingType.DurationMinutes minutes</p>
            <div class="gws-booking-zone small">
                <label for="booking-zone" class="text-secondary">Times shown in</label>
                <select id="booking-zone" class="form-select form-select-sm" @bind="ViewZoneId" @bind:after="OnZoneChanged">
                    @foreach (var zone in ZoneChoices)
                    {
                        <option value="@zone">@zone.Replace('_', ' ')</option>
                    }
                </select>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="alert alert-danger">@ErrorMessage</div>
        }

        @if (_selectedSlot is null)
        {
            @if (SlotsByDay.Count == 0)
            {
                <div class="alert alert-info">No open times in the next @BookingType.DaysAhead days.</div>
            }
            else
            {
                @foreach (var day in SlotsByDay)
                {
                    <div class="mb-3">
                        <div class="fw-semibold small mb-2">@day.Key.ToString("ddd dd-MM-yy")</div>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var slot in day)
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => _selectedSlot = slot">
                                    @TimeZoneInfo.ConvertTime(slot.StartsAt, ViewZone).ToString("HH:mm")
                                </button>
                            }
                        </div>
                    </div>
                }
            }
        }
        else
        {
            <div class="card border-0 shadow-sm" style="max-width: 32rem;">
                <div class="card-body">
                    <p class="fw-semibold">@BookingTimeZones.Format(_selectedSlot.StartsAt, ViewZone)</p>
                    <div class="mb-2">
                        <input class="form-control form-control-sm" placeholder="Your name" @bind="_attendeeName" />
                    </div>
                    <div class="mb-2">
                        <input class="form-control form-control-sm" type="email" placeholder="Your email" @bind="_attendeeEmail" />
                    </div>
                    <div class="mb-3">
                        <textarea class="form-control form-control-sm" rows="2" placeholder="Anything we should know? (optional)" @bind="_notes"></textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => _selectedSlot = null">Back</button>
                        <button class="btn btn-sm btn-primary" disabled="@_isBusy" @onclick="ConfirmAsync">Confirm booking</button>
                    </div>
                </div>
            </div>
        }
    }
</div>

<style>
    .gws-booking-shell {
        max-width: 42rem;
        margin: 0 auto;
        padding: 1rem 0 2rem;
    }
    .gws-booking-zone {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: .5rem;
    }
    .gws-booking-zone select {
        width: auto;
        max-width: 100%;
    }
</style>

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private bool _loading = true;
    private BookingTypeView? BookingType { get; set; }
    private IReadOnlyList<BookingSlot> Slots { get; set; } = [];
    private BookingSlot? _selectedSlot;
    private BookingView? _confirmedBooking;
    private string _attendeeName = string.Empty;
    private string _attendeeEmail = string.Empty;
    private string _notes = string.Empty;
    private string ErrorMessage { get; set; } = string.Empty;
    private bool _isBusy;

    // Times are shown in the visitor's zone (detected in the browser after the first render,
    // changeable with the picker); until then, in the booking type's own zone.
    private string ViewZoneId { get; set; } = string.Empty;
    private TimeZoneInfo ViewZone => BookingTimeZones.Find(ViewZoneId) ?? BookingTimeZones.Find(BookingType?.TimeZoneId) ?? TimeZoneInfo.Utc;
    private static readonly IReadOnlyList<string> AllZones =
        TimeZoneInfo.GetSystemTimeZones().Select(zone => zone.Id).Where(id => id.Contains('/')).Order(StringComparer.Ordinal).ToList();
    private IEnumerable<string> ZoneChoices => AllZones.Contains(ViewZone.Id) ? AllZones : AllZones.Prepend(ViewZone.Id);

    private List<IGrouping<DateTime, BookingSlot>> SlotsByDay =>
        Slots.GroupBy(slot => TimeZoneInfo.ConvertTime(slot.StartsAt, ViewZone).Date).ToList();

    protected override async Task OnInitializedAsync()
    {
        BookingType = await BookingService.GetBookingTypeBySlugAsync(Slug);
        if (BookingType is not null)
        {
            ViewZoneId = BookingType.TimeZoneId;
            Slots = await BookingService.GetAvailableSlotsAsync(BookingType.Id, DateTimeOffset.UtcNow, BookingType.DaysAhead);
        }
        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || BookingType is null) return;
        try
        {
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/booking-timezone.js");
            var browserZone = await module.InvokeAsync<string>("browserTimeZone");
            if (BookingTimeZones.Find(browserZone) is { } zone && zone.Id != ViewZone.Id)
            {
                ViewZoneId = zone.Id;
                StateHasChanged();
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private void OnZoneChanged() => _selectedSlot = null;

    private async Task ConfirmAsync()
    {
        if (_selectedSlot is null || BookingType is null) return;
        ErrorMessage = string.Empty;
        if (string.IsNullOrWhiteSpace(_attendeeName) || string.IsNullOrWhiteSpace(_attendeeEmail))
        {
            ErrorMessage = "Name and email are required.";
            return;
        }

        _isBusy = true;
        try
        {
            var result = await BookingService.CreateBookingAsync(
                BookingType.Id, _selectedSlot.StartsAt, _attendeeName, _attendeeEmail, _notes, attendeeTimeZone: ViewZone.Id);
            if (result is null)
            {
                ErrorMessage = "That time was just taken. Please pick another.";
                Slots = await BookingService.GetAvailableSlotsAsync(BookingType.Id, DateTimeOffset.UtcNow, BookingType.DaysAhead);
                _selectedSlot = null;
            }
            else
            {
                _confirmedBooking = result;
            }
        }
        finally
        {
            _isBusy = false;
        }
    }
}
