@page "/campaigns/unsubscribe/{Token}"
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@using GwsBusinessSuite.Application.Campaigns
@inject IEmailCampaignService CampaignService

<PageTitle>Unsubscribe</PageTitle>

<div class="gws-booking-shell">
    <div class="card border-0 shadow-sm" style="max-width: 32rem;">
        <div class="card-body text-center py-5">
            @if (_loading)
            {
                <p class="text-secondary">Loading...</p>
            }
            else if (_success)
            {
                <i class="bi bi-check-circle-fill text-success" style="font-size: 2.5rem;"></i>
                <h1 class="h5 mt-3">You're unsubscribed</h1>
                <p class="text-secondary">You won't receive any more emails from our campaigns.</p>
            }
            else
            {
                <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size: 2.5rem;"></i>
                <h1 class="h5 mt-3">Link not recognized</h1>
                <p class="text-secondary">This unsubscribe link is invalid or has already been used.</p>
            }
        </div>
    </div>
</div>

<style>
    .gws-booking-shell {
        max-width: 42rem;
        margin: 0 auto;
        padding: 1rem 0 2rem;
    }
</style>

@code {
    [Parameter] public string Token { get; set; } = string.Empty;

    private bool _loading = true;
    private bool _success;

    protected override async Task OnInitializedAsync()
    {
        _success = await CampaignService.UnsubscribeByTokenAsync(Token);
        _loading = false;
    }
}
