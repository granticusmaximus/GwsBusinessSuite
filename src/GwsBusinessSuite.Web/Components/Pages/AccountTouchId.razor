@page "/admin/account/touch-id"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "ContentAccess")]
@using GwsBusinessSuite.Application.Wiki
@using GwsBusinessSuite.Web.Components.Pages.BusinessSuite

<PageTitle>Touch ID, Face ID &amp; page lock</PageTitle>

@* One clear place (account menu) for Touch ID sign-in and page-lock setup - the same controls as
   Sentinel's Page lock settings panel. *@
<div class="gws-account-touchid">
    <header class="gws-touchid-hero">
        <div class="gws-touchid-hero-print" aria-hidden="true"><i class="bi bi-fingerprint"></i></div>
        <div>
            <h1 class="h3 mb-1">Sign in with your fingerprint or face</h1>
            <p class="text-secondary mb-0">No password or authenticator code: Touch ID, Face ID or your phone's fingerprint signs you in, and opens your locked Sentinel pages.</p>
        </div>
    </header>

    @* The three ways in (31-10-26). The Mac app's Touch ID also signs browsers in, from anywhere,
       through "Approve on my Mac" - a browser passkey can't be shared with the app. *@
    <div class="gws-touchid-ways">
        <article>
            <i class="bi bi-laptop" aria-hidden="true"></i>
            <h2>The Mac app</h2>
            <p>Set up once in the app, and it opens with Touch ID every time - which also turns on Mac-only tools like Content Studio.</p>
            <p class="gws-touchid-how">In the Mac app: this page's <strong>Set up Touch ID for this Mac</strong>, or GWS Business Suite → Set Up Touch ID.</p>
        </article>
        <article>
            <i class="bi bi-display" aria-hidden="true"></i>
            <h2>Any browser, with your Mac</h2>
            <p>On the sign-in page choose <strong>Approve on my Mac</strong>. Pick the same number in the Mac app and touch the sensor.</p>
            <p class="gws-touchid-how">Works from any computer while the Mac app is open with Touch ID set up.</p>
        </article>
        <article>
            <i class="bi bi-fingerprint" aria-hidden="true"></i>
            <h2>This browser, phone or tablet</h2>
            <p>Safari or Chrome on a Mac, an iPhone, an iPad or an Android phone can keep its own passkey, then sign in with <strong>Touch ID</strong>, <strong>Face ID</strong> or your fingerprint on the sign-in page.</p>
            <p class="gws-touchid-how">Add it below, on that device. On a phone or tablet, add it in the app on your Home Screen (or in Safari: they share the passkey).</p>
        </article>
    </div>

    @if (string.IsNullOrEmpty(_sessionId))
    {
        <div class="alert alert-warning small">This sign-in started before Touch ID was added. Sign out and sign in again to set it up.</div>
    }
    <p class="small text-secondary mb-3">
        <i class="bi bi-shield-lock me-1" aria-hidden="true"></i>If you already have a PIN or Touch ID, you'll be asked to unlock with it before adding another -
        so someone who only knows your password can't add their own fingerprint. A PIN is also the backup for locked pages.
    </p>
    <SentinelLockSettingsPanel SessionId="@_sessionId" TouchIdSettings="TouchIdSettings" ShowClose="false" />
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string? _sessionId;

    private RenderFragment TouchIdSettings => @<SentinelPasskeyControls Mode="settings" SessionId="@_sessionId" />;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
            _sessionId = (await AuthState).User.FindFirst(SentinelPageLock.SessionClaim)?.Value;
    }
}
