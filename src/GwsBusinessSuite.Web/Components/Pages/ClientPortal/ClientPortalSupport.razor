@page "/client-portal/support"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "ClientPortalAccess")]
@using Microsoft.AspNetCore.Authorization
@using GwsBusinessSuite.Application.Support
@using GwsBusinessSuite.Domain.Entities
@using GwsBusinessSuite.Web.Security
@inject ISupportTicketService TicketService

<PageTitle>Support</PageTitle>

<div class="gws-portal-shell">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h1 class="h4 mb-0">Support</h1>
        <a class="btn btn-outline-secondary btn-sm" href="/client-portal">Back to dashboard</a>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3 fw-semibold">New Ticket</div>
                <div class="card-body">
                    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                    {
                        <div class="alert alert-danger py-2 px-3 small">@ErrorMessage</div>
                    }
                    <div class="mb-2">
                        <input class="form-control form-control-sm" placeholder="Subject" @bind="_newSubject" />
                    </div>
                    <div class="mb-2">
                        <textarea class="form-control form-control-sm" rows="3" placeholder="How can we help?" @bind="_newMessage"></textarea>
                    </div>
                    <div class="mb-2">
                        <InputFile OnChange="args => OnFilesSelectedAsync(args, _newAttachments)" multiple class="form-control form-control-sm" />
                        @if (_newAttachments.Count > 0)
                        {
                            <div class="small text-secondary mt-1">@string.Join(", ", _newAttachments.Select(a => a.FileName))</div>
                        }
                    </div>
                    <button class="btn btn-sm btn-primary w-100" disabled="@_isBusy" @onclick="CreateTicketAsync">
                        <i class="bi bi-plus-lg me-1"></i>Send
                    </button>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3 fw-semibold">Your Tickets</div>
                <div class="card-body p-0">
                    @if (Tickets.Count == 0)
                    {
                        <div class="p-4 text-secondary">No tickets yet.</div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var ticket in Tickets)
                            {
                                <button type="button" class="list-group-item list-group-item-action @(SelectedTicketId == ticket.Id ? "active" : "")"
                                        @onclick="() => SelectTicketAsync(ticket.Id)">
                                    <div class="fw-semibold text-truncate">@ticket.Subject</div>
                                    <span class="badge gws-portal-badge">@ticket.Status</span>
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            @if (SelectedTicket is null)
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-secondary">Select a ticket to view the conversation.</div>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom py-3">
                        <div class="fw-semibold">@SelectedTicket.Subject</div>
                        <span class="badge gws-portal-badge">@SelectedTicket.Status</span>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            @foreach (var message in SelectedTicket.Messages)
                            {
                                <div class="mb-3 @(message.AuthorType == SupportTicketAuthorTypes.Contact ? "text-end" : "")">
                                    <div class="small text-secondary">@message.AuthorName &middot; @message.CreatedAt.ToLocalTime().ToString("MMM d, h:mm tt")</div>
                                    <SafeMarkdownContent Content="@message.Body"
                                                         CssClass="@(message.AuthorType == SupportTicketAuthorTypes.Contact ? "d-inline-block p-2 rounded bg-primary-subtle" : "d-inline-block p-2 rounded bg-secondary-subtle")"
                                                         style="max-width: 80%; text-align: left;" />
                                    @if (message.Attachments.Count > 0)
                                    {
                                        <div class="mt-1">
                                            @foreach (var attachment in message.Attachments)
                                            {
                                                <a class="d-inline-flex align-items-center gap-1 small me-2" href="/support/attachments/@attachment.Id" target="_blank">
                                                    <i class="bi bi-paperclip"></i>@attachment.FileName
                                                </a>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        @if (SelectedTicket.Status == SupportTicketStatuses.Resolved)
                        {
                            @if (SelectedTicket.SatisfactionRating is { } rating)
                            {
                                <div class="alert alert-light border small mb-3">
                                    Thanks for your feedback! You rated this @rating / 5.
                                    @if (!string.IsNullOrWhiteSpace(SelectedTicket.SatisfactionComment))
                                    {
                                        <div class="mt-1 fst-italic">"@SelectedTicket.SatisfactionComment"</div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-light border mb-3">
                                    <div class="fw-semibold mb-2">How did we do?</div>
                                    <div class="d-flex gap-2 mb-2">
                                        @for (var star = 1; star <= 5; star++)
                                        {
                                            var value = star;
                                            <button type="button" class="btn btn-sm @(_ratingValue >= value ? "btn-warning" : "btn-outline-secondary")"
                                                    @onclick="() => _ratingValue = value">
                                                <i class="bi bi-star-fill"></i>
                                            </button>
                                        }
                                    </div>
                                    <textarea class="form-control form-control-sm mb-2" rows="2" placeholder="Optional comment" @bind="_ratingComment"></textarea>
                                    <button class="btn btn-sm btn-primary" disabled="@(_isBusy || _ratingValue == 0)" @onclick="SubmitSatisfactionRatingAsync">
                                        Submit rating
                                    </button>
                                </div>
                            }
                        }
                        <div class="d-flex gap-2">
                            <div class="flex-grow-1">
                                <textarea class="form-control" rows="2" placeholder="Reply..." @bind="_replyBody"></textarea>
                                <InputFile OnChange="args => OnFilesSelectedAsync(args, _replyAttachments)" multiple class="form-control form-control-sm mt-1" />
                                @if (_replyAttachments.Count > 0)
                                {
                                    <div class="small text-secondary mt-1">@string.Join(", ", _replyAttachments.Select(a => a.FileName))</div>
                                }
                            </div>
                            <button class="btn btn-primary align-self-end" disabled="@_isBusy" @onclick="ReplyAsync">Send</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthStateTask { get; set; }

    private Guid _contactId;
    private string _contactName = "You";
    private IReadOnlyList<SupportTicketView> Tickets { get; set; } = [];
    private SupportTicketView? SelectedTicket { get; set; }
    private Guid? SelectedTicketId { get; set; }
    private string ErrorMessage { get; set; } = string.Empty;
    private bool _isBusy;

    private string _newSubject = string.Empty;
    private string _newMessage = string.Empty;
    private string _replyBody = string.Empty;
    private const long MaxAttachmentBytes = 10 * 1024 * 1024;
    private const int MaxAttachmentsPerMessage = 5;
    private readonly List<SupportTicketAttachmentUpload> _newAttachments = [];
    private readonly List<SupportTicketAttachmentUpload> _replyAttachments = [];
    private int _ratingValue;
    private string _ratingComment = string.Empty;

    private async Task OnFilesSelectedAsync(InputFileChangeEventArgs args, List<SupportTicketAttachmentUpload> target)
    {
        ErrorMessage = string.Empty;
        target.Clear();
        foreach (var file in args.GetMultipleFiles(MaxAttachmentsPerMessage))
        {
            if (file.Size > MaxAttachmentBytes)
            {
                ErrorMessage = $"'{file.Name}' exceeds the {MaxAttachmentBytes / 1024 / 1024} MB attachment limit.";
                target.Clear();
                return;
            }

            using var stream = new MemoryStream();
            await file.OpenReadStream(MaxAttachmentBytes).CopyToAsync(stream);
            target.Add(new SupportTicketAttachmentUpload(file.Name, stream.ToArray()));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            _contactName = authState.User.Identity?.Name ?? "You";
            Guid.TryParse(
                authState.User.FindFirst(ClientPortalAuthenticationDefaults.ContactIdClaim)?.Value,
                out _contactId);
        }

        await RefreshTicketsAsync();
    }

    private async Task RefreshTicketsAsync()
    {
        Tickets = await TicketService.ListTicketsForContactAsync(_contactId);
        if (SelectedTicketId is { } id)
        {
            SelectedTicket = Tickets.FirstOrDefault(ticket => ticket.Id == id);
        }
    }

    private async Task SelectTicketAsync(Guid ticketId)
    {
        SelectedTicketId = ticketId;
        SelectedTicket = await TicketService.GetTicketAsync(ticketId);
        _replyBody = string.Empty;
        _ratingValue = 0;
        _ratingComment = string.Empty;
    }

    private async Task CreateTicketAsync()
    {
        ErrorMessage = string.Empty;
        _isBusy = true;
        try
        {
            var created = await TicketService.CreateTicketAsync(
                _contactId, _newSubject, _newMessage, SupportTicketAuthorTypes.Contact, _contactName, _newAttachments);
            _newSubject = string.Empty;
            _newMessage = string.Empty;
            _newAttachments.Clear();
            await RefreshTicketsAsync();
            await SelectTicketAsync(created.Id);
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task SubmitSatisfactionRatingAsync()
    {
        if (SelectedTicketId is not { } ticketId || _ratingValue == 0) return;

        ErrorMessage = string.Empty;
        _isBusy = true;
        try
        {
            await TicketService.SubmitSatisfactionRatingAsync(ticketId, _ratingValue, _ratingComment);
            await RefreshTicketsAsync();
            await SelectTicketAsync(ticketId);
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task ReplyAsync()
    {
        if (SelectedTicketId is not { } ticketId || string.IsNullOrWhiteSpace(_replyBody)) return;

        _isBusy = true;
        try
        {
            await TicketService.AddReplyAsync(ticketId, SupportTicketAuthorTypes.Contact, _contactName, _replyBody, _replyAttachments);
            _replyBody = string.Empty;
            _replyAttachments.Clear();
            await RefreshTicketsAsync();
            await SelectTicketAsync(ticketId);
        }
        finally
        {
            _isBusy = false;
        }
    }
}

<style>
    .gws-portal-shell {
        max-width: 68rem;
        margin: 0 auto;
        padding: 1rem 0 2rem;
        --gws-portal-accent: #f59e0b;
    }

    .gws-portal-badge {
        background: color-mix(in srgb, var(--gws-portal-accent) 20%, transparent);
        color: var(--gws-portal-accent);
        font-weight: 600;
    }
</style>
