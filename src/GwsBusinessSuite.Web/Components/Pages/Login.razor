@page "/admin/login"
@attribute [AllowAnonymous]
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using GwsBusinessSuite.Web.Services

<PageTitle>Admin Login</PageTitle>

<div class="gws-login-shell">
    <div class="gws-login-brand">
        <div class="gws-login-brand-mark">
            <img src="favicon.svg" alt="" />
            <span>GWS Business Suite</span>
        </div>
        <div class="gws-login-brand-copy">
            <span class="gws-login-rule"></span>
            <h1>Everything one operator needs, in one place.</h1>
            <p>Content, relationships, growth, and a private knowledge workspace — run from a single admin,
                without the sprawl of a dozen disconnected tools.</p>
        </div>
        <div class="gws-login-stats">
            <div><strong>Sentinel</strong><span>Knowledge workspace</span></div>
            <div><strong>CRM</strong><span>Contacts &amp; pipeline</span></div>
            <div><strong>Automation</strong><span>Workflows that run</span></div>
        </div>
    </div>

    <div class="gws-login-form-panel">
        <span class="gws-login-eyebrow">Admin access</span>
        <h2>Welcome back</h2>
        <p class="gws-login-sub">Sign in to continue to your workspace.</p>

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="alert alert-danger" role="alert">@ErrorMessage</div>
        }

        @* Fingerprint first (31-10-26): Touch ID on this computer (a passkey), the Mac app's Touch ID
           from any browser ("Approve on my Mac"), or inside the Mac app its own Touch ID.
           js/sentinel-passkey-login.js shows what this browser can use and runs the scanner. *@
        <section class="gws-touchid" id="gws-touchid" data-state="idle" data-return-url="@ResolvedReturnUrl" hidden>
            <div class="gws-touchid-scanner" aria-hidden="true">
                <span class="gws-touchid-ring"></span>
                <span class="gws-touchid-ring gws-touchid-ring-late"></span>
                <i class="bi bi-fingerprint gws-touchid-print"></i>
                <span class="gws-touchid-sweep"></span>
                <i class="bi bi-check-lg gws-touchid-check"></i>
            </div>
            <div class="gws-touchid-title" id="gws-touchid-title">Sign in with your fingerprint</div>
            <div class="gws-touchid-number" id="gws-touchid-number" hidden></div>
            <div class="gws-touchid-status" id="gws-touchid-status" role="status" aria-live="polite"></div>
            <div class="gws-touchid-actions">
                <button type="button" class="btn btn-primary" id="gws-touchid-here" hidden>
                    <i class="bi bi-fingerprint" aria-hidden="true"></i> Touch ID
                </button>
                <button type="button" class="btn btn-outline-secondary" id="gws-touchid-mac" hidden>
                    <i class="bi bi-laptop" aria-hidden="true"></i> Approve on my Mac
                </button>
                @* The Mac app handles gws-native:// itself (MainPage.OnWorkspaceNavigating). *@
                <a class="btn btn-primary" id="gws-touchid-app" href="gws-native://signin" hidden>
                    <i class="bi bi-fingerprint" aria-hidden="true"></i> Sign in with Touch ID
                </a>
                <button type="button" class="btn btn-link btn-sm" id="gws-touchid-cancel" hidden>Cancel</button>
            </div>
        </section>
        <div class="gws-login-divider" id="gws-touchid-divider" hidden><span>or use your password</span></div>

        <form method="post" action="auth/login">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ResolvedReturnUrl" />

            <div class="mb-3">
                <label class="form-label fw-semibold small">Username</label>
                <input class="form-control" id="gws-login-username" name="username" autocomplete="username"
                       required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold small">Password</label>
                <input class="form-control" id="gws-login-password" type="password" name="password"
                       autocomplete="current-password" required />
            </div>

            <button type="submit" class="btn btn-primary w-100 gws-login-submit">Sign In</button>
        </form>


        <p class="text-secondary small mt-3 mb-0 gws-login-note">
            <i class="bi bi-shield-lock"></i> This area is restricted to administrators.
        </p>
    </div>
</div>

<script src="js/login-tab-focus.js"></script>
<script type="module" src="js/sentinel-passkey-login.js?v=2"></script>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "minutes")]
    public int? LockoutMinutes { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private string ErrorMessage { get; set; } = string.Empty;
    private string ReturnUrl { get; set; } = "/";

    private string ResolvedReturnUrl
        => PortalNavigation.IsSafeLocalPath(ReturnUrl)
            ? ReturnUrl!
            : "/";

    protected override async Task OnParametersSetAsync()
    {
        ReturnUrl = ResolveReturnUrlFromQuery();

        if (AuthenticationStateTask is not null)
        {
            var authState = await AuthenticationStateTask;
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                Navigation.NavigateTo(ResolvedReturnUrl, forceLoad: true);
                return;
            }
        }

        if (string.Equals(Error, "invalid", StringComparison.OrdinalIgnoreCase))
        {
            ErrorMessage = "Invalid admin credentials.";
        }
        else if (string.Equals(Error, "missing", StringComparison.OrdinalIgnoreCase))
        {
            ErrorMessage = "Admin credentials are not configured on the server.";
        }
        else if (string.Equals(Error, "ratelimit", StringComparison.OrdinalIgnoreCase))
        {
            var minutesText = LockoutMinutes is > 0 ? $"{LockoutMinutes} minute(s)" : "a few minutes";
            ErrorMessage = $"Too many sign-in attempts from this network. Try again in {minutesText}.";
        }
        else if (string.Equals(Error, "locked", StringComparison.OrdinalIgnoreCase))
        {
            var minutesText = LockoutMinutes is > 0 ? $"{LockoutMinutes} minute(s)" : "a few minutes";
            ErrorMessage = $"Too many failed attempts on this account. Try again in {minutesText}, or contact an administrator to unlock it.";
        }
        else if (string.Equals(Error, "touchid", StringComparison.OrdinalIgnoreCase))
        {
            ErrorMessage = "Touch ID sign-in didn't work - sign in with your password instead.";
        }
        else if (string.Equals(Error, "mac", StringComparison.OrdinalIgnoreCase))
        {
            ErrorMessage = "The approval from your Mac didn't go through - try again, or sign in with your password.";
        }
        else if (string.Equals(Error, "device", StringComparison.OrdinalIgnoreCase))
        {
            ErrorMessage = "The app's sign-in didn't carry over (it may have taken over a minute) - sign in here instead.";
        }
        else if (string.Equals(Error, "expired", StringComparison.OrdinalIgnoreCase))
        {
            ErrorMessage = "Your verification session expired. Enter your username and password again.";
        }
        else
        {
            ErrorMessage = string.Empty;
        }
    }

    private string ResolveReturnUrlFromQuery()
    {
        var query = QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);

        if (query.TryGetValue("returnUrl", out var lowerValue) && PortalNavigation.IsSafeLocalPath(lowerValue.ToString()))
        {
            return lowerValue.ToString();
        }

        if (query.TryGetValue("ReturnUrl", out var upperValue) && PortalNavigation.IsSafeLocalPath(upperValue.ToString()))
        {
            return upperValue.ToString();
        }

        return "/";
    }
}

<style>
    /* The brand panel is a deliberate fixed-dark design (like most split-screen login brand
       panels, regardless of app theme) - it's the product's first impression, not a themed
       admin surface, so it doesn't need to (and shouldn't) flip with the light/dark toggle. The
       form panel on the right uses the real --gws-* tokens and does adapt. */
    .gws-login-shell {
        display: flex;
        width: min(100%, 64rem);
        margin: 0 auto;
        border: 1px solid var(--gws-panel-border);
        border-radius: 18px;
        overflow: hidden;
        box-shadow: var(--gws-shadow-md);
    }

    .gws-login-brand {
        flex: 1.1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 2.5rem;
        padding: clamp(2rem, 4vw, 3.25rem);
        background:
            radial-gradient(circle at 18% 12%, rgba(245, 158, 11, .12), transparent 46%),
            radial-gradient(circle at 82% 88%, rgba(245, 158, 11, .07), transparent 50%),
            #100e0c;
        color: #fafaf9;
    }

    .gws-login-brand-mark { display: flex; align-items: center; gap: .65rem; font-weight: 700; font-size: .92rem; }
    .gws-login-brand-mark img { width: 1.5rem; height: 1.5rem; }

    .gws-login-rule { display: block; width: 2.75rem; height: 2px; margin-bottom: 1.35rem; background: #f59e0b; }
    .gws-login-brand-copy h1 {
        margin: 0;
        font: 800 clamp(1.7rem, 2.7vw, 2.5rem)/1.14 var(--gws-font-serif);
        letter-spacing: -.015em;
        max-width: 22ch;
    }
    .gws-login-brand-copy p { max-width: 32ch; margin: 1.1rem 0 0; color: #a8a29e; font-size: .9rem; line-height: 1.6; }

    .gws-login-stats { display: flex; gap: 1.75rem; }
    .gws-login-stats strong { display: block; font: 800 1rem var(--gws-font-serif); color: #fafaf9; }
    .gws-login-stats span { display: block; margin-top: .2rem; color: #78716c; font-size: .72rem; }

    .gws-login-form-panel {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: clamp(2rem, 4vw, 3.25rem);
        background: var(--gws-panel-bg);
    }

    .gws-login-eyebrow {
        display: inline-block;
        margin-bottom: .6rem;
        color: var(--gws-sidebar-accent);
        font-size: .68rem;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
    }
    .gws-login-form-panel h2 { margin: 0 0 .4rem; font: 800 1.6rem var(--gws-font-serif); color: var(--gws-text-strong); }
    .gws-login-sub { margin: 0 0 1.6rem; color: var(--gws-text-soft); font-size: .85rem; }

    .gws-login-submit { font-weight: 700; }

    .gws-login-note {
        display: flex;
        align-items: center;
        gap: .5rem;
        border-top: 1px solid var(--gws-panel-border);
        padding-top: .85rem;
        color: var(--gws-text-soft);
    }

    /* The fingerprint scanner (31-10-26). States on data-state: idle (a slow pulse), scanning
       (a sweep while Touch ID is asked), waiting (Mac approval: the number to pick), done, error. */
    .gws-touchid { display: flex; flex-direction: column; align-items: center; text-align: center; margin-bottom: .4rem; }
    .gws-touchid-scanner {
        position: relative;
        display: grid;
        place-items: center;
        width: 5.5rem;
        height: 5.5rem;
        margin-bottom: .9rem;
        border-radius: 50%;
        background: radial-gradient(circle at 50% 40%, rgba(245, 158, 11, .16), rgba(245, 158, 11, .04) 70%);
        box-shadow: inset 0 0 0 1px rgba(245, 158, 11, .35);
        color: #f59e0b;
        overflow: hidden;
        transition: color .3s ease, box-shadow .3s ease, background .3s ease;
    }
    .gws-touchid-print { font-size: 2.9rem; line-height: 1; transition: opacity .25s ease, transform .3s ease; }
    .gws-touchid-check { position: absolute; font-size: 2.6rem; line-height: 1; opacity: 0; transform: scale(.6); transition: opacity .25s ease, transform .3s ease; }
    .gws-touchid-ring {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        border: 1px solid rgba(245, 158, 11, .45);
        animation: gws-touchid-pulse 3.2s ease-out infinite;
    }
    .gws-touchid-ring-late { animation-delay: 1.6s; }
    .gws-touchid-sweep {
        position: absolute;
        left: 12%;
        right: 12%;
        top: 0;
        height: 2px;
        border-radius: 2px;
        background: linear-gradient(90deg, transparent, #fbbf24, transparent);
        box-shadow: 0 0 10px rgba(251, 191, 36, .9);
        opacity: 0;
    }
    .gws-touchid-title { font-weight: 700; color: var(--gws-text-strong); }
    .gws-touchid-status { min-height: 1.25rem; margin-top: .2rem; color: var(--gws-text-soft); font-size: .82rem; max-width: 30ch; }
    .gws-touchid-number { margin-top: .35rem; font: 800 2.6rem/1 var(--gws-font-serif); letter-spacing: .08em; color: var(--gws-text-strong); }
    .gws-touchid-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem; margin-top: .9rem; }
    .gws-touchid-actions .btn { display: inline-flex; align-items: center; gap: .4rem; font-weight: 700; }

    /* While it's busy only Cancel stays: the two ways in come back on a result. */
    .gws-touchid:is([data-state="scanning"], [data-state="waiting"], [data-state="done"]) :is(#gws-touchid-here, #gws-touchid-mac, #gws-touchid-app) { display: none; }
    .gws-touchid[data-state="scanning"] .gws-touchid-sweep { opacity: 1; animation: gws-touchid-sweep 1.4s ease-in-out infinite; }
    .gws-touchid[data-state="scanning"] .gws-touchid-ring,
    .gws-touchid[data-state="waiting"] .gws-touchid-ring { animation-duration: 1.6s; }
    .gws-touchid[data-state="scanning"] .gws-touchid-scanner,
    .gws-touchid[data-state="waiting"] .gws-touchid-scanner { box-shadow: inset 0 0 0 1px rgba(245, 158, 11, .7), 0 0 26px rgba(245, 158, 11, .28); }
    .gws-touchid[data-state="done"] .gws-touchid-scanner { color: #22c55e; background: radial-gradient(circle at 50% 40%, rgba(34, 197, 94, .2), rgba(34, 197, 94, .05) 70%); box-shadow: inset 0 0 0 1px rgba(34, 197, 94, .6); }
    .gws-touchid[data-state="done"] .gws-touchid-print { opacity: 0; transform: scale(.7); }
    .gws-touchid[data-state="done"] .gws-touchid-check { opacity: 1; transform: none; }
    .gws-touchid[data-state="done"] .gws-touchid-ring { border-color: rgba(34, 197, 94, .5); }
    .gws-touchid[data-state="error"] .gws-touchid-scanner { color: #ef4444; background: radial-gradient(circle at 50% 40%, rgba(239, 68, 68, .16), rgba(239, 68, 68, .04) 70%); box-shadow: inset 0 0 0 1px rgba(239, 68, 68, .55); animation: gws-touchid-shake .4s ease; }
    .gws-touchid[data-state="error"] .gws-touchid-ring { animation: none; opacity: 0; }
    .gws-touchid[data-state="error"] .gws-touchid-status { color: #ef4444; }

    @@keyframes gws-touchid-pulse { from { transform: scale(1); opacity: .9; } to { transform: scale(1.55); opacity: 0; } }
    @@keyframes gws-touchid-sweep { 0% { top: 12%; } 50% { top: 86%; } 100% { top: 12%; } }
    @@keyframes gws-touchid-shake { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-5px); } 75% { transform: translateX(5px); } }
    @@media (prefers-reduced-motion: reduce) {
        .gws-touchid-ring, .gws-touchid-sweep, .gws-touchid-scanner { animation: none !important; }
    }

    .gws-login-divider {
        display: flex;
        align-items: center;
        gap: .75rem;
        margin: 1.1rem 0 1rem;
        color: var(--gws-text-soft);
        font-size: .72rem;
        letter-spacing: .04em;
        text-transform: uppercase;
    }
    .gws-login-divider::before, .gws-login-divider::after { content: ""; flex: 1; border-top: 1px solid var(--gws-panel-border); }

    @@media (max-width: 820px) {
        .gws-login-shell { flex-direction: column; width: min(100%, 28rem); }
        .gws-login-brand { gap: 1.5rem; }
        .gws-login-stats { display: none; }
    }
</style>
