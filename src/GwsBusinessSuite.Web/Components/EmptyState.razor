@* Shared "nothing here yet" treatment - replaces each page's own plain <p>/<div> empty-state
   copy so an empty list looks the same everywhere instead of varying page to page. *@

<div class="gws-empty-state @CssClass">
    <i class="bi @Icon" aria-hidden="true"></i>
    @if (!string.IsNullOrEmpty(Title))
    {
        <strong class="gws-empty-state-title">@Title</strong>
    }
    <span>@Message</span>
    @if (ChildContent is not null)
    {
        @ChildContent
    }
</div>

@code {
    [Parameter] public string Icon { get; set; } = "bi-inbox";
    // Shell redesign R2: a list's empty state names what goes here (Title), says how it fills
    // up (Message), and offers the first action (ChildContent, e.g. a data-gws-focus button).
    [Parameter] public string? Title { get; set; }
    [Parameter, EditorRequired] public string Message { get; set; } = string.Empty;
    [Parameter] public string CssClass { get; set; } = "p-4 text-secondary";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
