@* While a list loads. It drew placeholder rows (shell redesign R5); since 30-10-26 it's the
   Overwatch boot screen like every other loading state (Grant: the same loading screen across the
   admin portal), so the 34 lists using it needn't change. Rows and Grid are kept for them; screen
   readers still hear Message. *@
<LoadingIndicator Message="@Message" CssClass="@(CssClass ?? "py-3")" />

@code {
    [Parameter] public string Message { get; set; } = "Loading…";
    [Parameter] public int Rows { get; set; } = 5;
    [Parameter] public bool Grid { get; set; }
    [Parameter] public string? CssClass { get; set; }
}
