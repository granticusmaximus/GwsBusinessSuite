@* Placeholder rows while a list loads (shell redesign R5), in place of a spinner, so the page
   keeps its shape; screen readers still hear Message. Grid draws tiles for card layouts. Single
   records and checks (a contact, Settings, "Checking Docker…") keep LoadingIndicator. *@
<div class="gws-skeleton @(Grid ? "is-grid" : string.Empty) @CssClass" role="status">
    <span class="visually-hidden">@Message</span>
    @for (var row = 0; row < Rows; row++)
    {
        <div class="gws-skeleton-row" aria-hidden="true"><span></span><span></span><span></span></div>
    }
</div>

@code {
    [Parameter] public string Message { get; set; } = "Loading…";
    [Parameter] public int Rows { get; set; } = 5;
    [Parameter] public bool Grid { get; set; }
    [Parameter] public string? CssClass { get; set; }
}
