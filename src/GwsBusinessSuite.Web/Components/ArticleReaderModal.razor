@using GwsBusinessSuite.Application.NewsIntelligence
@inject IArticleReader Reader
@inject IJSRuntime JS
@* Media Watch's reader (20-11-26): the article from the outlet's own page, formatted here, with
   the original one click away. Read later and finished (the reading queue), why it matters
   (three takeaways from the local model), notes and highlights, and a full-text clip to Sentinel.
   Copying works as in every modal (app.js adds the Copy button). *@

@if (Url is not null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal d-block gws-reader-modal" tabindex="-1" role="dialog" aria-modal="true" aria-label="@(_article?.Title ?? Title)" @onkeydown="OnKeyDown">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="gws-reader-heading">
                        <h2 class="modal-title h5">@(_article?.Title ?? Title ?? "Article")</h2>
                        @if (_article is { } meta && meta.Readable)
                        {
                            <div class="gws-reader-meta">
                                @meta.Site
                                @if (!string.IsNullOrWhiteSpace(meta.Byline)) { <span> · @meta.Byline</span> }
                                @if (meta.PublishedAt is { } published) { <span> · @published.ToLocalGwsDate()</span> }
                                <span> · @meta.Minutes min read</span>
                            </div>
                        }
                    </div>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseAsync"></button>
                </div>
                <div class="modal-body">
                    @if (_loading)
                    {
                        <LoadingIndicator Message="@(_translated ? "Translating the article into English…" : "Reading the article…")" />
                    }
                    else if (_article is { Readable: true } article)
                    {
                        @if (_translated)
                        {
                            <p class="gws-reader-translated small text-secondary"><i class="bi bi-translate" aria-hidden="true"></i> Translated into English by the AI model. Check the original before relying on a detail.</p>
                        }
                        @if (_takeaways is not null || _thinking)
                        {
                            <section class="gws-reader-takeaways" aria-label="Why it matters">
                                <h3 class="h6">Why it matters</h3>
                                @if (_thinking)
                                {
                                    <LoadingIndicator Message="Reading it for takeaways…" />
                                }
                                else if (_takeaways is { Problem: { } problem } && _takeaways.Points.Count == 0)
                                {
                                    <p class="mb-0 text-warning-emphasis">@problem</p>
                                }
                                else if (_takeaways is { } takeaways)
                                {
                                    <ul class="mb-2">
                                        @foreach (var point in takeaways.Points) { <li>@point</li> }
                                    </ul>
                                    @if (!string.IsNullOrWhiteSpace(takeaways.ForGws)) { <p class="mb-0"><strong>For GWS:</strong> @takeaways.ForGws</p> }
                                }
                            </section>
                        }
                        <article class="gws-reader-body">@((MarkupString)article.Html)</article>
                        @* Ask the article (20-11-26): answered from its text only, with the passage. *@
                        <section class="gws-reader-ask" aria-label="Ask the article">
                            <h3 class="h6">Ask the article</h3>
                            <form class="d-flex gap-2" @onsubmit="AskAsync" @onsubmit:preventDefault="true">
                                <input class="form-control form-control-sm" placeholder="What does it say about…?" aria-label="Your question"
                                       maxlength="300" @bind="_question" @bind:event="oninput" />
                                <button type="submit" class="btn btn-sm btn-outline-primary" disabled="@(_asking || _question.Trim().Length < 3)">@(_asking ? "Asking…" : "Ask")</button>
                            </form>
                            @if (_answer is { } answer)
                            {
                                <div class="gws-reader-answer mt-2" role="status">
                                    @if (answer.Problem is { } askProblem)
                                    {
                                        <p class="mb-0 text-warning-emphasis">@askProblem</p>
                                    }
                                    else
                                    {
                                        <p class="mb-1">@answer.Answer</p>
                                        @if (!string.IsNullOrWhiteSpace(answer.Quote))
                                        {
                                            <blockquote class="mb-0">“@answer.Quote”</blockquote>
                                        }
                                    }
                                </div>
                            }
                        </section>
                        @if (ReadingTools)
                        {
                        <section class="gws-reader-notes" aria-label="Notes">
                            <h3 class="h6">Notes and highlights</h3>
                            @if (_highlights.Count > 0)
                            {
                                <ul class="list-unstyled mb-2">
                                    @foreach (var highlight in _highlights.ToList())
                                    {
                                        <li class="gws-reader-highlight">
                                            <blockquote class="mb-0">@highlight</blockquote>
                                            <button type="button" class="btn btn-sm btn-link text-danger" aria-label="Remove highlight" @onclick="() => _highlights.Remove(highlight)"><i class="bi bi-x-lg"></i></button>
                                        </li>
                                    }
                                </ul>
                            }
                            <textarea class="form-control form-control-sm mb-2" rows="3" placeholder="Your notes on this article…" aria-label="Notes" @bind="_notes" @bind:event="oninput"></textarea>
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onmousedown:preventDefault="true" @onclick="AddHighlightAsync">
                                    <i class="bi bi-highlighter" aria-hidden="true"></i> Add selection as highlight
                                </button>
                                @if (!string.IsNullOrWhiteSpace(_highlightHint)) { <span class="small text-secondary">@_highlightHint</span> }
                            </div>
                        </section>
                        }
                    }
                    else
                    {
                        <p class="gws-reader-problem">@(_article?.Problem ?? "The article couldn't be read.")</p>
                        @if (!string.IsNullOrWhiteSpace(Summary))
                        {
                            <p class="text-secondary">@Summary</p>
                        }
                    }
                </div>
                <div class="modal-footer gws-reader-actions">
                    @if (_article is { Readable: true } && _canSpeak)
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ToggleListenAsync" aria-pressed="@(_listening ? "true" : "false")">
                            <i class="bi @(_listening ? "bi-stop-circle" : "bi-volume-up")" aria-hidden="true"></i> @(_listening ? "Stop" : "Listen")
                        </button>
                    }
                    @if (!_loading && (_translated || _article is { Readable: true }))
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ToggleTranslationAsync">
                            <i class="bi bi-translate" aria-hidden="true"></i> @(_translated ? "Show the original" : "Translate to English")
                        </button>
                    }
                    @if (ReadingTools)
                    {
                    @if (_article is { Readable: true })
                    {
                        <button type="button" class="btn btn-outline-primary btn-sm" disabled="@_thinking" @onclick="TakeawaysAsync">
                            <i class="bi bi-lightbulb" aria-hidden="true"></i> Why it matters
                        </button>
                    }
                    @if (!Saved)
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => OnReadLater.InvokeAsync()">
                            <i class="bi bi-bookmark" aria-hidden="true"></i> Read later
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm @(Finished ? "btn-success" : "btn-outline-success")" @onclick="() => OnFinished.InvokeAsync(!Finished)">
                            <i class="bi bi-check2-circle" aria-hidden="true"></i> @(Finished ? "Finished" : "Mark finished")
                        </button>
                    }
                    <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@_clipping" @onclick="ClipAsync">
                        <i class="bi bi-journal-plus" aria-hidden="true"></i> @(_clipping ? "Clipping…" : ClippedPageId is null ? "Clip to Sentinel" : HasNotes ? "Add notes to the clip" : "Clipped")
                    </button>
                    @if (ClippedPageId is { } pageId)
                    {
                        <a class="btn btn-link btn-sm" href="/admin/sentinel?page=@pageId">Open the clip</a>
                    }
                    @if (OnFollowAuthor.HasDelegate && WriterName is { } writer)
                    {
                        var following = FollowedAuthors.Any(a => string.Equals(a, writer, StringComparison.OrdinalIgnoreCase));
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => OnFollowAuthor.InvokeAsync((writer, !following))">
                            <i class="bi @(following ? "bi-person-check-fill" : "bi-person-plus")" aria-hidden="true"></i> @(following ? $"Following {writer}" : $"Follow {writer}")
                        </button>
                    }
                    }
                    <a class="btn btn-outline-secondary btn-sm ms-auto" href="@Url" target="_blank" rel="noopener noreferrer">
                        Open the original <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                    </a>
                    <button type="button" class="btn btn-primary btn-sm" @onclick="CloseAsync">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? Url { get; set; }
    [Parameter] public string? Title { get; set; }
    // The feed's own summary, shown when the page can't be read here.
    [Parameter] public string? Summary { get; set; }
    [Parameter] public bool Saved { get; set; }
    [Parameter] public bool Finished { get; set; }
    [Parameter] public Guid? ClippedPageId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnReadLater { get; set; }
    [Parameter] public EventCallback<bool> OnFinished { get; set; }
    // Clips (or adds notes to the clip); true when it worked, so the notes are only cleared then.
    [Parameter] public Func<ClipExtras, Task<bool>>? Clip { get; set; }
    // The article once read (the page keeps its reading time for the queue).
    [Parameter] public EventCallback<ReaderArticle> OnRead { get; set; }
    // Opens translated into English (World News reports in other languages, 20-11-26).
    [Parameter] public bool StartTranslated { get; set; }
    // Read later, notes, takeaways and clips: Media Watch's reading desk. Off for a plain reader.
    [Parameter] public bool ReadingTools { get; set; } = true;
    // Follow an author (20-11-26): the feed's author, else the page's byline.
    [Parameter] public string? Author { get; set; }
    [Parameter] public IReadOnlyList<string> FollowedAuthors { get; set; } = [];
    [Parameter] public EventCallback<(string Name, bool Follow)> OnFollowAuthor { get; set; }

    private string? WriterName => NewsAuthors.Clean(Author) ?? NewsAuthors.Clean(_article?.Byline);

    private ReaderArticle? _article;
    private bool _loading;
    private string? _loadedUrl;
    private ReaderTakeaways? _takeaways;
    private bool _thinking;
    private string _notes = string.Empty;
    private readonly List<string> _highlights = [];
    private string? _highlightHint;
    private bool _clipping;
    private bool _translated;
    private bool _canSpeak;
    private bool _listening;
    private string _question = string.Empty;
    private bool _asking;
    private ReaderAnswer? _answer;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { _canSpeak = await JS.InvokeAsync<bool>("gwsReader.canSpeak"); }
        catch (JSException) { _canSpeak = false; }
        if (_canSpeak) StateHasChanged();
    }

    // Listen mode (20-11-26): the device's own voice reads the article.
    private async Task ToggleListenAsync()
    {
        if (_listening)
        {
            await JS.InvokeVoidAsync("gwsReader.stop");
            _listening = false;
            return;
        }
        if (_article is not { Readable: true } article) return;
        _listening = await JS.InvokeAsync<bool>("gwsReader.speak", new object[] { new[] { new { title = article.Title, text = article.Text } }, 1.0 });
    }

    private async Task AskAsync()
    {
        if (Url is null || _question.Trim().Length < 3) return;
        _asking = true;
        try { _answer = await Reader.AskAsync(Url, _question.Trim()); }
        finally { _asking = false; }
    }

    private bool HasNotes => !string.IsNullOrWhiteSpace(_notes) || _highlights.Count > 0;

    protected override async Task OnParametersSetAsync()
    {
        if (Url is null || Url == _loadedUrl) return;
        _loadedUrl = Url;
        _article = null;
        _takeaways = null;
        _notes = string.Empty;
        _highlights.Clear();
        _highlightHint = null;
        _answer = null;
        _question = string.Empty;
        _loading = true;
        _translated = StartTranslated;
        var url = Url;
        try
        {
            var article = _translated ? await Reader.TranslateAsync(url, Title) : await Reader.ReadAsync(url, Title);
            if (url != _loadedUrl) return;
            _article = article;
            if (article.Readable) await OnRead.InvokeAsync(article);
        }
        finally
        {
            if (url == _loadedUrl) _loading = false;
        }
    }

    private async Task ToggleTranslationAsync()
    {
        if (Url is null) return;
        var url = Url;
        _translated = !_translated;
        _loading = true;
        try
        {
            var article = _translated ? await Reader.TranslateAsync(url, Title) : await Reader.ReadAsync(url, Title);
            if (url == _loadedUrl) _article = article;
        }
        finally
        {
            if (url == _loadedUrl) _loading = false;
        }
    }

    private async Task TakeawaysAsync()
    {
        if (Url is null) return;
        _thinking = true;
        try { _takeaways = await Reader.TakeawaysAsync(Url); }
        finally { _thinking = false; }
    }

    private async Task AddHighlightAsync()
    {
        var text = await JS.InvokeAsync<string>("gwsReader.selection");
        if (string.IsNullOrWhiteSpace(text))
        {
            _highlightHint = "Select some of the article's text first.";
            return;
        }
        _highlightHint = null;
        if (!_highlights.Contains(text)) _highlights.Add(text.Length > 1500 ? text[..1500] + "…" : text);
    }

    private async Task ClipAsync()
    {
        _clipping = true;
        try
        {
            if (Clip is not null && await Clip(new ClipExtras(_notes, _highlights.ToList())))
            {
                _notes = string.Empty;
                _highlights.Clear();
            }
        }
        finally { _clipping = false; }
    }

    private async Task CloseAsync()
    {
        if (_listening)
        {
            try { await JS.InvokeVoidAsync("gwsReader.stop"); }
            catch (JSException) { }
            _listening = false;
        }
        _loadedUrl = null;
        _article = null;
        await OnClose.InvokeAsync();
    }

    private Task OnKeyDown(KeyboardEventArgs e) => e.Key == "Escape" ? CloseAsync() : Task.CompletedTask;
}
