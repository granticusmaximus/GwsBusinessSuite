<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GwsBusinessSuite.App.StreamingCaretView">

    <!-- A soft-pulsing block caret trailing the streamed text. Fades rather than hard-blinks:
         a hard blink next to text that is itself appearing reads as flicker, while a fade
         reads as "still writing". -->
    <BoxView x:Name="Caret" WidthRequest="7" HeightRequest="15" Color="#F59E0B"
             CornerRadius="1" VerticalOptions="End" Margin="2,0,0,2" Opacity="0.9" />

</ContentView>
