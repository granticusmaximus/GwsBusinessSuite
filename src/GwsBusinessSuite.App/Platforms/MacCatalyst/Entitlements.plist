<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <!-- See https://aka.ms/maui-publish-app-store#add-entitlements for more information about adding entitlements.-->
    <dict>
        <!-- App Sandbox must be enabled to distribute a MacCatalyst app through the Mac App Store. -->
        <key>com.apple.security.app-sandbox</key>
        <true/>
        <!-- When App Sandbox is enabled, this value is required to open outgoing network connections. -->
        <key>com.apple.security.network.client</key>
        <true/>
        <key>com.apple.security.device.camera</key>
        <true/>
        <key>com.apple.security.device.audio-input</key>
        <true/>
        <!-- Developer Mode's folder picker (CommunityToolkit.Maui) and the resulting file reads/
             writes inside a user-chosen workspace folder need this - the sandbox only grants
             access to a path a human explicitly picked via the system picker, not arbitrary
             paths on disk. -->
        <key>com.apple.security.files.user-selected.read-write</key>
        <true/>
        <!-- SecureApiKeyStore's grounding-key save fails with errSecMissingEntitlement under App
             Sandbox (confirmed empirically via a DEBUG-only spike) - Keychain writes need a
             keychain-access-groups entitlement. Tried adding it (both with and without
             $(AppIdentifierPrefix)) and both broke the app outright: "Launchd job spawn failed"
             at launch, plus build warning MT7139 ("no provisioning profile has been specified")
             even for the prefix-free form. This ad-hoc-signed local build has no provisioning
             profile at all, and this specific entitlement appears to require real Apple
             provisioning to pass sandbox validation, not just correct plist syntax. Deliberately
             NOT re-adding it without a provisioning profile in place first - see
             project_securestorage_keychain_entitlement_2026_08_25 (Claude session memory) for
             the real fix options. -->
    </dict>
</plist>

