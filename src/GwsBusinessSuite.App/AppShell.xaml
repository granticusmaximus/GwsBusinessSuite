<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="GwsBusinessSuite.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:GwsBusinessSuite.App"
    Title="GWS Business Suite"
    Shell.NavBarIsVisible="False"
    FlyoutBehavior="Disabled">
    <!-- MacCatalyst gets a native titlebar toolbar instead (see
         Platforms/MacCatalyst/MacWindowToolbar.cs) - Shell's own bottom tab bar is an iOS idiom
         that floated over the hosted site's own bottom-left chrome (the sidebar, Settings). -->
    <Shell.TabBarIsVisible>
        <OnPlatform x:TypeArguments="x:Boolean" Default="True">
            <On Platform="MacCatalyst" Value="False" />
        </OnPlatform>
    </Shell.TabBarIsVisible>

    <TabBar>
        <ShellContent
            Title="Workspace"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />
        <ShellContent
            Title="SentinelGPT"
            ContentTemplate="{DataTemplate local:SentinelGptPage}"
            Route="SentinelGptPage" />
    </TabBar>

</Shell>
