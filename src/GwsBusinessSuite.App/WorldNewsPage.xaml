<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GwsBusinessSuite.App"
             x:Class="GwsBusinessSuite.App.WorldNewsPage"
             BackgroundColor="#141210"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="380,*">

        <Grid Grid.Row="0" Grid.ColumnSpan="2" Padding="16,12" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10" BackgroundColor="#1C1917">
            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                <Label Text="World news" TextColor="#FAFAF9" FontAttributes="Bold" FontSize="16" />
                <Label x:Name="StatusLabel" TextColor="#A8A29E" FontSize="12" LineBreakMode="TailTruncation" />
            </VerticalStackLayout>
            <Entry Grid.Column="1" x:Name="FilterEntry" Placeholder="Filter events" WidthRequest="220" VerticalOptions="Center"
                   TextColor="#FAFAF9" PlaceholderColor="#78716C" BackgroundColor="#292524" TextChanged="OnFilterChanged" />
            <Picker Grid.Column="2" x:Name="RangePicker" WidthRequest="150" VerticalOptions="Center"
                    TextColor="#FAFAF9" BackgroundColor="#292524" SelectedIndexChanged="OnRangeChanged" />
            <Button Grid.Column="3" x:Name="RefreshButton" Text="Refresh" BackgroundColor="#F59E0B" TextColor="#1C1917" FontAttributes="Bold"
                    CornerRadius="8" Clicked="OnRefreshClicked" VerticalOptions="Center" />
        </Grid>

        <CollectionView Grid.Row="1" Grid.Column="0" x:Name="EventsList" SelectionMode="Single" SelectionChanged="OnEventSelected" Margin="0,6,0,0"
                        EmptyView="No events yet. The first read takes a minute or two, while the local model reads every headline.">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:WorldEventRow">
                    <VerticalStackLayout Padding="14,8" Spacing="2">
                        <Label Text="{Binding Title}" TextColor="#FAFAF9" FontSize="14" MaxLines="2" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding Meta}" TextColor="#A8A29E" FontSize="11" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="1" Grid.Column="1" Stroke="#292524" BackgroundColor="#141210" Margin="0,10,12,12">
            <WebView x:Name="DetailView" Navigating="OnDetailNavigating" />
        </Border>
    </Grid>
</ContentPage>
