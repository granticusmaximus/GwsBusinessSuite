<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GwsBusinessSuite.App"
             x:Class="GwsBusinessSuite.App.NativeOverwatchPage"
             Title="Overwatch"
             BackgroundColor="#141210"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
        <Grid Padding="14,10" ColumnDefinitions="Auto,*,Auto" BackgroundColor="#1C1917">
            <Button Text="‹ Back"
                    Padding="10,6"
                    BackgroundColor="Transparent"
                    TextColor="#FBBF24"
                    BorderColor="#66501F"
                    BorderWidth="1"
                    CornerRadius="7"
                    Clicked="OnBackClicked" />
            <VerticalStackLayout Grid.Column="1" Margin="14,0" Spacing="1">
                <Label Text="OVERWATCH"
                       TextColor="#FAFAF9"
                       FontAttributes="Bold"
                       FontSize="16" />
                <Label Text="Native tactical map"
                       TextColor="#A8A29E"
                       FontSize="11" />
            </VerticalStackLayout>
            <Label Grid.Column="2"
                   Text="Pan · zoom · rotate · tilt"
                   TextColor="#A8A29E"
                   FontSize="11"
                   VerticalTextAlignment="Center" />
        </Grid>
        <local:NativeOverwatchMap Grid.Row="1" />
    </Grid>
</ContentPage>
