<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GwsBusinessSuite.WorldNewsKit</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- World news situations (.claude/plans/world-news-situations-macos-2026-10.md): the reading,
       grouping and summarizing pipeline, kept out of the Mac app so it's unit-testable. It runs
       in the Mac app against the local Ollama. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GwsBusinessSuite.OllamaKit\GwsBusinessSuite.OllamaKit.csproj" />
  </ItemGroup>
</Project>
