<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>sentinelcli</AssemblyName>
    <RootNamespace>GwsBusinessSuite.SentinelCLI</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\ollama\required-models.txt"
                      LogicalName="GwsBusinessSuite.SentinelCLI.required-models.txt" />
    <EmbeddedResource Include="..\..\ollama\SentinelGPT.Modelfile"
                      LogicalName="GwsBusinessSuite.SentinelCLI.SentinelGPT.Modelfile" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GwsBusinessSuite.OllamaKit\GwsBusinessSuite.OllamaKit.csproj" />
    <ProjectReference Include="..\GwsBusinessSuite.SentinelAgentKit\GwsBusinessSuite.SentinelAgentKit.csproj" />
  </ItemGroup>
</Project>
