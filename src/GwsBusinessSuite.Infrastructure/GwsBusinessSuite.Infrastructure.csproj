<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\GwsBusinessSuite.Domain\GwsBusinessSuite.Domain.csproj" />
    <ProjectReference Include="..\GwsBusinessSuite.Application\GwsBusinessSuite.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CodeHollow.FeedReader" Version="1.2.6" />
    <PackageReference Include="Docker.DotNet" Version="3.125.15" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.12" />
    <!-- IPasswordHasher<T>/PasswordHasher<T> only - not the full ASP.NET Core Identity
         stack - needed by UserManagementService without pulling in the web SDK's shared
         framework into this class library. -->
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Forces the transitive Roslyn version up to match Application's own direct
         Microsoft.CodeAnalysis.CSharp reference - without this, EntityFrameworkCore.Design's
         own floor on Microsoft.CodeAnalysis.CSharp.Workspaces produces an NU1107 conflict. -->
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.9.0" />
    <!-- EntityFrameworkCore.Design pulls the Workspaces packages at 5.0.0; pinning them to the same
         5.9.0 as Common keeps all of Roslyn on one version. Mixed 5.0/5.9 made `dotnet ef migrations`
         crash at design time (and produced the NU1608 build warnings). -->
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="MaxMind.GeoIP2" Version="6.1.0" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="SmartReader" Version="0.11.1" />
    <!-- Pin above the version Microsoft.Data.Sqlite.Core pulls in transitively (2.1.11),
         which has a known SQLite memory-corruption vulnerability (GHSA-2m69-gcr7-jv3q). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <!-- 2025.1.0 and earlier have a high-severity ScpClient path-traversal vulnerability
         (GHSA-q939-rpr3-3284 / CVE-2026-48798); 2026.0.0 is the first patched release. This app
         only uses SshClient/SftpClient (see SshTerminalService.cs, DatabaseBackupService.cs),
         never ScpClient, but the NuGet audit flags the package regardless of which APIs are used. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <!-- Community license (free for individuals/small companies) - accepted at
         startup via QuestPDF.Settings.License in ResumePdfService. -->
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <!-- Text extraction for Civic Watch county commission agendas/minutes (QuestPDF only writes PDFs). -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <!-- Headless-browser scraping for LocalEventsScraperService - the only sources this
         needs (Perry, GA's FullCalendar widget and Robins Region Chamber's GrowthZone
         cards) render their event data client-side, so plain HttpClient + regex (this
         file's usual pattern for GovernmentIntelligenceService) can't see it at all. -->
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
    <PackageReference Include="Stripe.net" Version="53.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
