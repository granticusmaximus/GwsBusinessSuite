# Existing application secrets/settings belong here too; this file only documents the
# optional Live Show TURN relay values. Generate a long secret, for example:
#   openssl rand -hex 32
TURN_SHARED_SECRET=replace-with-a-long-random-secret
TURN_URL_UDP=turn:turn.example.com:3478?transport=udp
TURN_URL_TCP=turn:turn.example.com:3478?transport=tcp
TURN_REALM=turn.example.com

# Optional privacy-first analytics geography. Copy a GeoLite2 City MMDB into the
# persistent app data volume at this path before restarting the web container.
ANALYTICS_GEOIP_DATABASE_PATH=/app/data/GeoLite2-City.mmdb

# Optional live internet research for SentinelGPT (Ollama Web Search). Without this,
# SentinelGPT still works fully from local knowledge; it just can't browse the web.
OLLAMA_WEB_API_KEY=replace-with-an-ollama-web-search-api-key

# Optional: lets the native macOS app sign in via /auth/device-login instead of the browser's
# mandatory MFA challenge, using this shared secret (generate with `openssl rand -hex 32`) plus
# the account's own username/password. Real security tradeoff, not equivalent to MFA - anyone who
# obtains both this secret and the account password bypasses the second factor entirely.
# Proportionate for a single-user, self-hosted app with one trusted device, not a multi-tenant
# fleet. Leave unset/empty to disable the endpoint entirely (fails closed by default). The same
# value must also be entered once into the Mac app (its own "Configure device login" button).
NATIVE_APP_DEVICE_SECRET=

# Preferred production backup key. Generate once with `openssl rand -base64 32`, store it
# in the production secret manager, and escrow it separately from the backup archives.
BACKUP_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Optional scheduled Growth Studio email reports. Keep the password in the untracked
# production .env file. StartTls is the secure default; use SslOnConnect for port 465.
GrowthReportEmail__Host=smtp.example.com
GrowthReportEmail__Port=587
GrowthReportEmail__Security=StartTls
GrowthReportEmail__Username=replace-with-smtp-username
GrowthReportEmail__Password=replace-with-smtp-password
GrowthReportEmail__FromAddress=reports@example.com
GrowthReportEmail__FromName=GWS Growth Studio
